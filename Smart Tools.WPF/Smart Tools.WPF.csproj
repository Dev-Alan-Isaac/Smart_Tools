<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<OutputType>WinExe</OutputType>
		<!-- Always self-contained: every build carries .NET, so Settings > Installation can make a portable copy for a USB from any build. -->
		<RuntimeIdentifier>win-x64</RuntimeIdentifier>
		<SelfContained>true</SelfContained>
		<TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
		<RootNamespace>Smart_Tools.WPF</RootNamespace>
		<Nullable>enable</Nullable>
		<ImplicitUsings>enable</ImplicitUsings>
		<UseWPF>true</UseWPF>
		<UseWindowsForms>true</UseWindowsForms>
		<ApplicationManifest>app.manifest</ApplicationManifest>
		<AssemblyName>SmartTools</AssemblyName>
		<Product>Smart Tools</Product>
		<AssemblyTitle>Smart Tools</AssemblyTitle>
		<ApplicationIcon>Images\Icon.ico</ApplicationIcon>
		<!-- The one version number: Settings, the Apps &amp; features entry and the zip name all read it. -->
		<Version>3.2.1</Version>
		<Company>Sheep</Company>
		<!-- OpenCvSharp's native runtime is Windows x64 only. -->
		<PlatformTarget>x64</PlatformTarget>
	</PropertyGroup>

	<!-- Send to Phone: a small local web server (Kestrel, part of the ASP.NET Core shared framework) for the encrypted
	     transfer on the local network, and the three files of the page the phone opens (embedded, served from memory). -->
	<ItemGroup>
		<FrameworkReference Include="Microsoft.AspNetCore.App" />
		<EmbeddedResource Include="Tools\Utilities\SendToPhone\Web\*.*" LogicalName="SendToPhone.%(Filename)%(Extension)" />
	</ItemGroup>

	<!-- ================= Native engines (no NuGet) ================= -->

	<ItemGroup>
		<Content Include="Engines\FFMPEG\ffmpeg.exe">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
		<Content Include="Engines\FFMPEG\ffprobe.exe">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
	</ItemGroup>

	<!-- VLC: libvlc.dll, libvlccore.dll, COPYING.txt and the whole plugins
	     folder, copied to bin\...\Engines\VLC with the subfolders kept.
	     The None Remove stops the same files being listed twice. -->
	<ItemGroup>
		<None Remove="Engines\VLC\**" />
		<Content Include="Engines\VLC\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
	</ItemGroup>

	<!-- 7-Zip (Archive Manager): 7z.exe + 7z.dll and its licence (GNU LGPL, with the unRAR restriction: it may read RAR, never make it).
	     Run by the tool as a separate program; arguments are passed as a list, never one string. -->
	<ItemGroup>
		<None Remove="Engines\7ZIP\**" />
		<Content Include="Engines\7ZIP\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
	</ItemGroup>

	<!-- yt-dlp (Web Audio Saver): the single yt-dlp.exe from the official release (Unlicense), checked against the published SHA2-256SUMS.
	     Sites change often: the tool can update a COPY in the user's data folder; this one is never modified. -->
	<ItemGroup>
		<None Remove="Engines\YTDLP\**" />
		<Content Include="Engines\YTDLP\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
	</ItemGroup>

	<!-- Tesseract OCR (optional engine for Screen OCR): tesseract.exe, its DLLs and
	     tessdata (configs + English). More languages are downloaded into AppPaths.TesseractData. -->
	<ItemGroup>
		<None Remove="Engines\TESSERACT\**" />
		<Content Include="Engines\TESSERACT\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
	</ItemGroup>

	<!-- Whisper speech engine (Speech to Text): whisper-cli.exe and the DLLs it loads, including the
	     ggml-cpu-*.dll variants it picks from at run time. Models are downloaded into AppPaths.WhisperModels. -->
	<ItemGroup>
		<None Remove="Engines\WHISPER\**" />
		<Content Include="Engines\WHISPER\**\*">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
	</ItemGroup>

	<!-- System Snapshot Collector (project SystemSnapshot.Collector): its ready-made zip travels with the app so System Snapshot can save it to a USB
	     drive for scanning another PC. Skipped when the zip has not been built (the button then says so). -->
	<ItemGroup Condition="Exists('..\SystemSnapshot.Collector\dist\SystemSnapshot-Collector.zip')">
		<Content Include="..\SystemSnapshot.Collector\dist\SystemSnapshot-Collector.zip" Link="Engines\SystemSnapshot\SystemSnapshot-Collector.zip">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
	</ItemGroup>

	<!-- IEEE OUI snapshot (MAC prefix -> manufacturer), read by OuiLookupManager. -->
	<ItemGroup>
		<Content Include="Data\oui.txt">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
		<Content Include="log4net.config">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
			<CopyToPublishDirectory>PreserveNewest</CopyToPublishDirectory>
		</Content>
	</ItemGroup>

	<!-- ================= Images ================= -->

	<ItemGroup>
		<None Remove="Images\Icon.ico" />
		<Resource Include="Images\Icon.ico" />
	</ItemGroup>

	<ItemGroup>
		<Content Include="Images\Memento.jpeg">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
		<Content Include="Images\Memento-bg.png">
			<CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
		</Content>
	</ItemGroup>

	<!-- ================= Packages ================= -->

	<ItemGroup>
		<PackageReference Include="LibreHardwareMonitorLib" Version="0.9.6" />
		<PackageReference Include="Konscious.Security.Cryptography.Argon2" Version="1.3.1" />
		<PackageReference Include="log4net" Version="3.5.0" />
		<PackageReference Include="Magick.NET-Q16-AnyCPU" Version="15.0.0" />
		<PackageReference Include="MaterialDesignThemes" Version="5.4.0" />
		<PackageReference Include="Microsoft.Data.SqlClient" Version="7.1.1" />
		<PackageReference Include="Microsoft.Diagnostics.Tracing.TraceEvent" Version="4.0.0" />
		<PackageReference Include="Microsoft.ML.OnnxRuntime" Version="1.31.1" />
		<PackageReference Include="Microsoft.ML.Tokenizers" Version="2.0.1" />
		<PackageReference Include="Microsoft.Toolkit.Uwp.Notifications" Version="7.1.3" />
		<PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4314.35" />
		<PackageReference Include="NAudio" Version="3.3.0" />
		<!-- Find Similar Files: images/video (OpenCV) and audio (SoundFingerprinting, MIT, in-memory model service only). -->
		<PackageReference Include="OpenCvSharp4" Version="4.13.0.20260627" />
		<PackageReference Include="OpenCvSharp4.runtime.win" Version="4.13.0.20260627" />
		<PackageReference Include="SoundFingerprinting" Version="17.1.0" />
		<!--  Stay on 6.2.4 (MIT). 6.5.0 is AGPL with a license check: saving any PDF throws "The loaded license is not valid".  -->
		<PackageReference Include="PDFsharp" Version="6.2.4" />
		<PackageReference Include="System.IO.Hashing" Version="10.0.14" />
		<PackageReference Include="System.Management" Version="10.0.14" />
		<PackageReference Include="System.Speech" Version="10.0.14" />
		<PackageReference Include="YamlDotNet" Version="18.1.0" />
		<PackageReference Include="ZXing.Net" Version="0.16.11" />
	</ItemGroup>

	<!-- ================= Resources and settings ================= -->

	<ItemGroup>
		<Compile Update="Properties\Resources.Designer.cs">
			<DesignTime>True</DesignTime>
			<AutoGen>True</AutoGen>
			<DependentUpon>Resources.resx</DependentUpon>
		</Compile>
		<Compile Update="Properties\Settings.Designer.cs">
			<DesignTimeSharedInput>True</DesignTimeSharedInput>
			<AutoGen>True</AutoGen>
			<DependentUpon>Settings.settings</DependentUpon>
		</Compile>
	</ItemGroup>

	<ItemGroup>
		<EmbeddedResource Update="Properties\Resources.resx">
			<Generator>ResXFileCodeGenerator</Generator>
			<LastGenOutput>Resources.Designer.cs</LastGenOutput>
		</EmbeddedResource>
	</ItemGroup>

	<ItemGroup>
		<None Update="Properties\Settings.settings">
			<Generator>SettingsSingleFileGenerator</Generator>
			<LastGenOutput>Settings.Designer.cs</LastGenOutput>
		</None>
	</ItemGroup>

</Project>