<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!--
        ============================================================
        GLASS THEME (translucent surfaces over the blurred window backdrop, see Modules/GlassWindow.cs)  —  "professional" pass
        ============================================================
        Same key set as Light.xaml (required — ThemeManager swaps this
        whole dictionary in at runtime, so every key here must exist
        there too and vice versa). Deeper near-black surfaces instead of
        dark-gray-blue, a slightly brighter accent than the light theme
        for contrast against a near-black background, and a vertical
        sidebar gradient to match.
    -->

    <!--  Page / content area background (behind cards)  -->
    <SolidColorBrush x:Key="ContentBg" Color="#40101826" />

    <!--  Card / panel surfaces  -->
    <SolidColorBrush x:Key="CardBg" Color="#40FFFFFF" />
    <SolidColorBrush x:Key="CardBorder" Color="#33FFFFFF" />

    <!--  A slightly recessed row background used inside cards (list rows, etc.)  -->
    <SolidColorBrush x:Key="RowBg" Color="#1AFFFFFF" />

    <!--  Text  -->
    <SolidColorBrush x:Key="TextPrimary" Color="#F6F8FC" />
    <SolidColorBrush x:Key="TextSecondary" Color="#BAC4D8" />

    <!--  Inputs (TextBox / ComboBox) that sit on a dark card  -->
    <SolidColorBrush x:Key="InputBg" Color="#99000000" />
    <!--
        #384157 -> #5A6680: old border was 1.45:1 on InputBg - inputs read as
        flat patches instead of fields. Now ~2.6:1.
    -->
    <SolidColorBrush x:Key="InputBorder" Color="#B3FFFFFF" />
    <SolidColorBrush x:Key="InputText" Color="#F6F8FC" />

    <!--
        Accent — brightened slightly relative to Light.xaml's #3D6FE0 so
        it keeps the same visual weight/contrast against a near-black
        background instead of looking muddy.
    -->
    <SolidColorBrush x:Key="AccentColor" Color="#5C86E8" />

    <!--
        ============ SEMANTIC STATUS COLORS ============
        Unchanged from the original — already tuned as tinted-dark
        backgrounds with a brighter foreground for this surface.
    -->
    <SolidColorBrush x:Key="StatusSuccessBg" Color="#1B3B2A" />
    <SolidColorBrush x:Key="StatusSuccessFg" Color="#4ADE80" />

    <SolidColorBrush x:Key="StatusInfoBg" Color="#1B2C48" />
    <SolidColorBrush x:Key="StatusInfoFg" Color="#60A5FA" />

    <SolidColorBrush x:Key="StatusWarningBg" Color="#40320F" />
    <SolidColorBrush x:Key="StatusWarningFg" Color="#FBBF24" />

    <SolidColorBrush x:Key="StatusErrorBg" Color="#3B1D1D" />
    <SolidColorBrush x:Key="StatusErrorFg" Color="#F87171" />

    <!--  Changed words inside a changed line (File Differences): a stronger tint of StatusSuccessBg / StatusErrorBg, TextPrimary stays readable on them  -->
    <SolidColorBrush x:Key="DiffAddedStrongBg" Color="#2A6340" />
    <SolidColorBrush x:Key="DiffRemovedStrongBg" Color="#6E2B2B" />

    <!--
        ============ SIDEBAR (options panel present in every view) ============
        Was a flat #1B2530. Same vertical-gradient treatment as
        Light.xaml, tuned a touch darker so it still reads as "the
        darkest surface in the app" next to the new deep ContentBg.
    -->

    <!--  Nested "step"/filter cards that sit ON the sidebar  -->
    <SolidColorBrush x:Key="SidebarCardBg" Color="#26FFFFFF" />

    <!--  Hover background for sidebar nav buttons (MainWindow)  -->
    <SolidColorBrush x:Key="SidebarItemHoverBg" Color="#33FFFFFF" />

    <!--
        A further-recessed sub-panel inside a sidebar card (e.g. "Group
        Unknown Extensions" panel nested inside a step card)
    -->
    <SolidColorBrush x:Key="SidebarSubPanelBg" Color="#33000000" />

    <!--  Text sitting directly on the (always-dark) sidebar  -->
    <SolidColorBrush x:Key="SidebarText" Color="#EDEFF4" />
    <SolidColorBrush x:Key="SidebarTextMuted" Color="#B7C2D6" />

    <!--
        Inputs that sit ON the sidebar — separate from InputBg/InputBorder
        above, which are for inputs sitting on the main CardBg surface
    -->
    <SolidColorBrush x:Key="SidebarInputBg" Color="#A6000000" />
    <SolidColorBrush x:Key="SidebarInputBorder" Color="#99FFFFFF" />
    <SolidColorBrush x:Key="SidebarInputText" Color="#EDEFF4" />

    <!--
        Subtle hairline border for panels/modals that sit on the
        (always-dark) SidebarBg surface — e.g. the video-compare overlay.
        Same translucent-white value in both themes since that surface
        never changes color between Light/Dark.
    -->
    <SolidColorBrush x:Key="SidebarBorder" Color="#17FFFFFF" />

    <!--
        Hairline border for the video-compare player frames, which sit
        on a fixed black MediaElement background regardless of theme.
    -->
    <SolidColorBrush x:Key="PlayerFrameBorder" Color="#1FFFFFFF" />

    <!--  Dim layer behind the guided-tour spotlight  -->
    <SolidColorBrush x:Key="TourScrim" Color="#B3000000" />

    <!--  Media stage (fixed dark in both themes), scrims, overlays on pictures, transparency checkerboard  -->
    <SolidColorBrush x:Key="MediaStageBg" Color="#0E0F12" />
    <SolidColorBrush x:Key="MediaStageText" Color="#E9EBEF" />
    <SolidColorBrush x:Key="MediaStageTextMuted" Color="#8A8F99" />
    <SolidColorBrush x:Key="MediaStageTextSoft" Color="#C9CDD4" />
    <SolidColorBrush x:Key="MediaStageTextSubtle" Color="#A9AFB9" />
    <SolidColorBrush x:Key="MediaChromeBg" Color="#CC16181D" />
    <SolidColorBrush x:Key="MediaChromeFill" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="MediaChromeFillHover" Color="#2AFFFFFF" />
    <SolidColorBrush x:Key="MediaChromeFillPressed" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="MediaTrackBg" Color="#33808080" />
    <SolidColorBrush x:Key="MediaOverlayBg" Color="#B3000000" />
    <SolidColorBrush x:Key="MediaPanelBg" Color="#E61B1E24" />
    <SolidColorBrush x:Key="MediaStageError" Color="#F87171" />
    <SolidColorBrush x:Key="ScrimBg" Color="#99000000" />
    <SolidColorBrush x:Key="SliderTrack" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="SelectionFill" Color="#335C86E8" />
    <SolidColorBrush x:Key="HoverOverlayFill" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="HoverOverlayStroke" Color="#FFFFFFFF" />

    <!--  Series colours of the per-program usage charts (heaviest first, then everything else)  -->
    <SolidColorBrush x:Key="ChartSeries1" Color="#60A5FA" />
    <SolidColorBrush x:Key="ChartSeries2" Color="#FBBF24" />
    <SolidColorBrush x:Key="ChartSeries3" Color="#34D399" />
    <SolidColorBrush x:Key="ChartSeries4" Color="#F87171" />
    <SolidColorBrush x:Key="ChartSeries5" Color="#A78BFA" />
    <SolidColorBrush x:Key="ChartSeries6" Color="#2DD4BF" />
    <SolidColorBrush x:Key="ChartSeriesOther" Color="#64748B" />
    <SolidColorBrush x:Key="CheckerLight" Color="#FF4A4F5A" />
    <SolidColorBrush x:Key="CheckerDark" Color="#FF353A44" />

    <!--
        ============ NEW: ACCENT STATE + GRADIENT TOKENS ============
        Additive only — tuned lighter than Light.xaml's equivalents so
        hover/pressed states stay visible against dark surfaces.
    -->
    <SolidColorBrush x:Key="AccentColorHover" Color="#729AEF" />
    <SolidColorBrush x:Key="AccentColorPressed" Color="#4670C9" />
    <SolidColorBrush x:Key="AccentColorSubtle" Color="#1C2A47" />

    <LinearGradientBrush x:Key="AccentGradient" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#6E96EE" />
        <GradientStop Offset="1" Color="#3D62C4" />
    </LinearGradientBrush>

    <!--
        ============ NEW: ELEVATION ============
        A shadow barely registers on a near-black background, so this
        is deliberately more opaque than Light.xaml's version but still
        blurred/soft rather than a hard drop-shadow — the goal is a
        faint "lifted" edge, not a black smudge.
    -->
    <DropShadowEffect
        x:Key="CardElevation"
        BlurRadius="24"
        Direction="270"
        Opacity="0.22"
        ShadowDepth="4"
        Color="#000000" />

    <DropShadowEffect
        x:Key="ButtonElevation"
        BlurRadius="14"
        Direction="270"
        Opacity="0.35"
        ShadowDepth="2"
        Color="#000000" />

    <!--
        Raw Color (not a Brush) — see Light.xaml for why this isn't a
        shared Effect resource. Lighter than Light.xaml's version so the
        hover glow still reads against a near-black card.
    -->
    <Color x:Key="ButtonHoverGlowColor">#6E96EE</Color>

    <!--
        ============ NEW: FILLS, DANGER, SCROLLBAR ============
        See Light.xaml. AccentFill is deliberately DEEPER than AccentColor
        here: white text on #5C86E8 is only 3.48:1 (fails AA), on #4670C9
        it's 4.75:1. AccentColor stays bright for text/borders/indicators.
    -->
    <SolidColorBrush x:Key="AccentFill" Color="#4670C9" />

    <SolidColorBrush x:Key="DangerFill" Color="#DC2626" />

    <!--  Opaque surface for dropdown lists, menus and tooltips: they float over page text, so they must not be see-through  -->
    <SolidColorBrush x:Key="PopupBg" Color="#FF1C2640" />
    <SolidColorBrush x:Key="PopupBorder" Color="#80FFFFFF" />
    <SolidColorBrush x:Key="ScrollThumb" Color="#80FFFFFF" />
    <SolidColorBrush x:Key="ScrollThumbHover" Color="#B3FFFFFF" />


    <!--  Glass sidebar: translucent so the blurred backdrop shows through  -->
    <LinearGradientBrush x:Key="SidebarBg" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#A61B2540" />
        <GradientStop Offset="1" Color="#8C0F1526" />
    </LinearGradientBrush>

</ResourceDictionary>
