<ResourceDictionary
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!--
        ================= SHARED MOTION + FOCUS =================
        One easing family for the whole app so every hover/press/expand
        feels related. EaseOut = settle; EasePop = tiny overshoot "spring"
        used on release / check / select so things feel friendly, not stiff.
    -->
    <!--
        ================= SHAPE + TYPE TOKENS (soft-modern pass) =================
        One radius scale for the shared styles below: Sm = chips/toggles,
        Md = buttons/inputs, Lg = cards/panels. Not theme-dependent, so they
        live here and not in Light/Dark.
    -->
    <CornerRadius x:Key="RadiusSm">6</CornerRadius>
    <CornerRadius x:Key="RadiusMd">8</CornerRadius>
    <CornerRadius x:Key="RadiusLg">12</CornerRadius>
    <FontFamily x:Key="AppFont">Segoe UI Variable Text, Segoe UI</FontFamily>

    <CubicEase x:Key="EaseOut" EasingMode="EaseOut" />
    <BackEase
        x:Key="EasePop"
        Amplitude="0.4"
        EasingMode="EaseOut" />

    <!--
        Rounded accent focus ring shown ONLY for keyboard focus (Tab) -
        replaces WPF's default dotted rectangle, which looked broken on
        rounded controls. Mouse clicks never show it.
    -->
    <Style x:Key="FocusRingVisual">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Border
                        Margin="-3"
                        BorderBrush="{DynamicResource AccentColor}"
                        BorderThickness="2"
                        CornerRadius="10"
                        Opacity="0.85"
                        SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ================= SIDEBAR SECTION LABEL =================  -->

    <!--
        Small-caps bold label above a group of sidebar settings (e.g.
        "REMOVAL SETTINGS", "AUTHENTICATION"). Was being redefined
        identically in ApiTesterView and BackgroundRemoverView's own
        UserControl.Resources - centralized here for the same reason as
        CardStyle above (one place to change, no dangling references).

        Usage: <TextBlock Style="{StaticResource SidebarSectionLabel}" Text="..." />
    -->
    <Style x:Key="SidebarSectionLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SidebarTextMuted}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="20,15,0,10" />
    </Style>

    <!--
        ================= FIELD LABEL =================
        Small bold label above a single field within a sidebar section
        (e.g. "Width (px)" under "SIZE"). Duplicated identically in
        BarcodeGeneratorView and QRcodeGeneratorView - centralized here for
        the same reason as CardStyle above. (BarcodeGeneratorView still has
        its own local copy as of this edit; safe to switch it over to this
        shared one too next time that file is touched.)
    -->
    <Style x:Key="FieldLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SidebarTextMuted}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Margin" Value="0,0,0,4" />
    </Style>

    <!--
        ================= SIDEBAR SUB LABEL =================
        Smaller, non-bold variant of SidebarSectionLabel for a sub-setting
        within a section (e.g. "Convert To" under "CONVERSION SETTINGS").
        Was duplicated identically in FileConverterView and
        FileDifferencesView - centralized for the same reason as CardStyle.
    -->
    <Style x:Key="SidebarSubLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SidebarTextMuted}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Margin" Value="0,10,0,5" />
    </Style>

    <!--  ================= TYPE SCALE =================  -->

    <!--
        Every view's header currently hardcodes FontSize/FontWeight/Foreground
        inline instead of sharing one definition - centralizing it here means
        the whole app's title/subtitle/section-heading look can be tuned in
        one place instead of 35 separate copies drifting apart over time.
    -->
    <Style x:Key="PageTitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="20" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>

    <Style x:Key="PageSubtitle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="Margin" Value="0,3,0,0" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--  A card's own internal heading (e.g. "Results", "Files", "Preview")  -->
    <Style x:Key="SectionHeading" TargetType="TextBlock">
        <Setter Property="FontSize" Value="14" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>

    <!--  ================= CARD =================  -->

    <!--
        Shared "panel surface" look, meant to replace the CardStyle that
        several views (PdfToolkitView, FindSimilarFilesView, etc.) were each
        redefining locally in their own UserControl.Resources. Centralizing
        it here means:
          - one place to change the card look app-wide instead of N copies
          - no more dangling StaticResource references if a view's local
            copy gets edited/removed by accident
        Values match what those local copies already used, so switching a
        view over to this one is a purely visual no-op.

        Usage: <Border Style="{StaticResource CardStyle}"> ... </Border>
        Only Background/CornerRadius/Padding/etc are set here - layout
        properties (Margin, Grid.Row/Column, etc.) are left for each call
        site, same as any other opt-in Style in this file.
    -->
    <Style x:Key="CardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource CardBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
        <Setter Property="Padding" Value="18" />
    </Style>

    <!--
        Same surface as CardStyle, for the always-dark sidebar panel - a
        hairline border in SidebarBorder (not CardBorder, which is tuned
        for the light CardBg surface and reads as invisible/mismatched
        against the dark sidebar in the Light theme) so the sidebar gets
        the same defined edge as every other panel instead of floating
        as an untethered block of color.
    -->
    <Style x:Key="SidebarPanelStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SidebarBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SidebarBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusLg}" />
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect
                    BlurRadius="20"
                    Direction="0"
                    Opacity="0.10"
                    ShadowDepth="3"
                    Color="Black" />
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Hairline divider for use ON the sidebar - same role as the default
        Separator style below, but in SidebarBorder's translucent-white
        rather than CardBorder, so it's actually visible against the
        dark sidebar surface in both themes instead of nearly disappearing.
        Usage: <Separator Style="{StaticResource SidebarSeparatorStyle}" Margin="..." />
    -->
    <Style x:Key="SidebarSeparatorStyle" TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource SidebarBorder}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!--
        Sub-section heading used INSIDE an already-padded sidebar
        container (e.g. "TRANSITION", "OUTPUT", "PROGRESS", "REPLAY MODE"
        above a group of fields within the scrollable settings area).
        Distinct from SidebarSectionLabel above, which bakes in its own
        20px left margin for sections sitting directly on the sidebar's
        un-padded root StackPanel - stacking that margin on top of a
        parent that already has its own padding would double-indent it.
        This one assumes zero left inset of its own and leaves spacing
        entirely to its container. Was duplicated identically several
        times across VideoEditorView/VideoReplayView - centralized here
        for the same reason as SidebarSectionLabel/FieldLabel above.

        Usage: <TextBlock Style="{StaticResource SidebarGroupLabel}" Text="OUTPUT" />
    -->
    <Style x:Key="SidebarGroupLabel" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource SidebarTextMuted}" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Margin" Value="0,0,0,8" />
    </Style>

    <!--
        Wraps one settings group (a SidebarGroupLabel + the fields under it)
        in its own subtly-tinted card instead of a flat list divided only by
        hairline Separators - gives the sidebar real visual segmentation, so
        scanning down it reads as a set of distinct settings panels rather
        than one long undifferentiated scroll. Replaces the old pattern of
        <TextBlock Style="{StaticResource SidebarGroupLabel}" .../> followed
        by fields followed by a <Separator .../> before the next group.

        Usage:
        <Border Style="{StaticResource SidebarGroupCardStyle}">
            <StackPanel>
                <TextBlock Style="{StaticResource SidebarGroupLabel}" Text="OUTPUT" />
                ... fields ...
            </StackPanel>
        </Border>
    -->
    <Style x:Key="SidebarGroupCardStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource SidebarCardBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource SidebarBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="8" />
        <Setter Property="Padding" Value="12" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>

    <!--
        Opt-in: a more pronounced rounding for cards that want a softer,
        more "floating" feel than the standard CardStyle above - e.g. a
        hero/summary panel, an empty-state placeholder, or a modal-like
        overlay card. Same surface colors, just rounder.
    -->
    <Style
        x:Key="RoundedCardStyle"
        BasedOn="{StaticResource CardStyle}"
        TargetType="Border">
        <Setter Property="CornerRadius" Value="18" />
    </Style>

    <!--  ================= BUTTONS =================  -->

    <!--
        Label text inside a button: wraps onto more lines instead of being
        clipped when the button is narrower than its text (long Spanish
        labels, narrow sidebar columns). Each button template applies it
        through ContentPresenter.Resources; the matching styles use
        MinHeight (not Height) so the button grows to fit the extra line.
    -->
    <Style x:Key="ButtonLabelTextStyle" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="TextAlignment" Value="Center" />
    </Style>

    <!--
        Base template for text buttons. Rebuilt so that:
        - hover/press are colour WASHES (tinted from the button's own
        Foreground) instead of fading the whole button's opacity - reads
        as "lighting up" rather than "going grey/flat"
        - the glow shadow sits on its own layer BEHIND the label, so the
        text keeps crisp ClearType (an Effect on the element that holds
        the text forces it to render through an offscreen bitmap)
        - disabled opacity is set on the Button itself. Previously it was a
        Setter on "Bd" while the hover storyboard also animated Bd.Opacity;
        an animation's held value beats a Setter, so any button that had
        been hovered and was then disabled (e.g. a Start button disabled
        while running) kept looking fully enabled.
        - hover lifts 1px, press squeezes to 97% and springs back
    -->
    <Style x:Key="BaseButtonStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
                                <TranslateTransform x:Name="RootLift" Y="0" />
                            </TransformGroup>
                        </Grid.RenderTransform>

                        <!--  Glow layer (never holds text)  -->
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <Border.Effect>
                                <DropShadowEffect
                                    x:Name="BdShadow"
                                    BlurRadius="14"
                                    Direction="270"
                                    Opacity="0"
                                    ShadowDepth="3"
                                    Color="{DynamicResource ButtonHoverGlowColor}" />
                            </Border.Effect>
                        </Border>

                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8" />

                        <!--  State washes tinted from Foreground: accent tint on outline buttons, white sheen on filled ones  -->
                        <Border
                            x:Name="HoverWash"
                            Background="{TemplateBinding Foreground}"
                            CornerRadius="8"
                            IsHitTestVisible="False"
                            Opacity="0" />
                        <Border
                            x:Name="PressWash"
                            Background="{TemplateBinding Foreground}"
                            CornerRadius="8"
                            IsHitTestVisible="False"
                            Opacity="0" />

                        <ContentPresenter
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            RecognizesAccessKey="True">
                            <ContentPresenter.Resources>
                                <Style BasedOn="{StaticResource ButtonLabelTextStyle}" TargetType="TextBlock" />
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverWash"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.1"
                                            Duration="0:0:0.14" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="BdShadow"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.16"
                                            Duration="0:0:0.18" />
                                        <DoubleAnimation
                                            EasingFunction="{StaticResource EaseOut}"
                                            Storyboard.TargetName="RootLift"
                                            Storyboard.TargetProperty="Y"
                                            To="0"
                                            Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverWash"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="0:0:0.2" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="BdShadow"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="0:0:0.2" />
                                        <DoubleAnimation
                                            EasingFunction="{StaticResource EaseOut}"
                                            Storyboard.TargetName="RootLift"
                                            Storyboard.TargetProperty="Y"
                                            To="0"
                                            Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="PressWash"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.1"
                                            Duration="0:0:0.06" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="RootScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="0.97"
                                            Duration="0:0:0.06" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="RootScale"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="0.97"
                                            Duration="0:0:0.06" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="PressWash"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="0:0:0.2" />
                                        <DoubleAnimation
                                            EasingFunction="{StaticResource EasePop}"
                                            Storyboard.TargetName="RootScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="1"
                                            Duration="0:0:0.28" />
                                        <DoubleAnimation
                                            EasingFunction="{StaticResource EasePop}"
                                            Storyboard.TargetName="RootScale"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="1"
                                            Duration="0:0:0.28" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!-- Default look for any plain <Button/>: outlined / secondary. -->
    <Style BasedOn="{StaticResource BaseButtonStyle}" TargetType="Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource AccentColor}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="14,4" />
    </Style>

    <!--  Opt-in: solid accent fill, for the one clear primary action on a card/page.  -->
    <Style
        x:Key="PrimaryButtonStyle"
        BasedOn="{StaticResource BaseButtonStyle}"
        TargetType="Button">
        <!--  AccentFill (not AccentColor): keeps white label >= 4.5:1 in Dark  -->
        <Setter Property="Background" Value="{DynamicResource AccentFill}" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="FontSize" Value="13" />
        <Setter Property="Padding" Value="16,5" />
    </Style>

    <!--
        Opt-in: circular icon-only button, turns soft red on hover — use
        for destructive row actions ("remove", "delete"). Hover colours now
        come from the theme's StatusError pair instead of hard-coded
        #EF4444, so the tint is readable in both Light and Dark.
    -->
    <Style x:Key="IconButtonStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
        <!--  Icon-only: the ToolTip is the only label, so screen readers read it as the button's name  -->
        <Setter Property="AutomationProperties.Name" Value="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        CornerRadius="14"
                        RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="BdScale" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource StatusErrorBg}" />
                            <Setter Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            EasingFunction="{StaticResource EasePop}"
                                            Storyboard.TargetName="BdScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="1.12"
                                            Duration="0:0:0.2" />
                                        <DoubleAnimation
                                            EasingFunction="{StaticResource EasePop}"
                                            Storyboard.TargetName="BdScale"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="1.12"
                                            Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="BdScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="1"
                                            Duration="0:0:0.15" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="BdScale"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="1"
                                            Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="BdScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="0.9"
                                            Duration="0:0:0.05" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="BdScale"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="0.9"
                                            Duration="0:0:0.05" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            EasingFunction="{StaticResource EasePop}"
                                            Storyboard.TargetName="BdScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="1.12"
                                            Duration="0:0:0.25" />
                                        <DoubleAnimation
                                            EasingFunction="{StaticResource EasePop}"
                                            Storyboard.TargetName="BdScale"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="1.12"
                                            Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Same footprint/animation as IconButtonStyle, but for icon-only
        actions that are NOT destructive (Copy, Refresh, Expand, ...).
        IconButtonStyle's hover is hard-coded red - correct for a row's
        "remove" action, misleading on something like Copy, which isn't
        a delete affordance and shouldn't glow like one. Also gets a
        faint resting-state ring (IconButtonStyle relies on hover alone
        to read as a button at all, which is part of what made it feel
        so minimal) and an accent-tinted hover instead.
    -->
    <Style x:Key="NeutralIconButtonStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontSize" Value="12" />
        <!--  Removed Width and Height setters so it can stretch  -->
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Padding" Value="10,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{DynamicResource InputBorder}"
                        BorderThickness="1"
                        CornerRadius="8"
                        RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="BdScale" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <ContentPresenter Margin="0,3" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentPresenter.Resources>
                                <Style BasedOn="{StaticResource ButtonLabelTextStyle}" TargetType="TextBlock" />
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <!--  Triggers remain the same  -->
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentColorSubtle}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentColor}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="BdScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="1.08"
                                            Duration="0:0:0.12" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="BdScale"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="1.08"
                                            Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="BdScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="1"
                                            Duration="0:0:0.15" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="BdScale"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="1"
                                            Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentColorSubtle}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="BdScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="0.92"
                                            Duration="0:0:0.05" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="BdScale"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="0.92"
                                            Duration="0:0:0.05" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="BdScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="1"
                                            Duration="0:0:0.1" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="BdScale"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="1"
                                            Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The standard list / result-bar button: icon only, 32x32, 16px icon.
        Used for Remove selected, Open folder, Show in folder and Open file.
        Put the ToolTip on it (there is no label).
    -->
    <Style
        x:Key="ListToolButtonStyle"
        BasedOn="{StaticResource NeutralIconButtonStyle}"
        TargetType="Button">
        <Setter Property="Width" Value="32" />
        <Setter Property="Height" Value="32" />
        <Setter Property="MinHeight" Value="32" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="AutomationProperties.Name" Value="{Binding RelativeSource={RelativeSource Self}, Path=ToolTip}" />
    </Style>

    <!--
        The labeled primary actions (Save, Save as, Add, Add to favorite, Export)
        keep their text but share the 32px height of the icon buttons beside them.
        PrimaryButtonStyle itself stays 34 so the Files card stays aligned.
    -->
    <Style
        x:Key="ListToolPrimaryButtonStyle"
        BasedOn="{StaticResource PrimaryButtonStyle}"
        TargetType="Button">
        <Setter Property="MinHeight" Value="32" />
    </Style>

    <!--  Round-cornered color chip (Recent, Favorites, shades) with a lift on hover. Global: code that builds chips for another view's panel looks it up by key.  -->
    <Style x:Key="SwatchButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" />
                        </Grid.RenderTransform>
                        <Border
                            x:Name="Ring"
                            Margin="-3"
                            BorderBrush="Transparent"
                            BorderThickness="2"
                            CornerRadius="8" />
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource CardBorder}"
                            BorderThickness="1"
                            CornerRadius="8" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            EasingFunction="{StaticResource EaseOut}"
                                            Storyboard.TargetName="Scale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="1.12"
                                            Duration="0:0:0.12" />
                                        <DoubleAnimation
                                            EasingFunction="{StaticResource EaseOut}"
                                            Storyboard.TargetName="Scale"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="1.12"
                                            Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="Scale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="1"
                                            Duration="0:0:0.15" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="Scale"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="1"
                                            Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>


    <!--
        Same button for Clear all: red icon at rest, red wash on hover. The
        neutral template reads AccentColor / AccentColorSubtle through
        DynamicResource, which finds these Style.Resources before the theme
        dictionary (the same trick DangerButtonStyle uses for its glow).
    -->
    <Style
        x:Key="ListToolDangerButtonStyle"
        BasedOn="{StaticResource ListToolButtonStyle}"
        TargetType="Button">
        <Style.Resources>
            <SolidColorBrush x:Key="AccentColor" Color="#DC2626" />
            <SolidColorBrush x:Key="AccentColorSubtle" Color="#26DC2626" />
        </Style.Resources>
        <Setter Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
    </Style>

    <!--
        Warning twin of ListToolDangerButtonStyle: amber icon at rest (StatusWarningFg
        follows the theme), amber wash on hover. For actions that need care but
        aren't destructive (reset, overwrite, retry).
    -->
    <Style
        x:Key="ListToolWarningButtonStyle"
        BasedOn="{StaticResource ListToolButtonStyle}"
        TargetType="Button">
        <Style.Resources>
            <SolidColorBrush x:Key="AccentColor" Color="#D97706" />
            <SolidColorBrush x:Key="AccentColorSubtle" Color="#26D97706" />
        </Style.Resources>
        <Setter Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
    </Style>

    <!--
        Now BasedOn BaseButtonStyle (same wash/lift/spring behaviour as every
        other button) instead of its own hard-coded #EF4444 template. The
        Style.Resources entry re-colours the hover glow red: DynamicResource
        lookups from inside the template reach the Button's own Style
        resources before the theme dictionary.
    -->
    <Style
        x:Key="DangerButtonStyle"
        BasedOn="{StaticResource BaseButtonStyle}"
        TargetType="Button">
        <Style.Resources>
            <Color x:Key="ButtonHoverGlowColor">#DC2626</Color>
        </Style.Resources>
        <Setter Property="Height" Value="32" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{DynamicResource DangerFill}" />
        <Setter Property="BorderThickness" Value="0" />
    </Style>

    <!--  ================= TEXT BOX =================  -->

    <Style TargetType="TextBox">
        <Setter Property="Height" Value="32" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="10,0" />

        <!--  IMPORTANT  -->
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="AcceptsReturn" Value="False" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />

        <!--
            Default Hidden keeps single-line inputs clean. CodeTextBox /
            CodeTextBoxNoWrap set these to Auto - which now actually works:
            the old template hard-coded Hidden on PART_ContentHost, so those
            multi-line code/log panes could never show a scrollbar at all.
        -->
        <Setter Property="HorizontalScrollBarVisibility" Value="Hidden" />
        <Setter Property="VerticalScrollBarVisibility" Value="Hidden" />

        <Setter Property="Background" Value="{DynamicResource InputBg}" />
        <Setter Property="Foreground" Value="{DynamicResource InputText}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{DynamicResource InputText}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentColor}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TextBox">
                    <Grid>
                        <!--
                            Glow layer sits BEHIND the field and never holds text.
                            It used to be an Effect on the Border that wraps
                            PART_ContentHost, which forced every keystroke (and a
                            whole multi-thousand-line CodeTextBox/log pane) to render
                            through an offscreen bitmap - slow, and it drops text
                            to greyscale anti-aliasing.
                        -->
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <Border.Effect>
                                <DropShadowEffect
                                    x:Name="FocusGlow"
                                    BlurRadius="10"
                                    Direction="0"
                                    Opacity="0"
                                    ShadowDepth="0"
                                    Color="{DynamicResource ButtonHoverGlowColor}" />
                            </Border.Effect>
                        </Border>

                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <Grid>
                                <ScrollViewer
                                    x:Name="PART_ContentHost"
                                    Margin="{TemplateBinding Padding}"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    CanContentScroll="False"
                                    Focusable="False"
                                    HorizontalScrollBarVisibility="{TemplateBinding HorizontalScrollBarVisibility}"
                                    VerticalScrollBarVisibility="{TemplateBinding VerticalScrollBarVisibility}" />
                                <!--
                                    Placeholder: views already put hint text in Tag
                                    (e.g. Tag="https://api.example.com/endpoint"), but no
                                    template ever displayed it. Shown only while empty.
                                    Only use Tag for hint text on TextBoxes from now on.
                                -->
                                <TextBlock
                                    x:Name="Placeholder"
                                    Margin="{TemplateBinding Padding}"
                                    Padding="2,0,0,0"
                                    VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                    FontFamily="{TemplateBinding FontFamily}"
                                    FontSize="{TemplateBinding FontSize}"
                                    Foreground="{DynamicResource TextSecondary}"
                                    IsHitTestVisible="False"
                                    Opacity="0.75"
                                    Text="{TemplateBinding Tag}"
                                    TextTrimming="CharacterEllipsis"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                        </Trigger>

                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="FocusGlow"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.55"
                                            Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="FocusGlow"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="0:0:0.22" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <!--
                            Read-only: previously faded the whole box to 60%, which made
                            read-only OUTPUT fields (results, generated values, code
                            panes) harder to read than editable ones. Now it just
                            stops pretending to be editable - no accent hover border.
                        -->
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsReadOnly" Value="True" />
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="IsKeyboardFocused" Value="False" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{Binding BorderBrush, RelativeSource={RelativeSource TemplatedParent}}" />
                        </MultiTrigger>

                        <Trigger Property="Text" Value="">
                            <Setter TargetName="Placeholder" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <!--  Multi-line panes: fill the box so scrollbars sit on its edges, not under the last line  -->
                        <Trigger Property="AcceptsReturn" Value="True">
                            <Setter TargetName="PART_ContentHost" Property="VerticalAlignment" Value="Stretch" />
                            <Setter TargetName="Placeholder" Property="VerticalAlignment" Value="Top" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ================= COMBO BOX =================  -->

    <!--
        Adds what the old template lacked: an "open" state (accent border +
        chevron flips up), keyboard-focus border, a disabled look, and a
        dropdown that slides in. IsEditable="True" shows a
        PART_EditableTextBox in place of the selection box.
    -->
    <Style TargetType="ComboBox">
        <Setter Property="Height" Value="32" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Background" Value="{DynamicResource InputBg}" />
        <Setter Property="Foreground" Value="{DynamicResource InputText}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="10,0,26,0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBox">
                    <Grid>
                        <ToggleButton
                            x:Name="ToggleBtn"
                            ClickMode="Press"
                            Focusable="False"
                            IsChecked="{Binding Path=IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}">
                            <ToggleButton.Template>
                                <ControlTemplate TargetType="ToggleButton">
                                    <Border
                                        x:Name="Bd"
                                        Background="{Binding Background, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                        BorderBrush="{Binding BorderBrush, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                        BorderThickness="{Binding BorderThickness, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                        CornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="24" />
                                            </Grid.ColumnDefinitions>
                                            <Path
                                                x:Name="Arrow"
                                                Grid.Column="1"
                                                Width="9"
                                                Height="5"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Data="M0,0 L4.5,4.5 L9,0"
                                                RenderTransformOrigin="0.5,0.5"
                                                Stretch="Fill"
                                                Stroke="{DynamicResource TextSecondary}"
                                                StrokeEndLineCap="Round"
                                                StrokeLineJoin="Round"
                                                StrokeStartLineCap="Round"
                                                StrokeThickness="1.6">
                                                <Path.RenderTransform>
                                                    <RotateTransform x:Name="ArrowRotate" Angle="0" />
                                                </Path.RenderTransform>
                                            </Path>
                                        </Grid>
                                    </Border>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                                            <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource AccentColor}" />
                                        </Trigger>
                                        <Trigger Property="IsChecked" Value="True">
                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                                            <Setter TargetName="Arrow" Property="Stroke" Value="{DynamicResource AccentColor}" />
                                            <Trigger.EnterActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                            EasingFunction="{StaticResource EaseOut}"
                                                            Storyboard.TargetName="ArrowRotate"
                                                            Storyboard.TargetProperty="Angle"
                                                            To="180"
                                                            Duration="0:0:0.2" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.EnterActions>
                                            <Trigger.ExitActions>
                                                <BeginStoryboard>
                                                    <Storyboard>
                                                        <DoubleAnimation
                                                            EasingFunction="{StaticResource EaseOut}"
                                                            Storyboard.TargetName="ArrowRotate"
                                                            Storyboard.TargetProperty="Angle"
                                                            To="0"
                                                            Duration="0:0:0.2" />
                                                    </Storyboard>
                                                </BeginStoryboard>
                                            </Trigger.ExitActions>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </ToggleButton.Template>
                        </ToggleButton>

                        <ContentPresenter
                            x:Name="ContentSite"
                            Margin="{TemplateBinding Padding}"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Content="{TemplateBinding SelectionBoxItem}"
                            ContentStringFormat="{TemplateBinding SelectionBoxItemStringFormat}"
                            ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                            IsHitTestVisible="False" />

                        <!--  Only shown when IsEditable="True"; the right margin leaves the chevron clickable  -->
                        <TextBox
                            x:Name="PART_EditableTextBox"
                            Margin="8,1,26,1"
                            HorizontalAlignment="Stretch"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            CaretBrush="{TemplateBinding Foreground}"
                            Focusable="True"
                            Foreground="{TemplateBinding Foreground}"
                            Visibility="Collapsed">
                            <TextBox.Template>
                                <ControlTemplate TargetType="TextBox">
                                    <ScrollViewer x:Name="PART_ContentHost" Focusable="False" />
                                </ControlTemplate>
                            </TextBox.Template>
                        </TextBox>

                        <Popup
                            x:Name="Popup"
                            AllowsTransparency="True"
                            Focusable="False"
                            HorizontalOffset="-6"
                            IsOpen="{TemplateBinding IsDropDownOpen}"
                            Placement="Bottom"
                            PopupAnimation="Slide">
                            <!--  Outer margin leaves room for the shadow, which a Popup would otherwise clip  -->
                            <Grid Margin="6,0,6,10">
                                <Border Background="{DynamicResource CardBg}" CornerRadius="10">
                                    <Border.Effect>
                                        <DropShadowEffect
                                            BlurRadius="20"
                                            Direction="270"
                                            Opacity="0.14"
                                            ShadowDepth="4"
                                            Color="Black" />
                                    </Border.Effect>
                                </Border>
                                <Border
                                    MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=ComboBox}}"
                                    MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                    Margin="0,4,0,0"
                                    Background="{DynamicResource CardBg}"
                                    BorderBrush="{DynamicResource CardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="10">
                                    <ScrollViewer SnapsToDevicePixels="True">
                                        <StackPanel
                                            Margin="4"
                                            IsItemsHost="True"
                                            KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </Popup>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEditable" Value="True">
                            <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                            <Setter TargetName="ContentSite" Property="Visibility" Value="Collapsed" />
                            <Setter Property="Cursor" Value="IBeam" />
                        </Trigger>
                        <Trigger Property="IsKeyboardFocusWithin" Value="True">
                            <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ComboBoxItem">
                    <Grid>
                        <Border
                            x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            CornerRadius="6">
                            <ContentPresenter />
                        </Border>
                        <!--  Small accent tick on the currently-selected option  -->
                        <Border
                            x:Name="SelectedBar"
                            Width="3"
                            Height="14"
                            Margin="1,0,0,0"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AccentGradient}"
                            CornerRadius="1.5"
                            Visibility="Collapsed" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowBg}" />
                        </Trigger>
                        <!--
                            Selected: accent-tinted row + accent tick. Text stays
                            TextPrimary - AccentColor text on this tint is ~4:1, a
                            touch under AA at 12px.
                        -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentColorSubtle}" />
                            <Setter TargetName="SelectedBar" Property="Visibility" Value="Visible" />
                            <Setter Property="FontWeight" Value="SemiBold" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Segmented two-way toggle (Folder/Entire Disk, Encrypt/Decrypt, etc).
        This was getting copy-pasted per-view with only the *usage* carried
        over and not the style definition itself (SpaceAnalyzerView being the
        latest to hit that - a StaticResource that can't resolve throws at
        parse time, not a silent no-op). Centralizing it here means that
        can't happen again for any future view that wants this same toggle.
    -->
    <Style x:Key="ModeToggleButtonStyle" TargetType="RadioButton">
        <Setter Property="GroupName" Value="Mode" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarText}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="RadioButton">
                    <Border
                        x:Name="Bd"
                        Background="{DynamicResource SidebarInputBg}"
                        CornerRadius="8"
                        RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="BdScale" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <ContentPresenter Margin="8,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentPresenter.Resources>
                                <Style BasedOn="{StaticResource ButtonLabelTextStyle}" TargetType="TextBlock" />
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarItemHoverBg}" />
                        </Trigger>
                        <!--  AccentFill + white: SidebarText on AccentColor was only 3.0:1 in Dark  -->
                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentFill}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Same rounded-pill visual language as ModeToggleButtonStyle (34px
        tall, same corner radius/background/hover-scale animation), but for
        plain Buttons that fire a one-off action (e.g. Rotate Left/Right,
        Flip H/V) rather than RadioButtons that hold a persistent selected
        state. There's no "checked" look here - IsPressed briefly flashes
        AccentColor instead, as click feedback rather than a standing
        selection, since none of these buttons is ever "the active one".
    -->
    <Style x:Key="SegmentedActionButtonStyle" TargetType="Button">
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="34" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarText}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Bd"
                        Background="{DynamicResource SidebarInputBg}"
                        CornerRadius="6"
                        RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="BdScale" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <ContentPresenter Margin="8,4" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentPresenter.Resources>
                                <Style BasedOn="{StaticResource ButtonLabelTextStyle}" TargetType="TextBlock" />
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarItemHoverBg}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="BdScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="1.015"
                                            Duration="0:0:0.1" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="BdScale"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="1.015"
                                            Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="BdScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="1"
                                            Duration="0:0:0.12" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="BdScale"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="1"
                                            Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentFill}" />
                            <Setter Property="Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ================= CHECK BOX =================  -->
    <!--
        Rebuilt:
        - the tick "pops" in with a small spring instead of just appearing
        - indeterminate (IsThreeState / IsChecked=null) now draws a dash;
        before, it looked identical to unchecked
        - the gap between box and label is clickable (was a StackPanel with
        no background, so clicks in that gap fell through)
        - disabled look, keyboard focus ring, and no stray 8px margin when
        there's no label (e.g. DataGrid checkbox columns)
    -->
    <Style TargetType="CheckBox">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="CheckBox">
                    <Grid
                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                        VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                        Background="Transparent">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border
                            x:Name="Box"
                            Width="18"
                            Height="18"
                            VerticalAlignment="Center"
                            Background="{DynamicResource InputBg}"
                            BorderBrush="{DynamicResource InputBorder}"
                            BorderThickness="1.5"
                            CornerRadius="5"
                            RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="BoxScale" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <Grid>
                                <Path
                                    x:Name="Check"
                                    Width="10"
                                    Height="8"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Data="M0,4 L3.5,7.5 L10,0.5"
                                    Opacity="0"
                                    RenderTransformOrigin="0.5,0.5"
                                    Stretch="Fill"
                                    Stroke="White"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="2">
                                    <Path.RenderTransform>
                                        <ScaleTransform x:Name="CheckScale" ScaleX="0.4" ScaleY="0.4" />
                                    </Path.RenderTransform>
                                </Path>
                                <Rectangle
                                    x:Name="Dash"
                                    Width="8"
                                    Height="2"
                                    Fill="White"
                                    RadiusX="1"
                                    RadiusY="1"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Border>

                        <ContentPresenter
                            x:Name="Label"
                            Grid.Column="1"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            RecognizesAccessKey="True" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="HasContent" Value="False">
                            <Setter TargetName="Label" Property="Visibility" Value="Collapsed" />
                        </Trigger>

                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                        </Trigger>

                        <Trigger Property="IsChecked" Value="True">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentFill}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentFill}" />
                            <!--  Fallback so a pre-checked box is never blank; the storyboard adds the pop  -->
                            <Setter TargetName="Check" Property="Opacity" Value="1" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="Check"
                                            Storyboard.TargetProperty="Opacity"
                                            To="1"
                                            Duration="0:0:0.1" />
                                        <DoubleAnimation
                                            EasingFunction="{StaticResource EasePop}"
                                            Storyboard.TargetName="CheckScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="1"
                                            Duration="0:0:0.28" />
                                        <DoubleAnimation
                                            EasingFunction="{StaticResource EasePop}"
                                            Storyboard.TargetName="CheckScale"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="1"
                                            Duration="0:0:0.28" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="Check"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="0:0:0.1" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="CheckScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="0.4"
                                            Duration="0:0:0.12" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="CheckScale"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="0.4"
                                            Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsChecked" Value="{x:Null}">
                            <Setter TargetName="Box" Property="Background" Value="{DynamicResource AccentFill}" />
                            <Setter TargetName="Box" Property="BorderBrush" Value="{DynamicResource AccentFill}" />
                            <Setter TargetName="Dash" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="BoxScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="0.88"
                                            Duration="0:0:0.06" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="BoxScale"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="0.88"
                                            Duration="0:0:0.06" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            EasingFunction="{StaticResource EasePop}"
                                            Storyboard.TargetName="BoxScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="1"
                                            Duration="0:0:0.28" />
                                        <DoubleAnimation
                                            EasingFunction="{StaticResource EasePop}"
                                            Storyboard.TargetName="BoxScale"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="1"
                                            Duration="0:0:0.28" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                            <Setter Property="Cursor" Value="Arrow" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ================= EXPANDER =================  -->

    <!--
        Implicit (no x:Key) so every <Expander/> in the app picks this up
        automatically - CodeToolkitView's error banner, JunkFileCleanerView's
        category groups, and RegexTesterView's Quick Reference all still set
        their own Background/Foreground per instance, which simply overrides
        these defaults; only the chrome (header row, chevron, corners) is new.
    -->
    <Style TargetType="Expander">
        <Setter Property="Background" Value="{DynamicResource CardBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Padding" Value="12,10" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Expander">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8"
                        SnapsToDevicePixels="True">

                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--
                                Header row - its own ToggleButton so the whole
                                row is clickable, not just the chevron.
                            -->
                            <ToggleButton
                                x:Name="HeaderToggle"
                                Grid.Row="0"
                                Content="{TemplateBinding Header}"
                                ContentTemplate="{TemplateBinding HeaderTemplate}"
                                Cursor="Hand"
                                Focusable="False"
                                IsChecked="{Binding IsExpanded, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                OverridesDefaultStyle="True">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border
                                            x:Name="HeaderBd"
                                            Padding="{TemplateBinding Padding}"
                                            Background="Transparent"
                                            CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>

                                                <!--  Chevron rotates 0°→90° on expand instead of the OS-drawn arrow  -->
                                                <Path
                                                    x:Name="Chevron"
                                                    Grid.Column="0"
                                                    Width="8"
                                                    Height="8"
                                                    Margin="0,0,10,0"
                                                    VerticalAlignment="Center"
                                                    Data="M0,0 L6,6 L0,12"
                                                    RenderTransformOrigin="0.5,0.5"
                                                    Stretch="Uniform"
                                                    Stroke="{DynamicResource TextSecondary}"
                                                    StrokeLineJoin="Round"
                                                    StrokeThickness="1.8">
                                                    <Path.RenderTransform>
                                                        <RotateTransform x:Name="ChevronRotate" Angle="0" />
                                                    </Path.RenderTransform>
                                                </Path>

                                                <ContentPresenter
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Content="{TemplateBinding Content}"
                                                    ContentTemplate="{TemplateBinding ContentTemplate}" />

                                            </Grid>
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="HeaderBd" Property="Background" Value="{DynamicResource RowBg}" />
                                            </Trigger>
                                            <!--
                                                RotateTransform is a Freezable, not a FrameworkElement - a plain
                                                Setter can't target it (throws "Cannot find the Trigger target"),
                                                so this has to run through a Storyboard instead.
                                            -->
                                            <Trigger Property="IsChecked" Value="True">
                                                <Trigger.EnterActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                EasingFunction="{StaticResource EasePop}"
                                                                Storyboard.TargetName="ChevronRotate"
                                                                Storyboard.TargetProperty="Angle"
                                                                To="90"
                                                                Duration="0:0:0.25" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.EnterActions>
                                                <Trigger.ExitActions>
                                                    <BeginStoryboard>
                                                        <Storyboard>
                                                            <DoubleAnimation
                                                                Storyboard.TargetName="ChevronRotate"
                                                                Storyboard.TargetProperty="Angle"
                                                                To="0"
                                                                Duration="0:0:0.15" />
                                                        </Storyboard>
                                                    </BeginStoryboard>
                                                </Trigger.ExitActions>
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>

                            <!--  Body - collapsed by default, shown when IsExpanded flips  -->
                            <ContentPresenter
                                x:Name="ExpandSite"
                                Grid.Row="1"
                                Margin="{TemplateBinding Padding}"
                                Focusable="False"
                                Visibility="Collapsed">
                                <ContentPresenter.RenderTransform>
                                    <TranslateTransform x:Name="ExpandShift" Y="0" />
                                </ContentPresenter.RenderTransform>
                            </ContentPresenter>

                        </Grid>
                    </Border>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsExpanded" Value="True">
                            <Setter TargetName="ExpandSite" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="ExpandSite"
                                            Storyboard.TargetProperty="Opacity"
                                            From="0"
                                            To="1"
                                            Duration="0:0:0.2" />
                                        <DoubleAnimation
                                            EasingFunction="{StaticResource EaseOut}"
                                            Storyboard.TargetName="ExpandShift"
                                            Storyboard.TargetProperty="Y"
                                            From="-6"
                                            To="0"
                                            Duration="0:0:0.22" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Opt-in variant of the CheckBox style above, for use inside a DataGrid
        cell (e.g. a row-selection checkbox column). The default CheckBox
        style bakes in Margin="0,0,0,10" for stacked checkboxes in a sidebar
        list - that same margin is what clips a checkbox sitting inside a
        DataGridCell, since it eats into the row's fixed height. This resets
        the margin to 0; everything else (box size, checkmark, colors) is
        identical to the default CheckBox look.
    -->
    <Style
        x:Key="DataGridCheckBoxStyle"
        BasedOn="{StaticResource {x:Type CheckBox}}"
        TargetType="CheckBox">
        <Setter Property="Margin" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  ================= DATA GRID =================  -->

    <Style TargetType="DataGrid">
        <Setter Property="Background" Value="{DynamicResource CardBg}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="RowBackground" Value="Transparent" />
        <Setter Property="AlternatingRowBackground" Value="Transparent" />
        <Setter Property="HorizontalGridLinesBrush" Value="{DynamicResource CardBorder}" />
        <Setter Property="VerticalGridLinesBrush" Value="Transparent" />
        <Setter Property="GridLinesVisibility" Value="None" />
        <!--
            MinRowHeight, not RowHeight - RowHeight forces every row to
            exactly this height and clips anything taller (wrapped
            multi-line cell text included), regardless of window size.
            MinRowHeight keeps the same 36px floor for ordinary single-line
            rows but still lets a row grow for wrapped content - needed for
            any DataGridTextColumn.ElementStyle that sets TextWrapping="Wrap"
            to actually work instead of silently clipping.
        -->
        <Setter Property="MinRowHeight" Value="40" />
        <Setter Property="CanUserAddRows" Value="False" />
        <Setter Property="CanUserResizeRows" Value="False" />
        <Setter Property="HeadersVisibility" Value="Column" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <!--
            No horizontal scrollbar: star columns shrink to the viewport, and
            long cell text trims (EllipsisCellTextStyle) or wraps
            (WrappingCellTextStyle) instead of pushing other columns away.
        -->
        <Setter Property="HorizontalScrollBarVisibility" Value="Disabled" />
    </Style>

    <!--
        Reusable ElementStyle for any DataGridTextColumn whose values can run
        long (matched text, file paths, etc.) - wraps instead of clipping or
        relying solely on the grid's horizontal scrollbar, so the column
        stays readable at any window width. Needs the DataGrid style's
        MinRowHeight (not a fixed RowHeight) above to actually take effect -
        a fixed RowHeight clips wrapped text regardless of this style.
    -->
    <Style x:Key="WrappingCellTextStyle" TargetType="TextBlock">
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="Margin" Value="0,5" />
    </Style>

    <!--
        ElementStyle for a DataGridTextColumn holding names, paths, vendors or
        other single-line text: one line, an ellipsis when the column is too
        narrow, and the full text in a tooltip. Use WrappingCellTextStyle
        instead where the whole value must stay visible (hashes, summaries).
    -->
    <Style x:Key="EllipsisCellTextStyle" TargetType="TextBlock">
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
    </Style>

    <!--
        Resize handle between column headers. The old header template had
        no PART_LeftHeaderGripper/PART_RightHeaderGripper, so columns could
        NOT be resized by dragging, even with CanUserResizeColumns=True.
        Invisible at rest; an accent line fades in on hover.
    -->
    <Style x:Key="DataGridHeaderGripperStyle" TargetType="Thumb">
        <Setter Property="Width" Value="8" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Cursor" Value="SizeWE" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Thumb">
                    <Border Background="{TemplateBinding Background}">
                        <Rectangle
                            x:Name="Line"
                            Width="2"
                            Margin="0,6"
                            HorizontalAlignment="Center"
                            Fill="{DynamicResource AccentColor}"
                            Opacity="0"
                            RadiusX="1"
                            RadiusY="1" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Line" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="Line" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Also restores the SORT ARROW - the old template dropped it, so
        clicking a header sorted the grid with no visible indication of
        which column / which direction.
    -->
    <Style TargetType="DataGridColumnHeader">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
        <Setter Property="BorderThickness" Value="0,0,0,1" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridColumnHeader">
                    <Grid>
                        <Border
                            x:Name="HeaderBd"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentPresenter
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center"
                                    Content="{TemplateBinding Content}"
                                    ContentStringFormat="{TemplateBinding ContentStringFormat}"
                                    ContentTemplate="{TemplateBinding ContentTemplate}"
                                    RecognizesAccessKey="True">
                                    <!--  A long header shows an ellipsis instead of pushing the sort arrow or the next column.  -->
                                    <ContentPresenter.Resources>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                        </Style>
                                    </ContentPresenter.Resources>
                                </ContentPresenter>
                                <Path
                                    x:Name="SortArrow"
                                    Grid.Column="1"
                                    Width="8"
                                    Height="5"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Data="M0,5 L4,0 L8,5"
                                    RenderTransformOrigin="0.5,0.5"
                                    Stretch="Fill"
                                    Stroke="{DynamicResource AccentColor}"
                                    StrokeEndLineCap="Round"
                                    StrokeLineJoin="Round"
                                    StrokeStartLineCap="Round"
                                    StrokeThickness="1.6"
                                    Visibility="Collapsed" />
                            </Grid>
                        </Border>
                        <Thumb
                            x:Name="PART_LeftHeaderGripper"
                            HorizontalAlignment="Left"
                            Style="{StaticResource DataGridHeaderGripperStyle}" />
                        <Thumb
                            x:Name="PART_RightHeaderGripper"
                            HorizontalAlignment="Right"
                            Style="{StaticResource DataGridHeaderGripperStyle}" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <MultiTrigger>
                            <MultiTrigger.Conditions>
                                <Condition Property="IsMouseOver" Value="True" />
                                <Condition Property="CanUserSort" Value="True" />
                            </MultiTrigger.Conditions>
                            <Setter TargetName="HeaderBd" Property="Background" Value="{DynamicResource AccentColorSubtle}" />
                            <Setter Property="Cursor" Value="Hand" />
                        </MultiTrigger>
                        <Trigger Property="SortDirection" Value="Ascending">
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                        </Trigger>
                        <Trigger Property="SortDirection" Value="Descending">
                            <Setter TargetName="SortArrow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="SortArrow" Property="RenderTransform">
                                <Setter.Value>
                                    <RotateTransform Angle="180" />
                                </Setter.Value>
                            </Setter>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridRow">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridRow">
                    <Border
                        x:Name="Bd"
                        Margin="0,1"
                        Background="{TemplateBinding Background}"
                        CornerRadius="8"
                        SnapsToDevicePixels="True">
                        <Grid>
                            <!--  Hover wash fades in/out rather than snapping as the mouse sweeps down the grid  -->
                            <Border
                                x:Name="HoverWash"
                                Background="{DynamicResource CardBorder}"
                                CornerRadius="8"
                                Opacity="0" />
                            <Border
                                x:Name="SelectWash"
                                Background="{DynamicResource AccentColorSubtle}"
                                CornerRadius="8"
                                Opacity="0" />
                            <Border
                                x:Name="SelectBar"
                                Width="3"
                                Margin="0,6"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource AccentGradient}"
                                CornerRadius="1.5"
                                Opacity="0" />
                            <SelectiveScrollingGrid>
                                <SelectiveScrollingGrid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </SelectiveScrollingGrid.ColumnDefinitions>
                                <SelectiveScrollingGrid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </SelectiveScrollingGrid.RowDefinitions>
                                <DataGridCellsPresenter
                                    Grid.Column="1"
                                    ItemsPanel="{TemplateBinding ItemsPanel}"
                                    SnapsToDevicePixels="True" />
                                <!--  Row details were silently dropped by the old template  -->
                                <DataGridDetailsPresenter
                                    x:Name="PART_DetailsPresenter"
                                    Grid.Row="1"
                                    Grid.Column="1"
                                    SelectiveScrollingGrid.SelectiveScrollingOrientation="Vertical"
                                    Visibility="{TemplateBinding DetailsVisibility}" />
                            </SelectiveScrollingGrid>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverWash"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.6"
                                            Duration="0:0:0.1" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverWash"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <!--
                            Selected: theme-aware accent tint + accent bar. Was a
                            hard-coded #224C8DFF (the OLD accent at 13% alpha).
                            Setters (not storyboards) so virtualized/recycled rows
                            can never keep a stale selection highlight.
                        -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="SelectWash" Property="Opacity" Value="1" />
                            <Setter TargetName="SelectBar" Property="Opacity" Value="1" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="DataGridCell">
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Padding" Value="12,6" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="DataGridCell">
                    <Border Padding="{TemplateBinding Padding}" Background="Transparent">
                        <ContentPresenter VerticalAlignment="Center" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Opt-in: for a checkbox column specifically. The default DataGridCell
        above uses Padding="10,6", sized for text - combined with a narrow
        checkbox column that padding crowds/clips the box. This zeroes it out
        and centers instead, pairing with DataGridCheckBoxStyle above.
    -->
    <Style
        x:Key="CheckBoxCellStyle"
        BasedOn="{StaticResource {x:Type DataGridCell}}"
        TargetType="DataGridCell">
        <Setter Property="Padding" Value="0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!--
        Opt-in: for any other narrow column - icon glyphs, row-action button
        clusters (Move Up/Down/Remove, "✕", etc). Same problem as the
        checkbox column above: the default 10,6 padding eats 20px off a
        column's declared Width before its content ever gets to lay out, so
        a "Width=80" three-button action column only has ~60px to actually
        work with. Use this on any DataGridTemplateColumn under ~100px wide.
    -->
    <Style
        x:Key="CompactCellStyle"
        BasedOn="{StaticResource {x:Type DataGridCell}}"
        TargetType="DataGridCell">
        <Setter Property="Padding" Value="2,0" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>

    <!--  ================= PROGRESS BAR =================  -->

    <!--
        Assumes the default Height below (10); if a consumer sets a
        different Height, adjust CornerRadius to Height/2 to keep the
        pill shape.
    -->
    <!--
        - Fill uses the accent GRADIENT by default (views that set their own
        Foreground, e.g. a status colour, still override it)
        - Indeterminate used to show a full-width bar at 55% opacity - which
        looked like "finished". Now a highlight sweeps across the track.
        Assumes the default Height (10); for other heights set CornerRadius
        to Height/2 to keep the pill shape.
    -->
    <Style TargetType="ProgressBar">
        <Setter Property="Height" Value="10" />
        <Setter Property="Foreground" Value="{DynamicResource AccentGradient}" />
        <Setter Property="Background" Value="{DynamicResource RowBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        ClipToBounds="True"
                        CornerRadius="5">
                        <Grid x:Name="PART_Track">
                            <Border
                                x:Name="PART_Indicator"
                                HorizontalAlignment="Left"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="5">
                                <!--  Soft top sheen so the fill reads as a lit bar, not a flat stripe  -->
                                <Border CornerRadius="5">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Offset="0" Color="#30FFFFFF" />
                                            <GradientStop Offset="0.6" Color="#00FFFFFF" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                            </Border>
                            <Border
                                x:Name="Sweep"
                                Background="{TemplateBinding Foreground}"
                                CornerRadius="5"
                                Visibility="Collapsed">
                                <Border.OpacityMask>
                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                        <LinearGradientBrush.RelativeTransform>
                                            <TranslateTransform X="-1" />
                                        </LinearGradientBrush.RelativeTransform>
                                        <GradientStop Offset="0" Color="Transparent" />
                                        <GradientStop Offset="0.3" Color="Transparent" />
                                        <GradientStop Offset="0.5" Color="Black" />
                                        <GradientStop Offset="0.7" Color="Transparent" />
                                        <GradientStop Offset="1" Color="Transparent" />
                                    </LinearGradientBrush>
                                </Border.OpacityMask>
                            </Border>
                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsIndeterminate" Value="True">
                            <Setter TargetName="PART_Indicator" Property="Visibility" Value="Collapsed" />
                            <Setter TargetName="Sweep" Property="Visibility" Value="Visible" />
                            <Trigger.EnterActions>
                                <BeginStoryboard x:Name="SweepAnim">
                                    <Storyboard RepeatBehavior="Forever">
                                        <DoubleAnimation
                                            EasingFunction="{StaticResource EaseOut}"
                                            Storyboard.TargetName="Sweep"
                                            Storyboard.TargetProperty="(UIElement.OpacityMask).(Brush.RelativeTransform).(TranslateTransform.X)"
                                            From="-1"
                                            To="1"
                                            Duration="0:0:1.4" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <RemoveStoryboard BeginStoryboardName="SweepAnim" />
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ================= MODERN SCROLLBAR =================  -->

    <!--
        Previously only a VERTICAL template existed and Width=8 was set for
        every ScrollBar, so horizontal scrollbars (DataGrid, no-wrap code
        panes) were squeezed to 8px wide and ran in reverse
        (IsDirectionReversed). Now each orientation has its own template.
        Thumb uses ScrollThumb (CardBorder was ~1.25:1 - nearly invisible),
        is slim at rest and widens on hover, turning accent while dragged.
    -->
    <Style TargetType="ScrollBar">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource ScrollThumb}" />
        <Setter Property="Width" Value="12" />
        <Setter Property="MinWidth" Value="12" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ScrollBar">
                    <Grid Background="Transparent" SnapsToDevicePixels="True">
                        <Track x:Name="PART_Track" IsDirectionReversed="True">
                            <Track.DecreaseRepeatButton>
                                <RepeatButton
                                    Command="ScrollBar.PageUpCommand"
                                    IsTabStop="False"
                                    Opacity="0" />
                            </Track.DecreaseRepeatButton>
                            <Track.Thumb>
                                <Thumb
                                    x:Name="Thumb"
                                    Width="4"
                                    HorizontalAlignment="Center"
                                    Background="{TemplateBinding Foreground}">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border
                                                x:Name="ThumbBorder"
                                                Background="{TemplateBinding Background}"
                                                CornerRadius="4" />
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource ScrollThumbHover}" />
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource AccentColor}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>
                            <Track.IncreaseRepeatButton>
                                <RepeatButton
                                    Command="ScrollBar.PageDownCommand"
                                    IsTabStop="False"
                                    Opacity="0" />
                            </Track.IncreaseRepeatButton>
                        </Track>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <!--  Slim at rest, widens under the pointer  -->
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            EasingFunction="{StaticResource EaseOut}"
                                            Storyboard.TargetName="Thumb"
                                            Storyboard.TargetProperty="Width"
                                            To="8"
                                            Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            BeginTime="0:0:0.4"
                                            EasingFunction="{StaticResource EaseOut}"
                                            Storyboard.TargetName="Thumb"
                                            Storyboard.TargetProperty="Width"
                                            To="4"
                                            Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="MinWidth" Value="0" />
                <Setter Property="Height" Value="10" />
                <Setter Property="MinHeight" Value="10" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="ScrollBar">
                            <Grid Background="Transparent" SnapsToDevicePixels="True">
                                <Track x:Name="PART_Track">
                                    <Track.DecreaseRepeatButton>
                                        <RepeatButton
                                            Command="ScrollBar.PageLeftCommand"
                                            IsTabStop="False"
                                            Opacity="0" />
                                    </Track.DecreaseRepeatButton>
                                    <Track.Thumb>
                                        <Thumb
                                            x:Name="Thumb"
                                            Height="4"
                                            VerticalAlignment="Center"
                                            Background="{TemplateBinding Foreground}">
                                            <Thumb.Template>
                                                <ControlTemplate TargetType="Thumb">
                                                    <Border
                                                        x:Name="ThumbBorder"
                                                        Background="{TemplateBinding Background}"
                                                        CornerRadius="4" />
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource ScrollThumbHover}" />
                                                        </Trigger>
                                                        <Trigger Property="IsDragging" Value="True">
                                                            <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource AccentColor}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Thumb.Template>
                                        </Thumb>
                                    </Track.Thumb>
                                    <Track.IncreaseRepeatButton>
                                        <RepeatButton
                                            Command="ScrollBar.PageRightCommand"
                                            IsTabStop="False"
                                            Opacity="0" />
                                    </Track.IncreaseRepeatButton>
                                </Track>
                            </Grid>
                            <ControlTemplate.Triggers>
                                <!--  Slim at rest, widens under the pointer  -->
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Trigger.EnterActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation
                                                    EasingFunction="{StaticResource EaseOut}"
                                                    Storyboard.TargetName="Thumb"
                                                    Storyboard.TargetProperty="Height"
                                                    To="8"
                                                    Duration="0:0:0.15" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.EnterActions>
                                    <Trigger.ExitActions>
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation
                                                    BeginTime="0:0:0.4"
                                                    EasingFunction="{StaticResource EaseOut}"
                                                    Storyboard.TargetName="Thumb"
                                                    Storyboard.TargetProperty="Height"
                                                    To="4"
                                                    Duration="0:0:0.2" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </Trigger.ExitActions>
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  ================= LISTBOX =================  -->

    <Style TargetType="ListBox">
        <Setter Property="Background" Value="{DynamicResource CardBg}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBox">
                    <Border
                        Padding="{TemplateBinding Padding}"
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8">

                        <ScrollViewer
                            Focusable="False"
                            HorizontalScrollBarVisibility="{TemplateBinding ScrollViewer.HorizontalScrollBarVisibility}"
                            VerticalScrollBarVisibility="{TemplateBinding ScrollViewer.VerticalScrollBarVisibility}">

                            <ItemsPresenter />

                        </ScrollViewer>

                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ================= LISTBOX ITEM =================  -->

    <Style TargetType="ListBoxItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Padding" Value="10,8" />
        <Setter Property="Margin" Value="2" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />

        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Grid>
                        <Border
                            x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            CornerRadius="7">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                        </Border>
                        <Border
                            x:Name="SelectBar"
                            Width="3"
                            Margin="0,7"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource AccentGradient}"
                            CornerRadius="1.5"
                            Visibility="Collapsed" />
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowBg}" />
                        </Trigger>

                        <!--
                            Selected: was a solid AccentColor block with white text.
                            Any item DataTemplate that sets its own Foreground (e.g.
                            TextSecondary for a sub-line) turned unreadable on that
                            solid fill. An accent TINT + accent bar keeps every
                            template's own colours readable, in both themes.
                        -->
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentColorSubtle}" />
                            <Setter TargetName="SelectBar" Property="Visibility" Value="Visible" />
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ================= PASSWORD BOX =================  -->

    <Style TargetType="PasswordBox">
        <Setter Property="Height" Value="30" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Padding" Value="8,0" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />

        <Setter Property="Background" Value="{DynamicResource InputBg}" />
        <Setter Property="Foreground" Value="{DynamicResource InputText}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CaretBrush" Value="{DynamicResource InputText}" />
        <Setter Property="SelectionBrush" Value="{DynamicResource AccentColor}" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />

        <!--  Now shares the TextBox template (focus glow included) - it was missing the glow entirely  -->
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="PasswordBox">
                    <Grid>
                        <!--
                            Glow layer sits BEHIND the field and never holds text.
                            It used to be an Effect on the Border that wraps
                            PART_ContentHost, which forced every keystroke (and a
                            whole multi-thousand-line CodeTextBox/log pane) to render
                            through an offscreen bitmap - slow, and it drops text
                            to greyscale anti-aliasing.
                        -->
                        <Border Background="{TemplateBinding Background}" CornerRadius="8">
                            <Border.Effect>
                                <DropShadowEffect
                                    x:Name="FocusGlow"
                                    BlurRadius="10"
                                    Direction="0"
                                    Opacity="0"
                                    ShadowDepth="0"
                                    Color="{DynamicResource ButtonHoverGlowColor}" />
                            </Border.Effect>
                        </Border>

                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="8">
                            <ScrollViewer
                                x:Name="PART_ContentHost"
                                Margin="{TemplateBinding Padding}"
                                VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                CanContentScroll="False"
                                Focusable="False"
                                HorizontalScrollBarVisibility="Hidden"
                                VerticalScrollBarVisibility="Hidden" />
                        </Border>
                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                        </Trigger>

                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="FocusGlow"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.55"
                                            Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="FocusGlow"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="0:0:0.22" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>

                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ================= SLIDER =================  -->

    <Style TargetType="Slider">
        <Setter Property="Height" Value="24" />
        <Setter Property="Foreground" Value="{DynamicResource AccentColor}" />
        <Setter Property="Background" Value="{DynamicResource RowBg}" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Slider">
                    <Grid VerticalAlignment="Center">
                        <!--  Full-width track, always visible underneath  -->
                        <Border
                            Height="4"
                            Background="{TemplateBinding Background}"
                            CornerRadius="2" />

                        <Track x:Name="PART_Track">
                            <!--  Filled portion (0 up to the thumb) accent color  -->
                            <Track.DecreaseRepeatButton>
                                <RepeatButton Command="Slider.DecreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border
                                                Height="4"
                                                Background="{DynamicResource AccentGradient}"
                                                CornerRadius="2" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.DecreaseRepeatButton>
                            <!--  Empty portion (thumb up to max) transparent, base Border shows through  -->
                            <Track.IncreaseRepeatButton>
                                <RepeatButton Command="Slider.IncreaseLarge" Focusable="False">
                                    <RepeatButton.Template>
                                        <ControlTemplate TargetType="RepeatButton">
                                            <Border Height="4" Background="Transparent" />
                                        </ControlTemplate>
                                    </RepeatButton.Template>
                                </RepeatButton>
                            </Track.IncreaseRepeatButton>

                            <Track.Thumb>
                                <Thumb
                                    x:Name="Thumb"
                                    Width="16"
                                    Height="16">
                                    <Thumb.Template>
                                        <ControlTemplate TargetType="Thumb">
                                            <Border
                                                x:Name="ThumbBorder"
                                                Background="{DynamicResource AccentColor}"
                                                BorderBrush="White"
                                                BorderThickness="2"
                                                CornerRadius="8"
                                                RenderTransformOrigin="0.5,0.5"
                                                SnapsToDevicePixels="True">
                                                <Border.RenderTransform>
                                                    <ScaleTransform x:Name="ThumbScale" ScaleX="1" ScaleY="1" />
                                                </Border.RenderTransform>
                                                <Border.Effect>
                                                    <DropShadowEffect
                                                        BlurRadius="4"
                                                        Opacity="0.25"
                                                        ShadowDepth="1"
                                                        Color="Black" />
                                                </Border.Effect>
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <!--  Grows under the pointer (was: faded to 85%/70%, which read as "disabled")  -->
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Trigger.EnterActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation
                                                                    EasingFunction="{StaticResource EasePop}"
                                                                    Storyboard.TargetName="ThumbScale"
                                                                    Storyboard.TargetProperty="ScaleX"
                                                                    To="1.2"
                                                                    Duration="0:0:0.2" />
                                                                <DoubleAnimation
                                                                    EasingFunction="{StaticResource EasePop}"
                                                                    Storyboard.TargetName="ThumbScale"
                                                                    Storyboard.TargetProperty="ScaleY"
                                                                    To="1.2"
                                                                    Duration="0:0:0.2" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.EnterActions>
                                                    <Trigger.ExitActions>
                                                        <BeginStoryboard>
                                                            <Storyboard>
                                                                <DoubleAnimation
                                                                    EasingFunction="{StaticResource EaseOut}"
                                                                    Storyboard.TargetName="ThumbScale"
                                                                    Storyboard.TargetProperty="ScaleX"
                                                                    To="1"
                                                                    Duration="0:0:0.18" />
                                                                <DoubleAnimation
                                                                    EasingFunction="{StaticResource EaseOut}"
                                                                    Storyboard.TargetName="ThumbScale"
                                                                    Storyboard.TargetProperty="ScaleY"
                                                                    To="1"
                                                                    Duration="0:0:0.18" />
                                                            </Storyboard>
                                                        </BeginStoryboard>
                                                    </Trigger.ExitActions>
                                                </Trigger>
                                                <Trigger Property="IsDragging" Value="True">
                                                    <Setter TargetName="ThumbBorder" Property="BorderBrush" Value="{DynamicResource AccentColorSubtle}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Thumb.Template>
                                </Thumb>
                            </Track.Thumb>

                        </Track>

                    </Grid>

                    <ControlTemplate.Triggers>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>

                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ================= CONTEXT MENU =================  -->

    <!--
        Un-keyed (TargetType only), so this applies to every ContextMenu in the
        app automatically - including ones built in code with `new ContextMenu()`
        (BuildResultsContextMenu / BuildContextMenus), since implicit styles
        resolve by TargetType regardless of whether the element came from XAML
        or code. No code-behind changes needed to pick this up.
    -->
    <Style TargetType="ContextMenu">
        <Setter Property="Background" Value="{DynamicResource CardBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContextMenu">
                    <Border
                        Background="{TemplateBinding Background}"
                        BorderBrush="{TemplateBinding BorderBrush}"
                        BorderThickness="{TemplateBinding BorderThickness}"
                        CornerRadius="8">
                        <Border.Effect>
                            <DropShadowEffect
                                BlurRadius="14"
                                Opacity="0.18"
                                ShadowDepth="2"
                                Color="Black" />
                        </Border.Effect>
                        <ScrollViewer Margin="{TemplateBinding Padding}" SnapsToDevicePixels="True">
                            <StackPanel IsItemsHost="True" />
                        </ScrollViewer>
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style TargetType="MenuItem">
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <!--
            Left, not the FrameworkElement default of Stretch - a ContextMenu's
            items sit in a vertical StackPanel, which arranges every child at
            the width of the WIDEST sibling when they're left at the default
            Stretch alignment. Combined with the Header column below being "*"
            (star-sized), that stretched width used to get silently absorbed
            by the Header column, leaving visible dead space after any item
            shorter than its widest sibling (e.g. "Delete File" next to "Open
            File Location"). Left alignment makes each row hug its own
            content's natural width instead.
        -->
        <Setter Property="HorizontalAlignment" Value="Left" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="MenuItem">
                    <Border
                        x:Name="Bd"
                        Margin="2,1"
                        Padding="{TemplateBinding Padding}"
                        Background="Transparent"
                        CornerRadius="6">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ContentPresenter
                                Grid.Column="0"
                                VerticalAlignment="Center"
                                ContentSource="Header" />

                            <!--  Only shows up if a MenuItem sets InputGestureText - none of ours do yet.  -->
                            <TextBlock
                                x:Name="Igt"
                                Grid.Column="1"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="11"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="{TemplateBinding InputGestureText}" />

                            <!--
                                Submenu arrow - only shown for items that have
                                their own child MenuItems (Role=SubmenuHeader).
                                Collapsed otherwise, so plain leaf items don't
                                reserve space for it.
                            -->
                            <TextBlock
                                x:Name="Arrow"
                                Grid.Column="2"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                FontFamily="Segoe MDL2 Assets"
                                FontSize="10"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="&#xE76C;"
                                Visibility="Collapsed" />

                            <!--
                                Submenu popup - same CardBg/CardBorder + soft
                                drop-shadow language as the top-level
                                ContextMenu and the ComboBox dropdown, so a
                                nested MenuItem's flyout reads as part of this
                                app's theme. Without this, WPF falls back to
                                its default submenu chrome (the flat,
                                yellow-tinted OS popup border) since the
                                template above never defined one.
                            -->
                            <Popup
                                x:Name="Submenu"
                                AllowsTransparency="True"
                                Focusable="False"
                                HorizontalOffset="2"
                                IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}"
                                Placement="Right"
                                PopupAnimation="Fade">
                                <Border
                                    Background="{DynamicResource CardBg}"
                                    BorderBrush="{DynamicResource CardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                    <Border.Effect>
                                        <DropShadowEffect
                                            BlurRadius="14"
                                            Opacity="0.18"
                                            ShadowDepth="2"
                                            Color="Black" />
                                    </Border.Effect>
                                    <ScrollViewer Margin="4" SnapsToDevicePixels="True">
                                        <StackPanel IsItemsHost="True" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>

                        </Grid>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsHighlighted" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowBg}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                        <Trigger Property="Role" Value="SubmenuHeader">
                            <Setter TargetName="Arrow" Property="Visibility" Value="Visible" />
                            <Setter TargetName="Igt" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ================= SEPARATOR =================  -->

    <Style TargetType="Separator">
        <Setter Property="Background" Value="{DynamicResource CardBorder}" />
        <Setter Property="Height" Value="1" />
        <Setter Property="Margin" Value="4,4" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
    </Style>

    <!--  ================= TOOLTIP =================  -->

    <!--
        Card-surface tooltip. Uses a ContentPresenter now: the old template
        bound a TextBlock's Text to Content, so any tooltip whose content
        wasn't a plain string (a StackPanel, an icon + text, a bound object)
        rendered blank. Plain strings still wrap at MaxWidth via the
        implicit TextBlock style in the presenter's resources.
    -->
    <Style TargetType="ToolTip">
        <Setter Property="Background" Value="{DynamicResource CardBg}" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="Padding" Value="10,7" />
        <Setter Property="MaxWidth" Value="320" />
        <Setter Property="HasDropShadow" Value="False" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ToolTip">
                    <!--  Margin gives the shadow room inside the tooltip popup  -->
                    <Grid Margin="4,2,4,8">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7">
                            <Border.Effect>
                                <DropShadowEffect
                                    BlurRadius="14"
                                    Direction="270"
                                    Opacity="0.2"
                                    ShadowDepth="2"
                                    Color="Black" />
                            </Border.Effect>
                        </Border>
                        <Border
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="7"
                            SnapsToDevicePixels="True">
                            <ContentPresenter Margin="{TemplateBinding Padding}">
                                <ContentPresenter.Resources>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="TextWrapping" Value="Wrap" />
                                    </Style>
                                </ContentPresenter.Resources>
                            </ContentPresenter>
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  ================= TAB CONTROL =================  -->

    <!--
        Nothing styled these before - a bare <TabControl> was rendering with
        WPF's default 3D gray Windows-98-era chrome, which clashes hard
        against every card/dark-sidebar surface in this app. Flat underline-
        indicator style instead: no tab "folder" look, just a bottom border
        on whichever tab is selected, matching how the rest of the app
        favors flat surfaces + accent color over chrome and borders.
    -->

    <Style TargetType="TabControl">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="0" />
    </Style>

    <Style TargetType="TabItem">
        <!--  Was a hard-coded #9CA3AF (2.5:1 on white - too faint to read in Light)  -->
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontSize" Value="12.5" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Padding" Value="14,8" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="TabItem">
                    <Grid>
                        <Border
                            x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            CornerRadius="8,8,0,0">
                            <ContentPresenter
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                ContentSource="Header"
                                RecognizesAccessKey="True" />
                        </Border>
                        <!--  Underline grows out from the centre when a tab is selected  -->
                        <Border
                            x:Name="Indicator"
                            Height="2.5"
                            Margin="8,0"
                            VerticalAlignment="Bottom"
                            Background="{DynamicResource AccentGradient}"
                            CornerRadius="1.5"
                            RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="IndicatorScale" ScaleX="0" ScaleY="1" />
                            </Border.RenderTransform>
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowBg}" />
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            EasingFunction="{StaticResource EaseOut}"
                                            Storyboard.TargetName="IndicatorScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="1"
                                            Duration="0:0:0.25" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            EasingFunction="{StaticResource EaseOut}"
                                            Storyboard.TargetName="IndicatorScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="0"
                                            Duration="0:0:0.18" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ================= SHARED TOOL CONTROLS =================
        Consolidated here after an audit found several tools redefining
        byte-for-byte (or near-identical, drifted) copies of the same style
        in their own UserControl.Resources - StatusPillStyle in
        ApiTesterView/LogViewerView/NetworkToolsView, TransportButtonStyle in
        BackgroundRemoverView/ImageEditorView/VideoEditorView/VideoReplayView,
        etc. Centralizing them here means one edit updates every tool at
        once, and any new tool gets the same look for free instead of
        reinventing (and inevitably drifting from) it. Each view's local copy
        has been removed in favor of these.
    -->

    <!--
        Small muted caption over a field/section - was previously
        byte-identical in ApiTesterView and NetworkToolsView, and drifted
        slightly (12px SemiBold vs 11px Bold) in CodeToolkitView; all three
        now use this single definition.
    -->
    <Style x:Key="PaneLabel" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,0,8" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>

    <!--
        Small rounded status/count badge - was byte-identical in
        ApiTesterView, LogViewerView, and NetworkToolsView.
    -->
    <Style x:Key="StatusPillStyle" TargetType="Border">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="CornerRadius" Value="6" />
        <Setter Property="Background" Value="{DynamicResource RowBg}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--
        Monospace text area for code/JSON/log content that should wrap
        rather than scroll horizontally (API bodies, network payloads,
        regex input) - was byte-identical in ApiTesterView, NetworkToolsView,
        and RegexTesterView. Explicit Background/BorderBrush/Foreground
        setters here (rather than inheriting the implicit TextBox style
        above) are intentional - see CodeTextBoxNoWrap below for the sibling
        style used where wrapping would be wrong.
    -->
    <!--
        BasedOn the implicit TextBox style below so this actually gets the
        app's rounded/focus-glow template - it was missing that inheritance
        entirely, which is why response/request code panes rendered with
        plain square default WPF chrome instead of matching every other
        input in the app. Height/VerticalContentAlignment are overridden
        back to auto/top because the base style pins those for single-line
        inputs, which would otherwise squash this multi-line pane to 30px.
    -->
    <Style
        x:Key="CodeTextBox"
        BasedOn="{StaticResource {x:Type TextBox}}"
        TargetType="TextBox">
        <Setter Property="Padding" Value="10" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="VerticalAlignment" Value="Stretch" />
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="Background" Value="{DynamicResource InputBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="TextWrapping" Value="Wrap" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>

    <!--
        CodeToolkitView's own variant of the above - genuinely different on
        purpose (source code shouldn't line-wrap; it should scroll
        horizontally instead), so it keeps its own key rather than being
        forced into CodeTextBox. Renamed from CodeToolkitView's local
        "CodeTextBox" to this distinct name so the two no longer collide
        under one identifier that meant two different things.
    -->
    <Style
        x:Key="CodeTextBoxNoWrap"
        BasedOn="{StaticResource {x:Type TextBox}}"
        TargetType="TextBox">
        <Setter Property="AcceptsReturn" Value="True" />
        <Setter Property="AcceptsTab" Value="True" />
        <Setter Property="TextWrapping" Value="NoWrap" />
        <Setter Property="FontFamily" Value="Consolas" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="VerticalScrollBarVisibility" Value="Auto" />
        <Setter Property="HorizontalScrollBarVisibility" Value="Auto" />
        <Setter Property="Padding" Value="8" />

        <!--
            The base TextBox style above fixes Height=30 and centers content
            vertically, tuned for single-line inputs - both need clearing
            back to defaults here, or this multi-line code pane would get
            squashed into a 30px strip instead of filling its container.
        -->
        <Setter Property="Height" Value="Auto" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>

    <!--
        Round transport-control button (play/pause/skip/etc.). Hover used to
        be SidebarItemHoverBg - a dark slate (#435269) that, on a white card
        in the Light theme, put a dark circle behind a dark (TextPrimary)
        icon and made the icon vanish on hover. Now an accent-tinted wash
        with an accent icon, readable in both themes, plus a press spring.
    -->
    <Style x:Key="TransportButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
        <Setter Property="Margin" Value="4,0" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Bd"
                        Background="Transparent"
                        CornerRadius="20"
                        RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <ScaleTransform x:Name="BdScale" ScaleX="1" ScaleY="1" />
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentColorSubtle}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentColor}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="BdScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="0.9"
                                            Duration="0:0:0.05" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="BdScale"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="0.9"
                                            Duration="0:0:0.05" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            EasingFunction="{StaticResource EasePop}"
                                            Storyboard.TargetName="BdScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="1"
                                            Duration="0:0:0.28" />
                                        <DoubleAnimation
                                            EasingFunction="{StaticResource EasePop}"
                                            Storyboard.TargetName="BdScale"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="1"
                                            Duration="0:0:0.28" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        The larger accent-filled Play/Pause button. Must stay below
        TransportButtonStyle (BasedOn it). Same treatment as the hero
        buttons - glow on its own layer (was a literal #4C8DFF, the OLD
        accent, so it no longer matched), theme-aware fill, lift on hover
        and a spring on release - just circular.
    -->
    <Style
        x:Key="PlayPauseButtonStyle"
        BasedOn="{StaticResource TransportButtonStyle}"
        TargetType="Button">
        <Setter Property="Width" Value="52" />
        <Setter Property="Height" Value="52" />
        <Setter Property="FontSize" Value="18" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
                        <Grid.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
                                <TranslateTransform x:Name="RootLift" Y="0" />
                            </TransformGroup>
                        </Grid.RenderTransform>

                        <Ellipse Fill="{DynamicResource AccentFill}">
                            <Ellipse.Effect>
                                <DropShadowEffect
                                    x:Name="BdShadow"
                                    BlurRadius="18"
                                    Direction="270"
                                    Opacity="0.35"
                                    ShadowDepth="5"
                                    Color="{DynamicResource ButtonHoverGlowColor}" />
                            </Ellipse.Effect>
                        </Ellipse>

                        <!--  Glossy top highlight  -->
                        <Ellipse IsHitTestVisible="False">
                            <Ellipse.Fill>
                                <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                    <GradientStop Offset="0" Color="#33FFFFFF" />
                                    <GradientStop Offset="0.45" Color="#00FFFFFF" />
                                </LinearGradientBrush>
                            </Ellipse.Fill>
                        </Ellipse>

                        <Ellipse
                            x:Name="HoverWash"
                            Fill="White"
                            IsHitTestVisible="False"
                            Opacity="0" />

                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            EasingFunction="{StaticResource EasePop}"
                                            Storyboard.TargetName="RootScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="1.06"
                                            Duration="0:0:0.22" />
                                        <DoubleAnimation
                                            EasingFunction="{StaticResource EasePop}"
                                            Storyboard.TargetName="RootScale"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="1.06"
                                            Duration="0:0:0.22" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="BdShadow"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.6"
                                            Duration="0:0:0.18" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverWash"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.08"
                                            Duration="0:0:0.14" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="RootScale"
                                            Storyboard.TargetProperty="ScaleX"
                                            To="1"
                                            Duration="0:0:0.18" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="RootScale"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="1"
                                            Duration="0:0:0.18" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="BdShadow"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0.35"
                                            Duration="0:0:0.2" />
                                        <DoubleAnimation
                                            Storyboard.TargetName="HoverWash"
                                            Storyboard.TargetProperty="Opacity"
                                            To="0"
                                            Duration="0:0:0.2" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="RootLift"
                                            Storyboard.TargetProperty="Y"
                                            To="1.5"
                                            Duration="0:0:0.06" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            EasingFunction="{StaticResource EasePop}"
                                            Storyboard.TargetName="RootLift"
                                            Storyboard.TargetProperty="Y"
                                            To="0"
                                            Duration="0:0:0.28" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.45" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Collapse/expand handle for a narrow resizable side panel (e.g. the
        file queue toggle in BackgroundRemoverView). TransportButtonStyle
        was being reused here - it's fully transparent at rest (by design,
        for a 40px round media-control button) and disappears almost
        entirely when squeezed into a ~22px-wide strip, which is why it
        read as barely-there. This instead renders a small "grip" pill
        that's visible at rest against the surrounding panels, centered in
        whatever width the button is given, so it reads as a real
        resize/collapse affordance rather than dead space that happens to
        be clickable.
    -->
    <Style x:Key="PanelToggleButtonStyle" TargetType="Button">
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid Background="Transparent">
                        <Border
                            x:Name="Grip"
                            Width="18"
                            Height="52"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Background="{DynamicResource RowBg}"
                            BorderBrush="{DynamicResource CardBorder}"
                            BorderThickness="1"
                            CornerRadius="9"
                            RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="GripScale" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Grip" Property="Background" Value="{DynamicResource AccentColorSubtle}" />
                            <Setter TargetName="Grip" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentColor}" />
                            <Trigger.EnterActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="GripScale"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="1.06"
                                            Duration="0:0:0.12" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.EnterActions>
                            <Trigger.ExitActions>
                                <BeginStoryboard>
                                    <Storyboard>
                                        <DoubleAnimation
                                            Storyboard.TargetName="GripScale"
                                            Storyboard.TargetProperty="ScaleY"
                                            To="1"
                                            Duration="0:0:0.15" />
                                    </Storyboard>
                                </BeginStoryboard>
                            </Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Grip" Property="Background" Value="{DynamicResource AccentColorSubtle}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        DataGrid row highlight for "this is the item currently playing" -
        was byte-identical in VideoEditorView and VideoReplayView.
    -->
    <Style
        x:Key="PlaylistRowStyle"
        BasedOn="{StaticResource {x:Type DataGridRow}}"
        TargetType="{x:Type DataGridRow}">
        <Style.Triggers>
            <DataTrigger Binding="{Binding IsNowPlaying}" Value="True">
                <Setter Property="Background" Value="{DynamicResource AccentColorSubtle}" />
                <Setter Property="FontWeight" Value="SemiBold" />
            </DataTrigger>
        </Style.Triggers>
    </Style>

    <!--
        ================= FILE CARD LIST =================
        Shared "card row" look for a sidebar file/folder list, replacing a
        plain DisplayMemberPath ListBox with the icon-badge + name + inline
        action row already hand-rolled per-view in DuplicateFinderView's
        FolderList and ImageConvertPDFView's QueueList. Use inside an outer
        Border (ContentBg/CardBorder, CornerRadius 6-8) the same way those
        two views wrap their list, so FileCardListBoxStyle can stay
        borderless/transparent and let the outer Border supply the chrome.
    -->
    <Style x:Key="FileCardListBoxStyle" TargetType="ListBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Padding" Value="4" />
        <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled" />
        <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto" />
    </Style>

    <Style x:Key="FileCardListItemStyle" TargetType="ListBoxItem">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Margin" Value="0,0,0,4" />
        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ListBoxItem">
                    <Border
                        x:Name="RowBorder"
                        Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1"
                        CornerRadius="6">
                        <ContentPresenter Margin="8,6" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                        </Trigger>
                        <Trigger Property="IsSelected" Value="True">
                            <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource RowBg}" />
                            <Setter TargetName="RowBorder" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Neutral (non-destructive) sibling of IconButtonStyle - IconButtonStyle
        always tints red on hover because every existing use of it is a
        "remove this row" action, so it's the wrong choice for reorder
        actions like Move Up/Down that sit in the same row.
    -->
    <Style x:Key="RowMoveButtonStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Width" Value="24" />
        <Setter Property="Height" Value="24" />
        <Setter Property="Padding" Value="0" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Bd"
                        Background="{TemplateBinding Background}"
                        CornerRadius="12">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowBg}" />
                            <Setter Property="Foreground" Value="{DynamicResource AccentColor}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        ================= ELEVATION (opt-in) =================
        A richer, "floating" version of CardStyle/SidebarGroupCardStyle for
        views that want more visual depth than the standard flat card - a
        soft drop shadow instead of just a hairline border. Kept as
        separate opt-in styles rather than changed in place on CardStyle/
        SidebarGroupCardStyle so the other ~30 views already using those
        keep their current look until/unless they're deliberately moved
        over too.
    -->
    <!--
        CAUTION: an Effect on a Border renders EVERYTHING inside it through
        an offscreen bitmap - text drops from ClearType to greyscale, and a
        card holding a DataGrid/log pane gets slower on every update. Fine
        for small summary/hero cards; for content-heavy cards prefer
        ElevatedCardHost below, which casts the same shadow without that
        cost. Shadow now comes from the theme's CardElevation (much
        stronger in Dark, where a 0.16 black shadow was invisible).
    -->
    <Style
        x:Key="ElevatedCardStyle"
        BasedOn="{StaticResource CardStyle}"
        TargetType="Border">
        <Setter Property="Effect" Value="{DynamicResource CardElevation}" />
    </Style>

    <!--
        Shadowed card WITHOUT putting an Effect on the content: the shadow
        is cast by an empty sibling Border behind the card. Same look as
        ElevatedCardStyle, crisp text, no offscreen rendering. Usage:

        <ContentControl Style="{StaticResource ElevatedCardHost}">
            ... card content ...
        </ContentControl>
    -->
    <Style x:Key="ElevatedCardHost" TargetType="ContentControl">
        <Setter Property="Background" Value="{DynamicResource CardBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Padding" Value="16" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Grid>
                        <Border
                            Background="{TemplateBinding Background}"
                            CornerRadius="12"
                            Effect="{DynamicResource CardElevation}" />
                        <Border
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="12">
                            <ContentPresenter />
                        </Border>
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style
        x:Key="ElevatedSidebarGroupCardStyle"
        BasedOn="{StaticResource SidebarGroupCardStyle}"
        TargetType="Border">
        <Setter Property="Effect">
            <Setter.Value>
                <DropShadowEffect
                    BlurRadius="14"
                    Direction="270"
                    Opacity="0.14"
                    ShadowDepth="3"
                    Color="Black" />
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Shared template for the big "hero" buttons (AccentPrimaryButtonStyle,
        AccentRedButtonStyle). Previously two ~110-line copies differing only
        in two colour literals (#4C8DFF - the OLD accent, so the shadow no
        longer matched the button - and Background="Red"). Now: fill comes
        from Background, glow colour from ButtonHoverGlowColor (theme-aware,
        overridable per style), and the glow lives on its own layer behind
        the label so text stays crisp.
    -->
    <ControlTemplate x:Key="HeroButtonTemplate" TargetType="Button">
        <Grid x:Name="Root" RenderTransformOrigin="0.5,0.5">
            <Grid.RenderTransform>
                <TransformGroup>
                    <ScaleTransform x:Name="RootScale" ScaleX="1" ScaleY="1" />
                    <TranslateTransform x:Name="RootLift" Y="0" />
                </TransformGroup>
            </Grid.RenderTransform>

            <Border Background="{TemplateBinding Background}" CornerRadius="10">
                <Border.Effect>
                    <DropShadowEffect
                        x:Name="BdShadow"
                        BlurRadius="18"
                        Direction="270"
                        Opacity="0.32"
                        ShadowDepth="4"
                        Color="{DynamicResource ButtonHoverGlowColor}" />
                </Border.Effect>
            </Border>

            <Border
                x:Name="Bd"
                Background="{TemplateBinding Background}"
                CornerRadius="10" />

            <!--  Glossy top highlight  -->
            <Border
                Height="18"
                VerticalAlignment="Top"
                CornerRadius="10,10,0,0"
                IsHitTestVisible="False">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                        <GradientStop Offset="0" Color="#33FFFFFF" />
                        <GradientStop Offset="1" Color="#00FFFFFF" />
                    </LinearGradientBrush>
                </Border.Background>
            </Border>

            <Border
                x:Name="HoverWash"
                Background="White"
                CornerRadius="10"
                IsHitTestVisible="False"
                Opacity="0" />
            <Border
                x:Name="PressWash"
                Background="Black"
                CornerRadius="10"
                IsHitTestVisible="False"
                Opacity="0" />

            <ContentPresenter
                Margin="{TemplateBinding Padding}"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                RecognizesAccessKey="True">
                <ContentPresenter.Resources>
                                <Style BasedOn="{StaticResource ButtonLabelTextStyle}" TargetType="TextBlock" />
                            </ContentPresenter.Resources>
            </ContentPresenter>
        </Grid>
        <ControlTemplate.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetName="HoverWash"
                                Storyboard.TargetProperty="Opacity"
                                To="0.08"
                                Duration="0:0:0.14" />
                            <DoubleAnimation
                                Storyboard.TargetName="BdShadow"
                                Storyboard.TargetProperty="Opacity"
                                To="0.55"
                                Duration="0:0:0.18" />
                            <DoubleAnimation
                                EasingFunction="{StaticResource EaseOut}"
                                Storyboard.TargetName="RootLift"
                                Storyboard.TargetProperty="Y"
                                To="-2"
                                Duration="0:0:0.2" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetName="HoverWash"
                                Storyboard.TargetProperty="Opacity"
                                To="0"
                                Duration="0:0:0.2" />
                            <DoubleAnimation
                                Storyboard.TargetName="BdShadow"
                                Storyboard.TargetProperty="Opacity"
                                To="0.32"
                                Duration="0:0:0.2" />
                            <DoubleAnimation
                                EasingFunction="{StaticResource EaseOut}"
                                Storyboard.TargetName="RootLift"
                                Storyboard.TargetProperty="Y"
                                To="0"
                                Duration="0:0:0.22" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsPressed" Value="True">
                <Trigger.EnterActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetName="PressWash"
                                Storyboard.TargetProperty="Opacity"
                                To="0.12"
                                Duration="0:0:0.06" />
                            <DoubleAnimation
                                Storyboard.TargetName="RootScale"
                                Storyboard.TargetProperty="ScaleX"
                                To="0.96"
                                Duration="0:0:0.06" />
                            <DoubleAnimation
                                Storyboard.TargetName="RootScale"
                                Storyboard.TargetProperty="ScaleY"
                                To="0.96"
                                Duration="0:0:0.06" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.EnterActions>
                <Trigger.ExitActions>
                    <BeginStoryboard>
                        <Storyboard>
                            <DoubleAnimation
                                Storyboard.TargetName="PressWash"
                                Storyboard.TargetProperty="Opacity"
                                To="0"
                                Duration="0:0:0.2" />
                            <DoubleAnimation
                                EasingFunction="{StaticResource EasePop}"
                                Storyboard.TargetName="RootScale"
                                Storyboard.TargetProperty="ScaleX"
                                To="1"
                                Duration="0:0:0.3" />
                            <DoubleAnimation
                                EasingFunction="{StaticResource EasePop}"
                                Storyboard.TargetName="RootScale"
                                Storyboard.TargetProperty="ScaleY"
                                To="1"
                                Duration="0:0:0.3" />
                        </Storyboard>
                    </BeginStoryboard>
                </Trigger.ExitActions>
            </Trigger>
            <Trigger Property="IsEnabled" Value="False">
                <Setter Property="Opacity" Value="0.45" />
                <Setter Property="Cursor" Value="Arrow" />
            </Trigger>
        </ControlTemplate.Triggers>
    </ControlTemplate>

    <!--  The one standout action on a page (e.g. Stitch Videos)  -->
    <Style x:Key="AccentPrimaryButtonStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="Background" Value="{DynamicResource AccentFill}" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="FontSize" Value="13.5" />
        <Setter Property="Padding" Value="16,6" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
        <Setter Property="Template" Value="{StaticResource HeroButtonTemplate}" />
    </Style>

    <!--  Destructive hero action - same template, danger fill + red glow  -->
    <Style
        x:Key="AccentRedButtonStyle"
        BasedOn="{StaticResource AccentPrimaryButtonStyle}"
        TargetType="Button">
        <Style.Resources>
            <Color x:Key="ButtonHoverGlowColor">#DC2626</Color>
        </Style.Resources>
        <Setter Property="Background" Value="{DynamicResource DangerFill}" />
    </Style>

    <!--
        ================= PAGE HEADER ICON BADGE =================
        Small gradient square sitting to the left of a page's PageTitle/
        PageSubtitle stack, in the header card at the top of a view - first
        used in VideoEditorView, meant to be reused on every other view's
        header card for a consistent look across the whole suite. Usage:

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>
            <Border Grid.Column="0" Style="{StaticResource PageHeaderIconBadgeStyle}">
                <TextBlock Style="{StaticResource PageHeaderIconGlyphStyle}" Text="&#xE714;" />
            </Border>
            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock Style="{StaticResource PageTitle}" Text="{DynamicResource Str_X_Title}" />
                <TextBlock Style="{StaticResource PageSubtitle}" Text="{DynamicResource Str_X_Subtitle}" />
            </StackPanel>
        </Grid>

        Swap only the Text glyph (a Segoe MDL2 Assets code point) per view -
        everything else is shared. Uses the theme's AccentGradient, so it
        matches MainWindow's header badge and follows Light/Dark. (Was two
        literals - the OLD #4C8DFF accent into purple - that no longer
        matched the rest of the app.)
    -->
    <Style x:Key="PageHeaderIconBadgeStyle" TargetType="Border">
        <Setter Property="Width" Value="44" />
        <Setter Property="Height" Value="44" />
        <Setter Property="Margin" Value="0,0,14,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{DynamicResource AccentGradient}" />
    </Style>

    <Style x:Key="PageHeaderIconGlyphStyle" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
        <Setter Property="FontSize" Value="20" />
        <Setter Property="Foreground" Value="White" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>


    <!--
        =====================================================================
        VIEW KIT - reusable building blocks for tool views
        =====================================================================
        Every view restyle uses these instead of hand-rolling its own, so
        the whole suite keeps one friendly, non-flat look:
        - SidebarGroupHeader / CardHeader : gradient icon chip + title
        - EmptyStateBadge                 : soft round icon for empty states
        - InputBarStyle + Bare*           : one rounded "search bar" that
        holds several inputs
        - ModeToggleTallStyle             : icon-over-label segmented pill
        - DropZoneStyle                   : dashed drop target
        Motion helpers for code-behind live in Controls/UiMotion.cs.
    -->

    <!--
        Sidebar card title with a small gradient icon chip.
        Usage:
        <ContentControl
            Content="REPLAY MODE"
            Style="{StaticResource SidebarGroupHeader}"
            Tag="{x:Static materialDesign:PackIconKind.RepeatVariant}" />
    -->
    <Style x:Key="SidebarGroupHeader" TargetType="ContentControl">
        <Setter Property="Margin" Value="0,0,0,10" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <StackPanel Orientation="Horizontal">
                        <Border
                            Width="22"
                            Height="22"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AccentGradient}"
                            CornerRadius="6">
                            <materialDesign:PackIcon
                                Width="13"
                                Height="13"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="White"
                                Kind="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Border>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="{DynamicResource SidebarTextMuted}"
                            Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Same idea, sized for a heading inside a content card (Playlist, Response, ...)  -->
    <Style x:Key="CardHeader" TargetType="ContentControl">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <StackPanel Orientation="Horizontal">
                        <Border
                            Width="28"
                            Height="28"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AccentGradient}"
                            CornerRadius="8">
                            <materialDesign:PackIcon
                                Width="16"
                                Height="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="White"
                                Kind="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                        </Border>
                        <TextBlock
                            VerticalAlignment="Center"
                            Style="{StaticResource SectionHeading}"
                            Text="{Binding Content, RelativeSource={RelativeSource TemplatedParent}}" />
                    </StackPanel>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Soft round icon for empty states ("nothing here yet")  -->
    <Style x:Key="EmptyStateBadge" TargetType="ContentControl">
        <Setter Property="Width" Value="56" />
        <Setter Property="Height" Value="56" />
        <Setter Property="HorizontalAlignment" Value="Center" />
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ContentControl">
                    <Border Background="{DynamicResource AccentColorSubtle}" CornerRadius="28">
                        <materialDesign:PackIcon
                            Width="26"
                            Height="26"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource AccentColor}"
                            Kind="{Binding Tag, RelativeSource={RelativeSource TemplatedParent}}" />
                    </Border>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        One rounded field that hosts several borderless inputs (e.g. method
        dropdown + URL box), like a browser address bar. Border turns accent
        on hover and while any child has keyboard focus. No Effect/glow on
        purpose - it would force the text inside to render blurry.
    -->
    <Style x:Key="InputBarStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource InputBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource InputBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="MinHeight" Value="36" />
        <Setter Property="SnapsToDevicePixels" Value="True" />
        <Style.Triggers>
            <Trigger Property="IsMouseOver" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
            </Trigger>
            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                <Setter Property="BorderThickness" Value="1.5" />
            </Trigger>
        </Style.Triggers>
    </Style>

    <!--  Borderless inputs for use inside InputBarStyle  -->
    <Style
        x:Key="BareTextBox"
        BasedOn="{StaticResource {x:Type TextBox}}"
        TargetType="TextBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Padding" Value="10,0" />
    </Style>

    <Style
        x:Key="BareComboBox"
        BasedOn="{StaticResource {x:Type ComboBox}}"
        TargetType="ComboBox">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Height" Value="Auto" />
    </Style>

    <!--  Thin vertical divider between inputs inside an InputBar  -->
    <Style x:Key="InputBarDivider" TargetType="Border">
        <Setter Property="Width" Value="1" />
        <Setter Property="Margin" Value="0,7" />
        <Setter Property="Background" Value="{DynamicResource InputBorder}" />
    </Style>

    <!--
        Segmented toggle with an icon above its label (roomier than the
        34px ModeToggleButtonStyle). Put a StackPanel (PackIcon + TextBlock)
        in Content.
    -->
    <Style
        x:Key="ModeToggleTallStyle"
        BasedOn="{StaticResource ModeToggleButtonStyle}"
        TargetType="RadioButton">
        <Setter Property="MinHeight" Value="54" />
        <Setter Property="FontSize" Value="11.5" />
    </Style>

    <!--  Compact "chip" that groups a small control cluster (volume, speed, ...)  -->
    <Style x:Key="ControlChipStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource RowBg}" />
        <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="18" />
        <Setter Property="Padding" Value="4,2,10,2" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  Icon + text pill for small stats (latency, size, count ...)  -->
    <Style
        x:Key="IconStatusPillStyle"
        BasedOn="{StaticResource StatusPillStyle}"
        TargetType="Border">
        <Setter Property="Padding" Value="8,4,10,4" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="RenderTransformOrigin" Value="0.5,0.5" />
    </Style>

    <!--
        Full-view drop target shown while files are dragged over a view.
        Keep IsHitTestVisible="False" so it never swallows the drop itself.
    -->
    <Style x:Key="DropZoneStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource AccentColorSubtle}" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="IsHitTestVisible" Value="False" />
        <Setter Property="Visibility" Value="Collapsed" />
        <Setter Property="Opacity" Value="0.96" />
    </Style>

    <!--
        ================= HOISTED SHARED STYLES =================
        These used to be copy-pasted into each view's UserControl.Resources.
        A view can still define its own style with the same key to override
        one of these locally (resource lookup finds the local one first).
    -->

    <!--  Small helper text under a control on the dark options sidebar  -->
    <Style x:Key="SidebarHint" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,6,0,0" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarTextMuted}" />
        <Setter Property="TextWrapping" Value="Wrap" />
    </Style>

    <!--  Label left of a slider on the sidebar, and the value pill right of it  -->
    <Style x:Key="SliderLabel" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarTextMuted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  AccentFill + white keeps 4.6-4.75:1 in both themes  -->
    <Style x:Key="SliderValuePill" TargetType="Border">
        <Setter Property="Padding" Value="8,2" />
        <Setter Property="Background" Value="{DynamicResource AccentFill}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>

    <!--  Stat tile: small number-over-caption card used by the network and system tools  -->
    <Style x:Key="StatTileStyle" TargetType="Border">
        <Setter Property="Background" Value="{DynamicResource RowBg}" />
        <Setter Property="CornerRadius" Value="{StaticResource RadiusMd}" />
        <Setter Property="Padding" Value="12,8" />
        <Setter Property="Margin" Value="0,0,8,8" />
        <Setter Property="MinWidth" Value="96" />
    </Style>

    <Style x:Key="StatValueStyle" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,2,0,0" />
        <Setter Property="FontSize" Value="17" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
    </Style>

    <Style x:Key="StatLabelStyle" TargetType="TextBlock">
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>

    <!--  Thin progress meter (disk speed, internet speed, password strength)  -->
    <Style x:Key="MeterBarStyle" TargetType="ProgressBar">
        <Setter Property="Height" Value="6" />
        <Setter Property="Maximum" Value="100" />
        <Setter Property="Foreground" Value="{DynamicResource AccentColor}" />
        <Setter Property="Background" Value="{DynamicResource RowBg}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="ProgressBar">
                    <Grid>
                        <Border Background="{TemplateBinding Background}" CornerRadius="3" />
                        <Border x:Name="PART_Track" CornerRadius="3" />
                        <Border
                            x:Name="PART_Indicator"
                            HorizontalAlignment="Left"
                            Background="{TemplateBinding Foreground}"
                            CornerRadius="3" />
                    </Grid>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Unit text after a number box (px, ms, ...)  -->
    <Style x:Key="UnitSuffix" TargetType="TextBlock">
        <Setter Property="Margin" Value="0,0,10,0" />
        <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="FontSize" Value="11" />
        <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
    </Style>

    <!--  Round colour swatch button with an accent ring on hover  -->
    <Style x:Key="SwatchPickerStyle" TargetType="Button">
        <Setter Property="Width" Value="22" />
        <Setter Property="Height" Value="22" />
        <Setter Property="Margin" Value="7,0,0,0" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Grid>
                        <Ellipse
                            x:Name="Ring"
                            Margin="-2"
                            Stroke="Transparent"
                            StrokeThickness="2" />
                        <Ellipse
                            Fill="{TemplateBinding Background}"
                            Stroke="{DynamicResource InputBorder}"
                            StrokeThickness="1" />
                    </Grid>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentColor}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--  Quick-pick chip on the dark options sidebar (sizes, ranges, presets)  -->
    <Style x:Key="PresetChipStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,4,4" />
        <Setter Property="MinHeight" Value="26" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarText}" />
        <Setter Property="FontSize" Value="11.5" />
        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Bd"
                        Padding="9,3"
                        Background="{DynamicResource SidebarInputBg}"
                        BorderBrush="{DynamicResource SidebarInputBorder}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource RadiusSm}">
                        <ContentPresenter Margin="0,2" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentPresenter.Resources>
                                <Style BasedOn="{StaticResource ButtonLabelTextStyle}" TargetType="TextBlock" />
                            </ContentPresenter.Resources>
                        </ContentPresenter>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentColorSubtle}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Rounded "pill" quick-pick chip for the options sidebar: Subnet Calculator examples and prefixes, Unit Converter
        favorites and recents. Sidebar-dark fill with an accent outline (readable in both themes); on hover it fills with the accent colour.
    -->
    <Style x:Key="PillChipStyle" TargetType="Button">
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Margin" Value="0,0,6,6" />
        <Setter Property="MinHeight" Value="28" />
        <Setter Property="Foreground" Value="{DynamicResource SidebarText}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Bd"
                        Padding="12,4"
                        Background="{DynamicResource SidebarInputBg}"
                        BorderBrush="{DynamicResource AccentColor}"
                        BorderThickness="1"
                        CornerRadius="14">
                        <ContentPresenter
                            x:Name="Cp"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            TextElement.FontFamily="{TemplateBinding FontFamily}"
                            TextElement.FontSize="{TemplateBinding FontSize}"
                            TextElement.FontWeight="{TemplateBinding FontWeight}"
                            TextElement.Foreground="{TemplateBinding Foreground}" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentFill}" />
                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFill}" />
                            <Setter TargetName="Cp" Property="TextElement.Foreground" Value="White" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.8" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter TargetName="Bd" Property="Opacity" Value="0.5" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Round icon button for the fixed-dark media players (video / image viewer).
        Hex colours are deliberate: the stage is dark in both themes.
    -->
    <Style x:Key="PlayerIconButtonStyle" TargetType="Button">
        <Setter Property="Width" Value="36" />
        <Setter Property="Height" Value="36" />
        <Setter Property="Cursor" Value="Hand" />
        <Setter Property="Foreground" Value="#E9EBEF" />
        <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border
                        x:Name="Bd"
                        Background="#1AFFFFFF"
                        CornerRadius="18">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#2AFFFFFF" />
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Bd" Property="Background" Value="#38FFFFFF" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.35" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <!--
        Group row for the grouped result grids (Duplicate Data, Find Similar Files): a chevron that folds the
        group's rows away, then the view's own header. The open/closed state is the group's IsExpanded
        (Content is the CollectionViewGroup, Name is the group object), so "collapse all" is just setting it.
    -->
    <Style x:Key="CollapsibleGroupItemStyle" TargetType="GroupItem">
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="GroupItem">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ToggleButton
                                x:Name="GroupToggle"
                                Width="26"
                                Height="26"
                                Margin="0,9,6,0"
                                VerticalAlignment="Top"
                                Cursor="Hand"
                                Focusable="False"
                                IsChecked="{Binding Name.IsExpanded, Mode=TwoWay}"
                                ToolTip="Fold or unfold this group">
                                <ToggleButton.Template>
                                    <ControlTemplate TargetType="ToggleButton">
                                        <Border x:Name="Bd" Background="Transparent" CornerRadius="8">
                                            <materialDesign:PackIcon
                                                x:Name="Chevron"
                                                Width="18"
                                                Height="18"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource TextSecondary}"
                                                Kind="ChevronDown" />
                                        </Border>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="IsChecked" Value="False">
                                                <Setter TargetName="Chevron" Property="Kind" Value="ChevronRight" />
                                            </Trigger>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentColorSubtle}" />
                                                <Setter TargetName="Chevron" Property="Foreground" Value="{DynamicResource AccentColor}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </ToggleButton.Template>
                            </ToggleButton>
                            <ContentPresenter Grid.Column="1" />
                        </Grid>
                        <ItemsPresenter x:Name="GroupRows" />
                    </StackPanel>
                    <ControlTemplate.Triggers>
                        <Trigger SourceName="GroupToggle" Property="IsChecked" Value="False">
                            <Setter TargetName="GroupRows" Property="Visibility" Value="Collapsed" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

</ResourceDictionary>
