    <system:String x:Key="Str_MetaClean_EmptyTitle">Aún no hay imágenes</system:String>
    <system:String x:Key="Str_MetaClean_EmptyHint">Suelta fotos o carpetas aquí, o usa la tarjeta Imágenes. Verás qué esconde cada una antes de limpiarla.</system:String>
