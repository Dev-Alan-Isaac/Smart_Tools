    <system:String x:Key="Str_MetaClean_CleanCopies">{0} copias limpias</system:String>
    <system:String x:Key="Str_Tour_MetaClean_Input_Title">Tus imágenes</system:String>
    <system:String x:Key="Str_Tour_MetaClean_Input_Text">Añade fotos o carpetas enteras. Cada una muestra lo que lleva escondido: una ubicación GPS, la cámara y la fecha en que se tomó.</system:String>
    <system:String x:Key="Str_Tour_MetaClean_Mode_Title">Qué quitar</system:String>
    <system:String x:Key="Str_Tour_MetaClean_Mode_Text">Quita todo, o solo la ubicación y deja el resto. Las copias limpias llevan un final corto añadido al nombre.</system:String>
    <system:String x:Key="Str_Tour_MetaClean_Output_Title">Dónde van las copias</system:String>
    <system:String x:Key="Str_Tour_MetaClean_Output_Text">Junto a los originales o en una carpeta que elijas. Los originales nunca se cambian ni se reemplazan.</system:String>
    <system:String x:Key="Str_Tour_MetaClean_Run_Title">Limpiar</system:String>
    <system:String x:Key="Str_Tour_MetaClean_Run_Text">Inicia el lote. Las etiquetas muestran cuántas fotos llevan ubicación y cuántas se limpiaron.</system:String>
    <system:String x:Key="Str_Tour_MetaClean_Results_Title">Resultados</system:String>
    <system:String x:Key="Str_Tour_MetaClean_Results_Text">Lo que escondía cada imagen y qué pasó con ella. Pon el cursor sobre un estado para ver por qué se omitió una.</system:String>
    <system:String x:Key="Str_Tool_pdf-reader_Name">Lector y firma de PDF</system:String>
    <system:String x:Key="Str_Tool_pdf-reader_Description">Lee un PDF, añade tu firma, texto, una fecha o una marca y guarda una copia firmada</system:String>
    <system:String x:Key="Str_PdfReader_FileHeader">EL PDF</system:String>
    <system:String x:Key="Str_PdfReader_Open">Abrir un PDF…</system:String>
    <system:String x:Key="Str_PdfReader_Password">Contraseña</system:String>
