    <system:String x:Key="Str_PdfReader_Picture">Imagen</system:String>
    <system:String x:Key="Str_PdfReader_Forget">Olvidar mi firma</system:String>
    <system:String x:Key="Str_PdfReader_SignatureHint">Dibújala con el ratón, escribe tu nombre o usa una foto de tu firma sobre papel blanco. Se guarda en este PC para hacerla una sola vez. Es una imagen de una firma, no una firma digital certificada.</system:String>
