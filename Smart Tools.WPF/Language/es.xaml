    <!--  Prueba de salida de audio (audio-output-test)  -->
    <system:String x:Key="Str_AudioOut_Header">Prueba de salida de audio</system:String>
    <system:String x:Key="Str_AudioOut_DeviceHeader">DISPOSITIVO DE SALIDA</system:String>
    <system:String x:Key="Str_AudioOut_DeviceTip">Cualquier altavoz, auricular, DAC USB o salida Bluetooth que Windows tenga activo. La estrella es el predeterminado de Windows.</system:String>
    <system:String x:Key="Str_AudioOut_Refresh">Buscar dispositivos otra vez</system:String>
    <system:String x:Key="Str_AudioOut_NoDevice">No se encontró ningún dispositivo de salida activo.</system:String>
    <system:String x:Key="Str_AudioOut_DeviceInfo">{0} canales · {1:0.#} kHz (el formato propio del dispositivo)</system:String>
    <system:String x:Key="Str_AudioOut_LevelHeader">NIVEL</system:String>
    <system:String x:Key="Str_AudioOut_Level">Volumen</system:String>
    <system:String x:Key="Str_AudioOut_LevelSafety">Empieza con el volumen bajo y súbelo despacio. El máximo de este control sigue siendo fuerte en auriculares e intrauditivos.</system:String>
    <system:String x:Key="Str_AudioOut_SignalHeader">SEÑAL</system:String>
    <system:String x:Key="Str_AudioOut_Pitch">Tono</system:String>
    <system:String x:Key="Str_AudioOut_WaveSine">Seno</system:String>
    <system:String x:Key="Str_AudioOut_WaveSquare">Cuadr.</system:String>
    <system:String x:Key="Str_AudioOut_WaveTriangle">Triáng.</system:String>
    <system:String x:Key="Str_AudioOut_WaveSaw">Sierra</system:String>
    <system:String x:Key="Str_AudioOut_SweepLength">Duración del barrido</system:String>
    <system:String x:Key="Str_AudioOut_SweepRange">Sube de 20 Hz a 20 kHz y se repite.</system:String>
    <system:String x:Key="Str_AudioOut_NoisePink">Rosa</system:String>
    <system:String x:Key="Str_AudioOut_NoiseWhite">Blanco</system:String>
    <system:String x:Key="Str_AudioOut_PhaseIn">En fase</system:String>
    <system:String x:Key="Str_AudioOut_PhaseOut">Fuera de fase</system:String>
    <system:String x:Key="Str_AudioOut_PhaseAlt">Alternar</system:String>
    <system:String x:Key="Str_AudioOut_PhaseClick">Clic</system:String>
    <system:String x:Key="Str_AudioOut_ChannelsNote">Cada canal por turno: un pitido para el primero, dos para el segundo, y así. Haz clic en una ficha para dejar un canal fuera.</system:String>
    <system:String x:Key="Str_AudioOut_TestChannels">Canales</system:String>
    <system:String x:Key="Str_AudioOut_TestPhase">Fase</system:String>
    <system:String x:Key="Str_AudioOut_TestTone">Tono</system:String>
    <system:String x:Key="Str_AudioOut_TestSweep">Barrido</system:String>
    <system:String x:Key="Str_AudioOut_TestNoise">Ruido</system:String>
    <system:String x:Key="Str_AudioOut_ChannelsHeader">Canales (clic para incluir o dejar fuera)</system:String>
    <system:String x:Key="Str_AudioOut_TileTip">Clic para incluir o dejar fuera este canal</system:String>
    <system:String x:Key="Str_AudioOut_AllTip">Vuelve a activar todos los canales</system:String>
    <system:String x:Key="Str_AudioOut_All">Todos los canales</system:String>
    <system:String x:Key="Str_AudioOut_Play">Reproducir</system:String>
    <system:String x:Key="Str_AudioOut_Stop">Detener</system:String>
    <system:String x:Key="Str_AudioOut_Stopped">Detenido</system:String>
    <system:String x:Key="Str_AudioOut_OpenFailed">No se pudo abrir el dispositivo: {0}</system:String>
    <system:String x:Key="Str_AudioOut_StateIn">En fase: el sonido debe estar en el centro</system:String>
    <system:String x:Key="Str_AudioOut_StateOut">Fuera de fase: el sonido debe sentirse ancho y hueco</system:String>
    <system:String x:Key="Str_AudioOut_StateIdle">Pulsa Reproducir</system:String>
    <system:String x:Key="Str_AudioOut_ClickNormal">Clic 1: ambos lados empujan igual</system:String>
    <system:String x:Key="Str_AudioOut_ClickInverted">Clic 2: el lado derecho está invertido</system:String>
    <system:String x:Key="Str_AudioOut_Guide_Channels">Debes oír cada canal por separado, en orden, con el número correcto de pitidos y con un volumen parecido. Un canal mudo, bajo, con crujidos o del lado equivocado apunta a un conector malo, un cable dañado o una configuración de altavoces errónea. En auriculares, un pitido va en el oído izquierdo y dos en el derecho.</system:String>
    <system:String x:Key="Str_AudioOut_Guide_Phase_InPhase">Ambos lados suenan exactamente igual. El sonido debe aparecer en el centro de la cabeza (o entre los altavoces). Si parece venir de un lado, o ancho y vago, puede que un lado esté conectado al revés o que el balance esté mal.</system:String>
    <system:String x:Key="Str_AudioOut_Guide_Phase_Out">El lado derecho está invertido. Debe sonar ancho, hueco, con pocos graves y difícil de ubicar. Compáralo con En fase: si En fase suena así, uno de tus transductores está conectado al revés.</system:String>
    <system:String x:Key="Str_AudioOut_Guide_Phase_Alt">Alterna entre En fase y Fuera de fase cada tres segundos. En fase debe sonar firme y centrado; Fuera de fase, más ancho y delgado. Si suenan igual, puede que un lado esté mudo o que la salida sea mono.</system:String>
    <system:String x:Key="Str_AudioOut_Guide_Phase_Click">Un clic por segundo. El primero empuja ambos transductores en el mismo sentido; el segundo invierte el derecho. En un altavoz o transductor que puedas ver o sentir, el clic 1 debe mover ambos lados en el mismo sentido. Uno conectado al revés se mueve al contrario. Se comprueba mejor con micrófono, osciloscopio o a simple vista en un woofer.</system:String>
    <system:String x:Key="Str_AudioOut_Guide_Tone">Un tono constante. Úsalo para revisar una frecuencia: un traqueteo, zumbido o ronroneo, un canal mucho más bajo en un tono, o los límites del oído (los oídos mayores y los intrauditivos pequeños se apagan por encima de 15 a 18 kHz). Cuadrada, triangular y sierra añaden armónicos y suenan más brillantes.</system:String>
    <system:String x:Key="Str_AudioOut_Guide_Sweep">Un deslizamiento lento de los graves más profundos a los agudos más altos. Escucha caídas y subidas de volumen, traqueteos, zumbidos, un corte repentino o un lado que desaparece en algún tono. Deja solo un canal activo para saber qué lado falla.</system:String>
    <system:String x:Key="Str_AudioOut_Guide_Noise">Siseo constante, distinto en cada canal. El ruido rosa suena parejo en todo el rango y es el mejor para comparar el volumen izquierdo y derecho. El blanco es más brillante. Ambos lados deben sonar igual de fuertes e igual de anchos. Apaga canales para comparar de uno en uno.</system:String>
    <system:String x:Key="Str_AudioOut_Spk_L">Izquierdo</system:String>
    <system:String x:Key="Str_AudioOut_Spk_R">Derecho</system:String>
    <system:String x:Key="Str_AudioOut_Spk_M">Mono</system:String>
    <system:String x:Key="Str_AudioOut_Spk_FL">Frontal izq.</system:String>
    <system:String x:Key="Str_AudioOut_Spk_FR">Frontal der.</system:String>
    <system:String x:Key="Str_AudioOut_Spk_C">Centro</system:String>
    <system:String x:Key="Str_AudioOut_Spk_LFE">Subwoofer</system:String>
    <system:String x:Key="Str_AudioOut_Spk_BL">Trasero izq.</system:String>
    <system:String x:Key="Str_AudioOut_Spk_BR">Trasero der.</system:String>
    <system:String x:Key="Str_AudioOut_Spk_SL">Lateral izq.</system:String>
    <system:String x:Key="Str_AudioOut_Spk_SR">Lateral der.</system:String>

    <!--  Prueba de mando (game-controller)  -->
    <system:String x:Key="Str_GameCtl_Header">Prueba de mando</system:String>
    <system:String x:Key="Str_GameCtl_ControllerHeader">MANDO</system:String>
    <system:String x:Key="Str_GameCtl_Refresh">Buscar mandos</system:String>
    <system:String x:Key="Str_GameCtl_NoneFound">No se encontró ningún mando.</system:String>
    <system:String x:Key="Str_GameCtl_Capabilities">{0} ejes · {1} botones</system:String>
    <system:String x:Key="Str_GameCtl_Battery">batería</system:String>
    <system:String x:Key="Str_GameCtl_EmptyTitle">No se encontró ningún mando</system:String>
    <system:String x:Key="Str_GameCtl_EmptyHint">Conecta un mando por USB, o empareja uno por Bluetooth, y pulsa el botón de abajo. Se leen tanto los mandos tipo Xbox como otros dispositivos (joysticks, volantes y muchos mandos de PlayStation o genéricos).</system:String>
    <system:String x:Key="Str_GameCtl_NothingNew">Sin cambios: siguen conectados los mismos mandos.</system:String>
    <system:String x:Key="Str_GameCtl_Plugged">Mando conectado ({0} encontrados)</system:String>
    <system:String x:Key="Str_GameCtl_Unplugged">Mando desconectado ({0} encontrados)</system:String>
    <system:String x:Key="Str_GameCtl_Lost">El mando dejó de responder. Revisa el cable o la batería.</system:String>
    <system:String x:Key="Str_GameCtl_DeadzoneHeader">ZONAS MUERTAS</system:String>
    <system:String x:Key="Str_GameCtl_ModeAxial">Axial</system:String>
    <system:String x:Key="Str_GameCtl_ModeAxialTip">Cada dirección por separado: una zona muerta cuadrada.</system:String>
    <system:String x:Key="Str_GameCtl_ModeRadial">Radial</system:String>
    <system:String x:Key="Str_GameCtl_ModeRadialTip">Por distancia al centro: una zona muerta redonda.</system:String>
    <system:String x:Key="Str_GameCtl_ModeScaled">Escalada</system:String>
    <system:String x:Key="Str_GameCtl_ModeScaledTip">Zona muerta redonda y el resto estirado para que no haya salto al terminar. La mejor para casi todos los juegos.</system:String>
    <system:String x:Key="Str_GameCtl_LeftStick">Palanca izquierda</system:String>
    <system:String x:Key="Str_GameCtl_RightStick">Palanca derecha</system:String>
    <system:String x:Key="Str_GameCtl_Triggers">Gatillos</system:String>
    <system:String x:Key="Str_GameCtl_Defaults">Valores de Windows</system:String>
    <system:String x:Key="Str_GameCtl_DefaultsTip">Los valores que recomienda Microsoft para mandos tipo Xbox: 24%, 27% y 12%.</system:String>
    <system:String x:Key="Str_GameCtl_DefaultsApplied">Zonas muertas puestas a los valores de Windows</system:String>
    <system:String x:Key="Str_GameCtl_VibrationHeader">VIBRACIÓN</system:String>
    <system:String x:Key="Str_GameCtl_MotorLeft">Motor izquierdo (grave)</system:String>
    <system:String x:Key="Str_GameCtl_MotorRight">Motor derecho (agudo)</system:String>
    <system:String x:Key="Str_GameCtl_Pulse">Pulso corto</system:String>
    <system:String x:Key="Str_GameCtl_PulseTip">Ambos motores al máximo medio segundo.</system:String>
    <system:String x:Key="Str_GameCtl_VibrationOnlyXInput">La vibración solo se puede probar en mandos tipo Xbox.</system:String>
    <system:String x:Key="Str_GameCtl_TabLive">En vivo</system:String>
    <system:String x:Key="Str_GameCtl_TabSticks">Deriva y rango</system:String>
    <system:String x:Key="Str_GameCtl_TabTriggers">Gatillos</system:String>
    <system:String x:Key="Str_GameCtl_PlotLegend">Anillo: la palanca como la informa el mando. Punto: después de la zona muerta. Forma discontinua: la zona muerta.</system:String>
    <system:String x:Key="Str_GameCtl_AxesXY">Ejes 1 y 2</system:String>
    <system:String x:Key="Str_GameCtl_AxesZR">Ejes 3 y 4</system:String>
    <system:String x:Key="Str_GameCtl_Axes">Todos los ejes</system:String>
    <system:String x:Key="Str_GameCtl_AxisN">Eje {0}</system:String>
    <system:String x:Key="Str_GameCtl_Buttons">Botones</system:String>
    <system:String x:Key="Str_GameCtl_Pov">Cruceta: {0}</system:String>
    <system:String x:Key="Str_GameCtl_PovCentered">centrada</system:String>
    <system:String x:Key="Str_GameCtl_Rate">≈ {0} Hz  ({1:0} medidos)</system:String>
    <system:String x:Key="Str_GameCtl_RateTip">Cuántas veces por segundo envía el mando una lectura nueva. Mueve una palanca para medirlo. Los mandos USB suelen ir de 125 a 1000 Hz; por Bluetooth suele ser menos y menos estable.</system:String>
    <system:String x:Key="Str_GameCtl_SticksIntro">Prueba en reposo: suelta la palanca 3 segundos para ver dónde descansa de verdad y cuánta deriva tiene. Prueba de rango: durante 10 segundos recorre despacio todo el borde de la palanca para ver hasta dónde llega y qué tan redondo es su movimiento.</system:String>
    <system:String x:Key="Str_GameCtl_RestTest">Prueba en reposo (3 s)</system:String>
    <system:String x:Key="Str_GameCtl_RestTip">No toques la palanca.</system:String>
    <system:String x:Key="Str_GameCtl_RangeTest">Prueba de rango (10 s)</system:String>
    <system:String x:Key="Str_GameCtl_RangeTip">Recorre despacio todo el borde de la palanca.</system:String>
    <system:String x:Key="Str_GameCtl_RestRunning">No toques la palanca... {0:0.0} s</system:String>
    <system:String x:Key="Str_GameCtl_RangeRunning">Recorre despacio todo el borde de la palanca... {0:0.0} s</system:String>
    <system:String x:Key="Str_GameCtl_NoData">No hay suficientes lecturas. Inténtalo de nuevo.</system:String>
    <system:String x:Key="Str_GameCtl_RestResult">Descansa en X {0}, Y {1}. Se desvía hasta {2:0.0}% del centro. La zona muerta más pequeña que lo oculta es {3}%.</system:String>
    <system:String x:Key="Str_GameCtl_RestPerfect">Una palanca perfectamente quieta: no necesita zona muerta.</system:String>
    <system:String x:Key="Str_GameCtl_RestCovered">Tu zona muerta de {0}% lo cubre, así que no debería haber deriva en los juegos.</system:String>
    <system:String x:Key="Str_GameCtl_RestDrifts">Tu zona muerta de {0}% es menor que la deriva: el personaje puede moverse solo en los juegos.</system:String>
    <system:String x:Key="Str_GameCtl_UseSuggested">Usar {0}% como zona muerta</system:String>
    <system:String x:Key="Str_GameCtl_DeadzoneSet">Zona muerta puesta a {0}%</system:String>
    <system:String x:Key="Str_GameCtl_RangeNone">No se llegó lo bastante al borde. Recorre todo el borde de la palanca e inténtalo de nuevo.</system:String>
    <system:String x:Key="Str_GameCtl_RangeResult">Llega al {0:0}% del recorrido · redondez {1:0}% · {2:0}% del círculo cubierto.</system:String>
    <system:String x:Key="Str_GameCtl_ShapeRound">Muy redonda: una guía suave.</system:String>
    <system:String x:Key="Str_GameCtl_ShapeOctagon">Ligeramente aplanada: normal en una guía octogonal o con poco desgaste.</system:String>
    <system:String x:Key="Str_GameCtl_ShapeUneven">Irregular: la palanca llega mucho más lejos en unas direcciones. Puede indicar una palanca gastada, sucia o dañada.</system:String>
    <system:String x:Key="Str_GameCtl_ReachShort">Nunca llega al recorrido completo: los juegos pueden no ver el 100% de empuje.</system:String>
    <system:String x:Key="Str_GameCtl_CoverageLow">No se alcanzaron partes del círculo; da la vuelta completa para un resultado justo.</system:String>
    <system:String x:Key="Str_GameCtl_TriggersIntro">Pulsa Grabar y aprieta el gatillo despacio y parejo hasta el fondo y suéltalo. La gráfica muestra el valor frente al tiempo; la línea discontinua es el umbral de tu gatillo.</system:String>
    <system:String x:Key="Str_GameCtl_Record">Grabar una pulsación</system:String>
    <system:String x:Key="Str_GameCtl_TriggerRunning">Aprieta despacio hasta el fondo y suelta...</system:String>
    <system:String x:Key="Str_GameCtl_TriggerNone">No se vio una pulsación completa. Aprieta el gatillo hasta el fondo e inténtalo de nuevo.</system:String>
    <system:String x:Key="Str_GameCtl_TriggerResult">Empieza a registrar en {0:0} de 255 · llega a {1:0} · uniformidad {2:0}%.</system:String>
    <system:String x:Key="Str_GameCtl_TriggerEven">Una respuesta uniforme.</system:String>
    <system:String x:Key="Str_GameCtl_TriggerUneven">Una respuesta irregular: unas partes de la pulsación cambian más rápido que otras (normal en algunos gatillos de efecto Hall y de resorte).</system:String>
    <system:String x:Key="Str_GameCtl_TriggerShort">No llega a 255: un juego puede no ver nunca una pulsación completa.</system:String>

    <!--  Prueba de monitor (monitor-test)  -->
    <system:String x:Key="Str_Monitor_Header">Prueba de monitor</system:String>
    <system:String x:Key="Str_Monitor_ScreenHeader">PANTALLA</system:String>
    <system:String x:Key="Str_Monitor_ScreenTip">La pantalla que cubrirán las imágenes de prueba.</system:String>
    <system:String x:Key="Str_Monitor_RefreshScreens">Buscar pantallas otra vez</system:String>
    <system:String x:Key="Str_Monitor_HzUnknown">frecuencia desconocida</system:String>
    <system:String x:Key="Str_Monitor_Primary">pantalla principal</system:String>
    <system:String x:Key="Str_Monitor_PlayHeader">REPRODUCCIÓN</system:String>
    <system:String x:Key="Str_Monitor_Slideshow">Presentación</system:String>
