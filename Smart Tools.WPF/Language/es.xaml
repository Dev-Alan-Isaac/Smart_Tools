    <system:String x:Key="Str_Tour_ScreenColorPicker_Result_Title">Color elegido</system:String>
    <system:String x:Key="Str_Tour_ScreenColorPicker_Result_Text">Mira el color que elegiste y copia sus valores.</system:String>
    <!--  Images to PDF  -->
    <system:String x:Key="Str_Tour_ImagesToPdf_Input_Title">Agrega tus imágenes</system:String>
    <system:String x:Key="Str_Tour_ImagesToPdf_Input_Text">Suelta imágenes aquí o búscalas. Cada una se convierte en una página.</system:String>
    <system:String x:Key="Str_Tour_ImagesToPdf_Pages_Title">Páginas</system:String>
    <system:String x:Key="Str_Tour_ImagesToPdf_Pages_Text">Elige el tamaño de página, la orientación, los márgenes y cómo se ajustan las imágenes a la página.</system:String>
    <system:String x:Key="Str_Tour_ImagesToPdf_Quality_Title">Calidad</system:String>
    <system:String x:Key="Str_Tour_ImagesToPdf_Quality_Text">Equilibra la calidad de las imágenes con el tamaño del PDF.</system:String>
    <system:String x:Key="Str_Tour_ImagesToPdf_Output_Title">Guardar en</system:String>
    <system:String x:Key="Str_Tour_ImagesToPdf_Output_Text">Elige la carpeta y el nombre de tu PDF.</system:String>
    <system:String x:Key="Str_Tour_ImagesToPdf_Create_Title">Crear PDF</system:String>
    <system:String x:Key="Str_Tour_ImagesToPdf_Create_Text">Combina las imágenes en un solo PDF.</system:String>
    <system:String x:Key="Str_Tour_ImagesToPdf_Order_Title">Orden de las páginas</system:String>
    <system:String x:Key="Str_Tour_ImagesToPdf_Order_Text">Reordena, ordena o quita imágenes aquí antes de crear el PDF.</system:String>
    <!--  PDF toolkit  -->
    <system:String x:Key="Str_Tour_PdfToolkit_Operation_Title">Qué hacer</system:String>
    <system:String x:Key="Str_Tour_PdfToolkit_Operation_Text">Une, divide o comprime tus archivos PDF. Las opciones de abajo cambian según tu elección.</system:String>
    <system:String x:Key="Str_Tour_PdfToolkit_Input_Title">Agrega tus PDF</system:String>
    <system:String x:Key="Str_Tour_PdfToolkit_Input_Text">Suelta archivos PDF aquí o búscalos.</system:String>
    <system:String x:Key="Str_Tour_PdfToolkit_Output_Title">Guardar en</system:String>
    <system:String x:Key="Str_Tour_PdfToolkit_Output_Text">Elige la carpeta para los archivos terminados.</system:String>
    <system:String x:Key="Str_Tour_PdfToolkit_Run_Title">Ejecutar</system:String>
    <system:String x:Key="Str_Tour_PdfToolkit_Run_Text">Inicia la operación que elegiste.</system:String>
    <system:String x:Key="Str_Tour_PdfToolkit_Results_Title">Resultados</system:String>
    <system:String x:Key="Str_Tour_PdfToolkit_Results_Text">Mira qué se creó y cómo quedó cada archivo.</system:String>
    <!--  PDF extras  -->
    <system:String x:Key="Str_Tour_PdfExtras_Action_Title">Qué hacer</system:String>
    <system:String x:Key="Str_Tour_PdfExtras_Action_Text">Elige una acción, como girar, recortar, numerar páginas o agregar una contraseña.</system:String>
    <system:String x:Key="Str_Tour_PdfExtras_Input_Title">Agrega tus PDF</system:String>
    <system:String x:Key="Str_Tour_PdfExtras_Input_Text">Suelta archivos PDF aquí o búscalos.</system:String>
    <system:String x:Key="Str_Tour_PdfExtras_Output_Title">Guardar en</system:String>
    <system:String x:Key="Str_Tour_PdfExtras_Output_Text">Elige la carpeta para los archivos terminados.</system:String>
    <system:String x:Key="Str_Tour_PdfExtras_Apply_Title">Aplicar</system:String>
    <system:String x:Key="Str_Tour_PdfExtras_Apply_Text">Ejecuta la acción elegida en tus PDF.</system:String>
    <system:String x:Key="Str_Tour_PdfExtras_Results_Title">Resultados</system:String>
    <system:String x:Key="Str_Tour_PdfExtras_Results_Text">Mira qué se creó y cómo quedó cada archivo.</system:String>
    <!--  Duplicate finder  -->
    <system:String x:Key="Str_Tour_DuplicateFinder_Input_Title">Carpetas por analizar</system:String>
    <system:String x:Key="Str_Tour_DuplicateFinder_Input_Text">Agrega las carpetas donde quieres buscar archivos duplicados.</system:String>
    <system:String x:Key="Str_Tour_DuplicateFinder_Method_Title">Método de detección</system:String>
    <system:String x:Key="Str_Tour_DuplicateFinder_Method_Text">Elige cómo se comparan los archivos. Los modos de hash son los más fiables, pero más lentos con archivos grandes.</system:String>
    <system:String x:Key="Str_Tour_DuplicateFinder_Filters_Title">Filtros</system:String>
    <system:String x:Key="Str_Tour_DuplicateFinder_Filters_Text">Limita el análisis a ciertos tipos o tamaños de archivo.</system:String>
    <system:String x:Key="Str_Tour_DuplicateFinder_Scan_Title">Analizar</system:String>
    <system:String x:Key="Str_Tour_DuplicateFinder_Scan_Text">Busca duplicados en tus carpetas.</system:String>
    <system:String x:Key="Str_Tour_DuplicateFinder_Results_Title">Grupos de duplicados</system:String>
    <system:String x:Key="Str_Tour_DuplicateFinder_Results_Text">Revisa cada grupo de archivos iguales, compáralos y limpia los sobrantes.</system:String>
    <!--  File differences  -->
    <system:String x:Key="Str_Tour_FileDifferences_Files_Title">Tus dos archivos</system:String>
    <system:String x:Key="Str_Tour_FileDifferences_Files_Text">Suelta aquí el archivo original y el modificado, o búscalos.</system:String>
    <system:String x:Key="Str_Tour_FileDifferences_Compare_Title">Opciones de comparación</system:String>
    <system:String x:Key="Str_Tour_FileDifferences_Compare_Text">Elige si se ignoran los espacios en blanco o las mayúsculas y minúsculas.</system:String>
    <system:String x:Key="Str_Tour_FileDifferences_Run_Title">Comparar</system:String>
    <system:String x:Key="Str_Tour_FileDifferences_Run_Text">Encuentra qué cambió entre los dos archivos.</system:String>
    <system:String x:Key="Str_Tour_FileDifferences_Differences_Title">Diferencias</system:String>
    <system:String x:Key="Str_Tour_FileDifferences_Differences_Text">Mira las líneas agregadas y eliminadas, salta entre cambios y copia o guarda el resultado.</system:String>
    <!--  Find similar files  -->
    <system:String x:Key="Str_Tour_FindSimilar_Input_Title">Carpetas por analizar</system:String>
    <system:String x:Key="Str_Tour_FindSimilar_Input_Text">Agrega las carpetas con las imágenes que quieres revisar.</system:String>
    <system:String x:Key="Str_Tour_FindSimilar_Method_Title">Método de detección</system:String>
    <system:String x:Key="Str_Tour_FindSimilar_Method_Text">Elige cómo decide la herramienta que dos imágenes se parecen.</system:String>
    <system:String x:Key="Str_Tour_FindSimilar_Threshold_Title">Similitud</system:String>
    <system:String x:Key="Str_Tour_FindSimilar_Threshold_Text">Define qué tan parecidas deben ser dos imágenes para contar como similares.</system:String>
    <system:String x:Key="Str_Tour_FindSimilar_Scan_Title">Analizar</system:String>
    <system:String x:Key="Str_Tour_FindSimilar_Scan_Text">Busca archivos similares en tus carpetas.</system:String>
    <system:String x:Key="Str_Tour_FindSimilar_Results_Title">Grupos similares</system:String>
    <system:String x:Key="Str_Tour_FindSimilar_Results_Text">Revisa cada grupo, compara los archivos lado a lado y decide cuáles conservar.</system:String>
    <!--  Hash verifier  -->
    <system:String x:Key="Str_Tour_HashVerifier_Input_Title">Agrega tus archivos</system:String>
    <system:String x:Key="Str_Tour_HashVerifier_Input_Text">Suelta archivos o carpetas aquí, o búscalos.</system:String>
    <system:String x:Key="Str_Tour_HashVerifier_Algorithms_Title">Algoritmos</system:String>
    <system:String x:Key="Str_Tour_HashVerifier_Algorithms_Text">Elige qué algoritmos de hash calcular. Todos los marcados se calculan en una sola pasada.</system:String>
    <system:String x:Key="Str_Tour_HashVerifier_Compare_Title">Calcular o verificar</system:String>
    <system:String x:Key="Str_Tour_HashVerifier_Compare_Text">Solo muestra los hashes, compáralos con uno que pegues o verifícalos con un archivo de sumas de comprobación.</system:String>
    <system:String x:Key="Str_Tour_HashVerifier_Run_Title">Iniciar</system:String>
    <system:String x:Key="Str_Tour_HashVerifier_Run_Text">Calcula los hashes y ejecuta la verificación.</system:String>
    <system:String x:Key="Str_Tour_HashVerifier_Results_Title">Resultados</system:String>
    <system:String x:Key="Str_Tour_HashVerifier_Results_Text">Mira el hash de cada archivo y si coincide.</system:String>
    <!--  Text diff  -->
    <system:String x:Key="Str_Tour_TextDiff_Original_Title">Texto original</system:String>
    <system:String x:Key="Str_Tour_TextDiff_Original_Text">Escribe o pega aquí la versión original.</system:String>
    <system:String x:Key="Str_Tour_TextDiff_Changed_Title">Texto modificado</system:String>
    <system:String x:Key="Str_Tour_TextDiff_Changed_Text">Escribe o pega aquí la versión modificada.</system:String>
    <system:String x:Key="Str_Tour_TextDiff_Compare_Title">Opciones de comparación</system:String>
    <system:String x:Key="Str_Tour_TextDiff_Compare_Text">Elige si se ignoran los espacios en blanco o las mayúsculas y minúsculas.</system:String>
    <system:String x:Key="Str_Tour_TextDiff_View_Title">Vista</system:String>
    <system:String x:Key="Str_Tour_TextDiff_View_Text">Muestra las diferencias lado a lado o en línea, y oculta las líneas sin cambios.</system:String>
    <system:String x:Key="Str_Tour_TextDiff_Differences_Title">Diferencias</system:String>
    <system:String x:Key="Str_Tour_TextDiff_Differences_Text">Mira qué se agregó y qué se quitó, salta entre cambios y copia o guarda un parche.</system:String>
    <!--  Validate files  -->
    <system:String x:Key="Str_Tour_ValidateFiles_Input_Title">Agrega tus archivos</system:String>
    <system:String x:Key="Str_Tour_ValidateFiles_Input_Text">Suelta archivos o carpetas aquí, o búscalos.</system:String>
    <system:String x:Key="Str_Tour_ValidateFiles_Type_Title">Qué revisar</system:String>
    <system:String x:Key="Str_Tour_ValidateFiles_Type_Text">Elige qué tipos de archivo validar, como imágenes, videos, audio, documentos o archivos comprimidos.</system:String>
    <system:String x:Key="Str_Tour_ValidateFiles_Settings_Title">Ajustes de revisión</system:String>
    <system:String x:Key="Str_Tour_ValidateFiles_Settings_Text">Ajusta la configuración del tipo de revisión que elegiste.</system:String>
    <system:String x:Key="Str_Tour_ValidateFiles_Run_Title">Validar</system:String>
    <system:String x:Key="Str_Tour_ValidateFiles_Run_Text">Revisa si tus archivos están dañados o corruptos.</system:String>
    <system:String x:Key="Str_Tour_ValidateFiles_Results_Title">Resultados</system:String>
    <system:String x:Key="Str_Tour_ValidateFiles_Results_Text">Mira qué archivos están bien y cuáles tienen problemas.</system:String>

<!-- Tour: Audio Output Test -->
<system:String x:Key="Str_Tour_AudioOut_Device_Title">Dispositivo de salida</system:String>
<system:String x:Key="Str_Tour_AudioOut_Device_Text">Elige qué altavoces o auriculares probar. Usa actualizar si acabas de conectar algo.</system:String>
<system:String x:Key="Str_Tour_AudioOut_Level_Title">Nivel de volumen</system:String>
<system:String x:Key="Str_Tour_AudioOut_Level_Text">Define qué tan fuerte suenan las pruebas. Empieza bajo para proteger tus oídos y tus altavoces.</system:String>
<system:String x:Key="Str_Tour_AudioOut_Signal_Title">Opciones de señal</system:String>
<system:String x:Key="Str_Tour_AudioOut_Signal_Text">Ajusta el tono, la forma de onda, el barrido, el ruido y la fase de la prueba seleccionada.</system:String>
<system:String x:Key="Str_Tour_AudioOut_Play_Title">Reproducir</system:String>
<system:String x:Key="Str_Tour_AudioOut_Play_Text">Inicia o detiene el sonido de prueba en el dispositivo elegido.</system:String>
<system:String x:Key="Str_Tour_AudioOut_Test_Title">Elige una prueba</system:String>
<system:String x:Key="Str_Tour_AudioOut_Test_Text">Cambia entre pruebas de canales, fase, tono, barrido y ruido, y luego elige los canales que quieres escuchar.</system:String>
<!-- Tour: Game Controller -->
<system:String x:Key="Str_Tour_GameCtl_Controller_Title">Mando</system:String>
<system:String x:Key="Str_Tour_GameCtl_Controller_Text">Elige cuál de los mandos conectados quieres probar.</system:String>
<system:String x:Key="Str_Tour_GameCtl_Deadzone_Title">Zonas muertas</system:String>
<system:String x:Key="Str_Tour_GameCtl_Deadzone_Text">Define cuánto debe moverse un stick antes de registrar la entrada, para detectar desvíos.</system:String>
<system:String x:Key="Str_Tour_GameCtl_Vibration_Title">Vibración</system:String>
<system:String x:Key="Str_Tour_GameCtl_Vibration_Text">Prueba los motores de vibración con distintas intensidades.</system:String>
<system:String x:Key="Str_Tour_GameCtl_Pad_Title">Mando en vivo</system:String>
<system:String x:Key="Str_Tour_GameCtl_Pad_Text">Pulsa botones y mueve sticks y gatillos para ver cada entrada reaccionar en tiempo real.</system:String>
<!-- Tour: Keyboard and Mouse Test -->
<system:String x:Key="Str_Tour_KbMouse_Options_Title">Opciones</system:String>
<system:String x:Key="Str_Tour_KbMouse_Options_Text">Elige qué pruebas mostrar y ajusta cómo se muestran las entradas.</system:String>
<system:String x:Key="Str_Tour_KbMouse_Tests_Title">Área de pruebas</system:String>
<system:String x:Key="Str_Tour_KbMouse_Tests_Text">Pulsa teclas y haz clic, desplázate o mueve el ratón para comprobar que se detecta cada entrada.</system:String>
<!-- Tour: Monitor HDR Test -->
<system:String x:Key="Str_Tour_MonitorHdr_Screen_Title">Pantalla</system:String>
<system:String x:Key="Str_Tour_MonitorHdr_Screen_Text">Elige el monitor que quieres probar.</system:String>
<system:String x:Key="Str_Tour_MonitorHdr_Play_Title">Opciones de reproducción</system:String>
<system:String x:Key="Str_Tour_MonitorHdr_Play_Text">Controla cómo se muestran los patrones HDR a pantalla completa.</system:String>
<system:String x:Key="Str_Tour_MonitorHdr_Start_Title">Iniciar</system:String>
<system:String x:Key="Str_Tour_MonitorHdr_Start_Text">Abre los patrones de prueba HDR a pantalla completa en el monitor seleccionado.</system:String>
<system:String x:Key="Str_Tour_MonitorHdr_Results_Title">Lecturas y veredicto</system:String>
<system:String x:Key="Str_Tour_MonitorHdr_Results_Text">Consulta lo que Windows informa sobre la compatibilidad HDR de tu pantalla, con un veredicto en lenguaje sencillo.</system:String>
<!-- Tour: Monitor Test -->
<system:String x:Key="Str_Tour_MonitorTest_Screen_Title">Pantalla</system:String>
<system:String x:Key="Str_Tour_MonitorTest_Screen_Text">Elige el monitor que quieres probar.</system:String>
<system:String x:Key="Str_Tour_MonitorTest_Play_Title">Opciones de reproducción</system:String>
<system:String x:Key="Str_Tour_MonitorTest_Play_Text">Controla cómo se muestran los patrones de prueba a pantalla completa.</system:String>
<system:String x:Key="Str_Tour_MonitorTest_Start_Title">Iniciar</system:String>
<system:String x:Key="Str_Tour_MonitorTest_Start_Text">Abre los patrones de prueba a pantalla completa para buscar píxeles muertos, color irregular y fugas de luz.</system:String>
<system:String x:Key="Str_Tour_MonitorTest_Results_Title">Frecuencia y marcas</system:String>
<system:String x:Key="Str_Tour_MonitorTest_Results_Text">Mide tu frecuencia de actualización real y anota los problemas que encuentres.</system:String>
<!-- Tour: Background Remover -->
<system:String x:Key="Str_Tour_BgRemove_Input_Title">Entrada</system:String>
<system:String x:Key="Str_Tour_BgRemove_Input_Text">Agrega las imágenes o carpetas a las que quieres quitar el fondo.</system:String>
<system:String x:Key="Str_Tour_BgRemove_Color_Title">Color a quitar</system:String>
<system:String x:Key="Str_Tour_BgRemove_Color_Text">Elige el color de fondo que se volverá transparente, o tómalo de una imagen.</system:String>
<system:String x:Key="Str_Tour_BgRemove_Background_Title">Fondo</system:String>
<system:String x:Key="Str_Tour_BgRemove_Background_Text">Ajusta qué tan parecidos deben ser los colores y qué tan suaves quedan los bordes.</system:String>
<system:String x:Key="Str_Tour_BgRemove_Output_Title">Salida</system:String>
<system:String x:Key="Str_Tour_BgRemove_Output_Text">Elige la carpeta donde se guardan las imágenes terminadas.</system:String>
<system:String x:Key="Str_Tour_BgRemove_Run_Title">Quitar fondos</system:String>
<system:String x:Key="Str_Tour_BgRemove_Run_Text">Procesa todas las imágenes de la cola y guarda los resultados.</system:String>
<!-- Tour: Bulk Image Resizer -->
<system:String x:Key="Str_Tour_BulkResize_Input_Title">Entrada</system:String>
<system:String x:Key="Str_Tour_BulkResize_Input_Text">Agrega las imágenes o carpetas que quieres redimensionar.</system:String>
<system:String x:Key="Str_Tour_BulkResize_Resize_Title">Redimensionar</system:String>
<system:String x:Key="Str_Tour_BulkResize_Resize_Text">Elige el nuevo tamaño en píxeles, porcentaje o ajuste, y cómo tratar la proporción.</system:String>
<system:String x:Key="Str_Tour_BulkResize_SaveAs_Title">Guardar como</system:String>
<system:String x:Key="Str_Tour_BulkResize_SaveAs_Text">Elige el formato, la calidad y el nombre de las copias redimensionadas.</system:String>
<system:String x:Key="Str_Tour_BulkResize_Output_Title">Salida</system:String>
<system:String x:Key="Str_Tour_BulkResize_Output_Text">Elige la carpeta donde se guardan las imágenes redimensionadas.</system:String>
<system:String x:Key="Str_Tour_BulkResize_Run_Title">Redimensionar imágenes</system:String>
<system:String x:Key="Str_Tour_BulkResize_Run_Text">Redimensiona todo lo que hay en la lista de una sola vez.</system:String>
<system:String x:Key="Str_Tour_BulkResize_Results_Title">Lista de imágenes</system:String>
<system:String x:Key="Str_Tour_BulkResize_Results_Text">Revisa las imágenes en cola y consulta el resultado de cada una.</system:String>
<!-- Tour: Image Editor -->
<system:String x:Key="Str_Tour_ImageEditor_Input_Title">Entrada</system:String>
<system:String x:Key="Str_Tour_ImageEditor_Input_Text">Agrega las imágenes o carpetas que quieres editar.</system:String>
<system:String x:Key="Str_Tour_ImageEditor_Rotate_Title">Girar y voltear</system:String>
<system:String x:Key="Str_Tour_ImageEditor_Rotate_Text">Gira la imagen a la izquierda o a la derecha, o voltéala horizontal o verticalmente.</system:String>
<system:String x:Key="Str_Tour_ImageEditor_Crop_Title">Recortar</system:String>
<system:String x:Key="Str_Tour_ImageEditor_Crop_Text">Activa el recorte, arrastra un recuadro sobre la vista previa y aplícalo.</system:String>
<system:String x:Key="Str_Tour_ImageEditor_Output_Title">Salida</system:String>
<system:String x:Key="Str_Tour_ImageEditor_Output_Text">Elige la carpeta donde se guardan las imágenes editadas.</system:String>
<system:String x:Key="Str_Tour_ImageEditor_Run_Title">Aplicar ediciones</system:String>
<system:String x:Key="Str_Tour_ImageEditor_Run_Text">Aplica tus ediciones y guarda las imágenes.</system:String>
<system:String x:Key="Str_Tour_ImageEditor_Preview_Title">Vista previa</system:String>
<system:String x:Key="Str_Tour_ImageEditor_Preview_Text">Mira tus cambios en vivo y recorre las imágenes de la cola.</system:String>
<!-- Tour: SVG Tool -->
<system:String x:Key="Str_Tour_SvgTool_Background_Title">Fondo</system:String>
<system:String x:Key="Str_Tour_SvgTool_Background_Text">Cambia el fondo de la vista previa para ver cómo se ve el SVG sobre superficies claras, oscuras o transparentes.</system:String>
<system:String x:Key="Str_Tour_SvgTool_CleanUp_Title">Limpiar</system:String>
<system:String x:Key="Str_Tour_SvgTool_CleanUp_Text">Elimina metadatos, comentarios y otros restos del código SVG.</system:String>
<system:String x:Key="Str_Tour_SvgTool_Shrink_Title">Reducir</system:String>
<system:String x:Key="Str_Tour_SvgTool_Shrink_Text">Haz el archivo más pequeño simplificando números y trazados.</system:String>
<system:String x:Key="Str_Tour_SvgTool_Export_Title">Exportar</system:String>
<system:String x:Key="Str_Tour_SvgTool_Export_Text">Elige el tamaño y las opciones para exportar el SVG como PNG.</system:String>
<system:String x:Key="Str_Tour_SvgTool_Preview_Title">Vista previa</system:String>
<system:String x:Key="Str_Tour_SvgTool_Preview_Text">Abre un SVG, acércalo y mira el resultado de tus cambios.</system:String>
<!-- Tour: Instrument Tuner -->
<system:String x:Key="Str_Tour_Tuner_Instrument_Title">Instrumento</system:String>
<system:String x:Key="Str_Tour_Tuner_Instrument_Text">Elige tu instrumento para ver las notas estándar de sus cuerdas.</system:String>
<system:String x:Key="Str_Tour_Tuner_Mic_Title">Micrófono</system:String>
<system:String x:Key="Str_Tour_Tuner_Mic_Text">Elige el micrófono con el que se escucha tu instrumento.</system:String>
<system:String x:Key="Str_Tour_Tuner_Reference_Title">Tono de referencia</system:String>
<system:String x:Key="Str_Tour_Tuner_Reference_Text">Define la frecuencia del La4, que es de 440 Hz en la afinación estándar.</system:String>
<system:String x:Key="Str_Tour_Tuner_Listen_Title">Empezar a afinar</system:String>
<system:String x:Key="Str_Tour_Tuner_Listen_Text">Empieza a escuchar y luego toca una sola nota en tu instrumento.</system:String>
<system:String x:Key="Str_Tour_Tuner_Meter_Title">Medidor de afinación</system:String>
<system:String x:Key="Str_Tour_Tuner_Meter_Text">Mira la nota detectada y cuántos cents está por encima o por debajo.</system:String>
<!-- Tour: MIDI Instruments -->
<system:String x:Key="Str_Tour_Midi_Instrument_Title">Instrumento</system:String>
<system:String x:Key="Str_Tour_Midi_Instrument_Text">Elige qué instrumento tocar.</system:String>
<system:String x:Key="Str_Tour_Midi_Sound_Title">Sonido</system:String>
<system:String x:Key="Str_Tour_Midi_Sound_Text">Da forma al volumen y al timbre del instrumento.</system:String>
<system:String x:Key="Str_Tour_Midi_Record_Title">Grabar</system:String>
<system:String x:Key="Str_Tour_Midi_Record_Text">Graba lo que tocas y guárdalo como archivo.</system:String>
<system:String x:Key="Str_Tour_Midi_Piano_Title">Teclado</system:String>
<system:String x:Key="Str_Tour_Midi_Piano_Text">Toca con el ratón, con el teclado del equipo o con un teclado MIDI conectado.</system:String>
<!-- Tour: Synthesizer -->
<system:String x:Key="Str_Tour_Synth_Oscillator_Title">Oscilador</system:String>
<system:String x:Key="Str_Tour_Synth_Oscillator_Text">Elige la forma de onda que define el carácter básico del sonido.</system:String>
<system:String x:Key="Str_Tour_Synth_Envelope_Title">Envolvente</system:String>
<system:String x:Key="Str_Tour_Synth_Envelope_Text">Da forma a cómo cada nota entra y se apaga con ataque, caída, sostenimiento y liberación.</system:String>
<system:String x:Key="Str_Tour_Synth_Record_Title">Grabar</system:String>
<system:String x:Key="Str_Tour_Synth_Record_Text">Graba lo que tocas y guárdalo en un archivo.</system:String>
<system:String x:Key="Str_Tour_Synth_Piano_Title">Teclado</system:String>
<system:String x:Key="Str_Tour_Synth_Piano_Text">Toca notas con el ratón o con el teclado del equipo.</system:String>
<!-- Tour: Pixel Art -->
<system:String x:Key="Str_Tour_PixelArt_Tools_Title">Herramientas</system:String>
<system:String x:Key="Str_Tour_PixelArt_Tools_Text">Elige una herramienta de dibujo, como lápiz, borrador, relleno o cuentagotas.</system:String>
<system:String x:Key="Str_Tour_PixelArt_Color_Title">Color</system:String>
<system:String x:Key="Str_Tour_PixelArt_Color_Text">Elige tu color de dibujo y gestiona la paleta.</system:String>
<system:String x:Key="Str_Tour_PixelArt_Brush_Title">Pincel</system:String>
<system:String x:Key="Str_Tour_PixelArt_Brush_Text">Define el tamaño del pincel.</system:String>
<system:String x:Key="Str_Tour_PixelArt_Canvas_Title">Lienzo</system:String>
<system:String x:Key="Str_Tour_PixelArt_Canvas_Text">Crea un lienzo nuevo, redimensiona el actual o abre una imagen existente.</system:String>
<system:String x:Key="Str_Tour_PixelArt_Drawing_Title">Área de dibujo</system:String>
<system:String x:Key="Str_Tour_PixelArt_Drawing_Text">Dibuja aquí tu pixel art y luego guárdalo o expórtalo.</system:String>
<!-- Tour: Sprite Packer -->
<system:String x:Key="Str_Tour_SpritePacker_Mode_Title">Modo</system:String>
<system:String x:Key="Str_Tour_SpritePacker_Mode_Text">Elige si empaquetar imágenes sueltas en una hoja o dividir una hoja en fotogramas.</system:String>
<system:String x:Key="Str_Tour_SpritePacker_Input_Title">Entrada</system:String>
<system:String x:Key="Str_Tour_SpritePacker_Input_Text">Agrega las imágenes o carpetas de sprites con las que trabajar.</system:String>
<system:String x:Key="Str_Tour_SpritePacker_Output_Title">Salida</system:String>
<system:String x:Key="Str_Tour_SpritePacker_Output_Text">Elige la carpeta donde se guardan los resultados.</system:String>
<system:String x:Key="Str_Tour_SpritePacker_Run_Title">Ejecutar</system:String>
<system:String x:Key="Str_Tour_SpritePacker_Run_Text">Crea la hoja de sprites o exporta los fotogramas.</system:String>
<system:String x:Key="Str_Tour_SpritePacker_Preview_Title">Vista previa</system:String>
<system:String x:Key="Str_Tour_SpritePacker_Preview_Text">Mira el diseño de la hoja de sprites y cómo se cortarán los fotogramas.</system:String>

    <!-- Tour: Escáner de dispositivos -->
    <system:String x:Key="Str_Tour_DeviceScanner_Network_Title">Red</system:String>
    <system:String x:Key="Str_Tour_DeviceScanner_Network_Text">Elige qué red escanear o introduce un rango de direcciones personalizado.</system:String>
    <system:String x:Key="Str_Tour_DeviceScanner_Speed_Title">Velocidad del escaneo</system:String>
    <system:String x:Key="Str_Tour_DeviceScanner_Speed_Text">Elige un ajuste que equilibre el tiempo del escaneo con la paciencia ante dispositivos lentos.</system:String>
    <system:String x:Key="Str_Tour_DeviceScanner_Options_Title">Detalles</system:String>
    <system:String x:Key="Str_Tour_DeviceScanner_Options_Text">Decide si buscar los nombres de los dispositivos e incluir los que ignoran los pings.</system:String>
    <system:String x:Key="Str_Tour_DeviceScanner_Scan_Title">Escanear</system:String>
    <system:String x:Key="Str_Tour_DeviceScanner_Scan_Text">Empieza a buscar dispositivos en la red elegida. El progreso aparece junto al botón.</system:String>
    <system:String x:Key="Str_Tour_DeviceScanner_Results_Title">Dispositivos encontrados</system:String>
    <system:String x:Key="Str_Tour_DeviceScanner_Results_Text">Cada dispositivo que respondió aparece con su dirección, nombre y fabricante. Aquí puedes filtrar o exportar la lista.</system:String>
    <!-- Tour: Herramientas DNS -->
    <system:String x:Key="Str_Tour_Dns_Mode_Title">Herramienta</system:String>
    <system:String x:Key="Str_Tour_Dns_Mode_Text">Cambia entre consulta DNS, WHOIS y traceroute.</system:String>
    <system:String x:Key="Str_Tour_Dns_Settings_Title">Ajustes</system:String>
    <system:String x:Key="Str_Tour_Dns_Settings_Text">Elige el tipo de registro y el servidor DNS al que preguntar.</system:String>
    <system:String x:Key="Str_Tour_Dns_Host_Title">Host o dirección</system:String>
    <system:String x:Key="Str_Tour_Dns_Host_Text">Escribe el nombre de dominio o la dirección IP que quieres consultar.</system:String>
    <system:String x:Key="Str_Tour_Dns_Run_Title">Ejecutar</system:String>
    <system:String x:Key="Str_Tour_Dns_Run_Text">Ejecuta la consulta, o deténla mientras sigue en curso.</system:String>
    <system:String x:Key="Str_Tour_Dns_Results_Title">Respuesta</system:String>
    <system:String x:Key="Str_Tour_Dns_Results_Text">Aquí aparecen los registros, los datos WHOIS o los saltos de traceroute a medida que llegan.</system:String>
    <!-- Tour: Editor de hosts -->
    <system:String x:Key="Str_Tour_Hosts_Search_Title">Buscar y guardar</system:String>
    <system:String x:Key="Str_Tour_Hosts_Search_Text">Filtra las entradas, vacía la caché DNS y guarda tus cambios en el archivo hosts.</system:String>
    <system:String x:Key="Str_Tour_Hosts_Add_Title">Nueva entrada</system:String>
    <system:String x:Key="Str_Tour_Hosts_Add_Text">Introduce una dirección, uno o más nombres y un comentario opcional, y luego agrégala a la lista.</system:String>
    <system:String x:Key="Str_Tour_Hosts_Entries_Title">Entradas</system:String>
    <system:String x:Key="Str_Tour_Hosts_Entries_Text">Cada línea del archivo hosts. Activa o desactiva entradas, edítalas o elimínalas.</system:String>
    <system:String x:Key="Str_Tour_Hosts_Save_Title">Guardar</system:String>
    <system:String x:Key="Str_Tour_Hosts_Save_Text">Escribe tus cambios en el archivo hosts. Requiere permisos de administrador.</system:String>
    <!-- Tour: Prueba de velocidad de internet -->
    <system:String x:Key="Str_Tour_InternetSpeed_Server_Title">Servidor</system:String>
    <system:String x:Key="Str_Tour_InternetSpeed_Server_Text">Elige el servidor de prueba, o deja que la herramienta elija el más cercano.</system:String>
    <system:String x:Key="Str_Tour_InternetSpeed_Test_Title">Tamaño de la prueba</system:String>
    <system:String x:Key="Str_Tour_InternetSpeed_Test_Text">Define cuántos datos usan las pruebas de descarga y subida.</system:String>
    <system:String x:Key="Str_Tour_InternetSpeed_Start_Title">Iniciar prueba</system:String>
    <system:String x:Key="Str_Tour_InternetSpeed_Start_Text">Mide tu ping y tus velocidades de descarga y subida, una tras otra.</system:String>
    <system:String x:Key="Str_Tour_InternetSpeed_Results_Title">Resultados</system:String>
    <system:String x:Key="Str_Tour_InternetSpeed_Results_Text">Aquí aparecen las velocidades, el ping y un gráfico en vivo, junto con lo que significan los números.</system:String>
    <system:String x:Key="Str_Tour_InternetSpeed_History_Title">Historial</system:String>
    <system:String x:Key="Str_Tour_InternetSpeed_History_Text">Las pruebas anteriores se guardan aquí para que puedas compararlas.</system:String>
    <!-- Tour: Widget de velocidad de red -->
    <system:String x:Key="Str_Tour_Connections_Summary_Title">Resumen del exterior</system:String>
    <system:String x:Key="Str_Tour_Connections_Summary_Text">Cuántas apps están conectadas fuera de tu PC y cuántas conexiones tienen abiertas ahora mismo.</system:String>
    <system:String x:Key="Str_Tour_Connections_Search_Title">Buscar</system:String>
    <system:String x:Key="Str_Tour_Connections_Search_Text">Encuentra una conexión por nombre de app, dirección remota, puerto o PID.</system:String>
    <system:String x:Key="Str_Tour_Connections_List_Title">Conexiones</system:String>
    <system:String x:Key="Str_Tour_Connections_List_Text">Cada fila es una conexión: la app, a dónde se conecta, el puerto y su estado. Haz clic en un encabezado para ordenar.</system:String>
    <system:String x:Key="Str_Tour_Connections_Show_Title">Exterior o local</system:String>
    <system:String x:Key="Str_Tour_Connections_Show_Text">Elige las conexiones fuera de tu red, las locales o todas. Exterior significa más allá de tu propia red.</system:String>
    <system:String x:Key="Str_Tour_Connections_LookUp_Title">Nombres de host</system:String>
    <system:String x:Key="Str_Tour_Connections_LookUp_Text">Pregunta a tu servidor DNS el nombre de cada dirección. Está desactivado por defecto porque cada búsqueda es una petición de red.</system:String>
    <system:String x:Key="Str_Tour_Connections_Export_Title">Exportar</system:String>
    <system:String x:Key="Str_Tour_Connections_Export_Text">Guarda en un archivo CSV las filas que ves.</system:String>
    <!-- Tour: Adaptadores de red -->
    <system:String x:Key="Str_Tour_NetworkAdapters_MyIp_Title">Tu conexión</system:String>
    <system:String x:Key="Str_Tour_NetworkAdapters_MyIp_Text">Consulta de un vistazo tus direcciones local y pública.</system:String>
    <system:String x:Key="Str_Tour_NetworkAdapters_Refresh_Title">Actualizar</system:String>
    <system:String x:Key="Str_Tour_NetworkAdapters_Refresh_Text">Vuelve a leer los adaptadores después de conectar o cambiar algo.</system:String>
    <system:String x:Key="Str_Tour_NetworkAdapters_List_Title">Adaptadores</system:String>
    <system:String x:Key="Str_Tour_NetworkAdapters_List_Text">Todos los adaptadores de red de este equipo. Selecciona uno para ver sus detalles o cambiar su configuración.</system:String>
    <system:String x:Key="Str_Tour_NetworkAdapters_Log_Title">Registro</system:String>
    <system:String x:Key="Str_Tour_NetworkAdapters_Log_Text">Aquí aparecen los mensajes sobre lo que hace la herramienta. Puedes copiarlos o guardarlos.</system:String>
    <!-- Tour: Ping -->
    <system:String x:Key="Str_Tour_Ping_Target_Title">Host</system:String>
    <system:String x:Key="Str_Tour_Ping_Target_Text">Introduce el host al que hacer ping y cuántas veces enviar la solicitud.</system:String>
    <system:String x:Key="Str_Tour_Ping_Source_Title">Enviar desde</system:String>
    <system:String x:Key="Str_Tour_Ping_Source_Text">Elige desde qué adaptador de red salen los pings.</system:String>
    <system:String x:Key="Str_Tour_Ping_Run_Title">Ping</system:String>
    <system:String x:Key="Str_Tour_Ping_Run_Text">Inicia el ping, o detén una ejecución en curso.</system:String>
    <system:String x:Key="Str_Tour_Ping_Replies_Title">Respuestas</system:String>
    <system:String x:Key="Str_Tour_Ping_Replies_Text">Cada respuesta aparece con su tiempo. Copia o guarda el registro cuando termines.</system:String>
    <!-- Tour: Escáner de puertos -->
    <system:String x:Key="Str_Tour_PortScanner_Target_Title">Host y puertos</system:String>
    <system:String x:Key="Str_Tour_PortScanner_Target_Text">Introduce el host a comprobar y los puertos a probar, como puertos sueltos, listas o rangos.</system:String>
    <system:String x:Key="Str_Tour_PortScanner_Source_Title">Enviar desde</system:String>
    <system:String x:Key="Str_Tour_PortScanner_Source_Text">Elige qué adaptador de red usa el escaneo.</system:String>
    <system:String x:Key="Str_Tour_PortScanner_Run_Title">Escanear</system:String>
    <system:String x:Key="Str_Tour_PortScanner_Run_Text">Inicia el escaneo, o deténlo antes de que termine.</system:String>
    <system:String x:Key="Str_Tour_PortScanner_Results_Title">Puertos abiertos</system:String>
    <system:String x:Key="Str_Tour_PortScanner_Results_Text">Los puertos que respondieron aparecen aquí mientras se ejecuta el escaneo.</system:String>
    <!-- Tour: Cliente TCP y UDP -->
    <system:String x:Key="Str_Tour_SocketClient_Connection_Title">Conexión</system:String>
    <system:String x:Key="Str_Tour_SocketClient_Connection_Text">Elige TCP o UDP y luego introduce el host y el puerto con los que comunicarte.</system:String>
    <system:String x:Key="Str_Tour_SocketClient_Source_Title">Enviar desde</system:String>
    <system:String x:Key="Str_Tour_SocketClient_Source_Text">Elige qué adaptador de red usa la conexión.</system:String>
    <system:String x:Key="Str_Tour_SocketClient_Connect_Title">Conectar</system:String>
    <system:String x:Key="Str_Tour_SocketClient_Connect_Text">Abre la conexión, o ciérrala cuando termines.</system:String>
    <system:String x:Key="Str_Tour_SocketClient_Send_Title">Enviar</system:String>
    <system:String x:Key="Str_Tour_SocketClient_Send_Text">Escribe un mensaje y envíalo. Pulsa Intro como atajo.</system:String>
    <system:String x:Key="Str_Tour_SocketClient_Traffic_Title">Tráfico</system:String>
    <system:String x:Key="Str_Tour_SocketClient_Traffic_Text">Todo lo que envías y recibes aparece aquí, con el recuento de bytes arriba.</system:String>
    <!-- Tour: Finalizador de procesos -->
    <system:String x:Key="Str_Tour_ProcessKiller_Search_Title">Buscar</system:String>
    <system:String x:Key="Str_Tour_ProcessKiller_Search_Text">Busca un proceso por nombre o ID, o averigua qué proceso usa un puerto.</system:String>
    <system:String x:Key="Str_Tour_ProcessKiller_Filter_Title">Filtro</system:String>
    <system:String x:Key="Str_Tour_ProcessKiller_Filter_Text">Muestra todos los procesos, solo aplicaciones, o solo procesos en segundo plano y de Windows.</system:String>
    <system:String x:Key="Str_Tour_ProcessKiller_Locked_Title">Archivo bloqueado</system:String>
    <system:String x:Key="Str_Tour_ProcessKiller_Locked_Text">Suelta un archivo que no se puede borrar ni mover para ver qué procesos lo retienen.</system:String>
    <system:String x:Key="Str_Tour_ProcessKiller_List_Title">Procesos</system:String>
    <system:String x:Key="Str_Tour_ProcessKiller_List_Text">Procesos en ejecución con el uso de CPU y memoria en vivo. Selecciona uno para ver sus detalles.</system:String>
    <system:String x:Key="Str_Tour_ProcessKiller_End_Title">Finalizar proceso</system:String>
    <system:String x:Key="Str_Tour_ProcessKiller_End_Text">Finaliza el proceso seleccionado. Los procesos protegidos del sistema no se pueden finalizar.</system:String>
    <!-- Tour: Monitor del sistema -->
    <system:String x:Key="Str_Tour_SystemMonitor_Sections_Title">Secciones</system:String>
    <system:String x:Key="Str_Tour_SystemMonitor_Sections_Text">Elige una parte de tu equipo, como CPU, memoria, discos o red. Cada una muestra un minigráfico.</system:String>
    <system:String x:Key="Str_Tour_SystemMonitor_Detail_Title">Detalles</system:String>
    <system:String x:Key="Str_Tour_SystemMonitor_Detail_Text">Gráficos en vivo, cifras principales y datos fijos de la sección que elegiste.</system:String>
    <system:String x:Key="Str_Tour_SystemMonitor_Refresh_Title">Actualización</system:String>
    <system:String x:Key="Str_Tour_SystemMonitor_Refresh_Text">Define con qué frecuencia se actualizan las lecturas, o ponlas en pausa.</system:String>
    <system:String x:Key="Str_Tour_SystemMonitor_Report_Title">Informe</system:String>
    <system:String x:Key="Str_Tour_SystemMonitor_Report_Text">Guarda o copia un informe de las lecturas actuales.</system:String>
    <!-- Tour: Sensores de hardware -->
    <system:String x:Key="Str_Tour_HardwareSensors_Parts_Title">Componentes</system:String>
    <system:String x:Key="Str_Tour_HardwareSensors_Parts_Text">Elige un componente de hardware, como el procesador, la tarjeta gráfica o las unidades.</system:String>
    <system:String x:Key="Str_Tour_HardwareSensors_Detail_Title">Sensores</system:String>
    <system:String x:Key="Str_Tour_HardwareSensors_Detail_Text">Temperaturas, velocidades de ventiladores, frecuencias y cargas del componente elegido, con sus valores mínimo y máximo.</system:String>
    <system:String x:Key="Str_Tour_HardwareSensors_Refresh_Title">Actualización</system:String>
    <system:String x:Key="Str_Tour_HardwareSensors_Refresh_Text">Define con qué frecuencia se leen los sensores, o ponlos en pausa.</system:String>
    <system:String x:Key="Str_Tour_HardwareSensors_Units_Title">Unidades</system:String>
    <system:String x:Key="Str_Tour_HardwareSensors_Units_Text">Muestra las temperaturas en grados Celsius o Fahrenheit.</system:String>
    <system:String x:Key="Str_Tour_HardwareSensors_Report_Title">Informe</system:String>
    <system:String x:Key="Str_Tour_HardwareSensors_Report_Text">Guarda o copia un informe de las lecturas actuales de los sensores.</system:String>
    <!-- Tour: Aplicaciones de inicio -->
    <system:String x:Key="Str_Tour_StartupApps_Search_Title">Buscar</system:String>
    <system:String x:Key="Str_Tour_StartupApps_Search_Text">Filtra la lista, consulta cuántas entradas hay y cuáles están activadas.</system:String>
    <system:String x:Key="Str_Tour_StartupApps_Refresh_Title">Actualizar</system:String>
    <system:String x:Key="Str_Tour_StartupApps_Refresh_Text">Vuelve a leer las entradas de inicio.</system:String>
    <system:String x:Key="Str_Tour_StartupApps_Entries_Title">Entradas de inicio</system:String>
    <system:String x:Key="Str_Tour_StartupApps_Entries_Text">Programas que se inician con Windows. Activa o desactiva cada uno para acelerar el inicio de sesión.</system:String>
    <!-- Tour: Servicios -->
    <system:String x:Key="Str_Tour_Services_Search_Title">Buscar y filtrar</system:String>
    <system:String x:Key="Str_Tour_Services_Search_Text">Encuentra un servicio por nombre o descripción y muestra solo los que están en ejecución o detenidos.</system:String>
    <system:String x:Key="Str_Tour_Services_Refresh_Title">Volver a buscar</system:String>
    <system:String x:Key="Str_Tour_Services_Refresh_Text">Vuelve a leer los servicios para ver los cambios hechos fuera de esta herramienta.</system:String>
    <system:String x:Key="Str_Tour_Services_List_Title">Servicios</system:String>
    <system:String x:Key="Str_Tour_Services_List_Text">Inicia, detiene o reinicia un servicio. El menú de tres puntos lo pausa y cambia su tipo de inicio.</system:String>
    <!-- Tour: Cifrado de archivos -->
    <system:String x:Key="Str_Tour_FileEncrypt_Mode_Title">Modo</system:String>
    <system:String x:Key="Str_Tour_FileEncrypt_Mode_Text">Elige si cifrar archivos o descifrar archivos que cifraste antes.</system:String>
    <system:String x:Key="Str_Tour_FileEncrypt_Files_Title">Agrega tus archivos</system:String>
    <system:String x:Key="Str_Tour_FileEncrypt_Files_Text">Suelta aquí archivos o carpetas, o búscalos.</system:String>
    <system:String x:Key="Str_Tour_FileEncrypt_Password_Title">Contraseña</system:String>
    <system:String x:Key="Str_Tour_FileEncrypt_Password_Text">Introduce la contraseña que protege tus archivos. Sin ella, no se pueden abrir.</system:String>
    <system:String x:Key="Str_Tour_FileEncrypt_Run_Title">Iniciar</system:String>
    <system:String x:Key="Str_Tour_FileEncrypt_Run_Text">Cifra o descifra todos los archivos de la lista.</system:String>
    <system:String x:Key="Str_Tour_FileEncrypt_List_Title">Archivos</system:String>
    <system:String x:Key="Str_Tour_FileEncrypt_List_Text">Aquí aparecen tus archivos y el resultado de cada uno.</system:String>
    <!-- Tour: Trituradora de archivos -->
    <system:String x:Key="Str_Tour_Shredder_Files_Title">Agrega tus archivos</system:String>
    <system:String x:Key="Str_Tour_Shredder_Files_Text">Suelta los archivos o carpetas que quieres destruir, o búscalos.</system:String>
    <system:String x:Key="Str_Tour_Shredder_Method_Title">Método</system:String>
    <system:String x:Key="Str_Tour_Shredder_Method_Text">Elige cuántas veces se sobrescriben los datos. Más pasadas son más lentas pero más difíciles de recuperar.</system:String>
    <system:String x:Key="Str_Tour_Shredder_Options_Title">Opciones</system:String>
    <system:String x:Key="Str_Tour_Shredder_Options_Text">Altera nombres y tamaños, elimina las carpetas vaciadas y elige si confirmar antes de triturar.</system:String>
    <system:String x:Key="Str_Tour_Shredder_Run_Title">Triturar</system:String>
    <system:String x:Key="Str_Tour_Shredder_Run_Text">Destruye de forma permanente los archivos seleccionados. No se puede deshacer.</system:String>
    <system:String x:Key="Str_Tour_Shredder_List_Title">Archivos</system:String>
    <system:String x:Key="Str_Tour_Shredder_List_Text">Todo lo que está en cola para triturar, con un resultado para cada elemento.</system:String>
    <!-- Tour: Generador de contraseñas -->
    <system:String x:Key="Str_Tour_PasswordGen_Mode_Title">Tipo</system:String>
    <system:String x:Key="Str_Tour_PasswordGen_Mode_Text">Elige caracteres aleatorios o una frase de contraseña formada por palabras.</system:String>
    <system:String x:Key="Str_Tour_PasswordGen_Random_Title">Caracteres</system:String>
    <system:String x:Key="Str_Tour_PasswordGen_Random_Text">Define la longitud y qué tipos de caracteres incluir.</system:String>
    <system:String x:Key="Str_Tour_PasswordGen_Count_Title">Cuántas</system:String>
    <system:String x:Key="Str_Tour_PasswordGen_Count_Text">Elige cuántas contraseñas crear a la vez.</system:String>
    <system:String x:Key="Str_Tour_PasswordGen_Generate_Title">Generar</system:String>
    <system:String x:Key="Str_Tour_PasswordGen_Generate_Text">Crea contraseñas nuevas con tus ajustes.</system:String>
    <system:String x:Key="Str_Tour_PasswordGen_Results_Title">Contraseñas</system:String>
    <system:String x:Key="Str_Tour_PasswordGen_Results_Text">Tus contraseñas nuevas y su fortaleza. Copia una, o copia o exporta todas.</system:String>
    <!-- Tour: Bóveda de contraseñas -->
    <system:String x:Key="Str_Tour_Vault_Setup_Title">Crea tu bóveda</system:String>
    <system:String x:Key="Str_Tour_Vault_Setup_Text">Elige una contraseña maestra para crear la bóveda. No se puede recuperar si la olvidas.</system:String>
    <system:String x:Key="Str_Tour_Vault_Unlock_Title">Desbloquear</system:String>
    <system:String x:Key="Str_Tour_Vault_Unlock_Text">Introduce tu contraseña maestra para abrir la bóveda.</system:String>
    <system:String x:Key="Str_Tour_Vault_Sidebar_Title">Bóveda</system:String>
    <system:String x:Key="Str_Tour_Vault_Sidebar_Text">Bloquea la bóveda, cambia la contraseña maestra o abre el widget flotante.</system:String>
    <system:String x:Key="Str_Tour_Vault_Backup_Title">Importar y copia de seguridad</system:String>
    <system:String x:Key="Str_Tour_Vault_Backup_Text">Importa entradas desde un archivo CSV, o expórtalas y haz una copia de seguridad de la bóveda.</system:String>
    <system:String x:Key="Str_Tour_Vault_Entries_Title">Entradas</system:String>
    <system:String x:Key="Str_Tour_Vault_Entries_Text">Busca y explora tus inicios de sesión guardados, organizados en grupos. Selecciona uno para verlo o editarlo.</system:String>
    <system:String x:Key="Str_Tour_Vault_New_Title">Nueva entrada</system:String>
    <system:String x:Key="Str_Tour_Vault_New_Text">Agrega un nuevo inicio de sesión a la bóveda.</system:String>

    <!-- Tour: DiskSpace -->
    <system:String x:Key="Str_Tour_DiskSpace_Scope_Title">Qué analizar</system:String>
    <system:String x:Key="Str_Tour_DiskSpace_Scope_Text">Elige una unidad o una carpeta para analizar.</system:String>
    <system:String x:Key="Str_Tour_DiskSpace_Options_Title">Opciones de análisis</system:String>
    <system:String x:Key="Str_Tour_DiskSpace_Options_Text">Ajusta cómo se realiza el análisis.</system:String>
    <system:String x:Key="Str_Tour_DiskSpace_Scan_Title">Analizar</system:String>
    <system:String x:Key="Str_Tour_DiskSpace_Scan_Text">Inicia el análisis para ver qué ocupa tu espacio.</system:String>
    <system:String x:Key="Str_Tour_DiskSpace_Results_Title">Uso del espacio</system:String>
    <system:String x:Key="Str_Tour_DiskSpace_Results_Text">Explora las carpetas y archivos más grandes como lista o mapa de árbol.</system:String>
    <!-- Tour: DiskSpeed -->
