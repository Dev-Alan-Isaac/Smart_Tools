    <system:String x:Key="Str_Tour_NetWidget_Live_Title">Velocidad en vivo</system:String>
    <system:String x:Key="Str_Tour_NetWidget_Live_Text">Velocidad actual de descarga y subida, un gráfico breve y el adaptador que se mide.</system:String>
    <system:String x:Key="Str_Tour_NetWidget_Adapter_Title">Adaptador</system:String>
    <system:String x:Key="Str_Tour_NetWidget_Adapter_Text">Elige qué adaptador de red medir.</system:String>
    <system:String x:Key="Str_Tour_NetWidget_Show_Title">Widget flotante</system:String>
    <system:String x:Key="Str_Tour_NetWidget_Show_Text">Muestra u oculta un pequeño widget siempre visible con los mismos números en vivo.</system:String>
    <system:String x:Key="Str_Tool_net-speed_Name">Velocidad de red</system:String>
    <system:String x:Key="Str_Tool_net-speed_Description">Un medidor de descarga y subida en vivo que puede flotar en pantalla, con el fabricante del adaptador</system:String>
    <system:String x:Key="Str_Tool_image-metadata-cleaner_Name">Limpiador de metadatos de imágenes</system:String>
    <system:String x:Key="Str_Tool_image-metadata-cleaner_Description">Quita la ubicación, la cámara y la fecha de muchas fotos antes de compartirlas</system:String>
    <system:String x:Key="Str_MetaClean_Pictures">IMÁGENES</system:String>
    <system:String x:Key="Str_MetaClean_ModeHeader">QUÉ QUITAR</system:String>
    <system:String x:Key="Str_MetaClean_ModeEverything">Todo</system:String>
    <system:String x:Key="Str_MetaClean_ModeLocation">Solo ubicación</system:String>
    <system:String x:Key="Str_MetaClean_HintEverything">Quita la ubicación, la cámara, la fecha, el programa y los comentarios. El perfil de color se queda. Los JPG se limpian sin perder calidad.</system:String>
    <system:String x:Key="Str_MetaClean_HintLocation">Quita solo dónde se tomó la imagen. La cámara y la fecha se quedan. La imagen se guarda de nuevo, así que los JPG cambian un poco.</system:String>
    <system:String x:Key="Str_MetaClean_Suffix">Se añade al nombre</system:String>
    <system:String x:Key="Str_MetaClean_SuffixHint">foto.jpg pasa a foto-clean.jpg. Si el nombre ya existe se añade un número.</system:String>
