    <system:String x:Key="Str_DateTimeTool_IsoProblem_BadYear">El año debe ser 0001 o posterior.</system:String>
    <system:String x:Key="Str_DateTimeTool_IsoProblem_BadMonth">El mes debe ser de 01 a 12.</system:String>
    <system:String x:Key="Str_DateTimeTool_IsoProblem_BadDay">Ese día no existe en ese mes.</system:String>
