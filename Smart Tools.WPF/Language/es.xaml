    <!--  ============ DRIVE HEALTH ============  -->
    <system:String x:Key="Str_DriveHealth_Title">Monitor de Salud de Unidades</system:String>
    <system:String x:Key="Str_DriveHealth_RefreshTooltip">Volver a escanear las unidades conectadas</system:String>
    <system:String x:Key="Str_DriveHealth_SmartExplainer">El detalle SMART (temperatura, horas encendido, sectores reasignados) requiere que la app se ejecute como administrador, y se lee directamente de unidades SATA - debería funcionar para la mayoría de HDDs/SSDs internos al elevar permisos. Las unidades NVMe usan un mecanismo SMART diferente que esto aún no cubre, y algunos gabinetes USB/controladores RAID ocultan SMART completamente a Windows - esos solo mostrarán tipo de medio y estado de salud, lo cual es esperado, no un error.</system:String>
    <system:String x:Key="Str_DriveHealth_ElevationWarning">No se está ejecutando como administrador - el detalle SMART (temperatura, horas encendido, conteo de sectores) no estará disponible para unidades SATA hasta que reinicies con permisos elevados.</system:String>
    <system:String x:Key="Str_DriveHealth_RestartAsAdmin">Reiniciar como Administrador</system:String>
    <system:String x:Key="Str_DriveHealth_RestartAsAdminTooltip">Vuelve a iniciar esta app con privilegios de administrador</system:String>

    <system:String x:Key="Str_HardwareSensors_ThisPc">Este equipo</system:String>
    <system:String x:Key="Str_HardwareSensors_AdminTitle">Algunos sensores necesitan permisos de administrador</system:String>
    <system:String x:Key="Str_HardwareSensors_AdminWarning">Como usuario estándar no se pueden leer los sensores de CPU y placa base (temperaturas, voltajes, ventiladores) ni los datos SMART de las unidades, por eso faltan o muestran 0. Reinicia como administrador para leerlos.</system:String>
    <system:String x:Key="Str_HardwareSensors_AdminAndDriverWarning">Como usuario estándar no se pueden leer los sensores de CPU y placa base (temperaturas, voltajes, ventiladores) ni los datos SMART de las unidades, por eso faltan o muestran 0. Reinicia como administrador para leer las unidades; los sensores de CPU y placa base también necesitan el controlador PawnIO (pawnio.eu) instalado.</system:String>
    <system:String x:Key="Str_HardwareSensors_DriverTitle">Los sensores de CPU y placa base necesitan el controlador PawnIO</system:String>
    <system:String x:Key="Str_HardwareSensors_DriverWarning">LibreHardwareMonitor lee las temperaturas, voltajes y ventiladores de la CPU y la placa base mediante el controlador PawnIO, que no está instalado en este equipo, por eso faltan o muestran 0. Instálalo y vuelve a abrir esta página.</system:String>
    <system:String x:Key="Str_HardwareSensors_GetDriver">Obtener PawnIO</system:String>
    <system:String x:Key="Str_HardwareSensors_GetDriverTooltip">Abre pawnio.eu en el navegador</system:String>
    <system:String x:Key="Str_HardwareSensors_HideBanner">Ocultar por ahora</system:String>
    <system:String x:Key="Str_HardwareSensors_RestartConfirm">Smart Tools se cerrará y se abrirá de nuevo como administrador para poder leer todos los sensores.&#x0a;&#x0a;Se perderá lo que no hayas guardado en otras herramientas. ¿Continuar?</system:String>
    <system:String x:Key="Str_DriveHealth_EmptyState">No se encontraron unidades, o la información de unidades no está disponible en este sistema.</system:String>
    <system:String x:Key="Str_DriveHealth_ReallocatedSuffix">reasignados</system:String>
    <system:String x:Key="Str_DriveHealth_PendingSuffix">pendientes</system:String>
    <system:String x:Key="Str_DriveHealth_HrsOnSuffix">h encendido</system:String>
    <system:String x:Key="Str_DriveHealth_SmartUnavailable">Detalle SMART no disponible para esta unidad (común en NVMe/USB/RAID, o cuando no se ejecuta como administrador).</system:String>
    <system:String x:Key="Str_DriveHealth_Subtitle">Consulta el estado SMART, la temperatura y el estado de salud de cada unidad conectada a este equipo.</system:String>

