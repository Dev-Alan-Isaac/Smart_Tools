    <system:String x:Key="Str_Settings_ClipboardKeepTip">Guarda el historial al copiar algo y lo carga la próxima vez que inicie Smart Tools.</system:String>
    <system:String x:Key="Str_Settings_ClipboardDelete">Borrar historial</system:String>
    <system:String x:Key="Str_Settings_ClipboardDeleteTip">Quita todo del historial del portapapeles, también lo anclado, y borra la copia guardada.</system:String>
    <system:String x:Key="Str_Settings_ClipboardDeleteText">¿Borrar todo el historial del portapapeles, incluidos los elementos anclados y la copia guardada?</system:String>
