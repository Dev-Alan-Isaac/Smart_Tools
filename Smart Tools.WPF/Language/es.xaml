    <system:String x:Key="Str_DateTimeTool_RfcValidText">Una marca de tiempo de internet: fecha completa, hora con segundos y desfase.</system:String>
    <system:String x:Key="Str_DateTimeTool_IsoOffsetAssumed">No se indicó desfase, así que la hora se lee como UTC.</system:String>
    <system:String x:Key="Str_DateTimeTool_IsoLeapSecond">Un segundo intercalar (:60) se muestra como el primer segundo del minuto siguiente.</system:String>
