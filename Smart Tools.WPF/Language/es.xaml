    <system:String x:Key="Str_DateTimeTool_IsoEmptyTitle">Comprueba y convierte ISO 8601 / RFC 3339</system:String>
    <system:String x:Key="Str_DateTimeTool_IsoEmptyHint">Pega una marca de tiempo para ver si es ISO 8601 válido y RFC 3339 válido, y leerla en las otras formas. O prueba una de estas:</system:String>
    <system:String x:Key="Str_DateTimeTool_IsoValid">ISO 8601 válido</system:String>
