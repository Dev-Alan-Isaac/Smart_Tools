    <!--  Audio Output Tester (audio-output-test)  -->
    <system:String x:Key="Str_AudioOut_Header">Audio output test</system:String>
    <system:String x:Key="Str_AudioOut_DeviceHeader">OUTPUT DEVICE</system:String>
    <system:String x:Key="Str_AudioOut_DeviceTip">Any speaker, headphone, USB DAC or Bluetooth output Windows has active. The star is the Windows default.</system:String>
    <system:String x:Key="Str_AudioOut_Refresh">Look for devices again</system:String>
