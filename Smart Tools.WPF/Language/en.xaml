    <system:String x:Key="Str_GameCtl_LeftStick">Left stick</system:String>
    <system:String x:Key="Str_GameCtl_RightStick">Right stick</system:String>
    <system:String x:Key="Str_GameCtl_Triggers">Triggers</system:String>
    <system:String x:Key="Str_GameCtl_Defaults">Windows defaults</system:String>
    <system:String x:Key="Str_GameCtl_DefaultsTip">The values Microsoft recommends for Xbox-style controllers: 24%, 27% and 12%.</system:String>
    <system:String x:Key="Str_GameCtl_DefaultsApplied">Dead zones set to the Windows defaults</system:String>
    <system:String x:Key="Str_GameCtl_VibrationHeader">VIBRATION</system:String>
    <system:String x:Key="Str_GameCtl_MotorLeft">Left motor (heavy)</system:String>
    <system:String x:Key="Str_GameCtl_MotorRight">Right motor (light)</system:String>
    <system:String x:Key="Str_GameCtl_Pulse">Short pulse</system:String>
    <system:String x:Key="Str_GameCtl_PulseTip">Both motors at full for half a second.</system:String>
    <system:String x:Key="Str_GameCtl_VibrationOnlyXInput">Vibration can only be tested on Xbox-style controllers.</system:String>
    <system:String x:Key="Str_GameCtl_TabLive">Live</system:String>
    <system:String x:Key="Str_GameCtl_TabSticks">Drift and range</system:String>
    <system:String x:Key="Str_GameCtl_TabTriggers">Triggers</system:String>
    <system:String x:Key="Str_GameCtl_PlotLegend">Ring: the stick as the controller reports it. Dot: after the dead zone. Dashed shape: the dead zone.</system:String>
    <system:String x:Key="Str_GameCtl_AxesXY">Axes 1 and 2</system:String>
    <system:String x:Key="Str_GameCtl_AxesZR">Axes 3 and 4</system:String>
    <system:String x:Key="Str_GameCtl_Axes">All axes</system:String>
    <system:String x:Key="Str_GameCtl_AxisN">Axis {0}</system:String>
    <system:String x:Key="Str_GameCtl_Buttons">Buttons</system:String>
    <system:String x:Key="Str_GameCtl_Pov">Hat switch: {0}</system:String>
    <system:String x:Key="Str_GameCtl_PovCentered">centered</system:String>
    <system:String x:Key="Str_GameCtl_Rate">≈ {0} Hz  ({1:0} measured)</system:String>
    <system:String x:Key="Str_GameCtl_RateTip">How many times per second the controller sends a new reading. Move a stick to measure it. USB pads are usually 125 to 1000 Hz; Bluetooth is often lower and less steady.</system:String>
    <system:String x:Key="Str_GameCtl_SticksIntro">Rest test: let go of the stick for 3 seconds to see where it really rests and how much it drifts. Range test: for 10 seconds roll the stick slowly around its whole edge to see how far it goes and how round its movement is.</system:String>
    <system:String x:Key="Str_GameCtl_RestTest">Rest test (3 s)</system:String>
    <system:String x:Key="Str_GameCtl_RestTip">Don't touch the stick.</system:String>
    <system:String x:Key="Str_GameCtl_RangeTest">Range test (10 s)</system:String>
    <system:String x:Key="Str_GameCtl_RangeTip">Roll the stick slowly around its full edge.</system:String>
    <system:String x:Key="Str_GameCtl_RestRunning">Don't touch the stick... {0:0.0} s</system:String>
    <system:String x:Key="Str_GameCtl_RangeRunning">Roll the stick slowly around its full edge... {0:0.0} s</system:String>
    <system:String x:Key="Str_GameCtl_NoData">Not enough readings. Try again.</system:String>
    <system:String x:Key="Str_GameCtl_RestResult">Rests at X {0}, Y {1}. It wanders up to {2:0.0}% from the middle. The smallest dead zone that hides this is {3}%.</system:String>
    <system:String x:Key="Str_GameCtl_RestPerfect">A perfectly still stick: it needs no dead zone.</system:String>
    <system:String x:Key="Str_GameCtl_RestCovered">Your dead zone of {0}% covers this, so there should be no drift in games.</system:String>
    <system:String x:Key="Str_GameCtl_RestDrifts">Your dead zone of {0}% is smaller than the drift: the character may creep in games.</system:String>
    <system:String x:Key="Str_GameCtl_UseSuggested">Use {0}% as dead zone</system:String>
    <system:String x:Key="Str_GameCtl_DeadzoneSet">Dead zone set to {0}%</system:String>
    <system:String x:Key="Str_GameCtl_RangeNone">Not enough of the edge was reached. Roll the stick all the way around its edge and try again.</system:String>
    <system:String x:Key="Str_GameCtl_RangeResult">Reaches {0:0}% of full travel · roundness {1:0}% · {2:0}% of the circle covered.</system:String>
    <system:String x:Key="Str_GameCtl_ShapeRound">Very round: a smooth gate.</system:String>
    <system:String x:Key="Str_GameCtl_ShapeOctagon">Slightly flattened: normal for an octagonal gate or a little wear.</system:String>
    <system:String x:Key="Str_GameCtl_ShapeUneven">Uneven: the stick reaches much further in some directions. This can mean a worn, dirty or damaged stick.</system:String>
    <system:String x:Key="Str_GameCtl_ReachShort">It never reaches full travel: games may not see 100% push.</system:String>
    <system:String x:Key="Str_GameCtl_CoverageLow">Parts of the circle were not reached; roll the whole way around for a fair result.</system:String>
    <system:String x:Key="Str_GameCtl_TriggersIntro">Press Record, then pull the trigger slowly and evenly all the way down and let go. The chart shows value against time; the dashed line is your trigger threshold.</system:String>
    <system:String x:Key="Str_GameCtl_Record">Record a pull</system:String>
    <system:String x:Key="Str_GameCtl_TriggerRunning">Pull slowly all the way, then let go...</system:String>
    <system:String x:Key="Str_GameCtl_TriggerNone">No full pull was seen. Pull the trigger all the way down and try again.</system:String>
    <system:String x:Key="Str_GameCtl_TriggerResult">Starts registering at {0:0} of 255 · reaches {1:0} · evenness {2:0}%.</system:String>
    <system:String x:Key="Str_GameCtl_TriggerEven">An even response.</system:String>
    <system:String x:Key="Str_GameCtl_TriggerUneven">An uneven response: some parts of the pull change faster than others (normal for some hall-effect and spring triggers).</system:String>
    <system:String x:Key="Str_GameCtl_TriggerShort">It does not reach 255: a game may never see a full press.</system:String>

    <!--  Monitor Test (monitor-test)  -->
    <system:String x:Key="Str_Monitor_Header">Monitor test</system:String>
    <system:String x:Key="Str_Monitor_ScreenHeader">SCREEN</system:String>
    <system:String x:Key="Str_Monitor_ScreenTip">The screen the test pictures will cover.</system:String>
