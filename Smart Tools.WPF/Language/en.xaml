    <system:String x:Key="Str_PdfReader_ZoomIn">Zoom in</system:String>
    <system:String x:Key="Str_PdfReader_ZoomOut">Zoom out</system:String>
    <system:String x:Key="Str_PdfReader_ZoomFit">Fit to width</system:String>
    <system:String x:Key="Str_PdfReader_EmptyTitle">No PDF open</system:String>
    <system:String x:Key="Str_PdfReader_EmptyHint">Open a PDF or drop one here. Then add your signature, text, a date or check marks and save a new copy.</system:String>
    <system:String x:Key="Str_PdfReader_Opening">Opening…</system:String>
    <system:String x:Key="Str_PdfReader_Pages">{0} pages</system:String>
