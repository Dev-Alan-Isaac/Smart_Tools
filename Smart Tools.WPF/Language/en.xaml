    <system:String x:Key="Str_DateTimeTool_RfcValidText">An internet timestamp: full date, time with seconds, and an offset.</system:String>
    <system:String x:Key="Str_DateTimeTool_IsoOffsetAssumed">No offset was given, so the time is read as UTC.</system:String>
    <system:String x:Key="Str_DateTimeTool_IsoLeapSecond">A leap second (:60) is shown as the first second of the next minute.</system:String>
    <system:String x:Key="Str_DateTimeTool_IsoBasicForm">basic format</system:String>
    <system:String x:Key="Str_DateTimeTool_IsoExtendedForm">extended format</system:String>
