    <system:String x:Key="Str_GameCtl_EmptyTitle">No game controller found</system:String>
    <system:String x:Key="Str_GameCtl_EmptyHint">Plug in a controller by USB, or pair one by Bluetooth, then press the button below. Xbox-style pads and other game devices (joysticks, wheels, many PlayStation and generic pads) are both read.</system:String>
    <system:String x:Key="Str_GameCtl_NothingNew">No change: the same controllers are connected.</system:String>
