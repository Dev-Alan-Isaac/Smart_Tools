    <system:String x:Key="Str_Tour_NetWidget_Live_Title">Live speed</system:String>
    <system:String x:Key="Str_Tour_NetWidget_Live_Text">Current download and upload speed, a short graph, and the adapter being measured.</system:String>
    <system:String x:Key="Str_Tour_NetWidget_Adapter_Title">Adapter</system:String>
    <system:String x:Key="Str_Tour_NetWidget_Adapter_Text">Choose which network adapter to measure.</system:String>
    <system:String x:Key="Str_Tour_NetWidget_Show_Title">Floating widget</system:String>
    <system:String x:Key="Str_Tour_NetWidget_Show_Text">Show or hide a small always-on-top widget with the same live numbers.</system:String>
    <system:String x:Key="Str_Tool_net-speed_Name">Network Speed</system:String>
    <system:String x:Key="Str_Tool_net-speed_Description">A live download and upload meter that can float on your screen, with the adapter's manufacturer</system:String>
    <system:String x:Key="Str_Tool_image-metadata-cleaner_Name">Image Metadata Cleaner</system:String>
    <system:String x:Key="Str_Tool_image-metadata-cleaner_Description">Remove location, camera and date details from many photos before you share them</system:String>
    <system:String x:Key="Str_MetaClean_Pictures">PICTURES</system:String>
    <system:String x:Key="Str_MetaClean_ModeHeader">WHAT TO REMOVE</system:String>
    <system:String x:Key="Str_MetaClean_ModeEverything">Everything</system:String>
    <system:String x:Key="Str_MetaClean_ModeLocation">Location only</system:String>
    <system:String x:Key="Str_MetaClean_HintEverything">Removes location, camera, date, software and comments. The color profile stays. JPG files are cleaned without any quality loss.</system:String>
    <system:String x:Key="Str_MetaClean_HintLocation">Removes only where the picture was taken. Camera and date stay. The picture is saved again, so JPG files change a tiny bit.</system:String>
    <system:String x:Key="Str_MetaClean_Suffix">Added to the file name</system:String>
    <system:String x:Key="Str_MetaClean_SuffixHint">photo.jpg becomes photo-clean.jpg. A number is added if the name is taken.</system:String>
    <system:String x:Key="Str_MetaClean_SaveTo">SAVE TO</system:String>
    <system:String x:Key="Str_MetaClean_Run">Clean</system:String>
    <system:String x:Key="Str_MetaClean_Cancel">Cancel</system:String>
    <system:String x:Key="Str_MetaClean_ColName">Picture</system:String>
    <system:String x:Key="Str_MetaClean_ColFound">Found inside</system:String>
    <system:String x:Key="Str_MetaClean_ColAfter">After</system:String>
    <system:String x:Key="Str_MetaClean_ColStatus">Status</system:String>
    <system:String x:Key="Str_MetaClean_ShowResult">Show the clean copy in its folder</system:String>
    <system:String x:Key="Str_MetaClean_RemoveItem">Remove from the list</system:String>
    <system:String x:Key="Str_MetaClean_EmptyTitle">No pictures yet</system:String>
    <system:String x:Key="Str_MetaClean_EmptyHint">Drop photos or folders here, or use the Pictures card. You will see what each one is hiding before you clean it.</system:String>
    <system:String x:Key="Str_MetaClean_StatusPending">Waiting</system:String>
    <system:String x:Key="Str_MetaClean_StatusWorking">Cleaning</system:String>
