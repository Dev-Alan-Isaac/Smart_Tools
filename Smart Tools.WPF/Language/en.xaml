    <system:String x:Key="Str_AudioOut_DeviceInfo">{0} channels · {1:0.#} kHz (the device's own format)</system:String>
    <system:String x:Key="Str_AudioOut_LevelHeader">LEVEL</system:String>
    <system:String x:Key="Str_AudioOut_Level">Loudness</system:String>
    <system:String x:Key="Str_AudioOut_LevelSafety">Start with the volume low and raise it slowly. The top of this slider is still loud in headphones and in-ears.</system:String>
