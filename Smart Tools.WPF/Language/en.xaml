    <system:String x:Key="Str_MetaClean_Finished">Finished.</system:String>
    <system:String x:Key="Str_MetaClean_Summary">{0} cleaned, {1} skipped, {2} failed.</system:String>
    <system:String x:Key="Str_MetaClean_SeeRows">Point at a status to see why.</system:String>
    <system:String x:Key="Str_MetaClean_LocationsRemoved">{0} locations removed</system:String>
    <system:String x:Key="Str_MetaClean_CleanCopies">{0} clean copies</system:String>
    <system:String x:Key="Str_Tour_MetaClean_Input_Title">Your pictures</system:String>
    <system:String x:Key="Str_Tour_MetaClean_Input_Text">Add photos or whole folders. Each one shows what is hidden inside: a GPS location, the camera and the date it was taken.</system:String>
    <system:String x:Key="Str_Tour_MetaClean_Mode_Title">What to remove</system:String>
    <system:String x:Key="Str_Tour_MetaClean_Mode_Text">Remove everything, or only the location and keep the rest. Clean copies get a short ending added to their name.</system:String>
    <system:String x:Key="Str_Tour_MetaClean_Output_Title">Where copies go</system:String>
    <system:String x:Key="Str_Tour_MetaClean_Output_Text">Next to the originals or in a folder you choose. Originals are never changed or replaced.</system:String>
    <system:String x:Key="Str_Tour_MetaClean_Run_Title">Clean</system:String>
    <system:String x:Key="Str_Tour_MetaClean_Run_Text">Starts the batch. The pills show how many photos carry a location and how many were cleaned.</system:String>
    <system:String x:Key="Str_Tour_MetaClean_Results_Title">Results</system:String>
    <system:String x:Key="Str_Tour_MetaClean_Results_Text">What each picture was hiding and what happened to it. Point at a status to see why one was skipped.</system:String>
    <system:String x:Key="Str_Tool_pdf-reader_Name">PDF Reader &amp; Signer</system:String>
    <system:String x:Key="Str_Tool_pdf-reader_Description">Read a PDF, then add your signature, text, a date or a check mark and save a signed copy</system:String>
    <system:String x:Key="Str_PdfReader_FileHeader">PDF FILES</system:String>
    <system:String x:Key="Str_PdfReader_Open">Open a PDF…</system:String>
    <system:String x:Key="Str_PdfReader_Password">Password</system:String>
    <system:String x:Key="Str_PdfReader_Unlock">Unlock</system:String>
    <system:String x:Key="Str_PdfReader_SignatureHeader">YOUR SIGNATURE</system:String>
    <system:String x:Key="Str_PdfReader_NoSignature">No signature yet</system:String>
    <system:String x:Key="Str_PdfReader_Draw">Draw</system:String>
    <system:String x:Key="Str_PdfReader_Type">Type</system:String>
    <system:String x:Key="Str_PdfReader_Picture">Picture</system:String>
    <system:String x:Key="Str_PdfReader_Forget">Forget my signature</system:String>
    <system:String x:Key="Str_PdfReader_SignatureHint">Draw it with the mouse, type your name, or use a photo of your signature on white paper. It is kept on this PC so you only make it once. This is a picture of a signature, not a certified digital signature.</system:String>
    <system:String x:Key="Str_PdfReader_AddHeader">ADD TO THE PAGE</system:String>
    <system:String x:Key="Str_PdfReader_AddSignature">Signature</system:String>
    <system:String x:Key="Str_PdfReader_AddText">Text</system:String>
    <system:String x:Key="Str_PdfReader_AddDate">Date</system:String>
    <system:String x:Key="Str_PdfReader_AddCheck">Check mark</system:String>
    <system:String x:Key="Str_PdfReader_AddHint">It lands in the middle of the page you are looking at. Drag it where you want it.</system:String>
    <system:String x:Key="Str_PdfReader_SelectedHeader">SELECTED</system:String>
    <system:String x:Key="Str_PdfReader_NothingSelected">Click something on the page to change its size or text. Press Delete to remove it.</system:String>
