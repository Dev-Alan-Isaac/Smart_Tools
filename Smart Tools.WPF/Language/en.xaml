    <!--  ============ DRIVE HEALTH ============  -->
    <system:String x:Key="Str_DriveHealth_Title">Drive Health Monitor</system:String>
    <system:String x:Key="Str_DriveHealth_RefreshTooltip">Rescan attached drives</system:String>
    <system:String x:Key="Str_DriveHealth_SmartExplainer">SMART detail (temperature, power-on hours, reallocated sectors) needs the app running as administrator, and is read directly from SATA drives - it should work for most internal HDDs/SSDs when elevated. NVMe drives use a different SMART mechanism this doesn't cover yet, and some USB enclosures/RAID controllers hide SMART from Windows entirely - those will show media type and health status only, which is expected, not an error.</system:String>
    <system:String x:Key="Str_DriveHealth_ElevationWarning">Not running as administrator - SMART detail (temperature, power-on hours, sector counts) won't be available for SATA drives until you restart elevated.</system:String>
    <system:String x:Key="Str_DriveHealth_RestartAsAdmin">Restart as Administrator</system:String>
    <system:String x:Key="Str_DriveHealth_RestartAsAdminTooltip">Relaunch this app with administrator privileges</system:String>

