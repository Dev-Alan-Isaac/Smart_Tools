    <system:String x:Key="Str_GameCtl_Unplugged">Controller disconnected ({0} found)</system:String>
    <system:String x:Key="Str_GameCtl_Lost">The controller stopped answering. Check the cable or the battery.</system:String>
    <system:String x:Key="Str_GameCtl_DeadzoneHeader">DEAD ZONES</system:String>
    <system:String x:Key="Str_GameCtl_ModeAxial">Axial</system:String>
    <system:String x:Key="Str_GameCtl_ModeAxialTip">Each direction on its own: a square dead area.</system:String>
    <system:String x:Key="Str_GameCtl_ModeRadial">Radial</system:String>
    <system:String x:Key="Str_GameCtl_ModeRadialTip">By distance from the middle: a round dead area.</system:String>
