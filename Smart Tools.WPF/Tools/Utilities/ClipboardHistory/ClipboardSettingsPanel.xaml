<UserControl
    x:Class="Smart_Tools.WPF.Views.ClipboardSettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!--  The Clipboard history section of Settings. Logic: ClipboardHistoryService. UI only.  -->
    <StackPanel>
        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <ContentControl
                    Content="{DynamicResource Str_Settings_ClipboardRecording}"
                    Style="{StaticResource CardHeader}"
                    Tag="{x:Static materialDesign:PackIconKind.RecordCircleOutline}" />
                <TextBlock
                    Margin="0,4,0,14"
                    FontSize="12"
                    Foreground="{DynamicResource TextSecondary}"
                    Text="{DynamicResource Str_Settings_ClipboardRecordingHint}"
                    TextWrapping="Wrap" />
                <CheckBox
                    x:Name="ChkClipboardBackground"
                    Click="ChkClipboardBackground_Click"
                    Content="{DynamicResource Str_Settings_ClipboardBackground}"
                    ToolTip="{DynamicResource Str_Settings_ClipboardBackgroundTip}" />
            </StackPanel>
        </Border>

        <Border Margin="0,14,0,0" Style="{StaticResource CardStyle}">
            <StackPanel>
                <ContentControl
                    Content="{DynamicResource Str_Settings_ClipboardSaved}"
                    Style="{StaticResource CardHeader}"
                    Tag="{x:Static materialDesign:PackIconKind.ContentSaveOutline}" />
                <TextBlock
                    Margin="0,4,0,14"
                    FontSize="12"
                    Foreground="{DynamicResource TextSecondary}"
                    Text="{DynamicResource Str_Settings_ClipboardSavedHint}"
                    TextWrapping="Wrap" />
                <CheckBox
                    x:Name="ChkClipboardKeep"
                    Click="ChkClipboardKeep_Click"
                    Content="{DynamicResource Str_Settings_ClipboardKeep}"
                    ToolTip="{DynamicResource Str_Settings_ClipboardKeepTip}" />
                <Button
                    Margin="0,14,0,0"
                    HorizontalAlignment="Left"
                    Click="BtnClipboardDelete_Click"
                    Style="{StaticResource NeutralIconButtonStyle}"
                    ToolTip="{DynamicResource Str_Settings_ClipboardDeleteTip}">
                    <Grid Margin="8,0" HorizontalAlignment="Center">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon
                            Grid.Column="0"
                            Width="15"
                            Height="15"
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Kind="DeleteOutline" />
                        <TextBlock
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Text="{DynamicResource Str_Settings_ClipboardDelete}" />
                    </Grid>
                </Button>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
