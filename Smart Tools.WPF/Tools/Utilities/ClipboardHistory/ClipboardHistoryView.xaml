<UserControl
    x:Class="Smart_Tools.WPF.Views.ClipboardHistoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:Smart_Tools.WPF.Models"
    xmlns:views="clr-namespace:Smart_Tools.WPF.Views"
    x:Name="Root"
    d:DesignHeight="650"
    d:DesignWidth="900"
    mc:Ignorable="d"
    Loaded="View_Loaded">

    <!--
        Clipboard History - what you copied while this tool was open. Kept in memory only.
        Backend: Controllers/ClipboardHistoryManager*.cs; Models/ClipboardHistoryModel.cs. UI only here.
    -->

    <UserControl.Resources>

        <!--  Rows fill the list, so each row's buttons sit at the right edge  -->
        <Style
            x:Key="StretchRowStyle"
            BasedOn="{StaticResource {x:Type ListBoxItem}}"
            TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>

        <views:PngToImageConverter x:Key="PngToImage" />
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!--  Pin: filled when pinned  -->
        <Style x:Key="PinIconStyle" TargetType="materialDesign:PackIcon">
            <Setter Property="Kind" Value="PinOutline" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsPinned}" Value="True">
                    <Setter Property="Kind" Value="Pin" />
                    <Setter Property="Foreground" Value="{DynamicResource AccentColor}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  Text items show a text icon; picture items show the picture  -->
        <Style x:Key="TextBadgeIconStyle" TargetType="materialDesign:PackIcon">
            <Setter Property="Kind" Value="TextBoxOutline" />
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsImage}" Value="True">
                    <Setter Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <DataTemplate DataType="{x:Type models:ClipboardItem}">
            <Grid Margin="0,4">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="44"
                    Height="44"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Background="{DynamicResource AccentColorSubtle}"
                    ClipToBounds="True"
                    CornerRadius="8">
                    <Grid>
                        <materialDesign:PackIcon
                            Width="22"
                            Height="22"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Style="{StaticResource TextBadgeIconStyle}" />
                        <Image
                            Source="{Binding ImagePng, Converter={StaticResource PngToImage}}"
                            Stretch="UniformToFill"
                            Visibility="{Binding IsImage, Converter={StaticResource BoolToVisibility}}" />
                    </Grid>
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        MaxHeight="36"
                        Foreground="{DynamicResource TextPrimary}"
                        Text="{Binding Preview}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                    <TextBlock
                        Margin="0,2,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource TextSecondary}"
                        Text="{Binding MetaText}" />
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    Margin="8,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button
                        Margin="0,0,2,0"
                        Click="BtnPin_Click"
                        Style="{StaticResource ListToolButtonStyle}"
                        ToolTip="{DynamicResource Str_Clipboard_Pin}">
                        <materialDesign:PackIcon
                            Width="16"
                            Height="16"
                            Style="{StaticResource PinIconStyle}" />
                    </Button>
                    <Button
                        Margin="0,0,2,0"
                        Click="BtnCopy_Click"
                        Style="{StaticResource ListToolButtonStyle}"
                        ToolTip="{DynamicResource Str_Clipboard_Copy}">
                        <materialDesign:PackIcon
                            Width="16"
                            Height="16"
                            Kind="ContentCopy" />
                    </Button>
                    <Button
                        Click="BtnDelete_Click"
                        Style="{StaticResource ListToolDangerButtonStyle}"
                        ToolTip="{DynamicResource Str_Clipboard_Delete}">
                        <materialDesign:PackIcon
                            Width="16"
                            Height="16"
                            Kind="DeleteOutline" />
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">

        <!--  No page header: MainWindow's header card shows the tool's icon and name.  -->

        <Grid Margin="16,8,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Search, status, pause, clear  -->
            <Border ctl:Tour.Key="Str_Tour_Clipboard_Search" ctl:Tour.Order="1" Margin="0,0,0,12" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Style="{StaticResource InputBarStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon
                                Width="16"
                                Height="16"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextSecondary}"
                                Kind="Magnify" />
                            <TextBox
                                x:Name="TxtSearch"
                                Grid.Column="1"
                                Margin="6,0,6,0"
                                VerticalAlignment="Center"
                                Tag="{DynamicResource Str_Clipboard_SearchPlaceholder}"
                                Style="{StaticResource BareTextBox}"
                                TextChanged="TxtSearch_TextChanged" />
                        </Grid>
                    </Border>

                    <StackPanel
                        Grid.Column="1"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <ComboBox
                            x:Name="CmbDays"
                            Width="160"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            SelectedIndex="0"
                            SelectionChanged="CmbDays_SelectionChanged"
                            ToolTip="{DynamicResource Str_Clipboard_DaysTip}">
                            <ComboBoxItem Content="{DynamicResource Str_Clipboard_DaysAll}" Tag="all" />
                            <ComboBoxItem Content="{DynamicResource Str_Clipboard_DaysToday}" Tag="today" />
                            <ComboBoxItem Content="{DynamicResource Str_Clipboard_DaysYesterday}" Tag="yesterday" />
                            <ComboBoxItem Content="{DynamicResource Str_Clipboard_DaysWeek}" Tag="week" />
                            <ComboBoxItem Content="{DynamicResource Str_Clipboard_DaysMonth}" Tag="month" />
                            <ComboBoxItem Content="{DynamicResource Str_Clipboard_DaysOlder}" Tag="older" />
                        </ComboBox>
                        <Button
                            x:Name="BtnWidget"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Click="BtnWidget_Click"
                            Style="{StaticResource ListToolButtonStyle}"
                            ToolTip="{DynamicResource Str_Clipboard_WidgetPin}">
                            <materialDesign:PackIcon
                                x:Name="IconWidget"
                                Width="16"
                                Height="16"
                                Kind="PictureInPictureBottomRight" />
                        </Button>
                        <Border
                            Margin="0,0,8,0"
                            Background="{DynamicResource RowBg}"
                            Style="{StaticResource IconStatusPillStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="13"
                                    Height="13"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Foreground="{Binding Foreground, ElementName=TxtCount}"
                                    Kind="ClipboardTextOutline" />
                                <TextBlock
                                    x:Name="TxtCount" VerticalAlignment="Center"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                        </Border>
                        <Border
                            x:Name="PillState"
                            Margin="0,0,10,0"
                            Style="{StaticResource IconStatusPillStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    x:Name="IconState"
                                    Width="13"
                                    Height="13"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Kind="RecordCircleOutline" />
                                <TextBlock
                                    x:Name="TxtState" VerticalAlignment="Center"
                                    FontSize="11"
                                    FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Button ctl:Tour.Key="Str_Tour_Clipboard_Pause" ctl:Tour.Order="2"
                            x:Name="BtnPause"
                            Margin="0,0,4,0"
                            Click="BtnPause_Click"
                            Style="{StaticResource ListToolButtonStyle}">
                            <materialDesign:PackIcon
                                x:Name="IconPause"
                                Width="16"
                                Height="16"
                                Kind="PauseCircleOutline" />
                        </Button>
                        <Button
                            Click="BtnClear_Click"
                            Style="{StaticResource ListToolDangerButtonStyle}"
                            ToolTip="{DynamicResource Str_Clipboard_Clear}">
                            <materialDesign:PackIcon
                                Width="16"
                                Height="16"
                                Kind="DeleteSweepOutline" />
                        </Button>
                    </StackPanel>

                    <TextBlock
                        x:Name="TxtStatus"
                        Grid.Row="1"
                        Grid.ColumnSpan="2"
                        Margin="2,8,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondary}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                </Grid>
            </Border>

            <!--  History  -->
            <Border ctl:Tour.Key="Str_Tour_Clipboard_History" ctl:Tour.Order="3" Grid.Row="1" Style="{StaticResource CardStyle}">
                <Grid>
                    <ListBox
                        x:Name="ListItems"
                        ItemContainerStyle="{StaticResource StretchRowStyle}"
                        BorderThickness="0"
                        MouseDoubleClick="ListItems_MouseDoubleClick"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        ToolTip="{DynamicResource Str_Clipboard_DoubleClickTip}">
                        <ListBox.GroupStyle>
                            <GroupStyle>
                                <GroupStyle.HeaderTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,12,4,4">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource TextSecondary}"
                                                Text="{Binding Name}" />
                                            <Border
                                                Grid.Column="1"
                                                Height="1"
                                                Margin="10,1,0,0"
                                                VerticalAlignment="Center"
                                                Background="{DynamicResource CardBorder}" />
                                        </Grid>
                                    </DataTemplate>
                                </GroupStyle.HeaderTemplate>
                            </GroupStyle>
                        </ListBox.GroupStyle>
                    </ListBox>

                    <StackPanel
                        x:Name="PanelEmpty"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False">
                        <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.ClipboardTextOutline}" />
                        <TextBlock
                            x:Name="TxtEmptyTitle"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Center"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock
                            x:Name="TxtEmptyHint"
                            MaxWidth="420"
                            Margin="0,4,0,0"
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource TextSecondary}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
