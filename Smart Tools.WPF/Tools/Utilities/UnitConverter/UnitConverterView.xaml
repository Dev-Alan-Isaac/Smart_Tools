<UserControl
    x:Class="Smart_Tools.WPF.Views.UnitConverterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    x:Name="Root"
    d:DesignHeight="700"
    d:DesignWidth="1100"
    mc:Ignorable="d"
    Loaded="View_Loaded">

    <!--
        Unit & currency converter - type a number, pick two units, read the answer; every other unit of the
        category is listed underneath. Currency rates come from the Frankfurter service (ECB data) and are kept
        for offline use. Backend: Controllers/UnitConverterManager.cs; Models/UnitConverterModel.cs. UI only here.
    -->

    <UserControl.Resources>
        <!--  One favorite or recent pair: a chip that selects the category and both units  -->
        <DataTemplate x:Key="PairChipTemplate">
            <Button
                Click="Pair_Click"
                Content="{Binding Label}"
                Margin="0,0,6,6"
                Style="{StaticResource PillChipStyle}"
                Tag="{Binding Pair}"
                ToolTip="{Binding Tip}" />
        </DataTemplate>

        <DataTemplate x:Key="UnitItemTemplate">
            <StackPanel Orientation="Horizontal">
                <TextBlock
                    MinWidth="46"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimary}"
                    Text="{Binding Symbol}" />
                <TextBlock
                    Margin="6,0,0,0"
                    Foreground="{DynamicResource TextSecondary}"
                    Text="{Binding Name}" />
            </StackPanel>
        </DataTemplate>

        <!--  One category tab: icon + name, accent underline and text when selected  -->
        <Style x:Key="ConvTabStyle" TargetType="RadioButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border
                            x:Name="Bd"
                            Margin="0,0,2,0"
                            Padding="12,8,12,7"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="0,0,0,3"
                            CornerRadius="8,8,0,0">
                            <ContentPresenter
                                x:Name="Cp"
                                VerticalAlignment="Center"
                                TextElement.Foreground="{TemplateBinding Foreground}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowBg}" />
                                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{DynamicResource TextPrimary}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentColorSubtle}" />
                                <Setter TargetName="Cp" Property="TextElement.Foreground" Value="{DynamicResource AccentColor}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  One unit tile in "In every unit": click it to convert to that unit; the current target is outlined  -->
        <Style x:Key="UnitTileButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Margin="0,0,8,8"
                            Padding="14,10"
                            Background="{DynamicResource RowBg}"
                            BorderBrush="{DynamicResource CardBorder}"
                            BorderThickness="1.5"
                            CornerRadius="10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsTarget}" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentColorSubtle}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="UnitTileTemplate">
            <Button
                Click="Tile_Click"
                Style="{StaticResource UnitTileButtonStyle}"
                Tag="{Binding}"
                ToolTip="{DynamicResource Str_Conv_AllUnitsTip}">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <TextBlock
                            FontSize="12"
                            FontWeight="Bold"
                            Foreground="{DynamicResource AccentColor}"
                            Text="{Binding Symbol}" />
                        <TextBlock
                            Margin="8,0,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource TextSecondary}"
                            Text="{Binding Name}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <TextBlock
                        Margin="0,6,0,0"
                        FontFamily="Cascadia Mono, Consolas"
                        FontSize="19"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        Text="{Binding Value}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding Value}" />
                </StackPanel>
            </Button>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">

        <!--  No page header: MainWindow's header card shows the tool's icon and name.  -->

        <Grid Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OptionsColumn" Width="280" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= OPTIONS SIDEBAR =================  -->
            <Border Grid.Column="0" Style="{StaticResource SidebarPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Button
                            x:Name="BtnCollapseOptions"
                            MinHeight="45"
                            HorizontalContentAlignment="Left"
                            Click="BtnCollapseOptions_Click"
                            Cursor="Hand"
                            FocusVisualStyle="{StaticResource FocusRingVisual}"
                            Foreground="{DynamicResource SidebarText}"
                            ToolTip="{DynamicResource Str_Common_SidebarToggleTooltip}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="OverridesDefaultStyle" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Margin="16,0,0,0" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Kind="TuneVariant" />
                                <TextBlock
                                    x:Name="TxtOptionsHeaderLabel"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{DynamicResource Str_Common_OptionsLabel}" />
                            </StackPanel>
                        </Button>
                        <Separator
                            x:Name="SepHeader"
                            Margin="16,4"
                            Style="{StaticResource SidebarSeparatorStyle}" />
                    </StackPanel>

                    <ScrollViewer
                        x:Name="OptionsScrollViewer"
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16,4,16,16">

                            <!--  ============ FAVORITES ============  -->
                            <Border ctl:Tour.Key="Str_Tour_UnitConverter_Favorites" ctl:Tour.Order="2" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Conv_FavoritesHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.StarOutline}" />
                                    <TextBlock
                                        x:Name="TxtNoFavorites"
                                        Style="{StaticResource SidebarHint}"
                                        Text="{DynamicResource Str_Conv_NoFavorites}" />
                                    <ItemsControl x:Name="ListFavorites" ItemTemplate="{StaticResource PairChipTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>

                            <!--  ============ RECENT ============  -->
                            <Border
                                x:Name="CardRecent"
                                Style="{StaticResource SidebarGroupCardStyle}"
                                Visibility="Collapsed">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Conv_RecentHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.History}" />
                                    <ItemsControl x:Name="ListRecent" ItemTemplate="{StaticResource PairChipTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="2" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <Button
                                        Margin="0,6,0,0"
                                        HorizontalAlignment="Left"
                                        Click="BtnClearRecent_Click"
                                        Style="{StaticResource PresetChipStyle}"
                                        ToolTip="{DynamicResource Str_Conv_ClearRecentTip}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon
                                                Width="13"
                                                Height="13"
                                                Margin="0,0,5,0"
                                                VerticalAlignment="Center"
                                                Kind="DeleteSweepOutline" />
                                            <TextBlock Text="{DynamicResource Str_Conv_ClearRecent}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!--  ============ EXCHANGE RATES (currency only) ============  -->
                            <Border
                                x:Name="CurrencyStatus"
                                Style="{StaticResource SidebarGroupCardStyle}"
                                Visibility="Collapsed">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Conv_RatesHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.Web}" />
                                    <StackPanel>
                                        <Border
                                            x:Name="PillRates"
                                            HorizontalAlignment="Left"
                                            Style="{StaticResource IconStatusPillStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    x:Name="IconRates"
                                                    Width="13"
                                                    Height="13"
                                                    Margin="0,0,5,0"
                                                    VerticalAlignment="Center"
                                                    Kind="Web" />
                                                <TextBlock
                                                    x:Name="TxtRates"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </Border>
                                        <Button
                                            x:Name="BtnRefreshRates"
                                            Margin="0,10,0,0"
                                            Click="BtnRefreshRates_Click"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            ToolTip="{DynamicResource Str_Conv_RefreshRates}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Kind="Refresh" />
                                                <TextBlock Text="{DynamicResource Str_Conv_UpdateNow}" />
                                            </StackPanel>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource SidebarHint}" Text="{DynamicResource Str_Conv_RatesTip}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--  ================= CONTENT =================  -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Category tabs  -->
                <Border
                    Grid.Row="0"
                    Margin="0,0,0,12"
                    Padding="6,6,6,0"
                    ctl:Tour.Key="Str_Tour_UnitConverter_Category"
                    ctl:Tour.Order="1"
                    Style="{StaticResource CardStyle}">
                    <WrapPanel x:Name="PanelCategories" />
                </Border>

                <!--  Convert: the amount on the left, the answer on the accent panel on the right  -->
                <Border
                    Grid.Row="1"
                    Margin="0,0,0,12"
                    Padding="22"
                    ctl:Tour.Key="Str_Tour_UnitConverter_Convert"
                    ctl:Tour.Order="3"
                    Style="{StaticResource ElevatedCardStyle}">
                    <Grid>
                        <StackPanel x:Name="PanelConvert">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!--  From  -->
                                <Border
                                    Padding="18,14"
                                    Background="{DynamicResource RowBg}"
                                    BorderBrush="{DynamicResource CardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Str_Conv_From}" />
                                        <TextBox
                                            x:Name="TxtValue"
                                            Margin="0,4,0,0"
                                            FontFamily="Cascadia Mono, Consolas"
                                            FontSize="34"
                                            FontWeight="Bold"
                                            Style="{StaticResource BareTextBox}"
                                            Tag="0"
                                            Text="1"
                                            PreviewKeyDown="TxtValue_PreviewKeyDown"
                                            TextChanged="TxtValue_TextChanged"
                                            ToolTip="{DynamicResource Str_Conv_AmountTip}" />
                                        <Border
                                            Height="1"
                                            Margin="0,6,0,8"
                                            Background="{DynamicResource CardBorder}" />
                                        <ComboBox
                                            x:Name="CmbFrom"
                                            ItemTemplate="{StaticResource UnitItemTemplate}"
                                            SelectionChanged="Unit_SelectionChanged"
                                            Style="{StaticResource BareComboBox}" />
                                        <WrapPanel Margin="0,12,0,0">
                                            <Button
                                                Margin="0,0,6,0"
                                                Click="Preset_Click"
                                                Content="1"
                                                Style="{StaticResource PillChipStyle}"
                                                Tag="1" />
                                            <Button
                                                Margin="0,0,6,0"
                                                Click="Preset_Click"
                                                Content="10"
                                                Style="{StaticResource PillChipStyle}"
                                                Tag="10" />
                                            <Button
                                                Margin="0,0,6,0"
                                                Click="Preset_Click"
                                                Content="100"
                                                Style="{StaticResource PillChipStyle}"
                                                Tag="100" />
                                            <Button
                                                Margin="0,0,6,0"
                                                Click="Preset_Click"
                                                Content="1000"
                                                Style="{StaticResource PillChipStyle}"
                                                Tag="1000" />
                                        </WrapPanel>
                                    </StackPanel>
                                </Border>

                                <Button Padding="0"
                                    Grid.Column="1"
                                    Width="44"
                                    Height="44"
                                    Margin="-6,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Panel.ZIndex="1"
                                    Click="BtnSwap_Click"
                                    Style="{StaticResource ListToolButtonStyle}"
                                    ToolTip="{DynamicResource Str_Conv_Swap}">
                                    <materialDesign:PackIcon
                                        Width="22"
                                        Height="22"
                                        Kind="SwapHorizontal" />
                                </Button>

                                <!--  To  -->
                                <Border
                                    Grid.Column="2"
                                    Padding="18,14"
                                    Background="{DynamicResource AccentColorSubtle}"
                                    BorderBrush="{DynamicResource AccentColor}"
                                    BorderThickness="1.5"
                                    CornerRadius="12">
                                    <StackPanel>
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Str_Conv_To}" />
                                        <TextBox
                                            x:Name="TxtResult"
                                            Margin="0,4,0,0"
                                            FontFamily="Cascadia Mono, Consolas"
                                            FontSize="34"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource AccentColor}"
                                            IsReadOnly="True"
                                            Style="{StaticResource BareTextBox}" />
                                        <Border
                                            Height="1"
                                            Margin="0,6,0,8"
                                            Background="{DynamicResource AccentColor}"
                                            Opacity="0.35" />
                                        <ComboBox
                                            x:Name="CmbTo"
                                            ItemTemplate="{StaticResource UnitItemTemplate}"
                                            SelectionChanged="Unit_SelectionChanged"
                                            Style="{StaticResource BareComboBox}" />
                                        <StackPanel Margin="0,12,0,0" Orientation="Horizontal">
                                            <Button
                                                x:Name="BtnCopy"
                                                Click="BtnCopy_Click"
                                                Style="{StaticResource PillChipStyle}"
                                                ToolTip="{DynamicResource Str_Conv_CopyResult}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon
                                                        x:Name="IconCopy"
                                                        Width="14"
                                                        Height="14"
                                                        Margin="0,0,5,0"
                                                        VerticalAlignment="Center"
                                                        Kind="ContentCopy" />
                                                    <TextBlock Text="{DynamicResource Str_Conv_CopyResult}" />
                                                </StackPanel>
                                            </Button>
                                            <Button
                                                x:Name="BtnFavorite"
                                                Margin="6,0,0,0"
                                                Click="BtnFavorite_Click"
                                                Style="{StaticResource PillChipStyle}"
                                                ToolTip="{DynamicResource Str_Conv_AddFavorite}">
                                                <materialDesign:PackIcon
                                                    x:Name="IconFavorite"
                                                    Width="14"
                                                    Height="14"
                                                    VerticalAlignment="Center"
                                                    Kind="StarOutline" />
                                            </Button>
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!--  The rate, as a sentence  -->
                            <StackPanel Margin="2,14,0,0" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    Margin="0,1,6,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Kind="FunctionVariant" />
                                <TextBlock
                                    x:Name="TxtFormula"
                                    VerticalAlignment="Center"
                                    FontFamily="Cascadia Mono, Consolas"
                                    FontSize="13"
                                    Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                            <TextBlock
                                x:Name="TxtProblem"
                                Margin="2,4,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource StatusErrorFg}"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                        </StackPanel>

                        <!--  Currency with no rates yet and no internet  -->
                        <StackPanel
                            x:Name="PanelNoRates"
                            MaxWidth="460"
                            Margin="0,8"
                            HorizontalAlignment="Center"
                            Visibility="Collapsed">
                            <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.WebOff}" />
                            <TextBlock
                                x:Name="TxtNoRatesTitle"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Center"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextPrimary}"
                                Text="{DynamicResource Str_Conv_NoRatesTitle}" />
                            <TextBlock
                                x:Name="TxtNoRatesHint"
                                Margin="0,4,0,10"
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource TextSecondary}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                            <Button
                                x:Name="BtnTryAgain"
                                HorizontalAlignment="Center"
                                Click="BtnRefreshRates_Click"
                                Style="{StaticResource PrimaryButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Kind="Refresh" />
                                    <TextBlock Text="{DynamicResource Str_Conv_TryAgain}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  Every unit at once: one tile per unit, the one you convert to is outlined  -->
                <Border
                    Grid.Row="2"
                    ctl:Tour.Key="Str_Tour_UnitConverter_Table"
                    ctl:Tour.Order="4"
                    Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ContentControl
                            Content="{DynamicResource Str_Conv_AllUnits}"
                            Style="{StaticResource CardHeader}"
                            Tag="{x:Static materialDesign:PackIconKind.ViewGridOutline}" />
                        <ScrollViewer
                            x:Name="TileScroller"
                            Grid.Row="1"
                            Margin="0,8,-8,0"
                            HorizontalScrollBarVisibility="Disabled"
                            SizeChanged="TileScroller_SizeChanged"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="TileList" ItemTemplate="{StaticResource UnitTileTemplate}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <UniformGrid Columns="3" Loaded="TilePanel_Loaded" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </ScrollViewer>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
