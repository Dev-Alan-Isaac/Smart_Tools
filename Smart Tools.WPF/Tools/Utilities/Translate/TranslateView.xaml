<UserControl
    x:Class="Smart_Tools.WPF.Views.TranslateView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:models="clr-namespace:Smart_Tools.WPF.Models">

    <!--
        Backend: Controllers/TranslateManager.cs (catalog, model download),
        TranslateManager.Engine.cs (tokenizer, ONNX encoder/decoder) and
        TranslateManager.Files.cs (Files mode); Models/TranslateModel.cs.
        This file and the code-behind are UI only.
    -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!--  One file in the sidebar card (same look as the other file lists)  -->
        <DataTemplate x:Key="FileRowTemplate" DataType="{x:Type models:TranslateFileItem}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="26"
                    Height="26"
                    Margin="0,0,8,0"
                    Background="{DynamicResource AccentColorSubtle}"
                    CornerRadius="7">
                    <materialDesign:PackIcon
                        Width="14"
                        Height="14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource AccentColor}"
                        Kind="FileDocumentOutline" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource SidebarText}"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding ToolTipText}" />
                    <TextBlock
                        Margin="0,1,0,0"
                        FontSize="10.5"
                        Foreground="{DynamicResource SidebarTextMuted}"
                        Text="{Binding SizeText}" />
                </StackPanel>
                <Button
                    Grid.Column="2"
                    Width="24"
                    Height="24"
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    Click="BtnRemoveFile_Click"
                    Style="{StaticResource IconButtonStyle}"
                    Tag="{Binding}"
                    ToolTip="{DynamicResource Str_LoudnessMeter_TakeThisOffThe}">
                    <materialDesign:PackIcon
                        Width="13"
                        Height="13"
                        Kind="Close" />
                </Button>
            </Grid>
        </DataTemplate>

        <!--  One file in the results list of the main area: name, status, its own progress, show-in-folder  -->
        <DataTemplate x:Key="ResultRowTemplate" DataType="{x:Type models:TranslateFileItem}">
            <Border
                Margin="0,0,0,8"
                Padding="12,10"
                Background="{DynamicResource ContentBg}"
                CornerRadius="10">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimary}"
                            Text="{Binding Name}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding ToolTipText}" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="11.5"
                            Foreground="{DynamicResource TextSecondary}"
                            Text="{Binding Status}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding Status}" />
                        <ProgressBar
                            Height="5"
                            Margin="0,8,0,0"
                            Maximum="100"
                            Value="{Binding Percent}"
                            Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                    </StackPanel>
                    <TextBlock
                        Grid.Column="1"
                        MinWidth="44"
                        Margin="12,0,0,0"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="Bold"
                        Foreground="{DynamicResource AccentColor}"
                        Text="{Binding Percent, StringFormat={}{0:0}%}"
                        TextAlignment="Right"
                        Visibility="{Binding IsRunning, Converter={StaticResource BoolToVis}}" />
                    <Button
                        Grid.Column="2"
                        Width="40"
                        Margin="8,0,0,0"
                        VerticalAlignment="Center"
                        Click="BtnShowFile_Click"
                        Style="{StaticResource NeutralIconButtonStyle}"
                        Tag="{Binding}"
                        ToolTip="{DynamicResource Str_Translate_ShowInFolder}"
                        Visibility="{Binding IsDone, Converter={StaticResource BoolToVis}}">
                        <materialDesign:PackIcon
                            Width="18"
                            Height="18"
                            Kind="FolderOpenOutline" />
                    </Button>
                </Grid>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">

        <!--  No page header: MainWindow's header card shows the tool's icon and name.  -->

        <Grid Margin="16,8,16,16">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="280" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= OPTIONS SIDEBAR =================  -->

            <Border Grid.Column="0" Style="{StaticResource SidebarPanelStyle}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,16,16,16">

                        <!--  ============ WHAT TO TRANSLATE ============  -->
                        <Border Style="{StaticResource SidebarGroupCardStyle}">
                            <StackPanel>
                                <ContentControl
                                    Content="{DynamicResource Str_Translate_ModeHeader}"
                                    Style="{StaticResource SidebarGroupHeader}"
                                    Tag="{x:Static materialDesign:PackIconKind.TranslateVariant}" />
                                <UniformGrid Columns="2">
                                    <RadioButton
                                        x:Name="RadioModeText"
                                        Margin="0,0,2,0"
                                        Click="RadioMode_Click"
                                        Content="{DynamicResource Str_Translate_ModeText}"
                                        GroupName="TranslateMode"
                                        IsChecked="True"
                                        Style="{StaticResource ModeToggleButtonStyle}" />
                                    <RadioButton
                                        x:Name="RadioModeFiles"
                                        Margin="2,0,0,0"
                                        Click="RadioMode_Click"
                                        Content="{DynamicResource Str_Translate_ModeFiles}"
                                        GroupName="TranslateMode"
                                        Style="{StaticResource ModeToggleButtonStyle}" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <!--  Files mode: the files to translate (the results show in the main area)  -->
                        <controls:InputFolderCard
                            x:Name="InputCard"
                            ClearRequested="InputCard_ClearRequested"
                            Header="{DynamicResource Str_Translate_FilesHeader}"
                            HeaderIcon="FileDocumentMultipleOutline"
                            ItemTemplate="{StaticResource FileRowTemplate}"
                            Mode="Files"
                            PathsAdded="InputCard_PathsAdded"
                            Visibility="Collapsed" />

                        <!--  ============ OFFLINE MODEL ============  -->
                        <Border ctl:Tour.Key="Str_Tour_Translate_Model" ctl:Tour.Order="2" Style="{StaticResource SidebarGroupCardStyle}">
                            <StackPanel>
                                <ContentControl
                                    Content="{DynamicResource Str_Translate_ModelHeader}"
                                    Style="{StaticResource SidebarGroupHeader}"
                                    Tag="{x:Static materialDesign:PackIconKind.DownloadCircleOutline}" />

                                <TextBlock
                                    x:Name="TxtModelStatus"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextSecondary}"
                                    TextWrapping="Wrap" />

                                <Grid Margin="0,8,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        x:Name="TxtModelPath"
                                        VerticalAlignment="Center"
                                        FontFamily="Consolas"
                                        FontSize="11"
                                        Foreground="{DynamicResource TextSecondary}"
                                        TextTrimming="CharacterEllipsis"
                                        ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                                    <Button
                                        x:Name="BtnOpenFolder"
                                        Grid.Column="1"
                                        Width="40"
                                        Margin="6,0,0,0"
                                        Click="BtnOpenFolder_Click"
                                        Style="{StaticResource NeutralIconButtonStyle}"
                                        ToolTip="{DynamicResource Str_Translate_OpenFolder}">
                                        <materialDesign:PackIcon
                                            Width="18"
                                            Height="18"
                                            Kind="FolderOpenOutline" />
                                    </Button>
                                </Grid>

                                <ProgressBar
                                    x:Name="ProgressDownload"
                                    Height="8"
                                    Margin="0,8,0,0"
                                    Maximum="100"
                                    Visibility="Collapsed" />

                                <Button
                                    x:Name="BtnDownload"
                                    Margin="0,10,0,0"
                                    Click="BtnDownload_Click"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    ToolTip="{DynamicResource Str_Translate_DownloadTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            x:Name="IconDownload"
                                            Width="18"
                                            Height="18"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Kind="Download" />
                                        <TextBlock
                                            x:Name="TxtDownloadLabel"
                                            VerticalAlignment="Center"
                                            Text="{DynamicResource Str_Translate_Download}" />
                                    </StackPanel>
                                </Button>

                                <Button
                                    x:Name="BtnRemove"
                                    Margin="0,10,0,0"
                                    Click="BtnRemove_Click"
                                    Style="{StaticResource DangerButtonStyle}"
                                    ToolTip="{DynamicResource Str_Translate_RemoveTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="18"
                                            Height="18"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Kind="DeleteOutline" />
                                        <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_Translate_Remove}" />
                                    </StackPanel>
                                </Button>

                            <Button
                                x:Name="BtnManage"
                                Margin="0,10,0,0"
                                HorizontalAlignment="Stretch"
                                Click="BtnManage_Click"
                                Style="{StaticResource NeutralIconButtonStyle}"
                                ToolTip="{DynamicResource Str_Translate_ManageTooltip}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="18"
                                        Height="18"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Kind="CogOutline" />
                                    <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_Translate_Manage}" />
                                </StackPanel>
                            </Button>

                            </StackPanel>
                        </Border>


                        <TextBlock
                            Margin="4,0,4,0"
                            FontSize="11.5"
                            Foreground="{DynamicResource TextSecondary}"
                            Text="{DynamicResource Str_Translate_Credit}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!--  ================= MAIN =================  -->

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Header (title + languages) and the run bar in one card  -->
                <Border
                    Grid.Row="0"
                    Margin="0,0,0,12"
                    Style="{StaticResource CardStyle}">
                    <StackPanel>
                    <Grid ctl:Tour.Key="Str_Tour_Translate_Languages" ctl:Tour.Order="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentControl
                            Content="{DynamicResource Str_Translate_Languages}"
                            Style="{StaticResource CardHeader}"
                            Tag="{x:Static materialDesign:PackIconKind.Translate}" />
                        <!--  Filled in code from TranslateManager.Pairs  -->
                        <ComboBox
                            x:Name="CmbFrom"
                            Grid.Column="1"
                            Width="170"
                            VerticalAlignment="Center"
                            SelectionChanged="Language_SelectionChanged"
                            ToolTip="{DynamicResource Str_Translate_From}" />
                        <Button
                            x:Name="BtnSwap"
                            Grid.Column="2"
                            Width="40"
                            Margin="6,0"
                            VerticalAlignment="Center"
                            Click="BtnSwap_Click"
                            Style="{StaticResource NeutralIconButtonStyle}"
                            ToolTip="{DynamicResource Str_Translate_SwapTooltip}">
                            <materialDesign:PackIcon
                                Width="18"
                                Height="18"
                                Kind="SwapHorizontal" />
                        </Button>
                        <ComboBox
                            x:Name="CmbTo"
                            Grid.Column="3"
                            Width="170"
                            VerticalAlignment="Center"
                            SelectionChanged="Language_SelectionChanged"
                            ToolTip="{DynamicResource Str_Translate_To}" />
                    </Grid>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button ctl:Tour.Key="Str_Tour_Translate_Run" ctl:Tour.Order="3"
                            x:Name="BtnRun"
                            MinWidth="170"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            Click="BtnRun_Click"
                            Style="{StaticResource AccentPrimaryButtonStyle}"
                            ToolTip="{DynamicResource Str_Translate_RunTooltip}">
                            <Grid HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon
                                    x:Name="IconRun"
                                    Width="18"
                                    Height="18"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Kind="Translate" />
                                <TextBlock
                                    x:Name="TxtRunLabel"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="{DynamicResource Str_Translate_Run}" />
                            </Grid>
                        </Button>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <ProgressBar
                                x:Name="ProgressTranslate"
                                Height="8"
                                Margin="0,0,0,6"
                                Maximum="100"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="TxtStatus"
                                FontSize="11.5"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="{DynamicResource Str_Translate_StatusIdle}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </StackPanel>

                        <TextBlock
                            x:Name="TxtPercent"
                            Grid.Column="2"
                            MinWidth="54"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="{DynamicResource AccentColor}"
                            TextAlignment="Right"
                            Visibility="Collapsed" />
                    </Grid>
                    </StackPanel>
                </Border>

                <!--  Files mode: what happens to each file  -->
                <Border
                    x:Name="FilesPanel"
                    Grid.Row="1"
                    Style="{StaticResource CardStyle}"
                    Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ContentControl
                            Margin="0,0,0,10"
                            Content="{DynamicResource Str_Translate_ResultsHeader}"
                            Style="{StaticResource CardHeader}"
                            Tag="{x:Static materialDesign:PackIconKind.FileDocumentCheckOutline}" />
                        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="ResultsList" ItemTemplate="{StaticResource ResultRowTemplate}" />
                        </ScrollViewer>
                        <StackPanel
                            x:Name="FilesEmptyHint"
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <materialDesign:PackIcon
                                Width="44"
                                Height="44"
                                HorizontalAlignment="Center"
                                Foreground="{DynamicResource TextSecondary}"
                                Kind="FileDocumentMultipleOutline" />
                            <TextBlock
                                Margin="0,10,0,0"
                                MaxWidth="420"
                                FontSize="13"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="{DynamicResource Str_Translate_FilesHint}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  Text panes  -->
                <Grid x:Name="TextPanes" Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,10">
                                <ContentControl
                                    VerticalAlignment="Center"
                                    Content="{DynamicResource Str_Translate_InputHeader}"
                                    Style="{StaticResource CardHeader}"
                                    Tag="{x:Static materialDesign:PackIconKind.TextBoxOutline}" />
                                <Button
                                    x:Name="BtnClear"
                                    Width="40"
                                    HorizontalAlignment="Right"
                                    Click="BtnClear_Click"
                                    Style="{StaticResource NeutralIconButtonStyle}"
                                    ToolTip="{DynamicResource Str_Translate_Clear}">
                                    <materialDesign:PackIcon
                                        Width="18"
                                        Height="18"
                                        Kind="Close" />
                                </Button>
                            </Grid>
                            <TextBox
                                x:Name="TxtInput"
                                Grid.Row="1"
                                Height="Auto"
                                Padding="10"
                                VerticalAlignment="Stretch"
                                VerticalContentAlignment="Top"
                                AcceptsReturn="True"
                                FontSize="14"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto" />
                        </Grid>
                    </Border>

                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,10">
                                <ContentControl
                                    VerticalAlignment="Center"
                                    Content="{DynamicResource Str_Translate_OutputHeader}"
                                    Style="{StaticResource CardHeader}"
                                    Tag="{x:Static materialDesign:PackIconKind.TranslateVariant}" />
                                <Button ctl:Tour.Key="Str_Tour_Translate_Copy" ctl:Tour.Order="4"
                                    x:Name="BtnCopy"
                                    Width="40"
                                    HorizontalAlignment="Right"
                                    Click="BtnCopy_Click"
                                    Style="{StaticResource NeutralIconButtonStyle}"
                                    ToolTip="{DynamicResource Str_Common_Copy}">
                                    <materialDesign:PackIcon
                                        Width="18"
                                        Height="18"
                                        Kind="ContentCopy" />
                                </Button>
                            </Grid>
                            <TextBox
                                x:Name="TxtOutput"
                                Grid.Row="1"
                                Height="Auto"
                                Padding="10"
                                VerticalAlignment="Stretch"
                                VerticalContentAlignment="Top"
                                AcceptsReturn="True"
                                FontSize="14"
                                IsReadOnly="True"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto" />
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
