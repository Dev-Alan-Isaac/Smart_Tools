<UserControl
    x:Class="Smart_Tools.WPF.Views.ScreenOcrView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    x:Name="Root"
    AllowDrop="True"
    FocusVisualStyle="{x:Null}"
    Focusable="True"
    Loaded="Root_Loaded"
    PreviewDragLeave="Root_PreviewDragLeave"
    PreviewDragOver="Root_PreviewDragOver"
    PreviewDrop="Root_PreviewDrop"
    PreviewKeyDown="Root_PreviewKeyDown">

    <!--
        OCR Text Extractor (Screen to Text).
        Backend: Controllers/ScreenOcrManager.cs (pure: crop, read scale, text
        layout, settings) and ScreenOcrManager.Windows.cs (screen capture and
        the Windows OCR engine - built into Windows, offline, no download);
        Models/ScreenOcrModel.cs. The drag-to-select overlay is
        Views/ScreenOcrSelectionWindow.cs. This file and the code-behind are UI only.
    -->

    <UserControl.Resources>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">

        <!--  No page header: MainWindow's header card shows the tool's icon and name.  -->

        <Grid Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OptionsColumn" Width="280" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= SIDEBAR =================  -->

            <Border Grid.Column="0" Style="{StaticResource SidebarPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Button
                            x:Name="BtnCollapseOptions"
                            MinHeight="45"
                            HorizontalContentAlignment="Left"
                            Click="BtnCollapseOptions_Click"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Foreground="{DynamicResource SidebarText}"
                            ToolTip="{DynamicResource Str_Common_SidebarToggleTooltip}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="OverridesDefaultStyle" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel
                                x:Name="CollapseHeaderStack"
                                Margin="16,0,0,0"
                                Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Kind="TuneVariant" />
                                <TextBlock
                                    x:Name="TxtOptionsHeaderLabel"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{DynamicResource Str_Common_OptionsLabel}" />
                            </StackPanel>
                        </Button>
                        <Separator
                            x:Name="SepHeader"
                            Margin="16,4"
                            Style="{StaticResource SidebarSeparatorStyle}" />
                    </StackPanel>

                    <ScrollViewer
                        x:Name="OptionsScrollViewer"
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16,4,16,16">

                            <!--  ============ CAPTURE ============  -->
                            <Border ctl:Tour.Key="Str_Tour_ScreenOcr_Capture" ctl:Tour.Order="1" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Ocr_Capture}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.SelectionDrag}" />
                                    <Button
                                        x:Name="BtnCapture"
                                        MinHeight="40"
                                        HorizontalAlignment="Stretch"
                                        Click="BtnCapture_Click"
                                        Style="{StaticResource AccentPrimaryButtonStyle}"
                                        ToolTip="{DynamicResource Str_Ocr_SelectAreaTip}">
                                        <Grid HorizontalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon
                                                Grid.Column="0"
                                                Width="18"
                                                Height="18"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Kind="SelectionDrag" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_Ocr_SelectArea}" TextWrapping="Wrap" />
                                        </Grid>
                                    </Button>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            x:Name="BtnOpenImage"
                                            MinHeight="36"
                                            Click="BtnOpenImage_Click"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            ToolTip="{DynamicResource Str_Ocr_OpenImageTip}">
                                            <Grid HorizontalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon
                                                    Grid.Column="0"
                                                    Width="15"
                                                    Height="15"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Kind="ImageOutline" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_Ocr_OpenImage}" TextWrapping="Wrap" />
                                            </Grid>
                                        </Button>
                                        <Button
                                            x:Name="BtnPasteImage"
                                            Grid.Column="2"
                                            MinHeight="36"
                                            Click="BtnPasteImage_Click"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            ToolTip="{DynamicResource Str_Ocr_PasteTip}">
                                            <Grid HorizontalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon
                                                    Grid.Column="0"
                                                    Width="15"
                                                    Height="15"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Kind="ContentPaste" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_Ocr_Paste}" TextWrapping="Wrap" />
                                            </Grid>
                                        </Button>
                                    </Grid>
                                    <CheckBox
                                        x:Name="ChkHideWhileCapturing"
                                        Margin="0,12,0,0"
                                        Checked="Option_Changed"
                                        Content="{DynamicResource Str_Ocr_HideWhileSelecting}"
                                        Foreground="{DynamicResource SidebarText}"
                                        ToolTip="{DynamicResource Str_Ocr_HideWhileSelectingTip}"
                                        Unchecked="Option_Changed"
                                        controls:ChoiceIcon.Kind="EyeOffOutline"
                                        Style="{StaticResource ToggleChipCheckBoxStyle}" />
                                    <TextBlock Style="{StaticResource SidebarHint}" Text="{DynamicResource Str_Ocr_FreezeHint}" />
                                </StackPanel>
                            </Border>

                            <!--  ============ READING ============  -->
                            <Border ctl:Tour.Key="Str_Tour_ScreenOcr_Reading" ctl:Tour.Order="2" Margin="0,0,0,4" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Ocr_ReadingHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.Translate}" />

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Str_Ocr_LanguageLabel}" />
                                    <ComboBox
                                        x:Name="CmbLanguage"
                                        Margin="0,0,0,4"
                                        SelectionChanged="CmbLanguage_SelectionChanged"
                                        ToolTip="{DynamicResource Str_Ocr_LanguageTip}" />
                                    <TextBlock
                                        x:Name="TxtLanguageHint"
                                        Margin="0,2,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource SidebarTextMuted}"
                                        TextWrapping="Wrap" />
                                    <Button
                                        Margin="0,8,0,0"
                                        x:Name="BtnAddLanguage"
                                        Click="BtnAddLanguage_Click"
                                        Content="{DynamicResource Str_Ocr_AddLanguage}"
                                        Style="{StaticResource NeutralIconButtonStyle}"
                                        ToolTip="{DynamicResource Str_Ocr_AddLanguageTip}" />

                                    <CheckBox
                                        x:Name="ChkEnhance"
                                        Margin="0,12,0,0"
                                        Checked="ChkEnhance_Changed"
                                        Content="{DynamicResource Str_Ocr_Enhance}"
                                        Foreground="{DynamicResource SidebarText}"
                                        ToolTip="{DynamicResource Str_Ocr_EnhanceTip}"
                                        Unchecked="ChkEnhance_Changed"
                                        controls:ChoiceIcon.Kind="AutoFix"
                                        Style="{StaticResource ToggleChipCheckBoxStyle}" />

                                    <TextBlock
                                        Margin="0,12,0,6"
                                        Style="{StaticResource FieldLabel}"
                                        Text="{DynamicResource Str_Ocr_LineBreaks}" />
                                    <UniformGrid Columns="2">
                                        <RadioButton
                                            x:Name="RadioKeepLines"
                                            Margin="0,0,2,0"
                                            Click="Layout_Click"
                                            Content="{DynamicResource Str_Ocr_KeepLines}"
                                            GroupName="OcrLayout"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="KeepLines"
                                            ToolTip="{DynamicResource Str_Ocr_KeepLinesTip}" />
                                        <RadioButton
                                            x:Name="RadioJoinLines"
                                            Margin="2,0,0,0"
                                            Click="Layout_Click"
                                            Content="{DynamicResource Str_Ocr_JoinLines}"
                                            GroupName="OcrLayout"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="JoinLines"
                                            ToolTip="{DynamicResource Str_Ocr_JoinLinesTip}" />
                                    </UniformGrid>

                                    <CheckBox
                                        x:Name="ChkCopyWhenDone"
                                        Margin="0,12,0,0"
                                        Checked="Option_Changed"
                                        Content="{DynamicResource Str_Ocr_CopyWhenDone}"
                                        Foreground="{DynamicResource SidebarText}"
                                        ToolTip="{DynamicResource Str_Ocr_CopyWhenDoneTip}"
                                        Unchecked="Option_Changed"
                                        controls:ChoiceIcon.Kind="ContentCopy"
                                        Style="{StaticResource ToggleChipCheckBoxStyle}" />
                                    <TextBlock Style="{StaticResource SidebarHint}" Text="{DynamicResource Str_Ocr_OfflineHint}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--  ================= MAIN =================  -->

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Status bar: what happened last, counts  -->
                <Border Margin="0,0,0,14" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            x:Name="StatusChip"
                            Width="34"
                            Height="34"
                            Margin="0,0,12,0"
                            Background="{DynamicResource AccentColorSubtle}"
                            CornerRadius="10"
                            RenderTransformOrigin="0.5,0.5">
                            <materialDesign:PackIcon
                                x:Name="IconStatus"
                                Width="18"
                                Height="18"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource AccentColor}"
                                Kind="TextRecognition" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                x:Name="TxtStatus"
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextPrimary}"
                                Text="{DynamicResource Str_Ocr_ReadyTitle}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                x:Name="TxtStatusDetail"
                                Margin="0,2,0,0"
                                FontSize="11.5"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="{DynamicResource Str_Ocr_ReadyHint}"
                                TextTrimming="CharacterEllipsis" />
                            <ProgressBar
                                x:Name="ReadingBar"
                                Height="3"
                                Margin="0,6,0,0"
                                IsIndeterminate="True"
                                Visibility="Collapsed" />
                        </StackPanel>
                        <WrapPanel
                            Grid.Column="2"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">
                            <Border
                                x:Name="WordsPill"
                                Margin="0,0,6,0"
                                Background="{DynamicResource StatusInfoBg}"
                                Style="{StaticResource IconStatusPillStyle}"
                                Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="13"
                                        Height="13"
                                        Margin="0,0,5,0"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource StatusInfoFg}"
                                        Kind="FormatTextVariant" />
                                    <TextBlock
                                        x:Name="TxtWordsPill"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource StatusInfoFg}" />
                                </StackPanel>
                            </Border>
                            <Border
                                x:Name="LanguagePill"
                                Background="{DynamicResource RowBg}"
                                Style="{StaticResource IconStatusPillStyle}"
                                Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="13"
                                        Height="13"
                                        Margin="0,0,5,0"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Kind="Translate" />
                                    <TextBlock
                                        x:Name="TxtLanguagePill"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  ============ CAPTURED PICTURE ============  -->
                    <Border ctl:Tour.Key="Str_Tour_ScreenOcr_Picture" ctl:Tour.Order="3" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentControl
                                    Content="{DynamicResource Str_Ocr_CapturedHeader}"
                                    Style="{StaticResource CardHeader}"
                                    Tag="{x:Static materialDesign:PackIconKind.ImageSearchOutline}" />
                                <CheckBox
                                    x:Name="ChkShowWords"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Checked="ChkShowWords_Changed"
                                    Content="{DynamicResource Str_Ocr_ShowWords}"
                                    IsChecked="True"
                                    ToolTip="{DynamicResource Str_Ocr_ShowWordsTip}"
                                    Unchecked="ChkShowWords_Changed" />
                            </Grid>

                            <Border
                                x:Name="PreviewStage"
                                Grid.Row="1"
                                Padding="8"
                                Background="{DynamicResource RowBg}"
                                CornerRadius="8">
                                <Viewbox
                                    x:Name="PreviewBox"
                                    StretchDirection="Both"
                                    Visibility="Collapsed">
                                    <Grid x:Name="PreviewHost">
                                        <Image x:Name="PreviewImage" Stretch="Fill" />
                                        <Canvas x:Name="WordLayer" />
                                    </Grid>
                                </Viewbox>
                            </Border>

                            <!--  Empty state  -->
                            <StackPanel
                                x:Name="EmptyPanel"
                                Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.TextRecognition}" />
                                <TextBlock
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimary}"
                                    Text="{DynamicResource Str_Ocr_EmptyTitle}" />
                                <TextBlock
                                    MaxWidth="340"
                                    Margin="0,4,0,14"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{DynamicResource Str_Ocr_EmptyHint}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <!--  Drop highlight  -->
                            <Border
                                x:Name="DropHighlight"
                                Grid.RowSpan="2"
                                Margin="-6"
                                Background="{DynamicResource AccentColorSubtle}"
                                BorderBrush="{DynamicResource AccentColor}"
                                BorderThickness="2"
                                CornerRadius="12"
                                IsHitTestVisible="False"
                                Opacity="0.85"
                                Visibility="Collapsed">
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <materialDesign:PackIcon
                                        Width="36"
                                        Height="36"
                                        HorizontalAlignment="Center"
                                        Foreground="{DynamicResource AccentColor}"
                                        Kind="TrayArrowDown" />
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        FontSize="13"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimary}"
                                        Text="{DynamicResource Str_Ocr_DropTitle}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!--  ============ TEXT ============  -->
                    <Border ctl:Tour.Key="Str_Tour_ScreenOcr_Text" ctl:Tour.Order="4" Grid.Column="2" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <ContentControl
                                Margin="0,0,0,10"
                                Content="{DynamicResource Str_Ocr_TextHeader}"
                                Style="{StaticResource CardHeader}"
                                Tag="{x:Static materialDesign:PackIconKind.TextBoxOutline}" />

                            <TextBox
                                x:Name="TxtResult"
                                Grid.Row="1"
                                Height="Auto"
                                VerticalAlignment="Stretch"
                                VerticalContentAlignment="Top"
                                AcceptsReturn="True"
                                AcceptsTab="True"
                                FontSize="13"
                                HorizontalScrollBarVisibility="Disabled"
                                Tag="The text you capture shows up here. You can edit it before copying."
                                TextChanged="TxtResult_TextChanged"
                                TextWrapping="Wrap"
                                VerticalScrollBarVisibility="Auto" />

                            <Grid Grid.Row="2" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                    <Button Padding="0"
                                        x:Name="BtnClear"
                                        Width="34"
                                        Height="34"
                                        Click="BtnClear_Click"
                                        IsEnabled="False"
                                        Style="{StaticResource NeutralIconButtonStyle}"
                                        ToolTip="{DynamicResource Str_Ocr_ClearTip}">
                                        <materialDesign:PackIcon
                                            Width="16"
                                            Height="16"
                                            Kind="DeleteSweepOutline" />
                                    </Button>
                                    <Button
                                        x:Name="BtnSave"
                                        Margin="6,0,0,0"
                                        Click="BtnSave_Click"
                                        IsEnabled="False"
                                        ToolTip="{DynamicResource Str_Ocr_SaveTip}"
                                        Style="{StaticResource ListToolButtonStyle}">
                                        <materialDesign:PackIcon
                                            Width="16"
                                            Height="16"
                                            Kind="ContentSaveOutline" />
                                    </Button>
                                </StackPanel>
                                <Button
                                    x:Name="BtnCopy"
                                    Grid.Column="1"
                                    Click="BtnCopy_Click"
                                    IsEnabled="False"
                                    Style="{StaticResource ListToolButtonStyle}"
                                    ToolTip="{DynamicResource Str_Ocr_CopyTip}">
                                    <materialDesign:PackIcon
                                        x:Name="IconCopy"
                                        Width="16"
                                        Height="16"
                                        Kind="ContentCopy" />
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
