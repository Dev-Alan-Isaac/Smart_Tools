<UserControl
    x:Class="Smart_Tools.WPF.Views.TimerStopwatchView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    x:Name="Root"
    Focusable="True"
    Loaded="Root_Loaded"
    Unloaded="Root_Unloaded">

    <!--  Backend: Controllers/TimerStopwatchManager.cs (typed times, formatting, Pomodoro cycle). UI only here.  -->

    <UserControl.Resources>
        <!--  The big round Start / Pause button under the ring  -->
        <Style x:Key="RoundMainButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Background="{DynamicResource AccentFill}"
                            CornerRadius="40"
                            RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentColor}" />
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="1.05" ScaleY="1.05" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="RenderTransform">
                                    <Setter.Value>
                                        <ScaleTransform ScaleX="0.96" ScaleY="0.96" />
                                    </Setter.Value>
                                </Setter>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TsLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarText}" />
            <Setter Property="Margin" Value="2,10,0,4" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">
        <Grid Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= OPTIONS SIDEBAR =================  -->
            <controls:ToolSidebar>
                <StackPanel x:Name="SidebarStack">
                    <Border ctl:Tour.Key="Str_Tour_TimerStopwatch_Mode" ctl:Tour.Order="1" Margin="0,0,0,10" Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl Content="{DynamicResource Str_Password_ModeHeader}" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.TimerOutline}" />
                            <StackPanel Margin="0,6,0,0">
                                <RadioButton x:Name="RadioStopwatch" Margin="0,0,0,4" Click="Mode_Click" Content="{DynamicResource Str_TimerStopwatch_Stopwatch}" GroupName="TsMode" IsChecked="True" Style="{StaticResource ModeToggleButtonStyle}" Tag="Stopwatch" />
                                <RadioButton x:Name="RadioCountdown" Margin="0,0,0,4" Click="Mode_Click" Content="{DynamicResource Str_TimerStopwatch_TimerCountdown}" GroupName="TsMode" Style="{StaticResource ModeToggleButtonStyle}" Tag="Countdown" />
                                <RadioButton x:Name="RadioPomodoro" Click="Mode_Click" Content="{DynamicResource Str_TimerStopwatch_Pomodoro}" GroupName="TsMode" Style="{StaticResource ModeToggleButtonStyle}" Tag="Pomodoro" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border ctl:Tour.Key="Str_Tour_TimerStopwatch_Timer" ctl:Tour.Order="2" x:Name="CardCountdown" Margin="0,0,0,10" Style="{StaticResource SidebarGroupCardStyle}" Visibility="Collapsed">
                        <StackPanel>
                            <ContentControl Content="{DynamicResource Str_Screenshot_Delay}" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.TimerSand}" />
                            <TextBlock Style="{StaticResource TsLabel}" Text="{DynamicResource Str_TimerStopwatch_TimeSHM}" />
                            <Border Style="{StaticResource InputBarStyle}">
                                <TextBox x:Name="TxtCountdown" VerticalContentAlignment="Center" Style="{StaticResource BareTextBox}" TextChanged="Setting_TextChanged" />
                            </Border>
                            <WrapPanel Margin="0,8,0,0">
                                <Button Click="Preset_Click" Content="{DynamicResource Str_TimerStopwatch_Min}" Tag="1:00" Style="{StaticResource PillChipStyle}" />
                                <Button Click="Preset_Click" Content="{DynamicResource Str_TimerStopwatch_Min2}" Tag="5:00" Style="{StaticResource PillChipStyle}" />
                                <Button Click="Preset_Click" Content="{DynamicResource Str_TimerStopwatch_Min3}" Tag="10:00" Style="{StaticResource PillChipStyle}" />
                                <Button Click="Preset_Click" Content="{DynamicResource Str_TimerStopwatch_Min4}" Tag="25:00" Style="{StaticResource PillChipStyle}" />
                                <Button Click="Preset_Click" Content="{DynamicResource Str_TimerStopwatch_Hour}" Tag="1:00:00" Style="{StaticResource PillChipStyle}" />
                            </WrapPanel>
                        </StackPanel>
                    </Border>

                    <Border ctl:Tour.Key="Str_Tour_TimerStopwatch_Pomodoro" ctl:Tour.Order="3" x:Name="CardPomodoro" Margin="0,0,0,10" Style="{StaticResource SidebarGroupCardStyle}" Visibility="Collapsed">
                        <StackPanel>
                            <ContentControl Content="{DynamicResource Str_TimerStopwatch_Pomodoro}" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.TimerCogOutline}" />
                            <TextBlock Style="{StaticResource TsLabel}" Text="{DynamicResource Str_TimerStopwatch_WorkMinutes}" />
                            <Border Style="{StaticResource InputBarStyle}"><TextBox x:Name="TxtWork" VerticalContentAlignment="Center" Style="{StaticResource BareTextBox}" TextChanged="Setting_TextChanged" /></Border>
                            <TextBlock Style="{StaticResource TsLabel}" Text="{DynamicResource Str_TimerStopwatch_ShortBreakMinutes}" />
                            <Border Style="{StaticResource InputBarStyle}"><TextBox x:Name="TxtShort" VerticalContentAlignment="Center" Style="{StaticResource BareTextBox}" TextChanged="Setting_TextChanged" /></Border>
                            <TextBlock Style="{StaticResource TsLabel}" Text="{DynamicResource Str_TimerStopwatch_LongBreakMinutes}" />
                            <Border Style="{StaticResource InputBarStyle}"><TextBox x:Name="TxtLong" VerticalContentAlignment="Center" Style="{StaticResource BareTextBox}" TextChanged="Setting_TextChanged" /></Border>
                            <TextBlock Style="{StaticResource TsLabel}" Text="{DynamicResource Str_TimerStopwatch_LongBreakAfterHow}" />
                            <Border Style="{StaticResource InputBarStyle}"><TextBox x:Name="TxtEvery" VerticalContentAlignment="Center" Style="{StaticResource BareTextBox}" TextChanged="Setting_TextChanged" /></Border>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl Content="{DynamicResource Str_TimerStopwatch_Alert}" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.BellRingOutline}" />
                            <CheckBox x:Name="ChkSound" Margin="0,8,0,0" Click="Setting_Click" Content="{DynamicResource Str_TimerStopwatch_PlayASoundWhen}" IsChecked="True" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </controls:ToolSidebar>

            <!--  ================= MAIN AREA =================  -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="2*" MinHeight="280" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" MinHeight="150" />
                </Grid.RowDefinitions>

                <!--  ========== The clock: the time inside a round progress bar ==========  -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Viewbox Margin="8,4" MaxHeight="460" Stretch="Uniform">
                            <Grid Width="380" Height="380">
                                <controls:RingProgress
                                    x:Name="BarProgress"
                                    Stroke="{DynamicResource AccentColor}"
                                    Thickness="16"
                                    Track="{DynamicResource RowBg}" />
                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <TextBlock
                                        x:Name="TxtPhase"
                                        MaxWidth="260"
                                        HorizontalAlignment="Center"
                                        FontSize="16"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource AccentColor}"
                                        TextAlignment="Center"
                                        TextTrimming="CharacterEllipsis" />
                                    <Viewbox MaxWidth="270" StretchDirection="DownOnly">
                                        <TextBlock
                                            ctl:Tour.Key="Str_Tour_TimerStopwatch_Clock"
                                            ctl:Tour.Order="4"
                                            x:Name="TxtTime"
                                            FontFamily="Cascadia Mono, Consolas"
                                            FontSize="62"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource TextPrimary}"
                                            Text="00:00.00" />
                                    </Viewbox>
                                    <TextBlock
                                        x:Name="TxtMessage"
                                        MaxWidth="250"
                                        Margin="0,6,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource StatusSuccessFg}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                    <StackPanel
                                        x:Name="DotsPanel"
                                        Margin="0,10,0,0"
                                        HorizontalAlignment="Center"
                                        Orientation="Horizontal"
                                        Visibility="Collapsed" />
                                </StackPanel>
                            </Grid>
                        </Viewbox>

                        <StackPanel Grid.Row="1" Margin="0,4,0,6" HorizontalAlignment="Center" VerticalAlignment="Center" Orientation="Horizontal">
                            <Button
                                ctl:Tour.Key="Str_Tour_TimerStopwatch_Lap"
                                ctl:Tour.Order="6"
                                x:Name="BtnLap"
                                MinWidth="84"
                                MinHeight="38"
                                Margin="0,0,22,0"
                                VerticalAlignment="Center"
                                Click="BtnLap_Click"
                                Content="{DynamicResource Str_TimerStopwatch_Lap}"
                                IsEnabled="False"
                                Style="{StaticResource PillChipStyle}" />
                            <StackPanel>
                                <Button
                                    ctl:Tour.Key="Str_Tour_TimerStopwatch_Start"
                                    ctl:Tour.Order="5"
                                    x:Name="BtnStart"
                                    Width="80"
                                    Height="80"
                                    HorizontalAlignment="Center"
                                    Click="BtnStart_Click"
                                    Style="{StaticResource RoundMainButtonStyle}">
                                    <materialDesign:PackIcon
                                        x:Name="IconStart"
                                        Width="36"
                                        Height="36"
                                        Kind="Play" />
                                </Button>
                                <TextBlock
                                    x:Name="TxtStart"
                                    Margin="0,6,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{DynamicResource Str_RenameFiles_Start}" />
                            </StackPanel>
                            <Button
                                ctl:Tour.Key="Str_Tour_TimerStopwatch_Reset"
                                ctl:Tour.Order="7"
                                x:Name="BtnReset"
                                MinWidth="84"
                                MinHeight="38"
                                Margin="22,0,0,0"
                                VerticalAlignment="Center"
                                Click="BtnReset_Click"
                                Content="{DynamicResource Str_Common_Reset}"
                                Style="{StaticResource PillChipStyle}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  ========== Laps (stopwatch) ==========  -->
                <Border x:Name="LapArea" Grid.Row="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ContentControl Margin="0,0,0,8" Content="{DynamicResource Str_TimerStopwatch_Laps}" Style="{StaticResource CardHeader}" Tag="{x:Static materialDesign:PackIconKind.FlagCheckered}" />
                        <Grid Grid.Row="1">
                            <ListBox ctl:Tour.Key="Str_Tour_TimerStopwatch_Laps" ctl:Tour.Order="8" x:Name="LapList" Background="Transparent" BorderThickness="0">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="0,2">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="60" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock FontSize="12.5" Foreground="{DynamicResource TextSecondary}" Text="{Binding Number}" />
                                            <TextBlock Grid.Column="1" FontFamily="Cascadia Mono, Consolas" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding Split}" />
                                            <TextBlock Grid.Column="2" FontFamily="Cascadia Mono, Consolas" FontSize="13" Foreground="{DynamicResource TextSecondary}" Text="{Binding Total}" />
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <TextBlock x:Name="TxtLapEmpty" HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" IsHitTestVisible="False" Text="{DynamicResource Str_TimerStopwatch_PressLapWhileThe}" />
                        </Grid>
                    </Grid>
                </Border>

                <!--  ========== Help (timer and Pomodoro) ==========  -->
                <Border x:Name="InfoCard" Grid.Row="2" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                    <StackPanel>
                        <ContentControl x:Name="InfoHeader" Margin="0,0,0,8" Content="{DynamicResource Str_Shell_About}" Style="{StaticResource CardHeader}" Tag="{x:Static materialDesign:PackIconKind.InformationOutline}" />
                        <TextBlock x:Name="TxtInfoBody" FontSize="13" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                        <TextBlock x:Name="TxtSessions" Margin="0,14,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentColor}" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
