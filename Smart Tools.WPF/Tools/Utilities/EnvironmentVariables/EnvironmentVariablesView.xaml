<UserControl
    x:Class="Smart_Tools.WPF.Views.EnvironmentVariablesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:Smart_Tools.WPF.Models"
    x:Name="Root"
    d:DesignHeight="700"
    d:DesignWidth="1200"
    mc:Ignorable="d"
    Loaded="View_Loaded">

    <!--
        Environment Variables Editor - user and system variables, and the PATH folder by folder.
        Backend: Controllers/EnvironmentVariablesManager*.cs; Models/EnvironmentVariablesModel.cs. UI only here.
    -->

    <UserControl.Resources>

        <!--  Rows fill the list, so each row's buttons sit at the right edge  -->
        <Style
            x:Key="StretchRowStyle"
            BasedOn="{StaticResource {x:Type ListBoxItem}}"
            TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
        </Style>
        <FontFamily x:Key="EnvMono">Cascadia Mono, Consolas, Courier New</FontFamily>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!--  One folder of the PATH  -->
        <DataTemplate x:Key="PathEntryTemplate" DataType="{x:Type models:EnvPathEntry}">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="22" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <materialDesign:PackIcon
                    Width="16"
                    Height="16"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource StatusWarningFg}"
                    Kind="AlertCircleOutline"
                    ToolTip="{Binding IssueText}"
                    Visibility="{Binding HasIssue, Converter={StaticResource BoolToVisibility}}" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontFamily="{StaticResource EnvMono}"
                    FontSize="12"
                    Foreground="{DynamicResource TextPrimary}"
                    Text="{Binding Path}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding Path}" />
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button
                        Click="BtnPathUp_Click"
                        Style="{StaticResource ListToolButtonStyle}"
                        ToolTip="{DynamicResource Str_EnvVars_MoveUp}">
                        <materialDesign:PackIcon
                            Width="16"
                            Height="16"
                            Kind="ArrowUp" />
                    </Button>
                    <Button
                        Click="BtnPathDown_Click"
                        Style="{StaticResource ListToolButtonStyle}"
                        ToolTip="{DynamicResource Str_EnvVars_MoveDown}">
                        <materialDesign:PackIcon
                            Width="16"
                            Height="16"
                            Kind="ArrowDown" />
                    </Button>
                    <Button
                        Click="BtnPathRemove_Click"
                        Style="{StaticResource ListToolDangerButtonStyle}"
                        ToolTip="{DynamicResource Str_EnvVars_RemoveFolder}">
                        <materialDesign:PackIcon
                            Width="16"
                            Height="16"
                            Kind="Close" />
                    </Button>
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">

        <!--  No page header: MainWindow's header card shows the tool's icon and name.  -->

        <Grid Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OptionsColumn" Width="280" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= SIDEBAR =================  -->

            <Border Grid.Column="0" Style="{StaticResource SidebarPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Button
                            x:Name="BtnCollapseOptions"
                            MinHeight="45"
                            HorizontalContentAlignment="Left"
                            Click="BtnCollapseOptions_Click"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Foreground="{DynamicResource SidebarText}"
                            ToolTip="{DynamicResource Str_Common_SidebarToggleTooltip}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="OverridesDefaultStyle" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Margin="16,0,0,0" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Kind="TuneVariant" />
                                <TextBlock
                                    x:Name="TxtOptionsHeaderLabel"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{DynamicResource Str_Common_OptionsLabel}" />
                            </StackPanel>
                        </Button>
                        <Separator
                            x:Name="SepHeader"
                            Margin="16,4"
                            Style="{StaticResource SidebarSeparatorStyle}" />
                    </StackPanel>

                    <ScrollViewer
                        x:Name="OptionsScrollViewer"
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16,4,16,16">

                            <!--  ============ SCOPE ============  -->
                            <Border ctl:Tour.Key="Str_Tour_EnvVars_Scope" ctl:Tour.Order="1" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_EnvVars_ScopeHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.AccountGroupOutline}" />
                                    <UniformGrid Columns="2">
                                        <RadioButton
                                            Margin="0,0,2,0"
                                            Click="Scope_Click"
                                            Content="{DynamicResource Str_EnvVars_User}"
                                            GroupName="EnvScope"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="User" />
                                        <RadioButton
                                            Margin="2,0,0,0"
                                            Click="Scope_Click"
                                            Content="{DynamicResource Str_EnvVars_System}"
                                            GroupName="EnvScope"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="System" />
                                    </UniformGrid>
                                    <TextBlock x:Name="TxtScopeHint" Style="{StaticResource SidebarHint}" />
                                </StackPanel>
                            </Border>

                            <!--  ============ CHANGES ============  -->
                            <Border ctl:Tour.Key="Str_Tour_EnvVars_Changes" ctl:Tour.Order="2" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_EnvVars_ChangesHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.History}" />
                                    <Button
                                        x:Name="BtnUndo"
                                        Margin="0,4,0,0"
                                        Click="BtnUndo_Click"
                                        IsEnabled="False"
                                        Style="{StaticResource PrimaryButtonStyle}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon
                                                Width="16"
                                                Height="16"
                                                VerticalAlignment="Center"
                                                Kind="UndoVariant" />
                                            <TextBlock
                                                Margin="6,0,0,0"
                                                VerticalAlignment="Center"
                                                Text="{DynamicResource Str_EnvVars_Undo}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Style="{StaticResource SidebarHint}" Text="{DynamicResource Str_EnvVars_ChangesHint}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--  ================= CONTENT =================  -->

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    x:Name="AdminBanner"
                    Margin="0,0,0,12"
                    Padding="14,12"
                    Background="{DynamicResource StatusWarningBg}"
                    CornerRadius="12"
                    Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon
                            Width="22"
                            Height="22"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource StatusWarningFg}"
                            Kind="ShieldAlertOutline" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource StatusWarningFg}"
                                Text="{DynamicResource Str_EnvVars_AdminTitle}" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource StatusWarningFg}"
                                Text="{DynamicResource Str_EnvVars_AdminText}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Click="BtnRestartAdmin_Click"
                            Style="{StaticResource PrimaryButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    VerticalAlignment="Center"
                                    Kind="ShieldCheckOutline" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="{DynamicResource Str_EnvVars_RestartAdmin}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="240" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="1.5*" MinWidth="320" />
                    </Grid.ColumnDefinitions>

                    <!--  Variables  -->
                    <Border ctl:Tour.Key="Str_Tour_EnvVars_Variables" ctl:Tour.Order="3" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource InputBarStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon
                                            Width="16"
                                            Height="16"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource TextSecondary}"
                                            Kind="Magnify" />
                                        <TextBox
                                            x:Name="TxtSearch"
                                            Grid.Column="1"
                                            Margin="6,0,6,0"
                                            VerticalAlignment="Center"
                                            Tag="{DynamicResource Str_EnvVars_SearchPlaceholder}"
                                            Style="{StaticResource BareTextBox}"
                                            TextChanged="TxtSearch_TextChanged" />
                                    </Grid>
                                </Border>
                                <Button
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Click="BtnNew_Click"
                                    Style="{StaticResource ListToolPrimaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="16"
                                            Height="16"
                                            VerticalAlignment="Center"
                                            Kind="Plus" />
                                        <TextBlock
                                            Margin="6,0,0,0"
                                            VerticalAlignment="Center"
                                            Text="{DynamicResource Str_EnvVars_New}" />
                                    </StackPanel>
                                </Button>
                            </Grid>
                            <DataGrid
                                x:Name="GridVars"
                                Grid.Row="1"
                                Margin="0,10,0,0"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                FontSize="12"
                                IsReadOnly="True"
                                MinRowHeight="36"
                                SelectionChanged="GridVars_SelectionChanged"
                                SelectionMode="Single"
                                VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Width="1.1*"
                                        MinWidth="80"
                                        Binding="{Binding Name}"
                                        ElementStyle="{StaticResource EllipsisCellTextStyle}"
                                        Header="{DynamicResource Str_EnvVars_ColName}" />
                                    <DataGridTextColumn
                                        Width="2*"
                                        MinWidth="80"
                                        Binding="{Binding Preview}"
                                        ElementStyle="{StaticResource EllipsisCellTextStyle}"
                                        Header="{DynamicResource Str_EnvVars_ColValue}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>
                    </Border>

                    <!--  Editor  -->
                    <Border ctl:Tour.Key="Str_Tour_EnvVars_Editor" ctl:Tour.Order="4" Grid.Column="2" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid x:Name="PanelEditor" d:Visibility="Visible" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <ContentControl
                                    x:Name="HdrEditor"
                                    Content="{DynamicResource Str_EnvVars_EditHeader}"
                                    Style="{StaticResource CardHeader}"
                                    Tag="{x:Static materialDesign:PackIconKind.VariableBox}" />

                                <ScrollViewer
                                    Grid.Row="1"
                                    Margin="0,10,0,0"
                                    HorizontalScrollBarVisibility="Disabled"
                                    VerticalScrollBarVisibility="Auto">
                                    <StackPanel Margin="0,0,6,0">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Str_EnvVars_FieldName}" />
                                        <TextBox
                                            x:Name="TxtName"
                                            Margin="0,4,0,0"
                                            FontFamily="{StaticResource EnvMono}"
                                            TextChanged="Editor_Changed" />

                                        <TextBlock
                                            Margin="0,12,0,0"
                                            Style="{StaticResource FieldLabel}"
                                            Text="{DynamicResource Str_EnvVars_FieldValue}" />
                                        <TextBox
                                            x:Name="TxtValue" Height="Auto"
                                            MinHeight="64"
                                            MaxHeight="160"
                                            Margin="0,4,0,0"
                                            VerticalContentAlignment="Top"
                                            AcceptsReturn="False"
                                            FontFamily="{StaticResource EnvMono}"
                                            FontSize="12"
                                            TextChanged="TxtValue_TextChanged"
                                            TextWrapping="Wrap"
                                            VerticalScrollBarVisibility="Auto" />

                                        <CheckBox
                                            x:Name="ChkExpand"
                                            Margin="0,10,0,0"
                                            Click="Editor_Changed"
                                            Content="{DynamicResource Str_EnvVars_Expandable}"
                                            ToolTip="{DynamicResource Str_EnvVars_ExpandableTip}" />
                                        <TextBlock
                                            x:Name="TxtExpandHint"
                                            Margin="0,4,0,0"
                                            FontSize="11.5"
                                            Foreground="{DynamicResource StatusWarningFg}"
                                            TextWrapping="Wrap"
                                            Visibility="Collapsed" />

                                        <!--  The PATH folder by folder  -->
                                        <Border
                                            x:Name="PathSection"
                                            Margin="0,16,0,4"
                                            BorderBrush="{DynamicResource CardBorder}"
                                            BorderThickness="0,1,0,0"
                                            Padding="0,14,0,0"
                                            Visibility="Collapsed">
                                            <StackPanel>
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <ContentControl
                                                        Content="{DynamicResource Str_EnvVars_Folders}"
                                                        Style="{StaticResource CardHeader}"
                                                        Tag="{x:Static materialDesign:PackIconKind.FolderMultipleOutline}" />
                                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                        <Border
                                                            x:Name="PillPathIssues"
                                                            Margin="0,0,8,0"
                                                            Style="{StaticResource IconStatusPillStyle}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <materialDesign:PackIcon
                                                                    x:Name="IconPathIssues"
                                                                    Width="13"
                                                                    Height="13"
                                                                    Margin="0,0,5,0"
                                                                    VerticalAlignment="Center"
                                                                    Kind="CheckCircleOutline" />
                                                                <TextBlock
                                                                    x:Name="TxtPathIssues"
                                                                    VerticalAlignment="Center"
                                                                    FontSize="11"
                                                                    FontWeight="SemiBold" />
                                                            </StackPanel>
                                                        </Border>
                                                        <Button
                                                            Margin="0,0,2,0"
                                                            Click="BtnPathAdd_Click"
                                                            Style="{StaticResource ListToolButtonStyle}"
                                                            ToolTip="{DynamicResource Str_EnvVars_AddFolder}">
                                                            <materialDesign:PackIcon
                                                                Width="16"
                                                                Height="16"
                                                                Kind="FolderPlusOutline" />
                                                        </Button>
                                                        <Button
                                                            x:Name="BtnPathClean"
                                                            Click="BtnPathClean_Click"
                                                            Style="{StaticResource ListToolButtonStyle}"
                                                            ToolTip="{DynamicResource Str_EnvVars_CleanUp}">
                                                            <materialDesign:PackIcon
                                                                Width="16"
                                                                Height="16"
                                                                Kind="Broom" />
                                                        </Button>
                                                    </StackPanel>
                                                </Grid>
                                                <ListBox
                                                    x:Name="ListPath"
                                                    ItemContainerStyle="{StaticResource StretchRowStyle}"
                                                    MaxHeight="300"
                                                    Margin="0,8,0,0"
                                                    BorderThickness="0"
                                                    ItemTemplate="{StaticResource PathEntryTemplate}"
                                                    ScrollViewer.HorizontalScrollBarVisibility="Disabled" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </ScrollViewer>

                                <Border
                                    Grid.Row="2"
                                    Margin="0,10,0,0"
                                    BorderBrush="{DynamicResource CardBorder}"
                                    BorderThickness="0,1,0,0"
                                    Padding="0,12,0,0">
                                    <StackPanel Orientation="Horizontal">
                                        <Button
                                            x:Name="BtnSave"
                                            Click="BtnSave_Click"
                                            Content="{DynamicResource Str_EnvVars_Save}"
                                            Style="{StaticResource AccentPrimaryButtonStyle}" />
                                        <Button
                                            x:Name="BtnDelete"
                                            Margin="8,0,0,0"
                                            Click="BtnDelete_Click"
                                            Content="{DynamicResource Str_EnvVars_Delete}"
                                            Style="{StaticResource DangerButtonStyle}" />
                                        <TextBlock
                                            x:Name="TxtStatus"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextSecondary}"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <StackPanel
                                x:Name="PanelNoSelection"
                                MaxWidth="360"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                d:Visibility="Collapsed"
                                IsHitTestVisible="False">
                                <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.VariableBox}" />
                                <TextBlock
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimary}"
                                    Text="{DynamicResource Str_EnvVars_PickTitle}" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{DynamicResource Str_EnvVars_PickHint}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
