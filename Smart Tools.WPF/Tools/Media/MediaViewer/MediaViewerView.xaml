<UserControl
    x:Class="Smart_Tools.WPF.Views.MediaViewerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    x:Name="Root"
    AllowDrop="True"
    DragOver="Root_DragOver"
    Drop="Root_Drop"
    Focusable="True"
    PreviewKeyDown="Root_PreviewKeyDown"
    Unloaded="Root_Unloaded">

    <!--
        Backend: Controllers/MediaViewerManager.cs (what a file is, folders, times).
        Pictures: ImageViewerManager.LoadForView. Video and sound: WPF's MediaElement
        (Windows Media Foundation). This file and the code-behind are UI only.
        The stage is fixed-dark like the other players; the list uses theme colours.
    -->

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="280" />
        </Grid.ColumnDefinitions>

        <!--  ============ Stage + controls ============  -->
        <Border
            Grid.Column="0"
            Margin="0,0,10,0"
            Background="#0E0F12"
            ClipToBounds="True"
            CornerRadius="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid x:Name="Stage" Grid.Row="0">
                    <ScrollViewer
                        x:Name="ImageScroll"
                        HorizontalScrollBarVisibility="Disabled"
                        PreviewMouseWheel="ImageScroll_PreviewMouseWheel"
                        SizeChanged="ImageScroll_SizeChanged"
                        VerticalScrollBarVisibility="Disabled"
                        Visibility="Collapsed">
                        <Image
                            x:Name="ImageView"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            MouseLeftButtonDown="ImageView_MouseLeftButtonDown"
                            MouseLeftButtonUp="ImageView_MouseLeftButtonUp"
                            MouseMove="ImageView_MouseMove"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Stretch="Uniform" />
                    </ScrollViewer>

                    <MediaElement
                        x:Name="Player"
                        LoadedBehavior="Manual"
                        MediaEnded="Player_MediaEnded"
                        MediaFailed="Player_MediaFailed"
                        MediaOpened="Player_MediaOpened"
                        MouseLeftButtonUp="Player_MouseLeftButtonUp"
                        Stretch="Uniform"
                        UnloadedBehavior="Manual"
                        Visibility="Collapsed" />

                    <StackPanel
                        x:Name="AudioPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False"
                        Visibility="Collapsed">
                        <materialDesign:PackIcon
                            Width="110"
                            Height="110"
                            HorizontalAlignment="Center"
                            Foreground="#6B7280"
                            Kind="MusicNote" />
                        <TextBlock
                            x:Name="TxtAudioName"
                            MaxWidth="420"
                            Margin="0,16,0,0"
                            HorizontalAlignment="Center"
                            FontSize="16"
                            Foreground="#E9EBEF"
                            TextAlignment="Center"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>

                    <StackPanel
                        x:Name="EmptyPanel"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                        <materialDesign:PackIcon
                            Width="72"
                            Height="72"
                            HorizontalAlignment="Center"
                            Foreground="#6B7280"
                            Kind="PlayBoxMultipleOutline" />
                        <TextBlock
                            Margin="0,14,0,16"
                            HorizontalAlignment="Center"
                            FontSize="14"
                            Foreground="#9CA3AF"
                            Text="{DynamicResource Str_MediaViewer_DropHint}" />
                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                            <Button
                                Margin="0,0,8,0"
                                Click="BtnOpenFiles_Click"
                                Content="{DynamicResource Str_MediaViewer_OpenFiles}" />
                            <Button Click="BtnOpenFolder_Click" Content="{DynamicResource Str_MediaViewer_OpenFolder}" />
                        </StackPanel>
                    </StackPanel>

                    <TextBlock
                        x:Name="TxtError"
                        MaxWidth="460"
                        Margin="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="14"
                        Foreground="#FCA5A5"
                        TextAlignment="Center"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                </Grid>

                <!--  Controls  -->
                <Border
                    Grid.Row="1"
                    Padding="12,8"
                    Background="#15171C">
                    <StackPanel>
                        <Grid x:Name="SeekRow" Margin="0,0,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                x:Name="TxtPosition"
                                Width="52"
                                VerticalAlignment="Center"
                                Foreground="#C9CDD4"
                                Text="0:00" />
                            <Slider
                                x:Name="PosSlider"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Maximum="1"
                                Minimum="0"
                                ValueChanged="PosSlider_ValueChanged" />
                            <TextBlock
                                x:Name="TxtDuration"
                                Grid.Column="2"
                                Width="52"
                                VerticalAlignment="Center"
                                Foreground="#C9CDD4"
                                Text="0:00"
                                TextAlignment="Right" />
                        </Grid>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                <Button
                                    x:Name="BtnPrev"
                                    Click="BtnPrev_Click"
                                    Style="{StaticResource PlayerIconButtonStyle}"
                                    ToolTip="{DynamicResource Str_MediaViewer_Previous}">
                                    <materialDesign:PackIcon Kind="SkipPrevious" />
                                </Button>
                                <Button
                                    x:Name="BtnPlay"
                                    Margin="8,0"
                                    Click="BtnPlay_Click"
                                    Style="{StaticResource PlayerIconButtonStyle}"
                                    ToolTip="{DynamicResource Str_MediaViewer_PlayPause}">
                                    <materialDesign:PackIcon x:Name="PlayIcon" Kind="Play" />
                                </Button>
                                <Button
                                    x:Name="BtnNext"
                                    Click="BtnNext_Click"
                                    Style="{StaticResource PlayerIconButtonStyle}"
                                    ToolTip="{DynamicResource Str_MediaViewer_Next}">
                                    <materialDesign:PackIcon Kind="SkipNext" />
                                </Button>
                            </StackPanel>

                            <StackPanel
                                Grid.Column="1"
                                Margin="14,0"
                                VerticalAlignment="Center">
                                <TextBlock
                                    x:Name="TxtNowPlaying"
                                    Foreground="#E9EBEF"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="TxtInfo"
                                    FontSize="11"
                                    Foreground="#9CA3AF"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Button
                                    x:Name="BtnFit"
                                    Margin="0,0,8,0"
                                    Click="BtnFit_Click"
                                    Style="{StaticResource PlayerIconButtonStyle}"
                                    ToolTip="{DynamicResource Str_MediaViewer_Fit}">
                                    <materialDesign:PackIcon Kind="ArrowExpandAll" />
                                </Button>
                                <ComboBox
                                    x:Name="ComboSpeed"
                                    Width="72"
                                    Margin="0,0,8,0"
                                    SelectedIndex="2"
                                    SelectionChanged="ComboSpeed_SelectionChanged"
                                    ToolTip="{DynamicResource Str_MediaViewer_Speed}">
                                    <ComboBoxItem Content="0.5x" Tag="0.5" />
                                    <ComboBoxItem Content="0.75x" Tag="0.75" />
                                    <ComboBoxItem Content="1x" Tag="1" />
                                    <ComboBoxItem Content="1.25x" Tag="1.25" />
                                    <ComboBoxItem Content="1.5x" Tag="1.5" />
                                    <ComboBoxItem Content="2x" Tag="2" />
                                </ComboBox>
                                <Button
                                    x:Name="BtnMute"
                                    Click="BtnMute_Click"
                                    Style="{StaticResource PlayerIconButtonStyle}"
                                    ToolTip="{DynamicResource Str_MediaViewer_Mute}">
                                    <materialDesign:PackIcon x:Name="MuteIcon" Kind="VolumeHigh" />
                                </Button>
                                <Slider
                                    x:Name="VolumeSlider"
                                    Width="90"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Maximum="1"
                                    Minimum="0"
                                    ValueChanged="VolumeSlider_ValueChanged"
                                    Value="0.8" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!--  ============ Playlist ============  -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Grid Margin="0,0,0,8">
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource MaterialDesignBody}"
                    Text="{DynamicResource Str_MediaViewer_Playlist}" />
                <TextBlock
                    x:Name="TxtCount"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource MaterialDesignBodyLight}" />
            </Grid>

            <ListBox
                x:Name="PlaylistBox"
                Grid.Row="1"
                HorizontalContentAlignment="Stretch"
                SelectionChanged="PlaylistBox_SelectionChanged">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid Margin="2,3" ToolTip="{Binding Path}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon
                                Width="16"
                                Height="16"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Kind="{Binding Icon}"
                                Opacity="0.7" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Text="{Binding Name}"
                                TextTrimming="CharacterEllipsis" />
                        </Grid>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <WrapPanel Grid.Row="2" Margin="0,10,0,0">
                <Button
                    Margin="0,0,6,6"
                    Click="BtnOpenFiles_Click"
                    Content="{DynamicResource Str_MediaViewer_OpenFiles}" />
                <Button
                    Margin="0,0,6,6"
                    Click="BtnOpenFolder_Click"
                    Content="{DynamicResource Str_MediaViewer_OpenFolder}" />
                <Button
                    Margin="0,0,0,6"
                    Click="BtnClear_Click"
                    Content="{DynamicResource Str_MediaViewer_Clear}" />
            </WrapPanel>
        </Grid>
    </Grid>
</UserControl>
