<UserControl
    x:Class="Smart_Tools.WPF.Views.MediaViewerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:models="clr-namespace:Smart_Tools.WPF.Models"
    x:Name="Root"
    AllowDrop="True"
    DragLeave="Root_DragLeave"
    DragOver="Root_DragOver"
    Drop="Root_Drop"
    Focusable="True"
    Loaded="Root_Loaded"
    PreviewKeyDown="Root_PreviewKeyDown"
    Unloaded="Root_Unloaded">

    <!--
        Backend: Controllers/MediaViewerManager.cs (what a file is, folders, times).
        Pictures: ImageViewerManager.LoadForView. Video and sound: WPF's MediaElement
        (Windows Media Foundation). This file and the code-behind are UI only.
        Same layout as Video Replay and Image Viewer: options sidebar, a fixed-dark
        stage (#0E0F12) with player chrome, and a playlist card. Everything around
        the stage uses theme tokens.
    -->

    <UserControl.Resources>

        <!--  ============ Player chrome (same as Video Replay) ============  -->

        <Style
            x:Key="PlayerPrimaryButtonStyle"
            BasedOn="{StaticResource PlayerIconButtonStyle}"
            TargetType="Button">
            <Setter Property="Width" Value="50" />
            <Setter Property="Height" Value="50" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Background="{DynamicResource AccentFill}"
                            CornerRadius="25">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.74" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Hairline scrubber  -->
        <Style x:Key="PlayerSliderStyle" TargetType="Slider">
            <Setter Property="Height" Value="16" />
            <Setter Property="IsMoveToPointEnabled" Value="True" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Slider">
                        <Grid VerticalAlignment="Center" Background="Transparent">
                            <Border
                                Height="3"
                                Background="#33FFFFFF"
                                CornerRadius="1.5" />
                            <Track x:Name="PART_Track">
                                <Track.DecreaseRepeatButton>
                                    <RepeatButton Command="Slider.DecreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border
                                                    Height="3"
                                                    Background="{DynamicResource AccentColor}"
                                                    CornerRadius="1.5" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.DecreaseRepeatButton>
                                <Track.IncreaseRepeatButton>
                                    <RepeatButton Command="Slider.IncreaseLarge">
                                        <RepeatButton.Template>
                                            <ControlTemplate>
                                                <Border Background="Transparent" />
                                            </ControlTemplate>
                                        </RepeatButton.Template>
                                    </RepeatButton>
                                </Track.IncreaseRepeatButton>
                                <Track.Thumb>
                                    <Thumb Width="12" Height="12">
                                        <Thumb.Template>
                                            <ControlTemplate TargetType="Thumb">
                                                <Ellipse Fill="White" />
                                            </ControlTemplate>
                                        </Thumb.Template>
                                    </Thumb>
                                </Track.Thumb>
                            </Track>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Speed pill ("1.5x") on the stage  -->
        <Style
            x:Key="PlayerPillButtonStyle"
            BasedOn="{StaticResource PlayerIconButtonStyle}"
            TargetType="Button">
            <Setter Property="Width" Value="Auto" />
            <Setter Property="MinWidth" Value="48" />
            <Setter Property="Padding" Value="10,0" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="#1AFFFFFF"
                            CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="#2AFFFFFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Input card: one added folder, or added files from one folder  -->
        <DataTemplate x:Key="QueueItemTemplate" DataType="{x:Type models:MediaQueueGroup}">
            <Grid ToolTip="{Binding ToolTip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="26"
                    Height="26"
                    Margin="0,0,8,0"
                    Background="{DynamicResource AccentColorSubtle}"
                    CornerRadius="7">
                    <materialDesign:PackIcon
                        x:Name="GroupIcon"
                        Width="14"
                        Height="14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource AccentColor}"
                        Kind="FileMultipleOutline" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource SidebarText}"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Margin="0,1,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource SidebarTextMuted}"
                        Text="{Binding Subtitle}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button
                    Grid.Column="2"
                    Width="24"
                    Height="24"
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    Click="BtnRemoveQueueGroup_Click"
                    Style="{StaticResource IconButtonStyle}"
                    Tag="{Binding}"
                    ToolTip="{DynamicResource Str_MediaViewer_RemoveFromList}">
                    <materialDesign:PackIcon
                        Width="13"
                        Height="13"
                        Kind="Close" />
                </Button>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                    <Setter TargetName="GroupIcon" Property="Kind" Value="Folder" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  Playlist: kind icon  -->
        <DataTemplate x:Key="KindCellTemplate" DataType="{x:Type models:MediaItem}">
            <Border
                Width="34"
                Height="34"
                HorizontalAlignment="Center"
                Background="{DynamicResource RowBg}"
                CornerRadius="6">
                <materialDesign:PackIcon
                    Width="16"
                    Height="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextSecondary}"
                    Kind="{Binding Icon}" />
            </Border>
        </DataTemplate>

        <!--  Playlist: name + folder  -->
        <DataTemplate x:Key="NameCellTemplate" DataType="{x:Type models:MediaItem}">
            <StackPanel VerticalAlignment="Center" ToolTip="{Binding Path}">
                <TextBlock
                    Foreground="{DynamicResource TextPrimary}"
                    Text="{Binding Name}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Margin="0,1,0,0"
                    FontSize="11"
                    Foreground="{DynamicResource TextSecondary}"
                    Text="{Binding Folder}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">

        <!--  No page header: MainWindow's header card shows the tool's icon and name.  -->

        <Grid Margin="16,8,16,16">

            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OptionsColumn" Width="280" />
                <ColumnDefinition x:Name="OptionsGapColumn" Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= OPTIONS SIDEBAR =================  -->

            <Border
                x:Name="OptionsSidebar"
                Grid.Column="0"
                Style="{StaticResource SidebarPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Button
                            x:Name="BtnCollapseOptions"
                            MinHeight="45"
                            HorizontalContentAlignment="Left"
                            Click="BtnCollapseOptions_Click"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Foreground="{DynamicResource SidebarText}"
                            ToolTip="{DynamicResource Str_Common_SidebarToggleTooltip}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="OverridesDefaultStyle" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Margin="16,0,0,0" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Kind="TuneVariant" />
                                <TextBlock
                                    x:Name="TxtOptionsHeaderLabel"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{DynamicResource Str_Common_OptionsLabel}" />
                            </StackPanel>
                        </Button>
                        <Separator
                            x:Name="SepHeader"
                            Margin="16,4"
                            Style="{StaticResource SidebarSeparatorStyle}" />
                    </StackPanel>

                    <ScrollViewer
                        x:Name="OptionsScrollViewer"
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16,4,16,16">

                            <!--  ============ FILES (shared input card) ============  -->
                            <controls:InputFolderCard
                                x:Name="InputCard"
                                ClearRequested="InputCard_ClearRequested"
                                Header="{DynamicResource Str_MediaViewer_Files}"
                                HeaderIcon="PlayBoxMultipleOutline"
                                IncludeSubfoldersChanged="InputCard_IncludeSubfoldersChanged"
                                ItemTemplate="{StaticResource QueueItemTemplate}"
                                PathsAdded="InputCard_PathsAdded" />

                            <!--  ============ PLAY ORDER ============  -->
                            <Border Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_MediaViewer_OrderHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.PlaylistPlay}" />
                                    <StackPanel x:Name="ModeTiles" ToolTip="{DynamicResource Str_VideoReplay_ModeTooltip}">
                                        <!--  In order (full width)  -->
                                        <RadioButton
                                            x:Name="RadioOrderSequential"
                                            Margin="0,0,0,3"
                                            HorizontalAlignment="Stretch"
                                            Click="Order_Click"
                                            GroupName="PlayOrder"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="Sequential">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="18"
                                                    Height="18"
                                                    HorizontalAlignment="Center"
                                                    Kind="PlaylistPlay" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    HorizontalAlignment="Center"
                                                    Text="{DynamicResource Str_VideoReplay_ModeSequential}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </RadioButton>

                                        <!--  Shuffle and repeat one (2 columns)  -->
                                        <UniformGrid Columns="2">
                                            <RadioButton
                                                x:Name="RadioOrderShuffle"
                                                Margin="0,3,1.5,0"
                                                Click="Order_Click"
                                                GroupName="PlayOrder"
                                                Style="{StaticResource ModeToggleTallStyle}"
                                                Tag="Shuffle">
                                                <StackPanel>
                                                    <materialDesign:PackIcon
                                                        Width="18"
                                                        Height="18"
                                                        HorizontalAlignment="Center"
                                                        Kind="ShuffleVariant" />
                                                    <TextBlock
                                                        Margin="0,3,0,0"
                                                        HorizontalAlignment="Center"
                                                        Text="{DynamicResource Str_VideoReplay_ModeShuffle}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </RadioButton>
                                            <RadioButton
                                                x:Name="RadioOrderRepeatOne"
                                                Margin="1.5,3,0,0"
                                                Click="Order_Click"
                                                GroupName="PlayOrder"
                                                Style="{StaticResource ModeToggleTallStyle}"
                                                Tag="RepeatOne">
                                                <StackPanel>
                                                    <materialDesign:PackIcon
                                                        Width="18"
                                                        Height="18"
                                                        HorizontalAlignment="Center"
                                                        Kind="RepeatOnce" />
                                                    <TextBlock
                                                        Margin="0,3,0,0"
                                                        HorizontalAlignment="Center"
                                                        Text="{DynamicResource Str_VideoReplay_ModeLoop}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </RadioButton>
                                        </UniformGrid>
                                    </StackPanel>
                                    <TextBlock
                                        x:Name="TxtOrderHint"
                                        Margin="2,10,0,10"
                                        FontSize="11"
                                        Foreground="{DynamicResource SidebarTextMuted}"
                                        TextWrapping="Wrap" />
                                    <CheckBox
                                        x:Name="ChkRepeatPlaylist"
                                        Checked="Repeat_Changed"
                                        Content="{DynamicResource Str_VideoReplay_RepeatThePlaylist}"
                                        Foreground="{DynamicResource SidebarText}"
                                        ToolTip="{DynamicResource Str_VideoReplay_StartAgainFromThe}"
                                        Unchecked="Repeat_Changed" />
                                </StackPanel>
                            </Border>

                            <!--  ============ SLIDESHOW ============  -->
                            <Border Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_MediaViewer_SlideshowHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.PresentationPlay}" />
                                    <TextBlock
                                        Margin="0,4,0,6"
                                        Style="{StaticResource FieldLabel}"
                                        Text="{DynamicResource Str_MediaViewer_SlideshowLabel}" />
                                    <UniformGrid x:Name="SlideTiles" Columns="4">
                                        <RadioButton
                                            x:Name="RadioSlide2"
                                            Margin="0,0,2,0"
                                            Click="Slide_Click"
                                            Content="2 s"
                                            GroupName="SlideshowSpeed"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="2" />
                                        <RadioButton
                                            x:Name="RadioSlide4"
                                            Margin="2,0"
                                            Click="Slide_Click"
                                            Content="4 s"
                                            GroupName="SlideshowSpeed"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="4" />
                                        <RadioButton
                                            x:Name="RadioSlide7"
                                            Margin="2,0"
                                            Click="Slide_Click"
                                            Content="7 s"
                                            GroupName="SlideshowSpeed"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="7" />
                                        <RadioButton
                                            x:Name="RadioSlide10"
                                            Margin="2,0,0,0"
                                            Click="Slide_Click"
                                            Content="10 s"
                                            GroupName="SlideshowSpeed"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="10" />
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!--  ============ KEYBOARD ============  -->
                            <Border Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_MediaViewer_KeyboardHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.KeyboardOutline}" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{DynamicResource SidebarTextMuted}"
                                        LineHeight="18"
                                        TextWrapping="Wrap">
                                        <Run
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource SidebarText}"
                                            Text="{DynamicResource Str_MediaViewer_Key_Space}" />
                                        <Run Text="{DynamicResource Str_MediaViewer_Kbd_PlayPause}" /><LineBreak />
                                        <Run
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource SidebarText}"
                                            Text="← →" />
                                        <Run Text="{DynamicResource Str_MediaViewer_Kbd_Seek}" /><LineBreak />
                                        <Run
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource SidebarText}"
                                            Text="N P  PgUp PgDn" />
                                        <Run Text="{DynamicResource Str_MediaViewer_Kbd_Item}" /><LineBreak />
                                        <Run
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource SidebarText}"
                                            Text="W" />
                                        <Run Text="{DynamicResource Str_MediaViewer_Kbd_Widget}" /><LineBreak />
                                        <Run
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource SidebarText}"
                                            Text="S" />
                                        <Run Text="{DynamicResource Str_MediaViewer_Kbd_Speed}" /><LineBreak />
                                        <Run
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource SidebarText}"
                                            Text="T" />
                                        <Run Text="{DynamicResource Str_MediaViewer_Kbd_Theater}" /><LineBreak />
                                        <Run
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource SidebarText}"
                                            Text="R" />
                                        <Run Text="{DynamicResource Str_MediaViewer_Kbd_Rotate}" /><LineBreak />
                                        <Run
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource SidebarText}"
                                            Text="↑ ↓" />
                                        <Run Text="{DynamicResource Str_MediaViewer_Kbd_Volume}" /><LineBreak />
                                        <Run
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource SidebarText}"
                                            Text="M" />
                                        <Run Text="{DynamicResource Str_MediaViewer_Kbd_Mute}" /><LineBreak />
                                        <Run
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource SidebarText}"
                                            Text="{DynamicResource Str_MediaViewer_Key_Delete}" />
                                        <Run Text="{DynamicResource Str_MediaViewer_Kbd_Remove}" /><LineBreak />
                                        <Run
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource SidebarText}"
                                            Text="{DynamicResource Str_MediaViewer_Key_ShiftDelete}" />
                                        <Run Text="{DynamicResource Str_MediaViewer_Kbd_DeleteFile}" />
                                    </TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--  ================= PLAYER + PLAYLIST =================  -->

            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="PlaylistColumn" Width="380" />
                </Grid.ColumnDefinitions>

                <!--  Player card  -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <Grid x:Name="PlayerCardGrid">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  Shown instead of the stage while the player is out in the mini window  -->
                        <Border
                            x:Name="StagePlaceholder"
                            Grid.Row="0"
                            Background="{DynamicResource RowBg}"
                            CornerRadius="12"
                            Visibility="Collapsed">
                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                <materialDesign:PackIcon
                                    Width="44"
                                    Height="44"
                                    HorizontalAlignment="Center"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Kind="PictureInPictureBottomRight" />
                                <TextBlock
                                    MaxWidth="320"
                                    Margin="0,12,0,14"
                                    HorizontalAlignment="Center"
                                    FontSize="13"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{DynamicResource Str_MediaViewer_Widget_Placeholder}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                                <Button
                                    HorizontalAlignment="Center"
                                    Click="BtnBringBack_Click"
                                    Style="{StaticResource ListToolButtonStyle}"
                                    Width="Auto">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="16"
                                            Height="16"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Kind="WindowRestore" />
                                        <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_MediaViewer_Widget_BringBack}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                        </Border>

                        <!--  Fixed-dark stage: picture / video / music + player chrome  -->
                        <Border
                            x:Name="Stage"
                            Background="#0E0F12"
                            ClipToBounds="True"
                            CornerRadius="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <Grid x:Name="StageContent" Grid.Row="0">
                                    <ScrollViewer
                                        x:Name="ImageScroll"
                                        Margin="6,6,6,0"
                                        Focusable="False"
                                        HorizontalScrollBarVisibility="Disabled"
                                        PreviewMouseWheel="ImageScroll_PreviewMouseWheel"
                                        SizeChanged="ImageScroll_SizeChanged"
                                        VerticalScrollBarVisibility="Disabled"
                                        Visibility="Collapsed">
                                        <Image
                                            x:Name="ImageView"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            MouseLeftButtonDown="ImageView_MouseLeftButtonDown"
                                            MouseLeftButtonUp="ImageView_MouseLeftButtonUp"
                                            MouseMove="ImageView_MouseMove"
                                            RenderOptions.BitmapScalingMode="HighQuality"
                                            Stretch="Uniform">
                                            <Image.LayoutTransform>
                                                <RotateTransform x:Name="ImageRotate" Angle="0" />
                                            </Image.LayoutTransform>
                                        </Image>
                                    </ScrollViewer>

                                    <MediaElement
                                        x:Name="Player"
                                        LoadedBehavior="Manual"
                                        MediaEnded="Player_MediaEnded"
                                        MediaFailed="Player_MediaFailed"
                                        MediaOpened="Player_MediaOpened"
                                        MouseLeftButtonUp="Player_MouseLeftButtonUp"
                                        Stretch="Uniform"
                                        UnloadedBehavior="Manual"
                                        Visibility="Collapsed" />

                                    <!--  Music: no picture, so show the cover placeholder  -->
                                    <StackPanel
                                        x:Name="AudioPanel"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False"
                                        Visibility="Collapsed">
                                        <Border
                                            Width="96"
                                            Height="96"
                                            HorizontalAlignment="Center"
                                            Background="#1AFFFFFF"
                                            CornerRadius="48">
                                            <materialDesign:PackIcon
                                                Width="44"
                                                Height="44"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Foreground="#C9CDD4"
                                                Kind="MusicNote" />
                                        </Border>
                                        <TextBlock
                                            x:Name="TxtAudioName"
                                            MaxWidth="420"
                                            Margin="0,16,0,0"
                                            HorizontalAlignment="Center"
                                            FontSize="15"
                                            Foreground="#E9EBEF"
                                            TextAlignment="Center"
                                            TextTrimming="CharacterEllipsis" />
                                    </StackPanel>

                                    <!--  Nothing on screen  -->
                                    <StackPanel
                                        x:Name="EmptyPanel"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False">
                                        <Border
                                            Width="64"
                                            Height="64"
                                            HorizontalAlignment="Center"
                                            Background="#1AFFFFFF"
                                            CornerRadius="32">
                                            <materialDesign:PackIcon
                                                Width="30"
                                                Height="30"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Foreground="#C9CDD4"
                                                Kind="PlayBoxMultipleOutline" />
                                        </Border>
                                        <TextBlock
                                            MaxWidth="340"
                                            Margin="0,12,0,0"
                                            HorizontalAlignment="Center"
                                            FontSize="13"
                                            Foreground="#C9CDD4"
                                            Text="{DynamicResource Str_MediaViewer_StageHint}"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!--  Couldn't open / play this one  -->
                                    <Border
                                        x:Name="ErrorBanner"
                                        MaxWidth="460"
                                        Margin="16"
                                        Padding="14,10"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource StatusErrorBg}"
                                        CornerRadius="10"
                                        Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon
                                                Width="18"
                                                Height="18"
                                                Margin="0,1,10,0"
                                                VerticalAlignment="Top"
                                                Foreground="{DynamicResource StatusErrorFg}"
                                                Kind="AlertCircleOutline" />
                                            <TextBlock
                                                x:Name="TxtError"
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{DynamicResource StatusErrorFg}"
                                                TextWrapping="Wrap" />
                                            <Button
                                                Grid.Column="2"
                                                Width="24"
                                                Height="24"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Top"
                                                Click="BtnDismissError_Click"
                                                Style="{StaticResource IconButtonStyle}"
                                                ToolTip="{DynamicResource Str_MediaViewer_Dismiss}">
                                                <materialDesign:PackIcon
                                                    Width="13"
                                                    Height="13"
                                                    Foreground="{DynamicResource StatusErrorFg}"
                                                    Kind="Close" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </Grid>

                                <!--  Player chrome  -->
                                <!--  In the mini window the controls float over the picture; this darkens the strip behind them  -->
                                <Border
                                    x:Name="ChromeScrim"
                                    Grid.Row="1"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                            <GradientStop Offset="0" Color="#000E0F12" />
                                            <GradientStop Offset="0.45" Color="#CC0E0F12" />
                                            <GradientStop Offset="1" Color="#E60E0F12" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <StackPanel
                                    x:Name="StageChrome"
                                    Grid.Row="1"
                                    Margin="14,6,14,12">
                                    <Grid x:Name="SeekRow" Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="52" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="52" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            x:Name="TxtPosition"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="#C9CDD4"
                                            Text="0:00" />
                                        <Slider
                                            x:Name="PosSlider"
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Maximum="1"
                                            Minimum="0"
                                            Style="{StaticResource PlayerSliderStyle}"
                                            ValueChanged="PosSlider_ValueChanged" />
                                        <TextBlock
                                            x:Name="TxtDuration"
                                            Grid.Column="2"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="#C9CDD4"
                                            Text="0:00"
                                            TextAlignment="Right" />
                                    </Grid>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel
                                            Grid.Column="0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                            <Button
                                                x:Name="BtnMute"
                                                Click="BtnMute_Click"
                                                Style="{StaticResource PlayerIconButtonStyle}"
                                                ToolTip="{DynamicResource Str_MediaViewer_Mute}">
                                                <materialDesign:PackIcon x:Name="MuteIcon" Kind="VolumeHigh" />
                                            </Button>
                                            <Slider
                                                x:Name="VolumeSlider"
                                                Width="90"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                Maximum="1"
                                                Minimum="0"
                                                Style="{StaticResource PlayerSliderStyle}"
                                                ValueChanged="VolumeSlider_ValueChanged"
                                                Value="0.8" />
                                        </StackPanel>

                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                            <Button
                                                x:Name="BtnPrev"
                                                Click="BtnPrev_Click"
                                                Style="{StaticResource PlayerIconButtonStyle}"
                                                ToolTip="{DynamicResource Str_MediaViewer_Previous}">
                                                <materialDesign:PackIcon Kind="SkipPrevious" />
                                            </Button>
                                            <Button
                                                x:Name="BtnSkipBack"
                                                Margin="8,0,0,0"
                                                Click="BtnSkipBack_Click"
                                                Style="{StaticResource PlayerIconButtonStyle}"
                                                ToolTip="{DynamicResource Str_MediaViewer_SkipBack}">
                                                <materialDesign:PackIcon Kind="Rewind_10" />
                                            </Button>
                                            <Button
                                                x:Name="BtnPlay"
                                                Margin="8,0"
                                                Click="BtnPlay_Click"
                                                Style="{StaticResource PlayerPrimaryButtonStyle}"
                                                ToolTip="{DynamicResource Str_MediaViewer_PlayPause}">
                                                <materialDesign:PackIcon
                                                    x:Name="PlayIcon"
                                                    Width="26"
                                                    Height="26"
                                                    Kind="Play" />
                                            </Button>
                                            <Button
                                                x:Name="BtnSkipForward"
                                                Margin="0,0,8,0"
                                                Click="BtnSkipForward_Click"
                                                Style="{StaticResource PlayerIconButtonStyle}"
                                                ToolTip="{DynamicResource Str_MediaViewer_SkipForward}">
                                                <materialDesign:PackIcon Kind="FastForward_10" />
                                            </Button>
                                            <Button
                                                x:Name="BtnNext"
                                                Click="BtnNext_Click"
                                                Style="{StaticResource PlayerIconButtonStyle}"
                                                ToolTip="{DynamicResource Str_MediaViewer_Next}">
                                                <materialDesign:PackIcon Kind="SkipNext" />
                                            </Button>
                                        </StackPanel>

                                        <StackPanel
                                            Grid.Column="2"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Orientation="Horizontal">
                                            <Button
                                                x:Name="BtnSpeed"
                                                Margin="0,0,8,0"
                                                Click="BtnSpeed_Click"
                                                Content="1x"
                                                Foreground="#E9EBEF"
                                                MouseRightButtonUp="BtnSpeed_MouseRightButtonUp"
                                                Style="{StaticResource PlayerPillButtonStyle}"
                                                ToolTip="{DynamicResource Str_VideoReplay_SpeedClickForFaster}" />
                                            <Button
                                                x:Name="BtnRotateLeft"
                                                Margin="0,0,6,0"
                                                Click="BtnRotateLeft_Click"
                                                Style="{StaticResource PlayerIconButtonStyle}"
                                                ToolTip="{DynamicResource Str_MediaViewer_RotateLeft}">
                                                <materialDesign:PackIcon Kind="RotateLeft" />
                                            </Button>
                                            <Button
                                                x:Name="BtnRotateRight"
                                                Margin="0,0,6,0"
                                                Click="BtnRotateRight_Click"
                                                Style="{StaticResource PlayerIconButtonStyle}"
                                                ToolTip="{DynamicResource Str_MediaViewer_RotateRight}">
                                                <materialDesign:PackIcon Kind="RotateRight" />
                                            </Button>
                                            <Button
                                                x:Name="BtnFit"
                                                Margin="0,0,6,0"
                                                Click="BtnFit_Click"
                                                Style="{StaticResource PlayerIconButtonStyle}"
                                                ToolTip="{DynamicResource Str_MediaViewer_Fit}">
                                                <materialDesign:PackIcon Kind="ArrowExpandAll" />
                                            </Button>
                                            <Button
                                                x:Name="BtnWidget"
                                                Margin="0,0,6,0"
                                                Click="BtnWidget_Click"
                                                Style="{StaticResource PlayerIconButtonStyle}"
                                                ToolTip="{DynamicResource Str_MediaViewer_Widget_Tooltip}">
                                                <materialDesign:PackIcon x:Name="WidgetIcon" Kind="PictureInPictureBottomRight" />
                                            </Button>
                                            <Button
                                                x:Name="BtnTheater"
                                                Click="BtnTheater_Click"
                                                Style="{StaticResource PlayerIconButtonStyle}"
                                                ToolTip="{DynamicResource Str_MediaViewer_Theater}">
                                                <materialDesign:PackIcon x:Name="IconTheater" Kind="ArrowExpand" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!--  Caption: what's on the stage  -->
                        <Grid Grid.Row="1" Margin="2,10,2,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock
                                    x:Name="TxtNowPlaying"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimary}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="TxtInfo"
                                    Margin="0,2,0,0"
                                    FontSize="11.5"
                                    Foreground="{DynamicResource TextSecondary}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Border
                                x:Name="PillPosition"
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                Background="{DynamicResource StatusInfoBg}"
                                Style="{StaticResource IconStatusPillStyle}"
                                Visibility="Collapsed">
                                <TextBlock
                                    x:Name="TxtPositionPill"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource StatusInfoFg}" />
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!--  Playlist collapse strip  -->
                <Button
                    x:Name="BtnTogglePlaylist"
                    Grid.Column="1"
                    Width="26"
                    Margin="6,0"
                    Click="BtnTogglePlaylist_Click"
                    Style="{StaticResource PanelToggleButtonStyle}"
                    ToolTip="{DynamicResource Str_MediaViewer_TogglePlaylist}">
                    <materialDesign:PackIcon
                        x:Name="IconTogglePlaylist"
                        Width="20"
                        Height="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Kind="ChevronRight" />
                </Button>

                <!--  Playlist  -->
                <Border
                    x:Name="PlaylistPanel"
                    Grid.Column="2"
                    Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentControl
                                VerticalAlignment="Center"
                                Content="{DynamicResource Str_MediaViewer_Playlist}"
                                Style="{StaticResource CardHeader}"
                                Tag="{x:Static materialDesign:PackIconKind.PlaylistPlay}" />
                            <Border
                                x:Name="SummaryPill"
                                Grid.Column="1"
                                Background="{DynamicResource StatusInfoBg}"
                                Style="{StaticResource IconStatusPillStyle}"
                                Visibility="Collapsed">
                                <TextBlock
                                    x:Name="TxtCount"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource StatusInfoFg}" />
                            </Border>
                        </Grid>

                        <StackPanel
                            x:Name="ListTools"
                            Grid.Row="1"
                            Margin="0,0,0,10"
                            Orientation="Horizontal">
                            <Button
                                x:Name="BtnMoveUp"
                                Width="32"
                                Height="32"
                                Click="BtnMoveUp_Click"
                                Style="{StaticResource NeutralIconButtonStyle}"
                                ToolTip="{DynamicResource Str_MediaViewer_MoveEarlier}">
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    Kind="ArrowUp" />
                            </Button>
                            <Button
                                x:Name="BtnMoveDown"
                                Width="32"
                                Height="32"
                                Margin="4,0,0,0"
                                Click="BtnMoveDown_Click"
                                Style="{StaticResource NeutralIconButtonStyle}"
                                ToolTip="{DynamicResource Str_MediaViewer_MoveLater}">
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    Kind="ArrowDown" />
                            </Button>
                            <Button
                                x:Name="BtnSortByName"
                                Width="32"
                                Height="32"
                                Margin="10,0,0,0"
                                Click="BtnSortByName_Click"
                                Style="{StaticResource NeutralIconButtonStyle}"
                                ToolTip="{DynamicResource Str_MediaViewer_SortByName}">
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    Kind="SortAlphabeticalAscending" />
                            </Button>
                            <Button
                                x:Name="BtnSortByDate"
                                Width="32"
                                Height="32"
                                Margin="4,0,0,0"
                                Click="BtnSortByDate_Click"
                                Style="{StaticResource NeutralIconButtonStyle}"
                                ToolTip="{DynamicResource Str_MediaViewer_SortByDate}">
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    Kind="SortCalendarAscending" />
                            </Button>
                        </StackPanel>

                        <DataGrid
                            x:Name="DataGridQueue"
                            Grid.Row="2"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            CanUserSortColumns="False"
                            FontSize="12"
                            IsReadOnly="True"
                            MinRowHeight="46"
                            MouseDoubleClick="DataGridQueue_MouseDoubleClick"
                            PreviewKeyDown="DataGridQueue_PreviewKeyDown"
                            PreviewMouseRightButtonDown="DataGridQueue_PreviewMouseRightButtonDown"
                            RowStyle="{StaticResource PlaylistRowStyle}"
                            SelectionMode="Extended"
                            ToolTip="{DynamicResource Str_MediaViewer_PlaylistTooltip}"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.ScrollUnit="Pixel"
                            VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Click="MenuPlay_Click">
                                        <MenuItem.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="15"
                                                    Height="15"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Kind="PlayCircleOutline" />
                                                <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_MediaViewer_MenuPlay}" />
                                            </StackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem Click="MenuShowInFolder_Click">
                                        <MenuItem.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="15"
                                                    Height="15"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Kind="FolderOpenOutline" />
                                                <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_MediaViewer_MenuShowInFolder}" />
                                            </StackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem Click="MenuRemove_Click">
                                        <MenuItem.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="15"
                                                    Height="15"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Kind="PlaylistRemove" />
                                                <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_MediaViewer_RemoveFromList}" />
                                            </StackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem Click="MenuDeleteFile_Click">
                                        <MenuItem.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="15"
                                                    Height="15"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Kind="DeleteOutline" />
                                                <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_MediaViewer_MenuDeleteFile}" />
                                            </StackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn
                                    Width="46"
                                    CellStyle="{StaticResource CompactCellStyle}"
                                    CellTemplate="{StaticResource KindCellTemplate}" />
                                <DataGridTemplateColumn
                                    Width="*"
                                    MinWidth="70"
                                    CellTemplate="{StaticResource NameCellTemplate}"
                                    Header="{DynamicResource Str_Common_ColHeaderName}" />
                                <DataGridTemplateColumn Width="38" CellStyle="{StaticResource CompactCellStyle}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button
                                                Width="24"
                                                Height="24"
                                                HorizontalAlignment="Center"
                                                Click="BtnRemoveFromList_Click"
                                                Style="{StaticResource IconButtonStyle}"
                                                ToolTip="{DynamicResource Str_MediaViewer_RemoveFromList}">
                                                <materialDesign:PackIcon
                                                    Width="13"
                                                    Height="13"
                                                    Foreground="{DynamicResource StatusErrorFg}"
                                                    Kind="Close" />
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <controls:EmptyStateCard
                            x:Name="EmptyStatePanel"
                            Grid.Row="2"
                            Description="{DynamicResource Str_MediaViewer_EmptyDescription}"
                            DescriptionMaxWidth="260"
                            Icon="PlayBoxMultipleOutline"
                            IsHitTestVisible="False" />

                        <!--  ============ PLAYLIST ACTIONS ============  -->
                        <Grid Grid.Row="3" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button
                                x:Name="BtnSelectAll"
                                Grid.Column="0"
                                Width="34"
                                Height="34"
                                Click="BtnSelectAll_Click"
                                Style="{StaticResource NeutralIconButtonStyle}"
                                ToolTip="{DynamicResource Str_MediaViewer_SelectAll}">
                                <materialDesign:PackIcon
                                    Width="17"
                                    Height="17"
                                    Kind="CheckboxMultipleMarkedOutline" />
                            </Button>

                            <Button
                                x:Name="BtnRemoveSelected"
                                Grid.Column="2"
                                Margin="0,0,6,0"
                                Click="BtnRemoveSelected_Click"
                                Style="{StaticResource ListToolButtonStyle}"
                                ToolTip="{DynamicResource Str_MediaViewer_RemoveSelected}">
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    Kind="PlaylistRemove" />
                            </Button>

                            <Button
                                x:Name="BtnDeleteFiles"
                                Grid.Column="3"
                                Margin="0,0,6,0"
                                Click="BtnDeleteFiles_Click"
                                Style="{StaticResource ListToolDangerButtonStyle}"
                                ToolTip="{DynamicResource Str_MediaViewer_DeleteFile}">
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    Kind="DeleteOutline" />
                            </Button>

                            <Button
                                x:Name="BtnClearQueue"
                                Grid.Column="4"
                                Click="BtnClear_Click"
                                Style="{StaticResource ListToolDangerButtonStyle}"
                                ToolTip="{DynamicResource Str_MediaViewer_Clear}">
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    Kind="DeleteSweepOutline" />
                            </Button>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
