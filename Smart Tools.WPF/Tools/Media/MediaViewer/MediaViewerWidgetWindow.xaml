<Window
    x:Class="Smart_Tools.WPF.Views.MediaViewerWidgetWindow"
    x:ClassModifier="internal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Title="Media Viewer"
    Width="420"
    Height="300"
    MinWidth="300"
    MinHeight="220"
    AllowsTransparency="True"
    Background="Transparent"
    ResizeMode="CanResizeWithGrip"
    ShowInTaskbar="False"
    Topmost="True"
    UseLayoutRounding="True"
    WindowStartupLocation="Manual"
    WindowStyle="None">

    <!--
        The floating mini player. It is only a frame: the Media Viewer moves its real player
        (the Stage with the picture, video and controls) in here when you press W, and moves
        it back when you close this window. There is no second set of controls to keep in
        sync. Borderless, always on top, not in the taskbar, no Owner (like the Network Speed
        widget). Colours are theme tokens, so a theme switch repaints it.
    -->

    <Border
        x:Name="Card"
        Padding="8,6,8,14"
        Background="{DynamicResource CardBg}"
        BorderBrush="{DynamicResource CardBorder}"
        BorderThickness="1"
        CornerRadius="12"
        MouseEnter="Card_MouseEnter"
        MouseLeave="Card_MouseLeave">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Title strip: drag here to move the window  -->
            <Grid
                x:Name="TitleStrip"
                Grid.Row="0"
                Margin="2,0,0,6"
                Background="Transparent"
                Cursor="SizeAll"
                MouseLeftButtonDown="TitleStrip_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <materialDesign:PackIcon
                    Width="16"
                    Height="16"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextSecondary}"
                    Kind="DragHorizontalVariant" />
                <TextBlock
                    x:Name="TxtTitle"
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimary}"
                    TextTrimming="CharacterEllipsis" />
                <Button
                    x:Name="BtnMinimizeApp"
                    Grid.Column="2"
                    Width="26"
                    Height="26"
                    Margin="8,0,2,0"
                    Click="BtnMinimizeApp_Click"
                    Cursor="Arrow"
                    Style="{StaticResource NeutralIconButtonStyle}">
                    <materialDesign:PackIcon
                        Width="14"
                        Height="14"
                        Kind="WindowMinimize" />
                </Button>
                <Button
                    x:Name="BtnBack"
                    Grid.Column="3"
                    Width="26"
                    Height="26"
                    Margin="0,0,2,0"
                    Click="BtnBack_Click"
                    Cursor="Arrow"
                    Style="{StaticResource NeutralIconButtonStyle}">
                    <materialDesign:PackIcon
                        Width="14"
                        Height="14"
                        Kind="WindowRestore" />
                </Button>
                <Button
                    x:Name="BtnClose"
                    Grid.Column="4"
                    Width="26"
                    Height="26"
                    Click="BtnClose_Click"
                    Cursor="Arrow"
                    Style="{StaticResource NeutralIconButtonStyle}">
                    <materialDesign:PackIcon
                        Width="14"
                        Height="14"
                        Kind="Close" />
                </Button>
            </Grid>

            <!--  The player lands here  -->
            <Border x:Name="StageHost" Grid.Row="1" />
        </Grid>
    </Border>
</Window>
