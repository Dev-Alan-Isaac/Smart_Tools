<UserControl
    x:Class="Smart_Tools.WPF.Views.MediaHubView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    x:Name="Root"
    AllowDrop="True"
    Focusable="True"
    PreviewDragOver="Hub_PreviewDragOver"
    PreviewDrop="Hub_PreviewDrop">

    <!--
        Media Viewer is one tool with four pages: Mixed (pictures, videos and music in one queue), Photos (Image Viewer),
        Videos (the VLC video player) and Music (the audio player with its visualizer). Each page is the full tool it always
        was - this bar only switches between them and sends dropped files to the right one. Only the page shown is in the
        visual tree, which is how every tool behaves when you open another one (playback is released by the page itself).
    -->

    <Grid Background="{DynamicResource ContentBg}">
        <!--
            The tab strip is parked here and handed to the page that is shown: each page puts it at the top of its own content column,
            so the page's sidebar keeps the full height (the same layout as Unit & Currency).
        -->
        <Grid x:Name="StripHome" Visibility="Collapsed">
            <Border x:Name="Strip" Margin="0,0,0,12" Padding="6,6,6,0" ctl:Tour.Key="Str_Tour_MediaHub_Modes" ctl:Tour.Order="0" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <WrapPanel>
                        <RadioButton x:Name="RadioMixed" Checked="Mode_Checked" GroupName="MhMode" Style="{StaticResource UnderlineTabStyle}" Tag="Mixed" ToolTip="{DynamicResource Str_MediaHub_PicturesVideosAndMusic}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="18" Height="18" Margin="0,0,7,0" VerticalAlignment="Center" Kind="ViewDashboardOutline" />
                                <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_MediaHub_Mixed}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="RadioPhotos" Checked="Mode_Checked" GroupName="MhMode" Style="{StaticResource UnderlineTabStyle}" Tag="Photos" ToolTip="{DynamicResource Str_MediaHub_PictureViewerZoomRotate}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="18" Height="18" Margin="0,0,7,0" VerticalAlignment="Center" Kind="ImageMultipleOutline" />
                                <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_MediaHub_Photos}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="RadioVideos" Checked="Mode_Checked" GroupName="MhMode" Style="{StaticResource UnderlineTabStyle}" Tag="Videos" ToolTip="{DynamicResource Str_MediaHub_VideoPlayerForAlmost}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="18" Height="18" Margin="0,0,7,0" VerticalAlignment="Center" Kind="MovieOpenOutline" />
                                <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_DuplicateFinder_Videos}" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="RadioMusic" Checked="Mode_Checked" GroupName="MhMode" Style="{StaticResource UnderlineTabStyle}" Tag="Music" ToolTip="{DynamicResource Str_MediaHub_AudioPlayerWithThe}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="18" Height="18" Margin="0,0,7,0" VerticalAlignment="Center" Kind="MusicNote" />
                                <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_MediaViewer_Audio}" />
                            </StackPanel>
                        </RadioButton>
                    </WrapPanel>

                    <Border
                        Grid.Column="1"
                        Margin="16,0,8,6"
                        Padding="10,4,12,4"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Background="{DynamicResource AccentColorSubtle}"
                        CornerRadius="12">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentColor}" Kind="InformationOutline" />
                            <TextBlock x:Name="TxtHint" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource AccentColor}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <ContentPresenter x:Name="PageHost" />
    </Grid>
</UserControl>
