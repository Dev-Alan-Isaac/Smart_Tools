<UserControl
    x:Class="Smart_Tools.WPF.Views.SystemSnapshotView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    x:Name="Root"
    Loaded="Root_Loaded">

    <!--
        Backend: Tools/System/SystemSnapshot/SystemSnapshotManager*.cs (the scan, one file per group of collectors, the exporters)
        and SystemSnapshotModel.cs. UI only here. The tool only reads the PC; nothing is changed and no secrets are read.
        Laid out like Battery Health: shared sidebar, a top bar with the one big action, stat tiles, then the data.
    -->

    <Grid Background="{DynamicResource ContentBg}">
        <Grid Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= SIDEBAR =================  -->
            <controls:ToolSidebar x:Name="Sidebar">
                <StackPanel>

                    <Border ctl:Tour.Key="Str_Tour_SystemSnapshot_Groups" ctl:Tour.Order="1" Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl
                                Content="{DynamicResource Str_SysSnap_ScanGroups}"
                                Style="{StaticResource SidebarGroupHeader}"
                                Tag="{x:Static materialDesign:PackIconKind.ClipboardListOutline}" />
                            <StackPanel x:Name="PanelGroups" Margin="0,4,0,0" />
                            <Grid Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="6" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button Click="BtnSelectAll_Click" Content="{DynamicResource Str_SysSnap_SelectAll}" />
                                <Button Grid.Column="2" Click="BtnSelectNone_Click" Content="{DynamicResource Str_SysSnap_SelectNone}" />
                            </Grid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl
                                Content="{DynamicResource Str_SysSnap_Options}"
                                Style="{StaticResource SidebarGroupHeader}"
                                Tag="{x:Static materialDesign:PackIconKind.TuneVariant}" />
                            <CheckBox x:Name="ChkMsTasks" Margin="0,4,0,0" Content="{DynamicResource Str_SysSnap_MsTasks}" Foreground="{DynamicResource SidebarText}" />
                            <CheckBox x:Name="ChkBuiltInRules" Margin="0,8,0,0" Content="{DynamicResource Str_SysSnap_BuiltInRules}" Foreground="{DynamicResource SidebarText}" />
                            <TextBlock Style="{StaticResource SidebarHint}" Text="{DynamicResource Str_SysSnap_OptionsHint}" />
                        </StackPanel>
                    </Border>

                    <Border ctl:Tour.Key="Str_Tour_SystemSnapshot_Export" ctl:Tour.Order="4" Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl
                                Content="{DynamicResource Str_SysSnap_Export}"
                                Style="{StaticResource SidebarGroupHeader}"
                                Tag="{x:Static materialDesign:PackIconKind.ExportVariant}" />
                            <Button x:Name="BtnExportHtml" MinHeight="36" Margin="0,10,0,0" Click="BtnExport_Click" IsEnabled="False" Tag="html">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,6,0" Kind="LanguageHtml5" />
                                    <TextBlock Text="{DynamicResource Str_SysSnap_ExportHtml}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnExportJson" MinHeight="36" Margin="0,8,0,0" Click="BtnExport_Click" IsEnabled="False" Tag="json">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,6,0" Kind="CodeJson" />
                                    <TextBlock Text="{DynamicResource Str_SysSnap_ExportJson}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnExportText" MinHeight="36" Margin="0,8,0,0" Click="BtnExport_Click" IsEnabled="False" Tag="txt">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,6,0" Kind="FileDocumentOutline" />
                                    <TextBlock Text="{DynamicResource Str_SysSnap_ExportText}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnExportCsv" MinHeight="36" Margin="0,8,0,0" Click="BtnExport_Click" IsEnabled="False" Tag="csv">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,6,0" Kind="FileDelimitedOutline" />
                                    <TextBlock Text="{DynamicResource Str_SysSnap_ExportCsv}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl
                                Content="{DynamicResource Str_SysSnap_About}"
                                Style="{StaticResource SidebarGroupHeader}"
                                Tag="{x:Static materialDesign:PackIconKind.InformationOutline}" />
                            <TextBlock Margin="2,8,0,0" FontSize="10.5" Foreground="{DynamicResource SidebarTextMuted}" Text="{DynamicResource Str_SysSnap_AboutText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </controls:ToolSidebar>

            <!--  ================= MAIN AREA =================  -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Top bar: the one big action is always top-left, like in every tool  -->
                <Border Margin="0,0,0,14" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button
                                ctl:Tour.Key="Str_Tour_SystemSnapshot_Scan"
                                ctl:Tour.Order="2"
                                x:Name="BtnScan"
                                MinWidth="180"
                                VerticalAlignment="Center"
                                Click="BtnScan_Click"
                                Style="{StaticResource AccentPrimaryButtonStyle}">
                                <Grid HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon x:Name="IconScan" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" Kind="Radar" />
                                    <TextBlock x:Name="TxtScan" Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_SysSnap_Scan}" TextWrapping="Wrap" />
                                </Grid>
                            </Button>

                            <Border
                                x:Name="PillStatus"
                                Grid.Column="1"
                                MaxWidth="560"
                                Margin="16,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{DynamicResource RowBg}"
                                Style="{StaticResource IconStatusPillStyle}"
                                Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        x:Name="IconStatus"
                                        Width="13"
                                        Height="13"
                                        Margin="0,0,5,0"
                                        VerticalAlignment="Center"
                                        Foreground="{Binding Foreground, ElementName=TxtStatus}"
                                        Kind="InformationOutline" />
                                    <TextBlock
                                        x:Name="TxtStatus"
                                        FontSize="11.5"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextSecondary}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>

                            <Border
                                x:Name="BadgeAdmin"
                                Grid.Column="2"
                                Padding="10,5"
                                VerticalAlignment="Center"
                                CornerRadius="9">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon x:Name="IconAdmin" Width="14" Height="14" Margin="0,0,6,0" VerticalAlignment="Center" Kind="ShieldAccountOutline" />
                                    <TextBlock x:Name="TxtAdmin" FontSize="12" FontWeight="SemiBold" />
                                </StackPanel>
                            </Border>
                        </Grid>
                        <ProgressBar x:Name="BarScan" Grid.Row="1" Height="4" Margin="0,12,0,0" Maximum="1" Minimum="0" Visibility="Collapsed" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  Section list  -->
                    <Border ctl:Tour.Key="Str_Tour_SystemSnapshot_Sections" ctl:Tour.Order="3" Padding="10" Style="{StaticResource CardStyle}">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel x:Name="PanelNav" />
                        </ScrollViewer>
                    </Border>

                    <!--  The chosen section  -->
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <Grid>
                            <!--  Nothing scanned yet  -->
                            <StackPanel
                                x:Name="EmptyState"
                                MaxWidth="440"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.ClipboardTextClockOutline}" />
                                <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource Str_SysSnap_EmptyTitle}" />
                                <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource Str_SysSnap_EmptyHint}" TextAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>

                            <!--  Overview: the stat tiles, like Battery Health  -->
                            <ScrollViewer x:Name="PanelOverview" VerticalScrollBarVisibility="Auto" Visibility="Collapsed">
                                <StackPanel>
                                    <TextBlock x:Name="TxtOverviewTitle" Margin="0,0,0,4" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                                    <TextBlock x:Name="TxtOverviewSub" Margin="0,0,0,12" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                                    <ItemsControl x:Name="OverviewTiles">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <UniformGrid Columns="3" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Border MinHeight="78" Margin="0,0,10,10" Padding="14,10" Background="{DynamicResource RowBg}" CornerRadius="12">
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <materialDesign:PackIcon Width="26" Height="26" Margin="0,0,12,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentColor}" Kind="{Binding Icon}" />
                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                            <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                                            <TextBlock Margin="0,3,0,0" FontSize="16" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding Value}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </ScrollViewer>

                            <!--  One section as a table  -->
                            <Grid x:Name="PanelTable" Visibility="Collapsed">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock x:Name="TxtTableTitle" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock x:Name="TxtTableNote" Grid.Row="1" Margin="0,4,0,0" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Visibility="Collapsed" />

                                <Border Grid.Row="2" Margin="0,12,0,12" Padding="10,0,4,0" Style="{StaticResource InputBarStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon Width="18" Height="18" VerticalAlignment="Center" Foreground="{DynamicResource AccentColor}" Kind="Magnify" />
                                        <TextBox
                                            x:Name="TxtFilter"
                                            Grid.Column="1"
                                            Style="{StaticResource BareTextBox}"
                                            Tag="{DynamicResource Str_SysSnap_FilterPlaceholder}"
                                            TextChanged="TxtFilter_TextChanged" />
                                        <TextBlock x:Name="TxtRowCount" Grid.Column="2" Margin="8,0,10,0" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" />
                                    </Grid>
                                </Border>

                                <DataGrid
                                    ctl:Tour.Key="Str_Tour_SystemSnapshot_Grid"
                                    ctl:Tour.Order="5"
                                    x:Name="GridData"
                                    Grid.Row="3"
                                    AutoGenerateColumns="False"
                                    ClipboardCopyMode="IncludeHeader"
                                    HorizontalScrollBarVisibility="Auto"
                                    IsReadOnly="True"
                                    SelectionUnit="FullRow"
                                    VerticalScrollBarVisibility="Auto" />
                            </Grid>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
