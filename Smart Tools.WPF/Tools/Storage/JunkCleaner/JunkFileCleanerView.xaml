<UserControl
    x:Class="Smart_Tools.WPF.Views.JunkFileCleanerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:models="clr-namespace:Smart_Tools.WPF.Models"
    x:Name="Root"
    Loaded="Root_Loaded"
    SizeChanged="Root_SizeChanged">

    <!--
        Backend: Controllers/JunkCleanerManager.cs (where to look, scanning
        without following folder links, settings) and
        JunkCleanerManager.Clean.cs (deleting off the UI thread, the Recycle
        Bin, in use / needs admin / changed); Models/JunkCleanerModel.cs.
        This file and the code-behind are UI only. Results: one row per place
        (each browser is its own row) on the left; the files of the chosen row
        in a virtualised list on the right (the old view drew every file of
        every category at once and froze on a big temp folder).
    -->

    <UserControl.Resources>

        <!--  Icon tile per category (results list)  -->
        <DataTemplate x:Key="CategoryIconTemplate" DataType="{x:Type models:JunkGroup}">
            <Border
                Width="34"
                Height="34"
                Background="{DynamicResource AccentColorSubtle}"
                CornerRadius="9">
                <materialDesign:PackIcon
                    x:Name="Icon"
                    Width="18"
                    Height="18"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource AccentColor}"
                    Kind="FileClockOutline" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Category}" Value="BrowserCache">
                    <Setter TargetName="Icon" Property="Kind" Value="Web" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Category}" Value="ThumbnailCache">
                    <Setter TargetName="Icon" Property="Kind" Value="ImageMultipleOutline" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Category}" Value="RecycleBin">
                    <Setter TargetName="Icon" Property="Kind" Value="TrashCanOutline" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Category}" Value="WindowsUpdateCache">
                    <Setter TargetName="Icon" Property="Kind" Value="Update" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Category}" Value="LogFiles">
                    <Setter TargetName="Icon" Property="Kind" Value="TextBoxOutline" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Category}" Value="ErrorReports">
                    <Setter TargetName="Icon" Property="Kind" Value="BugOutline" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  Files list: status chip (the reason is in the tooltip)  -->
        <DataTemplate x:Key="StatusCellTemplate" DataType="{x:Type models:JunkFile}">
            <Border
                x:Name="Chip"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="{DynamicResource RowBg}"
                Style="{StaticResource IconStatusPillStyle}"
                ToolTip="{Binding Message}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon
                        x:Name="ChipIcon"
                        Width="12"
                        Height="12"
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextSecondary}"
                        Kind="DeleteSweepOutline" />
                    <TextBlock
                        x:Name="ChipText"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextSecondary}"
                        Text="{Binding StatusText}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="InUse">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusWarningBg}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="LockOutline" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Changed">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusInfoBg}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="FileSyncOutline" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource StatusInfoFg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusInfoFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="NeedsAdmin">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusWarningBg}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="ShieldKeyOutline" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusErrorBg}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="AlertCircleOutline" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  Files list: path inside the folder (full path in the tooltip)  -->
        <DataTemplate x:Key="FileCellTemplate" DataType="{x:Type models:JunkFile}">
            <StackPanel VerticalAlignment="Center" ToolTip="{Binding FullPath}">
                <TextBlock
                    Foreground="{DynamicResource TextPrimary}"
                    Text="{Binding RelativePath}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Margin="0,1,0,0"
                    FontSize="11"
                    Foreground="{DynamicResource TextSecondary}"
                    Text="{Binding Root}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">

        <!--  No page header: MainWindow's header card shows the tool's icon and name.  -->

        <Grid Margin="16,8,16,16">

            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OptionsColumn" Width="280" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= OPTIONS SIDEBAR =================  -->

            <Border Grid.Column="0" Style="{StaticResource SidebarPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Button
                            x:Name="BtnCollapseOptions"
                            MinHeight="45"
                            HorizontalContentAlignment="Left"
                            Click="BtnCollapseOptions_Click"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Foreground="{DynamicResource SidebarText}"
                            ToolTip="{DynamicResource Str_Common_SidebarToggleTooltip}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="OverridesDefaultStyle" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Margin="16,0,0,0" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Kind="TuneVariant" />
                                <TextBlock
                                    x:Name="TxtOptionsHeaderLabel"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{DynamicResource Str_Common_OptionsLabel}" />
                            </StackPanel>
                        </Button>
                        <Separator
                            x:Name="SepHeader"
                            Margin="16,4"
                            Style="{StaticResource SidebarSeparatorStyle}" />
                    </StackPanel>

                    <ScrollViewer
                        x:Name="OptionsScrollViewer"
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16,4,16,16">

                            <!--  ============ WHAT TO CLEAN ============  -->
                            <Border ctl:Tour.Key="Str_Tour_JunkCleaner_Categories" ctl:Tour.Order="1" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ContentControl
                                            Content="{DynamicResource Str_Junk_CategoriesHeader}"
                                            Style="{StaticResource SidebarGroupHeader}"
                                            Tag="{x:Static materialDesign:PackIconKind.Broom}" />
                                        <Button
                                            x:Name="BtnSelectAllCategories"
                                            Grid.Column="1"
                                            MinHeight="26"
                                            Margin="0,0,0,8"
                                            VerticalAlignment="Center"
                                            Click="BtnSelectAllCategories_Click"
                                            Style="{StaticResource NeutralIconButtonStyle}"
                                            ToolTip="{DynamicResource Str_Junk_SelectAllCategoriesTooltip}">
                                            <TextBlock
                                                x:Name="TxtSelectAllCategories"
                                                Margin="8,0"
                                                FontSize="11"
                                                Text="{DynamicResource Str_DiskSpaceAnalyzer_All}" />
                                        </Button>
                                    </Grid>

                                    <CheckBox
                                        x:Name="ChkWindowsTemp"
                                        Margin="0,0,0,10"
                                        VerticalContentAlignment="Center"
                                        Click="Category_Click"
                                        Foreground="{DynamicResource SidebarText}"
                                        Tag="WindowsTemp"
                                        ToolTip="{DynamicResource Str_Junk_WindowsTempTooltip}">
                                        <StackPanel Margin="4,0,0,0">
                                            <TextBlock
                                                FontSize="12.5"
                                                FontWeight="SemiBold"
                                                Text="{DynamicResource Str_JunkFileCleaner_TemporaryFiles}" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{DynamicResource SidebarTextMuted}"
                                                Text="{DynamicResource Str_JunkFileCleaner_TempAndWindowsTemp}" />
                                        </StackPanel>
                                    </CheckBox>
                                    <CheckBox
                                        x:Name="ChkBrowserCache"
                                        Margin="0,0,0,10"
                                        VerticalContentAlignment="Center"
                                        Click="Category_Click"
                                        Foreground="{DynamicResource SidebarText}"
                                        Tag="BrowserCache"
                                        ToolTip="{DynamicResource Str_JunkFileCleaner_CacheOfEveryInstalled}">
                                        <StackPanel Margin="4,0,0,0">
                                            <TextBlock
                                                FontSize="12.5"
                                                FontWeight="SemiBold"
                                                Text="{DynamicResource Str_JunkFileCleaner_BrowserCaches}" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{DynamicResource SidebarTextMuted}"
                                                Text="{DynamicResource Str_JunkFileCleaner_ChromeEdgeFirefoxOpera}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </CheckBox>
                                    <CheckBox
                                        x:Name="ChkThumbnailCache"
                                        Margin="0,0,0,10"
                                        VerticalContentAlignment="Center"
                                        Click="Category_Click"
                                        Foreground="{DynamicResource SidebarText}"
                                        Tag="ThumbnailCache"
                                        ToolTip="{DynamicResource Str_Junk_ThumbnailCacheTooltip}">
                                        <StackPanel Margin="4,0,0,0">
                                            <TextBlock
                                                FontSize="12.5"
                                                FontWeight="SemiBold"
                                                Text="{DynamicResource Str_Junk_ThumbnailCacheLabel}" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{DynamicResource SidebarTextMuted}"
                                                Text="{DynamicResource Str_JunkFileCleaner_ExplorerRebuildsItAs}" />
                                        </StackPanel>
                                    </CheckBox>
                                    <CheckBox
                                        x:Name="ChkErrorReports"
                                        Margin="0,0,0,10"
                                        VerticalContentAlignment="Center"
                                        Click="Category_Click"
                                        Foreground="{DynamicResource SidebarText}"
                                        Tag="ErrorReports"
                                        ToolTip="{DynamicResource Str_JunkFileCleaner_CrashDumpsAndWindows}">
                                        <StackPanel Margin="4,0,0,0">
                                            <TextBlock
                                                FontSize="12.5"
                                                FontWeight="SemiBold"
                                                Text="{DynamicResource Str_JunkFileCleaner_CrashDumpsAmpError}" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{DynamicResource SidebarTextMuted}"
                                                Text="{DynamicResource Str_JunkFileCleaner_LeftBehindWhenPrograms}" />
                                        </StackPanel>
                                    </CheckBox>
                                    <CheckBox
                                        x:Name="ChkRecycleBin"
                                        Margin="0,0,0,10"
                                        VerticalContentAlignment="Center"
                                        Click="Category_Click"
                                        Foreground="{DynamicResource SidebarText}"
                                        Tag="RecycleBin"
                                        ToolTip="{DynamicResource Str_Junk_RecycleBinTooltip}">
                                        <StackPanel Margin="4,0,0,0">
                                            <TextBlock
                                                FontSize="12.5"
                                                FontWeight="SemiBold"
                                                Text="{DynamicResource Str_Junk_RecycleBinLabel}" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{DynamicResource SidebarTextMuted}"
                                                Text="{DynamicResource Str_JunkFileCleaner_EveryDriveCanT}" />
                                        </StackPanel>
                                    </CheckBox>
                                    <CheckBox
                                        x:Name="ChkWindowsUpdateCache"
                                        Margin="0,0,0,10"
                                        VerticalContentAlignment="Center"
                                        Click="Category_Click"
                                        Foreground="{DynamicResource SidebarText}"
                                        Tag="WindowsUpdateCache"
                                        ToolTip="{DynamicResource Str_Junk_UpdateCacheTooltip}">
                                        <StackPanel Margin="4,0,0,0">
                                            <TextBlock
                                                FontSize="12.5"
                                                FontWeight="SemiBold"
                                                Text="{DynamicResource Str_JunkFileCleaner_WindowsUpdateDownloads}" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{DynamicResource SidebarTextMuted}"
                                                Text="{DynamicResource Str_JunkFileCleaner_NeedsAdministratorRights}" />
                                        </StackPanel>
                                    </CheckBox>
                                    <CheckBox
                                        x:Name="ChkLogFiles"
                                        VerticalContentAlignment="Center"
                                        Click="Category_Click"
                                        Foreground="{DynamicResource SidebarText}"
                                        Tag="LogFiles"
                                        ToolTip="{DynamicResource Str_Junk_LogFilesTooltip}">
                                        <StackPanel Margin="4,0,0,0">
                                            <TextBlock
                                                FontSize="12.5"
                                                FontWeight="SemiBold"
                                                Text="{DynamicResource Str_JunkFileCleaner_OldWindowsLogs}" />
                                            <TextBlock
                                                FontSize="11"
                                                Foreground="{DynamicResource SidebarTextMuted}"
                                                Text="{DynamicResource Str_JunkFileCleaner_LogFilesOverA}" />
                                        </StackPanel>
                                    </CheckBox>
                                </StackPanel>
                            </Border>

                            <!--  ============ SAFETY ============  -->
                            <Border ctl:Tour.Key="Str_Tour_JunkCleaner_Safety" ctl:Tour.Order="2" Margin="0,0,0,4" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_JunkFileCleaner_Safety}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.ShieldCheckOutline}" />
                                    <CheckBox
                                        x:Name="ChkSkipRecent"
                                        Checked="Option_Changed"
                                        Content="{DynamicResource Str_JunkFileCleaner_LeaveFilesChangedIn}"
                                        Foreground="{DynamicResource SidebarText}"
                                        IsChecked="True"
                                        ToolTip="{DynamicResource Str_JunkFileCleaner_ProgramsThatAreRunning}"
                                        Unchecked="Option_Changed" />
                                    <TextBlock
                                        Margin="2,8,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource SidebarTextMuted}"
                                        Text="{DynamicResource Str_JunkFileCleaner_NothingIsDeletedUntil}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!--  Kept (empty) for existing code that references it  -->
                    <StackPanel x:Name="OptionsBottomPanel" Grid.Row="2" />
                </Grid>
            </Border>

            <!--  ================= MAIN AREA =================  -->

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Run bar  -->
                <Border
                    Grid.Row="0"
                    Margin="0,0,0,14"
                    Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button
                            x:Name="BtnScanForJunk"
                            ctl:Tour.Key="Str_Tour_JunkCleaner_Scan"
                            ctl:Tour.Order="3"
                            MinWidth="160"
                            VerticalAlignment="Center"
                            Click="BtnScanForJunk_Click"
                            Style="{StaticResource AccentPrimaryButtonStyle}"
                            ToolTip="{DynamicResource Str_Junk_ScanButtonTooltip}">
                            <Grid HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon
                                    Grid.Column="0"
                                    x:Name="IconScan"
                                    Width="18"
                                    Height="18"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Kind="MagnifyScan" />
                                <TextBlock
                                    Grid.Column="1"
                                    x:Name="TxtScanLabel"
                                    VerticalAlignment="Center"
                                    Text="{DynamicResource Str_Junk_ScanButton}" TextWrapping="Wrap" />
                            </Grid>
                        </Button>

                        <Button
                            x:Name="BtnCleanSelected"
                            ctl:Tour.Key="Str_Tour_JunkCleaner_Clean"
                            ctl:Tour.Order="4"
                            Grid.Column="1"
                            Margin="8,0,16,0"
                            VerticalAlignment="Center"
                            Click="BtnCleanSelected_Click"
                            IsEnabled="False"
                            Style="{StaticResource DangerButtonStyle}"
                            ToolTip="{DynamicResource Str_Junk_CleanSelectedTooltip}">
                            <Grid HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon
                                    Grid.Column="0"
                                    x:Name="IconClean"
                                    Width="16"
                                    Height="16"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Kind="DeleteSweepOutline" />
                                <TextBlock
                                    Grid.Column="1"
                                    x:Name="TxtCleanLabel"
                                    VerticalAlignment="Center"
                                    Text="{DynamicResource Str_Junk_CleanSelected}" TextWrapping="Wrap" />
                            </Grid>
                        </Button>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <ProgressBar
                                x:Name="ProgressScan"
                                Height="8"
                                Maximum="100"
                                ToolTip="{DynamicResource Str_Junk_ProgressTooltip}" />
                            <TextBlock
                                x:Name="TxtProgress"
                                Margin="0,6,0,0"
                                FontSize="11.5"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="{DynamicResource Str_JunkFileCleaner_PickWhatToLook}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </StackPanel>

                        <TextBlock
                            x:Name="TxtProgressPercent"
                            Grid.Column="3"
                            MinWidth="54"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="{DynamicResource AccentColor}"
                            TextAlignment="Right" />
                    </Grid>
                </Border>

                <!--  Needs administrator rights (hidden when already elevated or dismissed)  -->
                <controls:ElevationBannerCard
                    x:Name="ElevationBanner"
                    Grid.Row="1"
                    Margin="0,0,0,14"
                    MessageKey="Str_JunkFileCleaner_WindowsUpdateDownloadsAnd"
                    TitleKey="Str_JunkFileCleaner_AdminTitle" />

                <!--  Results + files  -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition x:Name="ResultsColumn" Width="400" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  Places found  -->
                    <Border ctl:Tour.Key="Str_Tour_JunkCleaner_Results" ctl:Tour.Order="5" Grid.Column="0" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <StackPanel Margin="0,0,0,10">
                                <ContentControl
                                    Content="{DynamicResource Str_Junk_ResultsTitle}"
                                    Style="{StaticResource CardHeader}"
                                    Tag="{x:Static materialDesign:PackIconKind.DeleteSweepOutline}" />
                                <WrapPanel
                                    x:Name="SummaryPanel"
                                    Margin="0,6,0,0"
                                    Visibility="Collapsed">
                                    <Border
                                        Margin="0,2,6,2"
                                        Background="{DynamicResource StatusInfoBg}"
                                        Style="{StaticResource IconStatusPillStyle}"
                                        ToolTip="{DynamicResource Str_Junk_ItemsFoundTooltip}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon
                                                Width="13"
                                                Height="13"
                                                Margin="0,0,5,0"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource StatusInfoFg}"
                                                Kind="MagnifyScan" />
                                            <TextBlock
                                                x:Name="TxtSummaryCount"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource StatusInfoFg}" />
                                        </StackPanel>
                                    </Border>
                                    <Border
                                        Margin="0,2,6,2"
                                        Background="{DynamicResource StatusSuccessBg}"
                                        Style="{StaticResource IconStatusPillStyle}"
                                        ToolTip="{DynamicResource Str_JunkFileCleaner_WhatCleanWillFree}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon
                                                Width="13"
                                                Height="13"
                                                Margin="0,0,5,0"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource StatusSuccessFg}"
                                                Kind="Broom" />
                                            <TextBlock
                                                x:Name="TxtSummaryReclaimable"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource StatusSuccessFg}" />
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>

                            <Border
                                x:Name="SafetyNoteBanner"
                                Grid.Row="1"
                                Margin="0,0,0,10"
                                Padding="10,8"
                                Background="{DynamicResource StatusWarningBg}"
                                CornerRadius="8"
                                Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon
                                        Width="14"
                                        Height="14"
                                        Margin="0,1,8,0"
                                        VerticalAlignment="Top"
                                        Foreground="{DynamicResource StatusWarningFg}"
                                        Kind="AlertOutline" />
                                    <TextBlock
                                        Grid.Column="1"
                                        FontSize="11.5"
                                        Foreground="{DynamicResource StatusWarningFg}"
                                        Text="{DynamicResource Str_JunkFileCleaner_CleanedFilesAreDeleted}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </Border>

                            <ListBox
                                x:Name="CategoryResultsList"
                                Grid.Row="2"
                                Background="Transparent"
                                BorderThickness="0"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                SelectionChanged="CategoryResultsList_SelectionChanged"
                                VirtualizingPanel.ScrollUnit="Pixel">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="0" />
                                        <Setter Property="Margin" Value="0,0,0,6" />
                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                        <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border
                                                        x:Name="Bd"
                                                        Padding="10,9"
                                                        Background="{DynamicResource RowBg}"
                                                        BorderBrush="Transparent"
                                                        BorderThickness="1.5"
                                                        CornerRadius="8">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource CardBorder}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                                                            <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentColorSubtle}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:JunkGroup}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <CheckBox
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Click="GroupCheckBox_Click"
                                                IsChecked="{Binding IsSelected, Mode=OneWay}"
                                                Tag="{Binding}"
                                                ToolTip="{DynamicResource Str_Junk_GroupCheckboxTooltip}" />
                                            <ContentControl
                                                Grid.Column="1"
                                                Margin="0,0,10,0"
                                                Content="{Binding}"
                                                ContentTemplate="{StaticResource CategoryIconTemplate}"
                                                Focusable="False" />
                                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                                <TextBlock
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource TextPrimary}"
                                                    Text="{Binding Title}"
                                                    TextTrimming="CharacterEllipsis" />
                                                <TextBlock
                                                    Margin="0,1,0,0"
                                                    FontSize="11"
                                                    Foreground="{DynamicResource TextSecondary}"
                                                    Text="{Binding Where}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip="{Binding Where}" />
                                            </StackPanel>
                                            <StackPanel
                                                Grid.Column="3"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center">
                                                <TextBlock
                                                    HorizontalAlignment="Right"
                                                    FontSize="13"
                                                    FontWeight="Bold"
                                                    Foreground="{DynamicResource AccentColor}"
                                                    Text="{Binding SizeText}" />
                                                <TextBlock
                                                    HorizontalAlignment="Right"
                                                    FontSize="11"
                                                    Foreground="{DynamicResource TextSecondary}"
                                                    Text="{Binding CountText}" />
                                            </StackPanel>
                                            <!--  Share of everything found  -->
                                            <ProgressBar
                                                Grid.Row="1"
                                                Grid.Column="2"
                                                Grid.ColumnSpan="2"
                                                Height="4"
                                                Margin="0,8,0,0"
                                                Maximum="1"
                                                Value="{Binding Share, Mode=OneWay}" />
                                            <TextBlock
                                                x:Name="NoteText"
                                                Grid.Row="2"
                                                Grid.Column="2"
                                                Grid.ColumnSpan="2"
                                                Margin="0,6,0,0"
                                                FontSize="11"
                                                Foreground="{DynamicResource StatusWarningFg}"
                                                Text="{Binding Note}"
                                                TextWrapping="Wrap" />
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding Note}" Value="">
                                                <Setter TargetName="NoteText" Property="Visibility" Value="Collapsed" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel
                                x:Name="EmptyStatePanel"
                                Grid.Row="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                                <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.Broom}" />
                                <TextBlock
                                    x:Name="TxtEmptyHint"
                                    MaxWidth="300"
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="12.5"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{DynamicResource Str_Junk_EmptyHint}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  Files of the chosen place  -->
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <ContentControl
                                        x:Name="FilesHeader"
                                        Content="{DynamicResource Str_Common_Files}"
                                        Style="{StaticResource CardHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.FileDocumentOutline}" />
                                    <TextBlock
                                        x:Name="TxtFilesInfo"
                                        Margin="0,4,0,0"
                                        FontSize="11.5"
                                        Foreground="{DynamicResource TextSecondary}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Top"
                                    Orientation="Horizontal">
                                    <Button Padding="0"
                                        x:Name="BtnSelectAllItems"
                                        Width="32"
                                        Height="32"
                                        Click="BtnSelectAllItems_Click"
                                        IsEnabled="False"
                                        Style="{StaticResource NeutralIconButtonStyle}"
                                        ToolTip="{DynamicResource Str_Junk_SelectAllItemsTooltip}">
                                        <materialDesign:PackIcon
                                            Width="16"
                                            Height="16"
                                            Kind="CheckboxMultipleMarkedOutline" />
                                    </Button>
                                    <Button Padding="0"
                                        x:Name="BtnDeselectAllItems"
                                        Width="32"
                                        Height="32"
                                        Margin="4,0,0,0"
                                        Click="BtnDeselectAllItems_Click"
                                        IsEnabled="False"
                                        Style="{StaticResource NeutralIconButtonStyle}"
                                        ToolTip="{DynamicResource Str_Junk_DeselectAllItemsTooltip}">
                                        <materialDesign:PackIcon
                                            Width="16"
                                            Height="16"
                                            Kind="CheckboxMultipleBlankOutline" />
                                    </Button>
                                    <Button
                                        x:Name="BtnOpenFolder"
                                        Margin="10,0,0,0"
                                        Click="BtnOpenFolder_Click"
                                        IsEnabled="False"
                                        ToolTip="{DynamicResource Str_JunkFileCleaner_OpenTheFolderOf}"
                                        Style="{StaticResource ListToolButtonStyle}">
                                        <materialDesign:PackIcon
                                            Width="16"
                                            Height="16"
                                            Kind="FolderOpenOutline" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <DataGrid
                                x:Name="DataGridFiles"
                                Grid.Row="1"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                CanUserReorderColumns="False"
                                CanUserSortColumns="False"
                                FontSize="12"
                                IsReadOnly="True"
                                MouseDoubleClick="DataGridFiles_MouseDoubleClick"
                                MinRowHeight="42"
                                SelectionMode="Extended"
                                ToolTip="{DynamicResource Str_JunkFileCleaner_TickedFilesAreDeleted}"
                                VirtualizingPanel.IsVirtualizing="True"
                                VirtualizingPanel.ScrollUnit="Pixel"
                                VirtualizingPanel.VirtualizationMode="Recycling">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="34" CellStyle="{StaticResource CheckBoxCellStyle}">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <CheckBox
                                                    Click="ItemCheckBox_Click"
                                                    IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                    Style="{StaticResource DataGridCheckBoxStyle}"
                                                    ToolTip="{DynamicResource Str_Junk_ItemCheckboxTooltip}" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTemplateColumn
                                        Width="*"
                                        MinWidth="90"
                                        CellTemplate="{StaticResource FileCellTemplate}"
                                        Header="{DynamicResource Str_Common_ColHeaderFile}" />
                                    <DataGridTextColumn
                                        ElementStyle="{StaticResource EllipsisCellTextStyle}"
                                        Width="78"
                                        Binding="{Binding Size, Mode=OneWay}"
                                        Header="{DynamicResource Str_Common_ColHeaderSize}" />
                                    <DataGridTextColumn
                                        ElementStyle="{StaticResource EllipsisCellTextStyle}"
                                        x:Name="ColModified"
                                        Width="130"
                                        Binding="{Binding ModifiedText, Mode=OneWay}"
                                        Header="{DynamicResource Str_JunkFileCleaner_Changed}" />
                                    <DataGridTemplateColumn
                                        Width="104"
                                        CellTemplate="{StaticResource StatusCellTemplate}"
                                        Header="{DynamicResource Str_Common_ColHeaderStatus}" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!--  Recycle Bin: Windows gives a count and size, not a file list  -->
                            <StackPanel
                                x:Name="RecycleBinPanel"
                                Grid.Row="1"
                                MaxWidth="360"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                                <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.TrashCanOutline}" />
                                <TextBlock
                                    x:Name="TxtRecycleBin"
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="12.5"
                                    Foreground="{DynamicResource TextSecondary}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <StackPanel
                                x:Name="FilesEmptyPanel"
                                Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                                <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.FileDocumentOutline}" />
                                <TextBlock
                                    MaxWidth="320"
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="12.5"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{DynamicResource Str_JunkFileCleaner_ChooseAPlaceOn}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
