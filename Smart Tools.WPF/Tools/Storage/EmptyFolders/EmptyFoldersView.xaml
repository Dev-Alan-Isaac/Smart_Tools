<UserControl
    x:Class="Smart_Tools.WPF.Views.EmptyFoldersView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:ctrl="clr-namespace:Smart_Tools.WPF.Controllers"
    x:Name="Root"
    Focusable="True"
    Loaded="Root_Loaded"
    Unloaded="Root_Unloaded">

    <!--  Backend: Controllers/EmptyFolderManager.cs (finding empty folders, deleting to the Recycle Bin). UI only here.  -->

    <UserControl.Resources>
        <!--  A folder on the Folders card  -->
        <DataTemplate x:Key="RootTemplate" DataType="{x:Type ctrl:EmptyFolder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="26" Height="26" Margin="0,0,8,0" Background="{DynamicResource AccentColorSubtle}" CornerRadius="7">
                    <materialDesign:PackIcon Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentColor}" Kind="Folder" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SidebarText}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                    <TextBlock Margin="0,1,0,0" FontSize="10.5" Foreground="{DynamicResource SidebarTextMuted}" Text="{Binding Parent}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="2" Width="24" Height="24" Margin="6,0,0,0" VerticalAlignment="Center" Click="BtnRemoveRoot_Click" Style="{StaticResource IconButtonStyle}" Tag="{Binding}" ToolTip="Take this off the list">
                    <materialDesign:PackIcon Width="13" Height="13" Kind="Close" />
                </Button>
            </Grid>
        </DataTemplate>

        <!--  One empty folder found  -->
        <DataTemplate x:Key="FoundTemplate">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <CheckBox Margin="2,0,8,0" VerticalAlignment="Center" Click="FoundCheck_Click" IsChecked="{Binding IsChecked, Mode=TwoWay}" ToolTip="Move this folder to the Recycle Bin" />
                <materialDesign:PackIcon Grid.Column="1" Width="20" Height="20" Margin="0,0,10,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Kind="FolderOutline" />
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding Folder.Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Folder.Path}" />
                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondary}" Text="{Binding Folder.Detail}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">
        <Grid Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= OPTIONS SIDEBAR =================  -->
            <controls:ToolSidebar>
                <StackPanel x:Name="SidebarStack">
                    <controls:InputFolderCard
                        x:Name="InputCard"
                        ClearRequested="InputCard_ClearRequested"
                        Header="Folders to check"
                        HeaderIcon="FolderSearchOutline"
                        ItemTemplate="{StaticResource RootTemplate}"
                        Mode="Folders"
                        PathsAdded="InputCard_PathsAdded"
                        ShowSubfolders="False" />

                    <Border Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl Content="GOOD TO KNOW" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.InformationOutline}" />
                            <TextBlock Margin="2,6,0,0" FontSize="10.5" Foreground="{DynamicResource SidebarTextMuted}" TextWrapping="Wrap" Text="A folder counts as empty when it has no files in it at all (hidden and system files count as files) and every folder inside it is empty too. Shortcuts to other folders are left alone, and the folders you add are never listed themselves. Deleting sends folders to the Recycle Bin, so you can get them back." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </controls:ToolSidebar>

            <!--  ================= MAIN AREA =================  -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  ========== Summary and actions ==========  -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="BtnFind" MinHeight="38" Margin="0,0,8,0" Click="BtnFind_Click" Style="{StaticResource ListToolPrimaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon x:Name="IconFind" Width="16" Height="16" Margin="0,0,6,0" Kind="Magnify" />
                                        <TextBlock x:Name="TxtFind" Text="Find empty folders" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnDelete" MinHeight="38" Click="BtnDelete_Click" IsEnabled="False" Style="{StaticResource AccentPrimaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" Kind="DeleteOutline" />
                                        <TextBlock x:Name="TxtDelete" VerticalAlignment="Center" Text="Move to Recycle Bin" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Text="EMPTY FOLDERS" />
                                <WrapPanel Margin="0,4,0,0">
                                    <Border x:Name="PillCount" Margin="0,0,6,0" Background="{DynamicResource AccentColorSubtle}" Style="{StaticResource IconStatusPillStyle}" Visibility="Collapsed">
                                        <TextBlock x:Name="TxtPillCount" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource AccentColor}" />
                                    </Border>
                                    <Border x:Name="DonePill" Background="{DynamicResource StatusSuccessBg}" Style="{StaticResource IconStatusPillStyle}" Visibility="Collapsed">
                                        <TextBlock x:Name="TxtDonePill" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource StatusSuccessFg}" />
                                    </Border>
                                </WrapPanel>
                            </StackPanel>
                        </DockPanel>
                        <Border x:Name="StatusBanner" Margin="0,10,0,0" Padding="12,9" HorizontalAlignment="Left" CornerRadius="10" Visibility="Collapsed">
                            <TextBlock x:Name="TxtStatus" MaxWidth="900" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <!--  ========== Results ==========  -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,10">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button x:Name="BtnSelectAll" Margin="0,0,6,0" Click="BtnSelectAll_Click" Content="Select all" Style="{StaticResource ListToolButtonStyle}" />
                                <Button x:Name="BtnSelectNone" Click="BtnSelectNone_Click" Content="Select none" Style="{StaticResource ListToolButtonStyle}" />
                            </StackPanel>
                            <ContentControl Content="Found" Style="{StaticResource CardHeader}" Tag="{x:Static materialDesign:PackIconKind.FolderRemoveOutline}" />
                        </DockPanel>
                        <Border Grid.Row="1" Background="{DynamicResource RowBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="12">
                            <Grid>
                                <ListBox x:Name="FoundList" Padding="8" Background="Transparent" BorderThickness="0" ItemTemplate="{StaticResource FoundTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" />
                                <StackPanel x:Name="ListEmpty" MaxWidth="340" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.FolderRemoveOutline}" />
                                    <TextBlock x:Name="TxtEmptyTitle" Margin="0,12,0,0" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="Add a folder to check" />
                                    <TextBlock x:Name="TxtEmptyHint" Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="Drop folders on the left, then press Find empty folders." TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
