<UserControl
    x:Class="Smart_Tools.WPF.Views.SmartHistoryView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:models="clr-namespace:Smart_Tools.WPF.Models"
    x:Name="Root"
    Focusable="True"
    Loaded="Root_Loaded">

    <!--  Backend: Controllers/SmartHistoryManager.cs (readings file, warnings, CSV) + DriveHealthManager (the SMART numbers). UI only here.  -->

    <UserControl.Resources>
        <Style x:Key="TagPillStyle" TargetType="Border">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--  One warning line  -->
        <DataTemplate x:Key="WarningTemplate" DataType="{x:Type models:SmartWarning}">
            <Border x:Name="Bd" Margin="0,0,0,6" Padding="10,8" Background="{DynamicResource StatusInfoBg}" CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon x:Name="Icon" Width="14" Height="14" Margin="0,1,8,0" VerticalAlignment="Top" Foreground="{DynamicResource StatusInfoFg}" Kind="InformationOutline" />
                    <TextBlock x:Name="Msg" Grid.Column="1" FontSize="11.5" Foreground="{DynamicResource StatusInfoFg}" Text="{Binding Text}" TextWrapping="Wrap" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Warning">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource StatusWarningBg}" />
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                    <Setter TargetName="Icon" Property="Kind" Value="AlertOutline" />
                    <Setter TargetName="Msg" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Danger">
                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource StatusErrorBg}" />
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                    <Setter TargetName="Icon" Property="Kind" Value="AlertCircleOutline" />
                    <Setter TargetName="Msg" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  What got worse since the reading before  -->
        <DataTemplate x:Key="ChangeCellTemplate" DataType="{x:Type models:SmartReadingRow}">
            <TextBlock x:Name="Txt" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Text="{Binding Change}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Change}" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Worsened}" Value="True">
                    <Setter TargetName="Txt" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                    <Setter TargetName="Txt" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">
        <Grid Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= OPTIONS SIDEBAR =================  -->
            <controls:ToolSidebar>
                <StackPanel x:Name="SidebarStack">
                    <Border ctl:Tour.Key="Str_Tour_SmartHistory_Drive" ctl:Tour.Order="1" Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl Content="DRIVE" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.Harddisk}" />
                            <ComboBox x:Name="CmbDrive" Margin="0,8,0,0" SelectionChanged="CmbDrive_SelectionChanged" />
                            <TextBlock x:Name="TxtDriveInfo" Margin="2,6,0,0" FontSize="10.5" Foreground="{DynamicResource SidebarTextMuted}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border ctl:Tour.Key="Str_Tour_SmartHistory_Chart" ctl:Tour.Order="2" Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl Content="CHART" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.ChartLine}" />
                            <TextBlock Margin="2,8,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SidebarTextMuted}" Text="Show" />
                            <ComboBox x:Name="CmbMetric" Margin="0,6,0,0" SelectionChanged="CmbMetric_SelectionChanged" />
                            <TextBlock Margin="2,12,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SidebarTextMuted}" Text="Period" />
                            <ComboBox x:Name="CmbPeriod" Margin="0,6,0,0" SelectedIndex="0" SelectionChanged="CmbPeriod_SelectionChanged">
                                <ComboBoxItem Content="Everything recorded" Tag="0" />
                                <ComboBoxItem Content="Last year" Tag="365" />
                                <ComboBoxItem Content="Last 90 days" Tag="90" />
                                <ComboBoxItem Content="Last 30 days" Tag="30" />
                                <ComboBoxItem Content="Last 7 days" Tag="7" />
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl Content="GOOD TO KNOW" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.InformationOutline}" />
                            <TextBlock Margin="2,6,0,0" FontSize="10.5" Foreground="{DynamicResource SidebarTextMuted}" TextWrapping="Wrap" Text="Opening this tool records a reading of every drive's SMART numbers (at most one every 6 hours); Record now adds one at once. The history only grows while the app is used, so open it now and then. It is kept on this PC only. A rise in reallocated, pending or uncorrectable sectors, or in media errors, is the classic sign a drive is starting to fail - back it up. Drives that report no SMART data (some USB boxes) can't be tracked; running as administrator helps." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </controls:ToolSidebar>

            <!--  ================= MAIN AREA =================  -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Run bar  -->
                <Border Grid.Row="0" Margin="0,0,0,14" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button ctl:Tour.Key="Str_Tour_SmartHistory_Record" ctl:Tour.Order="3" x:Name="BtnRecord" MinWidth="180" VerticalAlignment="Center" Click="BtnRecord_Click" Style="{StaticResource AccentPrimaryButtonStyle}" ToolTip="Read every drive now and add a reading to the history">
                            <Grid HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" Kind="PlaylistPlus" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="Record now" TextWrapping="Wrap" />
                            </Grid>
                        </Button>

                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <ProgressBar x:Name="Bar" Height="8" Maximum="100" />
                            <TextBlock x:Name="TxtProgress" Margin="0,6,0,0" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Text="Reading the drives..." TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  History  -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="230" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid x:Name="HeaderRow" Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ContentControl VerticalAlignment="Center" Content="Trend" Style="{StaticResource CardHeader}" Tag="{x:Static materialDesign:PackIconKind.ChartLine}" />

                            <WrapPanel x:Name="SummaryPanel" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                <Border Margin="0,2,6,2" Background="{DynamicResource StatusInfoBg}" Style="{StaticResource IconStatusPillStyle}" ToolTip="Readings kept for this drive">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource StatusInfoFg}" Kind="ClockOutline" />
                                        <TextBlock x:Name="TxtSummaryReadings" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource StatusInfoFg}" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="PillOk" Margin="0,2,6,2" Background="{DynamicResource StatusSuccessBg}" Style="{StaticResource IconStatusPillStyle}" ToolTip="Nothing has got worse">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource StatusSuccessFg}" Kind="CheckCircleOutline" />
                                        <TextBlock x:Name="TxtSummaryOk" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource StatusSuccessFg}" Text="Stable" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="PillWarn" Margin="0,2,6,2" Background="{DynamicResource StatusWarningBg}" Style="{StaticResource IconStatusPillStyle}" ToolTip="Things to keep an eye on" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource StatusWarningFg}" Kind="AlertOutline" />
                                        <TextBlock x:Name="TxtSummaryWarn" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource StatusWarningFg}" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="PillDanger" Margin="0,2,6,2" Background="{DynamicResource StatusErrorBg}" Style="{StaticResource IconStatusPillStyle}" ToolTip="Back up this drive" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource StatusErrorFg}" Kind="AlertCircleOutline" />
                                        <TextBlock x:Name="TxtSummaryDanger" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource StatusErrorFg}" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                                <Button x:Name="BtnCopyCsv" Margin="0,0,6,0" Click="BtnCopyCsv_Click" Style="{StaticResource ListToolButtonStyle}" ToolTip="Copy this drive's history (CSV)">
                                    <materialDesign:PackIcon Width="16" Height="16" Kind="ContentCopy" />
                                </Button>
                                <Button x:Name="BtnSaveCsv" Margin="0,0,6,0" Click="BtnSaveCsv_Click" Style="{StaticResource ListToolButtonStyle}" ToolTip="Save this drive's history as a CSV file">
                                    <materialDesign:PackIcon Width="16" Height="16" Kind="FileDelimitedOutline" />
                                </Button>
                                <Button x:Name="BtnClearDrive" Click="BtnClearDrive_Click" Style="{StaticResource ListToolDangerButtonStyle}" ToolTip="Forget the history of this drive">
                                    <materialDesign:PackIcon Width="16" Height="16" Kind="DeleteSweepOutline" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!--  Warnings and facts  -->
                        <StackPanel x:Name="WarningsPanel" Grid.Row="1" Margin="0,0,0,10" Visibility="Collapsed">
                            <ItemsControl x:Name="WarningList" ItemTemplate="{StaticResource WarningTemplate}" />
                            <TextBlock x:Name="TxtFacts" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Visibility="Collapsed" />
                        </StackPanel>

                        <Border x:Name="ChartCard" Grid.Row="2" Background="{DynamicResource RowBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="12">
                            <Grid>
                                <TextBlock x:Name="TxtChartTitle" Margin="14,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                <controls:TrendChart ctl:Tour.Key="Str_Tour_SmartHistory_Trend" ctl:Tour.Order="4" x:Name="Chart" Margin="6,26,6,6" />
                            </Grid>
                        </Border>

                        <DataGrid ctl:Tour.Key="Str_Tour_SmartHistory_Readings" ctl:Tour.Order="5"
                            x:Name="ReadingsGrid"
                            Grid.Row="4"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            CanUserSortColumns="False"
                            FontSize="12"
                            IsReadOnly="True"
                            MinRowHeight="38"
                            SelectionMode="Extended"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.ScrollUnit="Pixel"
                            VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="130" Binding="{Binding When}" ElementStyle="{StaticResource EllipsisCellTextStyle}" Header="When" />
                                <DataGridTextColumn Width="76" Binding="{Binding Temperature}" ElementStyle="{StaticResource EllipsisCellTextStyle}" Header="Temp" />
                                <DataGridTextColumn Width="100" Binding="{Binding PowerOn}" ElementStyle="{StaticResource EllipsisCellTextStyle}" Header="Power-on" />
                                <DataGridTextColumn Width="90" Binding="{Binding Reallocated}" ElementStyle="{StaticResource EllipsisCellTextStyle}" Header="Reallocated" />
                                <DataGridTextColumn Width="76" Binding="{Binding Pending}" ElementStyle="{StaticResource EllipsisCellTextStyle}" Header="Pending" />
                                <DataGridTextColumn Width="96" Binding="{Binding Written}" ElementStyle="{StaticResource EllipsisCellTextStyle}" Header="Written" />
                                <DataGridTextColumn Width="70" Binding="{Binding Life}" ElementStyle="{StaticResource EllipsisCellTextStyle}" Header="Life left" />
                                <DataGridTemplateColumn Width="2*" MinWidth="120" CellTemplate="{StaticResource ChangeCellTemplate}" Header="Changed since the one before" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <controls:EmptyStateCard
                            x:Name="EmptyStatePanel"
                            Grid.Row="2"
                            Grid.RowSpan="3"
                            Description="No readings for this drive yet. Press Record now - each time you open this tool a reading is added, and the trend builds up."
                            Icon="ChartLine"
                            IsHitTestVisible="False" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
