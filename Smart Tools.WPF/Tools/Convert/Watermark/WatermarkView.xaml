<UserControl
    x:Class="Smart_Tools.WPF.Views.WatermarkView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:models="clr-namespace:Smart_Tools.WPF.Models"
    x:Name="Root"
    Focusable="True"
    Loaded="Root_Loaded"
    Unloaded="Root_Unloaded">

    <!--
        Backend: Controllers/WatermarkManager.cs (placement maths, presets, settings), .Render.cs (drawing the mark),
        .Engines.cs (pictures, PDFs, videos and the batch), .Files.cs (the list), .Preview.cs (what the preview shows).
        Models/WatermarkModel.cs. UI only here.
    -->

    <UserControl.Resources>
        <!--  A round colour swatch button (the colour is the data, so the fixed colours are allowed)  -->
        <Style x:Key="WmSwatchStyle" TargetType="Button">
            <Setter Property="Width" Value="22" />
            <Setter Property="Height" Value="22" />
            <Setter Property="MinHeight" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Margin" Value="0,0,6,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Ring"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{DynamicResource SidebarInputBorder}"
                            BorderThickness="1.5"
                            CornerRadius="8" />
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="WmSideLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarText}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="WmSideHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextMuted}" />
            <Setter Property="Margin" Value="2,6,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="WmPillText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>

        <!--  A Files card row (a folder or loose files)  -->
        <DataTemplate x:Key="GroupTemplate" DataType="{x:Type models:WatermarkGroup}">
            <Grid ToolTip="{Binding ToolTip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="26"
                    Height="26"
                    Margin="0,0,8,0"
                    Background="{DynamicResource AccentColorSubtle}"
                    CornerRadius="7">
                    <materialDesign:PackIcon
                        x:Name="GroupIcon"
                        Width="14"
                        Height="14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource AccentColor}"
                        Kind="FileMultipleOutline" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource SidebarText}"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Margin="0,1,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource SidebarTextMuted}"
                        Text="{Binding Subtitle}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button
                    Grid.Column="2"
                    Width="24"
                    Height="24"
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    Click="BtnRemoveGroup_Click"
                    Style="{StaticResource IconButtonStyle}"
                    Tag="{Binding}"
                    ToolTip="{DynamicResource Str_Watermark_TakeOff}">
                    <materialDesign:PackIcon
                        Width="13"
                        Height="13"
                        Kind="Close" />
                </Button>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                    <Setter TargetName="GroupIcon" Property="Kind" Value="Folder" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  One file in the list  -->
        <DataTemplate x:Key="FileTemplate" DataType="{x:Type models:WatermarkItem}">
            <Grid Margin="0,3">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="34"
                    Height="34"
                    Margin="2,0,10,0"
                    VerticalAlignment="Center"
                    Background="{DynamicResource AccentColorSubtle}"
                    CornerRadius="9">
                    <materialDesign:PackIcon
                        x:Name="KindIcon"
                        Width="18"
                        Height="18"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource AccentColor}"
                        Kind="FileImageOutline" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="12.5"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding FullPath}" />
                    <StackPanel Margin="0,1,0,0" Orientation="Horizontal">
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource TextSecondary}"
                            Text="{Binding Info}" />
                        <TextBlock
                            x:Name="Dot"
                            Margin="5,0,5,0"
                            FontSize="11"
                            Foreground="{DynamicResource TextSecondary}"
                            Text="·" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource TextSecondary}"
                            Text="{Binding SizeText}" />
                    </StackPanel>
                    <TextBlock
                        x:Name="Reason"
                        Margin="0,2,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource StatusErrorFg}"
                        Text="{Binding StatusText}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />
                </StackPanel>
                <materialDesign:PackIcon
                    x:Name="StatusIcon"
                    Grid.Column="2"
                    Width="18"
                    Height="18"
                    Margin="6,0,4,0"
                    VerticalAlignment="Center"
                    Kind="CheckCircleOutline"
                    Visibility="Collapsed" />
                <ProgressBar
                    x:Name="ItemBar"
                    Grid.Row="1"
                    Grid.ColumnSpan="3"
                    Height="3"
                    Margin="46,5,4,0"
                    Maximum="100"
                    Visibility="Collapsed"
                    Value="{Binding Progress}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Video">
                    <Setter TargetName="KindIcon" Property="Kind" Value="FileVideoOutline" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Pdf">
                    <Setter TargetName="KindIcon" Property="Kind" Value="FilePdfBox" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Processing">
                    <Setter TargetName="ItemBar" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Done">
                    <Setter TargetName="StatusIcon" Property="Visibility" Value="Visible" />
                    <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource StatusSuccessFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter TargetName="StatusIcon" Property="Visibility" Value="Visible" />
                    <Setter TargetName="StatusIcon" Property="Kind" Value="AlertCircleOutline" />
                    <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                    <Setter TargetName="Reason" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Skipped">
                    <Setter TargetName="StatusIcon" Property="Visibility" Value="Visible" />
                    <Setter TargetName="StatusIcon" Property="Kind" Value="SkipNextCircleOutline" />
                    <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                    <Setter TargetName="Reason" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Reason" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">

        <!--  No page header: MainWindow's header card shows the tool's icon and name.  -->

        <Grid Margin="16,8,16,16">

            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OptionsColumn" Width="280" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= OPTIONS SIDEBAR =================  -->

            <Border Grid.Column="0" Style="{StaticResource SidebarPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Button
                            x:Name="BtnCollapseOptions"
                            MinHeight="45"
                            HorizontalContentAlignment="Left"
                            Click="BtnCollapseOptions_Click"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Foreground="{DynamicResource SidebarText}"
                            ToolTip="{DynamicResource Str_Common_SidebarToggleTooltip}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="OverridesDefaultStyle" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Margin="16,0,0,0" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Kind="TuneVariant" />
                                <TextBlock
                                    x:Name="TxtOptionsHeaderLabel"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{DynamicResource Str_Common_OptionsLabel}" />
                            </StackPanel>
                        </Button>
                        <Separator
                            x:Name="SepHeader"
                            Margin="16,4"
                            Style="{StaticResource SidebarSeparatorStyle}" />
                    </StackPanel>

                    <ScrollViewer
                        x:Name="OptionsScrollViewer"
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="SidebarStack" Margin="16,4,16,16">

                            <!--  ============ FILES ============  -->
                            <controls:InputFolderCard
                                x:Name="InputCard"
                                ctl:Tour.Key="Str_Tour_Watermark_Input"
                                ctl:Tour.Order="1"
                                ClearRequested="InputCard_ClearRequested"
                                Header="{DynamicResource Str_Common_Files}"
                                HeaderIcon="FileMultipleOutline"
                                IncludeSubfoldersChanged="InputCard_IncludeSubfoldersChanged"
                                ItemTemplate="{StaticResource GroupTemplate}"
                                PathsAdded="InputCard_PathsAdded" />
                            <!--  ============ MARK ============  -->
                            <Border ctl:Tour.Key="Str_Tour_Watermark_Mark" ctl:Tour.Order="2" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Watermark_MarkHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.Stamper}" />
                                    <UniformGrid Columns="2">
                                        <RadioButton
                                            x:Name="RadioKindText"
                                            Margin="0,0,2,0"
                                            Click="Kind_Click"
                                            Content="{DynamicResource Str_Watermark_KindText}"
                                            GroupName="WmKind"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="Text" />
                                        <RadioButton
                                            x:Name="RadioKindImage"
                                            Margin="2,0,0,0"
                                            Click="Kind_Click"
                                            Content="{DynamicResource Str_Watermark_KindImage}"
                                            GroupName="WmKind"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="Image" />
                                    </UniformGrid>

                                    <!--  Text  -->
                                    <StackPanel x:Name="TextPanel" Margin="0,12,0,0">
                                        <TextBlock
                                            Margin="2,0,0,4"
                                            Style="{StaticResource WmSideLabel}"
                                            Text="{DynamicResource Str_Watermark_TextLabel}" />
                                        <Border Style="{StaticResource InputBarStyle}">
                                            <TextBox
                                                x:Name="TxtMarkText"
                                                VerticalContentAlignment="Center"
                                                Style="{StaticResource BareTextBox}"
                                                Tag="{DynamicResource Str_Watermark_TextHint}"
                                                TextChanged="Setting_TextChanged" />
                                        </Border>
                                        <TextBlock
                                            Margin="2,10,0,4"
                                            Style="{StaticResource WmSideLabel}"
                                            Text="{DynamicResource Str_Watermark_FontLabel}" />
                                        <Border Style="{StaticResource InputBarStyle}">
                                            <ComboBox
                                                x:Name="CmbFont"
                                                VerticalContentAlignment="Center"
                                                SelectionChanged="Setting_SelectionChanged"
                                                Style="{StaticResource BareComboBox}" />
                                        </Border>
                                        <WrapPanel Margin="0,10,0,0">
                                            <CheckBox
                                                x:Name="ChkBold"
                                                Margin="0,0,14,4"
                                                Click="Setting_Click"
                                                Content="{DynamicResource Str_Watermark_Bold}"
                                                Foreground="{DynamicResource SidebarText}"
                                                IsChecked="True"
                                                controls:ChoiceIcon.Kind="FormatBold"
                                                Style="{StaticResource ToggleChipCheckBoxStyle}" />
                                            <CheckBox
                                                x:Name="ChkItalic"
                                                Margin="0,0,14,4"
                                                Click="Setting_Click"
                                                Content="{DynamicResource Str_Watermark_Italic}"
                                                Foreground="{DynamicResource SidebarText}"
                                                controls:ChoiceIcon.Kind="FormatItalic"
                                                Style="{StaticResource ToggleChipCheckBoxStyle}" />
                                            <CheckBox
                                                x:Name="ChkOutline"
                                                Margin="0,0,0,4"
                                                Click="Setting_Click"
                                                Content="{DynamicResource Str_Watermark_Outline}"
                                                Foreground="{DynamicResource SidebarText}"
                                                IsChecked="True"
                                                ToolTip="{DynamicResource Str_Watermark_OutlineTip}"
                                                controls:ChoiceIcon.Kind="SquareOutline"
                                                Style="{StaticResource ToggleChipCheckBoxStyle}" />
                                        </WrapPanel>
                                        <TextBlock
                                            Margin="2,6,0,4"
                                            Style="{StaticResource WmSideLabel}"
                                            Text="{DynamicResource Str_Watermark_ColorLabel}" />
                                        <Border x:Name="ColorBar" Style="{StaticResource InputBarStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    x:Name="ColorSwatch"
                                                    Width="22"
                                                    Height="22"
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    BorderBrush="{DynamicResource SidebarInputBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="11" />
                                                <TextBox
                                                    x:Name="TxtColor"
                                                    Grid.Column="1"
                                                    VerticalContentAlignment="Center"
                                                    FontFamily="Cascadia Mono, Consolas"
                                                    LostFocus="TxtColor_LostFocus"
                                                    Style="{StaticResource BareTextBox}"
                                                    Tag="#RRGGBB"
                                                    TextChanged="TxtColor_TextChanged" />
                                            </Grid>
                                        </Border>
                                        <TextBlock
                                            x:Name="TxtColorError"
                                            Margin="2,4,0,0"
                                            FontSize="11"
                                            Foreground="{DynamicResource StatusErrorFg}"
                                            Text="{DynamicResource Str_Watermark_ColorBad}"
                                            TextWrapping="Wrap"
                                            Visibility="Collapsed" />
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button
                                                Background="#FFFFFF"
                                                Click="ColorChip_Click"
                                                Style="{StaticResource WmSwatchStyle}"
                                                Tag="#FFFFFF" />
                                            <Button
                                                Background="#000000"
                                                Click="ColorChip_Click"
                                                Style="{StaticResource WmSwatchStyle}"
                                                Tag="#000000" />
                                            <Button
                                                Background="#9E9E9E"
                                                Click="ColorChip_Click"
                                                Style="{StaticResource WmSwatchStyle}"
                                                Tag="#9E9E9E" />
                                            <Button
                                                Background="#E53935"
                                                Click="ColorChip_Click"
                                                Style="{StaticResource WmSwatchStyle}"
                                                Tag="#E53935" />
                                            <Button
                                                Background="#FFD600"
                                                Click="ColorChip_Click"
                                                Style="{StaticResource WmSwatchStyle}"
                                                Tag="#FFD600" />
                                            <Button
                                                Background="#43A047"
                                                Click="ColorChip_Click"
                                                Style="{StaticResource WmSwatchStyle}"
                                                Tag="#43A047" />
                                            <Button
                                                Background="#1E88E5"
                                                Click="ColorChip_Click"
                                                Style="{StaticResource WmSwatchStyle}"
                                                Tag="#1E88E5" />
                                        </WrapPanel>
                                    </StackPanel>

                                    <!--  Picture  -->
                                    <StackPanel
                                        x:Name="ImagePanel"
                                        Margin="0,12,0,0"
                                        Visibility="Collapsed">
                                        <Border
                                            Height="96"
                                            Margin="0,0,0,10"
                                            Background="{DynamicResource SidebarInputBg}"
                                            BorderBrush="{DynamicResource SidebarInputBorder}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                            <Grid>
                                                <Image
                                                    x:Name="LogoPreview"
                                                    Margin="8"
                                                    RenderOptions.BitmapScalingMode="HighQuality"
                                                    Stretch="Uniform" />
                                                <StackPanel
                                                    x:Name="LogoEmpty"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    IsHitTestVisible="False">
                                                    <materialDesign:PackIcon
                                                        Width="22"
                                                        Height="22"
                                                        HorizontalAlignment="Center"
                                                        Foreground="{DynamicResource SidebarTextMuted}"
                                                        Kind="ImageOutline" />
                                                    <TextBlock
                                                        Margin="0,4,0,0"
                                                        FontSize="11"
                                                        Foreground="{DynamicResource SidebarTextMuted}"
                                                        Text="{DynamicResource Str_Watermark_NoLogo}" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button
                                                x:Name="BtnChooseLogo"
                                                Click="BtnChooseLogo_Click"
                                                Style="{StaticResource PrimaryButtonStyle}">
                                                <Grid HorizontalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <materialDesign:PackIcon
                                                        Grid.Column="0"
                                                        Width="16"
                                                        Height="16"
                                                        Margin="0,0,6,0"
                                                        VerticalAlignment="Center"
                                                        Kind="ImagePlusOutline" />
                                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_Watermark_ChooseLogo}" TextWrapping="Wrap" />
                                                </Grid>
                                            </Button>
                                            <Button Padding="0"
                                                x:Name="BtnClearLogo"
                                                Grid.Column="1"
                                                Width="34"
                                                Height="34"
                                                Margin="6,0,0,0"
                                                Click="BtnClearLogo_Click"
                                                Style="{StaticResource NeutralIconButtonStyle}"
                                                ToolTip="{DynamicResource Str_Watermark_ClearLogo}">
                                                <materialDesign:PackIcon
                                                    Width="16"
                                                    Height="16"
                                                    Kind="Close" />
                                            </Button>
                                        </Grid>
                                        <TextBlock
                                            x:Name="TxtLogoError"
                                            Foreground="{DynamicResource StatusErrorFg}"
                                            Style="{StaticResource WmSideHint}"
                                            Visibility="Collapsed" />
                                        <TextBlock Style="{StaticResource WmSideHint}" Text="{DynamicResource Str_Watermark_LogoHint}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!--  ============ POSITION ============  -->
                            <Border ctl:Tour.Key="Str_Tour_Watermark_Position" ctl:Tour.Order="3" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Watermark_PositionHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.ViewGridOutline}" />
                                    <UniformGrid Columns="3">
                                        <RadioButton
                                            x:Name="RadioPos0"
                                            Margin="0,0,2,2"
                                            Click="Position_Click"
                                            GroupName="WmPos"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="TopLeft"
                                            ToolTip="{DynamicResource Str_Watermark_PosTopLeft}">
                                            <materialDesign:PackIcon
                                                Width="16"
                                                Height="16"
                                                Kind="ArrowTopLeft" />
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="RadioPos1"
                                            Margin="2,0,2,2"
                                            Click="Position_Click"
                                            GroupName="WmPos"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="TopCenter"
                                            ToolTip="{DynamicResource Str_Watermark_PosTopCenter}">
                                            <materialDesign:PackIcon
                                                Width="16"
                                                Height="16"
                                                Kind="ArrowUp" />
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="RadioPos2"
                                            Margin="2,0,0,2"
                                            Click="Position_Click"
                                            GroupName="WmPos"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="TopRight"
                                            ToolTip="{DynamicResource Str_Watermark_PosTopRight}">
                                            <materialDesign:PackIcon
                                                Width="16"
                                                Height="16"
                                                Kind="ArrowTopRight" />
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="RadioPos3"
                                            Margin="0,2,2,2"
                                            Click="Position_Click"
                                            GroupName="WmPos"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="MiddleLeft"
                                            ToolTip="{DynamicResource Str_Watermark_PosMiddleLeft}">
                                            <materialDesign:PackIcon
                                                Width="16"
                                                Height="16"
                                                Kind="ArrowLeft" />
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="RadioPos4"
                                            Margin="2,2,2,2"
                                            Click="Position_Click"
                                            GroupName="WmPos"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="Center"
                                            ToolTip="{DynamicResource Str_Watermark_PosCenter}">
                                            <materialDesign:PackIcon
                                                Width="16"
                                                Height="16"
                                                Kind="CircleSmall" />
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="RadioPos5"
                                            Margin="2,2,0,2"
                                            Click="Position_Click"
                                            GroupName="WmPos"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="MiddleRight"
                                            ToolTip="{DynamicResource Str_Watermark_PosMiddleRight}">
                                            <materialDesign:PackIcon
                                                Width="16"
                                                Height="16"
                                                Kind="ArrowRight" />
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="RadioPos6"
                                            Margin="0,2,2,0"
                                            Click="Position_Click"
                                            GroupName="WmPos"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="BottomLeft"
                                            ToolTip="{DynamicResource Str_Watermark_PosBottomLeft}">
                                            <materialDesign:PackIcon
                                                Width="16"
                                                Height="16"
                                                Kind="ArrowBottomLeft" />
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="RadioPos7"
                                            Margin="2,2,2,0"
                                            Click="Position_Click"
                                            GroupName="WmPos"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="BottomCenter"
                                            ToolTip="{DynamicResource Str_Watermark_PosBottomCenter}">
                                            <materialDesign:PackIcon
                                                Width="16"
                                                Height="16"
                                                Kind="ArrowDown" />
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="RadioPos8"
                                            Margin="2,2,0,0"
                                            Click="Position_Click"
                                            GroupName="WmPos"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="BottomRight"
                                            ToolTip="{DynamicResource Str_Watermark_PosBottomRight}">
                                            <materialDesign:PackIcon
                                                Width="16"
                                                Height="16"
                                                Kind="ArrowBottomRight" />
                                        </RadioButton>
                                    </UniformGrid>
                                    <RadioButton
                                        x:Name="RadioPosTiled"
                                        Margin="0,6,0,0"
                                        Click="Position_Click"
                                        Content="{DynamicResource Str_Watermark_PosTiled}"
                                        GroupName="WmPos"
                                        Style="{StaticResource ModeToggleButtonStyle}"
                                        Tag="Tiled"
                                        ToolTip="{DynamicResource Str_Watermark_PosTiledTip}" />

                                    <StackPanel x:Name="MarginPanel" Margin="0,12,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource WmSideLabel}" Text="{DynamicResource Str_Watermark_Margin}" />
                                            <Border
                                                Grid.Column="1"
                                                Background="{DynamicResource AccentFill}"
                                                Style="{StaticResource IconStatusPillStyle}">
                                                <TextBlock
                                                    x:Name="TxtMarginValue"
                                                    FontSize="11.5"
                                                    FontWeight="Bold"
                                                    Foreground="White" />
                                            </Border>
                                        </Grid>
                                        <Slider
                                            x:Name="SldMargin"
                                            Margin="0,4,0,0"
                                            IsSnapToTickEnabled="True"
                                            LargeChange="2"
                                            Maximum="30"
                                            Minimum="0"
                                            SmallChange="1"
                                            TickFrequency="1"
                                            ValueChanged="Slider_ValueChanged"
                                            Value="3" />
                                        <TextBlock Style="{StaticResource WmSideHint}" Text="{DynamicResource Str_Watermark_MarginHint}" />
                                    </StackPanel>
                                    <StackPanel
                                        x:Name="GapPanel"
                                        Margin="0,12,0,0"
                                        Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource WmSideLabel}" Text="{DynamicResource Str_Watermark_Gap}" />
                                            <Border
                                                Grid.Column="1"
                                                Background="{DynamicResource AccentFill}"
                                                Style="{StaticResource IconStatusPillStyle}">
                                                <TextBlock
                                                    x:Name="TxtGapValue"
                                                    FontSize="11.5"
                                                    FontWeight="Bold"
                                                    Foreground="White" />
                                            </Border>
                                        </Grid>
                                        <Slider
                                            x:Name="SldGap"
                                            Margin="0,4,0,0"
                                            IsSnapToTickEnabled="True"
                                            LargeChange="20"
                                            Maximum="400"
                                            Minimum="0"
                                            SmallChange="5"
                                            TickFrequency="5"
                                            ValueChanged="Slider_ValueChanged"
                                            Value="120" />
                                        <TextBlock Style="{StaticResource WmSideHint}" Text="{DynamicResource Str_Watermark_GapHint}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!--  ============ LOOK ============  -->
                            <Border ctl:Tour.Key="Str_Tour_Watermark_Look" ctl:Tour.Order="4" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Watermark_LookHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.TuneVertical}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource WmSideLabel}" Text="{DynamicResource Str_Watermark_Size}" />
                                        <Border
                                            Grid.Column="1"
                                            Background="{DynamicResource AccentFill}"
                                            Style="{StaticResource IconStatusPillStyle}">
                                            <TextBlock
                                                x:Name="TxtSizeValue"
                                                FontSize="11.5"
                                                FontWeight="Bold"
                                                Foreground="White" />
                                        </Border>
                                    </Grid>
                                    <Slider
                                        x:Name="SldSize"
                                        Margin="0,4,0,0"
                                        IsSnapToTickEnabled="True"
                                        LargeChange="5"
                                        Maximum="100"
                                        Minimum="1"
                                        SmallChange="1"
                                        TickFrequency="1"
                                        ValueChanged="Slider_ValueChanged"
                                        Value="6" />
                                    <TextBlock x:Name="TxtSizeHint" Style="{StaticResource WmSideHint}" />

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource WmSideLabel}" Text="{DynamicResource Str_Watermark_Opacity}" />
                                        <Border
                                            Grid.Column="1"
                                            Background="{DynamicResource AccentFill}"
                                            Style="{StaticResource IconStatusPillStyle}">
                                            <TextBlock
                                                x:Name="TxtOpacityValue"
                                                FontSize="11.5"
                                                FontWeight="Bold"
                                                Foreground="White" />
                                        </Border>
                                    </Grid>
                                    <Slider
                                        x:Name="SldOpacity"
                                        Margin="0,4,0,0"
                                        IsSnapToTickEnabled="True"
                                        LargeChange="10"
                                        Maximum="100"
                                        Minimum="1"
                                        SmallChange="1"
                                        TickFrequency="1"
                                        ValueChanged="Slider_ValueChanged"
                                        Value="60" />

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource WmSideLabel}" Text="{DynamicResource Str_Watermark_Rotation}" />
                                        <Button
                                            Grid.Column="1"
                                            Margin="0,0,6,0"
                                            Click="BtnRotationReset_Click"
                                            Content="0°"
                                            Style="{StaticResource PresetChipStyle}"
                                            ToolTip="{DynamicResource Str_Watermark_RotationReset}" />
                                        <Border
                                            Grid.Column="2"
                                            Background="{DynamicResource AccentFill}"
                                            Style="{StaticResource IconStatusPillStyle}">
                                            <TextBlock
                                                x:Name="TxtRotationValue"
                                                FontSize="11.5"
                                                FontWeight="Bold"
                                                Foreground="White" />
                                        </Border>
                                    </Grid>
                                    <Slider
                                        x:Name="SldRotation"
                                        Margin="0,4,0,0"
                                        IsSnapToTickEnabled="True"
                                        LargeChange="15"
                                        Maximum="180"
                                        Minimum="-180"
                                        SmallChange="1"
                                        TickFrequency="1"
                                        ValueChanged="Slider_ValueChanged"
                                        Value="0" />
                                </StackPanel>
                            </Border>

                            <!--  ============ PRESETS ============  -->
                            <Border Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Watermark_PresetsHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.BookmarkOutline}" />
                                    <Border Style="{StaticResource InputBarStyle}">
                                        <ComboBox
                                            x:Name="CmbPreset"
                                            VerticalContentAlignment="Center"
                                            SelectionChanged="CmbPreset_SelectionChanged"
                                            Style="{StaticResource BareComboBox}" />
                                    </Border>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            x:Name="BtnPresetSave"
                                            Click="BtnPresetSave_Click"
                                            Style="{StaticResource PrimaryButtonStyle}">
                                            <Grid HorizontalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon
                                                    Grid.Column="0"
                                                    Width="16"
                                                    Height="16"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Kind="BookmarkPlusOutline" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_Watermark_PresetSave}" TextWrapping="Wrap" />
                                            </Grid>
                                        </Button>
                                        <Button
                                            x:Name="BtnPresetDelete"
                                            Grid.Column="1"
                                            Margin="6,0,0,0"
                                            Click="BtnPresetDelete_Click"
                                            Style="{StaticResource ListToolDangerButtonStyle}"
                                            ToolTip="{DynamicResource Str_Watermark_PresetDelete}">
                                            <materialDesign:PackIcon
                                                Width="16"
                                                Height="16"
                                                Kind="TrashCanOutline" />
                                        </Button>
                                    </Grid>
                                    <StackPanel
                                        x:Name="PresetNamePanel"
                                        Margin="0,8,0,0"
                                        Visibility="Collapsed">
                                        <Border Style="{StaticResource InputBarStyle}">
                                            <TextBox
                                                x:Name="TxtPresetName"
                                                VerticalContentAlignment="Center"
                                                KeyDown="TxtPresetName_KeyDown"
                                                MaxLength="40"
                                                Style="{StaticResource BareTextBox}"
                                                Tag="{DynamicResource Str_Watermark_PresetNameHint}" />
                                        </Border>
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button Click="BtnPresetConfirm_Click" Style="{StaticResource PrimaryButtonStyle}">
                                                <Grid HorizontalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <materialDesign:PackIcon
                                                        Grid.Column="0"
                                                        Width="16"
                                                        Height="16"
                                                        Margin="0,0,6,0"
                                                        VerticalAlignment="Center"
                                                        Kind="Check" />
                                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_Watermark_PresetConfirm}" TextWrapping="Wrap" />
                                                </Grid>
                                            </Button>
                                            <Button Padding="0"
                                                Grid.Column="1"
                                                Width="34"
                                                Height="34"
                                                Margin="6,0,0,0"
                                                Click="BtnPresetCancel_Click"
                                                Style="{StaticResource NeutralIconButtonStyle}">
                                                <materialDesign:PackIcon
                                                    Width="16"
                                                    Height="16"
                                                    Kind="Close" />
                                            </Button>
                                        </Grid>
                                    </StackPanel>
                                    <TextBlock x:Name="TxtPresetHint" Style="{StaticResource WmSideHint}" />
                                </StackPanel>
                            </Border>

                            <!--  ============ SAVE TO ============  -->
                            <controls:OutputFolderCard
                                x:Name="OutputCard"
                                Margin="0,10,0,0"
                                ctl:Tour.Key="Str_Tour_Watermark_Output"
                                ctl:Tour.Order="5"
                                AllowSameAsSource="True"
                                ExampleFileName="photo-watermarked.jpg"
                                Header="{DynamicResource Str_Watermark_SaveTo}"
                                HeaderIcon="ContentSaveOutline"
                                SameAsSourceText="{DynamicResource Str_Common_SaveNextToOriginals}"
                                ToolName="Watermarker" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--  ================= MAIN =================  -->

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Run bar: primary action is always top-left, same spot in every tool  -->
                <Border
                    Grid.Row="0"
                    Margin="0,0,0,14"
                    Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="BtnRun"
                            ctl:Tour.Key="Str_Tour_Watermark_Run"
                            ctl:Tour.Order="6"
                            MinHeight="36"
                            MinWidth="170"
                            VerticalAlignment="Center"
                            Click="BtnRun_Click"
                            Style="{StaticResource AccentPrimaryButtonStyle}">
                            <Grid HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon
                                    Grid.Column="0"
                                    x:Name="IconRun"
                                    Width="18"
                                    Height="18"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Kind="Stamper" />
                                <TextBlock
                                    Grid.Column="1"
                                    x:Name="TxtRun"
                                    VerticalAlignment="Center"
                                    Text="{DynamicResource Str_Watermark_Run}" TextWrapping="Wrap" />
                            </Grid>
                        </Button>
                        <Button Padding="0"
                            x:Name="BtnOpenFile"
                            Grid.Column="1"
                            Width="36"
                            Height="36"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Click="BtnOpenFile_Click"
                            IsEnabled="False"
                            Style="{StaticResource ListToolButtonStyle}"
                            ToolTip="{DynamicResource Str_Watermark_OpenFile}">
                            <materialDesign:PackIcon
                                Width="16"
                                Height="16"
                                Kind="OpenInNew" />
                        </Button>
                        <Button Padding="0"
                            x:Name="BtnOpenResult"
                            Grid.Column="2"
                            Width="36"
                            Height="36"
                            Margin="6,0,16,0"
                            VerticalAlignment="Center"
                            Click="BtnOpenResult_Click"
                            IsEnabled="False"
                            Style="{StaticResource ListToolButtonStyle}"
                            ToolTip="{DynamicResource Str_Watermark_OpenResult}">
                            <materialDesign:PackIcon
                                Width="16"
                                Height="16"
                                Kind="FolderSearchOutline" />
                        </Button>
                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                            <ProgressBar
                                x:Name="RunProgress"
                                Height="8"
                                Maximum="100" />
                            <TextBlock
                                x:Name="TxtProgress"
                                Margin="0,6,0,0"
                                FontSize="11.5"
                                Foreground="{DynamicResource TextSecondary}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </StackPanel>
                        <TextBlock
                            x:Name="TxtProgressPercent"
                            Grid.Column="4"
                            MinWidth="54"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="{DynamicResource AccentColor}"
                            TextAlignment="Right" />
                    </Grid>
                </Border>

                <!--  Preview card  -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!--  Header: counts, finished pill  -->
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentControl
                                VerticalAlignment="Center"
                                Content="{DynamicResource Str_Watermark_PreviewHeader}"
                                Style="{StaticResource CardHeader}"
                                Tag="{x:Static materialDesign:PackIconKind.Stamper}" />
                            <WrapPanel
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">
                                <Border
                                    Margin="0,0,6,0"
                                    Background="{DynamicResource RowBg}"
                                    Style="{StaticResource IconStatusPillStyle}">
                                    <TextBlock x:Name="TxtPillCount" Style="{StaticResource WmPillText}" />
                                </Border>
                                <Border
                                    x:Name="PillKinds"
                                    Margin="0,0,6,0"
                                    Background="{DynamicResource RowBg}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    Visibility="Collapsed">
                                    <TextBlock x:Name="TxtPillKinds" Style="{StaticResource WmPillText}" />
                                </Border>
                            </WrapPanel>
                            <Border
                                x:Name="DonePill"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Background="{DynamicResource StatusSuccessBg}"
                                Style="{StaticResource IconStatusPillStyle}"
                                Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="13"
                                        Height="13"
                                        Margin="0,0,5,0"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource StatusSuccessFg}"
                                        Kind="Check" />
                                    <TextBlock
                                        x:Name="TxtDonePill"
                                        FontSize="11.5"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource StatusSuccessFg}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!--  Messages  -->
                        <Border
                            x:Name="StatusBanner"
                            Grid.Row="1"
                            Margin="0,0,0,10"
                            Padding="12,9"
                            HorizontalAlignment="Left"
                            CornerRadius="8"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    x:Name="StatusIcon"
                                    Width="16"
                                    Height="16"
                                    Margin="0,1,8,0"
                                    VerticalAlignment="Top" />
                                <TextBlock
                                    x:Name="TxtStatus"
                                    MaxWidth="760"
                                    FontSize="12.5"
                                    FontWeight="SemiBold"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <!--  List and preview  -->
                        <Grid Grid.Row="2">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition
                                    Width="*"
                                    MinWidth="250"
                                    MaxWidth="380" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="2*" />
                            </Grid.ColumnDefinitions>

                            <Grid
                                x:Name="ListArea"
                                AllowDrop="True"
                                Background="Transparent"
                                DragOver="ListArea_DragOver"
                                Drop="ListArea_Drop">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <WrapPanel Margin="0,0,0,8">
                                    <Button
                                        x:Name="BtnRemoveSelected"
                                        Margin="0,0,4,4"
                                        Click="BtnRemoveSelected_Click"
                                        Style="{StaticResource ListToolButtonStyle}"
                                        ToolTip="{DynamicResource Str_Watermark_RemoveSelected}">
                                        <materialDesign:PackIcon
                                            Width="16"
                                            Height="16"
                                            Kind="PlaylistRemove" />
                                    </Button>
                                </WrapPanel>
                                <Border
                                    Grid.Row="1"
                                    Background="{DynamicResource RowBg}"
                                    BorderBrush="{DynamicResource CardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                    <Grid>
                                        <ListBox
                                            x:Name="FileList"
                                            Padding="6"
                                            Background="Transparent"
                                            BorderThickness="0"
                                            ItemTemplate="{StaticResource FileTemplate}"
                                            KeyDown="FileList_KeyDown"
                                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                            SelectionChanged="FileList_SelectionChanged"
                                            SelectionMode="Extended"
                                            VirtualizingPanel.IsVirtualizing="True" />
                                        <StackPanel
                                            x:Name="ListEmpty"
                                            MaxWidth="240"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsHitTestVisible="False">
                                            <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.FileMultipleOutline}" />
                                            <TextBlock
                                                Margin="0,12,0,0"
                                                HorizontalAlignment="Center"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource TextPrimary}"
                                                Text="{DynamicResource Str_Watermark_EmptyTitle}" />
                                            <TextBlock
                                                Margin="0,6,0,0"
                                                HorizontalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{DynamicResource TextSecondary}"
                                                Text="{DynamicResource Str_Watermark_EmptyHint}"
                                                TextAlignment="Center"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>

                            <Grid Grid.Column="2">
                                <Border
                                    Background="{DynamicResource RowBg}"
                                    BorderBrush="{DynamicResource CardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="12">
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Image
                                            x:Name="PreviewImage"
                                            Margin="14"
                                            RenderOptions.BitmapScalingMode="HighQuality"
                                            Stretch="Uniform" />
                                        <ProgressBar
                                            x:Name="PreviewBusy"
                                            Height="3"
                                            VerticalAlignment="Top"
                                            IsIndeterminate="True"
                                            Visibility="Collapsed" />
                                        <StackPanel
                                            x:Name="PreviewEmpty"
                                            MaxWidth="320"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            IsHitTestVisible="False">
                                            <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.Stamper}" />
                                            <TextBlock
                                                Margin="0,12,0,0"
                                                HorizontalAlignment="Center"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource TextPrimary}"
                                                Text="{DynamicResource Str_Watermark_PreviewEmptyTitle}" />
                                            <TextBlock
                                                Margin="0,6,0,0"
                                                HorizontalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{DynamicResource TextSecondary}"
                                                Text="{DynamicResource Str_Watermark_PreviewEmptyHint}"
                                                TextAlignment="Center"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <TextBlock
                                            x:Name="TxtPreviewNote"
                                            Grid.Row="1"
                                            Margin="14,0,14,10"
                                            FontSize="11.5"
                                            Foreground="{DynamicResource TextSecondary}"
                                            TextTrimming="CharacterEllipsis"
                                            TextWrapping="NoWrap" />
                                    </Grid>
                                </Border>
                            </Grid>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
