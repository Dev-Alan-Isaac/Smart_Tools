<UserControl
    x:Class="Smart_Tools.WPF.Views.PdfReaderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:Smart_Tools.WPF.Models"
    xmlns:views="clr-namespace:Smart_Tools.WPF.Views"
    x:Name="Root"
    d:DesignHeight="760"
    d:DesignWidth="1200"
    AllowDrop="True"
    DragOver="Root_DragOver"
    Drop="Root_Drop"
    Loaded="View_Loaded"
    mc:Ignorable="d">

    <!--
        PDF Reader and Signer - read a PDF, then add text, a date, a signature, a check mark, a cross, a line or a highlight and save a new copy.
        Backend: Controllers/PdfReaderManager.cs; Models/PdfReaderModel.cs. UI only here.
        Code-behind: PdfReaderView.xaml.cs (list, opening, pages), .Marks.cs (things on the page), .Signature.cs (signature + the in-app dialog).
    -->

    <UserControl.Resources>
        <views:ThumbnailConverter x:Key="Thumb" />

        <!--  A PDF in the sidebar list: click to open it, X to take it off the list. The name always gives way to the X.  -->
        <DataTemplate x:Key="FileItemTemplate" DataType="{x:Type models:PdfReaderFile}">
            <Border
                x:Name="Row"
                Background="Transparent"
                BorderBrush="Transparent"
                BorderThickness="1"
                CornerRadius="6"
                Cursor="Hand"
                MouseLeftButtonUp="FileRow_MouseLeftButtonUp"
                ToolTip="{Binding Path}">
                <Grid MinWidth="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" MinWidth="0" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon
                        Width="18"
                        Height="18"
                        Margin="4,0,8,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource StatusErrorFg}"
                        Kind="FilePdfBox" />
                    <TextBlock
                        x:Name="FileName"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource SidebarText}"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis" />
                    <Button
                        Grid.Column="2"
                        Width="24"
                        Height="24"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        Click="BtnRemoveFile_Click"
                        Style="{StaticResource IconButtonStyle}"
                        Tag="{Binding}"
                        ToolTip="{DynamicResource Str_PdfReader_RemoveFile}">
                        <materialDesign:PackIcon
                            Width="13"
                            Height="13"
                            Kind="Close" />
                    </Button>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource SidebarItemHoverBg}" />
                    <Setter TargetName="Row" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                    <Setter TargetName="FileName" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">
        <Grid x:Name="MainLayout" Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OptionsColumn" Width="280" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= SIDEBAR =================  -->

            <Border Grid.Column="0" Style="{StaticResource SidebarPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Button
                            x:Name="BtnCollapseOptions"
                            MinHeight="45"
                            HorizontalContentAlignment="Left"
                            Click="BtnCollapseOptions_Click"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Foreground="{DynamicResource SidebarText}"
                            ToolTip="{DynamicResource Str_Common_SidebarToggleTooltip}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="OverridesDefaultStyle" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Margin="16,0,0,0" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Kind="TuneVariant" />
                                <TextBlock
                                    x:Name="TxtOptionsHeaderLabel"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{DynamicResource Str_Common_OptionsLabel}" />
                            </StackPanel>
                        </Button>
                        <Separator
                            x:Name="SepHeader"
                            Margin="16,4"
                            Style="{StaticResource SidebarSeparatorStyle}" />
                    </StackPanel>

                    <ScrollViewer
                        x:Name="OptionsScrollViewer"
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16,4,16,16">

                            <!--  ============ THE PDFs (one file, or every PDF of a folder; one is open at a time) ============  -->
                            <controls:InputFolderCard
                                x:Name="InputCard"
                                ctl:Tour.Key="Str_Tour_PdfReader_Open"
                                ctl:Tour.Order="1"
                                ClearRequested="InputCard_ClearRequested"
                                Header="{DynamicResource Str_PdfReader_FileHeader}"
                                HeaderIcon="FilePdfBox"
                                ItemTemplate="{StaticResource FileItemTemplate}"
                                PathsAdded="InputCard_PathsAdded"
                                ShowSubfolders="False" />

                            <!--  ============ PASSWORD (only when the PDF needs one) ============  -->
                            <Border
                                x:Name="PanelPasswordCard"
                                Style="{StaticResource SidebarGroupCardStyle}"
                                Visibility="Collapsed">
                                <StackPanel>
                                    <StackPanel x:Name="PanelPassword">
                                        <TextBlock
                                            Margin="0,8,0,6"
                                            Style="{StaticResource FieldLabel}"
                                            Text="{DynamicResource Str_PdfReader_Password}" />
                                        <Border Style="{StaticResource InputBarStyle}">
                                            <PasswordBox x:Name="PwdBox" KeyDown="PwdBox_KeyDown" />
                                        </Border>
                                        <Button
                                            Margin="0,6,0,0"
                                            Click="BtnUnlock_Click"
                                            Content="{DynamicResource Str_PdfReader_Unlock}"
                                            Style="{StaticResource ListToolPrimaryButtonStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!--  ============ SIGNATURE ============  -->
                            <Border
                                ctl:Tour.Key="Str_Tour_PdfReader_Signature"
                                ctl:Tour.Order="2"
                                Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_PdfReader_SignatureHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.Draw}" />
                                    <Border
                                        Height="70"
                                        Background="White"
                                        BorderBrush="{DynamicResource CardBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <Grid>
                                            <Image
                                                x:Name="SigPreview"
                                                Margin="6"
                                                Stretch="Uniform" />
                                            <TextBlock
                                                x:Name="TxtNoSignature"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="11.5"
                                                Foreground="{DynamicResource TextSecondary}"
                                                Text="{DynamicResource Str_PdfReader_NoSignature}" />
                                        </Grid>
                                    </Border>

                                    <!--  Draw and Type side by side; the picture and forget buttons get a full row each so no label has to wrap  -->
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            Margin="0,0,3,0"
                                            Click="BtnSigDraw_Click"
                                            Style="{StaticResource ListToolPrimaryButtonStyle}">
                                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="16"
                                                    Height="16"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Kind="Draw" />
                                                <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_PdfReader_Draw}" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            Grid.Column="1"
                                            Margin="3,0,0,0"
                                            Click="BtnSigType_Click"
                                            Style="{StaticResource ListToolPrimaryButtonStyle}">
                                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="16"
                                                    Height="16"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Kind="FormatText" />
                                                <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_PdfReader_Type}" />
                                            </StackPanel>
                                        </Button>
                                    </Grid>
                                    <Button
                                        Margin="0,6,0,0"
                                        Click="BtnSigPicture_Click"
                                        Style="{StaticResource ListToolPrimaryButtonStyle}">
                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                            <materialDesign:PackIcon
                                                Width="16"
                                                Height="16"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Kind="ImageOutline" />
                                            <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_PdfReader_PictureButton}" />
                                        </StackPanel>
                                    </Button>
                                    <Button
                                        x:Name="BtnSigForget"
                                        Margin="0,6,0,0"
                                        Click="BtnSigForget_Click"
                                        Style="{StaticResource DangerButtonStyle}"
                                        Visibility="Collapsed">
                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                            <materialDesign:PackIcon
                                                Width="16"
                                                Height="16"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Kind="DeleteOutline" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Text="{DynamicResource Str_PdfReader_Forget}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Style="{StaticResource SidebarHint}" Text="{DynamicResource Str_PdfReader_SignatureHint}" />
                                </StackPanel>
                            </Border>

                            <!--  ============ ADD TO THE PAGE (a dropdown: there are more than five kinds) ============  -->
                            <Border
                                ctl:Tour.Key="Str_Tour_PdfReader_Add"
                                ctl:Tour.Order="3"
                                Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_PdfReader_AddHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.PlusBoxOutline}" />
                                    <ComboBox x:Name="CmbAddKind" SelectedIndex="0">
                                        <ComboBoxItem Tag="Signature">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="16"
                                                    Height="16"
                                                    VerticalAlignment="Center"
                                                    Kind="Draw" />
                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Text="{DynamicResource Str_PdfReader_AddSignature}" />
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="Text">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="16"
                                                    Height="16"
                                                    VerticalAlignment="Center"
                                                    Kind="FormatText" />
                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Text="{DynamicResource Str_PdfReader_AddText}" />
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="Date">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="16"
                                                    Height="16"
                                                    VerticalAlignment="Center"
                                                    Kind="CalendarOutline" />
                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Text="{DynamicResource Str_PdfReader_AddDate}" />
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="Check">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="16"
                                                    Height="16"
                                                    VerticalAlignment="Center"
                                                    Kind="Check" />
                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Text="{DynamicResource Str_PdfReader_AddCheck}" />
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="Cross">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="16"
                                                    Height="16"
                                                    VerticalAlignment="Center"
                                                    Kind="Close" />
                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Text="{DynamicResource Str_PdfReader_AddCross}" />
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="Line">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="16"
                                                    Height="16"
                                                    VerticalAlignment="Center"
                                                    Kind="Minus" />
                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Text="{DynamicResource Str_PdfReader_AddLine}" />
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="Highlight">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="16"
                                                    Height="16"
                                                    VerticalAlignment="Center"
                                                    Kind="MarkerCheck" />
                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Text="{DynamicResource Str_PdfReader_AddHighlight}" />
                                            </StackPanel>
                                        </ComboBoxItem>
                                    </ComboBox>
                                    <Button
                                        x:Name="BtnAddMark"
                                        Margin="0,6,0,0"
                                        Click="BtnAddMark_Click"
                                        Style="{StaticResource ListToolPrimaryButtonStyle}">
                                        <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                            <materialDesign:PackIcon
                                                Width="16"
                                                Height="16"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Kind="PlusCircleOutline" />
                                            <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_PdfReader_AddButton}" />
                                        </StackPanel>
                                    </Button>
                                    <TextBlock Style="{StaticResource SidebarHint}" Text="{DynamicResource Str_PdfReader_AddHint}" />
                                </StackPanel>
                            </Border>

                            <!--  ============ SELECTED ============  -->
                            <Border
                                x:Name="PanelSelected"
                                ctl:Tour.Key="Str_Tour_PdfReader_Selected"
                                ctl:Tour.Order="4"
                                Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_PdfReader_SelectedHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.CursorMove}" />
                                    <TextBlock
                                        x:Name="TxtNothingSelected"
                                        Style="{StaticResource SidebarHint}"
                                        Text="{DynamicResource Str_PdfReader_NothingSelected}" />
                                    <StackPanel x:Name="PanelSelectedFields" Visibility="Collapsed">
                                        <StackPanel x:Name="PanelTextField">
                                            <TextBlock
                                                Margin="0,0,0,6"
                                                Style="{StaticResource FieldLabel}"
                                                Text="{DynamicResource Str_PdfReader_Text}" />
                                            <Border Style="{StaticResource InputBarStyle}">
                                                <TextBox
                                                    x:Name="TxtMark"
                                                    Style="{StaticResource BareTextBox}"
                                                    TextChanged="TxtMark_TextChanged" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock
                                            x:Name="LblSize"
                                            Margin="0,10,0,6"
                                            Style="{StaticResource FieldLabel}"
                                            Text="{DynamicResource Str_PdfReader_Size}" />
                                        <Slider
                                            x:Name="SliderSize"
                                            Maximum="72"
                                            Minimum="6"
                                            ValueChanged="SliderSize_ValueChanged" />
                                        <Button
                                            Margin="0,8,0,0"
                                            HorizontalAlignment="Left"
                                            Click="BtnDeleteMark_Click"
                                            Style="{StaticResource ListToolDangerButtonStyle}"
                                            ToolTip="{DynamicResource Str_PdfReader_DeleteMark}">
                                            <materialDesign:PackIcon
                                                Width="16"
                                                Height="16"
                                                Kind="DeleteOutline" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--  ================= MAIN =================  -->

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Save, status, zoom  -->
                <Border Margin="0,0,0,12" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="BtnSave"
                            MinWidth="150"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            ctl:Tour.Key="Str_Tour_PdfReader_Save"
                            ctl:Tour.Order="5"
                            Click="BtnSave_Click"
                            IsEnabled="False"
                            Style="{StaticResource AccentPrimaryButtonStyle}">
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="18"
                                    Height="18"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Kind="ContentSaveOutline" />
                                <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_PdfReader_Save}" />
                            </StackPanel>
                        </Button>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                x:Name="TxtProgress"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextPrimary}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                x:Name="TxtProgressDetail"
                                Margin="0,2,0,0"
                                FontSize="11.5"
                                Foreground="{DynamicResource TextSecondary}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <!--  Badges: how many pages the open PDF has, and which PDF of the list this is, with previous / next  -->
                        <StackPanel
                            Grid.Column="2"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Border
                                x:Name="BadgeFiles"
                                Margin="0,0,6,0"
                                Padding="4,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource AccentColorSubtle}"
                                CornerRadius="10"
                                Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        Width="24"
                                        Height="24"
                                        Click="BtnPrevPdf_Click"
                                        Style="{StaticResource IconButtonStyle}"
                                        ToolTip="{DynamicResource Str_PdfReader_PrevPdf}">
                                        <materialDesign:PackIcon
                                            Width="14"
                                            Height="14"
                                            Kind="ChevronLeft" />
                                    </Button>
                                    <TextBlock
                                        x:Name="TxtFileInfo"
                                        MinWidth="40"
                                        VerticalAlignment="Center"
                                        FontSize="11.5"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource AccentColor}"
                                        TextAlignment="Center" />
                                    <Button
                                        Width="24"
                                        Height="24"
                                        Click="BtnNextPdf_Click"
                                        Style="{StaticResource IconButtonStyle}"
                                        ToolTip="{DynamicResource Str_PdfReader_NextPdf}">
                                        <materialDesign:PackIcon
                                            Width="14"
                                            Height="14"
                                            Kind="ChevronRight" />
                                    </Button>
                                </StackPanel>
                            </Border>
                            <Border
                                x:Name="BadgePages"
                                Padding="9,4"
                                VerticalAlignment="Center"
                                Background="{DynamicResource AccentColorSubtle}"
                                CornerRadius="10"
                                Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="14"
                                        Height="14"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource AccentColor}"
                                        Kind="FileDocumentOutline" />
                                    <TextBlock
                                        x:Name="TxtPageInfo"
                                        Margin="5,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="11.5"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource AccentColor}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>

                        <StackPanel
                            Grid.Column="3"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            ctl:Tour.Key="Str_Tour_PdfReader_Zoom"
                            ctl:Tour.Order="6"
                            Orientation="Horizontal">
                            <Button
                                Click="BtnZoomOut_Click"
                                Style="{StaticResource ListToolButtonStyle}"
                                ToolTip="{DynamicResource Str_PdfReader_ZoomOut}">
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    Kind="MagnifyMinusOutline" />
                            </Button>
                            <TextBlock
                                x:Name="TxtZoom"
                                MinWidth="44"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource TextSecondary}"
                                TextAlignment="Center" />
                            <Button
                                Margin="0,0,4,0"
                                Click="BtnZoomIn_Click"
                                Style="{StaticResource ListToolButtonStyle}"
                                ToolTip="{DynamicResource Str_PdfReader_ZoomIn}">
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    Kind="MagnifyPlusOutline" />
                            </Button>
                            <Button
                                Click="BtnZoomFit_Click"
                                Style="{StaticResource ListToolButtonStyle}"
                                ToolTip="{DynamicResource Str_PdfReader_ZoomFit}">
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    Kind="FitToPageOutline" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  Pages  -->
                <Border
                    Grid.Row="1"
                    ctl:Tour.Key="Str_Tour_PdfReader_Pages"
                    ctl:Tour.Order="7"
                    Style="{StaticResource CardStyle}">
                    <Grid>
                        <ScrollViewer
                            x:Name="Scroller"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="PageList" Margin="0,4,0,4">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:PdfReaderPage}">
                                        <Border
                                            Width="{Binding DisplayWidth}"
                                            Height="{Binding DisplayHeight}"
                                            Margin="0,0,0,14"
                                            HorizontalAlignment="Center"
                                            Background="White"
                                            BorderBrush="{DynamicResource CardBorder}"
                                            BorderThickness="1"
                                            DataContextChanged="PageBorder_DataContextChanged"
                                            Loaded="PageBorder_Loaded">
                                            <Grid ClipToBounds="True">
                                                <Image Source="{Binding Source, Converter={StaticResource Thumb}}" Stretch="Fill" />
                                                <Canvas Background="Transparent" MouseLeftButtonDown="PageCanvas_MouseLeftButtonDown" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel
                            x:Name="PanelEmpty"
                            MaxWidth="440"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            d:Visibility="Collapsed"
                            IsHitTestVisible="False">
                            <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.FilePdfBox}" />
                            <TextBlock
                                Margin="0,12,0,0"
                                HorizontalAlignment="Center"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextPrimary}"
                                Text="{DynamicResource Str_PdfReader_EmptyTitle}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="{DynamicResource Str_PdfReader_EmptyHint}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!--
            In-app dialog (draw / type a signature). The page behind is switched off while it is open. The content is built by the
            code-behind (PdfReaderView.Signature.cs) and put in ModalBody.
        -->
        <Grid
            x:Name="ModalHost"
            Panel.ZIndex="50"
            PreviewKeyDown="Modal_PreviewKeyDown"
            Visibility="Collapsed">
            <Border Background="{DynamicResource TourScrim}" />
            <Border
                MaxWidth="560"
                Margin="24"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock
                        x:Name="ModalTitle"
                        FontSize="16"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        TextTrimming="CharacterEllipsis" />
                    <ContentPresenter x:Name="ModalBody" Margin="0,12,0,14" />
                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button
                            x:Name="BtnModalClear"
                            MinWidth="80"
                            Margin="0,0,8,0"
                            Click="BtnModalClear_Click"
                            Content="{DynamicResource Str_PdfReader_Clear}"
                            Style="{StaticResource ListToolPrimaryButtonStyle}" />
                        <Button
                            MinWidth="80"
                            Margin="0,0,8,0"
                            Click="BtnModalCancel_Click"
                            Content="{DynamicResource Str_PdfReader_Cancel}"
                            Style="{StaticResource ListToolPrimaryButtonStyle}" />
                        <Button
                            MinWidth="80"
                            Click="BtnModalUse_Click"
                            Content="{DynamicResource Str_PdfReader_Use}"
                            Style="{StaticResource AccentPrimaryButtonStyle}" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
