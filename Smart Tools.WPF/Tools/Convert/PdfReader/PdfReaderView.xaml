<UserControl
    x:Class="Smart_Tools.WPF.Views.PdfReaderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:Smart_Tools.WPF.Models"
    xmlns:views="clr-namespace:Smart_Tools.WPF.Views"
    x:Name="Root"
    d:DesignHeight="760"
    d:DesignWidth="1200"
    AllowDrop="True"
    DragOver="Root_DragOver"
    Drop="Root_Drop"
    Loaded="View_Loaded"
    mc:Ignorable="d">

    <!--
        PDF Reader and Signer - read a PDF, then add text, a date, a signature or a check mark and save a new copy.
        Backend: Controllers/PdfReaderManager.cs; Models/PdfReaderModel.cs. UI only here.
    -->

    <UserControl.Resources>
        <views:ThumbnailConverter x:Key="Thumb" />

        <!--  The PDF in the sidebar queue  -->
        <DataTemplate x:Key="FileItemTemplate" DataType="{x:Type models:PdfReaderFile}">
            <TextBlock
                Margin="0,2"
                VerticalAlignment="Center"
                FontSize="12"
                Foreground="{DynamicResource SidebarText}"
                Text="{Binding Name}"
                TextTrimming="CharacterEllipsis"
                ToolTip="{Binding Path}" />
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">
        <Grid Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OptionsColumn" Width="280" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= SIDEBAR =================  -->

            <Border Grid.Column="0" Style="{StaticResource SidebarPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Button
                            x:Name="BtnCollapseOptions"
                            MinHeight="45"
                            HorizontalContentAlignment="Left"
                            Click="BtnCollapseOptions_Click"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Foreground="{DynamicResource SidebarText}"
                            ToolTip="{DynamicResource Str_Common_SidebarToggleTooltip}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="OverridesDefaultStyle" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Margin="16,0,0,0" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Kind="TuneVariant" />
                                <TextBlock
                                    x:Name="TxtOptionsHeaderLabel"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{DynamicResource Str_Common_OptionsLabel}" />
                            </StackPanel>
                        </Button>
                        <Separator
                            x:Name="SepHeader"
                            Margin="16,4"
                            Style="{StaticResource SidebarSeparatorStyle}" />
                    </StackPanel>

                    <ScrollViewer
                        x:Name="OptionsScrollViewer"
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16,4,16,16">

                            <!--  ============ THE PDF ============  -->
                            <controls:InputFolderCard
                                x:Name="InputCard"
                                ctl:Tour.Key="Str_Tour_PdfReader_Open"
                                ctl:Tour.Order="1"
                                ClearRequested="InputCard_ClearRequested"
                                Header="{DynamicResource Str_PdfReader_FileHeader}"
                                HeaderIcon="FilePdfBox"
                                ItemTemplate="{StaticResource FileItemTemplate}"
                                PathsAdded="InputCard_PathsAdded"
                                ShowSubfolders="False" />
                            <TextBlock
                                x:Name="TxtPageInfo"
                                Margin="4,0,4,8"
                                Style="{StaticResource SidebarHint}" />

                            <!--  ============ PASSWORD (only when the PDF needs one) ============  -->
                            <Border
                                x:Name="PanelPasswordCard"
                                Style="{StaticResource SidebarGroupCardStyle}"
                                Visibility="Collapsed">
                                <StackPanel>
                                    <StackPanel x:Name="PanelPassword">
                                        <TextBlock
                                            Margin="0,8,0,6"
                                            Style="{StaticResource FieldLabel}"
                                            Text="{DynamicResource Str_PdfReader_Password}" />
                                        <Border Style="{StaticResource InputBarStyle}">
                                            <PasswordBox x:Name="PwdBox" KeyDown="PwdBox_KeyDown" />
                                        </Border>
                                        <Button
                                            Margin="0,6,0,0"
                                            Click="BtnUnlock_Click"
                                            Content="{DynamicResource Str_PdfReader_Unlock}"
                                            Style="{StaticResource ListToolPrimaryButtonStyle}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!--  ============ SIGNATURE ============  -->
                            <Border
                                ctl:Tour.Key="Str_Tour_PdfReader_Signature"
                                ctl:Tour.Order="2"
                                Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_PdfReader_SignatureHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.Draw}" />
                                    <Border
                                        Height="70"
                                        Background="White"
                                        BorderBrush="{DynamicResource CardBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <Grid>
                                            <Image
                                                x:Name="SigPreview"
                                                Margin="6"
                                                Stretch="Uniform" />
                                            <TextBlock
                                                x:Name="TxtNoSignature"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                FontSize="11.5"
                                                Foreground="{DynamicResource TextSecondary}"
                                                Text="{DynamicResource Str_PdfReader_NoSignature}" />
                                        </Grid>
                                    </Border>
                                    <UniformGrid Margin="0,8,0,0" Columns="3">
                                        <Button
                                            Margin="0,0,3,0"
                                            Click="BtnSigDraw_Click"
                                            Content="{DynamicResource Str_PdfReader_Draw}"
                                            Style="{StaticResource ListToolPrimaryButtonStyle}" />
                                        <Button
                                            Margin="3,0,3,0"
                                            Click="BtnSigType_Click"
                                            Content="{DynamicResource Str_PdfReader_Type}"
                                            Style="{StaticResource ListToolPrimaryButtonStyle}" />
                                        <Button
                                            Margin="3,0,0,0"
                                            Click="BtnSigPicture_Click"
                                            Content="{DynamicResource Str_PdfReader_Picture}"
                                            Style="{StaticResource ListToolPrimaryButtonStyle}" />
                                    </UniformGrid>
                                    <Button
                                        x:Name="BtnSigForget"
                                        Margin="0,6,0,0"
                                        HorizontalAlignment="Left"
                                        Click="BtnSigForget_Click"
                                        Content="{DynamicResource Str_PdfReader_Forget}"
                                        Style="{StaticResource ListToolDangerButtonStyle}"
                                        Visibility="Collapsed" />
                                    <TextBlock Style="{StaticResource SidebarHint}" Text="{DynamicResource Str_PdfReader_SignatureHint}" />
                                </StackPanel>
                            </Border>

                            <!--  ============ ADD TO THE PAGE ============  -->
                            <Border
                                ctl:Tour.Key="Str_Tour_PdfReader_Add"
                                ctl:Tour.Order="3"
                                Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_PdfReader_AddHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.PlusBoxOutline}" />
                                    <UniformGrid Columns="2">
                                        <Button
                                            x:Name="BtnAddSignature"
                                            Margin="0,0,3,6"
                                            Click="BtnAddSignature_Click"
                                            Content="{DynamicResource Str_PdfReader_AddSignature}"
                                            Style="{StaticResource ListToolPrimaryButtonStyle}" />
                                        <Button
                                            x:Name="BtnAddText"
                                            Margin="3,0,0,6"
                                            Click="BtnAddText_Click"
                                            Content="{DynamicResource Str_PdfReader_AddText}"
                                            Style="{StaticResource ListToolPrimaryButtonStyle}" />
                                        <Button
                                            x:Name="BtnAddDate"
                                            Margin="0,0,3,0"
                                            Click="BtnAddDate_Click"
                                            Content="{DynamicResource Str_PdfReader_AddDate}"
                                            Style="{StaticResource ListToolPrimaryButtonStyle}" />
                                        <Button
                                            x:Name="BtnAddCheck"
                                            Margin="3,0,0,0"
                                            Click="BtnAddCheck_Click"
                                            Content="{DynamicResource Str_PdfReader_AddCheck}"
                                            Style="{StaticResource ListToolPrimaryButtonStyle}" />
                                    </UniformGrid>
                                    <TextBlock Style="{StaticResource SidebarHint}" Text="{DynamicResource Str_PdfReader_AddHint}" />
                                </StackPanel>
                            </Border>

                            <!--  ============ SELECTED ============  -->
                            <Border
                                x:Name="PanelSelected"
                                ctl:Tour.Key="Str_Tour_PdfReader_Selected"
                                ctl:Tour.Order="4"
                                Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_PdfReader_SelectedHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.CursorMove}" />
                                    <TextBlock
                                        x:Name="TxtNothingSelected"
                                        Style="{StaticResource SidebarHint}"
                                        Text="{DynamicResource Str_PdfReader_NothingSelected}" />
                                    <StackPanel x:Name="PanelSelectedFields" Visibility="Collapsed">
                                        <StackPanel x:Name="PanelTextField">
                                            <TextBlock
                                                Margin="0,0,0,6"
                                                Style="{StaticResource FieldLabel}"
                                                Text="{DynamicResource Str_PdfReader_Text}" />
                                            <Border Style="{StaticResource InputBarStyle}">
                                                <TextBox
                                                    x:Name="TxtMark"
                                                    Style="{StaticResource BareTextBox}"
                                                    TextChanged="TxtMark_TextChanged" />
                                            </Border>
                                        </StackPanel>
                                        <TextBlock
                                            x:Name="LblSize"
                                            Margin="0,10,0,6"
                                            Style="{StaticResource FieldLabel}"
                                            Text="{DynamicResource Str_PdfReader_Size}" />
                                        <Slider
                                            x:Name="SliderSize"
                                            Maximum="72"
                                            Minimum="6"
                                            ValueChanged="SliderSize_ValueChanged" />
                                        <Button
                                            Margin="0,8,0,0"
                                            HorizontalAlignment="Left"
                                            Click="BtnDeleteMark_Click"
                                            Style="{StaticResource ListToolDangerButtonStyle}"
                                            ToolTip="{DynamicResource Str_PdfReader_DeleteMark}">
                                            <materialDesign:PackIcon
                                                Width="16"
                                                Height="16"
                                                Kind="DeleteOutline" />
                                        </Button>
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--  ================= MAIN =================  -->

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Save, status, zoom  -->
                <Border Margin="0,0,0,12" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="BtnSave"
                            MinWidth="150"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            ctl:Tour.Key="Str_Tour_PdfReader_Save"
                            ctl:Tour.Order="5"
                            Click="BtnSave_Click"
                            IsEnabled="False"
                            Style="{StaticResource AccentPrimaryButtonStyle}">
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="18"
                                    Height="18"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Kind="ContentSaveOutline" />
                                <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_PdfReader_Save}" />
                            </StackPanel>
                        </Button>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                x:Name="TxtProgress"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextPrimary}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                x:Name="TxtProgressDetail"
                                Margin="0,2,0,0"
                                FontSize="11.5"
                                Foreground="{DynamicResource TextSecondary}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <StackPanel
                            Grid.Column="2"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            ctl:Tour.Key="Str_Tour_PdfReader_Zoom"
                            ctl:Tour.Order="6"
                            Orientation="Horizontal">
                            <Button
                                Click="BtnZoomOut_Click"
                                Style="{StaticResource ListToolButtonStyle}"
                                ToolTip="{DynamicResource Str_PdfReader_ZoomOut}">
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    Kind="MagnifyMinusOutline" />
                            </Button>
                            <TextBlock
                                x:Name="TxtZoom"
                                MinWidth="44"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource TextSecondary}"
                                TextAlignment="Center" />
                            <Button
                                Margin="0,0,4,0"
                                Click="BtnZoomIn_Click"
                                Style="{StaticResource ListToolButtonStyle}"
                                ToolTip="{DynamicResource Str_PdfReader_ZoomIn}">
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    Kind="MagnifyPlusOutline" />
                            </Button>
                            <Button
                                Click="BtnZoomFit_Click"
                                Style="{StaticResource ListToolButtonStyle}"
                                ToolTip="{DynamicResource Str_PdfReader_ZoomFit}">
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    Kind="FitToPageOutline" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  Pages  -->
                <Border
                    Grid.Row="1"
                    ctl:Tour.Key="Str_Tour_PdfReader_Pages"
                    ctl:Tour.Order="7"
                    Style="{StaticResource CardStyle}">
                    <Grid>
                        <ScrollViewer
                            x:Name="Scroller"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="PageList" Margin="0,4,0,4">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <VirtualizingStackPanel IsVirtualizing="True" VirtualizationMode="Recycling" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:PdfReaderPage}">
                                        <Border
                                            Width="{Binding DisplayWidth}"
                                            Height="{Binding DisplayHeight}"
                                            Margin="0,0,0,14"
                                            HorizontalAlignment="Center"
                                            Background="White"
                                            BorderBrush="{DynamicResource CardBorder}"
                                            BorderThickness="1"
                                            DataContextChanged="PageBorder_DataContextChanged"
                                            Loaded="PageBorder_Loaded">
                                            <Grid ClipToBounds="True">
                                                <Image Source="{Binding Source, Converter={StaticResource Thumb}}" Stretch="Fill" />
                                                <Canvas Background="Transparent" MouseLeftButtonDown="PageCanvas_MouseLeftButtonDown" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </ScrollViewer>

                        <StackPanel
                            x:Name="PanelEmpty"
                            MaxWidth="440"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            d:Visibility="Collapsed"
                            IsHitTestVisible="False">
                            <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.FilePdfBox}" />
                            <TextBlock
                                Margin="0,12,0,0"
                                HorizontalAlignment="Center"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextPrimary}"
                                Text="{DynamicResource Str_PdfReader_EmptyTitle}" />
                            <TextBlock
                                Margin="0,4,0,0"
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="{DynamicResource Str_PdfReader_EmptyHint}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
