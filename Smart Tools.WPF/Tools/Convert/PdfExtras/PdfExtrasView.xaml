<UserControl
    x:Class="Smart_Tools.WPF.Views.PdfExtrasView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:Smart_Tools.WPF.Models"
    x:Name="Root"
    d:DesignHeight="760"
    d:DesignWidth="1200"
    AllowDrop="True"
    DragLeave="Root_DragLeave"
    DragOver="Root_DragOver"
    Drop="Root_Drop"
    Loaded="View_Loaded"
    mc:Ignorable="d">

    <!--
        PDF Extras - rotate pages, remove or keep pages, add page numbers, edit properties, add or remove a password.
        One PDF at a time, always saved as a new file. Backend: Controllers/PdfExtrasManager.cs; Models/PdfExtrasModel.cs. UI only here.
    -->

    <UserControl.Resources>
        <!--  One operation toggle: icon above its label  -->
        <Style
            x:Key="OperationToggle"
            BasedOn="{StaticResource ModeToggleTallStyle}"
            TargetType="RadioButton">
            <Setter Property="GroupName" Value="PdfExtraOperation" />
            <Setter Property="Margin" Value="0,0,4,4" />
        </Style>

        <!--  One page in the page editor  -->
        <DataTemplate x:Key="PageTileTemplate" DataType="{x:Type models:PdfPageTile}">
            <Border
                x:Name="Tile"
                Width="132"
                Margin="4"
                Padding="6"
                Background="{DynamicResource RowBg}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1"
                CornerRadius="8"
                ToolTip="{Binding Tip}">
                <StackPanel>
                    <Grid Height="172">
                        <Border Background="{DynamicResource InputBg}" CornerRadius="4">
                            <Grid>
                                <materialDesign:PackIcon
                                    Width="28"
                                    Height="28"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Kind="FileOutline"
                                    Opacity="0.5" />
                                <Image
                                    Margin="3"
                                    RenderOptions.BitmapScalingMode="HighQuality"
                                    Source="{Binding Thumb}"
                                    Stretch="Uniform">
                                    <Image.LayoutTransform>
                                        <RotateTransform Angle="{Binding ExtraRotation}" />
                                    </Image.LayoutTransform>
                                </Image>
                            </Grid>
                        </Border>
                        <Border
                            MinWidth="22"
                            Margin="4"
                            Padding="6,1"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Top"
                            Background="{DynamicResource AccentFill}"
                            CornerRadius="9">
                            <TextBlock
                                HorizontalAlignment="Center"
                                FontSize="11"
                                FontWeight="Bold"
                                Foreground="White"
                                Text="{Binding Number}" />
                        </Border>
                        <Border
                            x:Name="BlankBadge"
                            Margin="4"
                            Padding="6,1"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top"
                            Background="{DynamicResource StatusWarningBg}"
                            CornerRadius="9"
                            Visibility="Collapsed">
                            <TextBlock
                                FontSize="10.5"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource StatusWarningFg}"
                                Text="{DynamicResource Str_PdfX_TileBlank}" />
                        </Border>
                    </Grid>
                    <TextBlock
                        Margin="0,6,0,0"
                        HorizontalAlignment="Center"
                        FontSize="11"
                        Foreground="{DynamicResource TextSecondary}"
                        Text="{Binding Caption}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsMarkedBlank}" Value="True">
                    <Setter TargetName="BlankBadge" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource StatusWarningFg}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  The tile's frame follows the list selection  -->
        <Style x:Key="PageTileItemStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
                            x:Name="Frame"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="2"
                            CornerRadius="10">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentColorSubtle}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Frame" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!--  Grid: list position (the merge order)  -->
        <DataTemplate x:Key="NumberCellTemplate" DataType="{x:Type models:PdfToolItem}">
            <Border
                x:Name="Badge"
                MinWidth="24"
                Padding="5,1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource AccentColorSubtle}"
                CornerRadius="8">
                <TextBlock
                    x:Name="Num"
                    HorizontalAlignment="Center"
                    FontSize="11"
                    FontWeight="Bold"
                    Foreground="{DynamicResource AccentColor}"
                    Text="{Binding Number}"
                    TextTrimming="CharacterEllipsis" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsIncluded}" Value="False">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource RowBg}" />
                    <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource TextSecondary}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  Grid: icon + name + folder  -->
        <DataTemplate x:Key="NameCellTemplate" DataType="{x:Type models:PdfToolItem}">
            <Grid x:Name="NamePanel" ToolTip="{Binding FullPath}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="30"
                    Height="30"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    Background="{DynamicResource StatusErrorBg}"
                    CornerRadius="7">
                    <materialDesign:PackIcon
                        Width="17"
                        Height="17"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource StatusErrorFg}"
                        Kind="FilePdfBox" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        Foreground="{DynamicResource TextPrimary}"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Margin="0,1,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource TextSecondary}"
                        Text="{Binding Folder}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsIncluded}" Value="False">
                    <Setter TargetName="NamePanel" Property="Opacity" Value="0.5" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  Grid: page count ("?" when the PDF can't be opened - the reason is in the tooltip)  -->
        <DataTemplate x:Key="PagesCellTemplate" DataType="{x:Type models:PdfToolItem}">
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextPrimary}"
                Text="{Binding Pages}"
                TextTrimming="CharacterEllipsis"
                ToolTip="{Binding Message}" />
        </DataTemplate>

        <!--  Grid: status chip. The reason or where it was saved is in the tooltip.  -->
        <DataTemplate x:Key="StatusCellTemplate" DataType="{x:Type models:PdfToolItem}">
            <Border
                x:Name="Chip"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="{DynamicResource RowBg}"
                Style="{StaticResource IconStatusPillStyle}"
                ToolTip="{Binding Message}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon
                        x:Name="ChipIcon"
                        Width="12"
                        Height="12"
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextSecondary}"
                        Kind="ClockOutline" />
                    <TextBlock
                        x:Name="ChipText"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextSecondary}"
                        Text="{Binding StatusText}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Working">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusInfoBg}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="ProgressClock" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource StatusInfoFg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusInfoFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Done">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusSuccessBg}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="CheckCircleOutline" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource StatusSuccessFg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusSuccessFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Skipped">
                    <Setter TargetName="ChipIcon" Property="Kind" Value="MinusCircleOutline" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusErrorBg}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="AlertCircleOutline" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusWarningBg}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="CloseCircleOutline" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  Grid: outcome ("12 files", "4.2 MB → 1.3 MB (−69%)")  -->
        <DataTemplate x:Key="ResultCellTemplate" DataType="{x:Type models:PdfToolItem}">
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextSecondary}"
                Text="{Binding Result}"
                TextTrimming="CharacterEllipsis"
                ToolTip="{Binding Message}" />
        </DataTemplate>

        <!--  Small info note used in the option cards  -->
        <Style x:Key="NoteText" TargetType="TextBlock">
            <Setter Property="Margin" Value="2,8,0,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>


        <!--  Input card: one queued item  -->
        <DataTemplate x:Key="QueueItemTemplate" DataType="{x:Type models:PdfToolkitGroup}">
            <Grid ToolTip="{Binding ToolTip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="26"
                    Height="26"
                    Margin="0,0,8,0"
                    Background="{DynamicResource AccentColorSubtle}"
                    CornerRadius="7">
                    <materialDesign:PackIcon
                        x:Name="GroupIcon"
                        Width="14"
                        Height="14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource AccentColor}"
                        Kind="FileMultipleOutline" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource SidebarText}"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Margin="0,1,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource SidebarTextMuted}"
                        Text="{Binding Subtitle}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button
                    Grid.Column="2"
                    Width="24"
                    Height="24"
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    Click="BtnRemoveGroup_Click"
                    Style="{StaticResource IconButtonStyle}"
                    Tag="{Binding}"
                    ToolTip="{DynamicResource Str_PdfToolkit_TakeThesePdfsOff}">
                    <materialDesign:PackIcon
                        Width="13"
                        Height="13"
                        Kind="Close" />
                </Button>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                    <Setter TargetName="GroupIcon" Property="Kind" Value="Folder" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">

        <!--  No page header: MainWindow's header card shows the tool's icon and name.  -->

        <Grid Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OptionsColumn" Width="280" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= OPTIONS SIDEBAR =================  -->
            <Border Grid.Column="0" Style="{StaticResource SidebarPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Button
                            x:Name="BtnCollapseOptions"
                            MinHeight="45"
                            HorizontalContentAlignment="Left"
                            Click="BtnCollapseOptions_Click"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Foreground="{DynamicResource SidebarText}"
                            ToolTip="{DynamicResource Str_Common_SidebarToggleTooltip}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="OverridesDefaultStyle" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Margin="16,0,0,0" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Kind="TuneVariant" />
                                <TextBlock
                                    x:Name="TxtOptionsHeaderLabel"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{DynamicResource Str_Common_OptionsLabel}" />
                            </StackPanel>
                        </Button>
                        <Separator
                            x:Name="SepHeader"
                            Margin="16,4"
                            Style="{StaticResource SidebarSeparatorStyle}" />
                    </StackPanel>

                    <ScrollViewer
                        x:Name="OptionsScrollViewer"
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16,4,16,16">


                            <!--  ============ FILES ============  -->
                            <controls:InputFolderCard
                                x:Name="InputCard"
                                ctl:Tour.Key="Str_Tour_PdfExtras_Input"
                                ctl:Tour.Order="2"
                                ClearRequested="InputCard_ClearRequested"
                                Header="{DynamicResource Str_Common_Files}"
                                HeaderIcon="FileMultipleOutline"
                                IncludeSubfoldersChanged="InputCard_IncludeSubfoldersChanged"
                                ItemTemplate="{StaticResource QueueItemTemplate}"
                                PathsAdded="InputCard_PathsAdded" />


                            <!--  ============ ACTION ============  -->
                            <Border
                                ctl:Tour.Key="Str_Tour_PdfExtras_Action"
                                ctl:Tour.Order="1"
                                Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_PdfX_ActionHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.FileDocumentEditOutline}" />
                                    <ComboBox x:Name="CmbOperation" SelectionChanged="Operation_SelectionChanged">
                                        <ComboBoxItem Tag="Rotate">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="16"
                                                    Height="16"
                                                    VerticalAlignment="Center"
                                                    Kind="RotateRight" />
                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Text="{DynamicResource Str_PdfX_OpRotate}" />
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="Pages">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="16"
                                                    Height="16"
                                                    VerticalAlignment="Center"
                                                    Kind="FileRemoveOutline" />
                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Text="{DynamicResource Str_PdfX_OpPages}" />
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="PageNumbers">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="16"
                                                    Height="16"
                                                    VerticalAlignment="Center"
                                                    Kind="Numeric" />
                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Text="{DynamicResource Str_PdfX_OpNumbers}" />
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="Properties">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="16"
                                                    Height="16"
                                                    VerticalAlignment="Center"
                                                    Kind="TagTextOutline" />
                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Text="{DynamicResource Str_PdfX_OpProperties}" />
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="Protect">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="16"
                                                    Height="16"
                                                    VerticalAlignment="Center"
                                                    Kind="LockOutline" />
                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Text="{DynamicResource Str_PdfX_OpProtect}" />
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="Unlock">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="16"
                                                    Height="16"
                                                    VerticalAlignment="Center"
                                                    Kind="LockOpenVariantOutline" />
                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Text="{DynamicResource Str_PdfX_OpUnlock}" />
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="Crop">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="16"
                                                    Height="16"
                                                    VerticalAlignment="Center"
                                                    Kind="Crop" />
                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Text="{DynamicResource Str_PdfX_OpCrop}" />
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="PageSize">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="16"
                                                    Height="16"
                                                    VerticalAlignment="Center"
                                                    Kind="ArrowExpandAll" />
                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Text="{DynamicResource Str_PdfX_OpSize}" />
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="Arrange">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="16"
                                                    Height="16"
                                                    VerticalAlignment="Center"
                                                    Kind="ViewGrid" />
                                                <TextBlock
                                                    Margin="8,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Text="{DynamicResource Str_PdfX_OpArrange}" />
                                            </StackPanel>
                                        </ComboBoxItem>
                                    </ComboBox>
                                    <TextBlock x:Name="TxtOperationHint" Style="{StaticResource SidebarHint}" />
                                </StackPanel>
                            </Border>

                            <!--  ============ ROTATE ============  -->
                            <Border x:Name="PanelRotate" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_PdfX_RotateHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.RotateRight}" />
                                    <UniformGrid Columns="3">
                                        <RadioButton
                                            x:Name="RbDeg90"
                                            Margin="0,0,2,0"
                                            Click="Setting_Click"
                                            Content="{DynamicResource Str_PdfX_Right90}"
                                            GroupName="PdfExtraDegrees"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="90" />
                                        <RadioButton
                                            x:Name="RbDeg180"
                                            Margin="2,0"
                                            Click="Setting_Click"
                                            Content="180°"
                                            GroupName="PdfExtraDegrees"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="180" />
                                        <RadioButton
                                            x:Name="RbDeg270"
                                            Margin="2,0,0,0"
                                            Click="Setting_Click"
                                            Content="{DynamicResource Str_PdfX_Left90}"
                                            GroupName="PdfExtraDegrees"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="270" />
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!--  ============ CROP ============  -->
                            <Border x:Name="PanelCrop" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_PdfX_CropHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.Crop}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Margin="0,0,0,10">
                                            <TextBlock
                                                Margin="0,0,0,6"
                                                Style="{StaticResource FieldLabel}"
                                                Text="{DynamicResource Str_PdfX_CropTop}" />
                                            <Border Style="{StaticResource InputBarStyle}">
                                                <TextBox
                                                    x:Name="TxtCropTop"
                                                    Style="{StaticResource BareTextBox}"
                                                    Text="0"
                                                    TextChanged="Setting_TextChanged" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2" Margin="0,0,0,10">
                                            <TextBlock
                                                Margin="0,0,0,6"
                                                Style="{StaticResource FieldLabel}"
                                                Text="{DynamicResource Str_PdfX_CropRight}" />
                                            <Border Style="{StaticResource InputBarStyle}">
                                                <TextBox
                                                    x:Name="TxtCropRight"
                                                    Style="{StaticResource BareTextBox}"
                                                    Text="0"
                                                    TextChanged="Setting_TextChanged" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1">
                                            <TextBlock
                                                Margin="0,0,0,6"
                                                Style="{StaticResource FieldLabel}"
                                                Text="{DynamicResource Str_PdfX_CropBottom}" />
                                            <Border Style="{StaticResource InputBarStyle}">
                                                <TextBox
                                                    x:Name="TxtCropBottom"
                                                    Style="{StaticResource BareTextBox}"
                                                    Text="0"
                                                    TextChanged="Setting_TextChanged" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Row="1" Grid.Column="2">
                                            <TextBlock
                                                Margin="0,0,0,6"
                                                Style="{StaticResource FieldLabel}"
                                                Text="{DynamicResource Str_PdfX_CropLeft}" />
                                            <Border Style="{StaticResource InputBarStyle}">
                                                <TextBox
                                                    x:Name="TxtCropLeft"
                                                    Style="{StaticResource BareTextBox}"
                                                    Text="0"
                                                    TextChanged="Setting_TextChanged" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock x:Name="TxtCropNote" Style="{StaticResource SidebarHint}" />
                                    <TextBlock Style="{StaticResource SidebarHint}" Text="{DynamicResource Str_PdfX_CropWarning}" />
                                </StackPanel>
                            </Border>

                            <!--  ============ PAGE SIZE ============  -->
                            <Border x:Name="PanelSize" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_PdfX_SizeHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.ArrowExpandAll}" />
                                    <TextBlock
                                        Margin="0,0,0,6"
                                        Style="{StaticResource FieldLabel}"
                                        Text="{DynamicResource Str_PdfX_Paper}" />
                                    <ComboBox x:Name="CmbPaper" SelectionChanged="Setting_SelectionChanged" />
                                    <TextBlock Style="{StaticResource SidebarHint}" Text="{DynamicResource Str_PdfX_SizeNote}" />
                                </StackPanel>
                            </Border>

                            <!--  ============ PAGE EDITOR ============  -->
                            <Border x:Name="PanelArrange" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_PdfX_ArrangeHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.ViewGrid}" />
                                    <TextBlock
                                        Margin="0,0,0,6"
                                        Style="{StaticResource FieldLabel}"
                                        Text="{DynamicResource Str_PdfX_BlankFinder}" />
                                    <ComboBox x:Name="CmbBlank" SelectionChanged="Blank_SelectionChanged" />
                                    <TextBlock Style="{StaticResource SidebarHint}" Text="{DynamicResource Str_PdfX_BlankNote}" />
                                    <TextBlock Style="{StaticResource SidebarHint}" Text="{DynamicResource Str_PdfX_ArrangeNote}" />
                                </StackPanel>
                            </Border>
                            <!--  ============ WHICH PAGES (rotate, crop, page size) ============  -->
                            <Border x:Name="PanelScope" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_PdfX_ScopeHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.FileDocumentMultipleOutline}" />
                                    <Border Style="{StaticResource InputBarStyle}">
                                        <TextBox
                                            x:Name="TxtRotatePages"
                                            Style="{StaticResource BareTextBox}"
                                            Tag="{DynamicResource Str_PdfX_RotatePagesHint}"
                                            TextChanged="Setting_TextChanged" />
                                    </Border>
                                    <TextBlock x:Name="TxtRotatePagesNote" Style="{StaticResource SidebarHint}" />
                                </StackPanel>
                            </Border>

                            <!--  ============ REMOVE / KEEP PAGES ============  -->
                            <Border x:Name="PanelPages" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_PdfX_PagesHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.FileRemoveOutline}" />
                                    <UniformGrid Columns="2">
                                        <RadioButton
                                            x:Name="RbRemove"
                                            Margin="0,0,2,0"
                                            Click="Setting_Click"
                                            Content="{DynamicResource Str_PdfX_Remove}"
                                            GroupName="PdfExtraPagesMode"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="Remove" />
                                        <RadioButton
                                            x:Name="RbKeep"
                                            Margin="2,0,0,0"
                                            Click="Setting_Click"
                                            Content="{DynamicResource Str_PdfX_KeepOnly}"
                                            GroupName="PdfExtraPagesMode"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="KeepOnly" />
                                    </UniformGrid>
                                    <TextBlock
                                        Margin="0,12,0,6"
                                        Style="{StaticResource FieldLabel}"
                                        Text="{DynamicResource Str_PdfX_Pages}" />
                                    <Border Style="{StaticResource InputBarStyle}">
                                        <TextBox
                                            x:Name="TxtPages"
                                            Style="{StaticResource BareTextBox}"
                                            Tag="{DynamicResource Str_PdfX_PagesHint}"
                                            TextChanged="Setting_TextChanged" />
                                    </Border>
                                    <TextBlock x:Name="TxtPagesNote" Style="{StaticResource SidebarHint}" />
                                </StackPanel>
                            </Border>

                            <!--  ============ PAGE NUMBERS ============  -->
                            <Border x:Name="PanelNumbers" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_PdfX_NumbersHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.Numeric}" />
                                    <TextBlock
                                        Margin="0,0,0,6"
                                        Style="{StaticResource FieldLabel}"
                                        Text="{DynamicResource Str_PdfX_Position}" />
                                    <ComboBox x:Name="CmbPosition" SelectionChanged="Setting_SelectionChanged" />
                                    <TextBlock
                                        Margin="0,12,0,6"
                                        Style="{StaticResource FieldLabel}"
                                        Text="{DynamicResource Str_PdfX_NumberFormat}" />
                                    <ComboBox x:Name="CmbFormat" SelectionChanged="Setting_SelectionChanged" />
                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock
                                                Margin="0,0,0,6"
                                                Style="{StaticResource FieldLabel}"
                                                Text="{DynamicResource Str_PdfX_StartAt}" />
                                            <Border Style="{StaticResource InputBarStyle}">
                                                <TextBox
                                                    x:Name="TxtStart"
                                                    Style="{StaticResource BareTextBox}"
                                                    Text="1"
                                                    TextChanged="Setting_TextChanged" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock
                                                Margin="0,0,0,6"
                                                Style="{StaticResource FieldLabel}"
                                                Text="{DynamicResource Str_PdfX_TextSize}" />
                                            <ComboBox x:Name="CmbSize" SelectionChanged="Setting_SelectionChanged" />
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox
                                        x:Name="ChkSkipFirst"
                                        Margin="0,12,0,0"
                                        Click="Setting_Click"
                                        Content="{DynamicResource Str_PdfX_SkipFirst}"
                                        ToolTip="{DynamicResource Str_PdfX_SkipFirstTip}" />
                                    <TextBlock x:Name="TxtNumbersPreview" Style="{StaticResource SidebarHint}" />
                                </StackPanel>
                            </Border>

                            <!--  ============ PROPERTIES ============  -->
                            <Border x:Name="PanelProperties" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_PdfX_PropertiesHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.TagTextOutline}" />
                                    <CheckBox
                                        x:Name="ChkCleanAll"
                                        Margin="0,0,0,12"
                                        Click="Setting_Click"
                                        Content="{DynamicResource Str_PdfX_CleanAll}"
                                        ToolTip="{DynamicResource Str_PdfX_CleanAllTip}" />
                                    <TextBlock
                                        Margin="0,0,0,6"
                                        Style="{StaticResource FieldLabel}"
                                        Text="{DynamicResource Str_PdfX_PropTitle}" />
                                    <Border Style="{StaticResource InputBarStyle}">
                                        <TextBox
                                            x:Name="TxtTitle"
                                            Style="{StaticResource BareTextBox}"
                                            TextChanged="Setting_TextChanged" />
                                    </Border>
                                    <TextBlock
                                        Margin="0,12,0,6"
                                        Style="{StaticResource FieldLabel}"
                                        Text="{DynamicResource Str_PdfX_PropAuthor}" />
                                    <Border Style="{StaticResource InputBarStyle}">
                                        <TextBox
                                            x:Name="TxtAuthor"
                                            Style="{StaticResource BareTextBox}"
                                            TextChanged="Setting_TextChanged" />
                                    </Border>
                                    <TextBlock
                                        Margin="0,12,0,6"
                                        Style="{StaticResource FieldLabel}"
                                        Text="{DynamicResource Str_PdfX_PropSubject}" />
                                    <Border Style="{StaticResource InputBarStyle}">
                                        <TextBox
                                            x:Name="TxtSubject"
                                            Style="{StaticResource BareTextBox}"
                                            TextChanged="Setting_TextChanged" />
                                    </Border>
                                    <TextBlock
                                        Margin="0,12,0,6"
                                        Style="{StaticResource FieldLabel}"
                                        Text="{DynamicResource Str_PdfX_PropKeywords}" />
                                    <Border Style="{StaticResource InputBarStyle}">
                                        <TextBox
                                            x:Name="TxtKeywords"
                                            Style="{StaticResource BareTextBox}"
                                            TextChanged="Setting_TextChanged" />
                                    </Border>
                                    <TextBlock Style="{StaticResource SidebarHint}" Text="{DynamicResource Str_PdfX_PropertiesNote}" />
                                </StackPanel>
                            </Border>

                            <!--  ============ PROTECT ============  -->
                            <Border x:Name="PanelProtect" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_PdfX_ProtectHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.LockOutline}" />
                                    <TextBlock
                                        Margin="0,0,0,6"
                                        Style="{StaticResource FieldLabel}"
                                        Text="{DynamicResource Str_PdfX_UserPassword}" />
                                    <PasswordBox x:Name="PwdUser" PasswordChanged="Setting_PasswordChanged" />
                                    <TextBlock Style="{StaticResource SidebarHint}" Text="{DynamicResource Str_PdfX_UserPasswordNote}" />
                                    <TextBlock
                                        Margin="0,12,0,6"
                                        Style="{StaticResource FieldLabel}"
                                        Text="{DynamicResource Str_PdfX_OwnerPassword}" />
                                    <PasswordBox x:Name="PwdOwner" PasswordChanged="Setting_PasswordChanged" />
                                    <TextBlock Style="{StaticResource SidebarHint}" Text="{DynamicResource Str_PdfX_OwnerPasswordNote}" />
                                    <TextBlock
                                        Margin="0,12,0,6"
                                        Style="{StaticResource FieldLabel}"
                                        Text="{DynamicResource Str_PdfX_Allow}" />
                                    <CheckBox
                                        x:Name="ChkAllowPrint"
                                        Click="Setting_Click"
                                        Content="{DynamicResource Str_PdfX_AllowPrint}"
                                        IsChecked="True" />
                                    <CheckBox
                                        x:Name="ChkAllowCopy"
                                        Margin="0,6,0,0"
                                        Click="Setting_Click"
                                        Content="{DynamicResource Str_PdfX_AllowCopy}"
                                        IsChecked="True" />
                                    <CheckBox
                                        x:Name="ChkAllowEdit"
                                        Margin="0,6,0,0"
                                        Click="Setting_Click"
                                        Content="{DynamicResource Str_PdfX_AllowEdit}"
                                        IsChecked="True" />
                                    <TextBlock Style="{StaticResource SidebarHint}" Text="{DynamicResource Str_PdfX_ProtectNote}" />
                                </StackPanel>
                            </Border>

                            <!--  ============ UNLOCK ============  -->
                            <Border x:Name="PanelUnlock" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_PdfX_UnlockHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.LockOpenVariantOutline}" />
                                    <TextBlock Style="{StaticResource SidebarHint}" Text="{DynamicResource Str_PdfX_UnlockNote}" />
                                </StackPanel>
                            </Border>

                            <!--  ============ PASSWORD FOR PROTECTED PDFs ============  -->
                            <Border Style="{StaticResource SidebarGroupCardStyle}" Visibility="Collapsed">
                                <StackPanel>
                                    <Grid
                                        Background="Transparent"
                                        Cursor="Hand"
                                        MouseLeftButtonUp="SharedHeader_MouseLeftButtonUp"
                                        ToolTip="{DynamicResource Str_PdfX_SharedPasswordToggle}">
                                        <ContentControl
                                            Content="{DynamicResource Str_PdfX_SharedPasswordHeader}"
                                            Style="{StaticResource SidebarGroupHeader}"
                                            Tag="{x:Static materialDesign:PackIconKind.KeyOutline}" />
                                        <materialDesign:PackIcon
                                            x:Name="IconSharedChevron"
                                            Width="18"
                                            Height="18"
                                            Margin="0,0,2,10"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource TextSecondary}"
                                            Kind="ChevronDown" />
                                    </Grid>
                                    <StackPanel x:Name="PanelShared" Visibility="Collapsed">
                                        <PasswordBox x:Name="PwdShared" PasswordChanged="PwdShared_PasswordChanged" />
                                        <TextBlock Style="{StaticResource SidebarHint}" Text="{DynamicResource Str_PdfX_SharedPasswordNote}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                            <!--  ============ SAVE TO ============  -->
                            <controls:OutputFolderCard
                                x:Name="OutputCard"
                                Margin="0,0,0,4"
                                ctl:Tour.Key="Str_Tour_PdfExtras_Output"
                                ctl:Tour.Order="3"
                                Header="{DynamicResource Str_BackgroundRemover_SaveTo}"
                                HeaderIcon="ContentSaveOutline"
                                ToolName="PDF Extras" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--  ================= CONTENT =================  -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition x:Name="RowFiles" Height="*" />
                    <RowDefinition x:Name="RowPages" Height="0" />
                </Grid.RowDefinitions>

                <!--  Run bar: what Apply will do, Apply, and how it went  -->
                <Border
                    Grid.Row="0"
                    Margin="0,0,0,14"
                    Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock
                            x:Name="TxtPlan"
                            Margin="0,0,0,12"
                            FontSize="12.5"
                            Foreground="{DynamicResource TextPrimary}"
                            TextWrapping="Wrap" />
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button
                                x:Name="BtnApply"
                                MinWidth="150"
                                Margin="0,0,16,0"
                                VerticalAlignment="Center"
                                ctl:Tour.Key="Str_Tour_PdfExtras_Apply"
                                ctl:Tour.Order="4"
                                Click="BtnApply_Click"
                                IsEnabled="False"
                                Style="{StaticResource AccentPrimaryButtonStyle}">
                                <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        x:Name="IconApply"
                                        Width="18"
                                        Height="18"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Kind="PlayCircleOutline" />
                                    <TextBlock
                                        x:Name="TxtApply"
                                        VerticalAlignment="Center"
                                        Text="{DynamicResource Str_PdfX_Apply}" />
                                </StackPanel>
                            </Button>
                            <Border
                                x:Name="BorderStatus"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Style="{StaticResource IconStatusPillStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        x:Name="IconStatus"
                                        Width="14"
                                        Height="14"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Kind="InformationOutline" />
                                    <TextBlock
                                        x:Name="TxtStatus"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                            <Button
                                x:Name="BtnOpenOutput"
                                Grid.Column="2"
                                Margin="8,0,0,0"
                                Click="BtnOpenOutput_Click"
                                Style="{StaticResource ListToolButtonStyle}"
                                ToolTip="{DynamicResource Str_PdfX_OpenOutputFolder}"
                                Visibility="Collapsed">
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    Kind="FolderOpenOutline" />
                            </Button>
                        </Grid>
                        <ProgressBar
                            x:Name="ProgressRun"
                            Height="8"
                            Margin="0,12,0,0"
                            Maximum="100"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!--  The PDFs  -->
                <Border
                    x:Name="CardFiles"
                    Grid.Row="1"
                    Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentControl
                                Content="{DynamicResource Str_Common_FilesTitle}"
                                Style="{StaticResource CardHeader}"
                                Tag="{x:Static materialDesign:PackIconKind.FileDocumentMultipleOutline}" />
                            <WrapPanel
                                x:Name="SummaryPanel"
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                                <Border
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource StatusInfoBg}"
                                    Style="{StaticResource IconStatusPillStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource StatusInfoFg}"
                                            Kind="FilePdfBox" />
                                        <TextBlock
                                            x:Name="TxtSummaryCount"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource StatusInfoFg}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    x:Name="PillDone"
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource StatusSuccessBg}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource StatusSuccessFg}"
                                            Kind="CheckCircleOutline" />
                                        <TextBlock
                                            x:Name="TxtSummaryDone"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource StatusSuccessFg}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    x:Name="PillSkipped"
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource StatusWarningBg}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource StatusWarningFg}"
                                            Kind="MinusCircleOutline" />
                                        <TextBlock
                                            x:Name="TxtSummarySkipped"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource StatusWarningFg}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    x:Name="PillFailed"
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource StatusErrorBg}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource StatusErrorFg}"
                                            Kind="AlertCircleOutline" />
                                        <TextBlock
                                            x:Name="TxtSummaryFailed"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource StatusErrorFg}" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button
                                    x:Name="BtnRemoveSelected"
                                    Click="BtnRemoveSelected_Click"
                                    Style="{StaticResource ListToolButtonStyle}"
                                    ToolTip="{DynamicResource Str_ImageConvertPDF_TakeTheHighlightedRows}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="PlaylistRemove" />
                                </Button>
                                <Button
                                    x:Name="BtnClearAll"
                                    Margin="10,0,0,0"
                                    Click="BtnClearAll_Click"
                                    Style="{StaticResource ListToolDangerButtonStyle}"
                                    ToolTip="{DynamicResource Str_Pdf_ClearListTooltip}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="DeleteSweepOutline" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <DataGrid
                            x:Name="DataGridResults"
                            Grid.Row="1"
                            ctl:Tour.Key="Str_Tour_PdfExtras_Results"
                            ctl:Tour.Order="5"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            CanUserReorderColumns="False"
                            CanUserSortColumns="False"
                            FontSize="12"
                            IsReadOnly="True"
                            LoadingRow="DataGridResults_LoadingRow"
                            MinRowHeight="46"
                            PreviewKeyDown="DataGridResults_PreviewKeyDown"
                            SelectionChanged="DataGridResults_SelectionChanged"
                            SelectionMode="Extended"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.ScrollUnit="Pixel"
                            VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="34" CellStyle="{StaticResource CheckBoxCellStyle}" HeaderStyle="{StaticResource CheckBoxHeaderStyle}">
                                    <DataGridTemplateColumn.Header>
                                        <CheckBox
                                            x:Name="ChkIncludeAll"
                                            Click="ChkIncludeAll_Click"
                                            IsChecked="True"
                                            Style="{StaticResource DataGridCheckBoxStyle}"
                                            ToolTip="{DynamicResource Str_PdfToolkit_TickOrUntickEvery}" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox
                                                Click="ItemCheckBox_Click"
                                                IsChecked="{Binding IsIncluded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Style="{StaticResource DataGridCheckBoxStyle}"
                                                ToolTip="{DynamicResource Str_PdfX_TickedAreChanged}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn
                                    Width="2*"
                                    MinWidth="90"
                                    CellTemplate="{StaticResource NameCellTemplate}"
                                    Header="{DynamicResource Str_Common_ColHeaderFile}" />
                                <DataGridTemplateColumn
                                    Width="78"
                                    CellTemplate="{StaticResource PagesCellTemplate}"
                                    Header="{DynamicResource Str_ImageConvertPDF_Pages}" />
                                <DataGridTextColumn
                                    x:Name="ColSize"
                                    Width="76"
                                    Binding="{Binding Size, Mode=OneWay}"
                                    ElementStyle="{StaticResource EllipsisCellTextStyle}"
                                    Header="{DynamicResource Str_Common_ColHeaderSize}" />
                                <DataGridTemplateColumn
                                    Width="104"
                                    CellTemplate="{StaticResource StatusCellTemplate}"
                                    Header="{DynamicResource Str_Common_ColHeaderStatus}" />
                                <DataGridTemplateColumn
                                    x:Name="ColResult"
                                    Width="*"
                                    MinWidth="70"
                                    CellTemplate="{StaticResource ResultCellTemplate}"
                                    Header="{DynamicResource Str_FileConverter_Result}" />
                                <DataGridTemplateColumn Width="40" CellStyle="{StaticResource CompactCellStyle}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button
                                                Width="26"
                                                Height="26"
                                                Click="BtnRowRemove_Click"
                                                Style="{StaticResource IconButtonStyle}"
                                                Tag="{Binding}"
                                                ToolTip="{DynamicResource Str_PdfToolkit_TakeThisPdfOff}">
                                                <materialDesign:PackIcon
                                                    Width="14"
                                                    Height="14"
                                                    Kind="Close" />
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <controls:EmptyStateCard
                            x:Name="EmptyStatePanel"
                            Title="{DynamicResource Str_PdfX_EmptyTitle}"
                            Grid.Row="1"
                            Description="{DynamicResource Str_PdfX_EmptyHint}"
                            Icon="FilePdfBox"
                            IsHitTestVisible="False" />
                    </Grid>
                </Border>

                <!--  Page editor (Pages action): filled in by the page editor step  -->
                <Border
                    x:Name="CardPages"
                    Grid.Row="2"
                    Margin="0,12,0,0"
                    Style="{StaticResource CardStyle}"
                    Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentControl
                                Content="{DynamicResource Str_PdfX_EditorHeader}"
                                Style="{StaticResource CardHeader}"
                                Tag="{x:Static materialDesign:PackIconKind.ViewGrid}" />
                            <WrapPanel
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center">
                                <Border
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource StatusInfoBg}"
                                    Style="{StaticResource IconStatusPillStyle}">
                                    <TextBlock
                                        x:Name="TxtEditorCount"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource StatusInfoFg}" />
                                </Border>
                                <Border
                                    x:Name="PillEditorSelected"
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource RowBg}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        x:Name="TxtEditorSelected"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextSecondary}" />
                                </Border>
                                <Border
                                    x:Name="PillEditorBlank"
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource StatusWarningBg}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        x:Name="TxtEditorBlank"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource StatusWarningFg}" />
                                </Border>
                            </WrapPanel>
                            <StackPanel
                                x:Name="EditorToolbar"
                                Grid.Column="2"
                                Orientation="Horizontal">
                                <Button
                                    x:Name="BtnEarlier"
                                    Margin="0,0,4,0"
                                    Click="BtnEarlier_Click"
                                    Style="{StaticResource ListToolButtonStyle}"
                                    ToolTip="{DynamicResource Str_PdfX_EditorEarlier}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="ChevronLeft" />
                                </Button>
                                <Button
                                    x:Name="BtnLater"
                                    Margin="0,0,10,0"
                                    Click="BtnLater_Click"
                                    Style="{StaticResource ListToolButtonStyle}"
                                    ToolTip="{DynamicResource Str_PdfX_EditorLater}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="ChevronRight" />
                                </Button>
                                <Button
                                    x:Name="BtnTurnLeft"
                                    Margin="0,0,4,0"
                                    Click="BtnTurnLeft_Click"
                                    Style="{StaticResource ListToolButtonStyle}"
                                    ToolTip="{DynamicResource Str_PdfX_EditorTurnLeft}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="RotateLeft" />
                                </Button>
                                <Button
                                    x:Name="BtnTurnRight"
                                    Margin="0,0,10,0"
                                    Click="BtnTurnRight_Click"
                                    Style="{StaticResource ListToolButtonStyle}"
                                    ToolTip="{DynamicResource Str_PdfX_EditorTurnRight}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="RotateRight" />
                                </Button>
                                <Button
                                    x:Name="BtnDuplicate"
                                    Margin="0,0,4,0"
                                    Click="BtnDuplicate_Click"
                                    Style="{StaticResource ListToolButtonStyle}"
                                    ToolTip="{DynamicResource Str_PdfX_EditorDuplicate}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="ContentDuplicate" />
                                </Button>
                                <Button
                                    x:Name="BtnInsertBlank"
                                    Margin="0,0,4,0"
                                    Click="BtnInsertBlank_Click"
                                    Style="{StaticResource ListToolButtonStyle}"
                                    ToolTip="{DynamicResource Str_PdfX_EditorBlankPage}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="FileOutline" />
                                </Button>
                                <Button
                                    x:Name="BtnInsertPdf"
                                    Margin="0,0,10,0"
                                    Click="BtnInsertPdf_Click"
                                    Style="{StaticResource ListToolButtonStyle}"
                                    ToolTip="{DynamicResource Str_PdfX_EditorInsertPdf}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="FilePlus" />
                                </Button>
                                <Button
                                    x:Name="BtnFindBlank"
                                    Margin="0,0,4,0"
                                    Click="BtnFindBlank_Click"
                                    Style="{StaticResource ListToolButtonStyle}"
                                    ToolTip="{DynamicResource Str_PdfX_EditorFindBlank}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="Magnify" />
                                </Button>
                                <Button
                                    x:Name="BtnReset"
                                    Margin="0,0,4,0"
                                    Click="BtnReset_Click"
                                    Style="{StaticResource ListToolButtonStyle}"
                                    ToolTip="{DynamicResource Str_PdfX_EditorReset}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="Restore" />
                                </Button>
                                <Button
                                    x:Name="BtnDeletePages"
                                    Click="BtnDeletePages_Click"
                                    Style="{StaticResource ListToolDangerButtonStyle}"
                                    ToolTip="{DynamicResource Str_PdfX_EditorDelete}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="DeleteOutline" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <ListBox
                            x:Name="ListPages"
                            Grid.Row="1"
                            Margin="0,10,0,0"
                            AllowDrop="True"
                            Background="Transparent"
                            BorderThickness="0"
                            DragOver="ListPages_DragOver"
                            Drop="ListPages_Drop"
                            ItemContainerStyle="{StaticResource PageTileItemStyle}"
                            ItemTemplate="{StaticResource PageTileTemplate}"
                            PreviewKeyDown="ListPages_PreviewKeyDown"
                            PreviewMouseLeftButtonDown="ListPages_PreviewMouseLeftButtonDown"
                            PreviewMouseMove="ListPages_PreviewMouseMove"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            SelectionChanged="ListPages_SelectionChanged"
                            SelectionMode="Extended">
                            <ListBox.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ListBox.ItemsPanel>
                        </ListBox>

                        <controls:EmptyStateCard
                            x:Name="EditorMessage"
                            Grid.Row="1"
                            Margin="0,10,0,0"
                            Icon="ViewGrid"
                            IsHitTestVisible="False" />
                    </Grid>
                </Border>
            </Grid>        
        </Grid>

        <!--  Drop overlay: anywhere on the page  -->
        <Border
            x:Name="DropOverlay"
            Margin="16,8,16,16"
            Panel.ZIndex="10"
            Style="{StaticResource DropZoneStyle}">
            <Grid>
                <Rectangle
                    RadiusX="14"
                    RadiusY="14"
                    Stroke="{DynamicResource AccentColor}"
                    StrokeDashArray="6 4"
                    StrokeThickness="2" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.TrayArrowDown}" />
                    <TextBlock
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        Text="{DynamicResource Str_PdfToolkit_DropToAddPdfs}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondary}"
                        Text="{DynamicResource Str_PdfToolkit_PdfFilesAndWhole}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
