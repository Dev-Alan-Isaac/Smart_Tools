<UserControl
    x:Class="Smart_Tools.WPF.Views.CsvJsonView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    x:Name="Root"
    Focusable="True"
    Loaded="Root_Loaded"
    Unloaded="Root_Unloaded">

    <!--  Backend: Controllers/CsvJsonManager.cs (CSV reader/writer, CSV<->JSON). UI only here.  -->

    <UserControl.Resources>
        <Style x:Key="CjLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarText}" />
            <Setter Property="Margin" Value="2,10,0,4" />
        </Style>
        <Style x:Key="CjHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextMuted}" />
            <Setter Property="Margin" Value="2,6,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">
        <Grid Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= OPTIONS SIDEBAR =================  -->
            <controls:ToolSidebar>
                <StackPanel>
                    <Border
                        Margin="0,0,0,10"
                        ctl:Tour.Key="Str_Tour_CsvJson_Direction"
                        ctl:Tour.Order="1"
                        Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl
                                Content="{DynamicResource Str_DateTimeTool_Convert}"
                                Style="{StaticResource SidebarGroupHeader}"
                                Tag="{x:Static materialDesign:PackIconKind.SwapHorizontal}" />
                            <UniformGrid Margin="0,6,0,0" Columns="2">
                                <RadioButton
                                    x:Name="RadioCsvToJson"
                                    Margin="0,0,2,0"
                                    Click="Direction_Click"
                                    Content="{DynamicResource Str_CsvJson_CsvJson}"
                                    GroupName="CjDir"
                                    IsChecked="True"
                                    Style="{StaticResource ModeToggleButtonStyle}"
                                    Tag="CsvToJson" />
                                <RadioButton
                                    x:Name="RadioJsonToCsv"
                                    Margin="2,0,0,0"
                                    Click="Direction_Click"
                                    Content="{DynamicResource Str_CsvJson_JsonCsv}"
                                    GroupName="CjDir"
                                    Style="{StaticResource ModeToggleButtonStyle}"
                                    Tag="JsonToCsv" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border
                        ctl:Tour.Key="Str_Tour_CsvJson_Options"
                        ctl:Tour.Order="2"
                        Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl
                                Content="{DynamicResource Str_Rest_Options}"
                                Style="{StaticResource SidebarGroupHeader}"
                                Tag="{x:Static materialDesign:PackIconKind.TuneVariant}" />
                            <TextBlock Style="{StaticResource CjLabel}" Text="{DynamicResource Str_Password_SeparatorHeader}" />
                            <Border Style="{StaticResource InputBarStyle}">
                                <ComboBox
                                    x:Name="CmbDelimiter"
                                    VerticalContentAlignment="Center"
                                    SelectionChanged="Option_SelectionChanged"
                                    Style="{StaticResource BareComboBox}">
                                    <ComboBoxItem Content="{DynamicResource Str_CsvJson_DetectAutomatically}" Tag="Auto" />
                                    <ComboBoxItem Content="{DynamicResource Str_CsvJson_Comma}" Tag="Comma" />
                                    <ComboBoxItem Content="{DynamicResource Str_CsvJson_Semicolon}" Tag="Semicolon" />
                                    <ComboBoxItem Content="{DynamicResource Str_CodeToolkit_Tab}" Tag="Tab" />
                                    <ComboBoxItem Content="{DynamicResource Str_CsvJson_Pipe}" Tag="Pipe" />
                                </ComboBox>
                            </Border>
                            <StackPanel x:Name="PanelCsvOptions" Margin="0,10,0,0">
                                <CheckBox
                                    x:Name="ChkHeader"
                                    Click="Option_Click"
                                    Content="{DynamicResource Str_CsvJson_FirstRowIsThe}"
                                    IsChecked="True" />
                                <CheckBox
                                    x:Name="ChkTypes"
                                    Margin="0,0,0,0"
                                    Click="Option_Click"
                                    Content="{DynamicResource Str_CsvJson_KeepNumbersAndTrue}"
                                    IsChecked="True"
                                    ToolTip="{DynamicResource Str_CsvJson_NumbersLikeStayText}" />
                                <CheckBox
                                    x:Name="ChkIndented"
                                    Margin="0,6,0,0"
                                    Click="Option_Click"
                                    Content="{DynamicResource Str_CsvJson_PrettyJsonIndented}"
                                    IsChecked="True" />
                            </StackPanel>
                            <TextBlock x:Name="TxtHint" Style="{StaticResource CjHint}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </controls:ToolSidebar>

            <!--  ================= MAIN AREA =================  -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="260" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" MinWidth="260" />
                </Grid.ColumnDefinitions>

                <!--  ========== Summary ==========  -->
                <Border Grid.ColumnSpan="3" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <StackPanel>
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{DynamicResource Str_FileConverter_Result}" />
                                <TextBlock
                                    x:Name="TxtInfo"
                                    Margin="0,2,0,0"
                                    FontSize="20"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource TextPrimary}"
                                    Text="{DynamicResource Str_CsvJson_PasteOrOpenSomething}" />
                            </StackPanel>
                        </StackPanel>
                        <Border
                            x:Name="ErrorBanner"
                            Margin="0,10,0,0"
                            Padding="12,9"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource StatusErrorBg}"
                            CornerRadius="10"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="TxtError"
                                MaxWidth="900"
                                FontSize="12.5"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource StatusErrorFg}"
                                TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <!--  ========== Input ==========  -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,10">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button
                                    Margin="0,0,6,0"
                                    Click="BtnOpen_Click"
                                    Style="{StaticResource ListToolButtonStyle}"
                                    ToolTip="{DynamicResource Str_Formatter_Open}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="FolderOpenOutline" />
                                </Button>
                                <Button
                                    Click="BtnClear_Click"
                                    Style="{StaticResource ListToolButtonStyle}"
                                    ToolTip="{DynamicResource Str_Validate_Clear}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="Close" />
                                </Button>
                            </StackPanel>
                            <ContentControl
                                x:Name="TxtInputTitle"
                                ctl:Tour.Key="Str_Tour_CsvJson_Input"
                                ctl:Tour.Order="3"
                                Content="CSV"
                                Style="{StaticResource CardHeader}"
                                Tag="{x:Static materialDesign:PackIconKind.TextBoxOutline}" />
                        </DockPanel>
                        <Border
                            Grid.Row="1"
                            Background="{DynamicResource RowBg}"
                            BorderBrush="{DynamicResource CardBorder}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <Grid x:Name="InputHost" PreviewDragLeave="InputHost_PreviewDragLeave">
                                <TextBox
                                    x:Name="TxtInput"
                                    Height="Auto"
                                    Padding="12"
                                    VerticalContentAlignment="Top"
                                    AcceptsReturn="True"
                                    AcceptsTab="True"
                                    AllowDrop="True"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontFamily="Cascadia Mono, Consolas"
                                    FontSize="12.5"
                                    Foreground="{DynamicResource TextPrimary}"
                                    HorizontalScrollBarVisibility="Auto"
                                    PreviewDragOver="Input_PreviewDragOver"
                                    PreviewDrop="Input_PreviewDrop"
                                    TextChanged="Input_TextChanged"
                                    TextWrapping="NoWrap"
                                    VerticalScrollBarVisibility="Auto" />

                                <!--  Nothing typed yet: say what to do (disappears as soon as there is text)  -->
                                <StackPanel
                                    x:Name="InputEmpty"
                                    MaxWidth="360"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                                    <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.TextBoxPlusOutline}" />
                                    <TextBlock
                                        Margin="0,12,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimary}"
                                        Text="{DynamicResource Str_CsvJson_EmptyTitle}" />
                                    <TextBlock
                                        Margin="0,6,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Text="{DynamicResource Str_CsvJson_EmptyHint}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <!--  A file is being dragged over: drop it to load it  -->
                                <Border
                                    x:Name="DropOverlay"
                                    Panel.ZIndex="10"
                                    Style="{StaticResource DropZoneStyle}">
                                    <Grid>
                                        <Rectangle
                                            RadiusX="12"
                                            RadiusY="12"
                                            Stroke="{DynamicResource AccentColor}"
                                            StrokeDashArray="5 4"
                                            StrokeThickness="2" />
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.TrayArrowDown}" />
                                            <TextBlock
                                                Margin="0,12,0,0"
                                                HorizontalAlignment="Center"
                                                FontSize="14"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource TextPrimary}"
                                                Text="{DynamicResource Str_CsvJson_DropTitle}" />
                                        </StackPanel>
                                    </Grid>
                                </Border>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!--  ========== Output ==========  -->
                <Border
                    Grid.Row="2"
                    Grid.Column="2"
                    Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,10">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <Button
                                    x:Name="BtnCopy"
                                    Margin="0,0,6,0"
                                    ctl:Tour.Key="Str_Tour_CsvJson_Copy"
                                    ctl:Tour.Order="5"
                                    Click="BtnCopy_Click"
                                    Style="{StaticResource ListToolButtonStyle}"
                                    ToolTip="{DynamicResource Str_Conv_CopyResult}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="ContentCopy" />
                                </Button>
                                <Button
                                    x:Name="BtnSave"
                                    Click="BtnSave_Click"
                                    Style="{StaticResource ListToolButtonStyle}"
                                    ToolTip="{DynamicResource Str_EncTool_SaveTooltip}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="ContentSaveOutline" />
                                </Button>
                            </StackPanel>
                            <ContentControl
                                x:Name="TxtOutputTitle"
                                ctl:Tour.Key="Str_Tour_CsvJson_Output"
                                ctl:Tour.Order="4"
                                Content="JSON"
                                Style="{StaticResource CardHeader}"
                                Tag="{x:Static materialDesign:PackIconKind.CodeJson}" />
                        </DockPanel>
                        <Border
                            Grid.Row="1"
                            Background="{DynamicResource RowBg}"
                            BorderBrush="{DynamicResource CardBorder}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <TextBox
                                x:Name="TxtOutput"
                                Height="Auto"
                                Padding="12"
                                VerticalContentAlignment="Top"
                                Background="Transparent"
                                BorderThickness="0"
                                FontFamily="Cascadia Mono, Consolas"
                                FontSize="12.5"
                                Foreground="{DynamicResource TextPrimary}"
                                HorizontalScrollBarVisibility="Auto"
                                IsReadOnly="True"
                                TextWrapping="NoWrap"
                                VerticalScrollBarVisibility="Auto" />
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
