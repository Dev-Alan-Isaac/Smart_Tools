<UserControl
    x:Class="Smart_Tools.WPF.Views.FileConverterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:models="clr-namespace:Smart_Tools.WPF.Models"
    x:Name="Root"
    Loaded="Root_Loaded"
    SizeChanged="Root_SizeChanged">

    <!--
        Backend: Controllers/ConverterManager.cs (planning: formats, codec
        rules, ffmpeg arguments, output paths, the file list),
        ConverterManager.Run.cs (folders, ffmpeg with live progress, moving
        results into place), ConverterManager.Images.cs (Magick.NET);
        Models/FileConverterModel.cs. This file and the code-behind are UI only.
        Choices are read by Tag (enum name), not by position.
    -->

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!--  Small format chip in the grid ("MP4")  -->
        <Style x:Key="FormatChipStyle" TargetType="Border">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="CornerRadius" Value="8" />
        </Style>

        <!--  Grid: file kind icon  -->
        <DataTemplate x:Key="KindCellTemplate" DataType="{x:Type models:ConvertFileItem}">
            <Border
                Width="30"
                Height="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource AccentColorSubtle}"
                CornerRadius="8">
                <materialDesign:PackIcon
                    x:Name="KindIcon"
                    Width="16"
                    Height="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource AccentColor}"
                    Kind="FileQuestionOutline" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Video">
                    <Setter TargetName="KindIcon" Property="Kind" Value="Filmstrip" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Audio">
                    <Setter TargetName="KindIcon" Property="Kind" Value="MusicNote" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Image">
                    <Setter TargetName="KindIcon" Property="Kind" Value="ImageOutline" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  Grid: name + folder  -->
        <DataTemplate x:Key="NameCellTemplate" DataType="{x:Type models:ConvertFileItem}">
            <StackPanel VerticalAlignment="Center" ToolTip="{Binding FullPath}">
                <TextBlock
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimary}"
                    Text="{Binding Name}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Margin="0,1,0,0"
                    FontSize="11"
                    Foreground="{DynamicResource TextSecondary}"
                    Text="{Binding Folder}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <!--  Grid: from -> to  -->
        <DataTemplate x:Key="FormatsCellTemplate" DataType="{x:Type models:ConvertFileItem}">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <Border Background="{DynamicResource RowBg}" Style="{StaticResource FormatChipStyle}">
                    <TextBlock
                        FontSize="10"
                        FontWeight="Bold"
                        Foreground="{DynamicResource TextSecondary}"
                        Text="{Binding CurrentFormat}"
                        TextTrimming="CharacterEllipsis" />
                </Border>
                <materialDesign:PackIcon
                    Width="14"
                    Height="14"
                    Margin="5,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextSecondary}"
                    Kind="ArrowRight" />
                <Border
                    Background="{DynamicResource AccentColorSubtle}"
                    Style="{StaticResource FormatChipStyle}"
                    ToolTip="{Binding OutputPath}">
                    <TextBlock
                        FontSize="10"
                        FontWeight="Bold"
                        Foreground="{DynamicResource AccentColor}"
                        Text="{Binding TargetFormat}"
                        TextTrimming="CharacterEllipsis" />
                </Border>
            </StackPanel>
        </DataTemplate>

        <!--  Grid: new size, green when smaller  -->
        <DataTemplate x:Key="ResultCellTemplate" DataType="{x:Type models:ConvertFileItem}">
            <TextBlock
                x:Name="ResultText"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextSecondary}"
                Text="{Binding ResultText}"
                TextTrimming="CharacterEllipsis"
                ToolTip="{Binding OutputPath}" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding ResultIsSmaller}" Value="True">
                    <Setter TargetName="ResultText" Property="Foreground" Value="{DynamicResource StatusSuccessFg}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  Grid: status chip (+ live progress while converting). Replaces StatusBadgeConverter.  -->
        <DataTemplate x:Key="StatusCellTemplate" DataType="{x:Type models:ConvertFileItem}">
            <StackPanel VerticalAlignment="Center" ToolTip="{Binding Message}">
                <Border
                    x:Name="Chip"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource StatusInfoBg}"
                    Style="{StaticResource IconStatusPillStyle}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            x:Name="ChipIcon"
                            Width="12"
                            Height="12"
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource StatusInfoFg}"
                            Kind="ClockOutline" />
                        <TextBlock
                            x:Name="ChipText"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource StatusInfoFg}"
                            Text="{Binding StatusText}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <ProgressBar
                    Width="86"
                    Height="3"
                    Margin="2,4,0,0"
                    HorizontalAlignment="Left"
                    Maximum="100"
                    Visibility="{Binding IsConverting, Converter={StaticResource BoolToVisibility}}"
                    Value="{Binding Progress, Mode=OneWay}" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Skipped">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource RowBg}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="CheckAll" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource TextSecondary}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource TextSecondary}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Unsupported">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusWarningBg}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="FileCancelOutline" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Converting">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource AccentColorSubtle}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="Autorenew" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource AccentColor}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource AccentColor}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Converted">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusSuccessBg}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="CheckCircleOutline" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource StatusSuccessFg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusSuccessFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusErrorBg}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="AlertCircleOutline" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusWarningBg}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="CloseCircleOutline" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>


        <!--  Input card: one queued item  -->
        <DataTemplate x:Key="QueueItemTemplate" DataType="{x:Type models:ConvertQueueGroup}">
            <Grid ToolTip="{Binding ToolTip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="26"
                    Height="26"
                    Margin="0,0,8,0"
                    Background="{DynamicResource AccentColorSubtle}"
                    CornerRadius="7">
                    <materialDesign:PackIcon
                        x:Name="GroupIcon"
                        Width="14"
                        Height="14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource AccentColor}"
                        Kind="FileMultipleOutline" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource SidebarText}"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Margin="0,1,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource SidebarTextMuted}"
                        Text="{Binding Subtitle}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button
                    Grid.Column="2"
                    Width="24"
                    Height="24"
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    Click="BtnRemoveQueueGroup_Click"
                    Style="{StaticResource IconButtonStyle}"
                    Tag="{Binding}"
                    ToolTip="{DynamicResource Str_Validate_RemoveFromListTooltip}">
                    <materialDesign:PackIcon
                        Width="13"
                        Height="13"
                        Kind="Close" />
                </Button>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                    <Setter TargetName="GroupIcon" Property="Kind" Value="Folder" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">

        <!--  No page header: MainWindow's header card shows the tool's icon and name.  -->

        <Grid Margin="16,8,16,16">

            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OptionsColumn" Width="280" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= OPTIONS SIDEBAR =================  -->

            <Border Grid.Column="0" Style="{StaticResource SidebarPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Button
                            x:Name="BtnCollapseOptions"
                            MinHeight="45"
                            HorizontalContentAlignment="Left"
                            Click="BtnCollapseOptions_Click"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Foreground="{DynamicResource SidebarText}"
                            ToolTip="{DynamicResource Str_Common_SidebarToggleTooltip}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="OverridesDefaultStyle" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Margin="16,0,0,0" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Kind="TuneVariant" />
                                <TextBlock
                                    x:Name="TxtOptionsHeaderLabel"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{DynamicResource Str_Common_OptionsLabel}" />
                            </StackPanel>
                        </Button>
                        <Separator
                            x:Name="SepHeader"
                            Margin="16,4"
                            Style="{StaticResource SidebarSeparatorStyle}" />
                    </StackPanel>

                    <ScrollViewer
                        x:Name="OptionsScrollViewer"
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16,4,16,16">

                            <!--  ============ FILES ============  -->
                            <controls:InputFolderCard
                                x:Name="InputCard"
                                ctl:Tour.Key="Str_Tour_FileConverter_Input"
                                ctl:Tour.Order="1"
                                ClearRequested="InputCard_ClearRequested"
                                Header="{DynamicResource Str_Common_Files}"
                                HeaderIcon="FileMultipleOutline"
                                IncludeSubfoldersChanged="InputCard_IncludeSubfoldersChanged"
                                ItemTemplate="{StaticResource QueueItemTemplate}"
                                PathsAdded="InputCard_PathsAdded" />


                            <!--  ============ CONVERT TO ============  -->
                            <Border ctl:Tour.Key="Str_Tour_FileConverter_Format" ctl:Tour.Order="2" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Convert_SettingsHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.SwapHorizontal}" />

                                    <Grid ToolTip="{DynamicResource Str_Convert_FileTypeTooltip}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <RadioButton
                                            x:Name="RadioTypeVideo"
                                            Click="RadioType_Click"
                                            GroupName="FileType"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="Video"
                                            ToolTip="{DynamicResource Str_FileConverter_ConvertVideosToAnother}">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="17"
                                                    Height="17"
                                                    HorizontalAlignment="Center"
                                                    Kind="Filmstrip" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    HorizontalAlignment="Center"
                                                    Text="{DynamicResource Str_FileConverter_Video}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="RadioTypeImage"
                                            Grid.Column="2"
                                            Click="RadioType_Click"
                                            GroupName="FileType"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="Image"
                                            ToolTip="{DynamicResource Str_FileConverter_ConvertResizeOrCompress}">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="17"
                                                    Height="17"
                                                    HorizontalAlignment="Center"
                                                    Kind="ImageOutline" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    HorizontalAlignment="Center"
                                                    Text="{DynamicResource Str_ImgEdit_ColHeaderImage}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="RadioTypeAudio"
                                            Grid.Column="4"
                                            Click="RadioType_Click"
                                            GroupName="FileType"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="Audio"
                                            ToolTip="{DynamicResource Str_FileConverter_ConvertMusicAndSound}">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="17"
                                                    Height="17"
                                                    HorizontalAlignment="Center"
                                                    Kind="MusicNote" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    HorizontalAlignment="Center"
                                                    Text="{DynamicResource Str_DuplicateFinder_Audio}" />
                                            </StackPanel>
                                        </RadioButton>
                                    </Grid>

                                    <!--  ~~~ Video ~~~  -->
                                    <StackPanel x:Name="PanelVideoOptions" Margin="0,12,0,0">
                                        <TextBlock
                                            Margin="0,0,0,6"
                                            Style="{StaticResource FieldLabel}"
                                            Text="{DynamicResource Str_Convert_ConvertToLabel}" />
                                        <UniformGrid
                                            x:Name="VideoFormatChips"
                                            Columns="3"
                                            ToolTip="{DynamicResource Str_Convert_VideoFormatTooltip}">
                                            <RadioButton
                                                Margin="0,0,2,4"
                                                Click="Setting_Click"
                                                Content="MP4"
                                                GroupName="VideoFormat"
                                                IsChecked="True"
                                                Style="{StaticResource ModeToggleButtonStyle}"
                                                Tag="Mp4"
                                                ToolTip="{DynamicResource Str_FileConverter_PlaysEverywherePhonesTvs}" />
                                            <RadioButton
                                                Margin="2,0,2,4"
                                                Click="Setting_Click"
                                                Content="{DynamicResource Str_FileConverter_Mkv}"
                                                GroupName="VideoFormat"
                                                Style="{StaticResource ModeToggleButtonStyle}"
                                                Tag="Mkv"
                                                ToolTip="{DynamicResource Str_FileConverter_FlexibleContainerKeepsEvery}" />
                                            <RadioButton
                                                Margin="2,0,0,4"
                                                Click="Setting_Click"
                                                Content="{DynamicResource Str_FileConverter_Mov}"
                                                GroupName="VideoFormat"
                                                Style="{StaticResource ModeToggleButtonStyle}"
                                                Tag="Mov"
                                                ToolTip="{DynamicResource Str_FileConverter_AppleQuicktimeH264}" />
                                            <RadioButton
                                                Margin="0,0,2,0"
                                                Click="Setting_Click"
                                                Content="{DynamicResource Str_FileConverter_Webm}"
                                                GroupName="VideoFormat"
                                                Style="{StaticResource ModeToggleButtonStyle}"
                                                Tag="Webm"
                                                ToolTip="{DynamicResource Str_FileConverter_ForTheWebVp9}" />
                                            <RadioButton
                                                Margin="2,0"
                                                Click="Setting_Click"
                                                Content="{DynamicResource Str_FileConverter_Avi}"
                                                GroupName="VideoFormat"
                                                Style="{StaticResource ModeToggleButtonStyle}"
                                                Tag="Avi"
                                                ToolTip="{DynamicResource Str_FileConverter_OlderPlayersH264}" />
                                            <RadioButton
                                                Margin="2,0,0,0"
                                                Click="Setting_Click"
                                                Content="{DynamicResource Str_FileConverter_Flv}"
                                                GroupName="VideoFormat"
                                                Style="{StaticResource ModeToggleButtonStyle}"
                                                Tag="Flv"
                                                ToolTip="{DynamicResource Str_FileConverter_LegacyFlashVideoH}" />
                                        </UniformGrid>

                                        <TextBlock
                                            Margin="0,12,0,6"
                                            Style="{StaticResource FieldLabel}"
                                            Text="{DynamicResource Str_Convert_VideoCodecLabel}" />
                                        <ComboBox
                                            x:Name="CmbVideoCodec"
                                            SelectedIndex="0"
                                            SelectionChanged="CmbVideoCodec_SelectionChanged"
                                            ToolTip="{DynamicResource Str_Convert_VideoCodecTooltip}">
                                            <ComboBoxItem Tag="H264">H.264 (AVC) - most compatible</ComboBoxItem>
                                            <ComboBoxItem Tag="H265">H.265 (HEVC) - about half the size</ComboBoxItem>
                                            <ComboBoxItem Tag="Vp9">VP9 - open, for the web</ComboBoxItem>
                                            <ComboBoxItem Tag="Av1">AV1 - smallest, slowest</ComboBoxItem>
                                        </ComboBox>
                                        <TextBlock
                                            x:Name="TxtCodecNote"
                                            Margin="0,6,0,0"
                                            FontSize="11"
                                            Foreground="{DynamicResource SidebarTextMuted}"
                                            TextWrapping="Wrap"
                                            Visibility="Collapsed" />

                                        <TextBlock
                                            Margin="0,12,0,6"
                                            Style="{StaticResource FieldLabel}"
                                            Text="{DynamicResource Str_Convert_ResolutionLabel}" />
                                        <ComboBox
                                            x:Name="CmbVideoResolution"
                                            SelectedIndex="0"
                                            SelectionChanged="Setting_SelectionChanged"
                                            ToolTip="{DynamicResource Str_FileConverter_LargestHeightToKeep}">
                                            <ComboBoxItem Tag="Original">Original</ComboBoxItem>
                                            <ComboBoxItem Tag="R2160p">Up to 2160p (4K)</ComboBoxItem>
                                            <ComboBoxItem Tag="R1080p">Up to 1080p</ComboBoxItem>
                                            <ComboBoxItem Tag="R720p">Up to 720p</ComboBoxItem>
                                            <ComboBoxItem Tag="R480p">Up to 480p</ComboBoxItem>
                                        </ComboBox>

                                        <TextBlock
                                            Margin="0,12,0,6"
                                            Style="{StaticResource FieldLabel}"
                                            Text="{DynamicResource Str_Convert_QualityLabel}" />
                                        <UniformGrid
                                            x:Name="VideoQualityChips"
                                            Columns="3"
                                            ToolTip="{DynamicResource Str_Convert_VideoQualityTooltip}">
                                            <RadioButton
                                                Margin="0,0,2,0"
                                                Click="Setting_Click"
                                                Content="{DynamicResource Str_FileConverter_Best}"
                                                GroupName="VideoQuality"
                                                Style="{StaticResource ModeToggleButtonStyle}"
                                                Tag="Highest"
                                                ToolTip="{DynamicResource Str_FileConverter_VisuallyLosslessBiggerFiles}" />
                                            <RadioButton
                                                Margin="2,0"
                                                Click="Setting_Click"
                                                Content="{DynamicResource Str_DeviceScanner_Balanced}"
                                                GroupName="VideoQuality"
                                                IsChecked="True"
                                                Style="{StaticResource ModeToggleButtonStyle}"
                                                Tag="Balanced"
                                                ToolTip="{DynamicResource Str_FileConverter_GoodQualityAtA}" />
                                            <RadioButton
                                                Margin="2,0,0,0"
                                                Click="Setting_Click"
                                                Content="{DynamicResource Str_FileConverter_Smaller}"
                                                GroupName="VideoQuality"
                                                Style="{StaticResource ModeToggleButtonStyle}"
                                                Tag="Smaller"
                                                ToolTip="{DynamicResource Str_FileConverter_SmallestFilesSomeDetail}" />
                                        </UniformGrid>
                                    </StackPanel>

                                    <!--  ~~~ Image ~~~  -->
                                    <StackPanel
                                        x:Name="PanelImageOptions"
                                        Margin="0,12,0,0"
                                        Visibility="Collapsed">
                                        <TextBlock
                                            Margin="0,0,0,6"
                                            Style="{StaticResource FieldLabel}"
                                            Text="{DynamicResource Str_Convert_ConvertToLabel}" />
                                        <StackPanel x:Name="ImageFormatChips" ToolTip="{DynamicResource Str_Convert_ImageFormatTooltip}">
                                            <!--  Top row: JPG and AVIF  -->
                                            <UniformGrid Columns="2">
                                                <RadioButton
                                                    Margin="0,0,2,4"
                                                    Click="Setting_Click"
                                                    Content="{DynamicResource Str_BackgroundRemover_Jpg}"
                                                    GroupName="ImageFormat"
                                                    IsChecked="True"
                                                    Style="{StaticResource ModeToggleButtonStyle}"
                                                    Tag="Jpg"
                                                    ToolTip="{DynamicResource Str_FileConverter_PhotosSmallFilesNo}" />
                                                <RadioButton
                                                    Margin="2,0,0,4"
                                                    Click="Setting_Click"
                                                    Content="{DynamicResource Str_FileConverter_Avif}"
                                                    GroupName="ImageFormat"
                                                    Style="{StaticResource ModeToggleButtonStyle}"
                                                    Tag="Avif"
                                                    ToolTip="{DynamicResource Str_FileConverter_AvifTooltip}" />
                                            </UniformGrid>

                                            <!--  Bottom 3x2 grid for remaining 6 formats  -->
                                            <UniformGrid Columns="3">
                                                <RadioButton
                                                    Margin="0,0,2,4"
                                                    Click="Setting_Click"
                                                    Content="{DynamicResource Str_BarcodeGenerator_Png}"
                                                    GroupName="ImageFormat"
                                                    Style="{StaticResource ModeToggleButtonStyle}"
                                                    Tag="Png"
                                                    ToolTip="{DynamicResource Str_FileConverter_LosslessKeepsTransparency}" />
                                                <RadioButton
                                                    Margin="2,0,2,4"
                                                    Click="Setting_Click"
                                                    Content="{DynamicResource Str_BackgroundRemover_Webp}"
                                                    GroupName="ImageFormat"
                                                    Style="{StaticResource ModeToggleButtonStyle}"
                                                    Tag="Webp"
                                                    ToolTip="{DynamicResource Str_FileConverter_SmallerThanJpgKeeps}" />
                                                <RadioButton
                                                    Margin="2,0,0,4"
                                                    Click="Setting_Click"
                                                    Content="{DynamicResource Str_FileConverter_Gif}"
                                                    GroupName="ImageFormat"
                                                    Style="{StaticResource ModeToggleButtonStyle}"
                                                    Tag="Gif"
                                                    ToolTip="{DynamicResource Str_FileConverter_Animations256Colours}" />
                                                <RadioButton
                                                    Margin="0,0,2,0"
                                                    Click="Setting_Click"
                                                    Content="{DynamicResource Str_FileConverter_Bmp}"
                                                    GroupName="ImageFormat"
                                                    Style="{StaticResource ModeToggleButtonStyle}"
                                                    Tag="Bmp"
                                                    ToolTip="{DynamicResource Str_FileConverter_UncompressedBitmap}" />
                                                <RadioButton
                                                    Margin="2,0"
                                                    Click="Setting_Click"
                                                    Content="{DynamicResource Str_FileConverter_Tiff}"
                                                    GroupName="ImageFormat"
                                                    Style="{StaticResource ModeToggleButtonStyle}"
                                                    Tag="Tiff"
                                                    ToolTip="{DynamicResource Str_FileConverter_LosslessForPrintAnd}" />
                                                <RadioButton
                                                    Margin="2,0,0,0"
                                                    Click="Setting_Click"
                                                    Content="{DynamicResource Str_FileConverter_Ico}"
                                                    GroupName="ImageFormat"
                                                    Style="{StaticResource ModeToggleButtonStyle}"
                                                    Tag="Ico"
                                                    ToolTip="{DynamicResource Str_FileConverter_WindowsIconUpTo}" />
                                            </UniformGrid>
                                        </StackPanel>

                                        <TextBlock
                                            Margin="0,12,0,6"
                                            Style="{StaticResource FieldLabel}"
                                            Text="{DynamicResource Str_Convert_QualityLabel}" />
                                        <ComboBox
                                            x:Name="CmbImageQuality"
                                            SelectedIndex="1"
                                            SelectionChanged="Setting_SelectionChanged"
                                            ToolTip="{DynamicResource Str_Convert_ImageQualityTooltip}">
                                            <ComboBoxItem Tag="Highest">Highest (95%)</ComboBoxItem>
                                            <ComboBoxItem Tag="High">High (85%)</ComboBoxItem>
                                            <ComboBoxItem Tag="Medium">Medium (70%)</ComboBoxItem>
                                            <ComboBoxItem Tag="Low">Low (50%)</ComboBoxItem>
                                        </ComboBox>
                                        <TextBlock
                                            x:Name="TxtImageQualityNote"
                                            Margin="0,6,0,0"
                                            FontSize="11"
                                            Foreground="{DynamicResource SidebarTextMuted}"
                                            Text="{DynamicResource Str_FileConverter_ThisFormatIsLossless}"
                                            TextWrapping="Wrap"
                                            Visibility="Collapsed" />

                                        <TextBlock
                                            Margin="0,12,0,6"
                                            Style="{StaticResource FieldLabel}"
                                            Text="{DynamicResource Str_Convert_ResizeLabel}" />
                                        <ComboBox
                                            x:Name="CmbImageResize"
                                            SelectedIndex="0"
                                            SelectionChanged="Setting_SelectionChanged"
                                            ToolTip="{DynamicResource Str_FileConverter_LargestSizeToKeep}">
                                            <ComboBoxItem Tag="Original">Original size</ComboBoxItem>
                                            <ComboBoxItem Tag="R4K">Fit in 3840 x 2160 (4K)</ComboBoxItem>
                                            <ComboBoxItem Tag="R1080p">Fit in 1920 x 1080</ComboBoxItem>
                                            <ComboBoxItem Tag="R720p">Fit in 1280 x 720</ComboBoxItem>
                                            <ComboBoxItem Tag="Custom">Custom...</ComboBoxItem>
                                        </ComboBox>

                                        <Grid
                                            x:Name="PanelImageCustomSize"
                                            Margin="0,8,0,0"
                                            Visibility="Collapsed">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox
                                                x:Name="TxtImageCustomWidth"
                                                PreviewTextInput="Digits_PreviewTextInput"
                                                Text="1920"
                                                TextChanged="Setting_TextChanged"
                                                ToolTip="{DynamicResource Str_FileConverter_MaxWidthInPixels}" />
                                            <TextBlock
                                                Grid.Column="1"
                                                Margin="8,0"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource SidebarTextMuted}"
                                                Text="x" />
                                            <TextBox
                                                x:Name="TxtImageCustomHeight"
                                                Grid.Column="2"
                                                PreviewTextInput="Digits_PreviewTextInput"
                                                Text="1080"
                                                TextChanged="Setting_TextChanged"
                                                ToolTip="{DynamicResource Str_FileConverter_MaxHeightInPixels}" />
                                        </Grid>
                                    </StackPanel>

                                    <!--  ~~~ Audio ~~~  -->
                                    <StackPanel
                                        x:Name="PanelAudioOptions"
                                        Margin="0,12,0,0"
                                        Visibility="Collapsed">
                                        <TextBlock
                                            Margin="0,0,0,6"
                                            Style="{StaticResource FieldLabel}"
                                            Text="{DynamicResource Str_Convert_ConvertToLabel}" />
                                        <UniformGrid
                                            x:Name="AudioFormatChips"
                                            Columns="3"
                                            ToolTip="{DynamicResource Str_Convert_AudioFormatTooltip}">
                                            <RadioButton
                                                Margin="0,0,2,4"
                                                Click="Setting_Click"
                                                Content="MP3"
                                                GroupName="AudioFormat"
                                                IsChecked="True"
                                                Style="{StaticResource ModeToggleButtonStyle}"
                                                Tag="Mp3"
                                                ToolTip="{DynamicResource Str_FileConverter_PlaysEverywhere}" />
                                            <RadioButton
                                                Margin="2,0,2,4"
                                                Click="Setting_Click"
                                                Content="M4A"
                                                GroupName="AudioFormat"
                                                Style="{StaticResource ModeToggleButtonStyle}"
                                                Tag="M4a"
                                                ToolTip="{DynamicResource Str_FileConverter_AacInMp4Apple}" />
                                            <RadioButton
                                                Margin="2,0,0,4"
                                                Click="Setting_Click"
                                                Content="{DynamicResource Str_FileConverter_Aac}"
                                                GroupName="AudioFormat"
                                                Style="{StaticResource ModeToggleButtonStyle}"
                                                Tag="Aac"
                                                ToolTip="{DynamicResource Str_FileConverter_RawAacStream}" />
                                            <RadioButton
                                                Margin="0,0,2,0"
                                                Click="Setting_Click"
                                                Content="{DynamicResource Str_FileConverter_Ogg}"
                                                GroupName="AudioFormat"
                                                Style="{StaticResource ModeToggleButtonStyle}"
                                                Tag="Ogg"
                                                ToolTip="{DynamicResource Str_FileConverter_OggVorbisOpenFormat}" />
                                            <RadioButton
                                                Margin="2,0"
                                                Click="Setting_Click"
                                                Content="{DynamicResource Str_FileConverter_Flac}"
                                                GroupName="AudioFormat"
                                                Style="{StaticResource ModeToggleButtonStyle}"
                                                Tag="Flac"
                                                ToolTip="{DynamicResource Str_FileConverter_LosslessAndCompressed}" />
                                            <RadioButton
                                                Margin="2,0,0,0"
                                                Click="Setting_Click"
                                                Content="{DynamicResource Str_FileConverter_Wav}"
                                                GroupName="AudioFormat"
                                                Style="{StaticResource ModeToggleButtonStyle}"
                                                Tag="Wav"
                                                ToolTip="{DynamicResource Str_FileConverter_LosslessAndUncompressedBig}" />
                                        </UniformGrid>

                                        <TextBlock
                                            Margin="0,12,0,6"
                                            Style="{StaticResource FieldLabel}"
                                            Text="{DynamicResource Str_Convert_BitrateLabel}" />
                                        <ComboBox
                                            x:Name="CmbAudioBitrate"
                                            SelectedIndex="2"
                                            SelectionChanged="Setting_SelectionChanged"
                                            ToolTip="{DynamicResource Str_Convert_BitrateTooltip}">
                                            <ComboBoxItem Tag="K128">128 kbps</ComboBoxItem>
                                            <ComboBoxItem Tag="K192">192 kbps</ComboBoxItem>
                                            <ComboBoxItem Tag="K256">256 kbps</ComboBoxItem>
                                            <ComboBoxItem Tag="K320">320 kbps</ComboBoxItem>
                                        </ComboBox>
                                        <TextBlock
                                            x:Name="TxtBitrateNote"
                                            Margin="0,6,0,0"
                                            FontSize="11"
                                            Foreground="{DynamicResource SidebarTextMuted}"
                                            Text="{DynamicResource Str_FileConverter_LosslessBitrateDoesnT}"
                                            TextWrapping="Wrap"
                                            Visibility="Collapsed" />

                                        <TextBlock
                                            Margin="0,12,0,6"
                                            Style="{StaticResource FieldLabel}"
                                            Text="{DynamicResource Str_Convert_SampleRateLabel}" />
                                        <ComboBox
                                            x:Name="CmbAudioSampleRate"
                                            SelectedIndex="0"
                                            SelectionChanged="Setting_SelectionChanged"
                                            ToolTip="{DynamicResource Str_Convert_SampleRateTooltip}">
                                            <ComboBoxItem Tag="Original">Keep original</ComboBoxItem>
                                            <ComboBoxItem Tag="Hz22050">22.05 kHz</ComboBoxItem>
                                            <ComboBoxItem Tag="Hz44100">44.1 kHz</ComboBoxItem>
                                            <ComboBoxItem Tag="Hz48000">48 kHz</ComboBoxItem>
                                            <ComboBoxItem Tag="Hz96000">96 kHz</ComboBoxItem>
                                        </ComboBox>
                                    </StackPanel>

                                    <TextBlock
                                        x:Name="TxtTypeHint"
                                        Margin="0,10,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource SidebarTextMuted}"
                                        TextWrapping="Wrap" />

                                    <Border
                                        x:Name="FfmpegWarning"
                                        Margin="0,10,0,0"
                                        Padding="10,8"
                                        Background="{DynamicResource StatusWarningBg}"
                                        CornerRadius="8"
                                        Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon
                                                Width="14"
                                                Height="14"
                                                Margin="0,1,8,0"
                                                VerticalAlignment="Top"
                                                Foreground="{DynamicResource StatusWarningFg}"
                                                Kind="AlertOutline" />
                                            <TextBlock
                                                x:Name="TxtFfmpegWarning"
                                                Grid.Column="1"
                                                FontSize="11"
                                                Foreground="{DynamicResource StatusWarningFg}"
                                                TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!--  ============ OPTIONS ============  -->
                            <Border
                                Margin="0,0,0,4"
                                ctl:Tour.Key="Str_Tour_FileConverter_Options"
                                ctl:Tour.Order="3"
                                Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Common_OptionsHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.Tune}" />

                                    <CheckBox
                                        x:Name="ChkMatchType"
                                        Margin="0,8,0,0"
                                        Checked="Option_Changed"
                                        Content="{DynamicResource Str_FileConverter_OnlyListFilesOf}"
                                        Foreground="{DynamicResource SidebarText}"
                                        IsChecked="True"
                                        ToolTip="{DynamicResource Str_Convert_FileSelectionTooltip}"
                                        Unchecked="Option_Changed" />

                                    <CheckBox
                                        x:Name="ChkOverwriteExisting"
                                        Margin="0,8,0,0"
                                        Checked="Option_Changed"
                                        Content="{DynamicResource Str_Convert_OverwriteExisting}"
                                        Foreground="{DynamicResource SidebarText}"
                                        ToolTip="{DynamicResource Str_FileConverter_ReplaceAFileWith}"
                                        Unchecked="Option_Changed" />

                                    <CheckBox
                                        x:Name="ChkDeleteOriginal"
                                        Margin="0,8,0,0"
                                        Checked="Option_Changed"
                                        Content="{DynamicResource Str_Convert_DeleteOriginal}"
                                        Foreground="{DynamicResource SidebarText}"
                                        ToolTip="{DynamicResource Str_FileConverter_AfterAFileConverts}"
                                        Unchecked="Option_Changed" />
                                </StackPanel>
                            </Border>

                            <!--
                                ============ SAVE TO ============
                                The shared Output card (Controls/OutputFolderCard): the same
                                look as the Files card. The folder is kept for this session
                                only; each file type has its own default folder.
                            -->
                            <controls:OutputFolderCard
                                x:Name="OutputCard"
                                Margin="0,8,0,0"
                                ctl:Tour.Key="Str_Tour_FileConverter_Output"
                                ctl:Tour.Order="4"
                                AllowSameAsSource="True"
                                FolderChanged="OutputCard_FolderChanged"
                                Header="{DynamicResource Str_MicRecorder_OutputHeader}"
                                SameAsSourceText="Save next to the originals"
                                ToolName="File Converter">
                                <!--
                                    Keep folder structure / Open the folder when done are made in
                                    the code-behind (BuildOutputOptions): WPF doesn't allow x:Name
                                    on content placed inside another UserControl (error MC3093).
                                -->
                            </controls:OutputFolderCard>
                        </StackPanel>
                    </ScrollViewer>

                    <!--  Kept (empty) for existing code that references it  -->
                    <StackPanel x:Name="OptionsBottomPanel" Grid.Row="2" />
                </Grid>
            </Border>

            <!--  ================= MAIN AREA =================  -->

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Run bar  -->
                <Border
                    Grid.Row="0"
                    Margin="0,0,0,14"
                    Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button
                            x:Name="BtnConvertFiles"
                            MinWidth="180"
                            ctl:Tour.Key="Str_Tour_FileConverter_Run"
                            ctl:Tour.Order="5"
                            VerticalAlignment="Center"
                            Click="BtnConvertFiles_Click"
                            Style="{StaticResource AccentPrimaryButtonStyle}"
                            ToolTip="{DynamicResource Str_Convert_ConvertButtonTooltip}">
                            <Grid HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon
                                    Grid.Column="0"
                                    x:Name="IconConvert"
                                    Width="18"
                                    Height="18"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Kind="SwapHorizontal" />
                                <TextBlock
                                    Grid.Column="1"
                                    x:Name="TxtConvertLabel"
                                    VerticalAlignment="Center"
                                    Text="{DynamicResource Str_Convert_ConvertButton}" TextWrapping="Wrap" />
                            </Grid>
                        </Button>

                        <Button
                            x:Name="BtnPreview"
                            Grid.Column="1"
                            Width="36"
                            Height="36"
                            Margin="8,0,16,0"
                            VerticalAlignment="Center"
                            Click="BtnPreview_Click"
                            Style="{StaticResource NeutralIconButtonStyle}"
                            ToolTip="{DynamicResource Str_FileConverter_ReadTheAddedFolders}">
                            <materialDesign:PackIcon
                                Width="17"
                                Height="17"
                                Kind="Refresh" />
                        </Button>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <ProgressBar
                                x:Name="ProgressConversion"
                                Height="8"
                                Maximum="100"
                                ToolTip="{DynamicResource Str_Convert_ProgressTooltip}" />
                            <TextBlock
                                x:Name="TxtProgress"
                                Margin="0,6,0,0"
                                FontSize="11.5"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="{DynamicResource Str_FileConverter_AddFilesChooseWhat}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock
                            x:Name="TxtProgressPercent"
                            Grid.Column="3"
                            MinWidth="54"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="{DynamicResource AccentColor}"
                            TextAlignment="Right" />
                    </Grid>
                </Border>

                <!--  Files  -->
                <Border
                    Grid.Row="1"
                    ctl:Tour.Key="Str_Tour_FileConverter_Queue"
                    ctl:Tour.Order="6"
                    Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ContentControl
                                VerticalAlignment="Center"
                                Content="{DynamicResource Str_Convert_ResultsTitle}"
                                Style="{StaticResource CardHeader}"
                                Tag="{x:Static materialDesign:PackIconKind.FileSwapOutline}" />

                            <WrapPanel
                                x:Name="SummaryPanel"
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                                <Border
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource StatusInfoBg}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    ToolTip="{DynamicResource Str_FileConverter_FilesThatWillBe}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource StatusInfoFg}"
                                            Kind="FileMultipleOutline" />
                                        <TextBlock
                                            x:Name="TxtSummaryFiles"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource StatusInfoFg}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource AccentColorSubtle}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    ToolTip="{DynamicResource Str_FileConverter_WhatTheyLlBecome}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource AccentColor}"
                                            Kind="ArrowRight" />
                                        <TextBlock
                                            x:Name="TxtSummaryTarget"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource AccentColor}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    x:Name="PillSkipped"
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource RowBg}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    ToolTip="{DynamicResource Str_FileConverter_AlreadyInThisFormat}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource TextSecondary}"
                                            Kind="CheckAll" />
                                        <TextBlock
                                            x:Name="TxtSummarySkipped"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextSecondary}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    x:Name="PillDone"
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource StatusSuccessBg}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    ToolTip="{DynamicResource Str_FileConverter_ConvertedThisSession}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource StatusSuccessFg}"
                                            Kind="CheckCircleOutline" />
                                        <TextBlock
                                            x:Name="TxtSummaryDone"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource StatusSuccessFg}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    x:Name="PillFailed"
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource StatusErrorBg}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    ToolTip="{DynamicResource Str_FileConverter_HoverAFailedRow}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource StatusErrorFg}"
                                            Kind="AlertCircleOutline" />
                                        <TextBlock
                                            x:Name="TxtSummaryFailed"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource StatusErrorFg}" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <StackPanel
                                x:Name="ActionsPanel"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Button
                                    x:Name="BtnOpenOutput"
                                    Margin="0,0,8,0"
                                    Click="BtnOpenOutput_Click"
                                    ToolTip="{DynamicResource Str_FileConverter_OpenTheFolderThe}"
                                    Style="{StaticResource ListToolButtonStyle}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="FolderOpenOutline" />
                                </Button>
                                <Button
                                    x:Name="BtnRemoveFiles"
                                    Margin="0,0,8,0"
                                    Click="BtnRemoveFiles_Click"
                                    ToolTip="{DynamicResource Str_Convert_RemoveFilesTooltip}"
                                    Style="{StaticResource ListToolButtonStyle}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="PlaylistRemove" />
                                </Button>
                                <Button
                                    x:Name="BtnClearFiles"
                                    Click="BtnClearFiles_Click"
                                    ToolTip="{DynamicResource Str_Convert_ClearTooltip}"
                                    Style="{StaticResource ListToolDangerButtonStyle}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="DeleteSweepOutline" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <DataGrid
                            x:Name="DataGridFiles"
                            Grid.Row="1"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            FontSize="12"
                            IsReadOnly="True"
                            MouseDoubleClick="DataGridFiles_MouseDoubleClick"
                            PreviewKeyDown="DataGridFiles_PreviewKeyDown"
                            MinRowHeight="48"
                            SelectionMode="Extended"
                            ToolTip="{DynamicResource Str_Convert_GridTooltip}"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.ScrollUnit="Pixel"
                            VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn
                                    Width="46"
                                    CanUserSort="False"
                                    CellStyle="{StaticResource CompactCellStyle}"
                                    CellTemplate="{StaticResource KindCellTemplate}" />
                                <DataGridTemplateColumn
                                    Width="2*"
                                    MinWidth="90"
                                    CellTemplate="{StaticResource NameCellTemplate}"
                                    Header="{DynamicResource Str_Common_ColHeaderFileName}"
                                    SortMemberPath="Name" />
                                <DataGridTemplateColumn
                                    x:Name="ColFormats"
                                    Width="150"
                                    CellTemplate="{StaticResource FormatsCellTemplate}"
                                    Header="{DynamicResource Str_Convert_ColHeaderTargetFormat}"
                                    SortMemberPath="CurrentFormat" />
                                <DataGridTextColumn
                                    ElementStyle="{StaticResource EllipsisCellTextStyle}"
                                    Width="80"
                                    Binding="{Binding Size}"
                                    Header="{DynamicResource Str_Common_ColHeaderSize}"
                                    SortMemberPath="SizeBytes" />
                                <DataGridTemplateColumn
                                    x:Name="ColResult"
                                    Width="120"
                                    CellTemplate="{StaticResource ResultCellTemplate}"
                                    Header="{DynamicResource Str_FileConverter_Result}"
                                    SortMemberPath="OutputBytes" />
                                <DataGridTemplateColumn
                                    Width="130"
                                    CellTemplate="{StaticResource StatusCellTemplate}"
                                    Header="{DynamicResource Str_Common_ColHeaderStatus}"
                                    SortMemberPath="Status" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <controls:EmptyStateCard
                            x:Name="EmptyStatePanel"
                            Grid.Row="1"
                            Description="{DynamicResource Str_FileConverter_DropFilesOrFolders}"
                            Icon="FileSwapOutline"
                            IsHitTestVisible="False" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
