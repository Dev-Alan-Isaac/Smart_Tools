<UserControl
    x:Class="Smart_Tools.WPF.Views.PdfToolkitView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:models="clr-namespace:Smart_Tools.WPF.Models"
    x:Name="Root"
    AllowDrop="True"
    DragLeave="Root_DragLeave"
    DragOver="Root_DragOver"
    Drop="Root_Drop"
    Loaded="Root_Loaded"
    SizeChanged="Root_SizeChanged">

    <!--
        Backend: Controllers/PdfToolkitManager.cs (page ranges, file names,
        the list, settings, and the merge / split / compress runs),
        PdfToolkitManager.Files.cs (finding PDFs) and PdfToolkitManager.Pdf.cs
        (PdfSharp + ImageMagick); Models/PdfToolkitModel.cs. This file and
        the code-behind are UI only. One list serves all three operations,
        so switching operation keeps the files; the list order is the merge
        order and the tick box decides what's included.
    -->

    <UserControl.Resources>

        <!--  Grid: list position (the merge order)  -->
        <DataTemplate x:Key="NumberCellTemplate" DataType="{x:Type models:PdfToolItem}">
            <Border
                x:Name="Badge"
                MinWidth="24"
                Padding="5,1"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource AccentColorSubtle}"
                CornerRadius="8">
                <TextBlock
                    x:Name="Num"
                    HorizontalAlignment="Center"
                    FontSize="11"
                    FontWeight="Bold"
                    Foreground="{DynamicResource AccentColor}"
                    Text="{Binding Number}"
                    TextTrimming="CharacterEllipsis" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsIncluded}" Value="False">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource RowBg}" />
                    <Setter TargetName="Num" Property="Foreground" Value="{DynamicResource TextSecondary}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  Grid: icon + name + folder  -->
        <DataTemplate x:Key="NameCellTemplate" DataType="{x:Type models:PdfToolItem}">
            <Grid x:Name="NamePanel" ToolTip="{Binding FullPath}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="30"
                    Height="30"
                    Margin="0,0,10,0"
                    VerticalAlignment="Center"
                    Background="{DynamicResource StatusErrorBg}"
                    CornerRadius="7">
                    <materialDesign:PackIcon
                        Width="17"
                        Height="17"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource StatusErrorFg}"
                        Kind="FilePdfBox" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        Foreground="{DynamicResource TextPrimary}"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Margin="0,1,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource TextSecondary}"
                        Text="{Binding Folder}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsIncluded}" Value="False">
                    <Setter TargetName="NamePanel" Property="Opacity" Value="0.5" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  Grid: page count ("?" when the PDF can't be opened - the reason is in the tooltip)  -->
        <DataTemplate x:Key="PagesCellTemplate" DataType="{x:Type models:PdfToolItem}">
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextPrimary}"
                Text="{Binding Pages}"
                TextTrimming="CharacterEllipsis"
                ToolTip="{Binding Message}" />
        </DataTemplate>

        <!--  Grid: status chip. The reason or where it was saved is in the tooltip.  -->
        <DataTemplate x:Key="StatusCellTemplate" DataType="{x:Type models:PdfToolItem}">
            <Border
                x:Name="Chip"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="{DynamicResource RowBg}"
                Style="{StaticResource IconStatusPillStyle}"
                ToolTip="{Binding Message}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon
                        x:Name="ChipIcon"
                        Width="12"
                        Height="12"
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextSecondary}"
                        Kind="ClockOutline" />
                    <TextBlock
                        x:Name="ChipText"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextSecondary}"
                        Text="{Binding StatusText}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Working">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusInfoBg}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="ProgressClock" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource StatusInfoFg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusInfoFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Done">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusSuccessBg}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="CheckCircleOutline" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource StatusSuccessFg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusSuccessFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Skipped">
                    <Setter TargetName="ChipIcon" Property="Kind" Value="MinusCircleOutline" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusErrorBg}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="AlertCircleOutline" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusWarningBg}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="CloseCircleOutline" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  Grid: outcome ("12 files", "4.2 MB → 1.3 MB (−69%)")  -->
        <DataTemplate x:Key="ResultCellTemplate" DataType="{x:Type models:PdfToolItem}">
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextSecondary}"
                Text="{Binding Result}"
                TextTrimming="CharacterEllipsis"
                ToolTip="{Binding Message}" />
        </DataTemplate>

        <!--  Small info note used in the option cards  -->
        <Style x:Key="NoteText" TargetType="TextBlock">
            <Setter Property="Margin" Value="2,8,0,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>


        <!--  Input card: one queued item  -->
        <DataTemplate x:Key="QueueItemTemplate" DataType="{x:Type models:PdfToolkitGroup}">
            <Grid ToolTip="{Binding ToolTip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="26"
                    Height="26"
                    Margin="0,0,8,0"
                    Background="{DynamicResource AccentColorSubtle}"
                    CornerRadius="7">
                    <materialDesign:PackIcon
                        x:Name="GroupIcon"
                        Width="14"
                        Height="14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource AccentColor}"
                        Kind="FileMultipleOutline" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource SidebarText}"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Margin="0,1,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource SidebarTextMuted}"
                        Text="{Binding Subtitle}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button
                    Grid.Column="2"
                    Width="24"
                    Height="24"
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    Click="BtnRemoveGroup_Click"
                    Style="{StaticResource IconButtonStyle}"
                    Tag="{Binding}"
                    ToolTip="{DynamicResource Str_PdfToolkit_TakeThesePdfsOff}">
                    <materialDesign:PackIcon
                        Width="13"
                        Height="13"
                        Kind="Close" />
                </Button>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                    <Setter TargetName="GroupIcon" Property="Kind" Value="Folder" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">

        <!--  No page header: MainWindow's header card shows the tool's icon and name.  -->

        <Grid Margin="16,8,16,16">

            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OptionsColumn" Width="280" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= OPTIONS SIDEBAR =================  -->

            <Border Grid.Column="0" Style="{StaticResource SidebarPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Button
                            x:Name="BtnCollapseOptions"
                            MinHeight="45"
                            HorizontalContentAlignment="Left"
                            Click="BtnCollapseOptions_Click"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Foreground="{DynamicResource SidebarText}"
                            ToolTip="{DynamicResource Str_Common_SidebarToggleTooltip}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="OverridesDefaultStyle" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Margin="16,0,0,0" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Kind="TuneVariant" />
                                <TextBlock
                                    x:Name="TxtOptionsHeaderLabel"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{DynamicResource Str_Common_OptionsLabel}" />
                            </StackPanel>
                        </Button>
                        <Separator
                            x:Name="SepHeader"
                            Margin="16,4"
                            Style="{StaticResource SidebarSeparatorStyle}" />
                    </StackPanel>

                    <ScrollViewer
                        x:Name="OptionsScrollViewer"
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16,4,16,16">

                            <!--
                                ============ FILES ============
                                Same card as Validate Data, Convert Files and Images to PDF: drop area
                                listing what was added (one row per folder, one for loose
                                files), Add files / Add folder / Clear, Include subfolders.
                            -->
                            <controls:InputFolderCard
                                x:Name="InputCard"
                                ctl:Tour.Key="Str_Tour_PdfToolkit_Input"
                                ctl:Tour.Order="2"
                                ClearRequested="InputCard_ClearRequested"
                                Header="{DynamicResource Str_Common_Files}"
                                HeaderIcon="FileMultipleOutline"
                                IncludeSubfoldersChanged="InputCard_IncludeSubfoldersChanged"
                                ItemTemplate="{StaticResource QueueItemTemplate}"
                                PathsAdded="InputCard_PathsAdded" />

                            <!--  ============ OPERATION ============  -->
                            <Border
                                ctl:Tour.Key="Str_Tour_PdfToolkit_Operation"
                                ctl:Tour.Order="1"
                                Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Pdf_OperationHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.FileDocumentMultipleOutline}" />
                                    <UniformGrid Columns="3">
                                        <RadioButton
                                            x:Name="RbOpMerge"
                                            Margin="0,0,2,0"
                                            Click="Operation_Click"
                                            GroupName="PdfOperation"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="Merge"
                                            ToolTip="{DynamicResource Str_PdfToolkit_JoinTheTickedPdfs}">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="18"
                                                    Height="18"
                                                    HorizontalAlignment="Center"
                                                    Kind="CallMerge" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    HorizontalAlignment="Center"
                                                    Text="{DynamicResource Str_Pdf_OpMerge}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="RbOpSplit"
                                            Margin="2,0"
                                            Click="Operation_Click"
                                            GroupName="PdfOperation"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="Split"
                                            ToolTip="{DynamicResource Str_PdfToolkit_CutEachTickedPdf}">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="18"
                                                    Height="18"
                                                    HorizontalAlignment="Center"
                                                    Kind="CallSplit" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    HorizontalAlignment="Center"
                                                    Text="{DynamicResource Str_Pdf_OpSplit}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="RbOpCompress"
                                            Margin="2,0,0,0"
                                            Click="Operation_Click"
                                            GroupName="PdfOperation"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="Compress"
                                            ToolTip="{DynamicResource Str_PdfToolkit_SaveASmallerCopy}">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="18"
                                                    Height="18"
                                                    HorizontalAlignment="Center"
                                                    Kind="ArrowCollapseAll" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    HorizontalAlignment="Center"
                                                    Text="{DynamicResource Str_Pdf_OpCompress}" />
                                            </StackPanel>
                                        </RadioButton>
                                    </UniformGrid>
                                    <TextBlock x:Name="TxtOperationHint" Style="{StaticResource NoteText}" />
                                </StackPanel>
                            </Border>

                            <!--  ============ MERGE ============  -->
                            <Border x:Name="PanelMergeOptions" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Pdf_OpMerge}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.CallMerge}" />
                                    <TextBlock
                                        Margin="0,4,0,6"
                                        Style="{StaticResource FieldLabel}"
                                        Text="{DynamicResource Str_Common_ColHeaderFileName}" />
                                    <TextBox
                                        x:Name="TxtMergeFileName"
                                        Tag="Merged.pdf"
                                        ToolTip="{DynamicResource Str_PdfToolkit_QuotPdfQuotIs}" />
                                    <CheckBox
                                        x:Name="ChkAddBookmarks"
                                        Margin="0,12,0,0"
                                        Checked="Option_Changed"
                                        Content="{DynamicResource Str_PdfToolkit_BookmarkWhereEachFile}"
                                        Foreground="{DynamicResource SidebarText}"
                                        IsChecked="True"
                                        ToolTip="{DynamicResource Str_PdfToolkit_AddsABookmarkNamed}"
                                        Unchecked="Option_Changed"
                                        controls:ChoiceIcon.Kind="BookmarkOutline"
                                        Style="{StaticResource ToggleChipCheckBoxStyle}" />
                                    <TextBlock Style="{StaticResource NoteText}" Text="{DynamicResource Str_PdfToolkit_PagesGoInList}" />
                                </StackPanel>
                            </Border>

                            <!--  ============ SPLIT ============  -->
                            <Border
                                x:Name="PanelSplitOptions"
                                Style="{StaticResource SidebarGroupCardStyle}"
                                Visibility="Collapsed">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Pdf_OpSplit}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.CallSplit}" />
                                    <UniformGrid Columns="3">
                                        <RadioButton
                                            x:Name="RbSplitEveryPage"
                                            Margin="0,0,2,0"
                                            Click="Option_Click"
                                            Content="{DynamicResource Str_PdfToolkit_EachPage}"
                                            GroupName="PdfSplitMode"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="EveryPage"
                                            ToolTip="{DynamicResource Str_PdfToolkit_OneFilePerPage}" />
                                        <RadioButton
                                            x:Name="RbSplitEveryN"
                                            Margin="2,0"
                                            Click="Option_Click"
                                            Content="{DynamicResource Str_PdfToolkit_EveryN}"
                                            GroupName="PdfSplitMode"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="EveryNPages"
                                            ToolTip="{DynamicResource Str_PdfToolkit_ANewFileEvery}" />
                                        <RadioButton
                                            x:Name="RbSplitPageRanges"
                                            Margin="2,0,0,0"
                                            Click="Option_Click"
                                            Content="{DynamicResource Str_ImageConvertPDF_Pages}"
                                            GroupName="PdfSplitMode"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="Ranges"
                                            ToolTip="{DynamicResource Str_PdfToolkit_OnlyThePagesYou}" />
                                    </UniformGrid>

                                    <StackPanel
                                        x:Name="PanelEveryN"
                                        Margin="0,12,0,0"
                                        Visibility="Collapsed">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Str_PdfToolkit_PagesPerFile}" />
                                        <TextBox
                                            x:Name="TxtEveryN"
                                            MaxLength="4"
                                            PreviewTextInput="DigitsOnly_PreviewTextInput"
                                            Tag="e.g. 2"
                                            Text="2"
                                            TextChanged="TxtEveryN_TextChanged"
                                            ToolTip="{DynamicResource Str_PdfToolkit_TheLastFileGets}" />
                                    </StackPanel>

                                    <StackPanel
                                        x:Name="PanelPageRangesInput"
                                        Margin="0,12,0,0"
                                        Visibility="Collapsed">
                                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Str_ImageConvertPDF_Pages}" />
                                        <TextBox
                                            x:Name="TxtPageRanges"
                                            Tag="e.g. 1-3, 5, 8-"
                                            TextChanged="TxtPageRanges_TextChanged"
                                            ToolTip="{DynamicResource Str_PdfToolkit_PagesAndRangesSeparated}" />
                                        <TextBlock x:Name="TxtRangesHint" Style="{StaticResource NoteText}" />
                                        <CheckBox
                                            x:Name="ChkRangesInOneFile"
                                            Margin="0,10,0,0"
                                            Checked="Option_Changed"
                                            Content="{DynamicResource Str_PdfToolkit_PutThesePagesIn}"
                                            Foreground="{DynamicResource SidebarText}"
                                            ToolTip="{DynamicResource Str_PdfToolkit_OnOneFileWith}"
                                            Unchecked="Option_Changed"
                                            controls:ChoiceIcon.Kind="FileMultipleOutline"
                                            Style="{StaticResource ToggleChipCheckBoxStyle}" />
                                    </StackPanel>
                                    <TextBlock Style="{StaticResource NoteText}" Text="{DynamicResource Str_PdfToolkit_APdfThatSplits}" />
                                </StackPanel>
                            </Border>

                            <!--  ============ COMPRESS ============  -->
                            <Border
                                x:Name="PanelCompressOptions"
                                Style="{StaticResource SidebarGroupCardStyle}"
                                Visibility="Collapsed">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Pdf_OpCompress}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.ArrowCollapseAll}" />
                                    <UniformGrid Columns="3">
                                        <RadioButton
                                            x:Name="RbCompressLight"
                                            Margin="0,0,2,0"
                                            Click="Option_Click"
                                            GroupName="CompressLevel"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="Light"
                                            ToolTip="{DynamicResource Str_PdfToolkit_PicturesStaySharpEnough}">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="18"
                                                    Height="18"
                                                    HorizontalAlignment="Center"
                                                    Kind="Feather" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    HorizontalAlignment="Center"
                                                    Text="{DynamicResource Str_PdfToolkit_Light}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="RbCompressBalanced"
                                            Margin="2,0"
                                            Click="Option_Click"
                                            GroupName="CompressLevel"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="Balanced"
                                            ToolTip="{DynamicResource Str_PdfToolkit_GoodOnScreenAnd}">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="18"
                                                    Height="18"
                                                    HorizontalAlignment="Center"
                                                    Kind="ScaleBalance" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    HorizontalAlignment="Center"
                                                    Text="{DynamicResource Str_DeviceScanner_Balanced}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="RbCompressStrong"
                                            Margin="2,0,0,0"
                                            Click="Option_Click"
                                            GroupName="CompressLevel"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="Strong"
                                            ToolTip="{DynamicResource Str_PdfToolkit_SmallestFileForEmail}">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="18"
                                                    Height="18"
                                                    HorizontalAlignment="Center"
                                                    Kind="PackageDown" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    HorizontalAlignment="Center"
                                                    Text="{DynamicResource Str_PasswordGenerator_Strong}" />
                                            </StackPanel>
                                        </RadioButton>
                                    </UniformGrid>
                                    <TextBlock x:Name="TxtCompressHint" Style="{StaticResource NoteText}" />
                                    <Border
                                        Margin="0,10,0,0"
                                        Padding="10,8"
                                        Background="{DynamicResource StatusInfoBg}"
                                        CornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon
                                                Width="14"
                                                Height="14"
                                                Margin="0,1,8,0"
                                                VerticalAlignment="Top"
                                                Foreground="{DynamicResource StatusInfoFg}"
                                                Kind="ShieldCheckOutline" />
                                            <TextBlock
                                                Grid.Column="1"
                                                FontSize="11"
                                                Foreground="{DynamicResource StatusInfoFg}"
                                                Text="{DynamicResource Str_PdfToolkit_TextAndDrawingsStay}"
                                                TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!--  ============ SAVE TO ============  -->
                            <!--
                                The shared Output card (folder for this session only). "Save without
                                asking" is built in code-behind (BuildOutputOptions) - no x:Name may
                                go inside the card's Options (MC3093).
                            -->
                            <controls:OutputFolderCard
                                x:Name="OutputCard"
                                Margin="0,0,0,4"
                                ctl:Tour.Key="Str_Tour_PdfToolkit_Output"
                                ctl:Tour.Order="3"
                                Header="{DynamicResource Str_BackgroundRemover_SaveTo}"
                                HeaderIcon="ContentSaveOutline"
                                ToolName="PDF Toolkit" />
                        </StackPanel>
                    </ScrollViewer>

                    <!--  Kept (empty) for existing code that references it  -->
                    <StackPanel x:Name="OptionsBottomPanel" Grid.Row="2" />
                </Grid>
            </Border>

            <!--  ================= MAIN AREA =================  -->

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Run bar  -->
                <Border
                    Grid.Row="0"
                    Margin="0,0,0,14"
                    Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button
                            x:Name="BtnRun"
                            MinWidth="170"
                            VerticalAlignment="Center"
                            ctl:Tour.Key="Str_Tour_PdfToolkit_Run"
                            ctl:Tour.Order="4"
                            Click="BtnRun_Click"
                            Style="{StaticResource AccentPrimaryButtonStyle}">
                            <Grid HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon
                                    x:Name="IconRun"
                                    Grid.Column="0"
                                    Width="18"
                                    Height="18"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Kind="CallMerge" />
                                <TextBlock
                                    x:Name="TxtRunLabel"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="{DynamicResource Str_PdfToolkit_MergePdfs}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Button>

                        <Button Padding="0"
                            x:Name="BtnOpenOutput"
                            Grid.Column="1"
                            Width="36"
                            Height="36"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Click="BtnOpenOutput_Click"
                            IsEnabled="False"
                            Style="{StaticResource ListToolButtonStyle}"
                            ToolTip="{DynamicResource Str_PdfToolkit_OpenTheResult}">
                            <materialDesign:PackIcon
                                Width="16"
                                Height="16"
                                Kind="OpenInNew" />
                        </Button>

                        <Button Padding="0"
                            x:Name="BtnShowInFolder"
                            Grid.Column="2"
                            Width="36"
                            Height="36"
                            Margin="6,0,16,0"
                            VerticalAlignment="Center"
                            Click="BtnShowInFolder_Click"
                            IsEnabled="False"
                            Style="{StaticResource ListToolButtonStyle}"
                            ToolTip="{DynamicResource Str_PdfToolkit_ShowTheResultIn}">
                            <materialDesign:PackIcon
                                Width="16"
                                Height="16"
                                Kind="FolderSearchOutline" />
                        </Button>

                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                            <ProgressBar
                                x:Name="ProgressBarRun"
                                Height="8"
                                Maximum="100"
                                ToolTip="{DynamicResource Str_Pdf_RunProgressTooltip}" />
                            <TextBlock
                                x:Name="TxtProgressStatus"
                                Margin="0,6,0,0"
                                FontSize="11.5"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="{DynamicResource Str_PdfToolkit_AddPdfsToGet}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </StackPanel>

                        <TextBlock
                            x:Name="TxtProgressPercent"
                            Grid.Column="4"
                            MinWidth="54"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="{DynamicResource AccentColor}"
                            TextAlignment="Right" />
                    </Grid>
                </Border>

                <!--  PDFs  -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ContentControl
                                VerticalAlignment="Center"
                                Content="{DynamicResource Str_Common_FilesTitle}"
                                Style="{StaticResource CardHeader}"
                                Tag="{x:Static materialDesign:PackIconKind.FileDocumentMultipleOutline}" />

                            <WrapPanel
                                x:Name="SummaryPanel"
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                                <Border
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource StatusInfoBg}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    ToolTip="{DynamicResource Str_PdfToolkit_PdfsInTheList}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource StatusInfoFg}"
                                            Kind="FilePdfBox" />
                                        <TextBlock
                                            x:Name="TxtSummaryCount"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource StatusInfoFg}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    x:Name="PillDone"
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource StatusSuccessBg}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource StatusSuccessFg}"
                                            Kind="CheckCircleOutline" />
                                        <TextBlock
                                            x:Name="TxtSummaryDone"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource StatusSuccessFg}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    x:Name="PillFailed"
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource StatusErrorBg}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    ToolTip="{DynamicResource Str_FileConverter_HoverAFailedRow}"
                                    Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource StatusErrorFg}"
                                            Kind="AlertCircleOutline" />
                                        <TextBlock
                                            x:Name="TxtSummaryFailed"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource StatusErrorFg}" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <Button Padding="0"
                                    x:Name="BtnMoveUp"
                                    Width="32"
                                    Height="32"
                                    Click="BtnMoveUp_Click"
                                    Style="{StaticResource NeutralIconButtonStyle}"
                                    ToolTip="{DynamicResource Str_Pdf_MoveUpTooltip}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="ArrowUp" />
                                </Button>
                                <Button Padding="0"
                                    x:Name="BtnMoveDown"
                                    Width="32"
                                    Height="32"
                                    Margin="4,0,0,0"
                                    Click="BtnMoveDown_Click"
                                    Style="{StaticResource NeutralIconButtonStyle}"
                                    ToolTip="{DynamicResource Str_Pdf_MoveDownTooltip}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="ArrowDown" />
                                </Button>

                                <Button Padding="0"
                                    x:Name="BtnSortByName"
                                    Width="32"
                                    Height="32"
                                    Margin="8,0,0,0"
                                    Click="BtnSortByName_Click"
                                    Style="{StaticResource NeutralIconButtonStyle}"
                                    ToolTip="{DynamicResource Str_PdfToolkit_NameOrderPart2}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="SortAlphabeticalAscending" />
                                </Button>
                                <Button Padding="0"
                                    x:Name="BtnSortByDate"
                                    Width="32"
                                    Height="32"
                                    Margin="4,0,0,0"
                                    Click="BtnSortByDate_Click"
                                    Style="{StaticResource NeutralIconButtonStyle}"
                                    ToolTip="{DynamicResource Str_PdfToolkit_DateOrderOldestFirst}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="SortCalendarAscending" />
                                </Button>
                                <Button
                                    x:Name="BtnRemoveSelected"
                                    Margin="10,0,0,0"
                                    Click="BtnRemoveSelected_Click"
                                    Style="{StaticResource ListToolButtonStyle}"
                                    ToolTip="{DynamicResource Str_ImageConvertPDF_TakeTheHighlightedRows}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="PlaylistRemove" />
                                </Button>
                                <Button
                                    x:Name="BtnClearAll"
                                    Margin="10,0,0,0"
                                    Click="BtnClearAll_Click"
                                    Style="{StaticResource ListToolDangerButtonStyle}"
                                    ToolTip="{DynamicResource Str_Pdf_ClearListTooltip}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="DeleteSweepOutline" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <DataGrid
                            x:Name="DataGridResults"
                            Grid.Row="1"
                            ctl:Tour.Key="Str_Tour_PdfToolkit_Results"
                            ctl:Tour.Order="5"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            CanUserDeleteRows="False"
                            CanUserReorderColumns="False"
                            CanUserSortColumns="False"
                            FontSize="12"
                            IsReadOnly="True"
                            LoadingRow="DataGridResults_LoadingRow"
                            MinRowHeight="46"
                            MouseDoubleClick="DataGridResults_MouseDoubleClick"
                            PreviewKeyDown="DataGridResults_PreviewKeyDown"
                            SelectionMode="Extended"
                            ToolTip="{DynamicResource Str_PdfToolkit_ListOrderIsThe}"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.ScrollUnit="Pixel"
                            VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="34" CellStyle="{StaticResource CheckBoxCellStyle}" HeaderStyle="{StaticResource CheckBoxHeaderStyle}">
                                    <DataGridTemplateColumn.Header>
                                        <CheckBox
                                            x:Name="ChkIncludeAll"
                                            Click="ChkIncludeAll_Click"
                                            IsChecked="True"
                                            Style="{StaticResource DataGridCheckBoxStyle}"
                                            ToolTip="{DynamicResource Str_PdfToolkit_TickOrUntickEvery}" />
                                    </DataGridTemplateColumn.Header>
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox
                                                Click="ItemCheckBox_Click"
                                                IsChecked="{Binding IsIncluded, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Style="{StaticResource DataGridCheckBoxStyle}"
                                                ToolTip="{DynamicResource Str_PdfToolkit_TickedPdfsAreIncluded}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn
                                    Width="44"
                                    CellStyle="{StaticResource CompactCellStyle}"
                                    CellTemplate="{StaticResource NumberCellTemplate}"
                                    Header="#" />
                                <DataGridTemplateColumn
                                    Width="2*"
                                    MinWidth="90"
                                    CellTemplate="{StaticResource NameCellTemplate}"
                                    Header="{DynamicResource Str_Common_ColHeaderFile}" />
                                <DataGridTemplateColumn
                                    Width="60"
                                    CellTemplate="{StaticResource PagesCellTemplate}"
                                    Header="{DynamicResource Str_ImageConvertPDF_Pages}" />
                                <DataGridTextColumn
                                    x:Name="ColSize"
                                    Width="76"
                                    Binding="{Binding Size, Mode=OneWay}"
                                    ElementStyle="{StaticResource EllipsisCellTextStyle}"
                                    Header="{DynamicResource Str_Common_ColHeaderSize}" />
                                <DataGridTemplateColumn
                                    Width="104"
                                    CellTemplate="{StaticResource StatusCellTemplate}"
                                    Header="{DynamicResource Str_Common_ColHeaderStatus}" />
                                <DataGridTemplateColumn
                                    x:Name="ColResult"
                                    Width="*"
                                    MinWidth="70"
                                    CellTemplate="{StaticResource ResultCellTemplate}"
                                    Header="{DynamicResource Str_FileConverter_Result}" />
                                <DataGridTemplateColumn Width="40" CellStyle="{StaticResource CompactCellStyle}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button
                                                Width="26"
                                                Height="26"
                                                Click="BtnRowRemove_Click"
                                                Style="{StaticResource IconButtonStyle}"
                                                Tag="{Binding}"
                                                ToolTip="{DynamicResource Str_PdfToolkit_TakeThisPdfOff}">
                                                <materialDesign:PackIcon
                                                    Width="14"
                                                    Height="14"
                                                    Kind="Close" />
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <controls:EmptyStateCard
                            x:Name="EmptyStatePanel"
                            Grid.Row="1"
                            Description="{DynamicResource Str_PdfToolkit_AddPdfsOnThe}"
                            Icon="FilePdfBox"
                            IsHitTestVisible="False" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!--  Drop overlay: anywhere on the page  -->
        <Border
            x:Name="DropOverlay"
            Margin="16,8,16,16"
            Panel.ZIndex="10"
            Style="{StaticResource DropZoneStyle}">
            <Grid>
                <Rectangle
                    RadiusX="14"
                    RadiusY="14"
                    Stroke="{DynamicResource AccentColor}"
                    StrokeDashArray="6 4"
                    StrokeThickness="2" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.TrayArrowDown}" />
                    <TextBlock
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        Text="{DynamicResource Str_PdfToolkit_DropToAddPdfs}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondary}"
                        Text="{DynamicResource Str_PdfToolkit_PdfFilesAndWhole}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
