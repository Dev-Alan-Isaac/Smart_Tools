<UserControl
    x:Class="Smart_Tools.WPF.Views.PdfHubView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    x:Name="Root"
    Focusable="True">

    <!--
        PDF Tools is one tool with two pages: Merge & split (the PDF Toolkit: join, cut, compress) and Pages & protect
        (what used to be PDF Extras: rotate, remove or keep pages, page numbers, crop, page size, document details, passwords).
        Each page is the full tool it always was - this bar only switches between them, the same way Media Viewer does.
        Only the page shown is in the visual tree. Images to PDF stays its own tool: it makes a PDF, these two change one.
    -->

    <Grid Background="{DynamicResource ContentBg}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Margin="16,8,16,0" Style="{StaticResource CardStyle}" ctl:Tour.Key="Str_Tour_PdfHub_Modes" ctl:Tour.Order="0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <UniformGrid Width="360" Columns="2">
                    <RadioButton x:Name="RadioMerge" Margin="0,0,2,0" Checked="Mode_Checked" GroupName="PdfHubMode" IsChecked="True" Style="{StaticResource ModeToggleButtonStyle}" Tag="MergeSplit" ToolTip="Join PDFs into one, split one into several, or make it smaller">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" Kind="FileSync" />
                            <TextBlock VerticalAlignment="Center" Text="Merge &amp; split" />
                        </StackPanel>
                    </RadioButton>
                    <RadioButton x:Name="RadioPages" Margin="2,0,0,0" Checked="Mode_Checked" GroupName="PdfHubMode" Style="{StaticResource ModeToggleButtonStyle}" Tag="PagesProtect" ToolTip="Rotate, remove or number pages, crop, edit the details, add or remove a password">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" Kind="FileCogOutline" />
                            <TextBlock VerticalAlignment="Center" Text="Pages &amp; protect" />
                        </StackPanel>
                    </RadioButton>
                </UniformGrid>

                <TextBlock x:Name="TxtHint" Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
            </Grid>
        </Border>

        <ContentPresenter x:Name="PageHost" Grid.Row="1" />
    </Grid>
</UserControl>
