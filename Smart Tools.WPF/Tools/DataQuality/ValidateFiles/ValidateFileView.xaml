<UserControl
    x:Class="Smart_Tools.WPF.Views.ValidateFileView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:models="clr-namespace:Smart_Tools.WPF.Models"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    x:Name="Root"
    AllowDrop="True"
    DragLeave="Root_DragLeave"
    DragOver="Root_DragOver"
    Drop="Root_Drop"
    Loaded="Root_Loaded"
    SizeChanged="Root_SizeChanged">

    <!--
        Backend: Controllers/ValidateManager.cs (kinds, signatures, the file
        list, reports, settings), ValidateManager.Checks.cs (the checks),
        .Media.cs (ffprobe/ffmpeg), .Images.cs (Windows picture codecs),
        .Run.cs (folders, the scan, quarantine); Models/ValidateFilesModel.cs.
        This file and the code-behind are UI only. Choices are read by Tag.
    -->

    <UserControl.Resources>

        <!--  Chevron buttons of the size stepper  -->
        <Style x:Key="SpinnerButtonStyle" TargetType="RepeatButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextMuted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RepeatButton">
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="3">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarItemHoverBg}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentColor}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.4" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Input card: one queued file group / folder  -->
        <DataTemplate x:Key="QueueItemTemplate" DataType="{x:Type models:ValidationQueueGroup}">
            <Grid ToolTip="{Binding ToolTip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="26"
                    Height="26"
                    Margin="0,0,8,0"
                    Background="{DynamicResource AccentColorSubtle}"
                    CornerRadius="7">
                    <materialDesign:PackIcon
                        x:Name="GroupIcon"
                        Width="14"
                        Height="14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource AccentColor}"
                        Kind="FileMultipleOutline" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource SidebarText}"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Margin="0,1,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource SidebarTextMuted}"
                        Text="{Binding Subtitle}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button
                    Grid.Column="2"
                    Width="24"
                    Height="24"
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    Click="BtnRemoveQueueGroup_Click"
                    Style="{StaticResource IconButtonStyle}"
                    Tag="{Binding}"
                    ToolTip="{DynamicResource Str_Validate_RemoveFromListTooltip}">
                    <materialDesign:PackIcon
                        Width="13"
                        Height="13"
                        Kind="Close" />
                </Button>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                    <Setter TargetName="GroupIcon" Property="Kind" Value="Folder" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  Grid: file kind icon  -->
        <DataTemplate x:Key="KindCellTemplate" DataType="{x:Type models:FileValidationResult}">
            <Border
                Width="30"
                Height="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource AccentColorSubtle}"
                CornerRadius="8">
                <materialDesign:PackIcon
                    x:Name="KindIcon"
                    Width="16"
                    Height="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource AccentColor}"
                    Kind="FileOutline" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Category}" Value="Video">
                    <Setter TargetName="KindIcon" Property="Kind" Value="Filmstrip" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Category}" Value="Image">
                    <Setter TargetName="KindIcon" Property="Kind" Value="ImageOutline" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Category}" Value="Audio">
                    <Setter TargetName="KindIcon" Property="Kind" Value="MusicNote" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Category}" Value="Document">
                    <Setter TargetName="KindIcon" Property="Kind" Value="FileDocumentOutline" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Category}" Value="Archive">
                    <Setter TargetName="KindIcon" Property="Kind" Value="ZipBoxOutline" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  Grid: name + folder (or quarantine location)  -->
        <DataTemplate x:Key="NameCellTemplate" DataType="{x:Type models:FileValidationResult}">
            <StackPanel VerticalAlignment="Center" ToolTip="{Binding CurrentPath}">
                <TextBlock
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimary}"
                    Text="{Binding FileName}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Margin="0,1,0,0"
                    FontSize="11"
                    Foreground="{DynamicResource TextSecondary}"
                    Text="{Binding Folder}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <!--  Grid: details, full text in the tooltip  -->
        <DataTemplate x:Key="DetailsCellTemplate" DataType="{x:Type models:FileValidationResult}">
            <TextBlock
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextSecondary}"
                Text="{Binding Details}"
                TextTrimming="CharacterEllipsis"
                TextWrapping="Wrap"
                ToolTip="{Binding Details}" />
        </DataTemplate>

        <!--  Grid: status chip. Replaces ValidationStatusToBrushConverter (fixed colours, white text).  -->
        <DataTemplate x:Key="StatusCellTemplate" DataType="{x:Type models:FileValidationResult}">
            <Border
                x:Name="Chip"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="{DynamicResource RowBg}"
                Style="{StaticResource IconStatusPillStyle}"
                ToolTip="{Binding Details}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon
                        x:Name="ChipIcon"
                        Width="12"
                        Height="12"
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextSecondary}"
                        Kind="ClockOutline" />
                    <TextBlock
                        x:Name="ChipText"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextSecondary}"
                        Text="{Binding StatusText}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Checking">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource AccentColorSubtle}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="Autorenew" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource AccentColor}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource AccentColor}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Valid">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusSuccessBg}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="CheckCircleOutline" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource StatusSuccessFg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusSuccessFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Warning">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusWarningBg}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="AlertOutline" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Corrupted">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusErrorBg}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="AlertCircleOutline" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Unknown">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusInfoBg}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="HelpCircleOutline" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource StatusInfoFg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusInfoFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Skipped">
                    <Setter TargetName="ChipIcon" Property="Kind" Value="MinusCircleOutline" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                    <Setter TargetName="ChipIcon" Property="Kind" Value="CloseCircleOutline" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">

        <!--  No page header: MainWindow's header card shows the tool's icon and name.  -->

        <Grid Margin="16,8,16,16">

            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OptionsColumn" Width="280" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= OPTIONS SIDEBAR =================  -->

            <Border Grid.Column="0" Style="{StaticResource SidebarPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Button
                            x:Name="BtnCollapseOptions"
                            MinHeight="45"
                            HorizontalContentAlignment="Left"
                            Click="BtnCollapseOptions_Click"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Foreground="{DynamicResource SidebarText}"
                            ToolTip="{DynamicResource Str_Common_SidebarToggleTooltip}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="OverridesDefaultStyle" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Margin="16,0,0,0" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Kind="TuneVariant" />
                                <TextBlock
                                    x:Name="TxtOptionsHeaderLabel"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{DynamicResource Str_Common_OptionsLabel}" />
                            </StackPanel>
                        </Button>
                        <Separator
                            x:Name="SepHeader"
                            Margin="16,4"
                            Style="{StaticResource SidebarSeparatorStyle}" />
                    </StackPanel>

                    <ScrollViewer
                        x:Name="OptionsScrollViewer"
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16,4,16,16">

                            <!--  ============ FILES ============  -->
                            <controls:InputFolderCard
                                ctl:Tour.Key="Str_Tour_ValidateFiles_Input"
                                ctl:Tour.Order="1"
                                x:Name="InputCard"
                                ClearRequested="InputCard_ClearRequested"
                                IncludeSubfoldersChanged="InputCard_IncludeSubfoldersChanged"
                                ItemTemplate="{StaticResource QueueItemTemplate}"
                                PathsAdded="InputCard_PathsAdded" />
                            <!--  ============ WHAT TO CHECK ============  -->
                            <Border ctl:Tour.Key="Str_Tour_ValidateFiles_Type" ctl:Tour.Order="2" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Validate_TypeHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.ShieldSearch}" />

                                    <UniformGrid
                                        x:Name="TypeTiles"
                                        Columns="3"
                                        ToolTip="{DynamicResource Str_Validate_TypeTooltip}">
                                        <RadioButton
                                            Margin="0,0,3,6"
                                            Click="RadioType_Click"
                                            GroupName="ValidationType"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="Auto"
                                            ToolTip="{DynamicResource Str_Validate_TypeAllTooltip}">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="17"
                                                    Height="17"
                                                    HorizontalAlignment="Center"
                                                    Kind="FileSearchOutline" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    HorizontalAlignment="Center"
                                                    Text="{DynamicResource Str_DiskSpaceAnalyzer_All}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton
                                            Margin="3,0,3,6"
                                            Click="RadioType_Click"
                                            GroupName="ValidationType"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="Video"
                                            ToolTip="{DynamicResource Str_Validate_TypeVideoTooltip}">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="17"
                                                    Height="17"
                                                    HorizontalAlignment="Center"
                                                    Kind="Filmstrip" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    HorizontalAlignment="Center"
                                                    Text="{DynamicResource Str_FileConverter_Video}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton
                                            Margin="3,0,0,6"
                                            Click="RadioType_Click"
                                            GroupName="ValidationType"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="Image"
                                            ToolTip="{DynamicResource Str_Validate_TypeImageTooltip}">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="17"
                                                    Height="17"
                                                    HorizontalAlignment="Center"
                                                    Kind="ImageOutline" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    HorizontalAlignment="Center"
                                                    Text="{DynamicResource Str_ImgEdit_ColHeaderImage}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton
                                            Margin="0,0,3,0"
                                            Click="RadioType_Click"
                                            GroupName="ValidationType"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="Audio"
                                            ToolTip="{DynamicResource Str_Validate_TypeAudioTooltip}">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="17"
                                                    Height="17"
                                                    HorizontalAlignment="Center"
                                                    Kind="MusicNote" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    HorizontalAlignment="Center"
                                                    Text="{DynamicResource Str_DuplicateFinder_Audio}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton
                                            Margin="3,0,3,0"
                                            Click="RadioType_Click"
                                            GroupName="ValidationType"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="Document"
                                            ToolTip="{DynamicResource Str_Validate_TypeDocumentTooltip}">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="17"
                                                    Height="17"
                                                    HorizontalAlignment="Center"
                                                    Kind="FileDocumentOutline" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    HorizontalAlignment="Center"
                                                    Text="{DynamicResource Str_DuplicateFinder_Docs}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton
                                            Margin="3,0,0,0"
                                            Click="RadioType_Click"
                                            GroupName="ValidationType"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="Archive"
                                            ToolTip="{DynamicResource Str_Validate_TypeArchiveTooltip}">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="17"
                                                    Height="17"
                                                    HorizontalAlignment="Center"
                                                    Kind="ZipBoxOutline" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    HorizontalAlignment="Center"
                                                    Text="{DynamicResource Str_FileGen_ArchiveHeader}" />
                                            </StackPanel>
                                        </RadioButton>
                                    </UniformGrid>

                                    <TextBlock
                                        x:Name="TxtTypeHint"
                                        Margin="2,10,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource SidebarTextMuted}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!--  ============ CHECKS ============  -->
                            <Border ctl:Tour.Key="Str_Tour_ValidateFiles_Settings" ctl:Tour.Order="3" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Validate_SettingsHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.TuneVertical}" />

                                    <!--  ~~~ All (auto) ~~~  -->
                                    <StackPanel x:Name="PanelAutoDetect">
                                        <TextBlock
                                            Margin="0,0,0,10"
                                            FontSize="11"
                                            Foreground="{DynamicResource SidebarTextMuted}"
                                            Text="{DynamicResource Str_Validate_AutoDetectHint}"
                                            TextWrapping="Wrap" />
                                        <CheckBox
                                            x:Name="ChkAutoVideo"
                                            Checked="Option_Changed"
                                            Content="{DynamicResource Str_Validate_VideoFiles}"
                                            Foreground="{DynamicResource SidebarText}"
                                            IsChecked="True"
                                            ToolTip="{DynamicResource Str_Validate_VideoFilesTooltip}"
                                            Unchecked="Option_Changed" />
                                        <CheckBox
                                            x:Name="ChkAutoImage"
                                            Checked="Option_Changed"
                                            Content="{DynamicResource Str_Validate_ImageFiles}"
                                            Foreground="{DynamicResource SidebarText}"
                                            IsChecked="True"
                                            ToolTip="{DynamicResource Str_Validate_ImageFilesTooltip}"
                                            Unchecked="Option_Changed" />
                                        <CheckBox
                                            x:Name="ChkAutoAudio"
                                            Checked="Option_Changed"
                                            Content="{DynamicResource Str_Validate_AudioFiles}"
                                            Foreground="{DynamicResource SidebarText}"
                                            IsChecked="True"
                                            ToolTip="{DynamicResource Str_Validate_AudioFilesTooltip}"
                                            Unchecked="Option_Changed" />
                                        <CheckBox
                                            x:Name="ChkAutoDocument"
                                            Checked="Option_Changed"
                                            Content="{DynamicResource Str_Validate_DocumentFiles}"
                                            Foreground="{DynamicResource SidebarText}"
                                            IsChecked="True"
                                            ToolTip="{DynamicResource Str_Validate_DocumentFilesTooltip}"
                                            Unchecked="Option_Changed" />
                                        <CheckBox
                                            x:Name="ChkAutoArchive"
                                            Checked="Option_Changed"
                                            Content="{DynamicResource Str_Validate_ArchiveFiles}"
                                            Foreground="{DynamicResource SidebarText}"
                                            IsChecked="True"
                                            ToolTip="{DynamicResource Str_Validate_ArchiveFilesTooltip}"
                                            Unchecked="Option_Changed" />
                                    </StackPanel>

                                    <!--  ~~~ Video ~~~  -->
                                    <StackPanel x:Name="PanelVideo" Visibility="Collapsed">
                                        <CheckBox
                                            x:Name="ChkVideoContainer"
                                            Checked="Option_Changed"
                                            Content="{DynamicResource Str_Validate_VideoContainer}"
                                            Foreground="{DynamicResource SidebarText}"
                                            IsChecked="True"
                                            ToolTip="{DynamicResource Str_Validate_VideoContainerTooltip}"
                                            Unchecked="Option_Changed" />
                                        <CheckBox
                                            x:Name="ChkVideoStream"
                                            Checked="Option_Changed"
                                            Content="{DynamicResource Str_Validate_VideoStream}"
                                            Foreground="{DynamicResource SidebarText}"
                                            IsChecked="True"
                                            ToolTip="{DynamicResource Str_Validate_VideoStreamTooltip}"
                                            Unchecked="Option_Changed" />
                                        <CheckBox
                                            x:Name="ChkVideoAudioStream"
                                            Checked="Option_Changed"
                                            Content="{DynamicResource Str_Validate_VideoAudioStream}"
                                            Foreground="{DynamicResource SidebarText}"
                                            IsChecked="True"
                                            ToolTip="{DynamicResource Str_Validate_VideoAudioStreamTooltip}"
                                            Unchecked="Option_Changed" />
                                        <CheckBox
                                            x:Name="ChkVideoDuration"
                                            Checked="Option_Changed"
                                            Content="{DynamicResource Str_Validate_DurationMatches}"
                                            Foreground="{DynamicResource SidebarText}"
                                            ToolTip="{DynamicResource Str_Validate_DurationMatchesTooltip}"
                                            Unchecked="Option_Changed" />
                                        <CheckBox
                                            x:Name="ChkVideoFrames"
                                            Checked="Option_Changed"
                                            Content="{DynamicResource Str_Validate_DroppedFrames}"
                                            Foreground="{DynamicResource SidebarText}"
                                            ToolTip="{DynamicResource Str_Validate_DroppedFramesTooltip}"
                                            Unchecked="Option_Changed" />

                                        <StackPanel x:Name="PanelScanDepth">
                                            <TextBlock
                                                Margin="0,2,0,6"
                                                Style="{StaticResource FieldLabel}"
                                                Text="{DynamicResource Str_Validate_ScanDepth}" />
                                            <ComboBox
                                                x:Name="CmbVideoScanDepth"
                                                SelectionChanged="Option_SelectionChanged"
                                                ToolTip="{DynamicResource Str_Validate_ScanDepthTooltip}">
                                                <ComboBoxItem Content="{DynamicResource Str_ValidateFile_QuickStartAndEnd}" Tag="Quick" />
                                                <ComboBoxItem
                                                    Content="{DynamicResource Str_ValidateFile_StandardSamplesThroughout}"
                                                    IsSelected="True"
                                                    Tag="Standard" />
                                                <ComboBoxItem Content="{DynamicResource Str_ValidateFile_FullEveryFrameSlowest}" Tag="Full" />
                                            </ComboBox>
                                        </StackPanel>
                                    </StackPanel>

                                    <!--  ~~~ Image ~~~  -->
                                    <StackPanel x:Name="PanelImage" Visibility="Collapsed">
                                        <CheckBox
                                            x:Name="ChkImageHeader"
                                            Checked="Option_Changed"
                                            Content="{DynamicResource Str_Validate_HeaderSignature}"
                                            Foreground="{DynamicResource SidebarText}"
                                            IsChecked="True"
                                            ToolTip="{DynamicResource Str_Validate_HeaderSignatureTooltip}"
                                            Unchecked="Option_Changed" />
                                        <CheckBox
                                            x:Name="ChkImageFullDecode"
                                            Checked="Option_Changed"
                                            Content="{DynamicResource Str_Validate_FullPixelDecode}"
                                            Foreground="{DynamicResource SidebarText}"
                                            IsChecked="True"
                                            ToolTip="{DynamicResource Str_Validate_FullPixelDecodeTooltip}"
                                            Unchecked="Option_Changed" />
                                        <CheckBox
                                            x:Name="ChkImageTruncated"
                                            Checked="Option_Changed"
                                            Content="{DynamicResource Str_Validate_TruncatedFiles}"
                                            Foreground="{DynamicResource SidebarText}"
                                            IsChecked="True"
                                            ToolTip="{DynamicResource Str_Validate_TruncatedFilesTooltip}"
                                            Unchecked="Option_Changed" />
                                        <CheckBox
                                            x:Name="ChkImageExif"
                                            Checked="Option_Changed"
                                            Content="{DynamicResource Str_Validate_ExifReadable}"
                                            Foreground="{DynamicResource SidebarText}"
                                            ToolTip="{DynamicResource Str_Validate_ExifReadableTooltip}"
                                            Unchecked="Option_Changed" />
                                        <CheckBox
                                            x:Name="ChkImageSmall"
                                            Checked="Option_Changed"
                                            Content="{DynamicResource Str_Validate_SmallDimensions}"
                                            Foreground="{DynamicResource SidebarText}"
                                            ToolTip="{DynamicResource Str_Validate_SmallDimensionsTooltip}"
                                            Unchecked="Option_Changed" />
                                    </StackPanel>

                                    <!--  ~~~ Audio ~~~  -->
                                    <StackPanel x:Name="PanelAudio" Visibility="Collapsed">
                                        <CheckBox
                                            x:Name="ChkAudioHeader"
                                            Checked="Option_Changed"
                                            Content="{DynamicResource Str_Validate_HeaderSignature}"
                                            Foreground="{DynamicResource SidebarText}"
                                            IsChecked="True"
                                            ToolTip="{DynamicResource Str_Validate_HeaderSignatureTooltip}"
                                            Unchecked="Option_Changed" />
                                        <CheckBox
                                            x:Name="ChkAudioFullDecode"
                                            Checked="Option_Changed"
                                            Content="{DynamicResource Str_Validate_FullAudioDecode}"
                                            Foreground="{DynamicResource SidebarText}"
                                            IsChecked="True"
                                            ToolTip="{DynamicResource Str_Validate_FullAudioDecodeTooltip}"
                                            Unchecked="Option_Changed" />
                                        <CheckBox
                                            x:Name="ChkAudioTruncated"
                                            Checked="Option_Changed"
                                            Content="{DynamicResource Str_Validate_TruncatedFiles}"
                                            Foreground="{DynamicResource SidebarText}"
                                            IsChecked="True"
                                            ToolTip="{DynamicResource Str_Validate_TruncatedFilesTooltip}"
                                            Unchecked="Option_Changed" />
                                        <CheckBox
                                            x:Name="ChkAudioDuration"
                                            Checked="Option_Changed"
                                            Content="{DynamicResource Str_Validate_DurationMatches}"
                                            Foreground="{DynamicResource SidebarText}"
                                            ToolTip="{DynamicResource Str_Validate_DurationMatchesTooltip}"
                                            Unchecked="Option_Changed" />
                                        <CheckBox
                                            x:Name="ChkAudioSilent"
                                            Checked="Option_Changed"
                                            Content="{DynamicResource Str_Validate_SilentTracks}"
                                            Foreground="{DynamicResource SidebarText}"
                                            ToolTip="{DynamicResource Str_Validate_SilentTracksTooltip}"
                                            Unchecked="Option_Changed" />
                                    </StackPanel>

                                    <!--  ~~~ Document ~~~  -->
                                    <StackPanel x:Name="PanelDocument" Visibility="Collapsed">
                                        <CheckBox
                                            x:Name="ChkDocStructure"
                                            Checked="Option_Changed"
                                            Content="{DynamicResource Str_Validate_DocStructure}"
                                            Foreground="{DynamicResource SidebarText}"
                                            IsChecked="True"
                                            ToolTip="{DynamicResource Str_Validate_DocStructureTooltip}"
                                            Unchecked="Option_Changed" />
                                        <CheckBox
                                            x:Name="ChkDocOpens"
                                            Checked="Option_Changed"
                                            Content="{DynamicResource Str_Validate_DocOpens}"
                                            Foreground="{DynamicResource SidebarText}"
                                            IsChecked="True"
                                            ToolTip="{DynamicResource Str_Validate_DocOpensTooltip}"
                                            Unchecked="Option_Changed" />
                                        <CheckBox
                                            x:Name="ChkDocEmbeddedImages"
                                            Checked="Option_Changed"
                                            Content="{DynamicResource Str_Validate_DocImages}"
                                            Foreground="{DynamicResource SidebarText}"
                                            ToolTip="{DynamicResource Str_Validate_DocImagesTooltip}"
                                            Unchecked="Option_Changed" />
                                        <CheckBox
                                            x:Name="ChkDocEmbeddedFonts"
                                            Checked="Option_Changed"
                                            Content="{DynamicResource Str_Validate_DocFonts}"
                                            Foreground="{DynamicResource SidebarText}"
                                            ToolTip="{DynamicResource Str_Validate_DocFontsTooltip}"
                                            Unchecked="Option_Changed" />
                                        <CheckBox
                                            x:Name="ChkDocPassword"
                                            Checked="Option_Changed"
                                            Content="{DynamicResource Str_Validate_DocPassword}"
                                            Foreground="{DynamicResource SidebarText}"
                                            IsChecked="True"
                                            ToolTip="{DynamicResource Str_Validate_DocPasswordTooltip}"
                                            Unchecked="Option_Changed" />
                                    </StackPanel>

                                    <!--  ~~~ Archive ~~~  -->
                                    <StackPanel x:Name="PanelArchive" Visibility="Collapsed">
                                        <CheckBox
                                            x:Name="ChkArchiveCrc"
                                            Checked="Option_Changed"
                                            Content="{DynamicResource Str_Validate_ArchiveCrc}"
                                            Foreground="{DynamicResource SidebarText}"
                                            IsChecked="True"
                                            ToolTip="{DynamicResource Str_Validate_ArchiveCrcTooltip}"
                                            Unchecked="Option_Changed" />
                                        <CheckBox
                                            x:Name="ChkArchiveExtract"
                                            Checked="Option_Changed"
                                            Content="{DynamicResource Str_Validate_ArchiveExtract}"
                                            Foreground="{DynamicResource SidebarText}"
                                            IsChecked="True"
                                            ToolTip="{DynamicResource Str_Validate_ArchiveExtractTooltip}"
                                            Unchecked="Option_Changed" />
                                        <CheckBox
                                            x:Name="ChkArchivePassword"
                                            Checked="Option_Changed"
                                            Content="{DynamicResource Str_Validate_ArchivePassword}"
                                            Foreground="{DynamicResource SidebarText}"
                                            IsChecked="True"
                                            ToolTip="{DynamicResource Str_Validate_ArchivePasswordTooltip}"
                                            Unchecked="Option_Changed" />
                                        <CheckBox
                                            x:Name="ChkArchiveBomb"
                                            Checked="Option_Changed"
                                            Content="{DynamicResource Str_Validate_ArchiveBomb}"
                                            Foreground="{DynamicResource SidebarText}"
                                            ToolTip="{DynamicResource Str_Validate_ArchiveBombTooltip}"
                                            Unchecked="Option_Changed" />
                                    </StackPanel>

                                    <!--  ffmpeg missing  -->
                                    <Border
                                        x:Name="FfmpegWarning"
                                        Margin="0,6,0,0"
                                        Padding="10,8"
                                        Background="{DynamicResource StatusWarningBg}"
                                        CornerRadius="8"
                                        Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon
                                                Width="14"
                                                Height="14"
                                                Margin="0,1,6,0"
                                                Foreground="{DynamicResource StatusWarningFg}"
                                                Kind="AlertOutline" />
                                            <TextBlock
                                                x:Name="TxtFfmpegWarning"
                                                Grid.Column="1"
                                                FontSize="11"
                                                Foreground="{DynamicResource StatusWarningFg}"
                                                TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!--  ============ OPTIONS ============  -->
                            <Border Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Validate_OptionsHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.Tune}" />

                                    <TextBlock
                                        Margin="0,0,0,6"
                                        Style="{StaticResource FieldLabel}"
                                        Text="{DynamicResource Str_Validate_SkipSize}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="72" />
                                        </Grid.ColumnDefinitions>
                                        <Border Style="{StaticResource InputBarStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="20" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox
                                                    x:Name="TxtSkipSizeValue"
                                                    MaxLength="6"
                                                    PreviewTextInput="Digits_PreviewTextInput"
                                                    Style="{StaticResource BareTextBox}"
                                                    Tag="0 = no limit"
                                                    Text="0"
                                                    TextAlignment="Right"
                                                    TextChanged="Setting_TextChanged"
                                                    ToolTip="{DynamicResource Str_Validate_SkipSizeTooltip}" />
                                                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                    <RepeatButton
                                                        Height="12"
                                                        Click="BtnSkipSizeUp_Click"
                                                        Style="{StaticResource SpinnerButtonStyle}">
                                                        <materialDesign:PackIcon
                                                            Width="12"
                                                            Height="12"
                                                            Kind="ChevronUp" />
                                                    </RepeatButton>
                                                    <RepeatButton
                                                        Height="12"
                                                        Margin="0,1,0,0"
                                                        Click="BtnSkipSizeDown_Click"
                                                        Style="{StaticResource SpinnerButtonStyle}">
                                                        <materialDesign:PackIcon
                                                            Width="12"
                                                            Height="12"
                                                            Kind="ChevronDown" />
                                                    </RepeatButton>
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                        <ComboBox
                                            x:Name="CmbSkipSizeUnit"
                                            Grid.Column="2"
                                            SelectionChanged="Option_SelectionChanged"
                                            ToolTip="{DynamicResource Str_Validate_SkipSizeUnitTooltip}">
                                            <ComboBoxItem Content="KB" Tag="KB" />
                                            <ComboBoxItem
                                                Content="MB"
                                                IsSelected="True"
                                                Tag="MB" />
                                            <ComboBoxItem Content="GB" Tag="GB" />
                                            <ComboBoxItem Content="TB" Tag="TB" />
                                        </ComboBox>
                                    </Grid>
                                    <TextBlock
                                        x:Name="TxtSkipHint"
                                        Margin="2,5,0,12"
                                        FontSize="11"
                                        Foreground="{DynamicResource SidebarTextMuted}"
                                        Text="{DynamicResource Str_ValidateFile_NoSizeLimitEvery}"
                                        TextWrapping="Wrap" />

                                    <CheckBox
                                        x:Name="ChkQuarantine"
                                        Checked="Option_Changed"
                                        Content="{DynamicResource Str_Validate_Quarantine}"
                                        Foreground="{DynamicResource SidebarText}"
                                        ToolTip="{DynamicResource Str_Validate_QuarantineTooltip}"
                                        Unchecked="Option_Changed" />
                                    <Border
                                        x:Name="PanelQuarantineFolder"
                                        Margin="0,0,0,10"
                                        Padding="10,8"
                                        Background="{DynamicResource SidebarSubPanelBg}"
                                        CornerRadius="8"
                                        Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel VerticalAlignment="Center">
                                                <TextBlock
                                                    FontSize="11"
                                                    Foreground="{DynamicResource SidebarTextMuted}"
                                                    Text="{DynamicResource Str_ValidateFile_CorruptedFilesAreMoved}" />
                                                <TextBlock
                                                    x:Name="TxtQuarantineFolder"
                                                    FontSize="11.5"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource SidebarText}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <Button Padding="0"
                                                x:Name="BtnBrowseQuarantine"
                                                Grid.Column="1"
                                                Width="30"
                                                Height="30"
                                                Margin="6,0,0,0"
                                                Click="BtnBrowseQuarantine_Click"
                                                Style="{StaticResource NeutralIconButtonStyle}"
                                                ToolTip="{DynamicResource Str_Validate_BrowseQuarantineTooltip}">
                                                <materialDesign:PackIcon
                                                    Width="15"
                                                    Height="15"
                                                    Kind="FolderCogOutline" />
                                            </Button>
                                            <Button
                                                x:Name="BtnResetQuarantine"
                                                Grid.Column="2"
                                                Margin="4,0,0,0"
                                                Click="BtnResetQuarantine_Click"
                                                Style="{StaticResource ListToolButtonStyle}"
                                                ToolTip="{DynamicResource Str_Validate_ResetQuarantineTooltip}">
                                                <materialDesign:PackIcon
                                                    Width="16"
                                                    Height="16"
                                                    Kind="Restore" />
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <CheckBox
                                        x:Name="ChkGenerateReport"
                                        Checked="Option_Changed"
                                        Content="{DynamicResource Str_Validate_GenerateReport}"
                                        Foreground="{DynamicResource SidebarText}"
                                        ToolTip="{DynamicResource Str_Validate_GenerateReportTooltip}"
                                        Unchecked="Option_Changed" />
                                    <TextBlock
                                        x:Name="TxtReportHint"
                                        Margin="26,-4,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource SidebarTextMuted}"
                                        TextWrapping="Wrap"
                                        Visibility="Collapsed" />
                                </StackPanel>
                            </Border>

                            <!--  ============ FILTERS ============  -->
                            <Border Margin="0,0,0,4" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_DuplicateFinder_Filters}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.FilterOutline}" />
                                    <CheckBox
                                        x:Name="ChkOnlyProblems"
                                        Checked="ChkOnlyProblems_Changed"
                                        Content="{DynamicResource Str_ValidateFile_OnlyProblems}"
                                        Foreground="{DynamicResource SidebarText}"
                                        ToolTip="{DynamicResource Str_Validate_OnlyProblemsTooltip}"
                                        Unchecked="ChkOnlyProblems_Changed" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!--  Kept (empty) for existing code that references it  -->
                    <StackPanel x:Name="OptionsBottomPanel" Grid.Row="2" />
                </Grid>
            </Border>

            <!--  ================= MAIN AREA =================  -->

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Run bar  -->
                <Border
                    Grid.Row="0"
                    Margin="0,0,0,14"
                    Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button
                            x:Name="BtnValidate"
                            ctl:Tour.Key="Str_Tour_ValidateFiles_Run"
                            ctl:Tour.Order="4"
                            MinWidth="180"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            Click="BtnValidate_Click"
                            Style="{StaticResource AccentPrimaryButtonStyle}"
                            ToolTip="{DynamicResource Str_Validate_ValidateButtonTooltip}">
                            <Grid HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon
                                    Grid.Column="0"
                                    x:Name="IconValidate"
                                    Width="18"
                                    Height="18"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Kind="ShieldCheckOutline" />
                                <TextBlock
                                    Grid.Column="1"
                                    x:Name="TxtValidateLabel"
                                    VerticalAlignment="Center"
                                    Text="{DynamicResource Str_Validate_ValidateButton}" TextWrapping="Wrap" />
                            </Grid>
                        </Button>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <ProgressBar
                                x:Name="ProgressValidation"
                                Height="8"
                                Maximum="100"
                                ToolTip="{DynamicResource Str_Validate_ProgressTooltip}" />
                            <TextBlock
                                x:Name="TxtProgress"
                                Margin="0,6,0,0"
                                FontSize="11.5"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="{DynamicResource Str_ValidateFile_AddFilesOrFolders}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock
                            x:Name="TxtProgressPercent"
                            Grid.Column="2"
                            MinWidth="54"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="{DynamicResource AccentColor}"
                            TextAlignment="Right" />
                    </Grid>
                </Border>

                <!--  Results  -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ContentControl
                                VerticalAlignment="Center"
                                Content="{DynamicResource Str_Validate_ResultsTitle}"
                                Style="{StaticResource CardHeader}"
                                Tag="{x:Static materialDesign:PackIconKind.ClipboardCheckOutline}" />

                            <WrapPanel
                                x:Name="SummaryPanel"
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                                <Border
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource StatusInfoBg}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    ToolTip="{DynamicResource Str_Validate_PillCheckedTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource StatusInfoFg}"
                                            Kind="FileMultipleOutline" />
                                        <TextBlock
                                            x:Name="TxtSummaryChecked"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource StatusInfoFg}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    x:Name="PillValid"
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource StatusSuccessBg}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    ToolTip="{DynamicResource Str_Validate_PillValidTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource StatusSuccessFg}"
                                            Kind="CheckCircleOutline" />
                                        <TextBlock
                                            x:Name="TxtSummaryValid"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource StatusSuccessFg}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    x:Name="PillCorrupted"
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource StatusErrorBg}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    ToolTip="{DynamicResource Str_Validate_PillCorruptedTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource StatusErrorFg}"
                                            Kind="AlertCircleOutline" />
                                        <TextBlock
                                            x:Name="TxtSummaryCorrupted"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource StatusErrorFg}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    x:Name="PillWarning"
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource StatusWarningBg}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    ToolTip="{DynamicResource Str_Validate_PillWarningTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource StatusWarningFg}"
                                            Kind="AlertOutline" />
                                        <TextBlock
                                            x:Name="TxtSummaryWarning"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource StatusWarningFg}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    x:Name="PillUnknown"
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource RowBg}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    ToolTip="{DynamicResource Str_Validate_PillUnknownTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource TextSecondary}"
                                            Kind="HelpCircleOutline" />
                                        <TextBlock
                                            x:Name="TxtSummaryUnknown"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextSecondary}" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <!--  Actions: right of the summary pills, like the Duplicate view  -->
                            <StackPanel
                                x:Name="ActionsPanel"
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                IsEnabled="False"
                                Orientation="Horizontal">

                                <controls:ExportButton
                                    x:Name="BtnExportReport"
                                    Margin="0,0,6,0"
                                    ToolTip="{DynamicResource Str_Validate_ExportReportTooltip}">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Click="MenuExportCsv_Click" Header="{DynamicResource Str_Common_ExportAsCsv}">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="FileDelimitedOutline" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </controls:ExportButton>

                                <Button Padding="0"
                                    x:Name="BtnTickProblems"
                                    Width="32"
                                    Height="32"
                                    Margin="0,0,6,0"
                                    Click="BtnTickProblems_Click"
                                    Style="{StaticResource NeutralIconButtonStyle}"
                                    ToolTip="{DynamicResource Str_Validate_TickCorruptedTooltip}">
                                    <materialDesign:PackIcon
                                        x:Name="IconTickProblems"
                                        Width="16"
                                        Height="16"
                                        Kind="CheckboxMultipleMarkedOutline" />
                                </Button>

                                <Button
                                    x:Name="BtnQuarantine"
                                    Width="32"
                                    Height="32"
                                    Margin="0,0,6,0"
                                    Click="BtnQuarantine_Click"
                                    Style="{StaticResource ListToolWarningButtonStyle}"
                                    ToolTip="{DynamicResource Str_Validate_QuarantineButtonTooltip}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="ShieldAlertOutline" />
                                </Button>

                                <Button
                                    x:Name="BtnRemoveFiles"
                                    Width="32"
                                    Height="32"
                                    Click="BtnRemoveFiles_Click"
                                    Style="{StaticResource ListToolDangerButtonStyle}"
                                    ToolTip="{DynamicResource Str_Validate_RemoveSelectedTooltip}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="PlaylistRemove" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <DataGrid
                            x:Name="DataGridResults"
                            ctl:Tour.Key="Str_Tour_ValidateFiles_Results"
                            ctl:Tour.Order="5"
                            Grid.Row="1"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            FontSize="12"
                            IsReadOnly="True"
                            MouseDoubleClick="DataGridResults_MouseDoubleClick"
                            PreviewKeyDown="DataGridResults_PreviewKeyDown"
                            PreviewMouseRightButtonDown="DataGridResults_PreviewMouseRightButtonDown"
                            MinRowHeight="48"
                            SelectionChanged="DataGridResults_SelectionChanged"
                            SelectionMode="Extended"
                            ToolTip="{DynamicResource Str_Validate_GridTooltip}"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.ScrollUnit="Pixel"
                            VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Click="MenuShowInFolder_Click">
                                        <MenuItem.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="15"
                                                    Height="15"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Kind="FolderOpenOutline" />
                                                <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_Validate_MenuShowInFolder}" />
                                            </StackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem Click="MenuCopyPath_Click">
                                        <MenuItem.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="15"
                                                    Height="15"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Kind="ContentCopy" />
                                                <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_Validate_MenuCopyPath}" />
                                            </StackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem Click="MenuCopyDetails_Click">
                                        <MenuItem.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="15"
                                                    Height="15"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Kind="ClipboardCheckOutline" />
                                                <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_Validate_MenuCopyResult}" />
                                            </StackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn
                                    Width="38"
                                    CanUserSort="False"
                                    CellStyle="{StaticResource CheckBoxCellStyle}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox
                                                Click="RowCheck_Click"
                                                IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Style="{StaticResource DataGridCheckBoxStyle}"
                                                ToolTip="{DynamicResource Str_Validate_SelectForRemovalTooltip}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn
                                    Width="46"
                                    CanUserSort="False"
                                    CellStyle="{StaticResource CompactCellStyle}"
                                    CellTemplate="{StaticResource KindCellTemplate}"
                                    IsReadOnly="True" />
                                <DataGridTemplateColumn
                                    Width="2*"
                                    MinWidth="90"
                                    CellTemplate="{StaticResource NameCellTemplate}"
                                    Header="{DynamicResource Str_Common_ColHeaderFileName}"
                                    IsReadOnly="True"
                                    SortMemberPath="FileName" />
                                <DataGridTextColumn
                                    ElementStyle="{StaticResource EllipsisCellTextStyle}"
                                    x:Name="ColFileType"
                                    Width="80"
                                    Binding="{Binding FileType, Mode=OneWay}"
                                    Header="{DynamicResource Str_Common_ColHeaderType}"
                                    IsReadOnly="True" />
                                <DataGridTextColumn
                                    ElementStyle="{StaticResource EllipsisCellTextStyle}"
                                    Width="76"
                                    Binding="{Binding Size, Mode=OneWay}"
                                    Header="{DynamicResource Str_Common_ColHeaderSize}"
                                    IsReadOnly="True"
                                    SortMemberPath="SizeBytes" />
                                <DataGridTemplateColumn
                                    Width="130"
                                    CellTemplate="{StaticResource StatusCellTemplate}"
                                    Header="{DynamicResource Str_Common_ColHeaderStatus}"
                                    IsReadOnly="True"
                                    SortMemberPath="Status" />
                                <DataGridTemplateColumn
                                    x:Name="ColDetails"
                                    Width="2.5*"
                                    MinWidth="90"
                                    CellTemplate="{StaticResource DetailsCellTemplate}"
                                    Header="{DynamicResource Str_Validate_ColHeaderDetails}"
                                    IsReadOnly="True"
                                    SortMemberPath="Details" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <controls:EmptyStateCard
                            x:Name="EmptyStatePanel"
                            Grid.Row="1"
                            Description="{DynamicResource Str_ValidateFile_DropFilesOrFolders}"
                            Icon="ShieldSearch"
                            IsHitTestVisible="False" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
