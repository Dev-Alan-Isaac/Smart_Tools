<UserControl
    x:Class="Smart_Tools.WPF.Views.DuplicateFinderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:models="clr-namespace:Smart_Tools.WPF.Models"
    x:Name="Root"
    Loaded="Root_Loaded"
    SizeChanged="Root_SizeChanged">

    <!--
        Backend: Controllers/DuplicateManager.cs (scan, keep rules, move,
        delete, export, settings), Controllers/ShellExplorer.cs (show in
        folder) and Models/DuplicateFinderModel.cs. Code-behind only wires
        controls. Look & feel: shared view kit + UiMotion.cs.
    -->

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!--  Small status tag inside a cell ("Keep", "Remove")  -->
        <Style x:Key="TagPillStyle" TargetType="Border">
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="6,0,0,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--  Thumbnail tile with a file-type icon when there's no preview  -->
        <DataTemplate x:Key="ThumbCellTemplate" DataType="{x:Type models:DuplicateFileItem}">
            <Border
                Width="34"
                Height="34"
                Margin="2"
                Background="{DynamicResource RowBg}"
                ClipToBounds="True"
                CornerRadius="6">
                <Grid>
                    <materialDesign:PackIcon
                        x:Name="TypeIcon"
                        Width="16"
                        Height="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextSecondary}"
                        Kind="FileOutline" />
                    <Image
                        RenderOptions.BitmapScalingMode="HighQuality"
                        Source="{Binding Thumbnail}"
                        Stretch="UniformToFill" />
                </Grid>
            </Border>
        </DataTemplate>

        <!--  Name + Keep / Remove tags  -->
        <DataTemplate x:Key="NameCellTemplate" DataType="{x:Type models:DuplicateFileItem}">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    x:Name="NameText"
                    Grid.Column="0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextPrimary}"
                    Text="{Binding Name}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding FullPath}" />
                <Border
                    x:Name="KeepTag"
                    Grid.Column="1"
                    Background="{DynamicResource StatusSuccessBg}"
                    Style="{StaticResource TagPillStyle}"
                    ToolTip="{DynamicResource Str_DuplicateFinder_ThisCopyIsKept}"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="11"
                            Height="11"
                            Margin="0,0,3,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource StatusSuccessFg}"
                            Kind="Star" />
                        <TextBlock
                            FontSize="10"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource StatusSuccessFg}"
                            Text="{DynamicResource Str_FindSimilar_KeepBadge}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <Border
                    x:Name="RemoveTag"
                    Grid.Column="2"
                    Background="{DynamicResource StatusErrorBg}"
                    Style="{StaticResource TagPillStyle}"
                    ToolTip="{DynamicResource Str_DuplicateFinder_SelectedForMoveDelete}"
                    Visibility="Collapsed">
                    <TextBlock
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource StatusErrorFg}"
                        Text="{DynamicResource Str_VideoEditor_Remove}"
                        TextTrimming="CharacterEllipsis" />
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsKeep}" Value="True">
                    <Setter TargetName="KeepTag" Property="Visibility" Value="Visible" />
                    <Setter TargetName="NameText" Property="FontWeight" Value="SemiBold" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="RemoveTag" Property="Visibility" Value="Visible" />
                    <Setter TargetName="NameText" Property="Foreground" Value="{DynamicResource TextSecondary}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  Group header row in the grid  -->
        <DataTemplate x:Key="GroupHeaderTemplate">
            <Border
                x:Name="HeaderBd"
                Margin="0,8,0,2"
                Padding="10,6"
                Background="{DynamicResource RowBg}"
                CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="26"
                        Height="26"
                        Margin="0,0,10,0"
                        Background="{DynamicResource AccentColorSubtle}"
                        CornerRadius="8">
                        <materialDesign:PackIcon
                            Width="14"
                            Height="14"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource AccentColor}"
                            Kind="ContentDuplicate" />
                    </Border>
                    <StackPanel
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <TextBlock
                            FontSize="12.5"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimary}"
                            Text="{Binding Name.Title}" />
                        <TextBlock
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="11.5"
                            Foreground="{DynamicResource TextSecondary}"
                            Text="{Binding Name.Subtitle}" />
                    </StackPanel>
                    <Border
                        x:Name="SelectionPill"
                        Grid.Column="2"
                        Margin="8,0"
                        Background="{DynamicResource CardBg}"
                        Style="{StaticResource IconStatusPillStyle}">
                        <TextBlock
                            x:Name="SelectionText"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextSecondary}"
                            Text="{Binding Name.SelectionText}" />
                    </Border>
                    <Button
                        Grid.Column="3"
                        Width="90"
                        Padding="10,3"
                        Click="BtnGroupCompare_Click"
                        Style="{StaticResource NeutralIconButtonStyle}"
                        Tag="{Binding Name}"
                        ToolTip="{DynamicResource Str_DuplicateFinder_CompareTheFilesIn}">
                        <Grid HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon
                                Grid.Column="0"
                                Width="14"
                                Height="14"
                                Margin="0,0,5,0"
                                VerticalAlignment="Center"
                                Kind="FileCompare" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="11.5"
                                Text="{DynamicResource Str_Code_ModeCompare}"
                                TextWrapping="Wrap" />
                        </Grid>
                    </Button>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <!--  Every copy selected: nothing would be left - make that loud.  -->
                <DataTrigger Binding="{Binding Name.AllSelected}" Value="True">
                    <Setter TargetName="SelectionPill" Property="Background" Value="{DynamicResource StatusErrorBg}" />
                    <Setter TargetName="SelectionText" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                    <Setter TargetName="SelectionPill" Property="ToolTip" Value="Every copy in this group is selected - acting on it would leave none." />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  Compare drawer card  -->
        <DataTemplate x:Key="CompareCardTemplate" DataType="{x:Type models:DuplicateFileItem}">
            <Border
                x:Name="CardBd"
                Margin="0,0,0,10"
                Padding="10"
                Background="{DynamicResource RowBg}"
                BorderBrush="Transparent"
                BorderThickness="2"
                CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border
                        Height="170"
                        Margin="0,0,0,10"
                        Background="{DynamicResource CardBg}"
                        ClipToBounds="True"
                        CornerRadius="8">
                        <Grid>
                            <materialDesign:PackIcon
                                Width="40"
                                Height="40"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextSecondary}"
                                Kind="FileOutline"
                                Opacity="0.6" />
                            <Image
                                RenderOptions.BitmapScalingMode="HighQuality"
                                Source="{Binding Thumbnail}"
                                Stretch="Uniform" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="1">
                        <TextBlock
                            FontSize="12.5"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimary}"
                            Text="{Binding Name}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding FullPath}" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="11"
                            Foreground="{DynamicResource TextSecondary}"
                            Text="{Binding Folder}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding Folder}" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="11"
                            Foreground="{DynamicResource TextSecondary}">
                            <Run Text="{Binding Size, Mode=OneWay}" />
                            <Run Text="{DynamicResource Str_DuplicateFinder_Modified}" />
                            <Run Text="{Binding Modified, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>

                    <Grid Grid.Row="2" Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <RadioButton
                            Margin="0,0,4,0"
                            Click="RadioKeep_Click"
                            GroupName="OriginalChoice"
                            IsChecked="{Binding IsKeep, Mode=TwoWay}"
                            Style="{StaticResource ModeToggleButtonStyle}"
                            ToolTip="{DynamicResource Str_DuplicateFinder_KeepThisCopyThe}">
                            <Grid HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon
                                    Grid.Column="0"
                                    Width="13"
                                    Height="13"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Kind="StarOutline" />
                                <TextBlock
                                    Grid.Column="1"
                                    Text="{DynamicResource Str_Dup_KeepRadio}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </RadioButton>
                        <CheckBox
                            Grid.Column="1"
                            Margin="8,0,4,0"
                            VerticalAlignment="Center"
                            Content="{DynamicResource Str_VideoEditor_Remove}"
                            IsChecked="{Binding IsSelected, Mode=TwoWay}"
                            ToolTip="{DynamicResource Str_Dup_FlagCheckboxTooltip}" />
                        <Button
                            Grid.Column="2"
                            Width="30"
                            Height="30"
                            Click="BtnCardShowInFolder_Click"
                            Style="{StaticResource NeutralIconButtonStyle}"
                            ToolTip="{DynamicResource Str_Common_ShowInFolderTooltip}">
                            <materialDesign:PackIcon
                                Width="15"
                                Height="15"
                                Kind="FolderOpenOutline" />
                        </Button>
                    </Grid>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsKeep}" Value="True">
                    <Setter TargetName="CardBd" Property="BorderBrush" Value="{DynamicResource StatusSuccessFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                    <Setter TargetName="CardBd" Property="Background" Value="{DynamicResource StatusErrorBg}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>


        <!--  Input card: one queued item  -->
        <DataTemplate x:Key="QueueItemTemplate" DataType="{x:Type models:FolderListEntry}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="26"
                    Height="26"
                    Margin="0,0,8,0"
                    Background="{DynamicResource AccentColorSubtle}"
                    CornerRadius="7">
                    <materialDesign:PackIcon
                        Width="14"
                        Height="14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource AccentColor}"
                        Kind="Folder" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource SidebarText}"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding FullPath}" />
                    <TextBlock
                        Margin="0,1,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource SidebarTextMuted}"
                        Text="{Binding FullPath}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding FullPath}" />
                </StackPanel>
                <Button
                    Grid.Column="2"
                    Width="24"
                    Height="24"
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    Click="BtnRemoveSingleFolder_Click"
                    Style="{StaticResource IconButtonStyle}"
                    Tag="{Binding}"
                    ToolTip="{DynamicResource Str_Dup_RemoveFolderTooltip}">
                    <materialDesign:PackIcon
                        Width="13"
                        Height="13"
                        Kind="Close" />
                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">

        <!--  No page header: MainWindow's header card shows the tool's icon and name.  -->

        <Grid Margin="16,8,16,16">

            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OptionsColumn" Width="280" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= OPTIONS SIDEBAR =================  -->

            <Border Grid.Column="0" Style="{StaticResource SidebarPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Button
                            x:Name="BtnCollapseOptions"
                            MinHeight="45"
                            HorizontalContentAlignment="Left"
                            Click="BtnCollapseOptions_Click"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Foreground="{DynamicResource SidebarText}"
                            ToolTip="{DynamicResource Str_Common_SidebarToggleTooltip}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="OverridesDefaultStyle" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Margin="16,0,0,0" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Kind="TuneVariant" />
                                <TextBlock
                                    x:Name="TxtOptionsHeaderLabel"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{DynamicResource Str_Common_OptionsLabel}" />
                            </StackPanel>
                        </Button>
                        <Separator
                            x:Name="SepHeader"
                            Margin="16,4"
                            Style="{StaticResource SidebarSeparatorStyle}" />
                    </StackPanel>

                    <ScrollViewer
                        x:Name="OptionsScrollViewer"
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16,4,16,16">

                            <!--  ============ FOLDERS ============  -->
                            <controls:InputFolderCard
                                x:Name="InputCard"
                                ctl:Tour.Key="Str_Tour_DuplicateFinder_Input"
                                ctl:Tour.Order="1"
                                ClearRequested="InputCard_ClearRequested"
                                Header="{DynamicResource Str_Dup_FoldersHeader}"
                                HeaderIcon="FolderSearchOutline"
                                ItemTemplate="{StaticResource QueueItemTemplate}"
                                Mode="Folders"
                                PathsAdded="InputCard_PathsAdded"
                                ShowSubfolders="False" />


                            <!--  ============ MATCH BY ============  -->
                            <Border
                                ctl:Tour.Key="Str_Tour_DuplicateFinder_Method"
                                ctl:Tour.Order="2"
                                Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Dup_DetectionMethodHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.Fingerprint}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <RadioButton
                                            x:Name="RadioMatchContent"
                                            Checked="RadioMatch_Checked"
                                            GroupName="MatchBy"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            ToolTip="{DynamicResource Str_DuplicateFinder_SameContentsTrueDuplicates}">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="17"
                                                    Height="17"
                                                    HorizontalAlignment="Center"
                                                    Kind="Fingerprint" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    HorizontalAlignment="Center"
                                                    Text="{DynamicResource Str_DuplicateFinder_Contents}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="RadioMatchNameSize"
                                            Grid.Column="2"
                                            Checked="RadioMatch_Checked"
                                            GroupName="MatchBy"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            ToolTip="{DynamicResource Str_DuplicateFinder_SameNameAndSize}">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="17"
                                                    Height="17"
                                                    HorizontalAlignment="Center"
                                                    Kind="FileCompare" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    HorizontalAlignment="Center"
                                                    Text="{DynamicResource Str_DuplicateFinder_NameSize}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="RadioMatchName"
                                            Grid.Column="4"
                                            Checked="RadioMatch_Checked"
                                            GroupName="MatchBy"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            ToolTip="{DynamicResource Str_DuplicateFinder_SameFileNameOnly}">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="17"
                                                    Height="17"
                                                    HorizontalAlignment="Center"
                                                    Kind="FormTextbox" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    HorizontalAlignment="Center"
                                                    Text="{DynamicResource Str_Common_ColHeaderName}" />
                                            </StackPanel>
                                        </RadioButton>
                                    </Grid>

                                    <!--  Contents: how to compare  -->
                                    <StackPanel x:Name="ContentOptionsPanel" Margin="0,12,0,0">
                                        <TextBlock
                                            Margin="0,0,0,6"
                                            Style="{StaticResource FieldLabel}"
                                            Text="{DynamicResource Str_DuplicateFinder_CompareWith}" />
                                        <ComboBox
                                            x:Name="CmbHashAlgorithm"
                                            SelectedIndex="0"
                                            SelectionChanged="Option_Changed"
                                            ToolTip="{DynamicResource Str_Dup_DetectionMethodTooltip}">
                                            <ComboBoxItem Tag="Sha256">SHA-256 (recommended)</ComboBoxItem>
                                            <ComboBoxItem Tag="Crc32">CRC32 (fastest)</ComboBoxItem>
                                            <ComboBoxItem Tag="Md5">MD5</ComboBoxItem>
                                            <ComboBoxItem Tag="Sha1">SHA-1</ComboBoxItem>
                                            <ComboBoxItem Tag="ByteByByte">Byte-by-byte (no hash)</ComboBoxItem>
                                        </ComboBox>
                                        <CheckBox
                                            x:Name="ChkCompareFileContents"
                                            Margin="0,10,0,0"
                                            Checked="Option_Changed"
                                            Content="{DynamicResource Str_Dup_CompareContents}"
                                            Foreground="{DynamicResource SidebarText}"
                                            IsChecked="True"
                                            ToolTip="{DynamicResource Str_Dup_CompareContentsTooltip}"
                                            Unchecked="Option_Changed" />
                                    </StackPanel>

                                    <Border
                                        x:Name="NameModeWarning"
                                        Margin="0,12,0,0"
                                        Padding="10,8"
                                        Background="{DynamicResource StatusWarningBg}"
                                        CornerRadius="8"
                                        Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon
                                                Width="14"
                                                Height="14"
                                                Margin="0,1,8,0"
                                                VerticalAlignment="Top"
                                                Foreground="{DynamicResource StatusWarningFg}"
                                                Kind="AlertOutline" />
                                            <TextBlock
                                                Grid.Column="1"
                                                FontSize="11"
                                                Foreground="{DynamicResource StatusWarningFg}"
                                                Text="{DynamicResource Str_DuplicateFinder_ContentsArenTCompared}"
                                                TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!--  ============ FILTERS ============  -->
                            <Border
                                ctl:Tour.Key="Str_Tour_DuplicateFinder_Filters"
                                ctl:Tour.Order="3"
                                Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_DuplicateFinder_Filters}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.FilterOutline}" />

                                    <TextBlock
                                        Margin="0,0,0,6"
                                        Style="{StaticResource FieldLabel}"
                                        Text="{DynamicResource Str_DuplicateFinder_FileTypes}" />
                                    <StackPanel>
                                        <!--  Full-width top button  -->
                                        <RadioButton
                                            x:Name="RadioTypeAll"
                                            Margin="0,0,0,4"
                                            Checked="Option_Changed"
                                            Content="{DynamicResource Str_DiskSpaceAnalyzer_All}"
                                            GroupName="FileTypes"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="All" />

                                        <!--  2x2 grid for the remaining 4 items  -->
                                        <UniformGrid Columns="2">
                                            <RadioButton
                                                x:Name="RadioTypeImages"
                                                Margin="0,0,2,4"
                                                Checked="Option_Changed"
                                                Content="{DynamicResource Str_ImgPdf_ImagesHeader}"
                                                GroupName="FileTypes"
                                                Style="{StaticResource ModeToggleButtonStyle}"
                                                Tag="Images" />
                                            <RadioButton
                                                x:Name="RadioTypeVideos"
                                                Margin="2,0,0,4"
                                                Checked="Option_Changed"
                                                Content="{DynamicResource Str_DuplicateFinder_Videos}"
                                                GroupName="FileTypes"
                                                Style="{StaticResource ModeToggleButtonStyle}"
                                                Tag="Videos" />
                                            <RadioButton
                                                x:Name="RadioTypeAudio"
                                                Margin="0,0,2,0"
                                                Checked="Option_Changed"
                                                Content="{DynamicResource Str_DuplicateFinder_Audio}"
                                                GroupName="FileTypes"
                                                Style="{StaticResource ModeToggleButtonStyle}"
                                                Tag="Audio" />
                                            <RadioButton
                                                x:Name="RadioTypeDocuments"
                                                Margin="2,0,0,0"
                                                Checked="Option_Changed"
                                                Content="{DynamicResource Str_DuplicateFinder_Docs}"
                                                GroupName="FileTypes"
                                                Style="{StaticResource ModeToggleButtonStyle}"
                                                Tag="Documents" />
                                        </UniformGrid>
                                    </StackPanel>
                                    <TextBlock
                                        Margin="0,12,0,6"
                                        Style="{StaticResource FieldLabel}"
                                        Text="{DynamicResource Str_DuplicateFinder_MinimumSize}" />

                                    <StackPanel>
                                        <!--  Full-width top button  -->
                                        <RadioButton
                                            x:Name="RadioMinAny"
                                            Margin="0,0,0,4"
                                            Checked="Option_Changed"
                                            Content="{DynamicResource Str_DuplicateFinder_Any}"
                                            GroupName="MinSize"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="1" />

                                        <!--  3-column row for the remaining buttons  -->
                                        <UniformGrid Columns="3">
                                            <RadioButton
                                                x:Name="RadioMin100K"
                                                Margin="0,0,2,0"
                                                Checked="Option_Changed"
                                                Content="100 KB"
                                                GroupName="MinSize"
                                                Style="{StaticResource ModeToggleButtonStyle}"
                                                Tag="102400" />
                                            <RadioButton
                                                x:Name="RadioMin1M"
                                                Margin="2,0"
                                                Checked="Option_Changed"
                                                Content="1 MB"
                                                GroupName="MinSize"
                                                Style="{StaticResource ModeToggleButtonStyle}"
                                                Tag="1048576" />
                                            <RadioButton
                                                x:Name="RadioMin10M"
                                                Margin="2,0,0,0"
                                                Checked="Option_Changed"
                                                Content="10 MB"
                                                GroupName="MinSize"
                                                Style="{StaticResource ModeToggleButtonStyle}"
                                                Tag="10485760" />
                                        </UniformGrid>
                                    </StackPanel>

                                    <TextBlock
                                        Margin="0,12,0,6"
                                        Style="{StaticResource FieldLabel}"
                                        Text="{DynamicResource Str_DuplicateFinder_SkipFileTypes}" />
                                    <Border Padding="8,0" Style="{StaticResource InputBarStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon
                                                Width="15"
                                                Height="15"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource TextSecondary}"
                                                Kind="FileHidden" />
                                            <TextBox
                                                x:Name="TxtExcludeExtensions"
                                                Grid.Column="1"
                                                LostFocus="TxtExcludeExtensions_LostFocus"
                                                Style="{StaticResource BareTextBox}"
                                                Tag=".tmp, .log, .ini"
                                                ToolTip="{DynamicResource Str_DuplicateFinder_ExtensionsToLeaveOut}" />
                                        </Grid>
                                    </Border>

                                    <CheckBox
                                        x:Name="ChkIncludeSubfolders"
                                        Margin="0,14,0,0"
                                        Checked="Option_Changed"
                                        Content="{DynamicResource Str_Common_IncludeSubfolders}"
                                        Foreground="{DynamicResource SidebarText}"
                                        IsChecked="True"
                                        ToolTip="{DynamicResource Str_Dup_IncludeSubfoldersTooltip}"
                                        Unchecked="Option_Changed" />
                                    <CheckBox
                                        x:Name="ChkIgnoreHiddenFiles"
                                        Margin="0,8,0,0"
                                        Checked="Option_Changed"
                                        Content="{DynamicResource Str_Dup_IgnoreHiddenFiles}"
                                        Foreground="{DynamicResource SidebarText}"
                                        ToolTip="{DynamicResource Str_Dup_IgnoreHiddenFilesTooltip}"
                                        Unchecked="Option_Changed" />
                                    <CheckBox
                                        x:Name="ChkIgnoreSystemFiles"
                                        Margin="0,8,0,0"
                                        Checked="Option_Changed"
                                        Content="{DynamicResource Str_Dup_IgnoreSystemFiles}"
                                        Foreground="{DynamicResource SidebarText}"
                                        IsChecked="True"
                                        ToolTip="{DynamicResource Str_Dup_IgnoreSystemFilesTooltip}"
                                        Unchecked="Option_Changed" />
                                </StackPanel>
                            </Border>

                            <!--  ============ CLEAN-UP ============  -->
                            <Border Margin="0,0,0,4" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_DuplicateFinder_CleanUp}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.Broom}" />
                                    <TextBlock
                                        Margin="0,0,0,6"
                                        Style="{StaticResource FieldLabel}"
                                        Text="{DynamicResource Str_DuplicateFinder_KeepInEachGroup}" />
                                    <ComboBox
                                        x:Name="CmbKeepRule"
                                        SelectedIndex="0"
                                        SelectionChanged="Option_Changed"
                                        ToolTip="{DynamicResource Str_DuplicateFinder_WhichCopyIsKept}">
                                        <ComboBoxItem Tag="Oldest">Oldest copy (usually the original)</ComboBoxItem>
                                        <ComboBoxItem Tag="Newest">Newest copy</ComboBoxItem>
                                        <ComboBoxItem Tag="ShortestPath">Shortest path</ComboBoxItem>
                                        <ComboBoxItem Tag="FolderOrder">Copy in the first folder listed</ComboBoxItem>
                                    </ComboBox>
                                    <CheckBox
                                        x:Name="ChkRecycleBin"
                                        Margin="0,10,0,0"
                                        Checked="Option_Changed"
                                        Content="{DynamicResource Str_DuplicateFinder_DeleteToTheRecycle}"
                                        Foreground="{DynamicResource SidebarText}"
                                        IsChecked="True"
                                        ToolTip="{DynamicResource Str_DuplicateFinder_DeletedDuplicatesCanBe}"
                                        Unchecked="Option_Changed" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!--  Kept (empty) for existing code that references it  -->
                    <StackPanel x:Name="OptionsBottomPanel" Grid.Row="2" />
                </Grid>
            </Border>

            <!--  ================= MAIN AREA =================  -->

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Run bar  -->
                <Border
                    Grid.Row="0"
                    Margin="0,0,0,14"
                    Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button
                            x:Name="BtnScanForDuplicates"
                            MinWidth="180"
                            VerticalAlignment="Center"
                            ctl:Tour.Key="Str_Tour_DuplicateFinder_Scan"
                            ctl:Tour.Order="4"
                            Click="ButtonScan_Click"
                            Style="{StaticResource AccentPrimaryButtonStyle}"
                            ToolTip="{DynamicResource Str_Dup_ScanButtonTooltip}">
                            <Grid HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon
                                    x:Name="IconScan"
                                    Grid.Column="0"
                                    Width="18"
                                    Height="18"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Kind="ContentDuplicate" />
                                <TextBlock
                                    x:Name="TxtScanLabel"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="{DynamicResource Str_Dup_ScanButton}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Button>

                        <Button
                            x:Name="BtnRescan"
                            Grid.Column="1"
                            Width="36"
                            Height="36"
                            Margin="8,0,16,0"
                            VerticalAlignment="Center"
                            Click="BtnRescan_Click"
                            IsEnabled="False"
                            Style="{StaticResource NeutralIconButtonStyle}"
                            ToolTip="{DynamicResource Str_Dup_RescanTooltip}">
                            <materialDesign:PackIcon
                                Width="17"
                                Height="17"
                                Kind="Refresh" />
                        </Button>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <ProgressBar
                                x:Name="ProgressDuplicates"
                                Height="8"
                                Maximum="100"
                                ToolTip="{DynamicResource Str_Dup_ProgressTooltip}" />
                            <TextBlock
                                x:Name="TxtProgress"
                                Margin="0,6,0,0"
                                FontSize="11.5"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="{DynamicResource Str_Dup_ProgressInitial}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock
                            x:Name="TxtProgressPercent"
                            Grid.Column="3"
                            MinWidth="54"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="{DynamicResource AccentColor}"
                            TextAlignment="Right" />
                    </Grid>
                </Border>

                <!--  Results  -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ContentControl
                                VerticalAlignment="Center"
                                Content="{DynamicResource Str_Dup_ResultsTitle}"
                                Style="{StaticResource CardHeader}"
                                Tag="{x:Static materialDesign:PackIconKind.ContentDuplicate}" />

                            <WrapPanel
                                x:Name="SummaryPanel"
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                                <Border
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource StatusInfoBg}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    ToolTip="{DynamicResource Str_Dup_DuplicatesFoundTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource StatusInfoFg}"
                                            Kind="ContentDuplicate" />
                                        <TextBlock
                                            x:Name="TxtSummaryCount"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource StatusInfoFg}"
                                            Text="{DynamicResource Str_Dup_DuplicatesFoundInitial}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource StatusSuccessBg}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    ToolTip="{DynamicResource Str_Dup_WastedSpaceTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource StatusSuccessFg}"
                                            Kind="Broom" />
                                        <TextBlock
                                            x:Name="TxtSummaryWasted"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource StatusSuccessFg}"
                                            Text="{DynamicResource Str_Dup_WastedSpaceInitial}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    x:Name="SelectionPill"
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource StatusErrorBg}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    ToolTip="{DynamicResource Str_DuplicateFinder_FilesCurrentlySelectedFor}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource StatusErrorFg}"
                                            Kind="CheckboxMultipleMarkedOutline" />
                                        <TextBlock
                                            x:Name="TxtSelection"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource StatusErrorFg}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    x:Name="NotVerifiedPill"
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource StatusWarningBg}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    ToolTip="{DynamicResource Str_DuplicateFinder_MatchedByNameThese}"
                                    Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource StatusWarningFg}"
                                            Kind="AlertOutline" />
                                        <TextBlock
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource StatusWarningFg}"
                                            Text="{DynamicResource Str_DuplicateFinder_ContentsNotCompared}" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <StackPanel
                                x:Name="ActionsPanel"
                                Grid.Column="2"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                IsEnabled="False"
                                Orientation="Horizontal">

                                <controls:ExportButton
                                    x:Name="BtnExport"
                                    Margin="0,0,6,0"
                                    ToolTip="{DynamicResource Str_Dup_ExportResultsTooltip}">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Click="MenuExportCsv_Click" Header="{DynamicResource Str_Common_ExportAsCsv}">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="FileDelimitedOutline" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </controls:ExportButton>

                                <Button
                                    x:Name="BtnAutoSelect"
                                    MinHeight="32"
                                    Margin="0,0,6,0"
                                    Click="BtnAutoSelect_Click"
                                    Style="{StaticResource NeutralIconButtonStyle}"
                                    ToolTip="{DynamicResource Str_DuplicateFinder_SelectEveryCopyExcept}">
                                    <Grid Margin="8,0" HorizontalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon
                                            Grid.Column="0"
                                            Width="16"
                                            Height="16"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            Kind="AutoFix" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Text="{DynamicResource Str_DuplicateFinder_AutoSelect}"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                </Button>

                                <Button
                                    x:Name="BtnCollapseGroups"
                                    Width="32"
                                    Height="32"
                                    Margin="0,0,6,0"
                                    Click="BtnCollapseGroups_Click"
                                    Style="{StaticResource NeutralIconButtonStyle}"
                                    ToolTip="Fold every group">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="UnfoldLessHorizontal" />
                                </Button>
                                <Button
                                    x:Name="BtnExpandGroups"
                                    Width="32"
                                    Height="32"
                                    Margin="0,0,6,0"
                                    Click="BtnExpandGroups_Click"
                                    Style="{StaticResource NeutralIconButtonStyle}"
                                    ToolTip="Unfold every group">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="UnfoldMoreHorizontal" />
                                </Button>
                                <Button
                                    x:Name="BtnDeselectAll"
                                    Width="32"
                                    Height="32"
                                    Margin="0,0,6,0"
                                    Click="BtnDeselectAll_Click"
                                    Style="{StaticResource NeutralIconButtonStyle}"
                                    ToolTip="{DynamicResource Str_Dup_DeselectAllTooltip}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="CheckboxMultipleBlankOutline" />
                                </Button>

                                <Button
                                    x:Name="BtnMoveSelected"
                                    Width="32"
                                    Height="32"
                                    Margin="0,0,6,0"
                                    Click="BtnMoveSelected_Click"
                                    Style="{StaticResource ListToolButtonStyle}"
                                    ToolTip="{DynamicResource Str_Dup_MoveSelectedTooltip}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="FolderMoveOutline" />
                                </Button>

                                <Button
                                    x:Name="BtnDeleteSelected"
                                    Width="32"
                                    Height="32"
                                    Click="BtnDeleteSelected_Click"
                                    Style="{StaticResource ListToolDangerButtonStyle}"
                                    ToolTip="{DynamicResource Str_Dup_DeleteSelectedTooltip}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="DeleteOutline" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <!--  Grouped results  -->
                        <DataGrid
                            x:Name="DataGridDuplicates"
                            Grid.Row="1"
                            ctl:Tour.Key="Str_Tour_DuplicateFinder_Results"
                            ctl:Tour.Order="5"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            CanUserSortColumns="False"
                            FontSize="12"
                            IsReadOnly="True"
                            MinRowHeight="44"
                            MouseDoubleClick="DataGridDuplicates_MouseDoubleClick"
                            PreviewKeyDown="DataGridDuplicates_PreviewKeyDown"
                            PreviewMouseRightButtonDown="DataGridDuplicates_PreviewMouseRightButtonDown"
                            SelectionMode="Extended"
                            ToolTip="{DynamicResource Str_Dup_GridTooltip}"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                            VirtualizingPanel.ScrollUnit="Pixel"
                            VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.GroupStyle>
                                <GroupStyle ContainerStyle="{StaticResource CollapsibleGroupItemStyle}" HeaderTemplate="{StaticResource GroupHeaderTemplate}" />
                            </DataGrid.GroupStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="36" CellStyle="{StaticResource CompactCellStyle}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                ToolTip="{DynamicResource Str_Dup_FlagCheckboxTooltip}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn
                                    Width="46"
                                    CellStyle="{StaticResource CompactCellStyle}"
                                    CellTemplate="{StaticResource ThumbCellTemplate}"
                                    Header="{DynamicResource Str_Dup_ColHeaderPreview}" />
                                <DataGridTemplateColumn
                                    Width="2*"
                                    MinWidth="90"
                                    CellTemplate="{StaticResource NameCellTemplate}"
                                    Header="{DynamicResource Str_Common_ColHeaderFileName}" />
                                <DataGridTextColumn
                                    Width="2*"
                                    Binding="{Binding Folder}"
                                    ElementStyle="{StaticResource EllipsisCellTextStyle}"
                                    Header="{DynamicResource Str_Common_ColHeaderFolder}" />
                                <DataGridTextColumn
                                    Width="80"
                                    Binding="{Binding Size}"
                                    ElementStyle="{StaticResource EllipsisCellTextStyle}"
                                    Header="{DynamicResource Str_Common_ColHeaderSize}" />
                                <DataGridTextColumn
                                    x:Name="ColModified"
                                    Width="120"
                                    Binding="{Binding Modified}"
                                    ElementStyle="{StaticResource EllipsisCellTextStyle}"
                                    Header="{DynamicResource Str_Common_ColHeaderModified}" />
                                <DataGridTextColumn
                                    x:Name="ColHash"
                                    Width="110"
                                    Binding="{Binding ShortHash}"
                                    ElementStyle="{StaticResource EllipsisCellTextStyle}"
                                    Header="{DynamicResource Str_Dup_ColHeaderHash}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <controls:EmptyStateCard
                            x:Name="EmptyStatePanel"
                            Grid.Row="1"
                            Description="{DynamicResource Str_Dup_ResultsHint}"
                            Icon="ContentDuplicate"
                            IsHitTestVisible="False" />
                    </Grid>
                </Border>
            </Grid>

            <!--  ================= COMPARE DRAWER =================  -->

            <Border
                x:Name="CompareScrim"
                Grid.Column="2"
                Background="Black"
                CornerRadius="12"
                MouseDown="CompareScrim_MouseDown"
                Opacity="0.35"
                Visibility="Collapsed" />

            <Border
                x:Name="ComparePanel"
                Grid.Column="2"
                Width="420"
                HorizontalAlignment="Right"
                Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1"
                CornerRadius="12"
                Visibility="Collapsed">
                <Border.RenderTransform>
                    <TranslateTransform x:Name="ComparePanelShift" />
                </Border.RenderTransform>
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Header  -->
                    <StackPanel Margin="16,14,16,10">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentControl
                                VerticalAlignment="Center"
                                Content="{DynamicResource Str_Dup_CompareTitle}"
                                Style="{StaticResource CardHeader}"
                                Tag="{x:Static materialDesign:PackIconKind.FileCompare}" />
                            <Button
                                Grid.Column="1"
                                Width="30"
                                Height="30"
                                Click="BtnCloseCompare_Click"
                                Style="{StaticResource NeutralIconButtonStyle}"
                                ToolTip="{DynamicResource Str_Dup_CloseDrawerTooltip}">
                                <materialDesign:PackIcon
                                    Width="15"
                                    Height="15"
                                    Kind="Close" />
                            </Button>
                        </Grid>

                        <Border
                            Margin="0,12,0,0"
                            Padding="4"
                            Background="{DynamicResource RowBg}"
                            CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    x:Name="BtnPrevCompareGroup"
                                    Width="30"
                                    Height="30"
                                    Click="BtnPrevCompareGroup_Click"
                                    Style="{StaticResource NeutralIconButtonStyle}"
                                    ToolTip="{DynamicResource Str_DuplicateFinder_PreviousGroup}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="ChevronLeft" />
                                </Button>
                                <StackPanel
                                    Grid.Column="1"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center">
                                    <TextBlock
                                        x:Name="TxtCompareGroupPosition"
                                        HorizontalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock
                                        x:Name="TxtCompareGroupLabel"
                                        HorizontalAlignment="Center"
                                        FontSize="11"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Text="{DynamicResource Str_Dup_GroupPlaceholder}" />
                                </StackPanel>
                                <Button
                                    x:Name="BtnNextCompareGroup"
                                    Grid.Column="2"
                                    Width="30"
                                    Height="30"
                                    Click="BtnNextCompareGroup_Click"
                                    Style="{StaticResource NeutralIconButtonStyle}"
                                    ToolTip="{DynamicResource Str_DuplicateFinder_NextGroup}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="ChevronRight" />
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>

                    <!--  Files in the group  -->
                    <ScrollViewer
                        x:Name="CompareScroller"
                        Grid.Row="1"
                        Padding="16,0"
                        VerticalScrollBarVisibility="Auto">
                        <ItemsControl
                            x:Name="CompareItemsControl"
                            Focusable="False"
                            ItemTemplate="{StaticResource CompareCardTemplate}" />
                    </ScrollViewer>

                    <!--  Footer  -->
                    <Grid Grid.Row="2" Margin="16,10,16,14">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="BtnSuggestOriginal"
                            HorizontalAlignment="Left"
                            Click="BtnSuggestOriginal_Click"
                            Style="{StaticResource NeutralIconButtonStyle}"
                            ToolTip="{DynamicResource Str_Dup_SuggestOldestTooltip}">
                            <Grid Margin="8,0" HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon
                                    Grid.Column="0"
                                    Width="15"
                                    Height="15"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Kind="AutoFix" />
                                <TextBlock
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Text="{DynamicResource Str_Dup_SuggestOldest}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Button>
                        <Button
                            x:Name="BtnApplyOriginal"
                            Grid.Column="1"
                            Click="BtnApplyOriginal_Click"
                            Style="{StaticResource PrimaryButtonStyle}"
                            ToolTip="{DynamicResource Str_Dup_ApplyChoiceTooltip}">
                            <Grid HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="TxtApplyLabel"
                                    Grid.Column="0"
                                    VerticalAlignment="Center"
                                    Text="{DynamicResource Str_DuplicateFinder_NextGroup}"
                                    TextWrapping="Wrap" />
                                <materialDesign:PackIcon
                                    Grid.Column="1"
                                    Width="15"
                                    Height="15"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Kind="ChevronRight" />
                            </Grid>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
