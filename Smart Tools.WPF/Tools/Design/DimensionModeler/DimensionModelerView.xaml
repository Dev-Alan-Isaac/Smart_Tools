<UserControl
    x:Class="Smart_Tools.WPF.Views.DimensionModelerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    x:Name="Root"
    Focusable="True"
    FocusVisualStyle="{x:Null}"
    Loaded="Root_Loaded"
    PreviewKeyDown="Root_PreviewKeyDown"
    Unloaded="Root_Unloaded">

    <!--
        3D Modeler. Backend: Tools/Design/DimensionModeler/Core/*.cs (scene, shapes, CSG, edits, files, examples - pure and tested),
        DimensionModelerManager.cs (settings, export). This page and its code-behind are UI only:
        .xaml.cs = flow, settings, undo and files; .Stage.cs = the 3D view, picking and the measuring lines; .Palette.cs = shapes and
        examples; .Inspector.cs = the Properties tab; .Outliner.cs = the Objects and Parts tabs; .Gizmo.cs = the axis gizmo.
    -->

    <UserControl.Resources>
        <!--  Labels and hints on the main surface (the sidebar ones use sidebar colours)  -->
        <Style x:Key="PanelLabel" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Margin" Value="0,12,0,4" />
        </Style>
        <Style x:Key="PanelCaption" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <!--  Width / Height / Depth: the box outline and caption in the axis colour of the measuring lines (Tag = the brush)  -->
        <Style x:Key="AxisInputBar" BasedOn="{StaticResource InputBarStyle}" TargetType="Border">
            <Setter Property="BorderBrush" Value="{Binding Tag, RelativeSource={RelativeSource Self}}" />
            <Setter Property="BorderThickness" Value="1.5" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                </Trigger>
                <Trigger Property="IsKeyboardFocusWithin" Value="True">
                    <Setter Property="BorderBrush" Value="{Binding Tag, RelativeSource={RelativeSource Self}}" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="AxisCaption" BasedOn="{StaticResource PanelCaption}" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style x:Key="PanelBox" BasedOn="{StaticResource BareTextBox}" TargetType="TextBox">
            <Setter Property="TextAlignment" Value="Right" />
        </Style>

        <!--  One row of the Objects list: indented by depth, an accent outline when picked  -->
        <Style x:Key="OutlineRowStyle" TargetType="ListBoxItem">
            <Setter Property="Padding" Value="4,3" />
            <Setter Property="Margin" Value="0,0,0,2" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
                            x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="7">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlayFill}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentColorSubtle}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">
        <Grid Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OptionsColumn" Width="280" />
                <ColumnDefinition x:Name="OptionsGapColumn" Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= SIDEBAR =================  -->
            <Border x:Name="OptionsSidebar" Grid.Column="0" Style="{StaticResource SidebarPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Button
                            x:Name="BtnCollapseOptions"
                            MinHeight="45"
                            HorizontalContentAlignment="Left"
                            Click="BtnCollapseOptions_Click"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Foreground="{DynamicResource SidebarText}"
                            ToolTip="{DynamicResource Str_Common_SidebarToggleTooltip}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="OverridesDefaultStyle" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Margin="16,0,0,0" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Kind="TuneVariant" />
                                <TextBlock
                                    x:Name="TxtOptionsHeaderLabel"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{DynamicResource Str_Common_OptionsLabel}" />
                            </StackPanel>
                        </Button>

                        <Separator
                            x:Name="SepHeader"
                            Margin="16,4"
                            Style="{StaticResource SidebarSeparatorStyle}" />
                    </StackPanel>

                    <ScrollViewer
                        x:Name="OptionsScrollViewer"
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16">

                            <!--  ============ SHAPES: click one to add it (tiles are made in code) ============  -->
                            <Border Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Modeler_ShapesHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.ShapePlusOutline}" />
                                    <UniformGrid x:Name="PanelShapes" ctl:Tour.Key="Str_Tour_DimensionModeler_Shapes" ctl:Tour.Order="1" Columns="3" />
                                    <!--  Draw an outline on the floor, give it a thickness  -->
                                    <Grid Margin="2,6,2,0" ctl:Tour.Key="Str_Tour_DimensionModeler_Extrude" ctl:Tour.Order="3">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            x:Name="BtnExtrude"
                                            Height="36"
                                            Padding="6,0"
                                            Click="BtnExtrude_Click"
                                            Style="{StaticResource NeutralIconButtonStyle}"
                                            ToolTip="{DynamicResource Str_Modeler_ExtrudeTip}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="18"
                                                    Height="18"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Kind="VectorPolygon" />
                                                <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_Modeler_Extrude}" />
                                            </StackPanel>
                                        </Button>
                                        <TextBox
                                            x:Name="TxtExtrudeHeight"
                                            Grid.Column="1"
                                            Width="66"
                                            Padding="4,0"
                                            HorizontalContentAlignment="Center"
                                            Height="36"
                                            Margin="6,0,0,0"
                                            VerticalContentAlignment="Center"
                                            LostFocus="TxtExtrudeHeight_LostFocus"
                                            KeyDown="TxtExtrudeHeight_KeyDown"
                                            ToolTip="{DynamicResource Str_Modeler_ExtrudeHeightTip}" />
                                    </Grid>
                                    <TextBlock
                                        Margin="0,12,0,6"
                                        Style="{StaticResource FieldLabel}"
                                        Text="{DynamicResource Str_Modeler_HolesLabel}"
                                        ToolTip="{DynamicResource Str_Modeler_HolesLabelTip}" />
                                    <UniformGrid x:Name="PanelHoleShapes" ctl:Tour.Key="Str_Tour_DimensionModeler_Holes" ctl:Tour.Order="4" Columns="3" />
                                    <TextBlock Style="{StaticResource SidebarHint}" Text="{DynamicResource Str_Modeler_ShapesHint}" />
                                </StackPanel>
                            </Border>

                            <!--  ============ EXAMPLES: set the sliders, then insert as ordinary shapes ============  -->
                            <Border ctl:Tour.Key="Str_Tour_DimensionModeler_Examples" ctl:Tour.Order="7" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Modeler_ExamplesHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.CubeOutline}" />
                                    <Border Style="{StaticResource InputBarStyle}">
                                        <ComboBox
                                            x:Name="ComboExample"
                                            Margin="4,0"
                                            SelectedValuePath="Id"
                                            SelectionChanged="ComboExample_Changed"
                                            Style="{StaticResource BareComboBox}"
                                            ToolTip="{DynamicResource Str_Modeler_ExamplesTip}">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon
                                                            Width="18"
                                                            Height="18"
                                                            Margin="0,0,10,0"
                                                            VerticalAlignment="Center"
                                                            Kind="{Binding Icon}" />
                                                        <TextBlock VerticalAlignment="Center" Text="{Binding Name}" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                    </Border>
                                    <StackPanel x:Name="PanelParams" />
                                    <Grid Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            x:Name="BtnInsertExample"
                                            Click="BtnInsertExample_Click"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            ToolTip="{DynamicResource Str_Modeler_InsertTip}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="16"
                                                    Height="16"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Kind="Plus" />
                                                <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_Modeler_Insert}" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            x:Name="BtnResetSizes"
                                            Grid.Column="1"
                                            Width="32"
                                            Height="32"
                                            Margin="6,0,0,0"
                                            Padding="0"
                                            Click="BtnResetSizes_Click"
                                            Style="{StaticResource ListToolButtonStyle}"
                                            ToolTip="{DynamicResource Str_Modeler_ResetSizesTip}">
                                            <materialDesign:PackIcon
                                                Width="16"
                                                Height="16"
                                                Kind="Restore" />
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!--  ============ SNAP ============  -->
                            <Border ctl:Tour.Key="Str_Tour_DimensionModeler_Snap" ctl:Tour.Order="8" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Modeler_SnapHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.Magnet}" />
                                    <Border Style="{StaticResource InputBarStyle}">
                                        <ComboBox
                                            x:Name="ComboGrid"
                                            Margin="4,0"
                                            SelectionChanged="ComboGrid_Changed"
                                            Style="{StaticResource BareComboBox}"
                                            ToolTip="{DynamicResource Str_Modeler_GridTip}" />
                                    </Border>
                                    <CheckBox
                                        x:Name="ChkMagnet"
                                        Margin="0,8,0,0"
                                        Checked="ChkMagnet_Changed"
                                        Content="{DynamicResource Str_Modeler_Magnet}"
                                        Foreground="{DynamicResource SidebarText}"
                                        ToolTip="{DynamicResource Str_Modeler_MagnetTip}"
                                        Unchecked="ChkMagnet_Changed" />
                                </StackPanel>
                            </Border>

                            <!--  ============ VIEW ============  -->
                            <Border ctl:Tour.Key="Str_Tour_DimensionModeler_View" ctl:Tour.Order="9" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Modeler_ViewHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.ArrowExpandHorizontal}" />
                                    <TextBlock
                                        Margin="0,0,0,6"
                                        Style="{StaticResource FieldLabel}"
                                        Text="{DynamicResource Str_Modeler_Units}" />
                                    <UniformGrid Columns="3">
                                        <RadioButton
                                            x:Name="RadioMm"
                                            Margin="0,0,2,0"
                                            Click="Unit_Click"
                                            Content="{DynamicResource Str_Modeler_UnitMm}"
                                            GroupName="Unit"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="Millimetres" />
                                        <RadioButton
                                            x:Name="RadioCm"
                                            Margin="2,0,2,0"
                                            Click="Unit_Click"
                                            Content="{DynamicResource Str_Modeler_UnitCm}"
                                            GroupName="Unit"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="Centimetres" />
                                        <RadioButton
                                            x:Name="RadioIn"
                                            Margin="2,0,0,0"
                                            Click="Unit_Click"
                                            Content="{DynamicResource Str_Modeler_UnitIn}"
                                            GroupName="Unit"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="Inches" />
                                    </UniformGrid>
                                    <CheckBox
                                        x:Name="ChkDimensions"
                                        Margin="0,12,0,0"
                                        Checked="ChkDimensions_Changed"
                                        Content="{DynamicResource Str_Modeler_ShowDimensions}"
                                        Foreground="{DynamicResource SidebarText}"
                                        IsChecked="True"
                                        ToolTip="{DynamicResource Str_Modeler_ShowDimensionsTip}"
                                        Unchecked="ChkDimensions_Changed" />
                                </StackPanel>
                            </Border>

                            <!--  ============ 3D PRINTING ============  -->
                            <Border ctl:Tour.Key="Str_Tour_DimensionModeler_Print" ctl:Tour.Order="10" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Modeler_PrintHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.Printer_3d}" />
                                    <TextBlock
                                        Margin="0,0,0,6"
                                        Style="{StaticResource FieldLabel}"
                                        Text="{DynamicResource Str_Modeler_Scale}"
                                        ToolTip="{DynamicResource Str_Modeler_ScaleTip}" />
                                    <controls:PresetChips
                                        x:Name="PresetScale"
                                        Columns="3"
                                        Items="1/1:1;1/2:2;1/5:5;1/10:10;1/20:20"
                                        PresetChosen="Scale_Chosen" />
                                    <TextBlock Style="{StaticResource SidebarHint}" Text="{DynamicResource Str_Modeler_ScaleHint}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--  ================= MAIN =================  -->
            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  The design's name (type to rename), its overall size, and Export  -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBox
                                x:Name="TxtSceneName"
                                Padding="0"
                                HorizontalAlignment="Left"
                                MinWidth="120"
                                Background="Transparent"
                                BorderThickness="0"
                                FontSize="16"
                                FontWeight="Bold"
                                Foreground="{DynamicResource TextPrimary}"
                                KeyDown="TxtSceneName_KeyDown"
                                LostFocus="TxtSceneName_LostFocus"
                                ToolTip="{DynamicResource Str_Modeler_SceneNameTip}" />
                            <TextBlock
                                x:Name="TxtSceneSize"
                                Margin="0,2,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource TextSecondary}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <controls:ExportButton
                            x:Name="BtnExport"
                            Grid.Column="1"
                            ctl:Tour.Key="Str_Tour_DimensionModeler_Export"
                            ctl:Tour.Order="11"
                            VerticalAlignment="Center"
                            ToolTip="{DynamicResource Str_Modeler_ExportTip}">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Click="MenuExport_Click" Header="{DynamicResource Str_Modeler_ExportStl}" Tag="stl">
                                        <MenuItem.Icon>
                                            <materialDesign:PackIcon Kind="Printer_3d" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Click="MenuExport_Click" Header="{DynamicResource Str_Modeler_ExportObj}" Tag="obj">
                                        <MenuItem.Icon>
                                            <materialDesign:PackIcon Kind="CubeOutline" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </controls:ExportButton>
                    </Grid>

                    <!--  Toolbar: every button acts on the picked shapes  -->
                    <WrapPanel x:Name="Toolbar" ctl:Tour.Key="Str_Tour_DimensionModeler_Group" ctl:Tour.Order="5" Grid.Row="1" Margin="0,0,0,10">
                        <Button x:Name="BtnUndo" Width="32" Height="32" Padding="0" Click="BtnUndo_Click" Style="{StaticResource ListToolButtonStyle}" ToolTip="{DynamicResource Str_Modeler_UndoTip}">
                            <materialDesign:PackIcon Width="16" Height="16" Kind="UndoVariant" />
                        </Button>
                        <Button x:Name="BtnRedo" Width="32" Height="32" Margin="4,0,0,0" Padding="0" Click="BtnRedo_Click" Style="{StaticResource ListToolButtonStyle}" ToolTip="{DynamicResource Str_Modeler_RedoTip}">
                            <materialDesign:PackIcon Width="16" Height="16" Kind="RedoVariant" />
                        </Button>
                        <Border Width="1" Height="20" Margin="10,0" Background="{DynamicResource CardBorder}" />
                        <Button x:Name="BtnGroup" Width="32" Height="32" Padding="0" Click="BtnGroup_Click" Style="{StaticResource ListToolButtonStyle}" ToolTip="{DynamicResource Str_Modeler_GroupTip}">
                            <materialDesign:PackIcon Width="16" Height="16" Kind="Group" />
                        </Button>
                        <Button x:Name="BtnUngroup" Width="32" Height="32" Margin="4,0,0,0" Padding="0" Click="BtnUngroup_Click" Style="{StaticResource ListToolButtonStyle}" ToolTip="{DynamicResource Str_Modeler_UngroupTip}">
                            <materialDesign:PackIcon Width="16" Height="16" Kind="Ungroup" />
                        </Button>
                        <Button x:Name="BtnMakeHole" Width="32" Height="32" Margin="4,0,0,0" Padding="0" Click="BtnMakeHole_Click" Style="{StaticResource ListToolButtonStyle}" ToolTip="{DynamicResource Str_Modeler_MakeHoleTip}">
                            <materialDesign:PackIcon x:Name="IconMakeHole" Width="16" Height="16" Kind="VectorDifference" />
                        </Button>
                        <Border Width="1" Height="20" Margin="10,0" Background="{DynamicResource CardBorder}" />
                        <Button x:Name="BtnDuplicate" Width="32" Height="32" Padding="0" Click="BtnDuplicate_Click" Style="{StaticResource ListToolButtonStyle}" ToolTip="{DynamicResource Str_Modeler_DuplicateTip}">
                            <materialDesign:PackIcon Width="16" Height="16" Kind="ContentDuplicate" />
                        </Button>
                        <Button x:Name="BtnDropToFloor" Width="32" Height="32" Margin="4,0,0,0" Padding="0" Click="BtnDropToFloor_Click" Style="{StaticResource ListToolButtonStyle}" ToolTip="{DynamicResource Str_Modeler_DropTip}">
                            <materialDesign:PackIcon Width="16" Height="16" Kind="ArrowCollapseDown" />
                        </Button>
                        <Button x:Name="BtnDelete" Width="32" Height="32" Margin="4,0,0,0" Padding="0" Click="BtnDelete_Click" Style="{StaticResource ListToolDangerButtonStyle}" ToolTip="{DynamicResource Str_Modeler_DeleteTip}">
                            <materialDesign:PackIcon Width="16" Height="16" Kind="DeleteOutline" />
                        </Button>
                        <Border Width="1" Height="20" Margin="10,0" Background="{DynamicResource CardBorder}" />
                        <Button x:Name="BtnOpenDesign" Width="32" Height="32" Padding="0" Click="BtnOpenDesign_Click" Style="{StaticResource ListToolButtonStyle}" ToolTip="{DynamicResource Str_Modeler_OpenTip}">
                            <materialDesign:PackIcon Width="16" Height="16" Kind="FolderOpenOutline" />
                        </Button>
                        <Button x:Name="BtnImport" Width="32" Height="32" Margin="4,0,0,0" Padding="0" Click="BtnImport_Click" Style="{StaticResource ListToolButtonStyle}" ToolTip="{DynamicResource Str_Modeler_ImportTip}">
                            <materialDesign:PackIcon Width="16" Height="16" Kind="FileImportOutline" />
                        </Button>
                        <Button x:Name="BtnSaveDesign" Width="32" Height="32" Margin="4,0,0,0" Padding="0" Click="BtnSaveDesign_Click" Style="{StaticResource ListToolButtonStyle}" ToolTip="{DynamicResource Str_Modeler_SaveTip}">
                            <materialDesign:PackIcon Width="16" Height="16" Kind="ContentSaveOutline" />
                        </Button>
                        <Button x:Name="BtnNew" Width="32" Height="32" Margin="4,0,0,0" Padding="0" Click="BtnNew_Click" Style="{StaticResource ListToolDangerButtonStyle}" ToolTip="{DynamicResource Str_Modeler_NewTip}">
                            <materialDesign:PackIcon Width="16" Height="16" Kind="DeleteSweepOutline" />
                        </Button>
                        <Border Width="1" Height="20" Margin="10,0" Background="{DynamicResource CardBorder}" />
                        <Button x:Name="BtnMeasure" Width="32" Height="32" Margin="0,0,4,0" Padding="0" Click="BtnMeasure_Click" Style="{StaticResource ListToolButtonStyle}" ToolTip="{DynamicResource Str_Modeler_MeasureToolTip}">
                            <materialDesign:PackIcon Width="16" Height="16" Kind="TapeMeasure" />
                        </Button>
                        <Button x:Name="BtnFit" Width="32" Height="32" Padding="0" Click="BtnFit_Click" Style="{StaticResource ListToolButtonStyle}" ToolTip="{DynamicResource Str_Modeler_FitTip}">
                            <materialDesign:PackIcon Width="16" Height="16" Kind="FitToScreenOutline" />
                        </Button>
                        <Button x:Name="BtnFullView" Width="32" Height="32" Margin="4,0,0,0" Padding="0" Click="BtnFullView_Click" Style="{StaticResource ListToolButtonStyle}" ToolTip="{DynamicResource Str_Modeler_FullViewTip}">
                            <materialDesign:PackIcon x:Name="IconFullView" Width="16" Height="16" Kind="ArrowExpand" />
                        </Button>
                        <Button x:Name="BtnTogglePanel" Width="32" Height="32" Margin="4,0,0,0" Padding="0" Click="BtnTogglePanel_Click" Style="{StaticResource ListToolButtonStyle}" ToolTip="{DynamicResource Str_Modeler_HidePanelTip}">
                            <materialDesign:PackIcon x:Name="IconTogglePanel" Width="16" Height="16" Kind="ChevronRight" />
                        </Button>
                    </WrapPanel>

                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition x:Name="PanelGapColumn" Width="14" />
                            <ColumnDefinition x:Name="PanelColumn" Width="340" />
                        </Grid.ColumnDefinitions>

                        <!--  The 3D view: click picks, drag turns, right-drag moves, wheel zooms. The lines are drawn over it from the same camera.  -->
                        <Border
                            ctl:Tour.Key="Str_Tour_DimensionModeler_Stage"
                            ctl:Tour.Order="2"
                            Background="{DynamicResource RowBg}"
                            ClipToBounds="True"
                            CornerRadius="12">
                            <Grid
                                x:Name="StageHost"
                                Background="Transparent"
                                ClipToBounds="True"
                                FocusVisualStyle="{x:Null}"
                                Focusable="True"
                                MouseDown="Stage_MouseDown"
                                MouseMove="Stage_MouseMove"
                                MouseUp="Stage_MouseUp"
                                MouseWheel="Stage_MouseWheel"
                                SizeChanged="Stage_SizeChanged">
                                <Viewport3D x:Name="Stage3D" ClipToBounds="True" IsHitTestVisible="False">
                                    <Viewport3D.Camera>
                                        <PerspectiveCamera
                                            x:Name="Cam"
                                            FarPlaneDistance="100000"
                                            FieldOfView="45"
                                            NearPlaneDistance="20" />
                                    </Viewport3D.Camera>
                                </Viewport3D>
                                <Canvas
                                    x:Name="Overlay"
                                    ClipToBounds="True"
                                    IsHitTestVisible="False" />
                                <!--  Empty design: what to do first  -->
                                <StackPanel
                                    x:Name="PanelStageEmpty"
                                    MaxWidth="360"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False"
                                    Visibility="Collapsed">
                                    <ContentControl HorizontalAlignment="Center" Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.ShapePlusOutline}" />
                                    <TextBlock
                                        Margin="0,12,0,4"
                                        HorizontalAlignment="Center"
                                        FontSize="14"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimary}"
                                        Text="{DynamicResource Str_Modeler_EmptyTitle}" />
                                    <TextBlock
                                        HorizontalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Text="{DynamicResource Str_Modeler_EmptyHint}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <TextBlock
                                    x:Name="TxtStageHint"
                                    Margin="14,0,110,10"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Bottom"
                                    FontSize="11"
                                    Foreground="{DynamicResource TextSecondary}"
                                    IsHitTestVisible="False"
                                    Opacity="0.8"
                                    Text="{DynamicResource Str_Modeler_StageHint}"
                                    TextWrapping="Wrap" />
                                <!--  Axis gizmo: turns with the camera; click an axis end to look from that side  -->
                                <Canvas
                                    x:Name="Gizmo"
                                    Width="92"
                                    Height="92"
                                    Margin="0,0,8,8"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Bottom"
                                    Background="Transparent"
                                    MouseDown="Gizmo_MouseDown"
                                    MouseUp="Gizmo_MouseUp" />
                                <!--  Shown when the pick is one part of a group: measure the part, its whole group, or both  -->
                                <Border
                                    x:Name="MeasureSwitch"
                                    Margin="10"
                                    Padding="4"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource PopupBg}"
                                    BorderBrush="{DynamicResource CardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="10"
                                    Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="16"
                                            Height="16"
                                            Margin="6,0,6,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource TextSecondary}"
                                            Kind="RulerSquare"
                                            ToolTip="{DynamicResource Str_Modeler_MeasureTip}" />
                                        <RadioButton x:Name="RadioMeasurePart" MinWidth="84" MinHeight="30" Margin="0,0,3,0" Click="MeasureMode_Click" Content="{DynamicResource Str_Modeler_MeasurePart}" GroupName="MeasureMode" Style="{StaticResource ModeToggleButtonStyle}" Tag="part" />
                                        <RadioButton x:Name="RadioMeasureGroup" MinWidth="84" MinHeight="30" Margin="0,0,3,0" Click="MeasureMode_Click" Content="{DynamicResource Str_Modeler_MeasureGroup}" GroupName="MeasureMode" Style="{StaticResource ModeToggleButtonStyle}" Tag="group" />
                                        <RadioButton x:Name="RadioMeasureBoth" MinWidth="84" MinHeight="30" Click="MeasureMode_Click" Content="{DynamicResource Str_Modeler_MeasureBoth}" GroupName="MeasureMode" Style="{StaticResource ModeToggleButtonStyle}" Tag="both" />
                                    </StackPanel>
                                </Border>
                            </Grid>
                        </Border>

                        <!--  Properties / Objects / Parts  -->
                        <Border
                            x:Name="SidePanel"
                            ctl:Tour.Key="Str_Tour_DimensionModeler_Panel" ctl:Tour.Order="6"
                            Grid.Column="2"
                            Padding="12,6,12,12"
                            Background="{DynamicResource RowBg}"
                            CornerRadius="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <WrapPanel Margin="0,0,0,6">
                                    <RadioButton x:Name="TabProperties" Checked="PanelTab_Checked" GroupName="ModelerPanel" Style="{StaticResource UnderlineTabStyle}" Tag="properties" ToolTip="{DynamicResource Str_Modeler_TabPropertiesTip}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" Kind="TuneVariant" />
                                            <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_Modeler_TabProperties}" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="TabObjects" Checked="PanelTab_Checked" GroupName="ModelerPanel" Style="{StaticResource UnderlineTabStyle}" Tag="objects" ToolTip="{DynamicResource Str_Modeler_TabObjectsTip}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" Kind="FileTreeOutline" />
                                            <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_Modeler_TabObjects}" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton x:Name="TabParts" Checked="PanelTab_Checked" GroupName="ModelerPanel" Style="{StaticResource UnderlineTabStyle}" Tag="parts" ToolTip="{DynamicResource Str_Modeler_TabPartsTip}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" Kind="FormatListBulleted" />
                                            <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_Modeler_TabParts}" />
                                        </StackPanel>
                                    </RadioButton>
                                </WrapPanel>

                                <!--  ===== Properties of the picked shapes ===== -->
                                <ScrollViewer x:Name="PageProperties" Grid.Row="1" VerticalScrollBarVisibility="Auto">
                                    <StackPanel>
                                        <TextBlock
                                            x:Name="TxtNoPick"
                                            Margin="0,10,0,0"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextSecondary}"
                                            Text="{DynamicResource Str_Modeler_NoPick}"
                                            TextWrapping="Wrap" />
                                        <StackPanel x:Name="PanelPick" Visibility="Collapsed">
                                            <StackPanel Margin="0,6,0,0" Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    x:Name="IconPick"
                                                    Width="18"
                                                    Height="18"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource AccentColor}"
                                                    Kind="CubeOutline" />
                                                <TextBlock
                                                    x:Name="TxtPickTitle"
                                                    VerticalAlignment="Center"
                                                    FontSize="13"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource TextPrimary}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <StackPanel x:Name="PanelName">
                                                <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource Str_Modeler_Name}" />
                                                <Border Style="{StaticResource InputBarStyle}">
                                                    <TextBox x:Name="TxtName" KeyDown="Field_KeyDown" LostFocus="Field_LostFocus" Style="{StaticResource BareTextBox}" Tag="name" />
                                                </Border>
                                            </StackPanel>

                                            <StackPanel x:Name="PanelKind">
                                                <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource Str_Modeler_Kind}" />
                                                <Border Style="{StaticResource InputBarStyle}">
                                                    <ComboBox x:Name="ComboKind" Margin="4,0" SelectionChanged="ComboKind_Changed" Style="{StaticResource BareComboBox}" />
                                                </Border>
                                            </StackPanel>

                                            <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource Str_Modeler_SolidOrHole}" ToolTip="{DynamicResource Str_Modeler_HolesLabelTip}" />
                                            <UniformGrid Columns="2">
                                                <RadioButton
                                                    x:Name="RadioSolid"
                                                    Margin="0,0,2,0"
                                                    controls:ChoiceIcon.Kind="VectorUnion"
                                                    Click="SolidHole_Click"
                                                    Content="{DynamicResource Str_Modeler_Solid}"
                                                    GroupName="SolidHole"
                                                    Style="{StaticResource ModeToggleButtonStyle}"
                                                    Tag="solid" />
                                                <RadioButton
                                                    x:Name="RadioHole"
                                                    Margin="2,0,0,0"
                                                    controls:ChoiceIcon.Kind="VectorDifference"
                                                    Click="SolidHole_Click"
                                                    Content="{DynamicResource Str_Modeler_Hole}"
                                                    GroupName="SolidHole"
                                                    Style="{StaticResource ModeToggleButtonStyle}"
                                                    Tag="hole" />
                                            </UniformGrid>

                                            <TextBlock x:Name="TxtPosLabel" Style="{StaticResource PanelLabel}" ToolTip="{DynamicResource Str_Modeler_PositionTip}" />
                                            <UniformGrid Columns="3">
                                                <StackPanel Margin="0,0,4,0">
                                                    <Border Style="{StaticResource InputBarStyle}">
                                                        <TextBox x:Name="TxtPosX" KeyDown="Field_KeyDown" LostFocus="Field_LostFocus" Style="{StaticResource PanelBox}" Tag="px" />
                                                    </Border>
                                                    <TextBlock Style="{StaticResource PanelCaption}" Text="X" />
                                                </StackPanel>
                                                <StackPanel Margin="2,0,2,0">
                                                    <Border Style="{StaticResource InputBarStyle}">
                                                        <TextBox x:Name="TxtPosY" KeyDown="Field_KeyDown" LostFocus="Field_LostFocus" Style="{StaticResource PanelBox}" Tag="py" />
                                                    </Border>
                                                    <TextBlock Style="{StaticResource PanelCaption}" Text="Y" />
                                                </StackPanel>
                                                <StackPanel Margin="4,0,0,0">
                                                    <Border Style="{StaticResource InputBarStyle}">
                                                        <TextBox x:Name="TxtPosZ" KeyDown="Field_KeyDown" LostFocus="Field_LostFocus" Style="{StaticResource PanelBox}" Tag="pz" />
                                                    </Border>
                                                    <TextBlock Style="{StaticResource PanelCaption}" Text="Z" />
                                                </StackPanel>
                                            </UniformGrid>

                                            <TextBlock x:Name="TxtSizeLabel" Style="{StaticResource PanelLabel}" ToolTip="{DynamicResource Str_Modeler_SizeTip}" />
                                            <UniformGrid Columns="3">
                                                <StackPanel Margin="0,0,4,0">
                                                    <Border Style="{StaticResource AxisInputBar}" Tag="{DynamicResource AxisXBrush}">
                                                        <TextBox x:Name="TxtSizeW" KeyDown="Field_KeyDown" LostFocus="Field_LostFocus" Style="{StaticResource PanelBox}" Tag="sx" />
                                                    </Border>
                                                    <TextBlock Foreground="{DynamicResource AxisXBrush}" Style="{StaticResource AxisCaption}" Text="{DynamicResource Str_Modeler_Width}" />
                                                </StackPanel>
                                                <StackPanel Margin="2,0,2,0">
                                                    <Border Style="{StaticResource AxisInputBar}" Tag="{DynamicResource AxisYBrush}">
                                                        <TextBox x:Name="TxtSizeH" KeyDown="Field_KeyDown" LostFocus="Field_LostFocus" Style="{StaticResource PanelBox}" Tag="sy" />
                                                    </Border>
                                                    <TextBlock Foreground="{DynamicResource AxisYBrush}" Style="{StaticResource AxisCaption}" Text="{DynamicResource Str_Modeler_Height}" />
                                                </StackPanel>
                                                <StackPanel Margin="4,0,0,0">
                                                    <Border Style="{StaticResource AxisInputBar}" Tag="{DynamicResource AxisZBrush}">
                                                        <TextBox x:Name="TxtSizeD" KeyDown="Field_KeyDown" LostFocus="Field_LostFocus" Style="{StaticResource PanelBox}" Tag="sz" />
                                                    </Border>
                                                    <TextBlock Foreground="{DynamicResource AxisZBrush}" Style="{StaticResource AxisCaption}" Text="{DynamicResource Str_Modeler_Depth}" />
                                                </StackPanel>
                                            </UniformGrid>

                                            <StackPanel x:Name="PanelRotation">
                                                <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource Str_Modeler_Rotation}" ToolTip="{DynamicResource Str_Modeler_RotationTip}" />
                                                <UniformGrid Columns="3">
                                                    <StackPanel Margin="0,0,4,0">
                                                        <Border Style="{StaticResource InputBarStyle}">
                                                            <TextBox x:Name="TxtRotX" KeyDown="Field_KeyDown" LostFocus="Field_LostFocus" Style="{StaticResource PanelBox}" Tag="rx" />
                                                        </Border>
                                                        <TextBlock Style="{StaticResource PanelCaption}" Text="X °" />
                                                    </StackPanel>
                                                    <StackPanel Margin="2,0,2,0">
                                                        <Border Style="{StaticResource InputBarStyle}">
                                                            <TextBox x:Name="TxtRotY" KeyDown="Field_KeyDown" LostFocus="Field_LostFocus" Style="{StaticResource PanelBox}" Tag="ry" />
                                                        </Border>
                                                        <TextBlock Style="{StaticResource PanelCaption}" Text="Y °" />
                                                    </StackPanel>
                                                    <StackPanel Margin="4,0,0,0">
                                                        <Border Style="{StaticResource InputBarStyle}">
                                                            <TextBox x:Name="TxtRotZ" KeyDown="Field_KeyDown" LostFocus="Field_LostFocus" Style="{StaticResource PanelBox}" Tag="rz" />
                                                        </Border>
                                                        <TextBlock Style="{StaticResource PanelCaption}" Text="Z °" />
                                                    </StackPanel>
                                                </UniformGrid>
                                            </StackPanel>

                                            <Grid x:Name="PanelRound" Margin="0,0,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel>
                                                    <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource Str_Modeler_Segments}" ToolTip="{DynamicResource Str_Modeler_SegmentsTip}" />
                                                    <Border Style="{StaticResource InputBarStyle}">
                                                        <TextBox x:Name="TxtSegments" KeyDown="Field_KeyDown" LostFocus="Field_LostFocus" Style="{StaticResource PanelBox}" Tag="seg" />
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel x:Name="PanelInner" Grid.Column="2">
                                                    <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource Str_Modeler_Inner}" ToolTip="{DynamicResource Str_Modeler_InnerTip}" />
                                                    <Border Style="{StaticResource InputBarStyle}">
                                                        <TextBox x:Name="TxtInner" KeyDown="Field_KeyDown" LostFocus="Field_LostFocus" Style="{StaticResource PanelBox}" Tag="inner" />
                                                    </Border>
                                                </StackPanel>
                                            </Grid>

                                            <TextBlock Style="{StaticResource PanelLabel}" Text="{DynamicResource Str_Modeler_Colour}" />
                                            <WrapPanel x:Name="PanelSwatches" />
                                        </StackPanel>
                                    </StackPanel>
                                </ScrollViewer>

                                <!--  ===== Objects: the groups and shapes as a list ===== -->
                                <Grid x:Name="PageObjects" Grid.Row="1" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <ListBox
                                        x:Name="ListObjects"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ItemContainerStyle="{StaticResource OutlineRowStyle}"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                        SelectionChanged="ListObjects_SelectionChanged"
                                        SelectionMode="Extended">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="{Binding Indent}">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="20" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <Button
                                                        Width="20"
                                                        Height="20"
                                                        Padding="0"
                                                        Click="BtnFold_Click"
                                                        Style="{StaticResource ListToolButtonStyle}"
                                                        Visibility="{Binding FoldVisibility}">
                                                        <materialDesign:PackIcon Width="14" Height="14" Kind="{Binding FoldIcon}" />
                                                    </Button>
                                                    <materialDesign:PackIcon
                                                        Grid.Column="1"
                                                        Width="16"
                                                        Height="16"
                                                        Margin="2,0,6,0"
                                                        VerticalAlignment="Center"
                                                        Foreground="{DynamicResource TextSecondary}"
                                                        Kind="{Binding Icon}" />
                                                    <TextBlock
                                                        Grid.Column="2"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        Foreground="{DynamicResource TextPrimary}"
                                                        Opacity="{Binding TextOpacity}"
                                                        Text="{Binding Name}"
                                                        TextTrimming="CharacterEllipsis"
                                                        ToolTip="{Binding Name}" />
                                                    <Button
                                                        Grid.Column="3"
                                                        Width="26"
                                                        Height="26"
                                                        Padding="0"
                                                        Click="BtnRowEye_Click"
                                                        Style="{StaticResource ListToolButtonStyle}"
                                                        ToolTip="{DynamicResource Str_Modeler_EyeTip}">
                                                        <materialDesign:PackIcon Width="14" Height="14" Kind="{Binding EyeIcon}" />
                                                    </Button>
                                                    <Button
                                                        Grid.Column="4"
                                                        Width="26"
                                                        Height="26"
                                                        Padding="0"
                                                        Click="BtnRowLock_Click"
                                                        Style="{StaticResource ListToolButtonStyle}"
                                                        ToolTip="{DynamicResource Str_Modeler_LockTip}">
                                                        <materialDesign:PackIcon Width="14" Height="14" Kind="{Binding LockIcon}" />
                                                    </Button>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock
                                        x:Name="TxtObjectsHint"
                                        Grid.Row="1"
                                        Margin="0,8,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Text="{DynamicResource Str_Modeler_ObjectsHint}"
                                        TextWrapping="Wrap" />
                                </Grid>

                                <!--  ===== Parts: every solid with its size, same ones counted together ===== -->
                                <Grid x:Name="PageParts" Grid.Row="1" Visibility="Collapsed">
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <DataGrid
                                        x:Name="DataGridParts"
                                        AutoGenerateColumns="False"
                                        CanUserAddRows="False"
                                        FontSize="12"
                                        HeadersVisibility="Column"
                                        IsReadOnly="True"
                                        MinRowHeight="34"
                                        SelectionChanged="DataGridParts_SelectionChanged"
                                        SelectionMode="Extended">
                                        <DataGrid.Columns>
                                            <DataGridTextColumn
                                                Width="*"
                                                MinWidth="70"
                                                Binding="{Binding Name, Mode=OneWay}"
                                                ElementStyle="{StaticResource EllipsisCellTextStyle}"
                                                Header="{DynamicResource Str_Modeler_ColPart}" />
                                            <DataGridTextColumn
                                                Width="44"
                                                Binding="{Binding Quantity, Mode=OneWay}"
                                                Header="{DynamicResource Str_Modeler_ColQty}" />
                                            <DataGridTextColumn
                                                Width="1.5*"
                                                MinWidth="90"
                                                Binding="{Binding SizeText, Mode=OneWay}"
                                                ElementStyle="{StaticResource WrappingCellTextStyle}"
                                                Header="{DynamicResource Str_Modeler_ColSize}" />
                                        </DataGrid.Columns>
                                    </DataGrid>
                                    <TextBlock
                                        x:Name="TxtPartsTotals"
                                        Grid.Row="1"
                                        Margin="0,8,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource TextSecondary}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <TextBlock
                        x:Name="TxtStatus"
                        Grid.Row="3"
                        Margin="0,10,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondary}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
