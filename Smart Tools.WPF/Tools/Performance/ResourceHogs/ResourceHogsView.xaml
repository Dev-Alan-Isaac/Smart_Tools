<UserControl
    x:Class="Smart_Tools.WPF.Views.ResourceHogsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    x:Name="Root"
    Loaded="Root_Loaded"
    Unloaded="Root_Unloaded">

    <!--  Backend: Controllers/ResourceHogsManager.cs (recorder + ranking), Controllers/AppUsageStore.cs (the per-minute history). UI only here.  -->

    <UserControl.Resources>
        <Style x:Key="RhHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextMuted}" />
            <Setter Property="Margin" Value="2,8,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">
        <Grid Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <controls:ToolSidebar>
                <StackPanel>
                    <Border ctl:Tour.Key="Str_Tour_ResourceHogs_Record" ctl:Tour.Order="1" Margin="0,0,0,10" Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl Content="{DynamicResource Str_ResourceHogs_RecordHeader}" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.RecordCircleOutline}" />
                            <Button x:Name="BtnRecord" MinHeight="38" Click="BtnRecord_Click" Style="{StaticResource AccentPrimaryButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon x:Name="IconRecord" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" Kind="Record" />
                                    <TextBlock x:Name="TxtRecord" VerticalAlignment="Center" />
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="TxtRecordState" Style="{StaticResource RhHint}" />
                        </StackPanel>
                    </Border>

                    <Border ctl:Tour.Key="Str_Tour_ResourceHogs_Period" ctl:Tour.Order="2" Margin="0,0,0,10" Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl Content="{DynamicResource Str_ResourceHogs_PeriodHeader}" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.ClockOutline}" />
                            <UniformGrid Columns="2">
                                <RadioButton x:Name="Period1" Margin="0,0,2,4" Checked="Option_Changed" Content="{DynamicResource Str_ResourceHogs_Hour1}" GroupName="RhPeriod" Style="{StaticResource ModeToggleButtonStyle}" Tag="1" />
                                <RadioButton x:Name="Period3" Margin="2,0,0,4" Checked="Option_Changed" Content="{DynamicResource Str_ResourceHogs_Hours3}" GroupName="RhPeriod" IsChecked="True" Style="{StaticResource ModeToggleButtonStyle}" Tag="3" />
                                <RadioButton x:Name="Period6" Margin="0,0,2,0" Checked="Option_Changed" Content="{DynamicResource Str_ResourceHogs_Hours6}" GroupName="RhPeriod" Style="{StaticResource ModeToggleButtonStyle}" Tag="6" />
                                <RadioButton x:Name="Period24" Margin="2,0,0,0" Checked="Option_Changed" Content="{DynamicResource Str_ResourceHogs_Hours24}" GroupName="RhPeriod" Style="{StaticResource ModeToggleButtonStyle}" Tag="24" />
                            </UniformGrid>
                            <TextBlock x:Name="TxtHistory" Style="{StaticResource RhHint}" />
                        </StackPanel>
                    </Border>

                    <Border ctl:Tour.Key="Str_Tour_ResourceHogs_Metric" ctl:Tour.Order="3" Margin="0,0,0,10" Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl Content="{DynamicResource Str_ResourceHogs_ShowHeader}" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.ChartBar}" />
                            <RadioButton x:Name="MetricCpu" Margin="0,0,0,4" Checked="Option_Changed" Content="{DynamicResource Str_ResourceHogs_Cpu}" GroupName="RhMetric" IsChecked="True" Style="{StaticResource ModeToggleButtonStyle}" />
                            <RadioButton x:Name="MetricMemory" Margin="0,0,0,4" Checked="Option_Changed" Content="{DynamicResource Str_ResourceHogs_Memory}" GroupName="RhMetric" Style="{StaticResource ModeToggleButtonStyle}" />
                            <RadioButton x:Name="MetricDisk" Checked="Option_Changed" Content="{DynamicResource Str_ResourceHogs_Disk}" GroupName="RhMetric" Style="{StaticResource ModeToggleButtonStyle}" />
                            <TextBlock x:Name="TxtMetricHint" Style="{StaticResource RhHint}" />
                        </StackPanel>
                    </Border>

                    <Border ctl:Tour.Key="Str_Tour_ResourceHogs_Data" ctl:Tour.Order="4" Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl Content="{DynamicResource Str_ResourceHogs_DataHeader}" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.DatabaseOutline}" />
                            <TextBlock Margin="2,0,0,8" FontSize="11" Foreground="{DynamicResource SidebarText}" Text="{DynamicResource Str_ResourceHogs_DataNote}" TextWrapping="Wrap" />
                            <Button HorizontalAlignment="Left" Click="BtnClear_Click" Content="{DynamicResource Str_ResourceHogs_Clear}" Style="{StaticResource NeutralIconButtonStyle}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </controls:ToolSidebar>

            <controls:AppUsageBoard x:Name="Board" Grid.Column="2" ctl:Tour.Key="Str_Tour_ResourceHogs_Board" ctl:Tour.Order="5" />
        </Grid>
    </Grid>
</UserControl>
