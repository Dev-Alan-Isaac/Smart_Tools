<UserControl
    x:Class="Smart_Tools.WPF.Views.StartupAppsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:Smart_Tools.WPF.Models"
    x:Name="Root"
    d:DesignHeight="650"
    d:DesignWidth="1000"
    mc:Ignorable="d"
    Loaded="View_Loaded">

    <!--
        Startup Apps - what starts with Windows, and a switch for each one.
        Backend: Controllers/StartupAppsManager*.cs; Models/StartupAppsModel.cs. UI only here.
    -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">

        <!--  No page header: MainWindow's header card shows the tool's icon and name.  -->

        <Grid Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= OPTIONS SIDEBAR: find and refresh =================  -->
            <controls:ToolSidebar>
                <StackPanel>
                    <Border Margin="0,0,0,4" ctl:Tour.Key="Str_Tour_StartupApps_Search" ctl:Tour.Order="1" Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <DockPanel>
                                <Button
                                    ctl:Tour.Key="Str_Tour_StartupApps_Refresh"
                                    ctl:Tour.Order="2"
                                    x:Name="BtnRefresh"
                                    DockPanel.Dock="Right"
                                    Click="BtnRefresh_Click"
                                    Width="32" Height="32" Padding="0" Style="{StaticResource NeutralIconButtonStyle}"
                                    ToolTip="{DynamicResource Str_Startup_Refresh}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="Refresh" />
                                </Button>
                                <ContentControl
                                    Content="{DynamicResource Str_Startup_FindHeader}"
                                    Style="{StaticResource SidebarGroupHeader}"
                                    Tag="{x:Static materialDesign:PackIconKind.Magnify}" />
                            </DockPanel>
                            <TextBox
                                x:Name="TxtSearch"
                                Tag="{DynamicResource Str_Startup_SearchPlaceholder}"
                                TextChanged="TxtSearch_TextChanged" />
                            <Border
                                Margin="0,10,0,0"
                                HorizontalAlignment="Left"
                                Background="{DynamicResource RowBg}"
                                Style="{StaticResource IconStatusPillStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="13"
                                        Height="13"
                                        Margin="0,0,5,0"
                                        VerticalAlignment="Center"
                                        Foreground="{Binding Foreground, ElementName=TxtCount}"
                                        Kind="RocketLaunchOutline" />
                                    <TextBlock
                                        x:Name="TxtCount"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>
                            </Border>
                            <TextBlock
                                x:Name="TxtStatus"
                                Margin="2,8,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource SidebarTextMuted}"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </controls:ToolSidebar>

            <!--  ================= MAIN AREA =================  -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Changing an all-users entry needs administrator rights  -->
                <Border
                    x:Name="AdminBanner"
                    Margin="0,0,0,12"
                    Padding="14,12"
                    Background="{DynamicResource StatusWarningBg}"
                    CornerRadius="12"
                    Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon
                            Width="22"
                            Height="22"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource StatusWarningFg}"
                            Kind="ShieldAlertOutline" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource StatusWarningFg}"
                                Text="{DynamicResource Str_Startup_AdminTitle}" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource StatusWarningFg}"
                                Text="{DynamicResource Str_Startup_AdminText}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                        <Button
                            Grid.Column="2"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Click="BtnRestartAdmin_Click"
                            Style="{StaticResource PrimaryButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    VerticalAlignment="Center"
                                    Kind="ShieldCheckOutline" />
                                <TextBlock
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Text="{DynamicResource Str_Startup_RestartAdmin}" />
                            </StackPanel>
                        </Button>
                    </Grid>
                </Border>

                <!--  Entries  -->
                <Border ctl:Tour.Key="Str_Tour_StartupApps_Entries" ctl:Tour.Order="3" Grid.Row="1" Style="{StaticResource CardStyle}">
                    <Grid>
                        <DataGrid
                            x:Name="GridApps"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            FontSize="12"
                            IsReadOnly="True"
                            MinRowHeight="46"
                            SelectionMode="Single"
                            VerticalScrollBarVisibility="Auto">
                            <DataGrid.Columns>
    
                                <DataGridTemplateColumn Width="64" Header="{DynamicResource Str_Startup_ColOn}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type models:StartupApp}">
                                            <CheckBox
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Click="ChkEnabled_Click"
                                                IsChecked="{Binding IsEnabled, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                ToolTip="{DynamicResource Str_Startup_ToggleTip}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
    
                                <DataGridTemplateColumn
                                    Width="2*"
                                    MinWidth="120"
                                    Header="{DynamicResource Str_Startup_ColName}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type models:StartupApp}">
                                            <Grid VerticalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon
                                                    Width="16"
                                                    Height="16"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource StatusWarningFg}"
                                                    Kind="AlertOutline"
                                                    ToolTip="{DynamicResource Str_Startup_MissingTip}"
                                                    Visibility="{Binding FileMissing, Converter={StaticResource BoolToVisibility}}" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource TextPrimary}"
                                                        Text="{Binding Name}"
                                                        TextTrimming="CharacterEllipsis"
                                                        ToolTip="{Binding Name}" />
                                                    <TextBlock
                                                        FontSize="11"
                                                        Foreground="{DynamicResource TextSecondary}"
                                                        Text="{Binding Publisher}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
    
                                <DataGridTextColumn
                                    Width="3*"
                                    MinWidth="120"
                                    Binding="{Binding Command}"
                                    ElementStyle="{StaticResource EllipsisCellTextStyle}"
                                    Header="{DynamicResource Str_Startup_ColCommand}" />
    
                                <DataGridTextColumn
                                    Width="150"
                                    Binding="{Binding SourceText}"
                                    ElementStyle="{StaticResource EllipsisCellTextStyle}"
                                    Header="{DynamicResource Str_Startup_ColSource}" />
    
                                <DataGridTemplateColumn Width="88" CellStyle="{StaticResource CompactCellStyle}" Header="">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate DataType="{x:Type models:StartupApp}">
                                            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                <Button
                                                    Margin="0,0,2,0"
                                                    Click="BtnShow_Click"
                                                    Style="{StaticResource ListToolButtonStyle}"
                                                    ToolTip="{DynamicResource Str_Startup_ShowInFolder}">
                                                    <materialDesign:PackIcon
                                                        Width="16"
                                                        Height="16"
                                                        Kind="FolderSearchOutline" />
                                                </Button>
                                                <Button
                                                    Click="BtnRemove_Click"
                                                    Style="{StaticResource ListToolDangerButtonStyle}"
                                                    ToolTip="{DynamicResource Str_Startup_Remove}">
                                                    <materialDesign:PackIcon
                                                        Width="16"
                                                        Height="16"
                                                        Kind="DeleteOutline" />
                                                </Button>
                                            </StackPanel>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
    
                        <StackPanel
                            x:Name="PanelEmpty"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False"
                            Visibility="Collapsed">
                            <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.RocketLaunchOutline}" />
                            <TextBlock
                                x:Name="TxtEmptyTitle"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Center"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock
                                x:Name="TxtEmptyHint"
                                Margin="0,4,0,0"
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource TextSecondary}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
