<UserControl
    x:Class="Smart_Tools.WPF.Views.ProcessKillerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:local="clr-namespace:Smart_Tools.WPF.Views"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:models="clr-namespace:Smart_Tools.WPF.Models"
    x:Name="Root"
    IsVisibleChanged="Root_IsVisibleChanged"
    PreviewKeyDown="Root_PreviewKeyDown">

    <!--
        Backend: Controllers/ProcessKillerManager.cs (reading loop, merge, filter,
        process tree, settings) + .Windows.cs (kernel32/psapi/user32, ports,
        Restart Manager, WMI); Models/ProcessKillerModel.cs. UI only here.
    -->

    <UserControl.Resources>

        <local:ProcessIconConverter x:Key="ProcessIcon" />

        <Style x:Key="PillText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>

        <Style x:Key="PillIcon" TargetType="materialDesign:PackIcon">
            <Setter Property="Width" Value="13" />
            <Setter Property="Height" Value="13" />
            <Setter Property="Margin" Value="0,0,5,0" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>

        <Style x:Key="DetailLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="0,0,12,6" />
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>

        <Style x:Key="DetailValue" TargetType="TextBox">
            <Setter Property="Margin" Value="0,0,0,6" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="Height" Value="Auto" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="IsReadOnly" Value="True" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="TextWrapping" Value="NoWrap" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <ScrollViewer
                            x:Name="PART_ContentHost"
                            HorizontalScrollBarVisibility="Hidden"
                            VerticalScrollBarVisibility="Disabled" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Name cell: file icon (generic icon when there's none), name, protected shield  -->
        <DataTemplate x:Key="NameCellTemplate" DataType="{x:Type models:ProcessKillerRow}">
            <Grid VerticalAlignment="Center" ToolTip="{Binding WindowTitle}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid
                    Width="16"
                    Height="16"
                    Margin="0,0,8,0">
                    <materialDesign:PackIcon
                        Width="16"
                        Height="16"
                        Foreground="{DynamicResource TextSecondary}"
                        Kind="{x:Static materialDesign:PackIconKind.CogOutline}">
                        <materialDesign:PackIcon.Style>
                            <Style TargetType="materialDesign:PackIcon">
                                <Setter Property="Visibility" Value="Collapsed" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Source, ElementName=Img}" Value="{x:Null}">
                                        <Setter Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </materialDesign:PackIcon.Style>
                    </materialDesign:PackIcon>
                    <Image
                        x:Name="Img"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        Source="{Binding Path, Converter={StaticResource ProcessIcon}}" />
                </Grid>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimary}"
                    Text="{Binding Name}"
                    TextTrimming="CharacterEllipsis" />
                <materialDesign:PackIcon
                    x:Name="Shield"
                    Grid.Column="2"
                    Width="14"
                    Height="14"
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource StatusWarningFg}"
                    Kind="{x:Static materialDesign:PackIconKind.ShieldLockOutline}"
                    ToolTip="{DynamicResource Str_ProcessKiller_ProtectedTooltip}"
                    Visibility="Collapsed" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding CanEnd}" Value="False">
                    <Setter TargetName="Shield" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  Kind chip: App / Background / Windows  -->
        <DataTemplate x:Key="KindCellTemplate" DataType="{x:Type models:ProcessKillerRow}">
            <Border
                x:Name="Chip"
                Padding="7,2"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="{DynamicResource RowBg}"
                CornerRadius="8">
                <TextBlock
                    x:Name="ChipText"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextSecondary}"
                    Text="{DynamicResource Str_ProcessKiller_KindBackground}"
                    TextTrimming="CharacterEllipsis" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:ProcessKillerKind.App}">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusInfoBg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusInfoFg}" />
                    <Setter TargetName="ChipText" Property="Text" Value="{DynamicResource Str_ProcessKiller_KindApp}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static models:ProcessKillerKind.Windows}">
                    <Setter TargetName="ChipText" Property="Text" Value="{DynamicResource Str_ProcessKiller_KindWindows}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="RightCell" TargetType="TextBlock">
            <Setter Property="HorizontalAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="Margin" Value="0,0,8,0" />
        </Style>

        <Style x:Key="MutedCell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">

        <!--  No page header: MainWindow's header card shows the tool's icon and name.  -->

        <Grid Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OptionsColumn" Width="280" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= OPTIONS SIDEBAR =================  -->
            <Border Grid.Column="0" Style="{StaticResource SidebarPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Button
                            x:Name="BtnCollapseOptions"
                            MinHeight="45"
                            HorizontalContentAlignment="Left"
                            Click="BtnCollapseOptions_Click"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Foreground="{DynamicResource SidebarText}"
                            ToolTip="{DynamicResource Str_Common_SidebarToggleTooltip}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="OverridesDefaultStyle" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Margin="16,0,0,0" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Kind="{x:Static materialDesign:PackIconKind.TuneVariant}" />
                                <TextBlock
                                    x:Name="TxtOptionsHeaderLabel"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{DynamicResource Str_Common_OptionsLabel}" />
                            </StackPanel>
                        </Button>
                        <Separator
                            x:Name="SepHeader"
                            Margin="16,4"
                            Style="{StaticResource SidebarSeparatorStyle}" />
                    </StackPanel>

                    <ScrollViewer
                        x:Name="OptionsScrollViewer"
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16">

                            <!--  ============ FIND ============  -->
                            <Border ctl:Tour.Key="Str_Tour_ProcessKiller_Filter" ctl:Tour.Order="2" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_ProcessKiller_FindHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.Magnify}" />

                                    <UniformGrid Columns="2">
                                        <RadioButton
                                            x:Name="RadioFilterAll"
                                            Margin="0,0,3,6"
                                            Checked="RadioFilter_Checked"
                                            Content="{DynamicResource Str_ProcessKiller_FilterAll}"
                                            GroupName="PkFilter"
                                            IsChecked="True"
                                            controls:ChoiceIcon.Kind="FormatListBulleted"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            ToolTip="{DynamicResource Str_ProcessKiller_FilterAllTooltip}" />
                                        <RadioButton
                                            x:Name="RadioFilterApps"
                                            Margin="3,0,0,6"
                                            Checked="RadioFilter_Checked"
                                            Content="{DynamicResource Str_ProcessKiller_FilterApps}"
                                            GroupName="PkFilter"
                                            controls:ChoiceIcon.Kind="ApplicationOutline"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            ToolTip="{DynamicResource Str_ProcessKiller_FilterAppsTooltip}" />
                                        <RadioButton
                                            x:Name="RadioFilterBackground"
                                            Margin="0,0,3,0"
                                            Checked="RadioFilter_Checked"
                                            Content="{DynamicResource Str_ProcessKiller_FilterBackground}"
                                            GroupName="PkFilter"
                                            controls:ChoiceIcon.Kind="CogOutline"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            ToolTip="{DynamicResource Str_ProcessKiller_FilterBackgroundTooltip}" />
                                        <RadioButton
                                            x:Name="RadioFilterWindows"
                                            Margin="3,0,0,0"
                                            Checked="RadioFilter_Checked"
                                            Content="{DynamicResource Str_ProcessKiller_FilterWindows}"
                                            GroupName="PkFilter"
                                            controls:ChoiceIcon.Kind="MicrosoftWindows"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            ToolTip="{DynamicResource Str_ProcessKiller_FilterWindowsTooltip}" />
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!--  ============ LOCKED FILE ============  -->
                            <Border ctl:Tour.Key="Str_Tour_ProcessKiller_Locked" ctl:Tour.Order="3" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_ProcessKiller_LockHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.FileLockOutline}" />
                                    <Border
                                        x:Name="DropArea"
                                        Padding="10,14"
                                        AllowDrop="True"
                                        Background="{DynamicResource SidebarInputBg}"
                                        BorderBrush="{DynamicResource SidebarInputBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        Cursor="Hand"
                                        DragLeave="DropArea_DragLeave"
                                        DragOver="DropArea_DragOver"
                                        Drop="DropArea_Drop"
                                        MouseLeftButtonUp="DropArea_MouseLeftButtonUp"
                                        ToolTip="{DynamicResource Str_ProcessKiller_LockTooltip}">
                                        <StackPanel HorizontalAlignment="Center">
                                            <materialDesign:PackIcon
                                                Width="20"
                                                Height="20"
                                                HorizontalAlignment="Center"
                                                Foreground="{DynamicResource SidebarTextMuted}"
                                                Kind="{x:Static materialDesign:PackIconKind.TrayArrowDown}" />
                                            <TextBlock
                                                Margin="0,6,0,0"
                                                HorizontalAlignment="Center"
                                                FontSize="11"
                                                Foreground="{DynamicResource SidebarTextMuted}"
                                                Text="{DynamicResource Str_ProcessKiller_LockHint}"
                                                TextAlignment="Center"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!--  ============ REFRESH ============  -->
                            <Border Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_ProcessKiller_RefreshHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.Refresh}" />
                                    <TextBlock
                                        Margin="2,8,0,4"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource SidebarText}"
                                        Text="{DynamicResource Str_ProcessKiller_EveryLabel}" />
                                    <UniformGrid Columns="3">
                                        <RadioButton
                                            x:Name="RadioRefresh1"
                                            Margin="0,0,3,0"
                                            Checked="RadioRefresh_Checked"
                                            Content="1 s"
                                            GroupName="PkRefresh"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="1" />
                                        <RadioButton
                                            x:Name="RadioRefresh2"
                                            Margin="3,0"
                                            Checked="RadioRefresh_Checked"
                                            Content="2 s"
                                            GroupName="PkRefresh"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="2" />
                                        <RadioButton
                                            x:Name="RadioRefresh5"
                                            Margin="3,0,0,0"
                                            Checked="RadioRefresh_Checked"
                                            Content="5 s"
                                            GroupName="PkRefresh"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="5" />
                                    </UniformGrid>
                                    <RadioButton
                                        x:Name="RadioRefresh0"
                                        Margin="0,6,0,0"
                                        Checked="RadioRefresh_Checked"
                                        GroupName="PkRefresh"
                                        Style="{StaticResource ModeToggleButtonStyle}"
                                        Tag="0"
                                        ToolTip="{DynamicResource Str_ProcessKiller_PausedTooltip}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon
                                                Width="15"
                                                Height="15"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Kind="Pause" />
                                            <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_ProcessKiller_PauseLabel}" />
                                        </StackPanel>
                                    </RadioButton>
                                    <Button
                                        x:Name="BtnRefreshNow"
                                        MinHeight="36"
                                        Margin="0,10,0,0"
                                        Click="BtnRefreshNow_Click"
                                        Style="{StaticResource SegmentedActionButtonStyle}"
                                        ToolTip="{DynamicResource Str_ProcessKiller_RefreshNowTooltip}">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon
                                                Width="16"
                                                Height="16"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Kind="Refresh" />
                                            <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_ProcessKiller_RefreshNow}" />
                                        </StackPanel>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!--  ============ SAFETY ============  -->
                            <Border Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_ProcessKiller_SafetyHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.ShieldCheckOutline}" />
                                    <CheckBox
                                        x:Name="ChkAskSingle"
                                        Margin="0,4,0,0"
                                        Checked="ChkAskSingle_Changed"
                                        Content="{DynamicResource Str_ProcessKiller_AskSingle}"
                                        Foreground="{DynamicResource SidebarText}"
                                        Unchecked="ChkAskSingle_Changed"
                                        controls:ChoiceIcon.Kind="HelpCircleOutline"
                                        Style="{StaticResource ToggleChipCheckBoxStyle}" />
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--  ================= MAIN AREA =================  -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  ================= SEARCH =================  -->
                <Border
                    ctl:Tour.Key="Str_Tour_ProcessKiller_Search"
                    ctl:Tour.Order="1"
                    Grid.Row="0"
                    Margin="0,0,0,14"
                    Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="230" />
                        </Grid.ColumnDefinitions>

                        <!--  Name, PID or app  -->
                        <Border Padding="10,0,4,0" Style="{StaticResource InputBarStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon
                                    Width="18"
                                    Height="18"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource AccentColor}"
                                    Kind="{x:Static materialDesign:PackIconKind.Magnify}" />
                                <TextBox
                                    x:Name="TxtSearch"
                                    Grid.Column="1"
                                    Style="{StaticResource BareTextBox}"
                                    Tag="{DynamicResource Str_ProcessKiller_SearchPlaceholder}"
                                    TextChanged="TxtSearch_TextChanged"
                                    ToolTip="{DynamicResource Str_ProcessKiller_SearchTooltip}" />
                                <Button Padding="0"
                                    x:Name="BtnClearSearch"
                                    Grid.Column="2"
                                    Width="26"
                                    Height="26"
                                    Margin="2,3"
                                    Click="BtnClearSearch_Click"
                                    Style="{StaticResource NeutralIconButtonStyle}"
                                    Visibility="Collapsed">
                                    <materialDesign:PackIcon
                                        Width="13"
                                        Height="13"
                                        Kind="{x:Static materialDesign:PackIconKind.Close}" />
                                </Button>
                            </Grid>
                        </Border>

                        <!--  Who's using a port  -->
                        <Border
                            Grid.Column="2"
                            Padding="10,0,4,0"
                            Style="{StaticResource InputBarStyle}"
                            ToolTip="{DynamicResource Str_ProcessKiller_PortHint}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon
                                    Width="18"
                                    Height="18"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource AccentColor}"
                                    Kind="{x:Static materialDesign:PackIconKind.LanConnect}" />
                                <TextBox
                                    x:Name="TxtPort"
                                    Grid.Column="1"
                                    KeyDown="TxtPort_KeyDown"
                                    MaxLength="6"
                                    Style="{StaticResource BareTextBox}"
                                    Tag="{DynamicResource Str_ProcessKiller_PortPlaceholder}" />
                                <Button Padding="0"
                                    x:Name="BtnFindPort"
                                    Grid.Column="2"
                                    Width="28"
                                    Height="28"
                                    Margin="2,4"
                                    Click="BtnFindPort_Click"
                                    Style="{StaticResource NeutralIconButtonStyle}"
                                    ToolTip="{DynamicResource Str_ProcessKiller_PortTooltip}">
                                    <materialDesign:PackIcon
                                        Width="15"
                                        Height="15"
                                        Kind="{x:Static materialDesign:PackIconKind.ArrowRight}" />
                                </Button>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>

                <!--  ================= ELEVATION BANNER =================  -->
                <controls:ElevationBannerCard
                    x:Name="ElevationBanner"
                    Grid.Row="1"
                    Margin="0,0,0,14"
                    MessageKey="Str_ProcessKiller_AdminWarning"
                    TitleKey="Str_ProcessKiller_AdminTitle" />

                <!--  ================= PROCESS LIST =================  -->
                <Border ctl:Tour.Key="Str_Tour_ProcessKiller_List" ctl:Tour.Order="4" Grid.Row="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                        <!--  Header + live pills  -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentControl
                                VerticalAlignment="Center"
                                Content="{DynamicResource Str_ProcessKiller_ProcessesHeader}"
                                Style="{StaticResource CardHeader}"
                                Tag="{x:Static materialDesign:PackIconKind.Memory}" />

                            <WrapPanel
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center">
                                <Border
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource RowBg}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    ToolTip="{DynamicResource Str_ProcessKiller_CountTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.FormatListBulleted}" Style="{StaticResource PillIcon}" />
                                        <TextBlock x:Name="TxtCount" Style="{StaticResource PillText}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource RowBg}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    ToolTip="{DynamicResource Str_ProcessKiller_CpuTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.Chip}" Style="{StaticResource PillIcon}" />
                                        <TextBlock x:Name="TxtTotalCpu" Style="{StaticResource PillText}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource RowBg}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    ToolTip="{DynamicResource Str_ProcessKiller_MemoryTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.Memory}" Style="{StaticResource PillIcon}" />
                                        <TextBlock x:Name="TxtTotalMemory" Style="{StaticResource PillText}" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <Border
                                x:Name="BorderStatus"
                                Grid.Column="2"
                                MaxWidth="420"
                                VerticalAlignment="Center"
                                Background="{DynamicResource RowBg}"
                                Style="{StaticResource IconStatusPillStyle}"
                                Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        x:Name="IconStatus"
                                        Width="13"
                                        Height="13"
                                        Margin="0,0,5,0"
                                        VerticalAlignment="Center"
                                        Foreground="{Binding Foreground, ElementName=TxtStatus}"
                                        Kind="{x:Static materialDesign:PackIconKind.CheckCircleOutline}" />
                                    <TextBlock
                                        x:Name="TxtStatus"
                                        FontSize="11.5"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextSecondary}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </Grid>

                    <!--  "Showing only what uses port N / file X" banner  -->
                    <Border
                        x:Name="FocusBanner"
                        Grid.Row="1"
                        Margin="0,0,0,10"
                        Padding="12,8"
                        Background="{DynamicResource StatusInfoBg}"
                        CornerRadius="8"
                        Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon
                                x:Name="IconFocus"
                                Width="16"
                                Height="16"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource StatusInfoFg}"
                                Kind="{x:Static materialDesign:PackIconKind.FilterOutline}" />
                            <TextBlock
                                x:Name="TxtFocus"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource StatusInfoFg}"
                                TextWrapping="Wrap" />
                            <Button
                                x:Name="BtnClearFocus"
                                Grid.Column="2"
                                Margin="10,0,0,0"
                                Click="BtnClearFocus_Click"
                                Style="{StaticResource PrimaryButtonStyle}">
                                <Grid HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon
                                        Grid.Column="0"
                                        Width="14"
                                        Height="14"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Kind="{x:Static materialDesign:PackIconKind.FilterRemoveOutline}" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_ProcessKiller_ShowAll}" TextWrapping="Wrap" />
                                </Grid>
                            </Button>
                        </Grid>
                    </Border>

                    <!--  Process list  -->
                    <DataGrid
                        x:Name="GridProcesses"
                        Grid.Row="2"
                        AutoGenerateColumns="False"
                        CanUserAddRows="False"
                        CanUserReorderColumns="False"
                        FontSize="12"
                        IsReadOnly="True"
                        MouseDoubleClick="GridProcesses_MouseDoubleClick"
                        PreviewMouseRightButtonDown="GridProcesses_PreviewMouseRightButtonDown"
                        MinRowHeight="34"
                        SelectionChanged="GridProcesses_SelectionChanged"
                        SelectionMode="Extended"
                        Sorting="GridProcesses_Sorting"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.ScrollUnit="Pixel"
                        VirtualizingPanel.VirtualizationMode="Recycling">
                        <DataGrid.ContextMenu>
                            <ContextMenu x:Name="RowMenu" Opened="RowMenu_Opened">
                                <MenuItem
                                    x:Name="MenuEnd"
                                    Click="MenuEnd_Click"
                                    Header="{DynamicResource Str_ProcessKiller_EndProcess}"
                                    InputGestureText="Del">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.CloseCircleOutline}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem
                                    x:Name="MenuEndTree"
                                    Click="MenuEndTree_Click"
                                    Header="{DynamicResource Str_ProcessKiller_EndTree}"
                                    InputGestureText="Shift+Del">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.FileTreeOutline}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <Separator />
                                <MenuItem
                                    x:Name="MenuOpenLocation"
                                    Click="MenuOpenLocation_Click"
                                    Header="{DynamicResource Str_ProcessKiller_OpenLocation}">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.FolderOpenOutline}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Click="MenuCopyName_Click" Header="{DynamicResource Str_ProcessKiller_CopyName}">
                                    <MenuItem.Icon>
                                        <materialDesign:PackIcon Kind="{x:Static materialDesign:PackIconKind.ContentCopy}" />
                                    </MenuItem.Icon>
                                </MenuItem>
                                <MenuItem Click="MenuCopyPid_Click" Header="{DynamicResource Str_ProcessKiller_CopyPid}" />
                                <MenuItem
                                    x:Name="MenuCopyPath"
                                    Click="MenuCopyPath_Click"
                                    Header="{DynamicResource Str_ProcessKiller_CopyPath}" />
                            </ContextMenu>
                        </DataGrid.ContextMenu>
                        <DataGrid.Columns>
                            <DataGridTemplateColumn
                                Width="2.4*"
                                MinWidth="90"
                                CellTemplate="{StaticResource NameCellTemplate}"
                                Header="{DynamicResource Str_ProcessKiller_ColName}"
                                SortMemberPath="Name" />
                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding Pid}"
                                ElementStyle="{StaticResource MutedCell}"
                                Header="{DynamicResource Str_ProcessKiller_Pid}"
                                SortMemberPath="Pid" />
                            <DataGridTemplateColumn
                                Width="100"
                                CellTemplate="{StaticResource KindCellTemplate}"
                                Header="{DynamicResource Str_ProcessKiller_ColKind}"
                                SortMemberPath="Kind" />
                            <DataGridTextColumn
                                Width="70"
                                Binding="{Binding CpuText}"
                                ElementStyle="{StaticResource RightCell}"
                                Header="{DynamicResource Str_ProcessKiller_ColCpu}"
                                SortMemberPath="CpuPercent" />
                            <DataGridTextColumn
                                Width="92"
                                Binding="{Binding MemoryText}"
                                ElementStyle="{StaticResource RightCell}"
                                Header="{DynamicResource Str_ProcessKiller_ColMemory}"
                                SortMemberPath="MemoryBytes" />
                            <DataGridTextColumn
                                Width="72"
                                Binding="{Binding Threads}"
                                ElementStyle="{StaticResource RightCell}"
                                Header="{DynamicResource Str_ProcessKiller_ColThreads}"
                                SortMemberPath="Threads" />
                            <DataGridTextColumn
                                Width="110"
                                Binding="{Binding OwnerText}"
                                ElementStyle="{StaticResource MutedCell}"
                                Header="{DynamicResource Str_ProcessKiller_ColUser}"
                                SortMemberPath="OwnerText" />
                            <DataGridTextColumn
                                Width="2.6*"
                                Binding="{Binding Path}"
                                ElementStyle="{StaticResource MutedCell}"
                                Header="{DynamicResource Str_ProcessKiller_ColPath}"
                                SortMemberPath="Path" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <!--  Nothing matches  -->
                    <StackPanel
                        x:Name="EmptyPanel"
                        Grid.Row="2"
                        Margin="0,60,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        IsHitTestVisible="False"
                        Visibility="Collapsed">
                        <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.MagnifyRemoveOutline}" />
                        <TextBlock
                            x:Name="TxtEmpty"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Center"
                            FontSize="14"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimary}"
                            Text="{DynamicResource Str_ProcessKiller_NoMatch}" />
                    </StackPanel>

                    <!--  Details of the one selected process  -->
                    <Border
                        x:Name="DetailsPanel"
                        Grid.Row="3"
                        Margin="0,12,0,0"
                        Padding="14,10,14,4"
                        Background="{DynamicResource RowBg}"
                        CornerRadius="8"
                        Visibility="Collapsed">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="24" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Style="{StaticResource DetailLabel}" Text="{DynamicResource Str_ProcessKiller_ColPath}" />
                            <Grid Grid.Column="1">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtDetailPath" Style="{StaticResource DetailValue}" />
                                <Button Padding="0"
                                    x:Name="BtnOpenLocation"
                                    Grid.Column="1"
                                    Width="24"
                                    Height="24"
                                    Margin="6,-4,0,2"
                                    Click="BtnOpenLocation_Click"
                                    Style="{StaticResource NeutralIconButtonStyle}"
                                    ToolTip="{DynamicResource Str_ProcessKiller_OpenLocation}">
                                    <materialDesign:PackIcon
                                        Width="13"
                                        Height="13"
                                        Kind="{x:Static materialDesign:PackIconKind.FolderOpenOutline}" />
                                </Button>
                            </Grid>

                            <TextBlock
                                Grid.Column="3"
                                Style="{StaticResource DetailLabel}"
                                Text="{DynamicResource Str_ProcessKiller_Parent}" />
                            <TextBox
                                x:Name="TxtDetailParent"
                                Grid.Column="4"
                                Style="{StaticResource DetailValue}" />

                            <TextBlock
                                Grid.Row="1"
                                Style="{StaticResource DetailLabel}"
                                Text="{DynamicResource Str_ProcessKiller_Window}" />
                            <TextBox
                                x:Name="TxtDetailWindow"
                                Grid.Row="1"
                                Grid.Column="1"
                                Style="{StaticResource DetailValue}" />

                            <TextBlock
                                Grid.Row="1"
                                Grid.Column="3"
                                Style="{StaticResource DetailLabel}"
                                Text="{DynamicResource Str_ProcessKiller_Started}" />
                            <TextBox
                                x:Name="TxtDetailStarted"
                                Grid.Row="1"
                                Grid.Column="4"
                                Style="{StaticResource DetailValue}" />

                            <TextBlock
                                Grid.Row="2"
                                Style="{StaticResource DetailLabel}"
                                Text="{DynamicResource Str_ProcessKiller_CommandLine}" />
                            <TextBox
                                x:Name="TxtDetailCommand"
                                Grid.Row="2"
                                Grid.Column="1"
                                Grid.ColumnSpan="4"
                                FontFamily="Consolas"
                                Style="{StaticResource DetailValue}" />
                        </Grid>
                    </Border>

                    <!--  Actions  -->
                    <Grid Grid.Row="4" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="TxtSelection"
                            VerticalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource TextSecondary}"
                            Text="{DynamicResource Str_ProcessKiller_SelectHint}"
                            TextTrimming="CharacterEllipsis" />
                        <Button
                            x:Name="BtnEndTree"
                            Grid.Column="1"
                            Margin="10,0,0,0"
                            Click="BtnEndTree_Click"
                            IsEnabled="False"
                            ToolTip="{DynamicResource Str_ProcessKiller_EndTreeTooltip}">
                            <Grid HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon
                                    Grid.Column="0"
                                    Width="15"
                                    Height="15"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Kind="{x:Static materialDesign:PackIconKind.FileTreeOutline}" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_ProcessKiller_EndTree}" TextWrapping="Wrap" />
                            </Grid>
                        </Button>
                        <Button
                            ctl:Tour.Key="Str_Tour_ProcessKiller_End"
                            ctl:Tour.Order="5"
                            x:Name="BtnEnd"
                            Grid.Column="2"
                            Margin="8,0,0,0"
                            Click="BtnEnd_Click"
                            IsEnabled="False"
                            Style="{StaticResource DangerButtonStyle}"
                            ToolTip="{DynamicResource Str_ProcessKiller_EndTooltip}">
                            <Grid HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon
                                    Grid.Column="0"
                                    Width="15"
                                    Height="15"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Kind="{x:Static materialDesign:PackIconKind.CloseCircleOutline}" />
                                <TextBlock
                                    Grid.Column="1"
                                    x:Name="TxtEndLabel"
                                    VerticalAlignment="Center"
                                    Text="{DynamicResource Str_ProcessKiller_EndProcess}" TextWrapping="Wrap" />
                            </Grid>
                        </Button>
                    </Grid>
                </Grid>
            </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
