<UserControl
    x:Class="Smart_Tools.WPF.Views.HardwareSensorsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:models="clr-namespace:Smart_Tools.WPF.Models"
    x:Name="Root"
    Loaded="Root_Loaded"
    Unloaded="Root_Unloaded">

    <!--
        Hardware Sensors - every sensor LibreHardwareMonitor can see, part by
        part: temperatures, loads, clocks, fans, voltages, power, drive data.
        Backend: Controllers/HardwareSensorsManager.cs (reads the library on its
        own thread), HardwareSensorsManager.Format.cs (units, levels, headline
        picks, parts, report, settings); Models/HardwareSensorsModel.cs;
        Controls/SystemMonitorSparkline.cs (the little graphs).
        This file and the code-behind are UI only.
    -->

    <UserControl.Resources>

        <!--  The part's icon (DataContext = HardwarePartItem)  -->
        <Style x:Key="PartIcon" TargetType="materialDesign:PackIcon">
            <Setter Property="Kind" Value="Chip" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="HorizontalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Part}" Value="Cpu">
                    <Setter Property="Kind" Value="Cpu_64Bit" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Part}" Value="Gpu">
                    <Setter Property="Kind" Value="ExpansionCardVariant" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Part}" Value="Memory">
                    <Setter Property="Kind" Value="Memory" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Part}" Value="Motherboard">
                    <Setter Property="Kind" Value="DeveloperBoard" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Part}" Value="Storage">
                    <Setter Property="Kind" Value="Harddisk" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Part}" Value="Network">
                    <Setter Property="Kind" Value="Lan" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Part}" Value="Battery">
                    <Setter Property="Kind" Value="Battery" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Part}" Value="Cooler">
                    <Setter Property="Kind" Value="Fan" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Part}" Value="Psu">
                    <Setter Property="Kind" Value="PowerPlug" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Part}" Value="Pc">
                    <Setter Property="Kind" Value="DesktopTowerMonitor" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  A sensor kind's icon (DataContext has a Kind: HardwareSensorKind)  -->
        <Style x:Key="SensorKindIcon" TargetType="materialDesign:PackIcon">
            <Setter Property="Kind" Value="Gauge" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Temperature">
                    <Setter Property="Kind" Value="Thermometer" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Load">
                    <Setter Property="Kind" Value="ChartBar" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Clock">
                    <Setter Property="Kind" Value="Speedometer" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Power">
                    <Setter Property="Kind" Value="LightningBolt" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Fan">
                    <Setter Property="Kind" Value="Fan" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Control">
                    <Setter Property="Kind" Value="Fan" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Voltage">
                    <Setter Property="Kind" Value="Flash" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Current">
                    <Setter Property="Kind" Value="SineWave" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Data">
                    <Setter Property="Kind" Value="Database" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="SmallData">
                    <Setter Property="Kind" Value="Memory" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Throughput">
                    <Setter Property="Kind" Value="SwapHorizontal" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Level">
                    <Setter Property="Kind" Value="PercentOutline" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Frequency">
                    <Setter Property="Kind" Value="Waves" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Energy">
                    <Setter Property="Kind" Value="BatteryCharging" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="TimeSpan">
                    <Setter Property="Kind" Value="Timer" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Flow">
                    <Setter Property="Kind" Value="WaterPump" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  A part in the list: rounded, accent bar and tint when chosen  -->
        <Style x:Key="PartItemStyle" TargetType="ListBoxItem">
            <Setter Property="Margin" Value="0,0,0,4" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
                            x:Name="Bd"
                            Padding="8"
                            Background="Transparent"
                            CornerRadius="8">
                            <Grid>
                                <Border
                                    x:Name="Bar"
                                    Width="3"
                                    Margin="-8,6,0,6"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentColor}"
                                    CornerRadius="2"
                                    Visibility="Collapsed" />
                                <ContentPresenter />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowBg}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentColorSubtle}" />
                                <Setter TargetName="Bar" Property="Visibility" Value="Visible" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="PartItemTemplate" DataType="{x:Type models:HardwarePartItem}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid Margin="0,0,10,0">
                    <Border
                        Width="34"
                        Height="34"
                        Background="{DynamicResource AccentColorSubtle}"
                        CornerRadius="9">
                        <materialDesign:PackIcon
                            Width="18"
                            Height="18"
                            Foreground="{DynamicResource AccentColor}"
                            Style="{StaticResource PartIcon}" />
                    </Border>
                    <Border
                        x:Name="Dot"
                        Width="11"
                        Height="11"
                        Margin="0,0,-3,-3"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Bottom"
                        Background="{DynamicResource StatusSuccessFg}"
                        BorderBrush="{DynamicResource ContentBg}"
                        BorderThickness="2"
                        CornerRadius="6"
                        Visibility="Collapsed" />
                </Grid>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="12.5"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding Name}" />
                    <TextBlock
                        Margin="0,1,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource TextSecondary}"
                        Text="{Binding Summary}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Warm">
                    <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Dot" Property="Background" Value="{DynamicResource StatusWarningFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Hot">
                    <Setter TargetName="Dot" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Dot" Property="Background" Value="{DynamicResource StatusErrorFg}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  A headline tile: label, big value, the last minute  -->
        <DataTemplate x:Key="HeadlineTemplate" DataType="{x:Type models:HardwareHeadlineTile}">
            <Border
                Width="172"
                Margin="0,0,10,10"
                Padding="12,10"
                Background="{DynamicResource RowBg}"
                CornerRadius="8">
                <StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            x:Name="Icon"
                            Width="14"
                            Height="14"
                            Margin="0,0,6,0"
                            Foreground="{DynamicResource AccentColor}"
                            Style="{StaticResource SensorKindIcon}" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource TextSecondary}"
                            Text="{Binding Label}" />
                    </StackPanel>
                    <TextBlock
                        x:Name="Value"
                        Margin="0,4,0,0"
                        FontSize="22"
                        FontWeight="Bold"
                        Foreground="{DynamicResource TextPrimary}"
                        Text="{Binding ValueText}" />
                    <controls:SystemMonitorSparkline
                        x:Name="Graph"
                        Height="34"
                        Margin="0,6,0,0"
                        Maximum="{Binding GraphMaximum}"
                        Stroke="{DynamicResource AccentColor}"
                        Values="{Binding History}" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Warm">
                    <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                    <Setter TargetName="Graph" Property="Stroke" Value="{DynamicResource StatusWarningFg}" />
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Hot">
                    <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                    <Setter TargetName="Graph" Property="Stroke" Value="{DynamicResource StatusErrorFg}" />
                    <Setter TargetName="Icon" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  One figure inside an at-a-glance tile: small label over the value (DataContext = HardwareHeadline)  -->
        <DataTemplate x:Key="GlanceFigureTemplate" DataType="{x:Type models:HardwareHeadline}">
            <StackPanel MinWidth="64" Margin="0,0,16,6">
                <TextBlock
                    FontSize="11"
                    Foreground="{DynamicResource TextSecondary}"
                    Text="{Binding Label}" />
                <TextBlock
                    x:Name="Value"
                    FontSize="14"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimary}"
                    Text="{Binding ValueText}" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Warm">
                    <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Hot">
                    <Setter TargetName="Value" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--
            A tile on the PC page (click = open that part): icon + name + every headline figure of the part.
            The icon/name row is a Grid (Auto icon column, * text column), not a horizontal StackPanel,
            so long device names trim instead of being clipped by the tile's edge.
        -->
        <DataTemplate x:Key="OverviewTileTemplate" DataType="{x:Type models:HardwarePartItem}">
            <Button
                Height="Auto"
                MinHeight="0"
                Margin="0,0,14,14"
                HorizontalContentAlignment="Stretch"
                VerticalContentAlignment="Top"
                Click="Tile_Click"
                Cursor="Hand"
                FocusVisualStyle="{x:Null}"
                OverridesDefaultStyle="True"
                ToolTip="{Binding Name}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Padding="16,14"
                            Background="{DynamicResource RowBg}"
                            CornerRadius="12">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentColorSubtle}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="32"
                            Height="32"
                            Margin="0,0,10,0"
                            VerticalAlignment="Top"
                            Background="{DynamicResource AccentColorSubtle}"
                            CornerRadius="9">
                            <materialDesign:PackIcon
                                Width="17"
                                Height="17"
                                Foreground="{DynamicResource AccentColor}"
                                Style="{StaticResource PartIcon}" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextPrimary}"
                                Text="{Binding Name}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Margin="0,1,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="{Binding PartTitle}" />
                        </StackPanel>
                    </Grid>
                    <ItemsControl
                        Margin="0,10,0,0"
                        Focusable="False"
                        IsHitTestVisible="False"
                        ItemTemplate="{StaticResource GlanceFigureTemplate}"
                        ItemsSource="{Binding Headlines}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                </StackPanel>
            </Button>
        </DataTemplate>

        <!--  One sensor row: name, now (coloured by level), low, high  -->
        <DataTemplate x:Key="SensorRowTemplate" DataType="{x:Type models:HardwareSensorRow}">
            <Border
                x:Name="RowBd"
                Padding="8,4"
                Background="Transparent"
                CornerRadius="6">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextPrimary}"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding Name}" />
                    <TextBlock
                        x:Name="Now"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        Text="{Binding ValueText}" />
                    <TextBlock
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="11.5"
                        Foreground="{DynamicResource TextSecondary}"
                        Text="{Binding MinText}" />
                    <TextBlock
                        Grid.Column="3"
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="11.5"
                        Foreground="{DynamicResource TextSecondary}"
                        Text="{Binding MaxText}" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <Trigger SourceName="RowBd" Property="IsMouseOver" Value="True">
                    <Setter TargetName="RowBd" Property="Background" Value="{DynamicResource RowBg}" />
                </Trigger>
                <DataTrigger Binding="{Binding Level}" Value="Warm">
                    <Setter TargetName="Now" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Hot">
                    <Setter TargetName="Now" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  A group of sensors of one kind  -->
        <DataTemplate x:Key="SensorGroupTemplate" DataType="{x:Type models:HardwareSensorGroup}">
            <StackPanel Margin="0,0,0,16">
                <Grid Margin="0,0,0,4">
                    <StackPanel Orientation="Horizontal">
                        <Border
                            Width="26"
                            Height="26"
                            Margin="0,0,8,0"
                            Background="{DynamicResource AccentColorSubtle}"
                            CornerRadius="7">
                            <materialDesign:PackIcon
                                Width="14"
                                Height="14"
                                HorizontalAlignment="Center"
                                Foreground="{DynamicResource AccentColor}"
                                Style="{StaticResource SensorKindIcon}" />
                        </Border>
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimary}"
                            Text="{Binding Title}" />
                        <TextBlock
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{DynamicResource TextSecondary}"
                            Text="{Binding CountText}" />
                    </StackPanel>
                </Grid>
                <Grid Margin="8,2,8,2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="100" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        FontSize="11"
                        Foreground="{DynamicResource TextSecondary}"
                        Text="{DynamicResource Str_HardwareSensors_Sensor}" />
                    <TextBlock
                        Grid.Column="1"
                        FontSize="11"
                        Foreground="{DynamicResource TextSecondary}"
                        Text="{DynamicResource Str_HardwareSensors_Now}" />
                    <TextBlock
                        Grid.Column="2"
                        FontSize="11"
                        Foreground="{DynamicResource TextSecondary}"
                        Text="{DynamicResource Str_HardwareSensors_Lowest}" />
                    <TextBlock
                        Grid.Column="3"
                        FontSize="11"
                        Foreground="{DynamicResource TextSecondary}"
                        Text="{DynamicResource Str_HardwareSensors_Highest}" />
                </Grid>
                <ItemsControl
                    Focusable="False"
                    ItemTemplate="{StaticResource SensorRowTemplate}"
                    ItemsSource="{Binding Rows}" />
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">

        <!--  No page header: MainWindow's header card shows the tool's icon and name.  -->

        <Grid Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OptionsColumn" Width="280" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= SIDEBAR =================  -->

            <Border Grid.Column="0" Style="{StaticResource SidebarPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Button
                            x:Name="BtnCollapseOptions"
                            MinHeight="45"
                            HorizontalContentAlignment="Left"
                            Click="BtnCollapseOptions_Click"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Foreground="{DynamicResource SidebarText}"
                            ToolTip="{DynamicResource Str_Common_SidebarToggleTooltip}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="OverridesDefaultStyle" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Margin="16,0,0,0" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Kind="TuneVariant" />
                                <TextBlock
                                    x:Name="TxtOptionsHeaderLabel"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{DynamicResource Str_Common_OptionsLabel}" />
                            </StackPanel>
                        </Button>
                        <Separator
                            x:Name="SepHeader"
                            Margin="16,4"
                            Style="{StaticResource SidebarSeparatorStyle}" />
                    </StackPanel>

                    <ScrollViewer
                        x:Name="OptionsScrollViewer"
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16">

                            <!--  ============ REFRESH ============  -->
                            <Border ctl:Tour.Key="Str_Tour_HardwareSensors_Refresh" ctl:Tour.Order="3" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <ContentControl
                                            Content="{DynamicResource Str_Network_Refresh}"
                                            Style="{StaticResource SidebarGroupHeader}"
                                            Tag="{x:Static materialDesign:PackIconKind.TimerSyncOutline}" />
                                        <Border
                                            x:Name="LiveDot"
                                            Width="9"
                                            Height="9"
                                            Margin="0,4,2,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Background="{DynamicResource StatusSuccessFg}"
                                            CornerRadius="5"
                                            RenderTransformOrigin="0.5,0.5"
                                            ToolTip="{DynamicResource Str_HardwareSensors_Live}" />
                                    </Grid>
                                    <UniformGrid x:Name="RefreshChips" Columns="4">
                                        <RadioButton
                                            Margin="0,0,2,0"
                                            Click="Refresh_Click"
                                            Content="½ s"
                                            GroupName="SensorsRefresh"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="500"
                                            ToolTip="{DynamicResource Str_HardwareSensors_TwiceASecond}" />
                                        <RadioButton
                                            Margin="2,0"
                                            Click="Refresh_Click"
                                            Content="1 s"
                                            GroupName="SensorsRefresh"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="1000" />
                                        <RadioButton
                                            Margin="2,0"
                                            Click="Refresh_Click"
                                            Content="2 s"
                                            GroupName="SensorsRefresh"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="2000" />
                                        <RadioButton
                                            Margin="2,0,0,0"
                                            Click="Refresh_Click"
                                            Content="5 s"
                                            GroupName="SensorsRefresh"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="5000"
                                            ToolTip="{DynamicResource Str_HardwareSensors_LightestOnThePc}" />
                                    </UniformGrid>
                                    <Button
                                        x:Name="BtnPause"
                                        MinHeight="36"
                                        Margin="0,10,0,0"
                                        HorizontalAlignment="Stretch"
                                        Click="BtnPause_Click"
                                        Style="{StaticResource PrimaryButtonStyle}">
                                        <Grid HorizontalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon
                                                x:Name="IconPause"
                                                Grid.Column="0"
                                                Width="16"
                                                Height="16"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Kind="Pause" />
                                            <TextBlock
                                                x:Name="TxtPause"
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Text="{DynamicResource Str_MicRecorder_Pause}"
                                                TextWrapping="Wrap" />
                                        </Grid>
                                    </Button>
                                    <TextBlock Style="{StaticResource SidebarHint}" Text="{DynamicResource Str_HardwareSensors_ReadingStopsWhileYou}" />
                                </StackPanel>
                            </Border>

                            <!--  ============ UNITS ============  -->
                            <Border ctl:Tour.Key="Str_Tour_HardwareSensors_Units" ctl:Tour.Order="4" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_DriveHealth_Temperature}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.Thermometer}" />
                                    <UniformGrid Columns="2">
                                        <RadioButton
                                            x:Name="RadioCelsius"
                                            Margin="0,0,2,0"
                                            Click="Units_Click"
                                            Content="°C"
                                            GroupName="SensorsUnits"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleButtonStyle}" />
                                        <RadioButton
                                            x:Name="RadioFahrenheit"
                                            Margin="2,0,0,0"
                                            Click="Units_Click"
                                            Content="°F"
                                            GroupName="SensorsUnits"
                                            Style="{StaticResource ModeToggleButtonStyle}" />
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!--  ============ REPORT ============  -->
                            <Border ctl:Tour.Key="Str_Tour_HardwareSensors_Report" ctl:Tour.Order="5" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_HardwareSensors_Report}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.FileDocumentOutline}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <controls:ExportButton
                                            x:Name="BtnSaveReport"
                                            IsEnabled="False"
                                            ToolTip="{DynamicResource Str_HardwareSensors_SaveEverySensorAs}">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Click="BtnSaveReport_Click" Header="{DynamicResource Str_Common_ExportAsHtml}" Tag="html">
                                                        <MenuItem.Icon>
                                                            <materialDesign:PackIcon Kind="Web" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Click="BtnSaveReport_Click" Header="{DynamicResource Str_Common_ExportAsPdf}" Tag="pdf">
                                                        <MenuItem.Icon>
                                                            <materialDesign:PackIcon Kind="FilePdfBox" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem Click="BtnSaveReport_Click" Header="{DynamicResource Str_Common_ExportAsText}" Tag="txt">
                                                        <MenuItem.Icon>
                                                            <materialDesign:PackIcon Kind="FileDocumentOutline" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </controls:ExportButton>
                                        <Button
                                            x:Name="BtnCopyReport"
                                            Grid.Column="1"
                                            Margin="6,0,0,0"
                                            Click="BtnCopyReport_Click"
                                            IsEnabled="False"
                                            Style="{StaticResource ListToolButtonStyle}"
                                            ToolTip="{DynamicResource Str_HardwareSensors_CopyTheReportTo}">
                                            <materialDesign:PackIcon
                                                x:Name="IconCopy"
                                                Width="16"
                                                Height="16"
                                                Kind="ContentCopy" />
                                        </Button>
                                    </Grid>
                                    <TextBlock Style="{StaticResource SidebarHint}" Text="{DynamicResource Str_HardwareSensors_EveryPartAndSensor}" />
                                </StackPanel>
                            </Border>

                            <Border
                                x:Name="CoverageCard"
                                Margin="0,0,0,12"
                                Padding="12,10"
                                Background="{DynamicResource StatusWarningBg}"
                                CornerRadius="8"
                                Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Margin="0,1,8,0"
                                        Foreground="{DynamicResource StatusWarningFg}"
                                        Kind="ThermometerAlert" />
                                    <TextBlock
                                        x:Name="TxtCoverage"
                                        Grid.Column="1"
                                        FontSize="11"
                                        Foreground="{DynamicResource StatusWarningFg}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </Border>
                            <TextBlock
                                Margin="4,0,4,0"
                                Style="{StaticResource SidebarHint}"
                                Text="{DynamicResource Str_HardwareSensors_WhichSensorsAppearDepends}" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--  ================= MAIN =================  -->

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  ================= ELEVATION BANNER =================  -->
                <!--  The shared "needs administrator" card (restart through UAC); the border below is only the PawnIO driver note for an elevated session.  -->
                <controls:ElevationBannerCard
                    x:Name="AdminBanner"
                    Margin="0,0,0,12"
                    MessageKey="Str_HardwareSensors_AdminWarning"
                    TitleKey="Str_HardwareSensors_AdminTitle" />
                <Border
                    x:Name="ElevationBanner"
                    Margin="0,0,0,12"
                    Padding="14,12"
                    Background="{DynamicResource StatusWarningBg}"
                    CornerRadius="12"
                    Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border
                            Width="34"
                            Height="34"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource CardBg}"
                            CornerRadius="10">
                            <materialDesign:PackIcon
                                Width="18"
                                Height="18"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource StatusWarningFg}"
                                Kind="ShieldLockOutline" />
                        </Border>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                x:Name="TxtBannerTitle"
                                FontSize="12.5"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource StatusWarningFg}"
                                Text="{DynamicResource Str_HardwareSensors_AdminTitle}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                x:Name="TxtBannerText"
                                Margin="0,2,0,0"
                                FontSize="11.5"
                                Foreground="{DynamicResource StatusWarningFg}"
                                Text="{DynamicResource Str_HardwareSensors_AdminWarning}"
                                TextWrapping="Wrap" />
                        </StackPanel>

                        <Button
                            x:Name="BtnBannerAction"
                            Grid.Column="2"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            Click="BtnBannerAction_Click"
                            Style="{StaticResource PrimaryButtonStyle}"
                            ToolTip="{DynamicResource Str_DriveHealth_RestartAsAdminTooltip}">
                            <Grid HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon
                                    x:Name="IconBannerAction"
                                    Grid.Column="0"
                                    Width="15"
                                    Height="15"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Kind="ShieldAccount" />
                                <TextBlock
                                    x:Name="TxtBannerAction"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="{DynamicResource Str_DriveHealth_RestartAsAdmin}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Button>

                        <Button
                            x:Name="BtnDismissBanner"
                            Grid.Column="3"
                            Width="28"
                            Height="28"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Click="BtnDismissBanner_Click"
                            Style="{StaticResource NeutralIconButtonStyle}"
                            ToolTip="{DynamicResource Str_HardwareSensors_HideBanner}">
                            <materialDesign:PackIcon
                                Width="14"
                                Height="14"
                                Kind="Close" />
                        </Button>
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="250" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  ============ PART LIST ============  -->
                    <Border ctl:Tour.Key="Str_Tour_HardwareSensors_Parts" ctl:Tour.Order="1" Padding="8" Style="{StaticResource CardStyle}">
                        <ListBox
                            x:Name="PartList"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemContainerStyle="{StaticResource PartItemStyle}"
                            ItemTemplate="{StaticResource PartItemTemplate}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            SelectionChanged="PartList_SelectionChanged"
                            SelectionMode="Single" />
                    </Border>

                    <!--  ============ DETAIL ============  -->
                    <Border ctl:Tour.Key="Str_Tour_HardwareSensors_Detail" ctl:Tour.Order="2" Grid.Column="2" Style="{StaticResource CardStyle}">
                        <Grid>
                            <ScrollViewer
                                x:Name="DetailScroll"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto"
                                Visibility="Collapsed">
                                <StackPanel x:Name="DetailPanel">
                                    <TextBlock
                                        x:Name="TxtPausedNote"
                                        Margin="0,0,0,8"
                                        FontSize="11.5"
                                        Foreground="{DynamicResource StatusWarningFg}"
                                        TextWrapping="Wrap"
                                        Visibility="Collapsed" />
                                    <Grid Margin="0,0,0,14">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border
                                            x:Name="HeaderChip"
                                            Width="40"
                                            Height="40"
                                            Margin="0,0,12,0"
                                            Background="{DynamicResource AccentGradient}"
                                            CornerRadius="11"
                                            RenderTransformOrigin="0.5,0.5">
                                            <materialDesign:PackIcon
                                                Width="21"
                                                Height="21"
                                                Foreground="White"
                                                Style="{StaticResource PartIcon}" />
                                        </Border>
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock
                                                FontSize="20"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource TextPrimary}"
                                                Text="{Binding Name}"
                                                TextTrimming="CharacterEllipsis"
                                                ToolTip="{Binding Name}" />
                                            <TextBlock
                                                x:Name="TxtPartKind"
                                                Margin="0,2,0,0"
                                                FontSize="11.5"
                                                Foreground="{DynamicResource TextSecondary}" />
                                        </StackPanel>
                                        <Border
                                            Grid.Column="2"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource RowBg}"
                                            Style="{StaticResource IconStatusPillStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="13"
                                                    Height="13"
                                                    Margin="0,0,5,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource TextSecondary}"
                                                    Kind="Gauge" />
                                                <TextBlock
                                                    x:Name="TxtSensorCount"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource TextSecondary}" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <ItemsControl
                                        x:Name="HeadlineTiles"
                                        Focusable="False"
                                        ItemTemplate="{StaticResource HeadlineTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>

                                    <!--  PC: every other part at a glance  -->
                                    <StackPanel x:Name="OverviewBlock" Visibility="Collapsed">
                                        <TextBlock
                                            Margin="0,6,0,8"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextPrimary}"
                                            Text="{DynamicResource Str_SystemMonitor_AtAGlance}" />
                                        <ItemsControl
                                            x:Name="OverviewTiles"
                                            Margin="0,0,-14,0"
                                            Focusable="False"
                                            ItemTemplate="{StaticResource OverviewTileTemplate}">
                                            <ItemsControl.ItemsPanel>
                                                <ItemsPanelTemplate>
                                                    <UniformGrid SizeChanged="OverviewPanel_SizeChanged" />
                                                </ItemsPanelTemplate>
                                            </ItemsControl.ItemsPanel>
                                        </ItemsControl>
                                    </StackPanel>

                                    <ItemsControl
                                        x:Name="SensorGroups"
                                        Margin="0,8,0,0"
                                        Focusable="False"
                                        ItemTemplate="{StaticResource SensorGroupTemplate}" />
                                </StackPanel>
                            </ScrollViewer>

                            <!--  Starting, or nothing to show  -->
                            <StackPanel
                                x:Name="EmptyPanel"
                                MaxWidth="440"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.Thermometer}" />
                                <TextBlock
                                    x:Name="TxtEmptyTitle"
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimary}"
                                    Text="{DynamicResource Str_HardwareSensors_ReadingTheSensors}" />
                                <TextBlock
                                    x:Name="TxtEmptyHint"
                                    Margin="0,4,0,8"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{DynamicResource Str_HardwareSensors_TheFirstReadingCan}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                                <ProgressBar
                                    x:Name="EmptyProgress"
                                    Width="180"
                                    Height="4"
                                    IsIndeterminate="True" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
