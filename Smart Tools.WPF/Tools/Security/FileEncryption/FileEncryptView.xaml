<UserControl
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    x:Class="Smart_Tools.WPF.Views.FileEncryptView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:models="clr-namespace:Smart_Tools.WPF.Models"
    x:Name="Root"
    AllowDrop="True"
    DragLeave="Root_DragLeave"
    DragOver="Root_DragOver"
    Drop="Root_Drop"
    Loaded="Root_Loaded"
    SizeChanged="Root_SizeChanged">

    <!--
        Backend: Controllers/EncryptManager.cs (names, which files fit the
        mode, the grid rows, password meter, settings),
        EncryptManager.Crypto.cs (the STF2/STF3 file format),
        EncryptManager.Run.cs (folders, running a batch);
        Models/FileEncryptModel.cs. This file and the code-behind are UI only.
        Choices are read by Tag (enum name). The password is never saved.
    -->

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!--  One segment of the password meter (coloured from code with theme keys)  -->
        <Style x:Key="MeterSegmentStyle" TargetType="Border">
            <Setter Property="Height" Value="5" />
            <Setter Property="Margin" Value="0,0,4,0" />
            <Setter Property="CornerRadius" Value="3" />
            <Setter Property="Background" Value="{DynamicResource SidebarInputBorder}" />
        </Style>

        <!--  Grid: lock / file icon  -->
        <DataTemplate x:Key="KindCellTemplate" DataType="{x:Type models:EncryptItem}">
            <Border
                x:Name="Badge"
                Width="30"
                Height="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource RowBg}"
                CornerRadius="8">
                <materialDesign:PackIcon
                    x:Name="KindIcon"
                    Width="16"
                    Height="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextSecondary}"
                    Kind="FileOutline" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsEncrypted}" Value="True">
                    <Setter TargetName="Badge" Property="Background" Value="{DynamicResource AccentColorSubtle}" />
                    <Setter TargetName="KindIcon" Property="Kind" Value="FileLockOutline" />
                    <Setter TargetName="KindIcon" Property="Foreground" Value="{DynamicResource AccentColor}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  Grid: name + folder  -->
        <DataTemplate x:Key="NameCellTemplate" DataType="{x:Type models:EncryptItem}">
            <StackPanel VerticalAlignment="Center" ToolTip="{Binding FullPath}">
                <TextBlock
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimary}"
                    Text="{Binding Name}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Margin="0,1,0,0"
                    FontSize="11"
                    Foreground="{DynamicResource TextSecondary}"
                    Text="{Binding Folder}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <!--  Grid: what it becomes  -->
        <DataTemplate x:Key="OutputCellTemplate" DataType="{x:Type models:EncryptItem}">
            <Grid
                x:Name="OutputPanel"
                VerticalAlignment="Center"
                
                ToolTip="{Binding OutputPath}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <materialDesign:PackIcon
                    Grid.Column="0"
                    Width="14"
                    Height="14"
                    Margin="0,0,6,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextSecondary}"
                    Kind="ArrowRight" />
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextPrimary}"
                    Text="{Binding OutputName}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Skipped">
                    <Setter TargetName="OutputPanel" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  Grid: status chip (+ live progress). Replaces the brushes that were hard-coded in EncryptItem.  -->
        <DataTemplate x:Key="StatusCellTemplate" DataType="{x:Type models:EncryptItem}">
            <StackPanel VerticalAlignment="Center" ToolTip="{Binding Message}">
                <Border
                    x:Name="Chip"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource StatusInfoBg}"
                    Style="{StaticResource IconStatusPillStyle}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            x:Name="ChipIcon"
                            Width="12"
                            Height="12"
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource StatusInfoFg}"
                            Kind="ClockOutline" />
                        <TextBlock
                            x:Name="ChipText"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource StatusInfoFg}"
                            Text="{Binding StatusText}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <ProgressBar
                    Width="86"
                    Height="3"
                    Margin="2,4,0,0"
                    HorizontalAlignment="Left"
                    Maximum="100"
                    Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisibility}}"
                    Value="{Binding Progress, Mode=OneWay}" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Working">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource AccentColorSubtle}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="Autorenew" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource AccentColor}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource AccentColor}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Done">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusSuccessBg}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="CheckCircleOutline" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource StatusSuccessFg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusSuccessFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusErrorBg}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="AlertCircleOutline" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusWarningBg}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="CloseCircleOutline" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Skipped">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource RowBg}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="MinusCircleOutline" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource TextSecondary}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource TextSecondary}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>


        <!--  Input card: one queued item  -->
        <DataTemplate x:Key="QueueItemTemplate" DataType="{x:Type models:EncryptQueueGroup}">
            <Grid ToolTip="{Binding ToolTip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="26"
                    Height="26"
                    Margin="0,0,8,0"
                    Background="{DynamicResource AccentColorSubtle}"
                    CornerRadius="7">
                    <materialDesign:PackIcon
                        x:Name="GroupIcon"
                        Width="14"
                        Height="14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource AccentColor}"
                        Kind="FileMultipleOutline" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource SidebarText}"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Margin="0,1,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource SidebarTextMuted}"
                        Text="{Binding Subtitle}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button
                    Grid.Column="2"
                    Width="24"
                    Height="24"
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    Click="BtnRemoveQueueGroup_Click"
                    Style="{StaticResource IconButtonStyle}"
                    Tag="{Binding}"
                    ToolTip="{DynamicResource Str_Validate_RemoveFromListTooltip}">
                    <materialDesign:PackIcon
                        Width="13"
                        Height="13"
                        Kind="Close" />
                </Button>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                    <Setter TargetName="GroupIcon" Property="Kind" Value="Folder" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">

        <!--  No page header: MainWindow's header card shows the tool's icon and name.  -->

        <Grid Margin="16,8,16,16">

            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OptionsColumn" Width="280" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= OPTIONS SIDEBAR =================  -->

            <Border Grid.Column="0" Style="{StaticResource SidebarPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Button
                            x:Name="BtnCollapseOptions"
                            MinHeight="45"
                            HorizontalContentAlignment="Left"
                            Click="BtnCollapseOptions_Click"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Foreground="{DynamicResource SidebarText}"
                            ToolTip="{DynamicResource Str_Common_SidebarToggleTooltip}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="OverridesDefaultStyle" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Margin="16,0,0,0" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Kind="TuneVariant" />
                                <TextBlock
                                    x:Name="TxtOptionsHeaderLabel"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{DynamicResource Str_Common_OptionsLabel}" />
                            </StackPanel>
                        </Button>
                        <Separator
                            x:Name="SepHeader"
                            Margin="16,4"
                            Style="{StaticResource SidebarSeparatorStyle}" />
                    </StackPanel>

                    <ScrollViewer
                        x:Name="OptionsScrollViewer"
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16,4,16,16">

                            <!--  ============ MODE ============  -->
                            <Border ctl:Tour.Key="Str_Tour_FileEncrypt_Mode" ctl:Tour.Order="1" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Password_ModeHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.ShieldLockOutline}" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <RadioButton
                                            x:Name="RadioModeEncrypt"
                                            Click="RadioMode_Click"
                                            GroupName="EncryptMode"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="Encrypt"
                                            ToolTip="{DynamicResource Str_Encrypt_ModeEncryptTooltip}">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="18"
                                                    Height="18"
                                                    HorizontalAlignment="Center"
                                                    Kind="LockOutline" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    HorizontalAlignment="Center"
                                                    Text="{DynamicResource Str_Encrypt_ModeEncrypt}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="RadioModeDecrypt"
                                            Grid.Column="2"
                                            Click="RadioMode_Click"
                                            GroupName="EncryptMode"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="Decrypt"
                                            ToolTip="{DynamicResource Str_Encrypt_ModeDecryptTooltip}">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="18"
                                                    Height="18"
                                                    HorizontalAlignment="Center"
                                                    Kind="LockOpenVariantOutline" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    HorizontalAlignment="Center"
                                                    Text="{DynamicResource Str_Encrypt_ModeDecrypt}" />
                                            </StackPanel>
                                        </RadioButton>
                                    </Grid>

                                    <TextBlock
                                        x:Name="TxtModeHint"
                                        Margin="2,10,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource SidebarTextMuted}"
                                        Text="{DynamicResource Str_FileEncrypt_LocksFilesWithA}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!--  ============ FILES ============  -->
                            <controls:InputFolderCard
                                ctl:Tour.Key="Str_Tour_FileEncrypt_Files"
                                ctl:Tour.Order="2"
                                x:Name="InputCard"
                                ClearRequested="InputCard_ClearRequested"
                                Header="{DynamicResource Str_Common_Files}"
                                HeaderIcon="FileMultipleOutline"
                                IncludeSubfoldersChanged="InputCard_IncludeSubfoldersChanged"
                                ItemTemplate="{StaticResource QueueItemTemplate}"
                                PathsAdded="InputCard_PathsAdded" />


                            <!--  ============ PASSWORD ============  -->
                            <Border ctl:Tour.Key="Str_Tour_FileEncrypt_Password" ctl:Tour.Order="3" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Encrypt_PasswordHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.KeyVariant}" />

                                    <TextBlock
                                        Margin="0,4,0,6"
                                        Style="{StaticResource FieldLabel}"
                                        Text="{DynamicResource Str_Encrypt_PasswordHeader}" />
                                    <PasswordBox
                                        x:Name="PwdPassword"
                                        GotKeyboardFocus="Password_GotKeyboardFocus"
                                        KeyUp="Password_KeyUp"
                                        LostKeyboardFocus="Password_LostKeyboardFocus"
                                        PasswordChanged="PwdPassword_PasswordChanged"
                                        ToolTip="{DynamicResource Str_Encrypt_PasswordFieldTooltip}" />

                                    <!--  Strength meter: four segments, coloured with theme keys (the old bar used fixed colours and ActualWidth)  -->
                                    <StackPanel x:Name="PanelStrength" Margin="0,8,0,0">
                                        <UniformGrid Columns="4">
                                            <Border x:Name="MeterSeg1" Style="{StaticResource MeterSegmentStyle}" />
                                            <Border x:Name="MeterSeg2" Style="{StaticResource MeterSegmentStyle}" />
                                            <Border x:Name="MeterSeg3" Style="{StaticResource MeterSegmentStyle}" />
                                            <Border
                                                x:Name="MeterSeg4"
                                                Margin="0"
                                                Style="{StaticResource MeterSegmentStyle}" />
                                        </UniformGrid>
                                        <TextBlock
                                            Margin="0,5,0,0"
                                            FontSize="11"
                                            TextWrapping="Wrap">
                                            <Run
                                                x:Name="RunStrengthLabel"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource SidebarText}" />
                                            <Run
                                                x:Name="RunStrengthHint"
                                                Foreground="{DynamicResource SidebarTextMuted}"
                                                Text="{DynamicResource Str_FileEncrypt_ChooseAPasswordYou}" />
                                        </TextBlock>
                                    </StackPanel>

                                    <StackPanel x:Name="PanelConfirm">
                                        <TextBlock
                                            Margin="0,12,0,6"
                                            Style="{StaticResource FieldLabel}"
                                            Text="{DynamicResource Str_Encrypt_ConfirmPasswordLabel}" />
                                        <PasswordBox
                                            x:Name="PwdConfirmPassword"
                                            GotKeyboardFocus="Password_GotKeyboardFocus"
                                            KeyUp="Password_KeyUp"
                                            LostKeyboardFocus="Password_LostKeyboardFocus"
                                            PasswordChanged="PwdConfirmPassword_PasswordChanged"
                                            ToolTip="{DynamicResource Str_Encrypt_ConfirmPasswordTooltip}" />
                                        <StackPanel
                                            x:Name="PanelMatch"
                                            Margin="0,5,0,0"
                                            Orientation="Horizontal"
                                            Visibility="Collapsed">
                                            <materialDesign:PackIcon
                                                x:Name="IconMatch"
                                                Width="13"
                                                Height="13"
                                                Margin="0,0,4,0"
                                                VerticalAlignment="Center"
                                                Kind="CheckCircleOutline" />
                                            <TextBlock
                                                x:Name="TxtMatch"
                                                VerticalAlignment="Center"
                                                FontSize="11" />
                                        </StackPanel>
                                    </StackPanel>

                                    <!--  Caps Lock warning while typing a password  -->
                                    <Border
                                        x:Name="CapsLockWarning"
                                        Margin="0,10,0,0"
                                        HorizontalAlignment="Left"
                                        Background="{DynamicResource StatusWarningBg}"
                                        Style="{StaticResource IconStatusPillStyle}"
                                        Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon
                                                Width="13"
                                                Height="13"
                                                Margin="0,0,5,0"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource StatusWarningFg}"
                                                Kind="KeyboardCaps" />
                                            <TextBlock
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource StatusWarningFg}"
                                                Text="{DynamicResource Str_FileEncrypt_CapsLockIsOn}" />
                                        </StackPanel>
                                    </Border>

                                    <Border
                                        x:Name="NoRecoveryNote"
                                        Margin="0,10,0,0"
                                        Padding="10,8"
                                        Background="{DynamicResource SidebarSubPanelBg}"
                                        CornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon
                                                Width="14"
                                                Height="14"
                                                Margin="0,1,6,0"
                                                Foreground="{DynamicResource StatusWarningFg}"
                                                Kind="AlertOutline" />
                                            <TextBlock
                                                Grid.Column="1"
                                                FontSize="11"
                                                Foreground="{DynamicResource SidebarTextMuted}"
                                                Text="{DynamicResource Str_FileEncrypt_ThereSNoWay}"
                                                TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!--  ============ OPTIONS ============  -->
                            <Border Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Common_OptionsHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.Tune}" />
                                    <CheckBox
                                        x:Name="ChkDeleteOriginal"
                                        Checked="Option_Changed"
                                        Content="{DynamicResource Str_Encrypt_DeleteOriginal}"
                                        Foreground="{DynamicResource SidebarText}"
                                        ToolTip="{DynamicResource Str_Encrypt_DeleteOriginalTooltip}"
                                        Unchecked="Option_Changed" />
                                    <TextBlock
                                        x:Name="TxtDeleteNote"
                                        Margin="26,4,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource SidebarTextMuted}"
                                        TextWrapping="Wrap"
                                        Visibility="Collapsed" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!--  Kept (empty) for existing code that references it  -->
                    <StackPanel x:Name="OptionsBottomPanel" Grid.Row="2" />
                </Grid>
            </Border>

            <!--  ================= MAIN AREA =================  -->

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Run bar  -->
                <Border
                    Grid.Row="0"
                    Margin="0,0,0,14"
                    Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button
                            ctl:Tour.Key="Str_Tour_FileEncrypt_Run"
                            ctl:Tour.Order="4"
                            x:Name="BtnRun"
                            MinWidth="180"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            Click="BtnRun_Click"
                            Style="{StaticResource AccentPrimaryButtonStyle}"
                            ToolTip="{DynamicResource Str_Encrypt_RunButtonTooltip}">
                            <Grid HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon
                                    Grid.Column="0"
                                    x:Name="IconRun"
                                    Width="18"
                                    Height="18"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Kind="LockOutline" />
                                <TextBlock
                                    Grid.Column="1"
                                    x:Name="TxtRunLabel"
                                    VerticalAlignment="Center"
                                    Text="{DynamicResource Str_Encrypt_ModeEncrypt}" TextWrapping="Wrap" />
                            </Grid>
                        </Button>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <ProgressBar
                                x:Name="ProgressRun"
                                Height="8"
                                Maximum="100"
                                ToolTip="{DynamicResource Str_Encrypt_ProgressTooltip}" />
                            <TextBlock
                                x:Name="TxtProgress"
                                Margin="0,6,0,0"
                                FontSize="11.5"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="{DynamicResource Str_FileEncrypt_AddFilesTypeA}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock
                            x:Name="TxtProgressPercent"
                            Grid.Column="2"
                            MinWidth="54"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="{DynamicResource AccentColor}"
                            TextAlignment="Right" />
                    </Grid>
                </Border>

                <!--  Security note  -->
                <Border
                    x:Name="SecurityNote"
                    Grid.Row="1"
                    Margin="0,0,0,14"
                    Padding="14,12"
                    Background="{DynamicResource StatusInfoBg}"
                    CornerRadius="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="36"
                            Height="36"
                            Margin="0,0,12,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AccentColor}"
                            CornerRadius="18">
                            <materialDesign:PackIcon
                                Width="19"
                                Height="19"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="White"
                                Kind="ShieldCheckOutline" />
                        </Border>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                FontSize="12.5"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource StatusInfoFg}"
                                Text="{DynamicResource Str_Encrypt_Aes256Label}" />
                            <TextBlock
                                Margin="0,2,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource StatusInfoFg}"
                                Text="{DynamicResource Str_Encrypt_SecurityNote}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  Files  -->
                <Border ctl:Tour.Key="Str_Tour_FileEncrypt_List" ctl:Tour.Order="5" Grid.Row="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ContentControl
                                VerticalAlignment="Center"
                                Content="{DynamicResource Str_Encrypt_ResultsTitle}"
                                Style="{StaticResource CardHeader}"
                                Tag="{x:Static materialDesign:PackIconKind.FileLockOutline}" />

                            <WrapPanel
                                x:Name="SummaryPanel"
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                                <Border
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource StatusInfoBg}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    ToolTip="{DynamicResource Str_Encrypt_ResultsPillTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource StatusInfoFg}"
                                            Kind="FileMultipleOutline" />
                                        <TextBlock
                                            x:Name="TxtSummaryFiles"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource StatusInfoFg}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource AccentColorSubtle}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    ToolTip="{DynamicResource Str_FileEncrypt_WhatHappensToThem}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            x:Name="IconSummaryTarget"
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource AccentColor}"
                                            Kind="LockOutline" />
                                        <TextBlock
                                            x:Name="TxtSummaryTarget"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource AccentColor}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    x:Name="PillSkipped"
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource RowBg}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    ToolTip="{DynamicResource Str_FileEncrypt_DonTFitThe}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource TextSecondary}"
                                            Kind="MinusCircleOutline" />
                                        <TextBlock
                                            x:Name="TxtSummarySkipped"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextSecondary}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    x:Name="PillDone"
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource StatusSuccessBg}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    ToolTip="{DynamicResource Str_FileEncrypt_FinishedThisRun}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource StatusSuccessFg}"
                                            Kind="CheckCircleOutline" />
                                        <TextBlock
                                            x:Name="TxtSummaryDone"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource StatusSuccessFg}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    x:Name="PillFailed"
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource StatusErrorBg}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    ToolTip="{DynamicResource Str_FileConverter_HoverAFailedRow}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource StatusErrorFg}"
                                            Kind="AlertCircleOutline" />
                                        <TextBlock
                                            x:Name="TxtSummaryFailed"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource StatusErrorFg}" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <StackPanel
                                x:Name="ActionsPanel"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Button
                                    x:Name="BtnShowInFolder"
                                    Margin="0,0,8,0"
                                    Click="BtnShowInFolder_Click"
                                    ToolTip="{DynamicResource Str_FileEncrypt_ShowTheSelectedFile}"
                                    Style="{StaticResource ListToolButtonStyle}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="FolderSearchOutline" />
                                </Button>
                                <Button
                                    x:Name="BtnRemoveFiles"
                                    Margin="0,0,8,0"
                                    Click="BtnRemoveFiles_Click"
                                    ToolTip="{DynamicResource Str_FileEncrypt_TakeTheSelectedFiles}"
                                    Style="{StaticResource ListToolButtonStyle}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="PlaylistRemove" />
                                </Button>
                                <Button
                                    x:Name="BtnClearFiles"
                                    Click="BtnClearFiles_Click"
                                    ToolTip="{DynamicResource Str_FileEncrypt_ClearTheListNo}"
                                    Style="{StaticResource ListToolDangerButtonStyle}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="DeleteSweepOutline" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <DataGrid
                            x:Name="DataGridFiles"
                            Grid.Row="1"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            FontSize="12"
                            IsReadOnly="True"
                            MouseDoubleClick="DataGridFiles_MouseDoubleClick"
                            PreviewKeyDown="DataGridFiles_PreviewKeyDown"
                            MinRowHeight="48"
                            SelectionMode="Extended"
                            ToolTip="{DynamicResource Str_Encrypt_GridTooltip}"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.ScrollUnit="Pixel"
                            VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn
                                    Width="46"
                                    CanUserSort="False"
                                    CellStyle="{StaticResource CompactCellStyle}"
                                    CellTemplate="{StaticResource KindCellTemplate}" />
                                <DataGridTemplateColumn
                                    Width="2*"
                                    MinWidth="90"
                                    CellTemplate="{StaticResource NameCellTemplate}"
                                    Header="{DynamicResource Str_Common_ColHeaderName}"
                                    SortMemberPath="Name" />
                                <DataGridTemplateColumn
                                    x:Name="ColOutput"
                                    Width="2*"
                                    MinWidth="70"
                                    CellTemplate="{StaticResource OutputCellTemplate}"
                                    Header="{DynamicResource Str_Encrypt_ColHeaderOutputName}"
                                    SortMemberPath="OutputName" />
                                <DataGridTextColumn
                                    ElementStyle="{StaticResource EllipsisCellTextStyle}"
                                    Width="80"
                                    Binding="{Binding Size}"
                                    Header="{DynamicResource Str_Common_ColHeaderSize}"
                                    SortMemberPath="SizeBytes" />
                                <DataGridTemplateColumn
                                    Width="120"
                                    CellTemplate="{StaticResource StatusCellTemplate}"
                                    Header="{DynamicResource Str_Common_ColHeaderStatus}"
                                    SortMemberPath="Status" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel
                            x:Name="EmptyStatePanel"
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                            <ContentControl
                                x:Name="EmptyBadge"
                                Style="{StaticResource EmptyStateBadge}"
                                Tag="{x:Static materialDesign:PackIconKind.FileLockOutline}" />
                            <TextBlock
                                x:Name="TxtEmptyHint"
                                MaxWidth="380"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Center"
                                FontSize="12.5"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="{DynamicResource Str_Encrypt_DragDropHint}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
