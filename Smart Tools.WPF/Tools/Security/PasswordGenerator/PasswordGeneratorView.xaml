<UserControl
    x:Class="Smart_Tools.WPF.Views.PasswordGeneratorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:models="clr-namespace:Smart_Tools.WPF.Models"
    x:Name="Root"
    Loaded="Root_Loaded"
    PreviewKeyDown="Root_PreviewKeyDown">

    <!--
        Backend: Controllers/PasswordGeneratorManager.cs (generation, exact
        strength, crack time, export, settings) + PasswordGeneratorManager.Words.cs
        (EFF word list); Models/PasswordGeneratorModel.cs. UI only here.
    -->

    <UserControl.Resources>

        <FontFamily x:Key="PasswordFont">Cascadia Mono, Consolas, Courier New</FontFamily>


        <!--  Thin rounded meter (strength)  -->

        <!--  Big number next to a slider (length, words)  -->
        <Style x:Key="BigValueStyle" TargetType="TextBlock">
            <Setter Property="FontSize" Value="24" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}" />
            <Setter Property="VerticalAlignment" Value="Bottom" />
        </Style>

        <!--  One run of the password, coloured by kind  -->
        <DataTemplate x:Key="SegmentTemplate" DataType="{x:Type models:PasswordGenSegment}">
            <TextBlock
                x:Name="Seg"
                FontFamily="{StaticResource PasswordFont}"
                FontSize="16"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextPrimary}"
                Text="{Binding Text}" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Digit">
                    <Setter TargetName="Seg" Property="Foreground" Value="{DynamicResource AccentColor}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Symbol">
                    <Setter TargetName="Seg" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Separator">
                    <Setter TargetName="Seg" Property="Foreground" Value="{DynamicResource TextSecondary}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  One generated password  -->
        <DataTemplate x:Key="PasswordCardTemplate" DataType="{x:Type models:PasswordGenItem}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Border
                    Width="30"
                    Height="30"
                    Margin="0,0,12,0"
                    VerticalAlignment="Center"
                    Background="{DynamicResource AccentColorSubtle}"
                    CornerRadius="8">
                    <TextBlock
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="Bold"
                        Foreground="{DynamicResource AccentColor}"
                        Text="{Binding Number}" />
                </Border>

                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <Grid>
                        <TextBlock
                            x:Name="Masked"
                            FontFamily="{StaticResource PasswordFont}"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextSecondary}"
                            Text="{Binding MaskedPassword}"
                            TextTrimming="CharacterEllipsis" />
                        <ItemsControl
                            x:Name="Plain"
                            Focusable="False"
                            ItemTemplate="{StaticResource SegmentTemplate}"
                            ItemsSource="{Binding Segments}"
                            Visibility="Collapsed">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </Grid>

                    <StackPanel Margin="0,7,0,0" Orientation="Horizontal">
                        <Border
                            x:Name="StrengthPill"
                            Margin="0,0,8,0"
                            Background="{DynamicResource StatusSuccessBg}"
                            Style="{StaticResource IconStatusPillStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    x:Name="StrengthIcon"
                                    Width="12"
                                    Height="12"
                                    Margin="0,0,4,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource StatusSuccessFg}"
                                    Kind="ShieldCheckOutline" />
                                <TextBlock
                                    x:Name="StrengthText"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource StatusSuccessFg}"
                                    Text="{Binding StrengthLabel}" />
                            </StackPanel>
                        </Border>
                        <ProgressBar
                            x:Name="StrengthMeter"
                            Width="70"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource StatusSuccessFg}"
                            Style="{StaticResource MeterBarStyle}"
                            Value="{Binding StrengthPercent, Mode=OneWay}" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11"
                            Foreground="{DynamicResource TextSecondary}"
                            ToolTip="{DynamicResource Str_Password_EntropyTooltip}">
                            <Run Text="{Binding EntropyLabel, Mode=OneWay}" />
                            <Run Text=" · " />
                            <Run Text="{Binding LengthLabel, Mode=OneWay}" />
                            <Run Text=" · " />
                            <Run Text="{Binding CrackTimeLabel, Mode=OneWay}" />
                        </TextBlock>
                    </StackPanel>
                </StackPanel>

                <StackPanel
                    Grid.Column="2"
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    Orientation="Horizontal">
                    <Button Padding="0"
                        Width="30"
                        Height="30"
                        Margin="0,0,4,0"
                        Click="BtnToggleVisibility_Click"
                        Style="{StaticResource NeutralIconButtonStyle}"
                        ToolTip="{DynamicResource Str_Password_ToggleVisibilityTooltip}">
                        <materialDesign:PackIcon
                            x:Name="EyeIcon"
                            Width="15"
                            Height="15"
                            Kind="EyeOutline" />
                    </Button>
                    <Button Padding="0"
                        Width="30"
                        Height="30"
                        Margin="0,0,4,0"
                        Click="BtnRegenerateOne_Click"
                        Style="{StaticResource NeutralIconButtonStyle}"
                        ToolTip="{DynamicResource Str_Password_RegenerateOneTooltip}">
                        <materialDesign:PackIcon
                            Width="15"
                            Height="15"
                            Kind="Refresh" />
                    </Button>
                    <Button Padding="0"
                        Width="30"
                        Height="30"
                        Click="BtnCopy_Click"
                        Style="{StaticResource NeutralIconButtonStyle}"
                        ToolTip="{DynamicResource Str_Common_CopyToClipboardTooltip}">
                        <materialDesign:PackIcon
                            x:Name="CopyIcon"
                            Width="15"
                            Height="15"
                            Kind="ContentCopy" />
                    </Button>
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsVisible}" Value="True">
                    <Setter TargetName="Masked" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="Plain" Property="Visibility" Value="Visible" />
                    <Setter TargetName="EyeIcon" Property="Kind" Value="EyeOffOutline" />
                </DataTrigger>
                <DataTrigger Binding="{Binding JustCopied}" Value="True">
                    <Setter TargetName="CopyIcon" Property="Kind" Value="Check" />
                    <Setter TargetName="CopyIcon" Property="Foreground" Value="{DynamicResource StatusSuccessFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Strength}" Value="Fair">
                    <Setter TargetName="StrengthPill" Property="Background" Value="{DynamicResource StatusWarningBg}" />
                    <Setter TargetName="StrengthIcon" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                    <Setter TargetName="StrengthIcon" Property="Kind" Value="ShieldHalfFull" />
                    <Setter TargetName="StrengthText" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                    <Setter TargetName="StrengthMeter" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Strength}" Value="Weak">
                    <Setter TargetName="StrengthPill" Property="Background" Value="{DynamicResource StatusErrorBg}" />
                    <Setter TargetName="StrengthIcon" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                    <Setter TargetName="StrengthIcon" Property="Kind" Value="ShieldAlertOutline" />
                    <Setter TargetName="StrengthText" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                    <Setter TargetName="StrengthMeter" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Strength}" Value="VeryWeak">
                    <Setter TargetName="StrengthPill" Property="Background" Value="{DynamicResource StatusErrorBg}" />
                    <Setter TargetName="StrengthIcon" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                    <Setter TargetName="StrengthIcon" Property="Kind" Value="ShieldAlertOutline" />
                    <Setter TargetName="StrengthText" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                    <Setter TargetName="StrengthMeter" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">

        <!--  No page header: MainWindow's header card shows the tool's icon and name.  -->

        <Grid Margin="16,8,16,16">

            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OptionsColumn" Width="280" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= OPTIONS SIDEBAR =================  -->

            <Border Grid.Column="0" Style="{StaticResource SidebarPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Button
                            x:Name="BtnCollapseOptions"
                            MinHeight="45"
                            HorizontalContentAlignment="Left"
                            Click="BtnCollapseOptions_Click"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Foreground="{DynamicResource SidebarText}"
                            ToolTip="{DynamicResource Str_Common_SidebarToggleTooltip}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="OverridesDefaultStyle" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Margin="16,0,0,0" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Kind="TuneVariant" />
                                <TextBlock
                                    x:Name="TxtOptionsHeaderLabel"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{DynamicResource Str_Common_OptionsLabel}" />
                            </StackPanel>
                        </Button>
                        <Separator
                            x:Name="SepHeader"
                            Margin="16,4"
                            Style="{StaticResource SidebarSeparatorStyle}" />
                    </StackPanel>

                    <ScrollViewer
                        x:Name="OptionsScrollViewer"
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16,4,16,16">

                            <!--  ============ MODE ============  -->
                            <Border ctl:Tour.Key="Str_Tour_PasswordGen_Mode" ctl:Tour.Order="1" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        x:Name="LblModeHeader"
                                        Content="{DynamicResource Str_Password_ModeHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.ShieldKeyOutline}" />
                                    <UniformGrid Columns="2">
                                        <RadioButton
                                            x:Name="RadioModeRandom"
                                            Margin="0,0,2,0"
                                            Click="Mode_Click"
                                            GroupName="PasswordMode"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            ToolTip="{DynamicResource Str_Password_RandomCharsTooltip}">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="18"
                                                    Height="18"
                                                    HorizontalAlignment="Center"
                                                    Kind="FormTextboxPassword" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    HorizontalAlignment="Center"
                                                    Text="{DynamicResource Str_Password_RandomChars}"
                                                    TextAlignment="Center"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="RadioModePassphrase"
                                            Margin="2,0,0,0"
                                            Click="Mode_Click"
                                            GroupName="PasswordMode"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            ToolTip="{DynamicResource Str_Password_PassphraseTooltip}">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="18"
                                                    Height="18"
                                                    HorizontalAlignment="Center"
                                                    Kind="BookOpenPageVariantOutline" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    HorizontalAlignment="Center"
                                                    Text="{DynamicResource Str_Password_Passphrase}"
                                                    TextAlignment="Center"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </RadioButton>
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!--  ============ RANDOM CHARACTERS ============  -->
                            <Border ctl:Tour.Key="Str_Tour_PasswordGen_Random" ctl:Tour.Order="2" x:Name="RandomOptionsPanel" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Password_LengthHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.ArrowExpandHorizontal}" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            x:Name="TxtLengthValue"
                                            Style="{StaticResource BigValueStyle}"
                                            Text="16" />
                                        <TextBlock
                                            Margin="6,0,0,4"
                                            VerticalAlignment="Bottom"
                                            FontSize="11"
                                            Foreground="{DynamicResource SidebarTextMuted}"
                                            Text="{DynamicResource Str_PasswordGenerator_Characters}" />
                                    </StackPanel>
                                    <Slider
                                        x:Name="SliderLength"
                                        Margin="0,4,0,6"
                                        IsSnapToTickEnabled="True"
                                        Maximum="64"
                                        Minimum="4"
                                        TickFrequency="1"
                                        ValueChanged="SliderLength_ValueChanged"
                                        Value="16" />
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!--  First Button: Full Width (12)  -->
                                        <Button
                                            Grid.Row="0"
                                            Margin="0,0,0,2"
                                            Click="LengthPreset_Click"
                                            Content="12"
                                            Style="{StaticResource PresetChipStyle}"
                                            Tag="12" />

                                        <!--  Row 1: 1x2 Grid (16 & 20)  -->
                                        <UniformGrid
                                            Grid.Row="1"
                                            Margin="0,2"
                                            Columns="2">
                                            <Button
                                                Margin="0,0,2,0"
                                                Click="LengthPreset_Click"
                                                Content="16"
                                                Style="{StaticResource PresetChipStyle}"
                                                Tag="16" />
                                            <Button
                                                Margin="2,0,0,0"
                                                Click="LengthPreset_Click"
                                                Content="20"
                                                Style="{StaticResource PresetChipStyle}"
                                                Tag="20" />
                                        </UniformGrid>

                                        <!--  Row 2: 1x2 Grid (32 & 64)  -->
                                        <UniformGrid
                                            Grid.Row="2"
                                            Margin="0,2,0,0"
                                            Columns="2">
                                            <Button
                                                Margin="0,0,2,0"
                                                Click="LengthPreset_Click"
                                                Content="32"
                                                Style="{StaticResource PresetChipStyle}"
                                                Tag="32" />
                                            <Button
                                                Margin="2,0,0,0"
                                                Click="LengthPreset_Click"
                                                Content="64"
                                                Style="{StaticResource PresetChipStyle}"
                                                Tag="64" />
                                        </UniformGrid>
                                    </Grid>

                                    <TextBlock
                                        Margin="2,10,0,6"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Style="{DynamicResource FieldLabel}"
                                        Text="{DynamicResource Str_Password_CharTypesHeader}" />
                                    <StackPanel>
                                        <CheckBox
                                            x:Name="ChkUppercase"
                                            Margin="0,0,0,6"
                                            Click="Option_Click"
                                            Content="{DynamicResource Str_Password_Uppercase}"
                                            Foreground="{DynamicResource SidebarText}"
                                            IsChecked="True"
                                            ToolTip="A B C … Z" />
                                        <CheckBox
                                            x:Name="ChkLowercase"
                                            Margin="0,0,0,6"
                                            Click="Option_Click"
                                            Content="{DynamicResource Str_Password_Lowercase}"
                                            Foreground="{DynamicResource SidebarText}"
                                            IsChecked="True"
                                            ToolTip="a b c … z" />
                                        <CheckBox
                                            x:Name="ChkNumbers"
                                            Margin="0,0,0,6"
                                            Click="Option_Click"
                                            Content="{DynamicResource Str_Password_Numbers}"
                                            Foreground="{DynamicResource SidebarText}"
                                            IsChecked="True"
                                            ToolTip="0 1 2 … 9" />
                                        <CheckBox
                                            x:Name="ChkSymbols"
                                            Click="Option_Click"
                                            Content="{DynamicResource Str_Password_Symbols}"
                                            Foreground="{DynamicResource SidebarText}"
                                            IsChecked="True"
                                            ToolTip="{DynamicResource Str_PasswordGenerator_AmpLtGt}" />
                                    </StackPanel>
                                    <TextBlock
                                        x:Name="TxtCharError"
                                        Margin="2,6,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource StatusErrorFg}"
                                        Text="{DynamicResource Str_PasswordGenerator_ChooseAtLeastOne}"
                                        Visibility="Collapsed" />

                                    <Separator Margin="0,10" Style="{StaticResource SidebarSeparatorStyle}" />

                                    <CheckBox
                                        x:Name="ChkExcludeAmbiguous"
                                        Click="Option_Click"
                                        Content="{DynamicResource Str_Password_ExcludeAmbiguous}"
                                        Foreground="{DynamicResource SidebarText}"
                                        ToolTip="{DynamicResource Str_Password_ExcludeAmbiguousTooltip}" />
                                    <CheckBox
                                        x:Name="ChkRequireEachCategory"
                                        Margin="0,8,0,0"
                                        Click="Option_Click"
                                        Content="{DynamicResource Str_Password_RequireEachType}"
                                        Foreground="{DynamicResource SidebarText}"
                                        IsChecked="True"
                                        ToolTip="{DynamicResource Str_Password_RequireEachTypeTooltip}" />
                                </StackPanel>
                            </Border>

                            <!--  ============ PASSPHRASE ============  -->
                            <Border
                                x:Name="PassphraseOptionsPanel"
                                Style="{StaticResource SidebarGroupCardStyle}"
                                Visibility="Collapsed">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Password_WordCountHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.FormatListNumbered}" />
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock
                                            x:Name="TxtWordCountValue"
                                            Style="{StaticResource BigValueStyle}"
                                            Text="6" />
                                        <TextBlock
                                            Margin="6,0,0,4"
                                            VerticalAlignment="Bottom"
                                            FontSize="11"
                                            Foreground="{DynamicResource SidebarTextMuted}"
                                            Text="{DynamicResource Str_PasswordGenerator_Words}" />
                                    </StackPanel>
                                    <Slider
                                        x:Name="SliderWordCount"
                                        Margin="0,4,0,6"
                                        IsSnapToTickEnabled="True"
                                        Maximum="12"
                                        Minimum="3"
                                        TickFrequency="1"
                                        ValueChanged="SliderWordCount_ValueChanged"
                                        Value="6" />
                                    <WrapPanel>
                                        <Button
                                            Click="WordPreset_Click"
                                            Content="4"
                                            Style="{StaticResource PresetChipStyle}"
                                            Tag="4" />
                                        <Button
                                            Click="WordPreset_Click"
                                            Content="5"
                                            Style="{StaticResource PresetChipStyle}"
                                            Tag="5" />
                                        <Button
                                            Click="WordPreset_Click"
                                            Content="6"
                                            Style="{StaticResource PresetChipStyle}"
                                            Tag="6" />
                                        <Button
                                            Click="WordPreset_Click"
                                            Content="8"
                                            Style="{StaticResource PresetChipStyle}"
                                            Tag="8" />
                                    </WrapPanel>

                                    <TextBlock
                                        Margin="2,10,0,6"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource SidebarText}"
                                        Text="{DynamicResource Str_Password_SeparatorHeader}" />
                                    <UniformGrid Columns="5" ToolTip="{DynamicResource Str_Password_SeparatorTooltip}">
                                        <RadioButton
                                            x:Name="RadioSepDash"
                                            Margin="0,0,2,0"
                                            Click="Option_Click"
                                            Content="-"
                                            GroupName="PasswordSeparator"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="dash" />
                                        <RadioButton
                                            x:Name="RadioSepDot"
                                            Margin="2,0"
                                            Click="Option_Click"
                                            Content="."
                                            GroupName="PasswordSeparator"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="dot" />
                                        <RadioButton
                                            x:Name="RadioSepUnderscore"
                                            Margin="2,0"
                                            Click="Option_Click"
                                            Content="_"
                                            GroupName="PasswordSeparator"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="underscore" />
                                        <RadioButton
                                            x:Name="RadioSepSpace"
                                            Margin="2,0"
                                            Click="Option_Click"
                                            Content="␣"
                                            GroupName="PasswordSeparator"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="space"
                                            ToolTip="{DynamicResource Str_ImageViewerControl_Space}" />
                                        <RadioButton
                                            x:Name="RadioSepNone"
                                            Margin="2,0,0,0"
                                            Click="Option_Click"
                                            Content="{DynamicResource Str_Api_AuthTypeNone}"
                                            GroupName="PasswordSeparator"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="none"
                                            ToolTip="{DynamicResource Str_PasswordGenerator_NoSeparatorWordsruntogether}" />
                                    </UniformGrid>

                                    <CheckBox
                                        x:Name="ChkCapitalizeWords"
                                        Margin="0,12,0,0"
                                        Click="Option_Click"
                                        Content="{DynamicResource Str_Password_CapitalizeWords}"
                                        Foreground="{DynamicResource SidebarText}"
                                        IsChecked="True" />
                                    <CheckBox
                                        x:Name="ChkAppendNumber"
                                        Margin="0,8,0,0"
                                        Click="Option_Click"
                                        Content="{DynamicResource Str_Password_AppendNumber}"
                                        Foreground="{DynamicResource SidebarText}"
                                        IsChecked="True"
                                        ToolTip="{DynamicResource Str_Password_AppendNumberTooltip}" />
                                    <TextBlock
                                        Margin="2,10,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource SidebarTextMuted}"
                                        Text="{DynamicResource Str_PasswordGenerator_WordsComeFromThe}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!--  ============ HOW MANY ============  -->
                            <Border ctl:Tour.Key="Str_Tour_PasswordGen_Count" ctl:Tour.Order="3" Margin="0,0,0,4" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Password_HowManyHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.LayersOutline}" />
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!--  First Option: Full Width (1)  -->
                                        <RadioButton
                                            x:Name="RadioBatch1"
                                            Grid.Row="0"
                                            Margin="0,0,0,2"
                                            Click="Option_Click"
                                            Content="1"
                                            GroupName="PasswordBatch"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="1" />

                                        <!--  Middle Options: 1x2 Grid (5 & 10)  -->
                                        <UniformGrid
                                            Grid.Row="1"
                                            Margin="0,2"
                                            Columns="2">
                                            <RadioButton
                                                x:Name="RadioBatch5"
                                                Margin="0,0,2,0"
                                                Click="Option_Click"
                                                Content="5"
                                                GroupName="PasswordBatch"
                                                IsChecked="True"
                                                Style="{StaticResource ModeToggleButtonStyle}"
                                                Tag="5" />
                                            <RadioButton
                                                x:Name="RadioBatch10"
                                                Margin="2,0,0,0"
                                                Click="Option_Click"
                                                Content="10"
                                                GroupName="PasswordBatch"
                                                Style="{StaticResource ModeToggleButtonStyle}"
                                                Tag="10" />
                                        </UniformGrid>

                                        <!--  Last Option: Full Width (20)  -->
                                        <RadioButton
                                            x:Name="RadioBatch20"
                                            Grid.Row="2"
                                            Margin="0,2,0,0"
                                            Click="Option_Click"
                                            Content="20"
                                            GroupName="PasswordBatch"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="20" />
                                    </Grid>
                                    <TextBlock
                                        Margin="2,10,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource SidebarTextMuted}"
                                        Text="{DynamicResource Str_PasswordGenerator_GeneratedOnThisPc}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel x:Name="OptionsBottomPanel" Grid.Row="2" />
                </Grid>
            </Border>

            <!--  ================= MAIN =================  -->

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Run bar: Generate + live strength of the current settings  -->
                <Border
                    Grid.Row="0"
                    Margin="0,0,0,14"
                    Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button
                            ctl:Tour.Key="Str_Tour_PasswordGen_Generate"
                            ctl:Tour.Order="4"
                            x:Name="BtnGenerate"
                            MinWidth="170"
                            Margin="0,0,20,0"
                            VerticalAlignment="Center"
                            Click="BtnGenerate_Click"
                            Style="{StaticResource AccentPrimaryButtonStyle}"
                            ToolTip="{DynamicResource Str_Password_GenerateButtonTooltip}">
                            <Grid HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon
                                    Grid.Column="0"
                                    Width="18"
                                    Height="18"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Kind="DiceMultipleOutline" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_Password_GenerateButton}" TextWrapping="Wrap" />
                            </Grid>
                        </Button>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Border
                                    x:Name="PreviewPill"
                                    Margin="0,0,8,0"
                                    Background="{DynamicResource StatusSuccessBg}"
                                    Style="{StaticResource IconStatusPillStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            x:Name="PreviewIcon"
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource StatusSuccessFg}"
                                            Kind="ShieldCheckOutline" />
                                        <TextBlock
                                            x:Name="TxtPreviewLabel"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource StatusSuccessFg}"
                                            Text="{DynamicResource Str_PasswordGenerator_Strong}" />
                                    </StackPanel>
                                </Border>
                                <TextBlock
                                    x:Name="TxtPreviewDetail"
                                    VerticalAlignment="Center"
                                    FontSize="11.5"
                                    Foreground="{DynamicResource TextSecondary}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <ProgressBar
                                x:Name="PreviewMeter"
                                Height="8"
                                Margin="0,8,0,0"
                                Foreground="{DynamicResource StatusSuccessFg}"
                                Style="{StaticResource MeterBarStyle}"
                                ToolTip="{DynamicResource Str_PasswordGenerator_StrengthOfPasswordsMade}" />
                            <TextBlock
                                x:Name="TxtPreviewCrack"
                                Margin="0,6,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource TextSecondary}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{DynamicResource Str_PasswordGenerator_AverageTimeToGuess}" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="2"
                            Margin="20,0,0,0"
                            VerticalAlignment="Center"
                            ToolTip="{DynamicResource Str_Password_EntropyTooltip}">
                            <TextBlock
                                x:Name="TxtPreviewBits"
                                HorizontalAlignment="Right"
                                FontSize="26"
                                FontWeight="Bold"
                                Foreground="{DynamicResource AccentColor}"
                                Text="—" />
                            <TextBlock
                                HorizontalAlignment="Right"
                                FontSize="11"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="{DynamicResource Str_PasswordGenerator_BitsOfEntropy}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  Results  -->
                <Border ctl:Tour.Key="Str_Tour_PasswordGen_Results" ctl:Tour.Order="5" Grid.Row="1" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentControl
                                VerticalAlignment="Center"
                                Content="{DynamicResource Str_Password_ResultsTitle}"
                                Style="{StaticResource CardHeader}"
                                Tag="{x:Static materialDesign:PackIconKind.KeyChainVariant}" />
                            <TextBlock
                                x:Name="TxtResultsSubtitle"
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="11.5"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="{DynamicResource Str_Password_ResultsSubtitle}"
                                TextTrimming="CharacterEllipsis" />
                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Button Padding="0"
                                    x:Name="BtnShowAll"
                                    Width="32"
                                    Height="32"
                                    Margin="0,0,4,0"
                                    Click="BtnShowAll_Click"
                                    IsEnabled="False"
                                    Style="{StaticResource NeutralIconButtonStyle}"
                                    ToolTip="{DynamicResource Str_PasswordGenerator_ShowAllPasswords}">
                                    <materialDesign:PackIcon
                                        x:Name="IconShowAll"
                                        Width="16"
                                        Height="16"
                                        Kind="EyeOutline" />
                                </Button>
                                <controls:ExportButton
                                    x:Name="BtnExport"
                                    Margin="0,2,8,2"
                                    IsEnabled="False"
                                    ToolTip="{DynamicResource Str_Password_ExportCsvTooltip}">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem
                                                Click="MenuExport_Click"
                                                Header="{DynamicResource Str_Common_ExportAsText}"
                                                Tag="txt">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="FileDocumentOutline" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem
                                                Click="MenuExport_Click"
                                                Header="{DynamicResource Str_Common_ExportAsCsv}"
                                                Tag="csv">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="FileDelimitedOutline" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </controls:ExportButton>
                                <Button
                                    x:Name="BtnCopyAll"
                                    Margin="8,0,0,0"
                                    Click="BtnCopyAll_Click"
                                    IsEnabled="False"
                                    ToolTip="{DynamicResource Str_Password_CopyAllTooltip}"
                                    Style="{StaticResource ListToolButtonStyle}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="ContentCopy" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <ListBox
                            x:Name="ListPasswords"
                            Grid.Row="1"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemContainerStyle="{StaticResource FileCardListItemStyle}"
                            ItemTemplate="{StaticResource PasswordCardTemplate}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto"
                            SelectionMode="Single"
                            Style="{StaticResource FileCardListBoxStyle}"
                            ToolTip="{DynamicResource Str_PasswordGenerator_CtrlCCopiesThe}"
                            Visibility="Collapsed" />

                        <StackPanel
                            x:Name="EmptyStatePanel"
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <ContentControl
                                x:Name="EmptyBadge"
                                Style="{StaticResource EmptyStateBadge}"
                                Tag="{x:Static materialDesign:PackIconKind.KeyVariant}" />
                            <TextBlock
                                x:Name="TxtEmptyTitle"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Center"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextPrimary}"
                                Text="{DynamicResource Str_PasswordGenerator_MakeStrongPasswords}" />
                            <TextBlock
                                x:Name="TxtEmptyHint"
                                MaxWidth="420"
                                Margin="0,4,0,0"
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="{DynamicResource Str_PasswordGenerator_PickTheOptionsOn}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
