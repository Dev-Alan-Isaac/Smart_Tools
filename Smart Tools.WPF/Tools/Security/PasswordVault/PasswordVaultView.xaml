<UserControl
    x:Class="Smart_Tools.WPF.Views.PasswordVaultView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:Smart_Tools.WPF.Models"
    x:Name="Root"
    d:DesignHeight="650"
    d:DesignWidth="1100"
    mc:Ignorable="d"
    Loaded="Root_Loaded">

    <!--
        Backend: Controllers/PasswordVaultManager*.cs (vault file, Argon2id + AES-256-GCM, entries, TOTP,
        health, CSV / backup, settings); Models/PasswordVaultModel.cs. Floating widget:
        Controllers/PasswordVaultWidgetWindow.cs. UI only here.
    -->

    <UserControl.Resources>

        <FontFamily x:Key="VaultMono">Cascadia Mono, Consolas, Courier New</FontFamily>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!--  Star toggle next to the title: same 32px footprint as ListToolButtonStyle, amber when on  -->
        <Style x:Key="FavoriteToggleStyle" TargetType="ToggleButton">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="Bd"
                            Background="Transparent"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentColorSubtle}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource StatusWarningBg}" />
                                <Setter Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Problem colors, same everywhere: weak = red, reused = amber, old = blue  -->
        <Style
            x:Key="VaultHealthBadgeStyle"
            BasedOn="{StaticResource IconStatusPillStyle}"
            TargetType="Border">
            <Setter Property="Background" Value="{DynamicResource StatusWarningBg}" />
            <Setter Property="TextElement.Foreground" Value="{DynamicResource StatusWarningFg}" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding HealthSeverity}" Value="3">
                    <Setter Property="Background" Value="{DynamicResource StatusErrorBg}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource StatusErrorFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HealthSeverity}" Value="1">
                    <Setter Property="Background" Value="{DynamicResource StatusInfoBg}" />
                    <Setter Property="TextElement.Foreground" Value="{DynamicResource StatusInfoFg}" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  Footer chip: tinted by the problem's colors, outlined while it filters the list. Set Background, Foreground and Tag (a VaultHealthKind name).  -->
        <Style x:Key="HealthChipStyle" TargetType="ToggleButton">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="Bd"
                            Padding="9,4"
                            Background="{TemplateBinding Background}"
                            BorderBrush="Transparent"
                            BorderThickness="1.5"
                            CornerRadius="12">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{Binding Foreground, RelativeSource={RelativeSource TemplatedParent}}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  One saved login in the list  -->
        <DataTemplate DataType="{x:Type models:VaultEntry}">
            <DockPanel
                Margin="0,2"
                Background="Transparent"
                PreviewMouseRightButtonDown="EntryRow_RightClick">
                <DockPanel.ContextMenu>
                    <ContextMenu>
                        <MenuItem Click="MenuEdit_Click" Header="{DynamicResource Str_Vault_Edit}">
                            <MenuItem.Icon>
                                <materialDesign:PackIcon Kind="PencilOutline" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Click="MenuCopyUser_Click" Header="{DynamicResource Str_Vault_CopyUsername}">
                            <MenuItem.Icon>
                                <materialDesign:PackIcon Kind="AccountOutline" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Click="MenuCopyPass_Click" Header="{DynamicResource Str_Vault_CopyPassword}">
                            <MenuItem.Icon>
                                <materialDesign:PackIcon Kind="KeyOutline" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <MenuItem Click="MenuMoveGroup_Click" Header="{DynamicResource Str_Vault_MoveToGroup}">
                            <MenuItem.Icon>
                                <materialDesign:PackIcon Kind="FolderMoveOutline" />
                            </MenuItem.Icon>
                        </MenuItem>
                        <Separator />
                        <MenuItem Click="MenuDelete_Click" Header="{DynamicResource Str_Vault_Delete}">
                            <MenuItem.Icon>
                                <materialDesign:PackIcon Foreground="{DynamicResource StatusErrorFg}" Kind="DeleteOutline" />
                            </MenuItem.Icon>
                        </MenuItem>
                    </ContextMenu>
                </DockPanel.ContextMenu>
                <Border Width="{Binding Indent}" DockPanel.Dock="Left" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="34"
                        Height="34"
                        Margin="0,0,12,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource AccentColorSubtle}"
                        CornerRadius="9">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="14"
                            FontWeight="Bold"
                            Foreground="{DynamicResource AccentColor}"
                            Text="{Binding Initial}" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimary}"
                            Text="{Binding Title}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            FontSize="11.5"
                            Foreground="{DynamicResource TextSecondary}"
                            Text="{Binding Subtitle}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <StackPanel
                        Grid.Column="2"
                        VerticalAlignment="Center"
                        Orientation="Horizontal">
                        <Border
                            Margin="6,0,0,0"
                            Style="{StaticResource VaultHealthBadgeStyle}"
                            ToolTip="{Binding HealthNote}"
                            Visibility="{Binding HasHealthNote, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="13"
                                    Height="13"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Kind="AlertOutline" />
                                <TextBlock
                                    MaxWidth="150"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Text="{Binding HealthNote}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                        <materialDesign:PackIcon
                            Width="14"
                            Height="14"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource AccentColor}"
                            Kind="TimerOutline"
                            Visibility="{Binding HasTotp, Converter={StaticResource BoolToVisibility}}" />
                        <materialDesign:PackIcon
                            Width="14"
                            Height="14"
                            Margin="6,0,0,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource StatusWarningFg}"
                            Kind="Star"
                            Visibility="{Binding Favorite, Converter={StaticResource BoolToVisibility}}" />
                    </StackPanel>
                </Grid>
            </DockPanel>
        </DataTemplate>

        <!--  A group level (Games, then Launchers under it): click to fold or unfold  -->
        <DataTemplate DataType="{x:Type models:VaultGroupRow}">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border Width="{Binding Indent}" />
                <Button
                    Grid.Column="1"
                    Click="BtnGroup_Click"
                    Cursor="Hand"
                    Focusable="False">
                    <Button.Template>
                        <ControlTemplate TargetType="Button">
                            <Border
                                x:Name="Bd"
                                Padding="8,6"
                                Background="{DynamicResource RowBg}"
                                BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <ContentPresenter />
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentColorSubtle}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Button.Template>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon
                            Width="16"
                            Height="16"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextSecondary}">
                            <materialDesign:PackIcon.Style>
                                <Style TargetType="materialDesign:PackIcon">
                                    <Setter Property="Kind" Value="ChevronRight" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsExpanded}" Value="True">
                                            <Setter Property="Kind" Value="ChevronDown" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </materialDesign:PackIcon.Style>
                        </materialDesign:PackIcon>
                        <materialDesign:PackIcon
                            Grid.Column="1"
                            Width="16"
                            Height="16"
                            Margin="6,0,8,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource AccentColor}"
                            Kind="FolderOutline" />
                        <TextBlock
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimary}"
                            Text="{Binding Name}"
                            TextTrimming="CharacterEllipsis" />
                        <Border
                            Grid.Column="3"
                            Margin="8,0,0,0"
                            Padding="7,1"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AccentColorSubtle}"
                            CornerRadius="9">
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource AccentColor}"
                                Text="{Binding Count}" />
                        </Border>
                    </Grid>
                </Button>
            </Grid>
        </DataTemplate>

        <!--  Group headers are never selected or focused; they only fold  -->
        <Style
            x:Key="VaultRowStyle"
            BasedOn="{StaticResource {x:Type ListBoxItem}}"
            TargetType="ListBoxItem">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsGroupHeader}" Value="True">
                    <Setter Property="Focusable" Value="False" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="2,4,2,0" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">

        <!--  No page header: MainWindow's header card shows the tool's icon and name.  -->

        <Grid Margin="16,8,16,16">

            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OptionsColumn" d:Width="280" Width="0" />
                <ColumnDefinition x:Name="GapColumn" d:Width="14" Width="0" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= OPTIONS SIDEBAR (only while unlocked) =================  -->

            <Border
                x:Name="SidebarHost"
                Grid.Column="0"
                d:Visibility="Visible"
                Style="{StaticResource SidebarPanelStyle}"
                Visibility="Collapsed">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16,12,16,16">

                        <!--  VAULT  -->
                        <Border ctl:Tour.Key="Str_Tour_Vault_Sidebar" ctl:Tour.Order="3" Style="{StaticResource SidebarGroupCardStyle}">
                            <StackPanel>
                                <ContentControl
                                    Content="{DynamicResource Str_Vault_SidebarVault}"
                                    Style="{StaticResource SidebarGroupHeader}"
                                    Tag="{x:Static materialDesign:PackIconKind.ShieldKeyOutline}" />
                                <Button
                                    x:Name="BtnLock"
                                    Click="BtnLock_Click"
                                    Content="{DynamicResource Str_Vault_LockNow}"
                                    Style="{StaticResource PrimaryButtonStyle}" />
                                <Button
                                    x:Name="BtnChangeMaster"
                                    Margin="0,8,0,0"
                                    Click="BtnChangeMaster_Click"
                                    Content="{DynamicResource Str_Vault_ChangeMaster}" />
                                <Button
                                    x:Name="BtnWidget"
                                    Margin="0,8,0,0"
                                    Click="BtnWidget_Click"
                                    Content="{DynamicResource Str_Vault_ShowWidget}" />
                            </StackPanel>
                        </Border>

                        <!--  IMPORT & BACKUP  -->
                        <Border ctl:Tour.Key="Str_Tour_Vault_Backup" ctl:Tour.Order="4" Style="{StaticResource SidebarGroupCardStyle}">
                            <StackPanel>
                                <ContentControl
                                    Content="{DynamicResource Str_Vault_SidebarData}"
                                    Style="{StaticResource SidebarGroupHeader}"
                                    Tag="{x:Static materialDesign:PackIconKind.DatabaseExportOutline}" />
                                <Button Click="BtnImportCsv_Click" Content="{DynamicResource Str_Vault_ImportCsv}" />
                                <Button
                                    Margin="0,8,0,0"
                                    Click="BtnExportCsv_Click"
                                    Content="{DynamicResource Str_Vault_ExportCsv}" />
                                <Button
                                    Margin="0,8,0,0"
                                    Click="BtnExportBackup_Click"
                                    Content="{DynamicResource Str_Vault_ExportBackup}" />
                                <Button
                                    Margin="0,8,0,0"
                                    Click="BtnImportBackup_Click"
                                    Content="{DynamicResource Str_Vault_ImportBackup}" />
                            </StackPanel>
                        </Border>

                        <TextBlock
                            Margin="4,4,4,0"
                            FontSize="11"
                            Foreground="{DynamicResource SidebarTextMuted}"
                            Text="{DynamicResource Str_Vault_Limits}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!--  ================= MAIN AREA =================  -->

            <Grid Grid.Column="2">

                <!--  No vault yet: create one  -->
                <Border
                    ctl:Tour.Key="Str_Tour_Vault_Setup"
                    ctl:Tour.Order="1"
                    x:Name="PanelSetup"
                    MaxWidth="460"
                    VerticalAlignment="Center"
                    Style="{StaticResource CardStyle}"
                    Visibility="Collapsed">
                    <StackPanel Margin="8">
                        <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.ShieldKeyOutline}" />
                        <TextBlock
                            Margin="0,12,0,0"
                            HorizontalAlignment="Center"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimary}"
                            Text="{DynamicResource Str_Vault_SetupTitle}" />
                        <TextBlock
                            Margin="0,4,0,12"
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource TextSecondary}"
                            Text="{DynamicResource Str_Vault_SetupHint}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />

                        <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Str_Vault_MasterPassword}" />
                        <PasswordBox
                            x:Name="PwdNew"
                            Margin="0,4,0,0"
                            KeyUp="Pwd_KeyUp"
                            PasswordChanged="PwdNew_PasswordChanged" />
                        <ProgressBar
                            x:Name="SetupMeter"
                            Height="6"
                            Margin="0,8,0,0"
                            Maximum="100"
                            Style="{StaticResource MeterBarStyle}" />
                        <TextBlock
                            x:Name="TxtSetupStrength"
                            Margin="0,4,0,0"
                            FontSize="11"
                            Foreground="{DynamicResource TextSecondary}" />

                        <TextBlock
                            Margin="0,10,0,0"
                            Style="{StaticResource FieldLabel}"
                            Text="{DynamicResource Str_Vault_ConfirmPassword}" />
                        <PasswordBox
                            x:Name="PwdConfirm"
                            Margin="0,4,0,0"
                            KeyUp="Pwd_KeyUp"
                            PasswordChanged="PwdConfirm_PasswordChanged" />
                        <TextBlock
                            x:Name="TxtMatch"
                            Margin="0,4,0,0"
                            FontSize="11" />

                        <Border
                            Margin="0,12,0,0"
                            Padding="10,8"
                            Background="{DynamicResource StatusWarningBg}"
                            CornerRadius="8">
                            <TextBlock
                                FontSize="11.5"
                                Foreground="{DynamicResource StatusWarningFg}"
                                Text="{DynamicResource Str_Vault_NoRecovery}"
                                TextWrapping="Wrap" />
                        </Border>

                        <Border
                            x:Name="CapsSetup"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource StatusWarningBg}"
                            Style="{StaticResource IconStatusPillStyle}"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="13"
                                    Height="13"
                                    Margin="0,0,5,0"
                                    Foreground="{DynamicResource StatusWarningFg}"
                                    Kind="KeyboardCaps" />
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource StatusWarningFg}"
                                    Text="{DynamicResource Str_Vault_CapsLock}" />
                            </StackPanel>
                        </Border>

                        <Button
                            x:Name="BtnCreate"
                            Margin="0,14,0,0"
                            Click="BtnCreate_Click"
                            Content="{DynamicResource Str_Vault_CreateVault}"
                            Style="{StaticResource AccentPrimaryButtonStyle}" />
                        <TextBlock
                            x:Name="TxtSetupError"
                            Margin="0,8,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource StatusErrorFg}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!--  Locked  -->
                <Border
                    ctl:Tour.Key="Str_Tour_Vault_Unlock"
                    ctl:Tour.Order="2"
                    x:Name="PanelLocked"
                    MaxWidth="420"
                    VerticalAlignment="Center"
                    Style="{StaticResource CardStyle}"
                    Visibility="Collapsed">
                    <StackPanel Margin="8">
                        <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.LockOutline}" />
                        <TextBlock
                            Margin="0,12,0,0"
                            HorizontalAlignment="Center"
                            FontSize="16"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimary}"
                            Text="{DynamicResource Str_Vault_LockedTitle}" />
                        <TextBlock
                            Margin="0,4,0,12"
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource TextSecondary}"
                            Text="{DynamicResource Str_Vault_LockedHint}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                        <PasswordBox x:Name="PwdUnlock" KeyUp="PwdUnlock_KeyUp" />
                        <Border
                            x:Name="CapsUnlock"
                            Margin="0,10,0,0"
                            HorizontalAlignment="Left"
                            Background="{DynamicResource StatusWarningBg}"
                            Style="{StaticResource IconStatusPillStyle}"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="13"
                                    Height="13"
                                    Margin="0,0,5,0"
                                    Foreground="{DynamicResource StatusWarningFg}"
                                    Kind="KeyboardCaps" />
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource StatusWarningFg}"
                                    Text="{DynamicResource Str_Vault_CapsLock}" />
                            </StackPanel>
                        </Border>
                        <Button
                            x:Name="BtnUnlock"
                            Margin="0,14,0,0"
                            Click="BtnUnlock_Click"
                            Content="{DynamicResource Str_Vault_Unlock}"
                            Style="{StaticResource AccentPrimaryButtonStyle}" />
                        <TextBlock
                            x:Name="TxtUnlockError"
                            Margin="0,8,0,0"
                            FontSize="12"
                            Foreground="{DynamicResource StatusErrorFg}"
                            TextWrapping="Wrap" />
                        <Button
                            x:Name="BtnRestoreFile"
                            Margin="0,8,0,0"
                            Click="BtnRestoreFile_Click"
                            Content="{DynamicResource Str_Vault_RestoreFile}"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Border>

                <!--  Unlocked: list + editor  -->
                <Grid x:Name="PanelVault" d:Visibility="Visible" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="240" />
                        <ColumnDefinition x:Name="EditorGapColumn" d:Width="14" Width="0" />
                        <ColumnDefinition x:Name="EditorColumn" d:Width="1.35*" Width="0" />
                    </Grid.ColumnDefinitions>

                    <!--  List  -->
                    <Border ctl:Tour.Key="Str_Tour_Vault_Entries" ctl:Tour.Order="5" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentControl
                                    x:Name="HdrList"
                                    Content="{DynamicResource Str_Vault_Entries}"
                                    Style="{StaticResource CardHeader}"
                                    Tag="{x:Static materialDesign:PackIconKind.KeyChain}" />
                                <Border
                                    x:Name="BadgeAutoLock"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource StatusInfoBg}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    ToolTip="{DynamicResource Str_Vault_AutoLockTip}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            x:Name="IconAutoLock"
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource StatusInfoFg}"
                                            Kind="TimerLockOutline" />
                                        <TextBlock
                                            x:Name="TxtAutoLock"
                                            VerticalAlignment="Center"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource StatusInfoFg}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <Grid Grid.Row="1" Margin="0,8,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Style="{StaticResource InputBarStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon
                                            Width="16"
                                            Height="16"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource TextSecondary}"
                                            Kind="Magnify" />
                                        <TextBox
                                            x:Name="TxtSearch"
                                            Grid.Column="1"
                                            Margin="6,0,6,0"
                                            VerticalAlignment="Center"
                                            materialDesign:HintAssist.Hint="{DynamicResource Str_Vault_SearchPlaceholder}"
                                            Style="{StaticResource BareTextBox}"
                                            TextChanged="TxtSearch_TextChanged" />
                                    </Grid>
                                </Border>
                                <Button
                                    ctl:Tour.Key="Str_Tour_Vault_New"
                                    ctl:Tour.Order="6"
                                    x:Name="BtnNew"
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Click="BtnNew_Click"
                                    Style="{StaticResource AccentPrimaryButtonStyle}"
                                    ToolTip="{DynamicResource Str_Vault_NewEntry}">
                                    <Grid HorizontalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon
                                            Grid.Column="0"
                                            Width="16"
                                            Height="16"
                                            Kind="Plus" />
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="6,0,0,0"
                                            Text="{DynamicResource Str_Vault_NewEntry}"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                </Button>
                            </Grid>

                            <ListBox
                                x:Name="ListEntries"
                                Grid.Row="2"
                                BorderThickness="0"
                                ItemContainerStyle="{StaticResource VaultRowStyle}"
                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                SelectionChanged="ListEntries_SelectionChanged" />

                            <StackPanel
                                x:Name="PanelListEmpty"
                                Grid.Row="2"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                                <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.KeyPlus}" />
                                <TextBlock
                                    x:Name="TxtEmptyTitle"
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimary}"
                                    Text="{DynamicResource Str_Vault_EmptyTitle}" />
                                <TextBlock
                                    x:Name="TxtEmptyHint"
                                    MaxWidth="280"
                                    Margin="0,4,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{DynamicResource Str_Vault_EmptyHint}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <!--  Undo bar after a delete  -->
                            <Border
                                x:Name="UndoBar"
                                Grid.Row="3"
                                Margin="0,8,0,0"
                                Padding="10,6"
                                Background="{DynamicResource StatusInfoBg}"
                                CornerRadius="8"
                                Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{DynamicResource StatusInfoFg}"
                                        Text="{DynamicResource Str_Vault_Deleted}" />
                                    <Button
                                        Grid.Column="1"
                                        Click="BtnUndo_Click"
                                        Content="{DynamicResource Str_Vault_Undo}" />
                                </Grid>
                            </Border>

                            <!--  Password health: one chip per problem type; click a chip to show only those entries  -->
                            <Border
                                x:Name="FooterHealth"
                                Grid.Row="4"
                                Margin="0,8,0,0"
                                Padding="0,10,0,0"
                                BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="0,1,0,0"
                                Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Kind="HeartPulse"
                                        ToolTip="{DynamicResource Str_Vault_SidebarHealth}" />
                                    <ToggleButton
                                        x:Name="ChipWeak"
                                        Background="{DynamicResource StatusErrorBg}"
                                        Click="HealthChip_Click"
                                        Foreground="{DynamicResource StatusErrorFg}"
                                        Style="{StaticResource HealthChipStyle}"
                                        Tag="Weak"
                                        ToolTip="{DynamicResource Str_Vault_NoteWeak}">
                                        <TextBlock
                                            x:Name="TxtChipWeak"
                                            FontSize="11.5"
                                            FontWeight="SemiBold"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                    </ToggleButton>
                                    <ToggleButton
                                        x:Name="ChipReused"
                                        Background="{DynamicResource StatusWarningBg}"
                                        Click="HealthChip_Click"
                                        Foreground="{DynamicResource StatusWarningFg}"
                                        Style="{StaticResource HealthChipStyle}"
                                        Tag="Reused"
                                        ToolTip="{DynamicResource Str_Vault_NoteReused}">
                                        <TextBlock
                                            x:Name="TxtChipReused"
                                            FontSize="11.5"
                                            FontWeight="SemiBold"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                    </ToggleButton>
                                    <ToggleButton
                                        x:Name="ChipOld"
                                        Background="{DynamicResource StatusInfoBg}"
                                        Click="HealthChip_Click"
                                        Foreground="{DynamicResource StatusInfoFg}"
                                        Style="{StaticResource HealthChipStyle}"
                                        Tag="Old"
                                        ToolTip="{DynamicResource Str_Vault_NoteOld}">
                                        <TextBlock
                                            x:Name="TxtChipOld"
                                            FontSize="11.5"
                                            FontWeight="SemiBold"
                                            Foreground="{Binding Foreground, RelativeSource={RelativeSource AncestorType=ToggleButton}}" />
                                    </ToggleButton>
                                    <StackPanel
                                        x:Name="HealthAllGood"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="14"
                                            Height="14"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource StatusSuccessFg}"
                                            Kind="CheckCircleOutline" />
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{DynamicResource StatusSuccessFg}"
                                            Text="{DynamicResource Str_Vault_HealthAllGood}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <!--  Editor (collapsed while nothing is being edited)  -->
                    <Border
                        x:Name="CardEditor"
                        Grid.Column="2"
                        d:Visibility="Visible"
                        Style="{StaticResource CardStyle}"
                        Visibility="Collapsed">
                        <Grid x:Name="PanelEditor">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <!--  Header: what we're doing + close  -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentControl
                                    x:Name="HdrEditor"
                                    Content="{DynamicResource Str_Vault_EditEntry}"
                                    Style="{StaticResource CardHeader}"
                                    Tag="{x:Static materialDesign:PackIconKind.PencilOutline}" />
                                <Button
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Click="BtnCloseEditor_Click"
                                    Style="{StaticResource ListToolButtonStyle}"
                                    ToolTip="{DynamicResource Str_Vault_CloseEditor}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="Close" />
                                </Button>
                            </Grid>

                            <ScrollViewer
                                Grid.Row="1"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto">
                                <StackPanel Margin="0,0,6,0">

                                    <!--  Title + favorite  -->
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Str_Vault_FieldTitle}" />
                                    <Grid Margin="0,4,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBox x:Name="TxtTitle" TextChanged="Editor_Changed" />
                                        <ToggleButton
                                            x:Name="BtnFavorite"
                                            Grid.Column="1"
                                            Margin="6,0,0,0"
                                            Click="Editor_Changed"
                                            Style="{StaticResource FavoriteToggleStyle}"
                                            ToolTip="{DynamicResource Str_Vault_Favorite}">
                                            <materialDesign:PackIcon
                                                Width="18"
                                                Height="18"
                                                Kind="StarOutline" />
                                        </ToggleButton>
                                    </Grid>

                                    <!--  Sign-in  -->
                                    <Border
                                        Margin="0,16,0,0"
                                        Padding="0,14,0,0"
                                        BorderBrush="{DynamicResource CardBorder}"
                                        BorderThickness="0,1,0,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Str_Vault_FieldUsername}" />
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="TxtUsername" TextChanged="Editor_Changed" />
                                                <Button
                                                    Grid.Column="1"
                                                    Margin="6,0,0,0"
                                                    Click="BtnCopyUser_Click"
                                                    Style="{StaticResource ListToolButtonStyle}"
                                                    ToolTip="{DynamicResource Str_Vault_CopyUsername}">
                                                    <materialDesign:PackIcon
                                                        Width="16"
                                                        Height="16"
                                                        Kind="ContentCopy" />
                                                </Button>
                                            </Grid>

                                            <TextBlock
                                                Margin="0,12,0,0"
                                                Style="{StaticResource FieldLabel}"
                                                Text="{DynamicResource Str_Vault_FieldPassword}" />
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <PasswordBox x:Name="PwdEntry" PasswordChanged="PwdEntry_PasswordChanged" />
                                                <TextBox
                                                    x:Name="TxtEntryPlain"
                                                    FontFamily="{StaticResource VaultMono}"
                                                    TextChanged="TxtEntryPlain_TextChanged"
                                                    Visibility="Collapsed" />
                                                <Button
                                                    x:Name="BtnReveal"
                                                    Grid.Column="1"
                                                    Margin="6,0,0,0"
                                                    Click="BtnReveal_Click"
                                                    Style="{StaticResource ListToolButtonStyle}"
                                                    ToolTip="{DynamicResource Str_Vault_Reveal}">
                                                    <materialDesign:PackIcon
                                                        x:Name="IconReveal"
                                                        Width="16"
                                                        Height="16"
                                                        Kind="EyeOutline" />
                                                </Button>
                                                <Button
                                                    Grid.Column="2"
                                                    Margin="2,0,0,0"
                                                    Click="BtnCopyPass_Click"
                                                    Style="{StaticResource ListToolButtonStyle}"
                                                    ToolTip="{DynamicResource Str_Vault_CopyPassword}">
                                                    <materialDesign:PackIcon
                                                        Width="16"
                                                        Height="16"
                                                        Kind="ContentCopy" />
                                                </Button>
                                                <Button
                                                    x:Name="BtnGenerate"
                                                    Grid.Column="3"
                                                    Margin="2,0,0,0"
                                                    Click="BtnGenerate_Click"
                                                    Style="{StaticResource ListToolButtonStyle}"
                                                    ToolTip="{DynamicResource Str_Vault_Generate}">
                                                    <materialDesign:PackIcon
                                                        Width="16"
                                                        Height="16"
                                                        Kind="AutoFix" />
                                                </Button>
                                            </Grid>
                                            <ProgressBar
                                                x:Name="EntryMeter"
                                                Height="6"
                                                Margin="0,8,0,0"
                                                Maximum="100"
                                                Style="{StaticResource MeterBarStyle}" />
                                            <TextBlock
                                                x:Name="TxtEntryStrength"
                                                Margin="0,4,0,0"
                                                FontSize="11"
                                                Foreground="{DynamicResource TextSecondary}" />
                                        </StackPanel>
                                    </Border>

                                    <!--  Website  -->
                                    <Border
                                        Margin="0,14,0,0"
                                        Padding="0,14,0,0"
                                        BorderBrush="{DynamicResource CardBorder}"
                                        BorderThickness="0,1,0,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Str_Vault_FieldUrl}" />
                                            <Grid Margin="0,4,0,0">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <TextBox x:Name="TxtUrl" TextChanged="Editor_Changed" />
                                                <Button
                                                    Grid.Column="1"
                                                    Margin="6,0,0,0"
                                                    Click="BtnOpenUrl_Click"
                                                    Style="{StaticResource ListToolButtonStyle}"
                                                    ToolTip="{DynamicResource Str_Vault_OpenUrl}">
                                                    <materialDesign:PackIcon
                                                        Width="16"
                                                        Height="16"
                                                        Kind="OpenInNew" />
                                                </Button>
                                            </Grid>
                                        </StackPanel>
                                    </Border>

                                    <!--  One-time code  -->
                                    <Border
                                        Margin="0,14,0,0"
                                        Padding="0,14,0,0"
                                        BorderBrush="{DynamicResource CardBorder}"
                                        BorderThickness="0,1,0,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Str_Vault_FieldTotp}" />
                                            <TextBox
                                                x:Name="TxtTotpSecret"
                                                Margin="0,4,0,0"
                                                FontFamily="{StaticResource VaultMono}"
                                                TextChanged="TxtTotpSecret_TextChanged" />
                                            <Border
                                                x:Name="TotpBox"
                                                Margin="0,8,0,0"
                                                Padding="12,8"
                                                Background="{DynamicResource AccentColorSubtle}"
                                                CornerRadius="8"
                                                Visibility="Collapsed">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock
                                                        x:Name="TxtTotpCode"
                                                        VerticalAlignment="Center"
                                                        FontFamily="{StaticResource VaultMono}"
                                                        FontSize="22"
                                                        FontWeight="Bold"
                                                        Foreground="{DynamicResource AccentColor}" />
                                                    <TextBlock
                                                        x:Name="TxtTotpLeft"
                                                        Grid.Column="1"
                                                        Margin="0,0,10,0"
                                                        VerticalAlignment="Center"
                                                        FontSize="12"
                                                        Foreground="{DynamicResource TextSecondary}" />
                                                    <Button
                                                        Grid.Column="2"
                                                        Click="BtnCopyTotp_Click"
                                                        Style="{StaticResource ListToolButtonStyle}"
                                                        ToolTip="{DynamicResource Str_Vault_CopyCode}">
                                                        <materialDesign:PackIcon
                                                            Width="16"
                                                            Height="16"
                                                            Kind="ContentCopy" />
                                                    </Button>
                                                </Grid>
                                            </Border>
                                        </StackPanel>
                                    </Border>

                                    <!--  Details  -->
                                    <Border
                                        Margin="0,14,0,4"
                                        Padding="0,14,0,0"
                                        BorderBrush="{DynamicResource CardBorder}"
                                        BorderThickness="0,1,0,0">
                                        <StackPanel>
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Str_Vault_FieldTags}" />
                                            <TextBox
                                                x:Name="TxtTags"
                                                Margin="0,4,0,0"
                                                TextChanged="Editor_Changed" />

                                            <TextBlock
                                                Margin="0,12,0,0"
                                                Style="{StaticResource FieldLabel}"
                                                Text="{DynamicResource Str_Vault_FieldNotes}" />
                                            <TextBox
                                                x:Name="TxtNotes"
                                                Height="90"
                                                Margin="0,4,0,0"
                                                AcceptsReturn="True"
                                                TextChanged="Editor_Changed"
                                                TextWrapping="Wrap"
                                                VerticalScrollBarVisibility="Auto" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>

                            <!--  Actions stay in view while the fields scroll  -->
                            <Border
                                Grid.Row="2"
                                Margin="0,10,0,0"
                                Padding="0,12,0,0"
                                BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="0,1,0,0">
                                <StackPanel Orientation="Horizontal">
                                    <Button
                                        x:Name="BtnEdit"
                                        Click="BtnEdit_Click"
                                        Content="{DynamicResource Str_Vault_Edit}"
                                        Style="{StaticResource AccentPrimaryButtonStyle}"
                                        Visibility="Collapsed" />
                                    <Button
                                        x:Name="BtnSave"
                                        Click="BtnSave_Click"
                                        Content="{DynamicResource Str_Vault_Save}"
                                        Style="{StaticResource AccentPrimaryButtonStyle}" />
                                    <Button
                                        x:Name="BtnDelete"
                                        Margin="8,0,0,0"
                                        Click="BtnDelete_Click"
                                        Content="{DynamicResource Str_Vault_Delete}"
                                        Style="{StaticResource DangerButtonStyle}" />
                                    <TextBlock
                                        x:Name="TxtEditorStatus"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextSecondary}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
