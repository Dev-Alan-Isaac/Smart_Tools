<UserControl
    x:Class="Smart_Tools.WPF.Views.FileGeneratorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:models="clr-namespace:Smart_Tools.WPF.Models"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    x:Name="Root"
    Loaded="Root_Loaded"
    SizeChanged="Root_SizeChanged">

    <!--
        Backend: Controllers/FileGeneratorManager.cs (names, sizes, free-space
        check, writing under a temporary name, archive, report, settings) and
        FileGeneratorManager.Formats.cs (one writer per format, exact sizes,
        valid files); Models/FileGeneratorModel.cs. UI only here.
    -->

    <UserControl.Resources>

        <!--  Small one-click preset (sizes, counts)  -->

        <Style x:Key="SidebarFieldLabel" TargetType="TextBlock">
            <Setter Property="Margin" Value="2,10,0,4" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarText}" />
        </Style>


        <!--  Results: icon by file type + name  -->
        <DataTemplate x:Key="NameCellTemplate" DataType="{x:Type models:FileGenItem}">
            <Grid VerticalAlignment="Center" ToolTip="{Binding FullPath}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="28"
                    Height="28"
                    Margin="0,0,10,0"
                    Background="{DynamicResource AccentColorSubtle}"
                    CornerRadius="8">
                    <materialDesign:PackIcon
                        x:Name="TypeIcon"
                        Width="15"
                        Height="15"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource AccentColor}"
                        Kind="FileOutline" />
                </Border>
                <TextBlock
                    Grid.Column="1"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextPrimary}"
                    Text="{Binding Name}"
                    TextTrimming="CharacterEllipsis" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Format}" Value="Txt">
                    <Setter TargetName="TypeIcon" Property="Kind" Value="FileDocumentOutline" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Format}" Value="Csv">
                    <Setter TargetName="TypeIcon" Property="Kind" Value="FileDelimitedOutline" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Format}" Value="Json">
                    <Setter TargetName="TypeIcon" Property="Kind" Value="CodeJson" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Format}" Value="Xml">
                    <Setter TargetName="TypeIcon" Property="Kind" Value="Xml" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Format}" Value="Pdf">
                    <Setter TargetName="TypeIcon" Property="Kind" Value="FilePdfBox" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Format}" Value="Docx">
                    <Setter TargetName="TypeIcon" Property="Kind" Value="FileWordBox" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Format}" Value="Bin">
                    <Setter TargetName="TypeIcon" Property="Kind" Value="FileCogOutline" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Format}" Value="Dat">
                    <Setter TargetName="TypeIcon" Property="Kind" Value="DatabaseOutline" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Format}" Value="Jpg">
                    <Setter TargetName="TypeIcon" Property="Kind" Value="FileImageOutline" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Format}" Value="Png">
                    <Setter TargetName="TypeIcon" Property="Kind" Value="ImageOutline" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Format}" Value="Mp4">
                    <Setter TargetName="TypeIcon" Property="Kind" Value="FileVideoOutline" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Format}" Value="Custom">
                    <Setter TargetName="TypeIcon" Property="Kind" Value="FileQuestionOutline" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  Results: size, with "exact" / how far off underneath  -->
        <DataTemplate x:Key="SizeCellTemplate" DataType="{x:Type models:FileGenItem}">
            <StackPanel VerticalAlignment="Center">
                <TextBlock Foreground="{DynamicResource TextPrimary}" Text="{Binding SizeDisplay}" TextTrimming="CharacterEllipsis" />
                <TextBlock
                    FontSize="11"
                    Foreground="{DynamicResource TextSecondary}"
                    Text="{Binding SizeNote}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <!--  Results: status chip (reason in the tooltip)  -->
        <DataTemplate x:Key="StatusCellTemplate" DataType="{x:Type models:FileGenItem}">
            <Border
                x:Name="Chip"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="{DynamicResource RowBg}"
                Style="{StaticResource IconStatusPillStyle}"
                ToolTip="{Binding Message}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon
                        x:Name="ChipIcon"
                        Width="12"
                        Height="12"
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextSecondary}"
                        Kind="ClockOutline" />
                    <TextBlock
                        x:Name="ChipText"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextSecondary}"
                        Text="{DynamicResource Str_FileGenerator_Waiting}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Creating">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusInfoBg}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="FilePlusOutline" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource StatusInfoFg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusInfoFg}" />
                    <Setter TargetName="ChipText" Property="Text" Value="Creating…" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Created">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusSuccessBg}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="CheckCircleOutline" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource StatusSuccessFg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusSuccessFg}" />
                    <Setter TargetName="ChipText" Property="Text" Value="Created" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusErrorBg}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="AlertCircleOutline" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                    <Setter TargetName="ChipText" Property="Text" Value="Failed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusWarningBg}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="CancelOutline" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                    <Setter TargetName="ChipText" Property="Text" Value="Not made" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">

        <!--  No page header: MainWindow's header card shows the tool's icon and name.  -->

        <Grid Margin="16,8,16,16">

            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OptionsColumn" Width="300" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= OPTIONS SIDEBAR =================  -->

            <Border Grid.Column="0" Style="{StaticResource SidebarPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Button
                            x:Name="BtnCollapseOptions"
                            MinHeight="45"
                            HorizontalContentAlignment="Left"
                            Click="BtnCollapseOptions_Click"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Foreground="{DynamicResource SidebarText}"
                            ToolTip="{DynamicResource Str_Common_SidebarToggleTooltip}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="OverridesDefaultStyle" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Margin="16,0,0,0" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Kind="TuneVariant" />
                                <TextBlock
                                    x:Name="TxtOptionsHeaderLabel"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{DynamicResource Str_Common_OptionsLabel}" />
                            </StackPanel>
                        </Button>
                        <Separator
                            x:Name="SepHeader"
                            Margin="16,4"
                            Style="{StaticResource SidebarSeparatorStyle}" />
                    </StackPanel>

                    <ScrollViewer
                        x:Name="OptionsScrollViewer"
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16,4,16,16">

                            <!--  ============ FILE TYPE ============  -->
                            <Border ctl:Tour.Key="Str_Tour_FileGenerator_Type" ctl:Tour.Order="1" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_FileGen_FileTypeHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.FileMultipleOutline}" />
                                    <UniformGrid
                                        x:Name="FormatChips"
                                        Columns="4"
                                        ToolTip="{DynamicResource Str_FileGen_FileTypeTooltip}">
                                        <RadioButton
                                            x:Name="RadioFormatTxt"
                                            Margin="0,0,2,4"
                                            Click="Format_Click"
                                            GroupName="FileGenFormat"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="Txt">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="17"
                                                    Height="17"
                                                    HorizontalAlignment="Center"
                                                    Kind="FileDocumentOutline" />
                                                <TextBlock
                                                    Margin="0,2,0,0"
                                                    HorizontalAlignment="Center"
                                                    FontSize="11"
                                                    Text="{DynamicResource Str_FileGenerator_Txt}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="RadioFormatCsv"
                                            Margin="2,0,2,4"
                                            Click="Format_Click"
                                            GroupName="FileGenFormat"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="Csv">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="17"
                                                    Height="17"
                                                    HorizontalAlignment="Center"
                                                    Kind="FileDelimitedOutline" />
                                                <TextBlock
                                                    Margin="0,2,0,0"
                                                    HorizontalAlignment="Center"
                                                    FontSize="11"
                                                    Text="{DynamicResource Str_ApiTester_Csv}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="RadioFormatJson"
                                            Margin="2,0,2,4"
                                            Click="Format_Click"
                                            GroupName="FileGenFormat"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="Json">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="17"
                                                    Height="17"
                                                    HorizontalAlignment="Center"
                                                    Kind="CodeJson" />
                                                <TextBlock
                                                    Margin="0,2,0,0"
                                                    HorizontalAlignment="Center"
                                                    FontSize="11"
                                                    Text="{DynamicResource Str_ApiTester_Json}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="RadioFormatXml"
                                            Margin="2,0,0,4"
                                            Click="Format_Click"
                                            GroupName="FileGenFormat"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="Xml">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="17"
                                                    Height="17"
                                                    HorizontalAlignment="Center"
                                                    Kind="Xml" />
                                                <TextBlock
                                                    Margin="0,2,0,0"
                                                    HorizontalAlignment="Center"
                                                    FontSize="11"
                                                    Text="{DynamicResource Str_ApiTester_Xml}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="RadioFormatPdf"
                                            Margin="0,0,2,4"
                                            Click="Format_Click"
                                            GroupName="FileGenFormat"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="Pdf">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="17"
                                                    Height="17"
                                                    HorizontalAlignment="Center"
                                                    Kind="FilePdfBox" />
                                                <TextBlock
                                                    Margin="0,2,0,0"
                                                    HorizontalAlignment="Center"
                                                    FontSize="11"
                                                    Text="{DynamicResource Str_BarcodeGenerator_Pdf}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="RadioFormatDocx"
                                            Margin="2,0,2,4"
                                            Click="Format_Click"
                                            GroupName="FileGenFormat"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="Docx">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="17"
                                                    Height="17"
                                                    HorizontalAlignment="Center"
                                                    Kind="FileWordBox" />
                                                <TextBlock
                                                    Margin="0,2,0,0"
                                                    HorizontalAlignment="Center"
                                                    FontSize="11"
                                                    Text="{DynamicResource Str_FileGenerator_Word}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="RadioFormatJpg"
                                            Margin="2,0,2,4"
                                            Click="Format_Click"
                                            GroupName="FileGenFormat"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="Jpg">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="17"
                                                    Height="17"
                                                    HorizontalAlignment="Center"
                                                    Kind="FileImageOutline" />
                                                <TextBlock
                                                    Margin="0,2,0,0"
                                                    HorizontalAlignment="Center"
                                                    FontSize="11"
                                                    Text="{DynamicResource Str_BackgroundRemover_Jpg}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="RadioFormatPng"
                                            Margin="2,0,0,4"
                                            Click="Format_Click"
                                            GroupName="FileGenFormat"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="Png">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="17"
                                                    Height="17"
                                                    HorizontalAlignment="Center"
                                                    Kind="ImageOutline" />
                                                <TextBlock
                                                    Margin="0,2,0,0"
                                                    HorizontalAlignment="Center"
                                                    FontSize="11"
                                                    Text="{DynamicResource Str_BarcodeGenerator_Png}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="RadioFormatMp4"
                                            Margin="0,0,2,0"
                                            Click="Format_Click"
                                            GroupName="FileGenFormat"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="Mp4">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="17"
                                                    Height="17"
                                                    HorizontalAlignment="Center"
                                                    Kind="FileVideoOutline" />
                                                <TextBlock
                                                    Margin="0,2,0,0"
                                                    HorizontalAlignment="Center"
                                                    FontSize="11"
                                                    Text="MP4" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="RadioFormatBin"
                                            Margin="2,0,2,0"
                                            Click="Format_Click"
                                            GroupName="FileGenFormat"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="Bin">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="17"
                                                    Height="17"
                                                    HorizontalAlignment="Center"
                                                    Kind="FileCogOutline" />
                                                <TextBlock
                                                    Margin="0,2,0,0"
                                                    HorizontalAlignment="Center"
                                                    FontSize="11"
                                                    Text="{DynamicResource Str_FileGenerator_Bin}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="RadioFormatDat"
                                            Margin="2,0,2,0"
                                            Click="Format_Click"
                                            GroupName="FileGenFormat"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="Dat">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="17"
                                                    Height="17"
                                                    HorizontalAlignment="Center"
                                                    Kind="DatabaseOutline" />
                                                <TextBlock
                                                    Margin="0,2,0,0"
                                                    HorizontalAlignment="Center"
                                                    FontSize="11"
                                                    Text="{DynamicResource Str_FileGenerator_Dat}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="RadioFormatCustom"
                                            Margin="2,0,0,0"
                                            Click="Format_Click"
                                            GroupName="FileGenFormat"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="Custom">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="17"
                                                    Height="17"
                                                    HorizontalAlignment="Center"
                                                    Kind="FileQuestionOutline" />
                                                <TextBlock
                                                    Margin="0,2,0,0"
                                                    HorizontalAlignment="Center"
                                                    FontSize="11"
                                                    Text="{DynamicResource Str_FileGenerator_Other}" />
                                            </StackPanel>
                                        </RadioButton>
                                    </UniformGrid>
                                    <TextBlock x:Name="TxtFormatHint" Style="{StaticResource SidebarHint}" />

                                    <StackPanel x:Name="PanelCustomExtension" Visibility="Collapsed">
                                        <TextBlock Style="{StaticResource SidebarFieldLabel}" Text="{DynamicResource Str_FileGen_ExtensionLabel}" />
                                        <Border Style="{StaticResource InputBarStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Margin="4,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontFamily="Consolas"
                                                    FontWeight="Bold"
                                                    Foreground="{DynamicResource AccentColor}"
                                                    Text="." />
                                                <TextBox
                                                    x:Name="TxtCustomExtension"
                                                    Grid.Column="1"
                                                    FontFamily="Consolas"
                                                    Style="{StaticResource BareTextBox}"
                                                    Tag="log"
                                                    Text="dat"
                                                    TextChanged="Option_TextChanged"
                                                    ToolTip="{DynamicResource Str_FileGen_ExtensionTooltip}" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!--  ============ SIZE ============  -->
                            <Border ctl:Tour.Key="Str_Tour_FileGenerator_Size" ctl:Tour.Order="2" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Common_SizeHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.ResizeBottomRight}" />
                                    <UniformGrid Columns="2">
                                        <RadioButton
                                            x:Name="RadioSizeExact"
                                            Margin="0,0,2,0"
                                            Click="Option_Click"
                                            Content="{DynamicResource Str_FileGen_SizeExact}"
                                            GroupName="SizeMode"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            ToolTip="{DynamicResource Str_FileGen_SizeExactTooltip}" />
                                        <RadioButton
                                            x:Name="RadioSizeRandom"
                                            Margin="2,0,0,0"
                                            Click="Option_Click"
                                            Content="{DynamicResource Str_FileGen_SizeRandomRange}"
                                            GroupName="SizeMode"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            ToolTip="{DynamicResource Str_FileGen_SizeRandomRangeTooltip}" />
                                    </UniformGrid>

                                    <StackPanel x:Name="PanelExactSize" Margin="0,10,0,0">
                                        <Border Style="{StaticResource InputBarStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="72" />
                                                </Grid.ColumnDefinitions>

                                                <!--  Ruler Icon with 10px left margin  -->
                                                <materialDesign:PackIcon
                                                    Width="15"
                                                    Height="15"
                                                    Margin="10,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource AccentColor}"
                                                    Kind="Ruler" />

                                                <TextBox
                                                    x:Name="TxtExactSize"
                                                    Grid.Column="1"
                                                    Style="{StaticResource BareTextBox}"
                                                    Tag="1"
                                                    Text="1"
                                                    TextChanged="Option_TextChanged"
                                                    ToolTip="{DynamicResource Str_FileGen_ExactSizeTooltip}" />

                                                <Border Grid.Column="2" Style="{StaticResource InputBarDivider}" />

                                                <ComboBox
                                                    x:Name="CmbExactSizeUnit"
                                                    Grid.Column="3"
                                                    SelectedIndex="2"
                                                    SelectionChanged="Option_SelectionChanged"
                                                    Style="{StaticResource BareComboBox}"
                                                    ToolTip="{DynamicResource Str_FileGen_SizeUnitTooltip}">
                                                    <ComboBoxItem Content="B" />
                                                    <ComboBoxItem Content="KB" />
                                                    <ComboBoxItem Content="MB" />
                                                    <ComboBoxItem Content="GB" />
                                                </ComboBox>
                                            </Grid>
                                        </Border>
                                        <StackPanel Margin="0,8,0,0">
                                            <!--  Top row: Full-width 10 MB standout option  -->
                                            <Button
                                                Margin="0,0,0,4"
                                                HorizontalAlignment="Stretch"
                                                Click="SizePreset_Click"
                                                Content="10 MB"
                                                Style="{StaticResource PresetChipStyle}"
                                                Tag="10|2" />

                                            <!--  Bottom row: Uniform grid for the remaining sizes  -->
                                            <UniformGrid Columns="3">
                                                <Button
                                                    Margin="0,0,2,0"
                                                    Click="SizePreset_Click"
                                                    Content="100 KB"
                                                    Style="{StaticResource PresetChipStyle}"
                                                    Tag="100|1" />
                                                <Button
                                                    Margin="2,0"
                                                    Click="SizePreset_Click"
                                                    Content="1 MB"
                                                    Style="{StaticResource PresetChipStyle}"
                                                    Tag="1|2" />
                                                <Button
                                                    Margin="2,0,0,0"
                                                    Click="SizePreset_Click"
                                                    Content="100 MB"
                                                    Style="{StaticResource PresetChipStyle}"
                                                    Tag="100|2" />
                                            </UniformGrid>

                                            <!--  Final row or next item if needed for 1 GB  -->
                                            <Button
                                                Margin="0,4,0,0"
                                                HorizontalAlignment="Stretch"
                                                Click="SizePreset_Click"
                                                Content="1 GB"
                                                Style="{StaticResource PresetChipStyle}"
                                                Tag="1|3" />
                                        </StackPanel>
                                    </StackPanel>

                                    <StackPanel
                                        x:Name="PanelRandomSize"
                                        Margin="0,10,0,0"
                                        Visibility="Collapsed">
                                        <Border Margin="0,0,0,6" Style="{StaticResource InputBarStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="72" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Margin="4,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Foreground="{DynamicResource TextSecondary}"
                                                    Text="{DynamicResource Str_FileGenerator_From}" />
                                                <TextBox
                                                    x:Name="TxtMinSize"
                                                    Grid.Column="1"
                                                    Style="{StaticResource BareTextBox}"
                                                    Tag="Min"
                                                    Text="1"
                                                    TextChanged="Option_TextChanged"
                                                    ToolTip="{DynamicResource Str_FileGen_MinSizeTooltip}" />
                                                <Border Grid.Column="2" Style="{StaticResource InputBarDivider}" />
                                                <ComboBox
                                                    x:Name="CmbMinSizeUnit"
                                                    Grid.Column="3"
                                                    SelectedIndex="2"
                                                    SelectionChanged="Option_SelectionChanged"
                                                    Style="{StaticResource BareComboBox}"
                                                    ToolTip="{DynamicResource Str_FileGen_MinSizeUnitTooltip}">
                                                    <ComboBoxItem Content="B" />
                                                    <ComboBoxItem Content="KB" />
                                                    <ComboBoxItem Content="MB" />
                                                    <ComboBoxItem Content="GB" />
                                                </ComboBox>
                                            </Grid>
                                        </Border>
                                        <Border Style="{StaticResource InputBarStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="40" />
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="72" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock
                                                    Margin="4,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontSize="11"
                                                    Foreground="{DynamicResource TextSecondary}"
                                                    Text="To" />
                                                <TextBox
