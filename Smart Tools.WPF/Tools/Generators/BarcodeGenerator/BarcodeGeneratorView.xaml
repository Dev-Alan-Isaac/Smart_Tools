<UserControl
    x:Class="Smart_Tools.WPF.Views.BarCodeGeneratorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    x:Name="Root"
    Loaded="Root_Loaded">

    <!--
        Backend: Controllers/BarcodeManager.cs (+ shared ZxingImageHelpers.cs)
        and Models/BarcodeModel.cs. Code-behind only wires controls.
        Look & feel: shared view kit (Themes/Controls.xaml) + UiMotion.cs.
    -->

    <UserControl.Resources>

        <!--  Small preset chip (size presets, swap/reset colours)  -->

        <!--  "px" suffix inside a size field  -->

        <!--  Round colour swatch that opens the colour picker  -->

        <!--  Batch status chip, coloured from theme tokens by Status (enum)  -->
        <DataTemplate x:Key="BatchStatusChipTemplate">
            <Border
                x:Name="Chip"
                Padding="7,3,9,3"
                HorizontalAlignment="Left"
                Background="{DynamicResource StatusSuccessBg}"
                CornerRadius="8"
                ToolTip="{Binding Message}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon
                        x:Name="ChipIcon"
                        Width="13"
                        Height="13"
                        Margin="0,0,5,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource StatusSuccessFg}"
                        Kind="CheckCircleOutline" />
                    <TextBlock
                        x:Name="ChipText"
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource StatusSuccessFg}"
                        Text="{Binding Message}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusErrorBg}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="AlertCircleOutline" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">

        <!--  No page header: MainWindow's header card shows the tool's icon and name.  -->

        <Grid Margin="16,8,16,16">

            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OptionsColumn" Width="280" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= OPTIONS SIDEBAR =================  -->

            <Border Grid.Column="0" Style="{StaticResource SidebarPanelStyle}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>

                        <Button
                            x:Name="BtnCollapseOptions"
                            MinHeight="45"
                            HorizontalContentAlignment="Left"
                            Click="BtnCollapseOptions_Click"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Foreground="{DynamicResource SidebarText}"
                            ToolTip="{DynamicResource Str_Common_SidebarToggleTooltip}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="OverridesDefaultStyle" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Margin="16,0,0,0" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Kind="TuneVariant" />
                                <TextBlock
                                    x:Name="TxtOptionsHeaderLabel"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{DynamicResource Str_Common_OptionsLabel}" />
                            </StackPanel>
                        </Button>

                        <Separator
                            x:Name="SepHeader"
                            Margin="16,4"
                            Style="{StaticResource SidebarSeparatorStyle}" />

                    </StackPanel>

                    <ScrollViewer
                        x:Name="OptionsScrollViewer"
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto">

                        <StackPanel Margin="16">

                            <!--  ============ MODE ============  -->
                            <Border ctl:Tour.Key="Str_Tour_BarcodeGenerator_Mode" ctl:Tour.Order="1" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Password_ModeHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.ShieldLockOutline}" />

                                    <Grid x:Name="ModeTogglePanel">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <RadioButton
                                            x:Name="RadioModeSingle"
                                            Checked="RadioMode_Checked"
                                            GroupName="BarcodeMode"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            ToolTip="{DynamicResource Str_Barcode_ModeSingleTooltip}">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="18"
                                                    Height="18"
                                                    HorizontalAlignment="Center"
                                                    Kind="Barcode" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    HorizontalAlignment="Center"
                                                    Text="{DynamicResource Str_Common_ModeSingle}" />
                                            </StackPanel>
                                        </RadioButton>

                                        <RadioButton
                                            x:Name="RadioModeBatch"
                                            Grid.Column="2"
                                            Checked="RadioMode_Checked"
                                            GroupName="BarcodeMode"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="WebSocket"
                                            ToolTip="{DynamicResource Str_Barcode_ModeBatchTooltip}">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="18"
                                                    Height="18"
                                                    HorizontalAlignment="Center"
                                                    Kind="LayersTripleOutline" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    HorizontalAlignment="Center"
                                                    Text="{DynamicResource Str_Common_ModeBatch}" />
                                            </StackPanel>
                                        </RadioButton>

                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!--  ============ CONTENT (single mode) ============  -->
                            <Border x:Name="SingleInputSection" ctl:Tour.Key="Str_Tour_BarcodeGenerator_Input" ctl:Tour.Order="2" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Barcode_InputHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.FormTextbox}" />

                                    <Grid Margin="0,0,0,10" ToolTip="{DynamicResource Str_Barcode_InputModeTooltip}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <RadioButton
                                            x:Name="RadioInputText"
                                            Grid.Column="0"
                                            Checked="RadioInputMode_Checked"
                                            GroupName="BarcodeInput"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleTallStyle}">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="17"
                                                    Height="17"
                                                    HorizontalAlignment="Center"
                                                    Kind="FormatText" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    HorizontalAlignment="Center"
                                                    Text="{DynamicResource Str_Barcode_InputModeText}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="RadioInputNumeric"
                                            Grid.Column="2"
                                            Checked="RadioInputMode_Checked"
                                            GroupName="BarcodeInput"
                                            Style="{StaticResource ModeToggleTallStyle}">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="17"
                                                    Height="17"
                                                    HorizontalAlignment="Center"
                                                    Kind="Numeric" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    HorizontalAlignment="Center"
                                                    Text="{DynamicResource Str_Barcode_InputModeNumeric}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="RadioInputFile"
                                            Grid.Column="4"
                                            Checked="RadioInputMode_Checked"
                                            GroupName="BarcodeInput"
                                            Style="{StaticResource ModeToggleTallStyle}">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="17"
                                                    Height="17"
                                                    HorizontalAlignment="Center"
                                                    Kind="FileOutline" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    HorizontalAlignment="Center"
                                                    Text="{DynamicResource Str_Barcode_InputModeFile}" />
                                            </StackPanel>
                                        </RadioButton>
                                    </Grid>

                                    <TextBox
                                        x:Name="ContentTextBox"
                                        Height="64"
                                        Padding="8,6"
                                        AcceptsReturn="True"
                                        FontFamily="Consolas"
                                        Tag="Type the value to encode"
                                        Text="1234567890"
                                        TextChanged="ContentInput_Changed"
                                        TextWrapping="Wrap"
                                        ToolTip="{DynamicResource Str_Barcode_ValueTooltip}"
                                        VerticalScrollBarVisibility="Auto" />

                                    <TextBlock
                                        x:Name="TxtCharCount"
                                        Margin="0,4,0,0"
                                        HorizontalAlignment="Right"
                                        FontSize="11"
                                        Foreground="{DynamicResource SidebarTextMuted}"
                                        Text="{DynamicResource Str_BarcodeGenerator_10Characters}" />

                                    <!--  File picker (File mode)  -->
                                    <Border
                                        x:Name="PathPickerGrid"
                                        Padding="8,0,4,0"
                                        Style="{StaticResource InputBarStyle}"
                                        Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon
                                                Width="16"
                                                Height="16"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource AccentColor}"
                                                Kind="FileOutline" />
                                            <TextBox
                                                x:Name="PathTextBox"
                                                Grid.Column="1"
                                                IsReadOnly="True"
                                                Style="{StaticResource BareTextBox}"
                                                Tag="No file chosen"
                                                ToolTip="{DynamicResource Str_Barcode_FilePathTooltip}" />
                                            <Button
                                                x:Name="BrowseButton"
                                                Grid.Column="2"
                                                Width="28"
                                                Height="28"
                                                Margin="2,4"
                                                Click="BrowseButton_Click"
                                                Style="{StaticResource NeutralIconButtonStyle}"
                                                ToolTip="{DynamicResource Str_Barcode_BrowseFileTooltip}">
                                                <materialDesign:PackIcon
                                                    Width="15"
                                                    Height="15"
                                                    Kind="FolderOpenOutline" />
                                            </Button>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!--  ============ BATCH ENTRIES (batch mode) ============  -->
                            <Border
                                x:Name="BatchInputSection"
                                Style="{StaticResource SidebarGroupCardStyle}"
                                Visibility="Collapsed">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Common_BatchEntriesHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.PlaylistPlus}" />

                                    <!--  Type + Enter (or +) adds one entry  -->
                                    <Border Padding="0,0,4,0" Style="{StaticResource InputBarStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox
                                                x:Name="TxtNewBatchEntry"
                                                FontFamily="Consolas"
                                                KeyDown="TxtNewBatchEntry_KeyDown"
                                                Style="{StaticResource BareTextBox}"
                                                Tag="Type a value, press Enter"
                                                ToolTip="{DynamicResource Str_Barcode_TypeValueTooltip}" />
                                            <Button
                                                x:Name="BtnAddBatchEntry"
                                                Grid.Column="1"
                                                Width="28"
                                                Height="28"
                                                Margin="2,4"
                                                Click="BtnAddBatchEntry_Click"
                                                Style="{StaticResource NeutralIconButtonStyle}"
                                                ToolTip="{DynamicResource Str_Barcode_AddValueTooltip}">
                                                <materialDesign:PackIcon
                                                    Width="15"
                                                    Height="15"
                                                    Kind="Plus" />
                                            </Button>
                                        </Grid>
                                    </Border>

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="6" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            x:Name="BtnPasteBatchEntries"
                                            Grid.Column="0"
                                            MinHeight="30"
                                            Click="BtnPasteBatchEntries_Click"
                                            ToolTip="{DynamicResource Str_BarcodeGenerator_AddEveryLineCurrently}">
                                            <Grid HorizontalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon
                                                    Grid.Column="0"
                                                    Width="14"
                                                    Height="14"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Kind="ContentPaste" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_BarcodeGenerator_PasteList}" TextWrapping="Wrap" />
                                            </Grid>
                                        </Button>
                                        <Button
                                            x:Name="BtnLoadNamesFromFolder"
                                            Grid.Column="2"
                                            MinHeight="30"
                                            Click="BtnLoadNamesFromFolder_Click"
                                            ToolTip="{DynamicResource Str_Barcode_LoadNamesFromFolderTooltip}">
                                            <Grid HorizontalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon
                                                    Grid.Column="0"
                                                    Width="14"
                                                    Height="14"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Kind="FolderOpenOutline" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    Text="{DynamicResource Str_Barcode_LoadNamesFromFolder}" TextWrapping="Wrap" />
                                            </Grid>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!--  ============ TYPE ============  -->
                            <Border ctl:Tour.Key="Str_Tour_BarcodeGenerator_Type" ctl:Tour.Order="3" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Barcode_TypeHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.BarcodeScan}" />

                                    <!--  2 x 2 pills: name + what it holds  -->
                                    <Grid ToolTip="{DynamicResource Str_Barcode_TypeTooltip}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="4" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <RadioButton
                                            x:Name="RadioTypeCode128"
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            MinHeight="46"
                                            Checked="RadioType_Checked"
                                            GroupName="BarcodeType"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="Code128">
                                            <StackPanel>
                                                <TextBlock HorizontalAlignment="Center" Text="{DynamicResource Str_BarcodeGenerator_Code128}" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontSize="10"
                                                    FontWeight="Normal"
                                                    Opacity="0.8"
                                                    Text="{DynamicResource Str_BarcodeGenerator_AnyText}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="RadioTypeCode39"
                                            Grid.Row="0"
                                            Grid.Column="2"
                                            MinHeight="46"
                                            Checked="RadioType_Checked"
                                            GroupName="BarcodeType"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="Code39">
                                            <StackPanel>
                                                <TextBlock HorizontalAlignment="Center" Text="{DynamicResource Str_BarcodeGenerator_Code39}" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontSize="10"
                                                    FontWeight="Normal"
                                                    Opacity="0.8"
                                                    Text="{DynamicResource Str_BarcodeGenerator_AZAmpDigits}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="RadioTypeEan13"
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            MinHeight="46"
                                            Checked="RadioType_Checked"
                                            GroupName="BarcodeType"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="Ean13">
                                            <StackPanel>
                                                <TextBlock HorizontalAlignment="Center" Text="{DynamicResource Str_BarcodeGenerator_Ean13}" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontSize="10"
                                                    FontWeight="Normal"
                                                    Opacity="0.8"
                                                    Text="{DynamicResource Str_BarcodeGenerator_Retail12Digits}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="RadioTypeItf"
                                            Grid.Row="2"
                                            Grid.Column="2"
                                            MinHeight="46"
                                            Checked="RadioType_Checked"
                                            GroupName="BarcodeType"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="Interleaved2of5">
                                            <StackPanel>
                                                <TextBlock HorizontalAlignment="Center" Text="{DynamicResource Str_BarcodeGenerator_Itf}" />
                                                <TextBlock
                                                    HorizontalAlignment="Center"
                                                    FontSize="10"
                                                    FontWeight="Normal"
                                                    Opacity="0.8"
                                                    Text="{DynamicResource Str_BarcodeGenerator_DigitsEvenCount}" />
                                            </StackPanel>
                                        </RadioButton>
                                    </Grid>

                                    <TextBlock
                                        x:Name="TxtTypeHint"
                                        Margin="0,8,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource SidebarTextMuted}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!--  ============ SIZE ============  -->
                            <Border ctl:Tour.Key="Str_Tour_BarcodeGenerator_Size" ctl:Tour.Order="4" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Common_SizeHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.ArrowExpandAll}" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Str_Common_WidthPx}" />
                                            <Border x:Name="WidthBar" Style="{StaticResource InputBarStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox
                                                        x:Name="WidthTextBox"
                                                        Style="{StaticResource BareTextBox}"
                                                        Text="320"
                                                        TextChanged="SizeInput_Changed"
                                                        ToolTip="{DynamicResource Str_Barcode_WidthTooltip}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Style="{StaticResource UnitSuffix}"
                                                        Text="px" />
                                                </Grid>
                                            </Border>
                                            <TextBlock
                                                x:Name="TxtWidthError"
                                                Margin="0,4,0,0"
                                                FontSize="11"
                                                Foreground="{DynamicResource StatusErrorFg}"
                                                Text="{DynamicResource Str_Barcode_PositiveWholeNumberError}"
                                                TextWrapping="Wrap"
                                                Visibility="Collapsed" />
                                        </StackPanel>

                                        <StackPanel Grid.Column="2">
                                            <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Str_Common_HeightPx}" />
                                            <Border x:Name="HeightBar" Style="{StaticResource InputBarStyle}">
                                                <Grid>
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <TextBox
                                                        x:Name="HeightTextBox"
                                                        Style="{StaticResource BareTextBox}"
                                                        Text="140"
                                                        TextChanged="SizeInput_Changed"
                                                        ToolTip="{DynamicResource Str_Barcode_HeightTooltip}" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        Style="{StaticResource UnitSuffix}"
                                                        Text="px" />
                                                </Grid>
                                            </Border>
                                            <TextBlock
                                                x:Name="TxtHeightError"
                                                Margin="0,4,0,0"
                                                FontSize="11"
                                                Foreground="{DynamicResource StatusErrorFg}"
                                                Text="{DynamicResource Str_Barcode_PositiveWholeNumberError}"
                                                TextWrapping="Wrap"
                                                Visibility="Collapsed" />
                                        </StackPanel>
                                    </Grid>

                                    <StackPanel Margin="0,8,0,0">
                                        <!--  Top row: Full-width Medium standout option  -->
                                        <Button
                                            Margin="0,0,0,4"
                                            HorizontalAlignment="Stretch"
                                            Click="BtnSizePreset_Click"
                                            Content="{DynamicResource Str_BarcodeGenerator_Medium}"
                                            Style="{StaticResource PresetChipStyle}"
                                            Tag="320x140"
                                            ToolTip="320 × 140 px" />

                                        <!--  Bottom row: 3 equal columns for the remaining size presets  -->
                                        <UniformGrid Columns="3">
                                            <Button
                                                Margin="0,0,2,0"
                                                Click="BtnSizePreset_Click"
                                                Content="{DynamicResource Str_BarcodeGenerator_Small}"
                                                Style="{StaticResource PresetChipStyle}"
                                                Tag="240x100"
                                                ToolTip="240 × 100 px" />
                                            <Button
                                                Margin="2,0"
                                                Click="BtnSizePreset_Click"
                                                Content="{DynamicResource Str_BarcodeGenerator_Large}"
                                                Style="{StaticResource PresetChipStyle}"
                                                Tag="480x200"
                                                ToolTip="480 × 200 px" />
                                            <Button
                                                Margin="2,0,0,0"
                                                Click="BtnSizePreset_Click"
                                                Content="{DynamicResource Str_BarcodeGenerator_Print}"
                                                Style="{StaticResource PresetChipStyle}"
                                                Tag="900x360"
                                                ToolTip="{DynamicResource Str_BarcodeGenerator_900360PxFor}" />
                                        </UniformGrid>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!--  ============ COLOURS ============  -->
                            <Border Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Common_ColorsHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.PaletteOutline}" />

                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Str_Common_ForegroundLabel}" />
                                    <Border x:Name="ForegroundBar" Style="{StaticResource InputBarStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button
                                                x:Name="SwatchForeground"
                                                Background="Black"
                                                Click="SwatchForeground_Click"
                                                Style="{StaticResource SwatchPickerStyle}"
                                                ToolTip="{DynamicResource Str_Common_PickColorTooltip}" />
                                            <TextBox
                                                x:Name="TxtForegroundHex"
                                                Grid.Column="1"
                                                FontFamily="Consolas"
                                                LostFocus="ColorField_LostFocus"
                                                Style="{StaticResource BareTextBox}"
                                                Tag="#RRGGBB"
                                                Text="#000000"
                                                TextChanged="ForegroundHex_TextChanged"
                                                ToolTip="{DynamicResource Str_Barcode_ForegroundTooltip}" />
                                        </Grid>
                                    </Border>
                                    <TextBlock
                                        x:Name="TxtForegroundHexError"
                                        Margin="0,4,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource StatusErrorFg}"
                                        Text="{DynamicResource Str_Barcode_InvalidHexError}"
                                        TextWrapping="Wrap"
                                        Visibility="Collapsed" />

                                    <TextBlock
                                        Margin="0,10,0,4"
                                        Style="{StaticResource FieldLabel}"
                                        Text="{DynamicResource Str_Common_BackgroundLabel}" />
                                    <Border x:Name="BackgroundBar" Style="{StaticResource InputBarStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Button
                                                x:Name="SwatchBackground"
                                                Background="White"
                                                Click="SwatchBackground_Click"
                                                Style="{StaticResource SwatchPickerStyle}"
                                                ToolTip="{DynamicResource Str_Common_PickColorTooltip}" />
                                            <TextBox
                                                x:Name="TxtBackgroundHex"
                                                Grid.Column="1"
                                                FontFamily="Consolas"
                                                LostFocus="ColorField_LostFocus"
                                                Style="{StaticResource BareTextBox}"
                                                Tag="#RRGGBB"
                                                Text="#FFFFFF"
                                                TextChanged="BackgroundHex_TextChanged"
                                                ToolTip="{DynamicResource Str_Common_BackgroundColorTooltip}" />
                                        </Grid>
                                    </Border>
                                    <TextBlock
                                        x:Name="TxtBackgroundHexError"
                                        Margin="0,4,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource StatusErrorFg}"
                                        Text="{DynamicResource Str_Barcode_InvalidHexError}"
                                        TextWrapping="Wrap"
                                        Visibility="Collapsed" />

                                    <UniformGrid Margin="0,8,0,0" Columns="2">
                                        <Button
                                            x:Name="BtnSwapColors"
                                            Margin="0,0,2,0"
                                            Click="BtnSwapColors_Click"
                                            Style="{StaticResource PresetChipStyle}"
                                            ToolTip="{DynamicResource Str_BarcodeGenerator_SwapBarAndBackground}">
                                            <Grid HorizontalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon
                                                    Grid.Column="0"
                                                    Width="13"
                                                    Height="13"
                                                    Margin="0,0,4,0"
                                                    VerticalAlignment="Center"
                                                    Kind="SwapVertical" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_BarcodeGenerator_Swap}" TextWrapping="Wrap" />
                                            </Grid>
                                        </Button>
                                        <Button
                                            x:Name="BtnResetColors"
                                            Margin="2,0,0,0"
                                            Click="BtnResetColors_Click"
                                            Style="{StaticResource PresetChipStyle}"
                                            ToolTip="{DynamicResource Str_BarcodeGenerator_BackToBlackBars}">
                                            <Grid HorizontalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon
                                                    Grid.Column="0"
                                                    Width="13"
                                                    Height="13"
                                                    Margin="0,0,4,0"
                                                    VerticalAlignment="Center"
                                                    Kind="Restore" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_Common_Reset}" TextWrapping="Wrap" />
                                            </Grid>
                                        </Button>
                                    </UniformGrid>

                                    <!--  Scannability warning (inverted or low-contrast colours)  -->
                                    <Border
                                        x:Name="ColorWarningPanel"
                                        Margin="0,8,0,0"
                                        Padding="8,6"
                                        Background="{DynamicResource StatusWarningBg}"
                                        CornerRadius="8"
                                        Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon
                                                Width="14"
                                                Height="14"
                                                Margin="0,1,6,0"
                                                VerticalAlignment="Top"
                                                Foreground="{DynamicResource StatusWarningFg}"
                                                Kind="AlertOutline" />
                                            <TextBlock
                                                x:Name="TxtColorWarning"
                                                Grid.Column="1"
                                                FontSize="11"
                                                Foreground="{DynamicResource StatusWarningFg}"
                                                TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!--  ============ LABEL ============  -->
                            <Border Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Common_OptionsHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.FormatTextVariant}" />
                                    <CheckBox
                                        x:Name="ShowTextCheckBox"
                                        Margin="0"
                                        Checked="ShowTextCheckBox_Changed"
                                        Content="{DynamicResource Str_Barcode_ShowText}"
                                        Foreground="{DynamicResource SidebarText}"
                                        IsChecked="True"
                                        ToolTip="{DynamicResource Str_Barcode_ShowTextTooltip}"
                                        Unchecked="ShowTextCheckBox_Changed" />
                                </StackPanel>
                            </Border>


                        </StackPanel>

                    </ScrollViewer>

                    <!--  Kept (empty) for existing code that references it  -->
                    <StackPanel x:Name="OptionsBottomPanel" Grid.Row="2" />

                </Grid>

            </Border>

            <!--  ================= MAIN AREA =================  -->

            <Grid Grid.Column="2">

                <!--  ============ SINGLE MODE ============  -->

                <Border x:Name="SingleModeArea" Style="{StaticResource CardStyle}">

                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  Header + live status  -->
                        <Grid Grid.Row="0" Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ContentControl
                                Content="{DynamicResource Str_Common_PreviewHeader}"
                                Style="{StaticResource CardHeader}"
                                Tag="{x:Static materialDesign:PackIconKind.BarcodeScan}" />

                            <Border
                                x:Name="BorderStatus"
                                Grid.Column="1"
                                MaxWidth="420"
                                VerticalAlignment="Center"
                                Background="{DynamicResource RowBg}"
                                Style="{StaticResource IconStatusPillStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        x:Name="IconStatus"
                                        Width="13"
                                        Height="13"
                                        Margin="0,0,5,0"
                                        VerticalAlignment="Center"
                                        Foreground="{Binding Foreground, ElementName=TxtProgress}"
                                        Kind="InformationOutline" />
                                    <TextBlock
                                        x:Name="TxtProgress"
                                        FontSize="11.5"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Text="{DynamicResource Str_Barcode_ProgressInitial}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <!--  Stage: the barcode sits on a "label" that floats over a soft surface  -->
                        <Border
                            x:Name="SinglePreviewArea"
                            ctl:Tour.Key="Str_Tour_BarcodeGenerator_Preview" ctl:Tour.Order="5"
                            Grid.Row="1"
                            Background="{DynamicResource RowBg}"
                            BorderBrush="{DynamicResource CardBorder}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <Grid>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                    <ContentControl
                                        x:Name="PreviewLabel"
                                        Margin="24"
                                        Padding="12"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource ElevatedCardHost}">
                                        <Image
                                            x:Name="PreviewImage"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            RenderOptions.BitmapScalingMode="NearestNeighbor"
                                            SnapsToDevicePixels="True"
                                            Stretch="None" />
                                    </ContentControl>
                                </ScrollViewer>

                                <StackPanel
                                    x:Name="PreviewPlaceholder"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Visibility="Collapsed">
                                    <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.BarcodeOff}" />
                                    <TextBlock
                                        MaxWidth="340"
                                        Margin="0,12,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="12.5"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Text="{DynamicResource Str_Barcode_PreviewPlaceholder}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!--  Info + export actions  -->
                        <Grid Grid.Row="2" Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock
                                x:Name="TxtPreviewInfo"
                                VerticalAlignment="Center"
                                FontSize="11.5"
                                Foreground="{DynamicResource TextSecondary}"
                                TextTrimming="CharacterEllipsis" />

                            <Button
                                x:Name="CopyButton"
                                Grid.Column="1"
                                Margin="0,0,8,0"
                                Click="CopyButton_Click"
                                IsEnabled="False"
                                ToolTip="{DynamicResource Str_Barcode_CopyClipboardTooltip}">
                                <Grid HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon
                                        Grid.Column="0"
                                        Width="15"
                                        Height="15"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Kind="ContentCopy" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_Common_CopyClipboard}" TextWrapping="Wrap" />
                                </Grid>
                            </Button>

                            <controls:ExportButton
                                x:Name="SaveButton"
                                Grid.Column="2"
                                IsEnabled="False"
                                ToolTip="{DynamicResource Str_Barcode_SaveAsTooltip}">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem
                                            Click="MenuSave_Click"
                                            Header="{DynamicResource Str_BarcodeGenerator_Png}"
                                            Tag="Png"
                                            ToolTip="{DynamicResource Str_QRcodeGenerator_PngLosslessCrispEdges}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="FileImageOutline" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem
                                            Click="MenuSave_Click"
                                            Header="{DynamicResource Str_BackgroundRemover_Jpg}"
                                            Tag="Jpg"
                                            ToolTip="{DynamicResource Str_BarcodeGenerator_JpgSmallerButCan}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="FileImageOutline" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem
                                            Click="MenuSave_Click"
                                            Header="{DynamicResource Str_BarcodeGenerator_Svg}"
                                            Tag="Svg"
                                            ToolTip="{DynamicResource Str_BarcodeGenerator_SvgTrueVectorBars}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="VectorSquare" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem
                                            Click="MenuSave_Click"
                                            Header="{DynamicResource Str_BarcodeGenerator_Pdf}"
                                            Tag="Pdf"
                                            ToolTip="{DynamicResource Str_BarcodeGenerator_PdfLosslessPrintReady}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="FilePdfBox" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </controls:ExportButton>
                        </Grid>
                    </Grid>
                </Border>

                <!--  ============ BATCH MODE ============  -->

                <Grid x:Name="BatchModeArea" Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="320" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <!--  Run bar  -->
                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Margin="0,0,0,14"
                        Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button
                                x:Name="BtnGenerateAll"
                                Grid.Column="0"
                                MinWidth="180"
                                Margin="0,0,16,0"
                                VerticalAlignment="Center"
                                Click="BtnGenerateAll_Click"
                                Style="{StaticResource AccentPrimaryButtonStyle}"
                                ToolTip="{DynamicResource Str_Barcode_GenerateAllTooltip}">
                                <Grid HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon
                                        Grid.Column="0"
                                        x:Name="IconGenerateAll"
                                        Width="18"
                                        Height="18"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Kind="PlayCircleOutline" />
                                    <TextBlock
                                        Grid.Column="1"
                                        x:Name="TxtGenerateAllLabel"
                                        VerticalAlignment="Center"
                                        Text="{DynamicResource Str_Barcode_GenerateAll}" TextWrapping="Wrap" />
                                </Grid>
                            </Button>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <ProgressBar
                                    x:Name="ProgressBarBatch"
                                    Height="8"
                                    Maximum="100"
                                    ToolTip="{DynamicResource Str_Barcode_BatchProgressTooltip}" />
                                <TextBlock
                                    x:Name="TxtBatchProgress"
                                    Margin="0,6,0,0"
                                    FontSize="11.5"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{DynamicResource Str_Barcode_BatchProgressInitial}" />
                            </StackPanel>

                            <TextBlock
                                x:Name="TxtProgressPercent"
                                Grid.Column="2"
                                MinWidth="54"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="{DynamicResource AccentColor}"
                                Text="0%"
                                TextAlignment="Right" />
                        </Grid>
                    </Border>

                    <!--  Entries  -->
                    <Border
                        Grid.Row="1"
                        Grid.Column="0"
                        Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentControl
                                    Content="{DynamicResource Str_Common_BatchEntriesCardTitle}"
                                    Style="{StaticResource CardHeader}"
                                    Tag="{x:Static materialDesign:PackIconKind.FormatListBulleted}" />
                                <Border
                                    x:Name="BatchCountPill"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource StatusInfoBg}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        x:Name="TxtBatchCount"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource StatusInfoFg}"
                                        Text="0" />
                                </Border>
                            </Grid>

                            <ListBox
                                x:Name="ListBoxBatchEntries"
                                Grid.Row="1"
                                HorizontalContentAlignment="Stretch"
                                FontFamily="Consolas"
                                SelectionMode="Extended"
                                ToolTip="{DynamicResource Str_Barcode_BatchEntriesListTooltip}"
                                VirtualizingPanel.IsVirtualizing="True"
                                VirtualizingPanel.VirtualizationMode="Recycling">
                                <ListBox.ItemContainerStyle>
                                    <Style BasedOn="{StaticResource {x:Type ListBoxItem}}" TargetType="ListBoxItem">
                                        <Setter Property="Padding" Value="8,5" />
                                        <Setter Property="Margin" Value="0,1" />
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon
                                                Width="14"
                                                Height="14"
                                                Margin="0,0,8,0"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource AccentColor}"
                                                Kind="Barcode" />
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Text="{Binding}"
                                                TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <StackPanel
                                x:Name="BatchEntriesEmptyPanel"
                                Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                                <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.PlaylistPlus}" />
                                <TextBlock
                                    x:Name="TxtBatchEmptyHint"
                                    MaxWidth="240"
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{DynamicResource Str_Barcode_BatchEmptyHint}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Grid Grid.Row="2" Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Button
                                    x:Name="BtnRemoveBatchEntry"
                                    Grid.Column="0"
                                    Click="BtnRemoveBatchEntry_Click"
                                    ToolTip="{DynamicResource Str_Common_RemoveSelectedEntriesTooltip}"
                                    Style="{StaticResource ListToolButtonStyle}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="PlaylistRemove" />
                                </Button>
                                <Button
                                    x:Name="BtnClearBatchEntries"
                                    Grid.Column="2"
                                    Click="BtnClearBatchEntries_Click"
                                    ToolTip="{DynamicResource Str_Common_ClearAllEntriesTooltip}"
                                    Style="{StaticResource ListToolDangerButtonStyle}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="DeleteSweepOutline" />
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                    <!--  Results  -->
                    <Border
                        Grid.Row="1"
                        Grid.Column="2"
                        Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Grid.Row="0" Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentControl
                                    Content="{DynamicResource Str_Common_BatchResultsTitle}"
                                    Style="{StaticResource CardHeader}"
                                    Tag="{x:Static materialDesign:PackIconKind.ViewGridOutline}" />
                                <Border
                                    x:Name="SummaryPill"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource StatusInfoBg}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    ToolTip="{DynamicResource Str_Common_BatchResultsPillTooltip}"
                                    Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{Binding Foreground, ElementName=TxtSummaryCount}"
                                            Kind="CheckAll" />
                                        <TextBlock
                                            x:Name="TxtSummaryCount"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource StatusInfoFg}"
                                            Text="{DynamicResource Str_Barcode_BatchResultsPillInitial}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <DataGrid
                                x:Name="DataGridBatch"
                                Grid.Row="1"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                EnableRowVirtualization="True"
                                IsReadOnly="True"
                                MinRowHeight="46"
                                ToolTip="{DynamicResource Str_Barcode_BatchGridTooltip}"
                                VirtualizingPanel.IsVirtualizing="True"
                                VirtualizingPanel.VirtualizationMode="Recycling">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="110" Header="">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Border
                                                    Padding="3"
                                                    HorizontalAlignment="Left"
                                                    Background="White"
                                                    CornerRadius="4">
                                                    <Image
                                                        Width="92"
                                                        Height="30"
                                                        Source="{Binding Thumbnail}"
                                                        Stretch="Uniform" />
                                                </Border>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                    <DataGridTextColumn
                                        ElementStyle="{StaticResource EllipsisCellTextStyle}"
                                        Width="2*"
                                        Binding="{Binding Input}"
                                        FontFamily="Consolas"
                                        Header="{DynamicResource Str_Common_ColHeaderInput}" />
                                    <DataGridTextColumn
                                        ElementStyle="{StaticResource EllipsisCellTextStyle}"
                                        Width="90"
                                        Binding="{Binding SymbologyName}"
                                        Header="{DynamicResource Str_Common_ColHeaderType}" />
                                    <DataGridTemplateColumn
                                        Width="2*"
                                        CellTemplate="{StaticResource BatchStatusChipTemplate}"
                                        Header="{DynamicResource Str_Common_ColHeaderStatus}"
                                        SortMemberPath="Status" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel
                                x:Name="BatchEmptyStatePanel"
                                Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.BarcodeScan}" />
                                <TextBlock
                                    MaxWidth="320"
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="12.5"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{DynamicResource Str_Barcode_BatchResultsEmptyHint}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <Grid Grid.Row="2" Margin="0,12,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock
                                    x:Name="TxtBatchExportInfo"
                                    VerticalAlignment="Center"
                                    FontSize="11.5"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{DynamicResource Str_BarcodeGenerator_ExportsEveryGeneratedCode}" />
                                <controls:ExportButton
                                    x:Name="BatchExportButton"
                                    Grid.Column="1"
                                    IsEnabled="False"
                                    ToolTip="{DynamicResource Str_Barcode_ExportAllToFolderTooltip}">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem
                                                Click="MenuBatchExport_Click"
                                                Header="{DynamicResource Str_BarcodeGenerator_Png}"
                                                Tag="Png"
                                                ToolTip="{DynamicResource Str_QRcodeGenerator_PngLosslessCrispEdges}">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="FileImageOutline" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem
                                                Click="MenuBatchExport_Click"
                                                Header="{DynamicResource Str_BackgroundRemover_Jpg}"
                                                Tag="Jpg"
                                                ToolTip="{DynamicResource Str_BarcodeGenerator_JpgSmallerButCan}">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="FileImageOutline" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem
                                                Click="MenuBatchExport_Click"
                                                Header="{DynamicResource Str_BarcodeGenerator_Svg}"
                                                Tag="Svg"
                                                ToolTip="{DynamicResource Str_BarcodeGenerator_SvgTrueVectorBars}">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="VectorSquare" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem
                                                Click="MenuBatchExport_Click"
                                                Header="{DynamicResource Str_BarcodeGenerator_Pdf}"
                                                Tag="Pdf"
                                                ToolTip="{DynamicResource Str_BarcodeGenerator_PdfLosslessPrintReady}">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="FilePdfBox" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </controls:ExportButton>
                            </Grid>
                        </Grid>
                    </Border>

                </Grid>

            </Grid>

        </Grid>

    </Grid>

</UserControl>
