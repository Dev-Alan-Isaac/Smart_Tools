<UserControl
    x:Class="Smart_Tools.WPF.Views.IdGeneratorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    x:Name="Root"
    Focusable="True"
    Loaded="Root_Loaded"
    Unloaded="Root_Unloaded">

    <!--  Backend: Controllers/IdGeneratorManager.cs (UUID v4/v7, ULID, hex, lorem ipsum). UI only here.  -->

    <UserControl.Resources>
        <Style x:Key="IgLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarText}" />
            <Setter Property="Margin" Value="2,10,0,4" />
        </Style>
        <Style x:Key="IgHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextMuted}" />
            <Setter Property="Margin" Value="2,6,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">
        <Grid Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= OPTIONS SIDEBAR =================  -->
            <controls:ToolSidebar>
                <StackPanel>
                    <Border ctl:Tour.Key="Str_Tour_IdGenerator_Kind" ctl:Tour.Order="1" Margin="0,0,0,10" Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl Content="{DynamicResource Str_Spectogram_WhatToMake}" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.Creation}" />
                            <Border Margin="0,6,0,0" Style="{StaticResource InputBarStyle}">
                                <ComboBox x:Name="CmbKind" VerticalContentAlignment="Center" SelectionChanged="Kind_SelectionChanged" Style="{StaticResource BareComboBox}">
                                    <ComboBoxItem Content="{DynamicResource Str_IdGenerator_UuidVRandom}" Tag="Uuid4" />
                                    <ComboBoxItem Content="{DynamicResource Str_IdGenerator_UuidVSortedBy}" Tag="Uuid7" />
                                    <ComboBoxItem Content="{DynamicResource Str_IdGenerator_UlidSortedByTime}" Tag="Ulid" />
                                    <ComboBoxItem Content="{DynamicResource Str_IdGen_KindNano}" Tag="NanoId" />
                                    <ComboBoxItem Content="{DynamicResource Str_IdGen_KindShort}" Tag="ShortCode" />
                                    <ComboBoxItem Content="{DynamicResource Str_IdGenerator_RandomHex}" Tag="Hex" />
                                    <ComboBoxItem Content="{DynamicResource Str_IdGenerator_LoremIpsum}" Tag="Lorem" />
                                </ComboBox>
                            </Border>
                            <TextBlock x:Name="TxtKindHint" Style="{StaticResource IgHint}" />
                        </StackPanel>
                    </Border>

                    <Border ctl:Tour.Key="Str_Tour_IdGenerator_Options" ctl:Tour.Order="2" Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl Content="{DynamicResource Str_Rest_Options}" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.TuneVariant}" />

                            <StackPanel x:Name="PanelCount">
                                <TextBlock Style="{StaticResource IgLabel}" Text="{DynamicResource Str_IdGenerator_HowMany}" />
                                <Border Style="{StaticResource InputBarStyle}">
                                    <TextBox x:Name="TxtCount" VerticalContentAlignment="Center" Style="{StaticResource BareTextBox}" TextChanged="Option_TextChanged" />
                                </Border>
                            </StackPanel>

                            <StackPanel x:Name="PanelHex" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource IgLabel}" Text="{DynamicResource Str_IdGenerator_BytesPerValue}" />
                                <Border Style="{StaticResource InputBarStyle}">
                                    <TextBox x:Name="TxtHexBytes" VerticalContentAlignment="Center" Style="{StaticResource BareTextBox}" TextChanged="Option_TextChanged" />
                                </Border>
                            </StackPanel>

                            <StackPanel x:Name="PanelLength" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource IgLabel}" Text="{DynamicResource Str_IdGen_Length}" />
                                <Border Style="{StaticResource InputBarStyle}">
                                    <TextBox x:Name="TxtLength" VerticalContentAlignment="Center" Style="{StaticResource BareTextBox}" TextChanged="Option_TextChanged" />
                                </Border>
                            </StackPanel>

                            <StackPanel x:Name="PanelLorem" Visibility="Collapsed">
                                <TextBlock Style="{StaticResource IgLabel}" Text="{DynamicResource Str_IdGenerator_Paragraphs}" />
                                <Border Style="{StaticResource InputBarStyle}">
                                    <TextBox x:Name="TxtParagraphs" VerticalContentAlignment="Center" Style="{StaticResource BareTextBox}" TextChanged="Option_TextChanged" />
                                </Border>
                            </StackPanel>

                            <StackPanel x:Name="PanelCase" Margin="0,10,0,0">
                                <CheckBox x:Name="ChkUpper" Click="Option_Click" Content="{DynamicResource Str_IdGenerator_UpperCase}" />
                                <CheckBox x:Name="ChkNoHyphens" Margin="0,6,0,0" Click="Option_Click" Content="{DynamicResource Str_IdGenerator_RemoveHyphens}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border x:Name="PanelFormat" Margin="0,10,0,0" Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl Content="{DynamicResource Str_IdGen_FormatHeader}" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.FormatText}" />

                            <TextBlock Style="{StaticResource IgLabel}" Text="{DynamicResource Str_IdGen_WrapLabel}" />
                            <Border Style="{StaticResource InputBarStyle}">
                                <ComboBox x:Name="CmbWrap" VerticalContentAlignment="Center" SelectedIndex="0" SelectionChanged="Format_SelectionChanged" Style="{StaticResource BareComboBox}">
                                    <ComboBoxItem Content="{DynamicResource Str_IdGen_WrapPlain}" Tag="Plain" />
                                    <ComboBoxItem Content="{DynamicResource Str_IdGen_WrapJson}" Tag="JsonArray" />
                                    <ComboBoxItem Content="{DynamicResource Str_IdGen_WrapSql}" Tag="SqlIn" />
                                    <ComboBoxItem Content="{DynamicResource Str_IdGen_WrapCsv}" Tag="Csv" />
                                </ComboBox>
                            </Border>

                            <StackPanel x:Name="PanelSeparator">
                                <TextBlock Style="{StaticResource IgLabel}" Text="{DynamicResource Str_IdGen_SeparatorLabel}" />
                                <Border Style="{StaticResource InputBarStyle}">
                                    <ComboBox x:Name="CmbSeparator" VerticalContentAlignment="Center" SelectedIndex="0" SelectionChanged="Format_SelectionChanged" Style="{StaticResource BareComboBox}">
                                        <ComboBoxItem Content="{DynamicResource Str_IdGen_SepNewLine}" Tag="NewLine" />
                                        <ComboBoxItem Content="{DynamicResource Str_IdGen_SepComma}" Tag="Comma" />
                                        <ComboBoxItem Content="{DynamicResource Str_IdGen_SepCommaSpace}" Tag="CommaSpace" />
                                        <ComboBoxItem Content="{DynamicResource Str_IdGen_SepSpace}" Tag="Space" />
                                        <ComboBoxItem Content="{DynamicResource Str_IdGen_SepSemicolon}" Tag="Semicolon" />
                                        <ComboBoxItem Content="{DynamicResource Str_IdGen_SepTab}" Tag="Tab" />
                                        <ComboBoxItem Content="{DynamicResource Str_IdGen_SepNone}" Tag="None" />
                                    </ComboBox>
                                </Border>
                            </StackPanel>

                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Style="{StaticResource IgLabel}" Text="{DynamicResource Str_IdGen_PrefixLabel}" />
                                    <Border Style="{StaticResource InputBarStyle}">
                                        <TextBox x:Name="TxtPrefix" VerticalContentAlignment="Center" FontFamily="Consolas" Style="{StaticResource BareTextBox}" TextChanged="Option_TextChanged" />
                                    </Border>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Style="{StaticResource IgLabel}" Text="{DynamicResource Str_IdGen_SuffixLabel}" />
                                    <Border Style="{StaticResource InputBarStyle}">
                                        <TextBox x:Name="TxtSuffix" VerticalContentAlignment="Center" FontFamily="Consolas" Style="{StaticResource BareTextBox}" TextChanged="Option_TextChanged" />
                                    </Border>
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource IgHint}" Text="{DynamicResource Str_IdGen_FormatHint}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </controls:ToolSidebar>

            <!--  ================= MAIN AREA =================  -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!--  ========== Actions ==========  -->
                <Border Style="{StaticResource CardStyle}">
                    <DockPanel>
                        <!--  Actions on the left (the main one first), the result on the right  -->
                        <StackPanel DockPanel.Dock="Left" Orientation="Horizontal">
                            <Button ctl:Tour.Key="Str_Tour_IdGenerator_Generate" ctl:Tour.Order="3" x:Name="BtnGenerate" MinHeight="36" Margin="0,0,8,0" Click="BtnGenerate_Click" Style="{StaticResource AccentPrimaryButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center" Kind="Refresh" />
                                    <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_IdGenerator_GenerateAgain}" />
                                </StackPanel>
                            </Button>
                            <Button ctl:Tour.Key="Str_Tour_IdGenerator_Copy" ctl:Tour.Order="4" x:Name="BtnCopy" MinHeight="36" Margin="0,0,8,0" Click="BtnCopy_Click" ToolTip="{DynamicResource Str_IdGenerator_CopyEverything}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,6,0" Kind="ContentCopy" />
                                    <TextBlock Text="{DynamicResource Str_Common_Copy}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnSave" MinHeight="36" Click="BtnSave_Click" ToolTip="{DynamicResource Str_IdGenerator_SaveToAText}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,6,0" Kind="ContentSaveOutline" />
                                    <TextBlock Text="{DynamicResource Str_Code_Save}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                        <StackPanel HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource Str_FileConverter_Result}" TextAlignment="Right" />
                            <TextBlock x:Name="TxtInfo" Margin="0,2,0,0" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" TextAlignment="Right" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!--  ========== Output ==========  -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ContentControl Margin="0,0,0,10" Content="{DynamicResource Str_IdGenerator_Values}" Style="{StaticResource CardHeader}" Tag="{x:Static materialDesign:PackIconKind.FormatListNumbered}" />
                        <Border Grid.Row="1" Background="{DynamicResource RowBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="12">
                            <TextBox x:Name="TxtOutput" Height="Auto" Padding="14" VerticalContentAlignment="Top" TextWrapping="NoWrap" Background="Transparent" BorderThickness="0" FontFamily="Cascadia Mono, Consolas" FontSize="14" Foreground="{DynamicResource TextPrimary}" HorizontalScrollBarVisibility="Auto" IsReadOnly="True" VerticalScrollBarVisibility="Auto" />
                        </Border>
                    </Grid>
                </Border>

                <!--  ========== Inspect an ID ==========  -->
                <Border Grid.Row="4" ctl:Tour.Key="Str_Tour_IdGenerator_Inspect" ctl:Tour.Order="5" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <ContentControl Margin="0,0,0,10" Content="{DynamicResource Str_IdGen_InspectHeader}" Style="{StaticResource CardHeader}" Tag="{x:Static materialDesign:PackIconKind.MagnifyScan}" />
                        <Border Padding="0,0,4,0" Style="{StaticResource InputBarStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBox x:Name="TxtInspect" VerticalContentAlignment="Center" FontFamily="Consolas" Style="{StaticResource BareTextBox}" Tag="{DynamicResource Str_IdGen_InspectHint}" TextChanged="Inspect_TextChanged" />
                                <Button Padding="0" x:Name="BtnInspectPaste" Grid.Column="1" Width="28" Height="28" Margin="2,4" Click="BtnInspectPaste_Click" Style="{StaticResource NeutralIconButtonStyle}" ToolTip="{DynamicResource Str_ColorPicker_Paste}">
                                    <materialDesign:PackIcon Width="15" Height="15" Kind="ContentPaste" />
                                </Button>
                            </Grid>
                        </Border>
                        <StackPanel x:Name="PanelInspectResult" Margin="2,10,0,0" Visibility="Collapsed">
                            <TextBlock x:Name="TxtInspectTitle" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock x:Name="TxtInspectLines" Margin="0,4,0,0" FontSize="12.5" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                        </StackPanel>
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
