<UserControl
    x:Class="Smart_Tools.WPF.Views.MetronomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    x:Name="Root"
    Focusable="True"
    PreviewKeyDown="Root_PreviewKeyDown"
    Loaded="Root_Loaded"
    Unloaded="Root_Unloaded">

    <!--  Backend: Controllers/MetronomeManager.cs (tempo, tap tempo, one bar of clicks). UI and the sound device here.  -->

    <UserControl.Resources>
        <Style x:Key="MtLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarText}" />
            <Setter Property="Margin" Value="2,10,0,4" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">
        <Grid Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= OPTIONS SIDEBAR =================  -->
            <controls:ToolSidebar>
                <StackPanel>
                    <Border ctl:Tour.Key="Str_Tour_Metronome_Beat" ctl:Tour.Order="1" Margin="0,0,0,10" Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl Content="{DynamicResource Str_Metronome_Beat}" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.MusicNoteQuarter}" />
                            <TextBlock Style="{StaticResource MtLabel}" Text="{DynamicResource Str_Metronome_BeatsPerBar}" />
                            <Border Style="{StaticResource InputBarStyle}">
                                <ComboBox x:Name="CmbBeats" VerticalContentAlignment="Center" SelectionChanged="Beats_SelectionChanged" Style="{StaticResource BareComboBox}" />
                            </Border>
                            <CheckBox
                                x:Name="ChkAccent"
                                Margin="0,12,0,0"
                                Click="Accent_Click"
                                Content="{DynamicResource Str_Metronome_AccentTheFirstBeat}"
                                IsChecked="True"
                                controls:ChoiceIcon.Kind="MusicNote"
                                Style="{StaticResource ToggleChipCheckBoxStyle}" />
                        </StackPanel>
                    </Border>

                    <Border ctl:Tour.Key="Str_Tour_Metronome_Volume" ctl:Tour.Order="2" Margin="0,0,0,10" Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl Content="{DynamicResource Str_TTS_Volume}" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.VolumeHigh}" />
                            <Slider x:Name="SliderVolume" Margin="0,10,0,0" Maximum="100" Minimum="0" SmallChange="5" LargeChange="10" Value="70" ValueChanged="Volume_ValueChanged" />
                        </StackPanel>
                    </Border>

                    <Border ctl:Tour.Key="Str_Tour_Metronome_Keys" ctl:Tour.Order="3" Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl Content="{DynamicResource Str_MidiInstruments_Keys}" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.KeyboardOutline}" />
                            <TextBlock Margin="2,8,0,0" FontSize="11" Foreground="{DynamicResource SidebarText}" TextWrapping="Wrap" Text="{DynamicResource Str_Metronome_SpaceStartsAndStops}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </controls:ToolSidebar>

            <!--  ================= MAIN AREA =================  -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" MinHeight="200" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="1.15*" MinHeight="260" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="300" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" MinWidth="300" />
                </Grid.ColumnDefinitions>

                <!--  ========== The tempo ==========  -->
                <Border Grid.ColumnSpan="3" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button Padding="0" x:Name="BtnMinus" Width="56" Height="56" Margin="10,0" VerticalAlignment="Center" Click="BtnMinus_Click" Style="{StaticResource NeutralIconButtonStyle}" ToolTip="{DynamicResource Str_Metronome_SlowerDownArrow}">
                            <materialDesign:PackIcon Width="26" Height="26" Kind="Minus" />
                        </Button>
                        <Grid Grid.Column="1">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Viewbox MaxHeight="190" Stretch="Uniform">
                                <TextBlock x:Name="TxtBpm" FontSize="120" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Text="100" />
                            </Viewbox>
                            <TextBlock Grid.Row="1" HorizontalAlignment="Center" FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource Str_Metronome_BeatsPerMinute}" />
                            <TextBlock x:Name="TxtTempoName" Grid.Row="2" Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="16" FontStyle="Italic" Foreground="{DynamicResource AccentColor}" />
                        </Grid>
                        <Button Padding="0" x:Name="BtnPlus" Grid.Column="2" Width="56" Height="56" Margin="10,0" VerticalAlignment="Center" Click="BtnPlus_Click" Style="{StaticResource NeutralIconButtonStyle}" ToolTip="{DynamicResource Str_Metronome_FasterUpArrow}">
                            <materialDesign:PackIcon Width="26" Height="26" Kind="Plus" />
                        </Button>
                    </Grid>
                </Border>

                <!--  ========== Beat and controls ==========  -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <ContentControl Margin="0,0,0,6" Content="{DynamicResource Str_Metronome_Beat}" Style="{StaticResource CardHeader}" Tag="{x:Static materialDesign:PackIconKind.Metronome}" />
                        <Viewbox Grid.Row="1" Margin="8" MaxHeight="120" Stretch="Uniform">
                            <ItemsControl x:Name="BeatDots">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Ellipse Width="44" Height="44" Margin="10,0" Fill="{Binding Fill}" Stroke="{DynamicResource CardBorder}" StrokeThickness="1" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </Viewbox>
                        <StackPanel Grid.Row="2" HorizontalAlignment="Center" Orientation="Horizontal">
                            <Button ctl:Tour.Key="Str_Tour_Metronome_Start" ctl:Tour.Order="4" x:Name="BtnStart" MinWidth="150" MinHeight="44" Margin="0,0,10,0" Click="BtnStart_Click" Style="{StaticResource AccentPrimaryButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon x:Name="IconStart" Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center" Kind="Play" />
                                    <TextBlock x:Name="TxtStart" VerticalAlignment="Center" Text="{DynamicResource Str_RenameFiles_Start}" />
                                </StackPanel>
                            </Button>
                            <Button x:Name="BtnTap" MinWidth="120" MinHeight="44" Click="BtnTap_Click" ToolTip="{DynamicResource Str_Metronome_TapAlongToThe}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="18" Height="18" Margin="0,0,6,0" VerticalAlignment="Center" Kind="GestureTap" />
                                    <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_Metronome_TapTempo}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  ========== Tempo slider and presets ==========  -->
                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource CardStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <ContentControl Margin="0,0,0,12" Content="{DynamicResource Str_Metronome_Tempo}" Style="{StaticResource CardHeader}" Tag="{x:Static materialDesign:PackIconKind.SpeedometerMedium}" />
                        <Slider ctl:Tour.Key="Str_Tour_Metronome_Tempo" ctl:Tour.Order="5" x:Name="SliderBpm" IsMoveToPointEnabled="True" LargeChange="10" Maximum="300" Minimum="20" SmallChange="1" TickFrequency="10" Value="100" ValueChanged="Bpm_ValueChanged" />
                        <DockPanel Margin="0,2,0,0">
                            <TextBlock DockPanel.Dock="Right" FontSize="11" Foreground="{DynamicResource TextSecondary}" Text="300" />
                            <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondary}" Text="20" />
                        </DockPanel>

                        <TextBlock Margin="0,18,0,8" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource Str_Metronome_CommonTempos}" />
                        <WrapPanel>
                            <Button MinHeight="34" Margin="0,0,6,6" Click="Preset_Click" Content="{DynamicResource Str_Metronome_Largo}" Tag="50" />
                            <Button MinHeight="34" Margin="0,0,6,6" Click="Preset_Click" Content="{DynamicResource Str_Metronome_Adagio}" Tag="70" />
                            <Button MinHeight="34" Margin="0,0,6,6" Click="Preset_Click" Content="{DynamicResource Str_Metronome_Andante}" Tag="90" />
                            <Button MinHeight="34" Margin="0,0,6,6" Click="Preset_Click" Content="{DynamicResource Str_Metronome_Moderato}" Tag="110" />
                            <Button MinHeight="34" Margin="0,0,6,6" Click="Preset_Click" Content="{DynamicResource Str_Metronome_Allegro}" Tag="130" />
                            <Button MinHeight="34" Margin="0,0,6,6" Click="Preset_Click" Content="{DynamicResource Str_Metronome_Vivace}" Tag="168" />
                            <Button MinHeight="34" Margin="0,0,6,6" Click="Preset_Click" Content="{DynamicResource Str_Metronome_Presto}" Tag="190" />
                        </WrapPanel>
                        <TextBlock x:Name="TxtMessage" Margin="0,10,0,0" FontSize="12" Foreground="{DynamicResource StatusErrorFg}" TextWrapping="Wrap" />
                    </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
