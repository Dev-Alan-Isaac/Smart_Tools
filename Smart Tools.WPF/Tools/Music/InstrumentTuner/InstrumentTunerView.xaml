<UserControl
    x:Class="Smart_Tools.WPF.Views.InstrumentTunerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    x:Name="Root"
    Loaded="Root_Loaded"
    Unloaded="Root_Unloaded">

    <!--
        Backend: Controllers/InstrumentTunerManager.cs (NAudio microphone,
        reference tone) + InstrumentTunerManager.Pitch.cs (YIN pitch
        detection, note names, needle smoothing, "in tune", presets,
        settings); Models/InstrumentTunerModel.cs. UI only here.
    -->

    <UserControl.Resources>

    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">

        <!--  No page header: MainWindow's header card shows the tool's icon and name.  -->

        <Grid Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OptionsColumn" Width="280" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= SIDEBAR =================  -->

            <Border Grid.Column="0" Style="{StaticResource SidebarPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Button
                            x:Name="BtnCollapseOptions"
                            MinHeight="45"
                            HorizontalContentAlignment="Left"
                            Click="BtnCollapseOptions_Click"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Foreground="{DynamicResource SidebarText}"
                            ToolTip="{DynamicResource Str_Common_SidebarToggleTooltip}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="OverridesDefaultStyle" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Margin="16,0,0,0" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Kind="TuneVariant" />
                                <TextBlock
                                    x:Name="TxtOptionsHeaderLabel"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{DynamicResource Str_Common_OptionsLabel}" />
                            </StackPanel>
                        </Button>

                        <Separator
                            x:Name="SepHeader"
                            Margin="16,4"
                            Style="{StaticResource SidebarSeparatorStyle}" />
                    </StackPanel>

                    <ScrollViewer
                        x:Name="OptionsScrollViewer"
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16">

                            <!--  ============ INSTRUMENT ============  -->
                            <Border ctl:Tour.Key="Str_Tour_Tuner_Instrument" ctl:Tour.Order="1" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_InstrumentTuner_Instrument}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.GuitarAcoustic}" />
                                    <Border Style="{StaticResource InputBarStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon
                                                x:Name="IconPreset"
                                                Width="16"
                                                Height="16"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource AccentColor}"
                                                Kind="MusicNote" />
                                            <ComboBox
                                                x:Name="CmbInstrumentPreset"
                                                Grid.Column="1"
                                                Margin="4,0,4,0"
                                                DisplayMemberPath="Name"
                                                SelectionChanged="CmbInstrumentPreset_SelectionChanged"
                                                Style="{StaticResource BareComboBox}"
                                                ToolTip="{DynamicResource Str_InstrumentTuner_ChromaticNamesAnyNote}" />
                                        </Grid>
                                    </Border>
                                    <TextBlock
                                        x:Name="TxtPresetHint"
                                        Style="{StaticResource SidebarHint}"
                                        Text="" />
                                </StackPanel>
                            </Border>

                            <!--  ============ MICROPHONE ============  -->
                            <Border ctl:Tour.Key="Str_Tour_Tuner_Mic" ctl:Tour.Order="2" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <ContentControl
                                            Content="{DynamicResource Str_MicRecorder_Device}"
                                            Style="{StaticResource SidebarGroupHeader}"
                                            Tag="{x:Static materialDesign:PackIconKind.MicrophoneOutline}" />
                                        <Button
                                            x:Name="BtnRefreshDevices"
                                            Margin="0,-6,0,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Click="BtnRefreshDevices_Click"
                                            ToolTip="{DynamicResource Str_InstrumentTuner_LookAgainAfterPlugging}"
                                            Style="{StaticResource ListToolButtonStyle}">
                                            <materialDesign:PackIcon
                                                x:Name="IconRefresh"
                                                Width="15"
                                                Height="15"
                                                Kind="Refresh"
                                                RenderTransformOrigin="0.5,0.5" />
                                        </Button>
                                    </Grid>
                                    <Border Style="{StaticResource InputBarStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon
                                                Width="16"
                                                Height="16"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource TextSecondary}"
                                                Kind="Microphone" />
                                            <ComboBox
                                                x:Name="CmbInputDevice"
                                                Grid.Column="1"
                                                Margin="4,0,4,0"
                                                DisplayMemberPath="Name"
                                                SelectionChanged="CmbInputDevice_SelectionChanged"
                                                Style="{StaticResource BareComboBox}"
                                                ToolTip="{DynamicResource Str_InstrumentTuner_TheMicrophoneTheTuner}" />
                                        </Grid>
                                    </Border>

                                    <TextBlock
                                        Margin="0,12,0,6"
                                        Style="{StaticResource FieldLabel}"
                                        Text="{DynamicResource Str_InstrumentTuner_Sensitivity}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <RadioButton
                                            x:Name="RadioSensLow"
                                            Click="Sensitivity_Click"
                                            Content="{DynamicResource Str_InstrumentTuner_Low}"
                                            GroupName="TunerSensitivity"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="Low"
                                            ToolTip="{DynamicResource Str_InstrumentTuner_IgnoresBackgroundNoiseLoud}" />
                                        <RadioButton
                                            x:Name="RadioSensNormal"
                                            Grid.Column="2"
                                            Click="Sensitivity_Click"
                                            Content="{DynamicResource Str_ImageConvertPDF_Normal}"
                                            GroupName="TunerSensitivity"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="Normal" />
                                        <RadioButton
                                            x:Name="RadioSensHigh"
                                            Grid.Column="4"
                                            Click="Sensitivity_Click"
                                            Content="{DynamicResource Str_ImageConvertPDF_High}"
                                            GroupName="TunerSensitivity"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="High"
                                            ToolTip="{DynamicResource Str_InstrumentTuner_HearsQuietInstrumentsAnd}" />
                                    </Grid>
                                    <TextBlock
                                        x:Name="TxtMicHint"
                                        Style="{StaticResource SidebarHint}"
                                        Text="{DynamicResource Str_InstrumentTuner_PlayOneStringAt}" />
                                </StackPanel>
                            </Border>

                            <!--  ============ REFERENCE ============  -->
                            <Border ctl:Tour.Key="Str_Tour_Tuner_Reference" ctl:Tour.Order="3" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_InstrumentTuner_ReferencePitch}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.SineWave}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{DynamicResource SidebarTextMuted}"
                                            Style="{DynamicResource FieldLabel}"
                                            Text="A4 =" />
                                        <Border Grid.Column="1" Style="{StaticResource SliderValuePill}">
                                            <TextBlock
                                                x:Name="TxtA4Value"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="White"
                                                Text="440 Hz" />
                                        </Border>
                                    </Grid>
                                    <Slider
                                        x:Name="SldA4Reference"
                                        Margin="0,6,0,0"
                                        IsMoveToPointEnabled="True"
                                        IsSnapToTickEnabled="True"
                                        Maximum="466"
                                        Minimum="415"
                                        TickFrequency="1"
                                        ToolTip="{DynamicResource Str_InstrumentTuner_440HzIsStandard}"
                                        ValueChanged="SldA4Reference_ValueChanged"
                                        Value="440" />
                                    <UniformGrid Margin="0,8,0,0" Columns="3">
                                        <Button
                                            Margin="0,0,3,0"
                                            Click="BtnA4Preset_Click"
                                            Content="432"
                                            Style="{StaticResource SegmentedActionButtonStyle}"
                                            Tag="432" />
                                        <Button
                                            Margin="3,0"
                                            Click="BtnA4Preset_Click"
                                            Content="440"
                                            Style="{StaticResource SegmentedActionButtonStyle}"
                                            Tag="440" />
                                        <Button
                                            Margin="3,0,0,0"
                                            Click="BtnA4Preset_Click"
                                            Content="442"
                                            Style="{StaticResource SegmentedActionButtonStyle}"
                                            Tag="442" />
                                    </UniformGrid>
                                </StackPanel>
                            </Border>

                            <!--  ============ NOTATION ============  -->
                            <Border Margin="0,0,0,4" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_InstrumentTuner_NoteNames}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.Alphabetical}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <RadioButton
                                            x:Name="BtnNotationLetter"
                                            Click="Notation_Click"
                                            Content="C D E"
                                            GroupName="NotationMode"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            ToolTip="{DynamicResource Str_InstrumentTuner_LetterNames}" />
                                        <RadioButton
                                            x:Name="BtnNotationSolfege"
                                            Grid.Column="2"
                                            Click="Notation_Click"
                                            Content="Do Re Mi"
                                            GroupName="NotationMode"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            ToolTip="{DynamicResource Str_InstrumentTuner_SolfGeNames}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--  ================= MAIN =================  -->

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  ============ LISTEN BAR ============  -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            ctl:Tour.Key="Str_Tour_Tuner_Listen" ctl:Tour.Order="4"
                            x:Name="BtnListen"
                            MinWidth="160"
                            Click="BtnListen_Click"
                            Style="{StaticResource AccentPrimaryButtonStyle}">
                            <Grid HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon
                                    Grid.Column="0"
                                    x:Name="IconListen"
                                    Width="18"
                                    Height="18"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Kind="Microphone" />
                                <TextBlock
                                    Grid.Column="1"
                                    x:Name="TxtListenLabel"
                                    VerticalAlignment="Center"
                                    Text="{DynamicResource Str_InstrumentTuner_StartTuning}" TextWrapping="Wrap" />
                            </Grid>
                        </Button>
                        <StackPanel
                            Grid.Column="1"
                            Margin="16,0,12,0"
                            VerticalAlignment="Center">
                            <TextBlock
                                x:Name="TxtMicStatus"
                                FontSize="12.5"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="{DynamicResource Str_InstrumentTuner_PressStartTuningThen}"
                                TextTrimming="CharacterEllipsis" />
                            <Border
                                Height="6"
                                Margin="0,6,0,0"
                                Background="{DynamicResource RowBg}"
                                CornerRadius="3"
                                ToolTip="{DynamicResource Str_InstrumentTuner_HowLoudTheMicrophone}">
                                <Border
                                    x:Name="LevelFill"
                                    Background="{DynamicResource AccentColor}"
                                    CornerRadius="3"
                                    RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="LevelScale" ScaleX="0" />
                                    </Border.RenderTransform>
                                </Border>
                            </Border>
                            <!--  Where the tuner starts listening: the bar must pass this tick (it learns the room's noise)  -->
                            <Grid Height="4" Margin="0,2,0,0" IsHitTestVisible="False">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition x:Name="GateBefore" Width="0*" />
                                    <ColumnDefinition x:Name="GateAfter" Width="1*" />
                                </Grid.ColumnDefinitions>
                                <Border
                                    Grid.Column="1"
                                    Width="2"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource TextSecondary}"
                                    CornerRadius="1" />
                            </Grid>
                        </StackPanel>
                        <Border
                            x:Name="InTunePill"
                            Grid.Column="2"
                            Background="{DynamicResource StatusSuccessBg}"
                            RenderTransformOrigin="0.5,0.5"
                            Style="{StaticResource IconStatusPillStyle}"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="15"
                                    Height="15"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource StatusSuccessFg}"
                                    Kind="CheckCircle" />
                                <TextBlock
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource StatusSuccessFg}"
                                    Text="{DynamicResource Str_InstrumentTuner_InTune}" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!--  ============ TUNER ============  -->
                <Border ctl:Tour.Key="Str_Tour_Tuner_Meter" ctl:Tour.Order="5" Grid.Row="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  Note  -->
                        <StackPanel
                            Grid.Row="0"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <StackPanel HorizontalAlignment="Center" Orientation="Horizontal">
                                <TextBlock
                                    x:Name="TxtNoteName"
                                    FontSize="110"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource TextSecondary}"
                                    RenderTransformOrigin="0.5,0.5"
                                    Text="–" />
                                <TextBlock
                                    x:Name="TxtOctave"
                                    Margin="4,0,0,22"
                                    VerticalAlignment="Bottom"
                                    FontSize="30"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="" />
                            </StackPanel>
                            <TextBlock
                                x:Name="TxtGuidance"
                                HorizontalAlignment="Center"
                                FontSize="16"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="{DynamicResource Str_InstrumentTuner_WaitingForANote}" />
                            <TextBlock
                                x:Name="TxtFrequency"
                                Margin="0,6,0,0"
                                HorizontalAlignment="Center"
                                FontSize="13"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="" />
                        </StackPanel>

                        <!--  Cents gauge: green centre, amber, red edges  -->
                        <Grid
                            Grid.Row="1"
                            MaxWidth="640"
                            Margin="24,0,24,18">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Height="44">
                                <Grid
                                    Height="10"
                                    VerticalAlignment="Center"
                                    Opacity="0.55">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="35*" />
                                        <ColumnDefinition Width="10*" />
                                        <ColumnDefinition Width="10*" />
                                        <ColumnDefinition Width="10*" />
                                        <ColumnDefinition Width="35*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Background="{DynamicResource StatusErrorFg}" CornerRadius="5,0,0,5" />
                                    <Border Grid.Column="1" Background="{DynamicResource StatusWarningFg}" />
                                    <Border Grid.Column="2" Background="{DynamicResource StatusSuccessFg}" />
                                    <Border Grid.Column="3" Background="{DynamicResource StatusWarningFg}" />
                                    <Border
                                        Grid.Column="4"
                                        Background="{DynamicResource StatusErrorFg}"
                                        CornerRadius="0,5,5,0" />
                                </Grid>
                                <Rectangle
                                    Width="2"
                                    Height="30"
                                    HorizontalAlignment="Center"
                                    Fill="{DynamicResource TextPrimary}"
                                    Opacity="0.6" />
                                <Canvas
                                    x:Name="CentsMeterCanvas"
                                    ClipToBounds="False"
                                    SizeChanged="CentsMeterCanvas_SizeChanged">
                                    <Border
                                        x:Name="CentsMeterNeedle"
                                        Canvas.Top="4"
                                        Width="10"
                                        Height="36"
                                        Background="{DynamicResource AccentColor}"
                                        BorderBrush="{DynamicResource CardBg}"
                                        BorderThickness="2"
                                        CornerRadius="5"
                                        Opacity="0.35" />
                                </Canvas>
                            </Grid>
                            <Grid Grid.Row="1" Margin="0,4,0,0">
                                <TextBlock
                                    HorizontalAlignment="Left"
                                    FontSize="11.5"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{DynamicResource Str_InstrumentTuner_Flat50}" />
                                <TextBlock
                                    x:Name="TxtCentsValue"
                                    HorizontalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimary}"
                                    Text="0¢" />
                                <TextBlock
                                    HorizontalAlignment="Right"
                                    FontSize="11.5"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{DynamicResource Str_InstrumentTuner_50Sharp}" />
                            </Grid>
                        </Grid>

                        <!--  Strings: the one being played lights up; click one to hear its note  -->
                        <StackPanel x:Name="StringsPanel" Grid.Row="2">
                            <TextBlock
                                Margin="0,0,0,8"
                                HorizontalAlignment="Center"
                                FontSize="11.5"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="{DynamicResource Str_InstrumentTuner_ClickAStringTo}" />
                            <ItemsControl x:Name="StringStrip" HorizontalAlignment="Center">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <StackPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                            </ItemsControl>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
