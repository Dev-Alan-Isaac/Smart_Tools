<UserControl
    x:Class="Smart_Tools.WPF.Views.SynthesizerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    x:Name="Root"
    FocusVisualStyle="{x:Null}"
    Focusable="True"
    Loaded="Root_Loaded"
    PreviewKeyDown="Root_PreviewKeyDown"
    PreviewKeyUp="Root_PreviewKeyUp"
    Unloaded="Root_Unloaded">

    <!--
        Same shape as MIDI Instruments: options sidebar on the left, a "now
        playing + recorder" card and the piano on the right. The audio engine
        (oscillator, ADSR, recording tap) lives in the code-behind; UI only here.
    -->

    <UserControl.Resources>




        <!--  A piano is black and white in either theme, so the keys use fixed colours; pressed = theme accent.  -->
        <SolidColorBrush x:Key="PianoWhiteKey" Color="#FBFAF6" />
        <SolidColorBrush x:Key="PianoWhiteKeyEdge" Color="#C9C6BD" />
        <SolidColorBrush x:Key="PianoWhiteKeyText" Color="#6B6A66" />
        <SolidColorBrush x:Key="PianoBlackKey" Color="#1F232B" />
        <SolidColorBrush x:Key="PianoBlackKeyEdge" Color="#0E1015" />
        <SolidColorBrush x:Key="PianoBlackKeyText" Color="#C8CBD2" />

    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">

        <!--  No page header: MainWindow's header card shows the tool's icon and name.  -->

        <Grid Margin="16,8,16,16">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="290" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= SIDEBAR =================  -->

            <Border Grid.Column="0" Style="{StaticResource SidebarPanelStyle}">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="16">

                        <Border ctl:Tour.Key="Str_Tour_Synth_Oscillator" ctl:Tour.Order="1" Style="{StaticResource SidebarGroupCardStyle}">
                            <StackPanel>
                                <ContentControl
                                    Content="{DynamicResource Str_Synth_OscillatorHeader}"
                                    Style="{StaticResource SidebarGroupHeader}"
                                    Tag="{x:Static materialDesign:PackIconKind.SineWave}" />

                                <TextBlock Style="{StaticResource SliderLabel}" Text="{DynamicResource Str_Synth_Waveform}" />
                                <Border Margin="0,6,0,0" Style="{StaticResource InputBarStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon
                                            Width="16"
                                            Height="16"
                                            Margin="10,0,0,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource AccentColor}"
                                            Kind="SineWave" />
                                        <ComboBox
                                            x:Name="WaveformCombo"
                                            Grid.Column="1"
                                            Margin="4,0,4,0"
                                            SelectionChanged="WaveformCombo_SelectionChanged"
                                            Style="{StaticResource BareComboBox}"
                                            ToolTip="{DynamicResource Str_Synth_WaveformTooltip}">
                                            <ComboBoxItem
                                                Content="{DynamicResource Str_Synthesizer_Sine}"
                                                IsSelected="True"
                                                Tag="Sine" />
                                            <ComboBoxItem Content="{DynamicResource Str_ImageEditor_Square}" Tag="Square" />
                                            <ComboBoxItem Content="{DynamicResource Str_Synthesizer_Sawtooth}" Tag="Sawtooth" />
                                            <ComboBoxItem Content="{DynamicResource Str_Synthesizer_Triangle}" Tag="Triangle" />
                                        </ComboBox>
                                    </Grid>
                                </Border>
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Str_Synth_Octave}" />
                                    <Border Grid.Column="1" Style="{StaticResource SliderValuePill}">
                                        <TextBlock
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="White"
                                            Text="{Binding ElementName=OctaveSlider, Path=Value, StringFormat={}{0:+0;-0;0}}" />
                                    </Border>
                                </Grid>
                                <Slider
                                    x:Name="OctaveSlider"
                                    Margin="0,6,0,0"
                                    IsMoveToPointEnabled="True"
                                    IsSnapToTickEnabled="True"
                                    Maximum="2"
                                    Minimum="-2"
                                    TickFrequency="1"
                                    ToolTip="{DynamicResource Str_Synth_OctaveTooltip}"
                                    ValueChanged="ParamSlider_ValueChanged"
                                    Value="0" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Str_Synth_Detune}" />
                                    <Border Grid.Column="1" Style="{StaticResource SliderValuePill}">
                                        <TextBlock
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="White"
                                            Text="{Binding ElementName=DetuneSlider, Path=Value, StringFormat={}{0:+0;-0;0} ¢}" />
                                    </Border>
                                </Grid>
                                <Slider
                                    x:Name="DetuneSlider"
                                    Margin="0,6,0,0"
                                    IsMoveToPointEnabled="True"
                                    Maximum="50"
                                    Minimum="-50"
                                    ToolTip="{DynamicResource Str_Synth_DetuneTooltip}"
                                    ValueChanged="ParamSlider_ValueChanged"
                                    Value="0" />
                            </StackPanel>
                        </Border>

                        <Border ctl:Tour.Key="Str_Tour_Synth_Envelope" ctl:Tour.Order="2" Style="{StaticResource SidebarGroupCardStyle}">
                            <StackPanel>
                                <ContentControl
                                    Content="{DynamicResource Str_Synth_EnvelopeHeader}"
                                    Style="{StaticResource SidebarGroupHeader}"
                                    Tag="{x:Static materialDesign:PackIconKind.ChartBellCurve}" />

                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Str_Synth_Attack}" />
                                    <Border Grid.Column="1" Style="{StaticResource SliderValuePill}">
                                        <TextBlock
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="White"
                                            Text="{Binding ElementName=AttackSlider, Path=Value, StringFormat={}{0:0.00} s}" />
                                    </Border>
                                </Grid>
                                <Slider
                                    x:Name="AttackSlider"
                                    Margin="0,6,0,0"
                                    IsMoveToPointEnabled="True"
                                    Maximum="2"
                                    Minimum="0.005"
                                    ToolTip="{DynamicResource Str_Synth_AttackTooltip}"
                                    ValueChanged="ParamSlider_ValueChanged"
                                    Value="0.02" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Str_Synth_Decay}" />
                                    <Border Grid.Column="1" Style="{StaticResource SliderValuePill}">
                                        <TextBlock
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="White"
                                            Text="{Binding ElementName=DecaySlider, Path=Value, StringFormat={}{0:0.00} s}" />
                                    </Border>
                                </Grid>
                                <Slider
                                    x:Name="DecaySlider"
                                    Margin="0,6,0,0"
                                    IsMoveToPointEnabled="True"
                                    Maximum="2"
                                    Minimum="0.005"
                                    ToolTip="{DynamicResource Str_Synth_DecayTooltip}"
                                    ValueChanged="ParamSlider_ValueChanged"
                                    Value="0.15" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Str_Synth_Sustain}" />
                                    <Border Grid.Column="1" Style="{StaticResource SliderValuePill}">
                                        <TextBlock
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="White"
                                            Text="{Binding ElementName=SustainSlider, Path=Value, StringFormat={}{0:P0}}" />
                                    </Border>
                                </Grid>
                                <Slider
                                    x:Name="SustainSlider"
                                    Margin="0,6,0,0"
                                    IsMoveToPointEnabled="True"
                                    Maximum="1"
                                    Minimum="0"
                                    ToolTip="{DynamicResource Str_Synth_SustainTooltip}"
                                    ValueChanged="ParamSlider_ValueChanged"
                                    Value="0.7" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Str_Synth_Release}" />
                                    <Border Grid.Column="1" Style="{StaticResource SliderValuePill}">
                                        <TextBlock
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="White"
                                            Text="{Binding ElementName=ReleaseSlider, Path=Value, StringFormat={}{0:0.00} s}" />
                                    </Border>
                                </Grid>
                                <Slider
                                    x:Name="ReleaseSlider"
                                    Margin="0,6,0,0"
                                    IsMoveToPointEnabled="True"
                                    Maximum="3"
                                    Minimum="0.02"
                                    ToolTip="{DynamicResource Str_Synth_ReleaseTooltip}"
                                    ValueChanged="ParamSlider_ValueChanged"
                                    Value="0.3" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SidebarGroupCardStyle}">
                            <StackPanel>
                                <ContentControl
                                    Content="{DynamicResource Str_Synth_PlaybackHeader}"
                                    Style="{StaticResource SidebarGroupHeader}"
                                    Tag="{x:Static materialDesign:PackIconKind.TuneVertical}" />

                                <Grid Margin="0,0,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Str_Synth_Volume}" />
                                    <Border Grid.Column="1" Style="{StaticResource SliderValuePill}">
                                        <TextBlock
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="White"
                                            Text="{Binding ElementName=VolumeSlider, Path=Value, StringFormat={}{0:P0}}" />
                                    </Border>
                                </Grid>
                                <Slider
                                    x:Name="VolumeSlider"
                                    Margin="0,6,0,0"
                                    IsMoveToPointEnabled="True"
                                    Maximum="1"
                                    Minimum="0"
                                    ToolTip="{DynamicResource Str_Synth_VolumeTooltip}"
                                    ValueChanged="ParamSlider_ValueChanged"
                                    Value="0.5" />

                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <RadioButton
                                        x:Name="RadioPoly"
                                        Checked="ParamCheck_Changed"
                                        Content="{DynamicResource Str_Synth_ModePoly}"
                                        GroupName="SynthVoiceMode"
                                        IsChecked="True"
                                        Style="{StaticResource ModeToggleButtonStyle}"
                                        ToolTip="{DynamicResource Str_Synth_ModePolyTooltip}" />
                                    <RadioButton
                                        x:Name="RadioMono"
                                        Grid.Column="2"
                                        Checked="ParamCheck_Changed"
                                        Content="{DynamicResource Str_Synth_ModeMono}"
                                        GroupName="SynthVoiceMode"
                                        Style="{StaticResource ModeToggleButtonStyle}"
                                        ToolTip="{DynamicResource Str_Synth_ModeMonoTooltip}" />
                                </Grid>

                                <CheckBox
                                    x:Name="SustainPedalCheckBox"
                                    Margin="0,14,0,0"
                                    Checked="SustainPedalCheckBox_Checked"
                                    Content="{DynamicResource Str_Synth_Sustain_Pedal}"
                                    Foreground="{DynamicResource SidebarText}"
                                    ToolTip="{DynamicResource Str_Synth_SustainPedalTooltip}"
                                    Unchecked="SustainPedalCheckBox_Unchecked" />
                                <TextBlock Style="{StaticResource SidebarHint}" Text="{DynamicResource Str_Synth_SpaceHint}" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,0,0,4" Style="{StaticResource SidebarGroupCardStyle}">
                            <StackPanel>
                                <ContentControl
                                    Content="{DynamicResource Str_Synth_KeyboardHeader}"
                                    Style="{StaticResource SidebarGroupHeader}"
                                    Tag="{x:Static materialDesign:PackIconKind.KeyboardOutline}" />

                                <CheckBox
                                    x:Name="ChkShowNoteNames"
                                    Checked="KeyLabels_Changed"
                                    Content="{DynamicResource Str_Synth_ShowNoteNames}"
                                    Foreground="{DynamicResource SidebarText}"
                                    IsChecked="True"
                                    ToolTip="{DynamicResource Str_Synth_ShowNoteNamesTooltip}"
                                    Unchecked="KeyLabels_Changed" />
                                <CheckBox
                                    x:Name="ChkShowComputerKeys"
                                    Margin="0,6,0,0"
                                    Checked="KeyLabels_Changed"
                                    Content="{DynamicResource Str_Synth_ShowComputerKeys}"
                                    Foreground="{DynamicResource SidebarText}"
                                    IsChecked="True"
                                    ToolTip="{DynamicResource Str_Synth_ShowComputerKeysTooltip}"
                                    Unchecked="KeyLabels_Changed" />
                                <TextBlock Style="{StaticResource SidebarHint}" Text="{DynamicResource Str_Synth_KeyLayoutHint}" />
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Border>

            <!--  ================= MAIN =================  -->

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  ============ NOW PLAYING + RECORDER ============  -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Border
                                Width="56"
                                Height="56"
                                Margin="0,0,14,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource AccentColorSubtle}"
                                CornerRadius="16">
                                <materialDesign:PackIcon
                                    x:Name="IconWave"
                                    Width="30"
                                    Height="30"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource AccentColor}"
                                    Kind="SineWave" />
                            </Border>

                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock
                                    x:Name="TxtWaveName"
                                    FontSize="22"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimary}"
                                    Text="{DynamicResource Str_Synthesizer_Sine}"
                                    TextTrimming="CharacterEllipsis" />
                                <WrapPanel Margin="0,6,0,0">
                                    <Border
                                        Margin="0,0,6,4"
                                        Background="{DynamicResource RowBg}"
                                        Style="{StaticResource IconStatusPillStyle}">
                                        <TextBlock
                                            x:Name="TxtVoiceMode"
                                            FontSize="11.5"
                                            Foreground="{DynamicResource TextSecondary}"
                                            Text="{DynamicResource Str_Synth_ModePoly}" />
                                    </Border>
                                    <Border
                                        x:Name="SustainPill"
                                        Margin="0,0,6,4"
                                        Background="{DynamicResource StatusInfoBg}"
                                        Style="{StaticResource IconStatusPillStyle}"
                                        Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon
                                                Width="13"
                                                Height="13"
                                                Margin="0,0,5,0"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource StatusInfoFg}"
                                                Kind="MusicNoteWhole" />
                                            <TextBlock
                                                FontSize="11.5"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource StatusInfoFg}"
                                                Text="{DynamicResource Str_Synth_Sustain}" />
                                        </StackPanel>
                                    </Border>
                                </WrapPanel>
                            </StackPanel>

                            <!--  Last note played: big and friendly  -->
                            <StackPanel
                                Grid.Column="2"
                                MinWidth="110"
                                Margin="14,0,0,0"
                                VerticalAlignment="Center"
                                ToolTip="{DynamicResource Str_Synth_LastNoteTooltip}">
                                <TextBlock
                                    x:Name="TxtLastNote"
                                    HorizontalAlignment="Right"
                                    FontSize="30"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource AccentColor}"
                                    RenderTransformOrigin="0.5,0.5"
                                    Text="–" />
                                <TextBlock
                                    x:Name="TxtActiveNotes"
                                    HorizontalAlignment="Right"
                                    FontSize="11"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{DynamicResource Str_Synth_NoActiveNotes}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Grid>

                        <!--  Recorder  -->
                        <Border
                            Margin="0,14,0,0"
                            Padding="12,10"
                            Background="{DynamicResource RowBg}"
                            BorderBrush="{DynamicResource CardBorder}"
                            BorderThickness="1"
                            CornerRadius="12">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button
                                    ctl:Tour.Key="Str_Tour_Synth_Record" ctl:Tour.Order="3"
                                    x:Name="BtnRecord"
                                    MinWidth="118"
                                    Click="BtnRecord_Click"
                                    Style="{StaticResource AccentRedButtonStyle}"
                                    ToolTip="{DynamicResource Str_Synth_RecordToFileTooltip}">
                                    <Grid HorizontalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon
                                            Grid.Column="0"
                                            x:Name="IconRecord"
                                            Width="17"
                                            Height="17"
                                            Margin="0,0,7,0"
                                            VerticalAlignment="Center"
                                            Kind="RecordCircleOutline" />
                                        <TextBlock
                                            Grid.Column="1"
                                            x:Name="TxtRecordLabel"
                                            VerticalAlignment="Center"
                                            Text="{DynamicResource Str_MicRecorder_Record}" TextWrapping="Wrap" />
                                    </Grid>
                                </Button>

                                <StackPanel
                                    Grid.Column="1"
                                    Margin="14,0,8,0"
                                    VerticalAlignment="Center">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse
                                            x:Name="RecDot"
                                            Width="10"
                                            Height="10"
                                            Margin="0,0,7,0"
                                            VerticalAlignment="Center"
                                            Fill="{DynamicResource StatusErrorFg}"
                                            Opacity="0" />
                                        <TextBlock
                                            x:Name="TxtRecorderTime"
                                            FontFamily="Consolas"
                                            FontSize="18"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextPrimary}"
                                            Text="0:00" />
                                    </StackPanel>
                                    <TextBlock
                                        x:Name="StatusText"
                                        FontSize="11.5"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Text="{DynamicResource Str_Synth_ReadyStatus}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>

                                <Button
                                    x:Name="BtnPanic"
                                    Grid.Column="2"
                                    Click="BtnPanic_Click"
                                    Style="{StaticResource DangerButtonStyle}"
                                    ToolTip="{DynamicResource Str_Synth_PanicTooltip}">
                                    <Grid HorizontalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon
                                            Grid.Column="0"
                                            Width="16"
                                            Height="16"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            Kind="VolumeOff" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_Synth_Panic}" TextWrapping="Wrap" />
                                    </Grid>
                                </Button>
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!--  ============ PIANO ============  -->
                <Border ctl:Tour.Key="Str_Tour_Synth_Piano" ctl:Tour.Order="4" Grid.Row="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentControl
                                Content="{DynamicResource Str_MidiInstruments_Keys}"
                                Style="{StaticResource CardHeader}"
                                Tag="{x:Static materialDesign:PackIconKind.Piano}" />
                            <TextBlock
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="C3 – C6" />
                        </Grid>

                        <Border
                            Grid.Row="1"
                            MinHeight="150"
                            Padding="8,8,8,10"
                            Background="{DynamicResource PianoBlackKeyEdge}"
                            CornerRadius="14">
                            <Canvas
                                x:Name="PianoCanvas"
                                Background="Transparent"
                                ClipToBounds="True"
                                Cursor="Hand"
                                LostMouseCapture="PianoCanvas_LostMouseCapture"
                                MouseLeftButtonDown="PianoCanvas_MouseLeftButtonDown"
                                MouseLeftButtonUp="PianoCanvas_MouseLeftButtonUp"
                                MouseMove="PianoCanvas_MouseMove"
                                SizeChanged="PianoCanvas_SizeChanged" />
                        </Border>

                        <TextBlock
                            Grid.Row="2"
                            Margin="0,10,0,0"
                            FontSize="11.5"
                            Foreground="{DynamicResource TextSecondary}"
                            Text="{DynamicResource Str_Synth_KeyboardHint}"
                            TextWrapping="Wrap" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>

</UserControl>
