<UserControl
    x:Class="Smart_Tools.WPF.Views.VideoToAudioExtractorView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:models="clr-namespace:Smart_Tools.WPF.Models"
    x:Name="Root"
    AllowDrop="True"
    DragLeave="Root_DragLeave"
    DragOver="Root_DragOver"
    Drop="Root_Drop"
    Loaded="Root_Loaded"
    SizeChanged="Root_SizeChanged">

    <!--
        Backend: Controllers/VideoToAudioManager.cs (formats, ffmpeg arguments,
        estimates, the file list, settings) and VideoToAudioManager.Run.cs
        (ffprobe, the batch run); Models/VideoToAudioModel.cs. This file and
        the code-behind are UI only. Choices are read by Tag (enum name).
    -->

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!--  Grid: video icon  -->
        <DataTemplate x:Key="KindCellTemplate" DataType="{x:Type models:VtaFileItem}">
            <Border
                Width="30"
                Height="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource AccentColorSubtle}"
                CornerRadius="8">
                <materialDesign:PackIcon
                    x:Name="KindIcon"
                    Width="16"
                    Height="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource AccentColor}"
                    Kind="Filmstrip" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Done">
                    <Setter TargetName="KindIcon" Property="Kind" Value="MusicNote" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  Grid: name + folder  -->
        <DataTemplate x:Key="NameCellTemplate" DataType="{x:Type models:VtaFileItem}">
            <StackPanel VerticalAlignment="Center" ToolTip="{Binding FullPath}">
                <TextBlock
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimary}"
                    Text="{Binding Name}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Margin="0,1,0,0"
                    FontSize="11"
                    Foreground="{DynamicResource TextSecondary}"
                    Text="{Binding Folder}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <!--  Grid: the sound track - a combo when the video has several, else text  -->
        <DataTemplate x:Key="TrackCellTemplate" DataType="{x:Type models:VtaFileItem}">
            <Grid VerticalAlignment="Center">
                <TextBlock
                    x:Name="TrackText"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource TextSecondary}"
                    Text="{Binding TrackText}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding TrackText}" />
                <ComboBox
                    x:Name="TrackCombo"
                    Height="30"
                    DisplayMemberPath="Label"
                    IsEnabled="{Binding CanPickTrack}"
                    ItemsSource="{Binding Tracks}"
                    SelectedItem="{Binding SelectedTrack, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                    SelectionChanged="TrackCombo_SelectionChanged"
                    ToolTip="{DynamicResource Str_VideoToAudio_TrackComboTooltip}"
                    Visibility="Collapsed" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding HasSeveralTracks}" Value="True">
                    <Setter TargetName="TrackText" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="TrackCombo" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  Grid: estimated size before, real size after (green)  -->
        <DataTemplate x:Key="ResultCellTemplate" DataType="{x:Type models:VtaFileItem}">
            <TextBlock
                x:Name="ResultText"
                VerticalAlignment="Center"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextSecondary}"
                Text="{Binding ResultText}"
                TextTrimming="CharacterEllipsis" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Done">
                    <Setter TargetName="ResultText" Property="Foreground" Value="{DynamicResource StatusSuccessFg}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  Grid: status chip (+ live progress while extracting)  -->
        <DataTemplate x:Key="StatusCellTemplate" DataType="{x:Type models:VtaFileItem}">
            <StackPanel VerticalAlignment="Center" ToolTip="{Binding Message}">
                <Border
                    x:Name="Chip"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource StatusInfoBg}"
                    Style="{StaticResource IconStatusPillStyle}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            x:Name="ChipIcon"
                            Width="12"
                            Height="12"
                            Margin="0,0,4,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource StatusInfoFg}"
                            Kind="CheckCircleOutline" />
                        <TextBlock
                            x:Name="ChipText"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource StatusInfoFg}"
                            Text="{Binding StatusText}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
                <ProgressBar
                    Width="86"
                    Height="3"
                    Margin="2,4,0,0"
                    HorizontalAlignment="Left"
                    Maximum="100"
                    Visibility="{Binding IsWorking, Converter={StaticResource BoolToVisibility}}"
                    Value="{Binding Progress, Mode=OneWay}" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Reading">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource RowBg}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="ClockOutline" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource TextSecondary}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource TextSecondary}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="NoAudio">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusWarningBg}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="VolumeOff" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Unreadable">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusErrorBg}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="FileAlertOutline" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Extracting">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource AccentColorSubtle}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="Autorenew" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource AccentColor}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource AccentColor}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Done">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusSuccessBg}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="CheckCircleOutline" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource StatusSuccessFg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusSuccessFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusErrorBg}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="AlertCircleOutline" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusWarningBg}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="CloseCircleOutline" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>


        <!--  Input card: one queued item  -->
        <DataTemplate x:Key="QueueItemTemplate" DataType="{x:Type models:VtaQueueGroup}">
            <Grid ToolTip="{Binding ToolTip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="26"
                    Height="26"
                    Margin="0,0,8,0"
                    Background="{DynamicResource AccentColorSubtle}"
                    CornerRadius="7">
                    <materialDesign:PackIcon
                        x:Name="GroupIcon"
                        Width="14"
                        Height="14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource AccentColor}"
                        Kind="FileVideoOutline" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource SidebarText}"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Margin="0,1,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource SidebarTextMuted}"
                        Text="{Binding Subtitle}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button
                    Grid.Column="2"
                    Width="24"
                    Height="24"
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    Click="BtnRemoveQueueGroup_Click"
                    Style="{StaticResource IconButtonStyle}"
                    Tag="{Binding}"
                    ToolTip="{DynamicResource Str_Validate_RemoveFromListTooltip}">
                    <materialDesign:PackIcon
                        Width="13"
                        Height="13"
                        Kind="Close" />
                </Button>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                    <Setter TargetName="GroupIcon" Property="Kind" Value="Folder" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">

        <!--  No page header: MainWindow's header card shows the tool's icon and name.  -->

        <Grid Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OptionsColumn" Width="280" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= OPTIONS SIDEBAR =================  -->
            <Border Grid.Column="0" Style="{StaticResource SidebarPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Button
                            x:Name="BtnCollapseOptions"
                            MinHeight="45"
                            HorizontalContentAlignment="Left"
                            Click="BtnCollapseOptions_Click"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Foreground="{DynamicResource SidebarText}"
                            ToolTip="{DynamicResource Str_Common_SidebarToggleTooltip}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="OverridesDefaultStyle" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Margin="16,0,0,0" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Kind="TuneVariant" />
                                <TextBlock
                                    x:Name="TxtOptionsHeaderLabel"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{DynamicResource Str_Common_OptionsLabel}" />
                            </StackPanel>
                        </Button>
                        <Separator
                            x:Name="SepHeader"
                            Margin="16,4"
                            Style="{StaticResource SidebarSeparatorStyle}" />
                    </StackPanel>

                    <ScrollViewer
                        x:Name="OptionsScrollViewer"
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="OptionsPanel" Margin="16,4,16,16">

                            <!--  ============ FILES ============  -->
                            <controls:InputFolderCard
                                x:Name="InputCard"
                                ctl:Tour.Key="Str_Tour_VideoToAudio_Input"
                                ctl:Tour.Order="1"
                                ClearRequested="InputCard_ClearRequested"
                                Header="{DynamicResource Str_Common_Files}"
                                HeaderIcon="FileVideoOutline"
                                IncludeSubfoldersChanged="InputCard_IncludeSubfoldersChanged"
                                ItemTemplate="{StaticResource QueueItemTemplate}"
                                PathsAdded="InputCard_PathsAdded" />


                            <!--  ============ OUTPUT FORMAT ============  -->
                            <Border ctl:Tour.Key="Str_Tour_VideoToAudio_Format" ctl:Tour.Order="2" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_VideoToAudio_FormatHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.FileMusicOutline}" />

                                    <UniformGrid x:Name="FormatChips" Columns="4">
                                        <RadioButton
                                            Margin="0,0,2,0"
                                            Click="Setting_Click"
                                            Content="MP3"
                                            GroupName="VtaFormat"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="Mp3" />
                                        <RadioButton
                                            Margin="2,0"
                                            Click="Setting_Click"
                                            Content="M4A"
                                            GroupName="VtaFormat"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="M4a" />
                                        <RadioButton
                                            Margin="2,0"
                                            Click="Setting_Click"
                                            Content="WAV"
                                            GroupName="VtaFormat"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="Wav" />
                                        <RadioButton
                                            Margin="2,0,0,0"
                                            Click="Setting_Click"
                                            Content="FLAC"
                                            GroupName="VtaFormat"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="Flac" />
                                    </UniformGrid>

                                    <TextBlock
                                        x:Name="TxtFormatNote"
                                        Margin="0,8,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource SidebarTextMuted}"
                                        TextWrapping="Wrap" />

                                    <TextBlock
                                        Margin="0,12,0,6"
                                        Style="{StaticResource FieldLabel}"
                                        Text="{DynamicResource Str_VideoToAudio_Bitrate}" />
                                    <UniformGrid x:Name="BitrateChips" Columns="4">
                                        <RadioButton
                                            Margin="0,0,2,0"
                                            Click="Setting_Click"
                                            Content="128"
                                            GroupName="VtaBitrate"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="128" />
                                        <RadioButton
                                            Margin="2,0"
                                            Click="Setting_Click"
                                            Content="192"
                                            GroupName="VtaBitrate"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="192" />
                                        <RadioButton
                                            Margin="2,0"
                                            Click="Setting_Click"
                                            Content="256"
                                            GroupName="VtaBitrate"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="256" />
                                        <RadioButton
                                            Margin="2,0,0,0"
                                            Click="Setting_Click"
                                            Content="320"
                                            GroupName="VtaBitrate"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="320" />
                                    </UniformGrid>

                                    <TextBlock
                                        Margin="0,12,0,6"
                                        Style="{StaticResource FieldLabel}"
                                        Text="{DynamicResource Str_VideoToAudio_SampleRate}" />
                                    <ComboBox x:Name="CmbSampleRate" SelectionChanged="Setting_SelectionChanged">
                                        <ComboBoxItem
                                            Content="{DynamicResource Str_VideoToAudio_RateOriginal}"
                                            IsSelected="True"
                                            Tag="Original" />
                                        <ComboBoxItem Content="44.1 kHz" Tag="Hz44100" />
                                        <ComboBoxItem Content="48 kHz" Tag="Hz48000" />
                                    </ComboBox>

                                    <Border
                                        x:Name="FfmpegWarning"
                                        Margin="0,10,0,0"
                                        Padding="10,8"
                                        Background="{DynamicResource StatusWarningBg}"
                                        CornerRadius="8"
                                        Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon
                                                Width="14"
                                                Height="14"
                                                Margin="0,1,8,0"
                                                VerticalAlignment="Top"
                                                Foreground="{DynamicResource StatusWarningFg}"
                                                Kind="AlertOutline" />
                                            <TextBlock
                                                x:Name="TxtFfmpegWarning"
                                                Grid.Column="1"
                                                FontSize="11"
                                                Foreground="{DynamicResource StatusWarningFg}"
                                                TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!--  ============ SOUND TRACKS ============  -->
                            <Border Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_VideoToAudio_TracksHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.Waveform}" />
                                    <UniformGrid x:Name="TrackModeChips" Columns="2">
                                        <RadioButton
                                            Margin="0,0,2,0"
                                            Click="Setting_Click"
                                            Content="{DynamicResource Str_VideoToAudio_TrackChosen}"
                                            GroupName="VtaTrackMode"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="Chosen" />
                                        <RadioButton
                                            Margin="2,0,0,0"
                                            Click="Setting_Click"
                                            Content="{DynamicResource Str_VideoToAudio_TrackEvery}"
                                            GroupName="VtaTrackMode"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="Every" />
                                    </UniformGrid>
                                    <TextBlock
                                        x:Name="TxtTrackNote"
                                        Margin="0,8,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource SidebarTextMuted}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!--  ============ TAGS ============  -->
                            <Border Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_VideoToAudio_TagsHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.TagOutline}" />
                                    <CheckBox
                                        x:Name="ChkKeepTags"
                                        Checked="Option_Changed"
                                        Content="{DynamicResource Str_VideoToAudio_KeepTags}"
                                        Foreground="{DynamicResource SidebarText}"
                                        IsChecked="True"
                                        ToolTip="{DynamicResource Str_VideoToAudio_KeepTagsTooltip}"
                                        Unchecked="Option_Changed"
                                        controls:ChoiceIcon.Kind="FileVideoOutline"
                                        Style="{StaticResource ToggleChipCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="ChkTitleFromName"
                                        Margin="0,8,0,0"
                                        Checked="Option_Changed"
                                        Content="{DynamicResource Str_VideoToAudio_TitleFromName}"
                                        Foreground="{DynamicResource SidebarText}"
                                        Unchecked="Option_Changed"
                                        controls:ChoiceIcon.Kind="CheckCircleOutline"
                                        Style="{StaticResource ToggleChipCheckBoxStyle}" />

                                    <TextBlock
                                        Margin="0,12,0,6"
                                        Style="{StaticResource FieldLabel}"
                                        Text="{DynamicResource Str_VideoToAudio_Artist}" />
                                    <Border Style="{StaticResource InputBarStyle}">
                                        <TextBox
                                            x:Name="TxtArtist"
                                            MaxLength="200"
                                            Style="{StaticResource BareTextBox}"
                                            Tag="{DynamicResource Str_VideoToAudio_TagsPlaceholder}" />
                                    </Border>

                                    <TextBlock
                                        Margin="0,12,0,6"
                                        Style="{StaticResource FieldLabel}"
                                        Text="{DynamicResource Str_VideoToAudio_Album}" />
                                    <Border Style="{StaticResource InputBarStyle}">
                                        <TextBox
                                            x:Name="TxtAlbum"
                                            MaxLength="200"
                                            Style="{StaticResource BareTextBox}"
                                            Tag="{DynamicResource Str_VideoToAudio_TagsPlaceholder}" />
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!--
                                ============ OUTPUT ============
                                The shared Output card. Its extra option (Open the folder
                                when done) is made in the code-behind: no x:Name inside
                                another UserControl's content (MC3093).
                            -->
                            <controls:OutputFolderCard
                                x:Name="OutputCard"
                                ctl:Tour.Key="Str_Tour_VideoToAudio_Output"
                                ctl:Tour.Order="3"
                                Margin="0,8,0,0"
                                AllowSameAsSource="True"
                                ExampleFileName="video.mp3"
                                FolderChanged="OutputCard_FolderChanged"
                                Header="{DynamicResource Str_MicRecorder_OutputHeader}"
                                SameAsSourceText="{DynamicResource Str_VideoToAudio_SameAsSource}"
                                ToolName="Video to Audio" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--  ================= MAIN AREA =================  -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Run bar  -->
                <Border
                    Grid.Row="0"
                    Margin="0,0,0,14"
                    Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button
                            x:Name="BtnExtract"
                            ctl:Tour.Key="Str_Tour_VideoToAudio_Extract"
                            ctl:Tour.Order="4"
                            MinWidth="180"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            Click="BtnExtract_Click"
                            Style="{StaticResource AccentPrimaryButtonStyle}"
                            ToolTip="{DynamicResource Str_VideoToAudio_ExtractTooltip}">
                            <Grid HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon
                                    Grid.Column="0"
                                    x:Name="IconExtract"
                                    Width="18"
                                    Height="18"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Kind="FileMusicOutline" />
                                <TextBlock
                                    Grid.Column="1"
                                    x:Name="TxtExtractLabel"
                                    VerticalAlignment="Center"
                                    Text="{DynamicResource Str_VideoToAudio_ExtractAudio}" TextWrapping="Wrap" />
                            </Grid>
                        </Button>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <ProgressBar
                                x:Name="ProgressRun"
                                Height="8"
                                Maximum="100" />
                            <TextBlock
                                x:Name="TxtProgress"
                                Margin="0,6,0,0"
                                FontSize="11.5"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="{DynamicResource Str_VideoToAudio_ReadyHint}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock
                            x:Name="TxtProgressPercent"
                            Grid.Column="2"
                            MinWidth="54"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="{DynamicResource AccentColor}"
                            TextAlignment="Right" />
                    </Grid>
                </Border>

                <!--  Videos  -->
                <Border ctl:Tour.Key="Str_Tour_VideoToAudio_Results" ctl:Tour.Order="5" Grid.Row="1" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ContentControl
                                VerticalAlignment="Center"
                                Content="{DynamicResource Str_VideoToAudio_ResultsTitle}"
                                Style="{StaticResource CardHeader}"
                                Tag="{x:Static materialDesign:PackIconKind.MusicBoxOutline}" />

                            <WrapPanel
                                x:Name="SummaryPanel"
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                                <Border
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource StatusInfoBg}"
                                    Style="{StaticResource IconStatusPillStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource StatusInfoFg}"
                                            Kind="Filmstrip" />
                                        <TextBlock
                                            x:Name="TxtSummaryFiles"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource StatusInfoFg}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    x:Name="PillEstimate"
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource AccentColorSubtle}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    ToolTip="{DynamicResource Str_VideoToAudio_EstimateTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource AccentColor}"
                                            Kind="Harddisk" />
                                        <TextBlock
                                            x:Name="TxtSummaryEstimate"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource AccentColor}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    x:Name="PillDone"
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource StatusSuccessBg}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    ToolTip="{DynamicResource Str_VideoToAudio_DoneTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource StatusSuccessFg}"
                                            Kind="CheckCircleOutline" />
                                        <TextBlock
                                            x:Name="TxtSummaryDone"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource StatusSuccessFg}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    x:Name="PillFailed"
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource StatusErrorBg}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    ToolTip="{DynamicResource Str_VideoToAudio_FailedTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource StatusErrorFg}"
                                            Kind="AlertCircleOutline" />
                                        <TextBlock
                                            x:Name="TxtSummaryFailed"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource StatusErrorFg}" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <StackPanel
                                x:Name="ActionsPanel"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Button
                                    x:Name="BtnOpenOutput"
                                    Margin="0,0,8,0"
                                    Click="BtnOpenOutput_Click"
                                    ToolTip="{DynamicResource Str_VideoToAudio_OpenOutputTooltip}"
                                    Style="{StaticResource ListToolButtonStyle}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="FolderOpenOutline" />
                                </Button>
                                <Button
                                    x:Name="BtnRemoveFiles"
                                    Margin="0,0,8,0"
                                    Click="BtnRemoveFiles_Click"
                                    ToolTip="{DynamicResource Str_VideoToAudio_RemoveTooltip}"
                                    Style="{StaticResource ListToolButtonStyle}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="PlaylistRemove" />
                                </Button>
                                <Button
                                    x:Name="BtnClearFiles"
                                    Click="BtnClearFiles_Click"
                                    ToolTip="{DynamicResource Str_VideoToAudio_ClearTooltip}"
                                    Style="{StaticResource ListToolDangerButtonStyle}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="DeleteSweepOutline" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <DataGrid
                            x:Name="DataGridFiles"
                            Grid.Row="1"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            FontSize="12"
                            IsReadOnly="True"
                            MouseDoubleClick="DataGridFiles_MouseDoubleClick"
                            PreviewKeyDown="DataGridFiles_PreviewKeyDown"
                            MinRowHeight="48"
                            SelectionMode="Extended"
                            ToolTip="{DynamicResource Str_VideoToAudio_GridTooltip}"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.ScrollUnit="Pixel"
                            VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn
                                    Width="46"
                                    CanUserSort="False"
                                    CellStyle="{StaticResource CompactCellStyle}"
                                    CellTemplate="{StaticResource KindCellTemplate}" />
                                <DataGridTemplateColumn
                                    Width="2*"
                                    MinWidth="90"
                                    CellTemplate="{StaticResource NameCellTemplate}"
                                    Header="{DynamicResource Str_Common_ColHeaderFileName}"
                                    SortMemberPath="Name" />
                                <DataGridTextColumn
                                    ElementStyle="{StaticResource EllipsisCellTextStyle}"
                                    x:Name="ColLength"
                                    Width="70"
                                    Binding="{Binding DurationText}"
                                    Header="{DynamicResource Str_VideoToAudio_ColLength}"
                                    SortMemberPath="Duration" />
                                <DataGridTemplateColumn
                                    x:Name="ColTrack"
                                    Width="1.4*"
                                    MinWidth="90"
                                    CanUserSort="False"
                                    CellTemplate="{StaticResource TrackCellTemplate}"
                                    Header="{DynamicResource Str_VideoToAudio_AudioTrack}" />
                                <DataGridTemplateColumn
                                    x:Name="ColResult"
                                    Width="90"
                                    CanUserSort="False"
                                    CellTemplate="{StaticResource ResultCellTemplate}"
                                    Header="{DynamicResource Str_VideoToAudio_ColOutput}" />
                                <DataGridTemplateColumn
                                    Width="120"
                                    CellTemplate="{StaticResource StatusCellTemplate}"
                                    Header="{DynamicResource Str_Common_ColHeaderStatus}"
                                    SortMemberPath="Status" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <controls:EmptyStateCard
                            x:Name="EmptyStatePanel"
                            Title="{DynamicResource Str_VideoToAudio_EmptyTitle}"
                            Grid.Row="1"
                            Description="{DynamicResource Str_VideoToAudio_EmptyHint}"
                            Icon="MusicBoxOutline" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!--  Drop overlay: anywhere on the page  -->
        <Border
            x:Name="DropOverlay"
            Margin="16,8,16,16"
            Panel.ZIndex="10"
            Style="{StaticResource DropZoneStyle}">
            <Grid>
                <Rectangle
                    RadiusX="14"
                    RadiusY="14"
                    Stroke="{DynamicResource AccentColor}"
                    StrokeDashArray="6 4"
                    StrokeThickness="2" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.TrayArrowDown}" />
                    <TextBlock
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        Text="{DynamicResource Str_VideoToAudio_DropOverlay}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondary}"
                        Text="{DynamicResource Str_VideoToAudio_DropOverlayHint}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
