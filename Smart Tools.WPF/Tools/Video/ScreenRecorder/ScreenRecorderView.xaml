<UserControl
    x:Class="Smart_Tools.WPF.Views.ScreenRecorderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:Smart_Tools.WPF.Models"
    x:Name="Root"
    d:DesignHeight="720"
    d:DesignWidth="1200"
    mc:Ignorable="d"
    Loaded="View_Loaded">

    <!--
        Screen Recorder - record a screen, a window, or an area to an MP4, with your microphone if you like.
        Backend: Controllers/ScreenRecorderManager*.cs; Models/ScreenRecorderModel.cs; Views/ScreenRecorderControlWindow.cs
        (the small bar shown while recording). UI only here.
    -->

    <UserControl.Resources>
        <FontFamily x:Key="RecorderMono">Cascadia Mono, Consolas, Courier New</FontFamily>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">

        <!--  No page header: MainWindow's header card shows the tool's icon and name.  -->

        <Grid Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OptionsColumn" Width="280" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= SIDEBAR =================  -->

            <Border Grid.Column="0" Style="{StaticResource SidebarPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Button
                            x:Name="BtnCollapseOptions"
                            MinHeight="45"
                            HorizontalContentAlignment="Left"
                            Click="BtnCollapseOptions_Click"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Foreground="{DynamicResource SidebarText}"
                            ToolTip="{DynamicResource Str_Common_SidebarToggleTooltip}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="OverridesDefaultStyle" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Margin="16,0,0,0" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Kind="TuneVariant" />
                                <TextBlock
                                    x:Name="TxtOptionsHeaderLabel"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{DynamicResource Str_Common_OptionsLabel}" />
                            </StackPanel>
                        </Button>
                        <Separator
                            x:Name="SepHeader"
                            Margin="16,4"
                            Style="{StaticResource SidebarSeparatorStyle}" />
                    </StackPanel>

                    <ScrollViewer
                        x:Name="OptionsScrollViewer"
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16,4,16,16">

                            <!--  ============ WHAT TO RECORD ============  -->
                            <Border ctl:Tour.Key="Str_Tour_ScreenRecorder_What" ctl:Tour.Order="1" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Recorder_WhatHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.MonitorScreenshot}" />
                                    <UniformGrid Columns="3">
                                        <RadioButton
                                            x:Name="TargetScreen"
                                            Margin="0,0,2,0"
                                            Click="Target_Click"
                                            Content="{DynamicResource Str_Recorder_TargetScreen}"
                                            GroupName="RecTarget"
                                            IsChecked="True"
                                            controls:ChoiceIcon.Kind="Monitor"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="Screen" />
                                        <RadioButton
                                            x:Name="TargetWindow"
                                            Margin="2,0,2,0"
                                            Click="Target_Click"
                                            Content="{DynamicResource Str_Recorder_TargetWindow}"
                                            GroupName="RecTarget"
                                            controls:ChoiceIcon.Kind="WindowMaximize"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="Window" />
                                        <RadioButton
                                            x:Name="TargetArea"
                                            Margin="2,0,0,0"
                                            Click="Target_Click"
                                            Content="{DynamicResource Str_Recorder_TargetArea}"
                                            GroupName="RecTarget"
                                            controls:ChoiceIcon.Kind="SelectDrag"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="Area" />
                                    </UniformGrid>

                                    <StackPanel x:Name="PanelScreen" Margin="0,12,0,0">
                                        <ComboBox x:Name="CmbScreens" SelectionChanged="Choice_Changed" />
                                        <TextBlock
                                            x:Name="TxtSwitchHint"
                                            Margin="2,6,0,0"
                                            FontSize="11"
                                            Foreground="{DynamicResource SidebarTextMuted}"
                                            Text="{DynamicResource Str_Recorder_SwitchHint}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <StackPanel x:Name="PanelWindow" Margin="0,12,0,0" Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ComboBox x:Name="CmbWindows" SelectionChanged="Choice_Changed" />
                                            <Button
                                                Grid.Column="1"
                                                Margin="6,0,0,0"
                                                Click="BtnRefreshWindows_Click"
                                                Style="{StaticResource ListToolButtonStyle}"
                                                ToolTip="{DynamicResource Str_Recorder_RefreshWindows}">
                                                <materialDesign:PackIcon
                                                    Width="16"
                                                    Height="16"
                                                    Kind="Refresh" />
                                            </Button>
                                        </Grid>
                                        <TextBlock Style="{StaticResource SidebarHint}" Text="{DynamicResource Str_Recorder_WindowHint}" />
                                    </StackPanel>

                                    <StackPanel x:Name="PanelArea" Margin="0,12,0,0" Visibility="Collapsed">
                                        <Button
                                            x:Name="BtnPickArea"
                                            Click="BtnPickArea_Click"
                                            Style="{StaticResource PrimaryButtonStyle}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="16"
                                                    Height="16"
                                                    VerticalAlignment="Center"
                                                    Kind="SelectDrag" />
                                                <TextBlock
                                                    Margin="6,0,0,0"
                                                    VerticalAlignment="Center"
                                                    Text="{DynamicResource Str_Recorder_PickArea}"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Button>
                                        <TextBlock x:Name="TxtArea" Style="{StaticResource SidebarHint}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!--  ============ VIDEO ============  -->
                            <Border ctl:Tour.Key="Str_Tour_ScreenRecorder_Video" ctl:Tour.Order="2" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Recorder_VideoHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.VideoOutline}" />
                                    <TextBlock
                                        Margin="0,4,0,6"
                                        Style="{StaticResource FieldLabel}"
                                        Text="{DynamicResource Str_Recorder_Fps}" />
                                    <UniformGrid Columns="3">
                                        <RadioButton
                                            x:Name="Fps15"
                                            Margin="0,0,2,0"
                                            Click="Option_Click"
                                            Content="15"
                                            GroupName="RecFps"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="15" />
                                        <RadioButton
                                            x:Name="Fps30"
                                            Margin="2,0,2,0"
                                            Click="Option_Click"
                                            Content="30"
                                            GroupName="RecFps"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="30" />
                                        <RadioButton
                                            x:Name="Fps60"
                                            Margin="2,0,0,0"
                                            Click="Option_Click"
                                            Content="60"
                                            GroupName="RecFps"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="60" />
                                    </UniformGrid>

                                    <TextBlock
                                        Margin="0,12,0,6"
                                        Style="{StaticResource FieldLabel}"
                                        Text="{DynamicResource Str_Recorder_Quality}" />
                                    <UniformGrid Columns="3">
                                        <RadioButton
                                            x:Name="QualSmall"
                                            Margin="0,0,2,0"
                                            Click="Option_Click"
                                            Content="{DynamicResource Str_Recorder_QualitySmall}"
                                            GroupName="RecQuality"
                                            controls:ChoiceIcon.Kind="EmailFastOutline"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="Small"
                                            ToolTip="{DynamicResource Str_Recorder_QualitySmallTip}" />
                                        <RadioButton
                                            x:Name="QualBalanced"
                                            Margin="2,0,2,0"
                                            Click="Option_Click"
                                            Content="{DynamicResource Str_Recorder_QualityBalanced}"
                                            GroupName="RecQuality"
                                            IsChecked="True"
                                            controls:ChoiceIcon.Kind="ScaleBalance"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="Balanced" />
                                        <RadioButton
                                            x:Name="QualHigh"
                                            Margin="2,0,0,0"
                                            Click="Option_Click"
                                            Content="{DynamicResource Str_Recorder_QualityHigh}"
                                            GroupName="RecQuality"
                                            controls:ChoiceIcon.Kind="Diamond"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="High"
                                            ToolTip="{DynamicResource Str_Recorder_QualityHighTip}" />
                                    </UniformGrid>

                                    <CheckBox
                                        x:Name="ChkCursor"
                                        Margin="0,12,0,0"
                                        Click="Option_Click"
                                        Content="{DynamicResource Str_Recorder_Cursor}"
                                        Foreground="{DynamicResource SidebarText}"
                                        IsChecked="True"
                                        controls:ChoiceIcon.Kind="CursorDefaultOutline"
                                        Style="{StaticResource ToggleChipCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="ChkMinimize"
                                        Margin="0,8,0,0"
                                        Click="Option_Click"
                                        Content="{DynamicResource Str_Recorder_Minimize}"
                                        Foreground="{DynamicResource SidebarText}"
                                        IsChecked="True"
                                        ToolTip="{DynamicResource Str_Recorder_MinimizeTip}"
                                        controls:ChoiceIcon.Kind="CursorDefaultOutline"
                                        Style="{StaticResource ToggleChipCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="ChkSkipUac"
                                        Margin="0,8,0,0"
                                        Click="Option_Click"
                                        Content="{DynamicResource Str_Recorder_SkipUac}"
                                        Foreground="{DynamicResource SidebarText}"
                                        IsChecked="True"
                                        ToolTip="{DynamicResource Str_Recorder_SkipUacTip}"
                                        controls:ChoiceIcon.Kind="CursorDefaultOutline"
                                        Style="{StaticResource ToggleChipCheckBoxStyle}" />
                                    <TextBlock Style="{StaticResource SidebarHint}" Text="{DynamicResource Str_Recorder_SkipUacHint}" />
                                </StackPanel>
                            </Border>

                            <!--  ============ SOUND ============  -->
                            <Border ctl:Tour.Key="Str_Tour_ScreenRecorder_Sound" ctl:Tour.Order="3" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Recorder_SoundHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.MicrophoneOutline}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="CmbMic" />
                                        <Button
                                            Grid.Column="1"
                                            Margin="6,0,0,0"
                                            Click="BtnRefreshMic_Click"
                                            Style="{StaticResource ListToolButtonStyle}"
                                            ToolTip="{DynamicResource Str_Recorder_RefreshMic}">
                                            <materialDesign:PackIcon
                                                Width="16"
                                                Height="16"
                                                Kind="Refresh" />
                                        </Button>
                                    </Grid>
                                    <TextBlock Style="{StaticResource SidebarHint}" Text="{DynamicResource Str_Recorder_SoundHint}" />
                                </StackPanel>
                            </Border>

                            <!--  ============ SAVE TO ============  -->
                            <controls:OutputFolderCard
                                x:Name="OutputCard"
                                ctl:Tour.Key="Str_Tour_ScreenRecorder_Output"
                                ctl:Tour.Order="4"
                                Margin="0,10,0,0"
                                ExampleFileName="Recording 2026-01-01 12.00.00.mp4"
                                Header="{DynamicResource Str_Recorder_SaveTo}"
                                HeaderIcon="ContentSaveOutline"
                                ToolName="Screen Recorder" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--  ================= MAIN =================  -->

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Record button, timer, status  -->
                <Border Margin="0,0,0,12" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="BtnRecord"
                            ctl:Tour.Key="Str_Tour_ScreenRecorder_Record"
                            ctl:Tour.Order="5"
                            MinWidth="160"
                            Margin="0,0,18,0"
                            VerticalAlignment="Center"
                            Click="BtnRecord_Click"
                            Style="{StaticResource AccentPrimaryButtonStyle}">
                            <Grid HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon
                                    x:Name="IconRecord"
                                    Width="18"
                                    Height="18"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Kind="RecordCircleOutline" />
                                <TextBlock
                                    x:Name="TxtRecordLabel"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Text="{DynamicResource Str_Recorder_Start}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Button>
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock
                                x:Name="TxtTimer"
                                FontFamily="{StaticResource RecorderMono}"
                                FontSize="26"
                                FontWeight="Bold"
                                Foreground="{DynamicResource TextPrimary}"
                                Text="00:00" />
                            <TextBlock
                                x:Name="TxtStatus"
                                Margin="0,2,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource TextSecondary}"
                                TextTrimming="CharacterEllipsis"
                                TextWrapping="NoWrap" />
                        </StackPanel>
                        <Border
                            x:Name="PillState"
                            Grid.Column="2"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Style="{StaticResource IconStatusPillStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    x:Name="IconState"
                                    Width="13"
                                    Height="13"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Kind="CircleOutline" />
                                <TextBlock
                                    x:Name="TxtState"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!--  This session's recordings  -->
                <Border ctl:Tour.Key="Str_Tour_ScreenRecorder_Recordings" ctl:Tour.Order="6" Grid.Row="1" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ContentControl
                            Content="{DynamicResource Str_Recorder_ListHeader}"
                            Style="{StaticResource CardHeader}"
                            Tag="{x:Static materialDesign:PackIconKind.FilmstripBox}" />
                        <Grid Grid.Row="1" Margin="0,8,0,0">
                            <DataGrid
                                x:Name="GridRecordings"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                FontSize="12"
                                IsReadOnly="True"
                                MinRowHeight="44"
                                MouseDoubleClick="GridRecordings_MouseDoubleClick"
                                SelectionMode="Single"
                                VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Width="2*"
                                        MinWidth="120"
                                        Binding="{Binding Name}"
                                        ElementStyle="{StaticResource EllipsisCellTextStyle}"
                                        Header="{DynamicResource Str_Recorder_ColName}" />
                                    <DataGridTextColumn
                                        Width="90"
                                        Binding="{Binding DurationText}"
                                        ElementStyle="{StaticResource EllipsisCellTextStyle}"
                                        Header="{DynamicResource Str_Recorder_ColLength}" />
                                    <DataGridTextColumn
                                        Width="90"
                                        Binding="{Binding SizeText}"
                                        ElementStyle="{StaticResource EllipsisCellTextStyle}"
                                        Header="{DynamicResource Str_Recorder_ColSize}" />
                                    <DataGridTemplateColumn Width="120" Header="">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type models:RecordingEntry}">
                                                <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                    <Button
                                                        Margin="0,0,2,0"
                                                        Click="BtnPlay_Click"
                                                        Style="{StaticResource ListToolButtonStyle}"
                                                        ToolTip="{DynamicResource Str_Recorder_Play}">
                                                        <materialDesign:PackIcon
                                                            Width="16"
                                                            Height="16"
                                                            Kind="OpenInNew" />
                                                    </Button>
                                                    <Button
                                                        Margin="0,0,2,0"
                                                        Click="BtnShowFile_Click"
                                                        Style="{StaticResource ListToolButtonStyle}"
                                                        ToolTip="{DynamicResource Str_Recorder_ShowInFolder}">
                                                        <materialDesign:PackIcon
                                                            Width="16"
                                                            Height="16"
                                                            Kind="FolderSearchOutline" />
                                                    </Button>
                                                    <Button
                                                        Click="BtnRemoveEntry_Click"
                                                        Style="{StaticResource ListToolDangerButtonStyle}"
                                                        ToolTip="{DynamicResource Str_Recorder_RemoveFromList}">
                                                        <materialDesign:PackIcon
                                                            Width="16"
                                                            Height="16"
                                                            Kind="Close" />
                                                    </Button>
                                                </StackPanel>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel
                                x:Name="PanelEmpty"
                                MaxWidth="440"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                d:Visibility="Collapsed"
                                IsHitTestVisible="False">
                                <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.RecordCircleOutline}" />
                                <TextBlock
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="15"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimary}"
                                    Text="{DynamicResource Str_Recorder_EmptyTitle}" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{DynamicResource Str_Recorder_EmptyHint}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
