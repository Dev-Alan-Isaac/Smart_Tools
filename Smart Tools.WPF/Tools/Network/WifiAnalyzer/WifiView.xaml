<UserControl
    x:Class="Smart_Tools.WPF.Views.WifiView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:models="clr-namespace:Smart_Tools.WPF.Models"
    x:Name="Root"
    Focusable="True"
    Loaded="Root_Loaded">

    <!--  Backend: Controllers/WifiManager.cs + WlanNative.cs (Windows' Wi-Fi API). Read-only: nothing is connected or changed. UI only here.  -->

    <UserControl.Resources>
        <Style x:Key="TagPillStyle" TargetType="Border">
            <Setter Property="Padding" Value="6,1" />
            <Setter Property="Margin" Value="8,0,0,0" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--  Network name, with a tag on the one you are connected to  -->
        <DataTemplate x:Key="NetworkCellTemplate" DataType="{x:Type models:WifiNetwork}">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock x:Name="Name" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding DisplayName}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Bssid}" />
                <Border x:Name="Tag" Background="{DynamicResource StatusSuccessBg}" Style="{StaticResource TagPillStyle}" Visibility="Collapsed">
                    <TextBlock FontSize="10" FontWeight="SemiBold" Foreground="{DynamicResource StatusSuccessFg}" Text="{DynamicResource Str_WifiAnalyzer_Connected}" />
                </Border>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsConnected}" Value="True">
                    <Setter TargetName="Tag" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsHidden}" Value="True">
                    <Setter TargetName="Name" Property="FontStyle" Value="Italic" />
                    <Setter TargetName="Name" Property="Foreground" Value="{DynamicResource TextSecondary}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  Signal: dBm and a word, coloured by how good it is  -->
        <DataTemplate x:Key="SignalCellTemplate" DataType="{x:Type models:WifiNetwork}">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock x:Name="Dbm" MinWidth="58" VerticalAlignment="Center" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding SignalText}" />
                <TextBlock x:Name="Word" VerticalAlignment="Center" FontSize="11" Foreground="{DynamicResource TextSecondary}" Text="{Binding QualityText}" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding QualityText}" Value="Excellent">
                    <Setter TargetName="Word" Property="Foreground" Value="{DynamicResource StatusSuccessFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding QualityText}" Value="Good">
                    <Setter TargetName="Word" Property="Foreground" Value="{DynamicResource StatusSuccessFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding QualityText}" Value="Weak">
                    <Setter TargetName="Word" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding QualityText}" Value="Very weak">
                    <Setter TargetName="Word" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">
        <Grid Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= OPTIONS SIDEBAR =================  -->
            <controls:ToolSidebar>
                <StackPanel x:Name="SidebarStack">
                    <Border ctl:Tour.Key="Str_Tour_Wifi_ThisPc" ctl:Tour.Order="1" Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl Content="{DynamicResource Str_HardwareSensors_ThisPc}" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.Wifi}" />
                            <TextBlock x:Name="TxtAdapter" Margin="2,8,0,0" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource SidebarText}" Text="{DynamicResource Str_WifiAnalyzer_LookingForAWi}" TextWrapping="Wrap" />
                            <TextBlock x:Name="TxtLink" Margin="2,4,0,0" FontSize="10.5" Foreground="{DynamicResource SidebarTextMuted}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border ctl:Tour.Key="Str_Tour_Wifi_View" ctl:Tour.Order="2" Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl Content="{DynamicResource Str_FileDiff_ViewHeader}" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.EyeOutline}" />
                            <UniformGrid Margin="0,8,0,0" Columns="2">
                                <RadioButton
                                    x:Name="RadioNearby"
                                    Margin="0,0,2,0"
                                    Checked="View_Changed"
                                    Content="{DynamicResource Str_WifiAnalyzer_Nearby}"
                                    GroupName="WfView"
                                    IsChecked="True"
                                    controls:ChoiceIcon.Kind="Wifi"
                                    Style="{StaticResource ModeToggleTallStyle}"
                                    ToolTip="{DynamicResource Str_WifiAnalyzer_NetworksYourPcCan}" />
                                <RadioButton
                                    x:Name="RadioSaved"
                                    Margin="2,0,0,0"
                                    Checked="View_Changed"
                                    Content="{DynamicResource Str_Settings_Saved}"
                                    GroupName="WfView"
                                    controls:ChoiceIcon.Kind="BookmarkOutline"
                                    Style="{StaticResource ModeToggleTallStyle}"
                                    ToolTip="{DynamicResource Str_WifiAnalyzer_NetworksWindowsRemembers}" />
                            </UniformGrid>

                            <StackPanel x:Name="BandPanel">
                                <TextBlock Margin="2,12,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SidebarTextMuted}" Text="{DynamicResource Str_WifiAnalyzer_ChannelGraphFor}" />
                                <UniformGrid Margin="0,6,0,0" Columns="3">
                                    <RadioButton x:Name="RadioBand24" Margin="0,0,2,0" Checked="Band_Changed" Content="2.4 GHz" GroupName="WfBand" IsChecked="True" Style="{StaticResource ModeToggleButtonStyle}" />
                                    <RadioButton x:Name="RadioBand5" Margin="2,0,2,0" Checked="Band_Changed" Content="5 GHz" GroupName="WfBand" Style="{StaticResource ModeToggleButtonStyle}" />
                                    <RadioButton x:Name="RadioBand6" Margin="2,0,0,0" Checked="Band_Changed" Content="6 GHz" GroupName="WfBand" Style="{StaticResource ModeToggleButtonStyle}" />
                                </UniformGrid>
                                <CheckBox
                                    x:Name="ChkAuto"
                                    Margin="2,12,0,0"
                                    Checked="ChkAuto_Changed"
                                    Content="{DynamicResource Str_WifiAnalyzer_ScanAgainEverySeconds}"
                                    Foreground="{DynamicResource SidebarText}"
                                    Unchecked="ChkAuto_Changed" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl Content="{DynamicResource Str_SecureFileShredder_GoodToKnow}" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.InformationOutline}" />
                            <TextBlock Margin="2,6,0,0" FontSize="10.5" Foreground="{DynamicResource SidebarTextMuted}" TextWrapping="Wrap" Text="{DynamicResource Str_WifiAnalyzer_ThisOnlyListensIt}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </controls:ToolSidebar>

            <!--  ================= MAIN AREA =================  -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Run bar  -->
                <Border Grid.Row="0" Margin="0,0,0,14" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button ctl:Tour.Key="Str_Tour_Wifi_Scan" ctl:Tour.Order="3" x:Name="BtnScan" MinWidth="160" VerticalAlignment="Center" Click="BtnScan_Click" Style="{StaticResource AccentPrimaryButtonStyle}" ToolTip="{DynamicResource Str_WifiAnalyzer_LookForNetworksNow}">
                            <Grid HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon x:Name="IconScan" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" Kind="Radar" />
                                <TextBlock x:Name="TxtScan" Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_Network_ScanButton}" TextWrapping="Wrap" />
                            </Grid>
                        </Button>

                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <ProgressBar x:Name="Bar" Height="8" Maximum="100" />
                            <TextBlock x:Name="TxtProgress" Margin="0,6,0,0" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource Str_WifiAnalyzer_PressScanToListen}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  Results  -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ContentControl x:Name="CardTitle" VerticalAlignment="Center" Content="{DynamicResource Str_WifiAnalyzer_Networks}" Style="{StaticResource CardHeader}" Tag="{x:Static materialDesign:PackIconKind.Wifi}" />

                            <WrapPanel x:Name="SummaryPanel" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                <Border Margin="0,2,6,2" Background="{DynamicResource StatusInfoBg}" Style="{StaticResource IconStatusPillStyle}" ToolTip="{DynamicResource Str_WifiAnalyzer_AccessPointsHeardOne}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource StatusInfoFg}" Kind="Wifi" />
                                        <TextBlock x:Name="TxtSummaryCount" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource StatusInfoFg}" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="PillBest" Margin="0,2,6,2" Background="{DynamicResource StatusSuccessBg}" Style="{StaticResource IconStatusPillStyle}" ToolTip="{DynamicResource Str_WifiAnalyzer_TheLeastCrowdedChannel}" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource StatusSuccessFg}" Kind="StarOutline" />
                                        <TextBlock x:Name="TxtSummaryBest" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource StatusSuccessFg}" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="PillYours" Margin="0,2,6,2" Background="{DynamicResource AccentColorSubtle}" Style="{StaticResource IconStatusPillStyle}" ToolTip="{DynamicResource Str_WifiAnalyzer_TheChannelYourConnection}" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentColor}" Kind="AccessPoint" />
                                        <TextBlock x:Name="TxtSummaryYours" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentColor}" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                                <Button x:Name="BtnCopy" Margin="0,0,6,0" Click="BtnCopy_Click" Style="{StaticResource ListToolButtonStyle}" ToolTip="{DynamicResource Str_WifiAnalyzer_CopyTheListCsv}">
                                    <materialDesign:PackIcon Width="16" Height="16" Kind="ContentCopy" />
                                </Button>
                                <Button x:Name="BtnSave" Click="BtnSave_Click" Style="{StaticResource ListToolButtonStyle}" ToolTip="{DynamicResource Str_LargeFileFinder_SaveTheListAs}">
                                    <materialDesign:PackIcon Width="16" Height="16" Kind="FileDelimitedOutline" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Border x:Name="StatusBanner" Grid.Row="1" Margin="0,0,0,10" Padding="10,8" CornerRadius="8" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon x:Name="StatusIcon" Width="14" Height="14" Margin="0,1,8,0" VerticalAlignment="Top" Kind="AlertOutline" />
                                <TextBlock x:Name="TxtStatus" Grid.Column="1" FontSize="11.5" TextWrapping="Wrap" />
                                <Button x:Name="BtnOpenLocation" Grid.Column="2" Margin="10,0,0,0" Padding="10,2" VerticalAlignment="Center" Click="BtnOpenLocation_Click" Style="{StaticResource NeutralIconButtonStyle}" Visibility="Collapsed" Content="{DynamicResource Str_WifiAnalyzer_OpenLocationSettings}" />
                            </Grid>
                        </Border>

                        <!--  Nearby: graph above the list  -->
                        <Grid x:Name="NearbyPanel" Grid.Row="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="230" />
                                <RowDefinition Height="12" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Border x:Name="ChartCard" Background="{DynamicResource RowBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="12">
                                <Grid>
                                    <TextBlock x:Name="TxtChartTitle" Margin="14,10,0,0" HorizontalAlignment="Left" VerticalAlignment="Top" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                    <TextBlock x:Name="TxtChartAdvice" Margin="0,10,14,0" HorizontalAlignment="Right" VerticalAlignment="Top" FontSize="11.5" Foreground="{DynamicResource StatusSuccessFg}" />
                                    <controls:ChannelChart ctl:Tour.Key="Str_Tour_Wifi_Channels" ctl:Tour.Order="4" x:Name="Chart" Margin="6,30,6,6" />
                                </Grid>
                            </Border>

                            <DataGrid ctl:Tour.Key="Str_Tour_Wifi_Networks" ctl:Tour.Order="5"
                                x:Name="NetworkGrid"
                                Grid.Row="2"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                CanUserSortColumns="False"
                                FontSize="12"
                                IsReadOnly="True"
                                MinRowHeight="40"
                                SelectionMode="Single"
                                VirtualizingPanel.IsVirtualizing="True"
                                VirtualizingPanel.ScrollUnit="Pixel"
                                VirtualizingPanel.VirtualizationMode="Recycling">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="2*" MinWidth="130" CellTemplate="{StaticResource NetworkCellTemplate}" Header="{DynamicResource Str_SubnetCalculator_Network}" />
                                    <DataGridTemplateColumn Width="130" CellTemplate="{StaticResource SignalCellTemplate}" Header="{DynamicResource Str_AudioOut_SignalHeader}" />
                                    <DataGridTextColumn Width="70" Binding="{Binding ChannelText}" ElementStyle="{StaticResource EllipsisCellTextStyle}" Header="{DynamicResource Str_WifiAnalyzer_Channel}" />
                                    <DataGridTextColumn Width="70" Binding="{Binding BandText}" ElementStyle="{StaticResource EllipsisCellTextStyle}" Header="{DynamicResource Str_WifiAnalyzer_Band}" />
                                    <DataGridTextColumn Width="1.2*" MinWidth="90" Binding="{Binding Standard}" ElementStyle="{StaticResource EllipsisCellTextStyle}" Header="{DynamicResource Str_SecureFileShredder_Standard}" />
                                    <DataGridTextColumn Width="1.2*" MinWidth="100" Binding="{Binding Security}" ElementStyle="{StaticResource EllipsisCellTextStyle}" Header="{DynamicResource Str_WifiAnalyzer_Security}" />
                                    <DataGridTextColumn Width="2*" MinWidth="130" Binding="{Binding AccessPoint}" ElementStyle="{StaticResource EllipsisCellTextStyle}" Header="{DynamicResource Str_WifiAnalyzer_AccessPoint}" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </Grid>

                        <!--  Saved networks  -->
                        <DataGrid
                            x:Name="ProfileGrid"
                            Grid.Row="2"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            CanUserSortColumns="False"
                            FontSize="12"
                            IsReadOnly="True"
                            MinRowHeight="40"
                            SelectionMode="Single"
                            Visibility="Collapsed">
                            <DataGrid.Columns>
                                <DataGridTextColumn Width="2*" MinWidth="130" Binding="{Binding Name}" ElementStyle="{StaticResource EllipsisCellTextStyle}" Header="{DynamicResource Str_SubnetCalculator_Network}" />
                                <DataGridTextColumn Width="1.4*" MinWidth="120" Binding="{Binding SecurityText}" ElementStyle="{StaticResource EllipsisCellTextStyle}" Header="{DynamicResource Str_WifiAnalyzer_Security}" />
                                <DataGridTextColumn Width="1*" MinWidth="90" Binding="{Binding ConnectText}" ElementStyle="{StaticResource EllipsisCellTextStyle}" Header="{DynamicResource Str_WifiAnalyzer_Connects}" />
                                <DataGridTextColumn Width="1*" MinWidth="90" Binding="{Binding PasswordText}" ElementStyle="{StaticResource EllipsisCellTextStyle}" Header="{DynamicResource Str_Encrypt_PasswordHeader}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <controls:EmptyStateCard
                            x:Name="EmptyStatePanel"
                            Grid.Row="2"
                            Description="Press Scan to see the Wi-Fi networks around you, how strong they are and which channel is least crowded."
                            Icon="Wifi"
                            IsHitTestVisible="False" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
