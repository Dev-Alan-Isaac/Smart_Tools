<UserControl
    x:Class="Smart_Tools.WPF.Views.ConnectionsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:models="clr-namespace:Smart_Tools.WPF.Models"
    IsVisibleChanged="Root_IsVisibleChanged">

    <!--
        Backend: Tools/Network/Connections/ConnectionsManager.cs (reading, outside or local, filtering, CSV, settings)
        on Shared/Controllers/TcpUdpTable.cs; ConnectionsModel.cs. This file and the code-behind are UI only.
    -->

    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <Style x:Key="MutedCell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <Style x:Key="PlainCell" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <DataTemplate x:Key="AppCellTemplate" DataType="{x:Type models:ConnectionRow}">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <TextBlock
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimary}"
                    Text="{Binding AppName}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="11"
                    Foreground="{DynamicResource TextSecondary}"
                    Text="{Binding Pid}" />
                <Border
                    Margin="8,0,0,0"
                    Padding="6,1"
                    VerticalAlignment="Center"
                    Background="{DynamicResource AccentColorSubtle}"
                    CornerRadius="8"
                    Visibility="{Binding IsNew, Converter={StaticResource BoolToVisibility}}">
                    <TextBlock
                        FontSize="10"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource AccentColor}"
                        Text="{DynamicResource Str_Connections_New}" />
                </Border>
            </StackPanel>
        </DataTemplate>

        <DataTemplate x:Key="WhereCellTemplate" DataType="{x:Type models:ConnectionRow}">
            <TextBlock x:Name="Label" Style="{StaticResource MutedCell}" Text="{DynamicResource Str_Connections_ScopeLocal}" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsOutside}" Value="True">
                    <Setter TargetName="Label" Property="Text" Value="{DynamicResource Str_Connections_ScopeOutside}" />
                    <Setter TargetName="Label" Property="Foreground" Value="{DynamicResource TextPrimary}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Margin="16,8,16,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  The connections  -->
        <Border Grid.Column="2" Padding="16" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <UniformGrid ctl:Tour.Key="Str_Tour_Connections_Summary" ctl:Tour.Order="1" Columns="2">
                    <Border Margin="0,0,6,0" Padding="16,12" Background="{DynamicResource RowBg}" CornerRadius="12">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource Str_Connections_StatApps}" />
                            <TextBlock
                                x:Name="TxtApps"
                                FontSize="30"
                                FontWeight="Bold"
                                Foreground="{DynamicResource TextPrimary}"
                                Text="0" />
                        </StackPanel>
                    </Border>
                    <Border Margin="6,0,0,0" Padding="16,12" Background="{DynamicResource RowBg}" CornerRadius="12">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource Str_Connections_StatActive}" />
                            <TextBlock
                                x:Name="TxtActive"
                                FontSize="30"
                                FontWeight="Bold"
                                Foreground="{DynamicResource TextPrimary}"
                                Text="0" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!--  App, address, port or PID  -->
                <Border ctl:Tour.Key="Str_Tour_Connections_Search" ctl:Tour.Order="2" Grid.Row="1" Margin="0,12,0,12" Padding="10,0,4,0" Style="{StaticResource InputBarStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon
                            Width="18"
                            Height="18"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource AccentColor}"
                            Kind="{x:Static materialDesign:PackIconKind.Magnify}" />
                        <TextBox
                            x:Name="TxtSearch"
                            Grid.Column="1"
                            Style="{StaticResource BareTextBox}"
                            Tag="{DynamicResource Str_Connections_SearchPlaceholder}"
                            TextChanged="TxtSearch_TextChanged" />
                    </Grid>
                </Border>

                <DataGrid
                    ctl:Tour.Key="Str_Tour_Connections_List" ctl:Tour.Order="3" 
                    x:Name="GridConnections"
                    Grid.Row="2"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    CanUserReorderColumns="False"
                    FontSize="12"
                    IsReadOnly="True"
                    MinRowHeight="32"
                    PreviewMouseRightButtonDown="GridConnections_PreviewMouseRightButtonDown"
                    SelectionMode="Extended"
                    VirtualizingPanel.IsVirtualizing="True"
                    VirtualizingPanel.ScrollUnit="Pixel"
                    VirtualizingPanel.VirtualizationMode="Recycling">
                    <DataGrid.ContextMenu>
                        <ContextMenu>
                            <MenuItem Click="MenuCopy_Click" Header="{DynamicResource Str_Connections_CopyRemote}" />
                        </ContextMenu>
                    </DataGrid.ContextMenu>
                    <DataGrid.Columns>
                        <DataGridTemplateColumn
                            Width="2.2*"
                            MinWidth="140"
                            CellTemplate="{StaticResource AppCellTemplate}"
                            Header="{DynamicResource Str_Connections_ColApp}"
                            SortMemberPath="AppName" />
                        <DataGridTextColumn
                            Width="1.4*"
                            MinWidth="110"
                            Binding="{Binding RemoteAddress}"
                            ElementStyle="{StaticResource PlainCell}"
                            Header="{DynamicResource Str_Connections_ColRemote}"
                            SortMemberPath="RemoteAddress" />
                        <DataGridTextColumn
                            Width="1.6*"
                            MinWidth="100"
                            Binding="{Binding Host}"
                            ElementStyle="{StaticResource MutedCell}"
                            Header="{DynamicResource Str_Connections_ColHost}"
                            SortMemberPath="Host" />
                        <DataGridTextColumn
                            Width="64"
                            Binding="{Binding RemotePortText}"
                            ElementStyle="{StaticResource MutedCell}"
                            Header="{DynamicResource Str_Connections_ColPort}"
                            SortMemberPath="RemotePort" />
                        <DataGridTextColumn
                            Width="70"
                            Binding="{Binding Protocol}"
                            ElementStyle="{StaticResource MutedCell}"
                            Header="{DynamicResource Str_Connections_ColProtocol}"
                            SortMemberPath="Protocol" />
                        <DataGridTextColumn
                            Width="100"
                            Binding="{Binding State}"
                            ElementStyle="{StaticResource MutedCell}"
                            Header="{DynamicResource Str_Connections_ColState}"
                            SortMemberPath="State" />
                        <DataGridTemplateColumn
                            Width="76"
                            CellTemplate="{StaticResource WhereCellTemplate}"
                            Header="{DynamicResource Str_Connections_ColWhere}"
                            SortMemberPath="IsOutside" />
                    </DataGrid.Columns>
                </DataGrid>

                <!--  Nothing to show  -->
                <StackPanel
                    x:Name="EmptyPanel"
                    Grid.Row="2"
                    Margin="0,60,0,0"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Top"
                    IsHitTestVisible="False"
                    Visibility="Collapsed">
                    <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.LanDisconnect}" />
                    <TextBlock
                        x:Name="TxtEmpty"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        Text="{DynamicResource Str_Connections_NoMatch}" />
                </StackPanel>
            </Grid>
        </Border>

        <!--  Options (shared ToolSidebar: on the left and collapsible like the other tools)  -->
        <controls:ToolSidebar Grid.Column="0">
<StackPanel>
<Border Margin="0,0,0,10" Style="{StaticResource SidebarGroupCardStyle}">
<StackPanel>
<ContentControl Content="{DynamicResource Str_Connections_Show}" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.FilterVariant}" />
<UniformGrid ctl:Tour.Key="Str_Tour_Connections_Show" ctl:Tour.Order="4" Margin="0,0,0,0" Columns="3">
                        <RadioButton
                            x:Name="RadioOutside"
                            Margin="0,0,3,0"
                            Checked="Scope_Checked"
                            Content="{DynamicResource Str_Connections_ScopeOutside}"
                            GroupName="ConnectionsScope"
                            Style="{StaticResource ModeToggleButtonStyle}"
                            Tag="Outside" />
                        <RadioButton
                            x:Name="RadioLocal"
                            Margin="3,0"
                            Checked="Scope_Checked"
                            Content="{DynamicResource Str_Connections_ScopeLocal}"
                            GroupName="ConnectionsScope"
                            Style="{StaticResource ModeToggleButtonStyle}"
                            Tag="Local" />
                        <RadioButton
                            x:Name="RadioAll"
                            Margin="3,0,0,0"
                            Checked="Scope_Checked"
                            Content="{DynamicResource Str_Connections_ScopeAll}"
                            GroupName="ConnectionsScope"
                            Style="{StaticResource ModeToggleButtonStyle}"
                            Tag="All" />
                    </UniformGrid>
<CheckBox
                        x:Name="ChkHideListening"
                        Margin="0,12,0,0"
                        Click="ChkHideListening_Click"
                        Content="{DynamicResource Str_Connections_HideListening}"
                        ToolTip="{DynamicResource Str_Connections_HideListeningTip}" />
</StackPanel>
</Border>
<Border Margin="0,0,0,10" Style="{StaticResource SidebarGroupCardStyle}">
<StackPanel>
<ContentControl Content="{DynamicResource Str_Connections_Refresh}" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.Refresh}" />
<ComboBox x:Name="CmbRefresh" SelectionChanged="CmbRefresh_SelectionChanged" />
</StackPanel>
</Border>
<Border Margin="0,0,0,10" Style="{StaticResource SidebarGroupCardStyle}">
<StackPanel>
<ContentControl Content="{DynamicResource Str_Connections_DetailsHeader}" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.Magnify}" />
<CheckBox
                        ctl:Tour.Key="Str_Tour_Connections_LookUp" ctl:Tour.Order="5" 
                        x:Name="ChkLookUp"
                        Margin="0,0,0,0"
                        Click="ChkLookUp_Click"
                        Content="{DynamicResource Str_Connections_LookUp}"
                        ToolTip="{DynamicResource Str_Connections_LookUpTip}" />
</StackPanel>
</Border>
<Border Margin="0,0,0,10" Style="{StaticResource SidebarGroupCardStyle}">
<StackPanel>
<ContentControl Content="{DynamicResource Str_Connections_ExportHeader}" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.FileExportOutline}" />
<controls:ExportButton ctl:Tour.Key="Str_Tour_Connections_Export" ctl:Tour.Order="6" ToolTip="{DynamicResource Str_Connections_ExportTip}">
                    <Button.ContextMenu>
                        <ContextMenu>
                            <MenuItem Click="BtnExport_Click" Header="{DynamicResource Str_Common_ExportAsCsv}" Tag="csv">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="FileDelimitedOutline" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Click="BtnExport_Click" Header="{DynamicResource Str_Common_ExportAsPdf}" Tag="pdf">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="FilePdfBox" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Click="BtnExport_Click" Header="{DynamicResource Str_Common_ExportAsHtml}" Tag="html">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="Web" />
                                </MenuItem.Icon>
                            </MenuItem>
                            <MenuItem Click="BtnExport_Click" Header="{DynamicResource Str_Common_ExportAsText}" Tag="txt">
                                <MenuItem.Icon>
                                    <materialDesign:PackIcon Kind="FileDocumentOutline" />
                                </MenuItem.Icon>
                            </MenuItem>
                        </ContextMenu>
                    </Button.ContextMenu>
                </controls:ExportButton>
</StackPanel>
</Border>
<TextBlock
                        Margin="2,2,2,0"
                        Foreground="{DynamicResource TextSecondary}"
                        Text="{DynamicResource Str_Connections_Hint}"
                        TextWrapping="Wrap" />
</StackPanel>
</controls:ToolSidebar>
    </Grid>
</UserControl>
