<UserControl
    x:Class="Smart_Tools.WPF.Views.PortScannerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:models="clr-namespace:Smart_Tools.WPF.Models"
    x:Name="Root"
    Loaded="View_Loaded"
    Unloaded="View_Unloaded">

    <!--
        Port Scanner - which TCP ports answer on a host, from the adapter you choose.
        Backend: Controllers/NetworkToolsManager.Scan.cs, NetworkToolsManager.Source.cs;
        Controls/NetworkConsole, Controls/SourceAdapterPicker.
        This file and the code-behind are UI only.
    -->

    <UserControl.Resources>

        <!--  Small number tile on the tool card  -->
        <Style x:Key="SidebarHint" TargetType="TextBlock">
            <Setter Property="Margin" Value="2,10,0,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">

        <!--  No page header: MainWindow's header card shows the tool's icon and name.  -->

        <Grid Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OptionsColumn" Width="280" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= SIDEBAR =================  -->

            <Border Grid.Column="0" Style="{StaticResource SidebarPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Button
                            x:Name="BtnCollapseOptions"
                            MinHeight="45"
                            HorizontalContentAlignment="Left"
                            Click="BtnCollapseOptions_Click"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Foreground="{DynamicResource SidebarText}"
                            ToolTip="{DynamicResource Str_Common_SidebarToggleTooltip}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="OverridesDefaultStyle" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Margin="16,0,0,0" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Kind="TuneVariant" />
                                <TextBlock
                                    x:Name="TxtOptionsHeaderLabel"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{DynamicResource Str_Common_OptionsLabel}" />
                            </StackPanel>
                        </Button>
                        <Separator
                            x:Name="SepHeader"
                            Margin="16,4"
                            Style="{StaticResource SidebarSeparatorStyle}" />
                    </StackPanel>

                    <ScrollViewer
                        x:Name="OptionsScrollViewer"
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16,4,16,16">
                            <!--  ============ TARGET: this PC, each adapter network, or another host ============  -->
                            <Border ctl:Tour.Key="Str_Tour_PortScanner_Target" ctl:Tour.Order="1" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <ContentControl
                                            Content="{DynamicResource Str_PortScanner_TargetHeader}"
                                            Style="{StaticResource SidebarGroupHeader}"
                                            Tag="{x:Static materialDesign:PackIconKind.LanConnect}" />
                                        <Button
                                            x:Name="BtnRefreshTargets"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Center"
                                            Click="BtnRefreshTargets_Click"
                                            Style="{StaticResource ListToolButtonStyle}"
                                            ToolTip="{DynamicResource Str_SourceAdapterPicker_LookForAdaptersAgain}">
                                            <materialDesign:PackIcon
                                                Width="16"
                                                Height="16"
                                                Kind="Refresh" />
                                        </Button>
                                    </Grid>
                                    <StackPanel x:Name="TargetPanel" Margin="0,6,0,0" />
                                    <TextBlock
                                        x:Name="TxtTargetHint"
                                        Style="{StaticResource SidebarHint}"
                                        Text="{DynamicResource Str_PortScanner_TargetsLooking}" />
                                </StackPanel>
                            </Border>

                            <!--  ============ RANGE: prefix chips, same look as the Subnet Calculator ============  -->
                            <Border
                                x:Name="RangeCard"
                                ctl:Tour.Key="Str_Tour_PortScanner_Range"
                                ctl:Tour.Order="2"
                                Style="{StaticResource SidebarGroupCardStyle}"
                                Visibility="Collapsed">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_PortScanner_RangeHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.CallSplit}" />
                                    <TextBlock
                                        Margin="2,4,0,4"
                                        Style="{StaticResource FieldLabel}"
                                        Text="{DynamicResource Str_PortScanner_RangeLabel}" />
                                    <UniformGrid x:Name="PrefixChips" Margin="-3,4,-3,0" Columns="3">
                                        <Button Click="PrefixChip_Click" Content="/24" Style="{StaticResource ScPrefixChip}" Tag="24" />
                                        <Button Click="PrefixChip_Click" Content="/25" Style="{StaticResource ScPrefixChip}" Tag="25" />
                                        <Button Click="PrefixChip_Click" Content="/26" Style="{StaticResource ScPrefixChip}" Tag="26" />
                                        <Button Click="PrefixChip_Click" Content="/27" Style="{StaticResource ScPrefixChip}" Tag="27" />
                                        <Button Click="PrefixChip_Click" Content="/28" Style="{StaticResource ScPrefixChip}" Tag="28" />
                                        <Button Click="PrefixChip_Click" Content="/30" Style="{StaticResource ScPrefixChip}" Tag="30" />
                                    </UniformGrid>
                                    <Button
                                        x:Name="BtnPrefixWhole"
                                        Margin="0,0,0,0"
                                        Click="PrefixChip_Click"
                                        Content="{DynamicResource Str_PortScanner_RangeWhole}"
                                        Style="{StaticResource ScPrefixChip}"
                                        Tag="0" />
                                    <TextBlock x:Name="TxtRangeHint" Style="{StaticResource SidebarHint}" />
                                </StackPanel>
                            </Border>

                            <!--  ============ ANOTHER HOST ============  -->
                            <Border
                                x:Name="CustomCard"
                                ctl:Tour.Key="Str_Tour_PortScanner_Source"
                                ctl:Tour.Order="3"
                                Style="{StaticResource SidebarGroupCardStyle}"
                                Visibility="Collapsed">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_PortScanner_AnotherHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.Server}" />
                                    <TextBlock
                                        Margin="0,4,0,6"
                                        Style="{StaticResource FieldLabel}"
                                        Text="{DynamicResource Str_NetworkTools_Host}" />
                                    <Border Style="{StaticResource InputBarStyle}">
                                        <TextBox
                                            x:Name="TxtScanHost"
                                            KeyDown="HostBox_KeyDown"
                                            TextChanged="TxtScanHost_TextChanged"
                                            LostFocus="Setting_LostFocus"
                                            Style="{StaticResource BareTextBox}"
                                            Tag="192.168.1.1"
                                            ToolTip="{DynamicResource Str_Network_ScanHostTooltip}" />
                                    </Border>
                                    <TextBlock
                                        Margin="0,12,0,0"
                                        Style="{StaticResource FieldLabel}"
                                        Text="{DynamicResource Str_Ping_Adapter}" />
                                    <controls:SourceAdapterPicker x:Name="SourcePicker" />
                                </StackPanel>
                            </Border>

                            <!--  ============ PORTS ============  -->
                            <Border ctl:Tour.Key="Str_Tour_PortScanner_Ports" ctl:Tour.Order="4" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_PortScanner_PortsHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.Ethernet}" />
                                    <TextBlock
                                        Margin="0,4,0,6"
                                        Style="{StaticResource FieldLabel}"
                                        Text="{DynamicResource Str_NetworkTools_Ports}" />
                                    <Border Style="{StaticResource InputBarStyle}">
                                        <TextBox
                                            x:Name="TxtScanPorts"
                                            KeyDown="HostBox_KeyDown"
                                            LostFocus="Setting_LostFocus"
                                            Style="{StaticResource BareTextBox}"
                                            Tag="80, 443, 8000-8100"
                                            TextChanged="TxtScanPorts_TextChanged"
                                            ToolTip="{DynamicResource Str_NetworkTools_SinglePortsAndRanges}" />
                                    </Border>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!--  First Button: Full Width  -->
                                        <Button
                                            Grid.Row="0"
                                            MinHeight="28"
                                            Margin="0,0,0,2"
                                            Padding="10,0"
                                            Click="PortPreset_Click"
                                            Content="{DynamicResource Str_NetworkTools_Common}"
                                            Style="{StaticResource NeutralIconButtonStyle}"
                                            Tag="common"
                                            ToolTip="{DynamicResource Str_NetworkTools_About50WellKnown}" />

                                        <!--  Remaining Buttons: 1x2 Grid  -->
                                        <UniformGrid
                                            Grid.Row="1"
                                            Margin="0,2,0,0"
                                            Columns="2">
                                            <Button
                                                Height="28"
                                                Margin="0,0,2,0"
                                                Padding="10,0"
                                                Click="PortPreset_Click"
                                                Content="1-1024"
                                                Style="{StaticResource NeutralIconButtonStyle}"
                                                Tag="1-1024"
                                                ToolTip="{DynamicResource Str_NetworkTools_TheStandardSystemPorts}" />
                                            <Button
                                                MinHeight="28"
                                                Margin="2,0,0,0"
                                                Padding="10,0"
                                                Click="PortPreset_Click"
                                                Content="{DynamicResource Str_DiskSpaceAnalyzer_All}"
                                                Style="{StaticResource NeutralIconButtonStyle}"
                                                Tag="all"
                                                ToolTip="{DynamicResource Str_NetworkTools_EveryPort165535}" />
                                        </UniformGrid>
                                    </Grid>
                                    <TextBlock
                                        Margin="0,12,0,6"
                                        Style="{StaticResource FieldLabel}"
                                        Text="{DynamicResource Str_NetworkTools_WaitPerPort}" />
                                    <UniformGrid x:Name="ScanSpeedChips" Columns="3">
                                        <RadioButton
                                            Margin="0,0,2,0"
                                            Click="ScanSpeed_Click"
                                            Content="{DynamicResource Str_NetworkTools_Fast}"
                                            GroupName="ScanSpeed"
                                            controls:ChoiceIcon.Kind="Flash"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="300"
                                            ToolTip="{DynamicResource Str_NetworkTools_300MsFineOn}" />
                                        <RadioButton
                                            Margin="2,0,2,0"
                                            Click="ScanSpeed_Click"
                                            Content="{DynamicResource Str_ImageConvertPDF_Normal}"
                                            GroupName="ScanSpeed"
                                            IsChecked="True"
                                            controls:ChoiceIcon.Kind="Speedometer"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="800"
                                            ToolTip="800 ms" />
                                        <RadioButton
                                            Margin="2,0,0,0"
                                            Click="ScanSpeed_Click"
                                            Content="{DynamicResource Str_NetworkTools_Careful}"
                                            GroupName="ScanSpeed"
                                            controls:ChoiceIcon.Kind="Turtle"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="2000"
                                            ToolTip="{DynamicResource Str_NetworkTools_2SForSlow}" />
                                    </UniformGrid>
                                    <TextBlock x:Name="TxtPortsHint" Style="{StaticResource SidebarHint}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--  ================= MAIN AREA =================  -->

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition x:Name="CardRow" Height="Auto" />
                    <RowDefinition x:Name="ConsoleRow" Height="*" MinHeight="130" />
                </Grid.RowDefinitions>

                <!--  Tool card: action, progress, open ports  -->
                <Border x:Name="ToolCard" Margin="0,0,0,14" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button
                                ctl:Tour.Key="Str_Tour_PortScanner_Run"
                                ctl:Tour.Order="5"
                                x:Name="BtnAction"
                                MinWidth="150"
                                Margin="0,0,16,0"
                                VerticalAlignment="Center"
                                Click="BtnAction_Click"
                                Style="{StaticResource AccentPrimaryButtonStyle}">
                                <Grid HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon
                                        Grid.Column="0"
                                        x:Name="IconAction"
                                        Width="18"
                                        Height="18"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Kind="MagnifyScan" />
                                    <TextBlock
                                        Grid.Column="1"
                                        x:Name="TxtActionLabel"
                                        VerticalAlignment="Center"
                                        Text="{DynamicResource Str_Network_ScanButton}" TextWrapping="Wrap" />
                                </Grid>
                            </Button>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock
                                    x:Name="TxtToolTitle"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimary}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="TxtToolDetail"
                                    Margin="0,2,0,0"
                                    FontSize="11.5"
                                    Foreground="{DynamicResource TextSecondary}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Border
                                x:Name="SourcePill"
                                Grid.Column="2"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource RowBg}"
                                Style="{StaticResource IconStatusPillStyle}"
                                ToolTip="{DynamicResource Str_Ping_TheAdapterThisTool}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        x:Name="IconSource"
                                        Width="13"
                                        Height="13"
                                        Margin="0,0,5,0"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Kind="AutoFix" />
                                    <TextBlock
                                        x:Name="TxtSource"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Text="{DynamicResource Str_NetworkAdapters_Automatic}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <ProgressBar
                            x:Name="ProgressScan"
                            Grid.Row="1"
                            Height="8"
                            Margin="0,14,0,0"
                            Maximum="100" />
                        <Grid Grid.Row="2" Margin="0,12,0,6">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock
                                VerticalAlignment="Center"
                                Style="{StaticResource FieldLabel}"
                                Text="{DynamicResource Str_NetworkTools_OpenPorts}" />
                            <Button
                                x:Name="BtnCollapseAll"
                                Grid.Column="1"
                                Margin="0,0,8,0"
                                Click="BtnCollapseAll_Click"
                                IsEnabled="False"
                                Style="{StaticResource NeutralIconButtonStyle}"
                                ToolTip="{DynamicResource Str_PortScanner_CollapseAllTip}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        x:Name="IconCollapseAll"
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Kind="UnfoldLessHorizontal" />
                                    <TextBlock
                                        x:Name="TxtCollapseAll"
                                        VerticalAlignment="Center"
                                        Text="{DynamicResource Str_PortScanner_CollapseAll}" />
                                </StackPanel>
                            </Button>
                            <controls:ExportButton
                                x:Name="BtnExport"
                                Grid.Column="2"
                                IsEnabled="False"
                                ToolTip="{DynamicResource Str_PortScanner_ExportTip}">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Click="MenuExport_Click" Header="{DynamicResource Str_Common_ExportAsHtml}" Tag="html">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="Web" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Click="MenuExport_Click" Header="{DynamicResource Str_Common_ExportAsPdf}" Tag="pdf">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="FilePdfBox" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                        <MenuItem Click="MenuExport_Click" Header="{DynamicResource Str_Common_ExportAsText}" Tag="txt">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="FileDocumentOutline" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </controls:ExportButton>
                        </Grid>
                        <Grid Grid.Row="3" MinHeight="34">
                            <ScrollViewer x:Name="HostsScroll" MaxHeight="280" HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="HostsList">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:HostPorts}">
                                            <Expander
                                                Margin="0,0,0,6"
                                                IsExpanded="{Binding IsExpanded, Mode=TwoWay}">
                                                <Expander.Header>
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock
                                                            FontFamily="Cascadia Mono, Consolas"
                                                            FontSize="12.5"
                                                            FontWeight="SemiBold"
                                                            Foreground="{DynamicResource TextPrimary}"
                                                            Text="{Binding Host}" />
                                                        <TextBlock
                                                            Margin="8,0,0,0"
                                                            FontSize="11.5"
                                                            Foreground="{DynamicResource TextSecondary}"
                                                            Text="{Binding Label}" />
                                                        <TextBlock
                                                            Margin="8,0,0,0"
                                                            FontSize="11.5"
                                                            Foreground="{DynamicResource TextSecondary}"
                                                            Text="{Binding Status}" />
                                                    </StackPanel>
                                                </Expander.Header>
                                                <Grid Margin="22,2,0,0">
                                                    <ItemsControl Margin="0,4,0,0" ItemsSource="{Binding Ports}">
                                                    <ItemsControl.ItemsPanel>
                                                        <ItemsPanelTemplate>
                                                            <WrapPanel />
                                                        </ItemsPanelTemplate>
                                                    </ItemsControl.ItemsPanel>
                                                    <ItemsControl.ItemTemplate>
                                                        <DataTemplate DataType="{x:Type models:PortResult}">
                                                            <Border
                                                                Margin="0,0,6,6"
                                                                Background="{DynamicResource StatusSuccessBg}"
                                                                Style="{StaticResource IconStatusPillStyle}"
                                                                ToolTip="{Binding LatencyMs, StringFormat='{}{0} ms'}">
                                                                <StackPanel Orientation="Horizontal">
                                                                    <materialDesign:PackIcon
                                                                        Width="12"
                                                                        Height="12"
                                                                        Margin="0,0,5,0"
                                                                        VerticalAlignment="Center"
                                                                        Foreground="{DynamicResource StatusSuccessFg}"
                                                                        Kind="CheckCircleOutline" />
                                                                    <TextBlock
                                                                        FontSize="11.5"
                                                                        FontWeight="SemiBold"
                                                                        Foreground="{DynamicResource StatusSuccessFg}"
                                                                        Text="{Binding Label}" />
                                                                </StackPanel>
                                                            </Border>
                                                        </DataTemplate>
                                                    </ItemsControl.ItemTemplate>
                                                </ItemsControl>
                                                </Grid>
                                            </Expander>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <TextBlock
                                x:Name="TxtNoOpenPorts"
                                VerticalAlignment="Center"
                                FontSize="11.5"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="{DynamicResource Str_NetworkTools_OpenPortsAppearHere}" />
                        </Grid>
                    </Grid>
                </Border>

                <controls:NetworkConsole
                    ctl:Tour.Key="Str_Tour_PortScanner_Results"
                    ctl:Tour.Order="6"
                    x:Name="Results"
                    CollapsedChanged="Results_CollapsedChanged"
                    OpenOnNewLine="False"
                    Title="{DynamicResource Str_PortScanner_ScanLog}"
                    Grid.Row="1"
                    EmptyText="Each open port and the scan summary are listed here."
                    FileNamePrefix="Port scan log" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
