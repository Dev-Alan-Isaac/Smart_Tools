<UserControl
    x:Class="Smart_Tools.WPF.Controls.NetworkConsole"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:models="clr-namespace:Smart_Tools.WPF.Models">

    <!--
        The results console the network tools share (Ping, Port Scanner,
        TCP/UDP Client, My IP & Adapters): time, coloured source chip, text;
        copy, save (never overwrites), clear. Set Title and EmptyText; call Log().
        No content slot, so names inside are fine (MC3093 doesn't apply).
    -->

    <UserControl.Resources>
        <DataTemplate x:Key="ConsoleLineTemplate" DataType="{x:Type models:ConsoleLine}">
            <Grid Margin="0,1">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="62" />
                    <ColumnDefinition Width="52" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Padding="0,2,0,0"
                    FontFamily="Consolas"
                    FontSize="11.5"
                    Foreground="{DynamicResource TextSecondary}"
                    Text="{Binding TimeText}" />
                <Border
                    x:Name="Chip"
                    Grid.Column="1"
                    Margin="0,0,8,0"
                    Padding="0,1"
                    VerticalAlignment="Top"
                    Background="{DynamicResource RowBg}"
                    CornerRadius="6">
                    <TextBlock
                        x:Name="ChipText"
                        HorizontalAlignment="Center"
                        FontSize="10"
                        FontWeight="Bold"
                        Foreground="{DynamicResource TextSecondary}"
                        Text="{Binding Source}" />
                </Border>
                <TextBlock
                    x:Name="LineText"
                    Grid.Column="2"
                    Padding="0,1,0,0"
                    FontFamily="Consolas"
                    FontSize="12"
                    Foreground="{DynamicResource TextPrimary}"
                    Text="{Binding Text}"
                    TextWrapping="Wrap" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Success">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusSuccessBg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusSuccessFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Warning">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusWarningBg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                    <Setter TargetName="LineText" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Error">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusErrorBg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                    <Setter TargetName="LineText" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Sent">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource AccentColorSubtle}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource AccentColor}" />
                    <Setter TargetName="LineText" Property="Foreground" Value="{DynamicResource AccentColor}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Received">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusInfoBg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusInfoFg}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Border Style="{StaticResource CardStyle}">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>
            <Grid Margin="0,0,0,10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <ContentControl
                    x:Name="HeaderLabel"
                    VerticalAlignment="Center"
                    Content="{DynamicResource Str_Network_ConsoleTitle}"
                    Style="{StaticResource CardHeader}"
                    Tag="{x:Static materialDesign:PackIconKind.ConsoleLine}" />
                <Border
                    Grid.Column="1"
                    Margin="10,0,0,0"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Center"
                    Background="{DynamicResource RowBg}"
                    Style="{StaticResource IconStatusPillStyle}"
                    ToolTip="{DynamicResource Str_Network_LastActivityTooltip}">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="12"
                            Height="12"
                            Margin="0,0,5,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextSecondary}"
                            Kind="TimerOutline" />
                        <TextBlock
                            x:Name="TxtLastActivity"
                            FontSize="11"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextSecondary}"
                            Text="{DynamicResource Str_Network_NoActivityYet}" />
                    </StackPanel>
                </Border>
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button
                        Width="32"
                        Height="32"
                        Margin="0,0,6,0"
                        Click="BtnCopy_Click"
                        Style="{StaticResource NeutralIconButtonStyle}"
                        ToolTip="{DynamicResource Str_NetworkConsole_CopyTheSelectedLines}">
                        <materialDesign:PackIcon
                            Width="15"
                            Height="15"
                            Kind="ContentCopy" />
                    </Button>
                    <Button
                        Width="32"
                        Height="32"
                        Margin="0,0,6,0"
                        Click="BtnSave_Click"
                        Style="{StaticResource NeutralIconButtonStyle}"
                        ToolTip="{DynamicResource Str_NetworkConsole_SaveTheConsoleTo}">
                        <materialDesign:PackIcon
                            Width="15"
                            Height="15"
                            Kind="ContentSaveOutline" />
                    </Button>
                    <Button
                        Click="BtnClear_Click"
                        Style="{StaticResource DangerButtonStyle}"
                        ToolTip="{DynamicResource Str_Network_ClearConsoleTooltip}">
                        <Grid HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon
                                Grid.Column="0"
                                Width="14"
                                Height="14"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Kind="DeleteSweepOutline" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_Network_ClearConsole}" TextWrapping="Wrap" />
                        </Grid>
                    </Button>
                </StackPanel>
            </Grid>

            <Border
                Grid.Row="1"
                Background="{DynamicResource InputBg}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1"
                CornerRadius="8">
                <Grid>
                    <ListBox
                        x:Name="ConsoleList"
                        Padding="8,6"
                        Background="Transparent"
                        BorderThickness="0"
                        ItemTemplate="{StaticResource ConsoleLineTemplate}"
                        KeyDown="ConsoleList_KeyDown"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectionMode="Extended"
                        ToolTip="{DynamicResource Str_Network_ConsoleOutputTooltip}"
                        VirtualizingPanel.IsVirtualizing="True"
                        VirtualizingPanel.ScrollUnit="Pixel"
                        VirtualizingPanel.VirtualizationMode="Recycling">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="4,1" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border
                                                x:Name="Bd"
                                                Padding="{TemplateBinding Padding}"
                                                Background="Transparent"
                                                CornerRadius="6">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowBg}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentColorSubtle}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                    </ListBox>
                    <StackPanel
                        x:Name="ConsoleEmpty"
                        Margin="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        IsHitTestVisible="False">
                        <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.ConsoleLine}" />
                        <TextBlock
                            x:Name="TxtEmpty"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Center"
                            FontSize="12.5"
                            Foreground="{DynamicResource TextSecondary}"
                            Text="{DynamicResource Str_NetworkConsole_ResultsCollectHereNewest}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Border>
</UserControl>
