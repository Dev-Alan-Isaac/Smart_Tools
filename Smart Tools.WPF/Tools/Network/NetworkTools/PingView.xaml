<UserControl
    x:Class="Smart_Tools.WPF.Views.PingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:models="clr-namespace:Smart_Tools.WPF.Models"
    x:Name="Root"
    Loaded="View_Loaded"
    Unloaded="View_Unloaded">

    <!--
        Ping - is a host reachable, and how fast, from the adapter you choose.
        Backend: Controllers/NetworkToolsManager.cs (PingAsync), NetworkToolsManager.Source.cs
        (sending from a chosen adapter); Controls/NetworkConsole, Controls/SourceAdapterPicker.
        This file and the code-behind are UI only.
    -->

    <UserControl.Resources>

        <!--  Small number tile on the tool card  -->
        <Style x:Key="SidebarHint" TargetType="TextBlock">
            <Setter Property="Margin" Value="2,10,0,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextMuted}" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">

        <!--  No page header: MainWindow's header card shows the tool's icon and name.  -->

        <Grid Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OptionsColumn" Width="280" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= SIDEBAR =================  -->

            <Border Grid.Column="0" Style="{StaticResource SidebarPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Button
                            x:Name="BtnCollapseOptions"
                            MinHeight="45"
                            HorizontalContentAlignment="Left"
                            Click="BtnCollapseOptions_Click"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Foreground="{DynamicResource SidebarText}"
                            ToolTip="{DynamicResource Str_Common_SidebarToggleTooltip}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="OverridesDefaultStyle" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Margin="16,0,0,0" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Kind="TuneVariant" />
                                <TextBlock
                                    x:Name="TxtOptionsHeaderLabel"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{DynamicResource Str_Common_OptionsLabel}" />
                            </StackPanel>
                        </Button>
                        <Separator
                            x:Name="SepHeader"
                            Margin="16,4"
                            Style="{StaticResource SidebarSeparatorStyle}" />
                    </StackPanel>

                    <ScrollViewer
                        x:Name="OptionsScrollViewer"
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16,4,16,16">
                            <!--  ============ PING ============  -->
                            <Border ctl:Tour.Key="Str_Tour_Ping_Target" ctl:Tour.Order="1" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Network_PingHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.Pulse}" />
                                    <TextBlock
                                        Margin="0,0,0,6"
                                        Style="{StaticResource FieldLabel}"
                                        Text="{DynamicResource Str_NetworkTools_Host}" />
                                    <Border Style="{StaticResource InputBarStyle}">
                                        <TextBox
                                            x:Name="TxtPingHost"
                                            KeyDown="HostBox_KeyDown"
                                            LostFocus="Setting_LostFocus"
                                            Style="{StaticResource BareTextBox}"
                                            Tag="google.com or 192.168.1.1"
                                            ToolTip="{DynamicResource Str_Network_PingHostTooltip}" />
                                    </Border>
                                    <TextBlock
                                        Margin="0,12,0,6"
                                        Style="{StaticResource FieldLabel}"
                                        Text="{DynamicResource Str_NetworkTools_HowMany}" />
                                    <Grid x:Name="PingCountChips">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!--  First Option: Full Width (4)  -->
                                        <RadioButton
                                            Grid.Row="0"
                                            Margin="0,0,0,2"
                                            Click="PingCount_Click"
                                            Content="4"
                                            GroupName="PingCount"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="4"
                                            ToolTip="{DynamicResource Str_NetworkTools_FourPingsLikeThe}" />

                                        <!--  Middle Options: 1x2 Grid (10 & 50)  -->
                                        <UniformGrid
                                            Grid.Row="1"
                                            Margin="0,2"
                                            Columns="2">
                                            <RadioButton
                                                Margin="0,0,2,0"
                                                Click="PingCount_Click"
                                                Content="10"
                                                GroupName="PingCount"
                                                Style="{StaticResource ModeToggleButtonStyle}"
                                                Tag="10" />
                                            <RadioButton
                                                Margin="2,0,0,0"
                                                Click="PingCount_Click"
                                                Content="50"
                                                GroupName="PingCount"
                                                Style="{StaticResource ModeToggleButtonStyle}"
                                                Tag="50" />
                                        </UniformGrid>

                                        <!--  Last Option: Full Width (∞)  -->
                                        <RadioButton
                                            Grid.Row="2"
                                            Margin="0,2,0,0"
                                            Click="PingCount_Click"
                                            Content="∞"
                                            GroupName="PingCount"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="0"
                                            ToolTip="{DynamicResource Str_NetworkTools_KeepPingingUntilStop}" />
                                    </Grid>
                                    <TextBlock Style="{StaticResource SidebarHint}" Text="{DynamicResource Str_NetworkTools_OnePingASecond}" />
                                </StackPanel>
                            </Border>

                            <!--  ============ SEND FROM ============  -->
                            <Border ctl:Tour.Key="Str_Tour_Ping_Source" ctl:Tour.Order="2" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Ping_Adapter}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.Ethernet}" />
                                    <controls:SourceAdapterPicker x:Name="SourcePicker" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--  ================= MAIN AREA =================  -->

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Tool card: action, numbers, latency strip  -->
                <Border Margin="0,0,0,14" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Button
                                ctl:Tour.Key="Str_Tour_Ping_Run"
                                ctl:Tour.Order="3"
                                x:Name="BtnAction"
                                MinWidth="150"
                                Margin="0,0,16,0"
                                VerticalAlignment="Center"
                                Click="BtnAction_Click"
                                Style="{StaticResource AccentPrimaryButtonStyle}">
                                <Grid HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon
                                        Grid.Column="0"
                                        x:Name="IconAction"
                                        Width="18"
                                        Height="18"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Kind="PlayCircleOutline" />
                                    <TextBlock
                                        Grid.Column="1"
                                        x:Name="TxtActionLabel"
                                        VerticalAlignment="Center"
                                        Text="{DynamicResource Str_Network_PingHeader}" TextWrapping="Wrap" />
                                </Grid>
                            </Button>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock
                                    x:Name="TxtToolTitle"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimary}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="TxtToolDetail"
                                    Margin="0,2,0,0"
                                    FontSize="11.5"
                                    Foreground="{DynamicResource TextSecondary}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Border
                                x:Name="SourcePill"
                                Grid.Column="2"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource RowBg}"
                                Style="{StaticResource IconStatusPillStyle}"
                                ToolTip="{DynamicResource Str_Ping_TheAdapterThisTool}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        x:Name="IconSource"
                                        Width="13"
                                        Height="13"
                                        Margin="0,0,5,0"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Kind="AutoFix" />
                                    <TextBlock
                                        x:Name="TxtSource"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Text="{DynamicResource Str_NetworkAdapters_Automatic}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <WrapPanel Margin="0,14,0,0">
                            <Border Style="{StaticResource StatTileStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource StatLabelStyle}" Text="{DynamicResource Str_NetworkTools_Replies}" />
                                    <TextBlock
                                        x:Name="TxtStatReplies"
                                        Style="{StaticResource StatValueStyle}"
                                        Text="–" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatTileStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource StatLabelStyle}" Text="{DynamicResource Str_NetworkTools_Lost}" />
                                    <TextBlock
                                        x:Name="TxtStatLoss"
                                        Style="{StaticResource StatValueStyle}"
                                        Text="–" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatTileStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource StatLabelStyle}" Text="{DynamicResource Str_NetworkTools_Average}" />
                                    <TextBlock
                                        x:Name="TxtStatAvg"
                                        Style="{StaticResource StatValueStyle}"
                                        Text="–" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatTileStyle}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource StatLabelStyle}" Text="{DynamicResource Str_NetworkTools_MinMax}" />
                                    <TextBlock
                                        x:Name="TxtStatMinMax"
                                        Style="{StaticResource StatValueStyle}"
                                        Text="–" />
                                </StackPanel>
                            </Border>
                            <Border Style="{StaticResource StatTileStyle}" ToolTip="{DynamicResource Str_NetworkTools_HowMuchTheTime}">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource StatLabelStyle}" Text="{DynamicResource Str_NetworkTools_Jitter}" />
                                    <TextBlock
                                        x:Name="TxtStatJitter"
                                        Style="{StaticResource StatValueStyle}"
                                        Text="–" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>

                        <!--  Latency strip: one bar per ping, red = lost  -->
                        <Border
                            Height="48"
                            Padding="8,6"
                            Background="{DynamicResource RowBg}"
                            CornerRadius="10">
                            <Grid>
                                <ItemsControl x:Name="LatencyStrip" VerticalAlignment="Bottom">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <StackPanel Orientation="Horizontal" />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type models:LatencyBar}">
                                            <Border
                                                x:Name="Bar"
                                                Width="8"
                                                Height="36"
                                                Margin="0,0,3,0"
                                                Background="{DynamicResource AccentColor}"
                                                CornerRadius="3"
                                                RenderTransformOrigin="0.5,1"
                                                ToolTip="{Binding ToolTip}">
                                                <Border.RenderTransform>
                                                    <ScaleTransform ScaleY="{Binding Height}" />
                                                </Border.RenderTransform>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding Lost}" Value="True">
                                                    <Setter TargetName="Bar" Property="Background" Value="{DynamicResource StatusErrorFg}" />
                                                    <Setter TargetName="Bar" Property="Opacity" Value="0.55" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <TextBlock
                                    x:Name="TxtLatencyEmpty"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{DynamicResource Str_NetworkTools_EachPingAppearsHere}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <controls:NetworkConsole
                    ctl:Tour.Key="Str_Tour_Ping_Replies"
                    ctl:Tour.Order="4"
                    x:Name="Results"
                    Title="{DynamicResource Str_NetworkTools_Replies}"
                    Grid.Row="1"
                    EmptyText="Each reply is listed here, with the adapter it was sent from."
                    FileNamePrefix="Ping log" />
            </Grid>
        </Grid>
    </Grid>
</UserControl>
