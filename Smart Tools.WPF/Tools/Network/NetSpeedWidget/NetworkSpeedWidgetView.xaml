<UserControl
    x:Class="Smart_Tools.WPF.Views.NetworkSpeedWidgetView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Loaded="View_Loaded">

    <!--
        Backend: Controllers/NetworkSpeedWidgetManager.cs (counters, rates, units,
        settings), Controllers/OuiLookupManager.cs (MAC -> manufacturer),
        Controllers/NetworkSpeedWidgetWindow.cs (the floating widget);
        Models/NetSpeedWidgetModel.cs. This file and the code-behind are UI only.
    -->

    <Grid Margin="16,8,16,16">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="14" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!--  Live preview: fills the whole area  -->
        <Border ctl:Tour.Key="Str_Tour_NetWidget_Live" ctl:Tour.Order="1" Grid.Column="2" Padding="20" Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" MinHeight="140" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <ContentControl Content="{DynamicResource Str_NetWidget_Live}" Style="{StaticResource CardHeader}" />

                <!--  Now, peak and average, download and upload  -->
                <UniformGrid Grid.Row="1" Margin="0,14,0,0" Columns="2">
                    <Border Margin="0,0,8,0" Padding="18,14" Background="{DynamicResource RowBg}" CornerRadius="12">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource Str_NetWidget_Download}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtDownValue" FontSize="40" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Text="0" />
                                <TextBlock x:Name="TxtDownUnit" Margin="6,0,0,9" VerticalAlignment="Bottom" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                            <TextBlock x:Name="TxtDownStats" Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>
                    </Border>
                    <Border Margin="8,0,0,0" Padding="18,14" Background="{DynamicResource RowBg}" CornerRadius="12">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource Str_NetWidget_Upload}" />
                            <StackPanel Orientation="Horizontal">
                                <TextBlock x:Name="TxtUpValue" FontSize="40" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Text="0" />
                                <TextBlock x:Name="TxtUpUnit" Margin="6,0,0,9" VerticalAlignment="Bottom" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                            <TextBlock x:Name="TxtUpStats" Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <!--  The graph takes all the free height  -->
                <Border Grid.Row="2" Margin="0,14,0,0" Padding="14,12" Background="{DynamicResource RowBg}" CornerRadius="12">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <DockPanel Margin="0,0,0,8">
                            <TextBlock DockPanel.Dock="Right" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource Str_NetWidget_GraphLegend}" />
                            <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource Str_NetWidget_GraphTitle}" />
                        </DockPanel>
                        <controls:SystemMonitorSparkline
                            x:Name="Graph"
                            Grid.Row="1"
                            Capacity="300"
                            MinHeight="100"
                            ShowGrid="True"
                            Stroke="{DynamicResource AccentFill}" />
                    </Grid>
                </Border>

                <!--  Session totals and which card is being measured  -->
                <Grid Grid.Row="3" Margin="0,14,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Border Padding="16,12" Background="{DynamicResource RowBg}" CornerRadius="12">
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource Str_NetWidget_Session}" />
                            <TextBlock x:Name="TxtSession" Margin="0,4,0,0" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                    <Border Grid.Column="2" Padding="16,12" Background="{DynamicResource RowBg}" CornerRadius="12">
                        <StackPanel>
                            <TextBlock x:Name="TxtAdapterName" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="TxtAdapterDesc" Margin="0,2,0,0" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="TxtAdapterMaker" Margin="0,6,0,0" Foreground="{DynamicResource TextPrimary}" TextWrapping="Wrap" />
                            <TextBlock x:Name="TxtAdapterMac" Margin="0,2,0,0" Foreground="{DynamicResource TextSecondary}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Border>

        <!--  Options (shared ToolSidebar: on the left, collapsible)  -->
        <controls:ToolSidebar Grid.Column="0">
<StackPanel>
<Border Margin="0,0,0,10" Style="{StaticResource SidebarGroupCardStyle}">
<StackPanel>
<ContentControl Content="{DynamicResource Str_NetWidget_WidgetHeader}" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.Widgets}" />
<Button
                        ctl:Tour.Key="Str_Tour_NetWidget_Show"
                        ctl:Tour.Order="3"
                        x:Name="BtnToggleWidget"
                        MinHeight="40"
                        Click="BtnToggleWidget_Click"
                        Content="{DynamicResource Str_NetWidget_Show}"
                        Style="{StaticResource PrimaryButtonStyle}" />
</StackPanel>
</Border>
<Border Margin="0,0,0,10" Style="{StaticResource SidebarGroupCardStyle}">
<StackPanel>
<ContentControl Content="{DynamicResource Str_NetWidget_Adapter}" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.LanConnect}" />
<ComboBox ctl:Tour.Key="Str_Tour_NetWidget_Adapter" ctl:Tour.Order="2" x:Name="CmbAdapter" SelectionChanged="CmbAdapter_SelectionChanged" />
</StackPanel>
</Border>
<Border Margin="0,0,0,10" Style="{StaticResource SidebarGroupCardStyle}">
<StackPanel>
<ContentControl Content="{DynamicResource Str_NetWidget_DataHeader}" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.SpeedometerMedium}" />
<TextBlock Margin="0,0,0,4" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource Str_NetWidget_Units}" />
<UniformGrid Columns="2">
                        <RadioButton x:Name="RadioBytes" Margin="0,0,3,0" Checked="Option_Changed" Content="{DynamicResource Str_NetWidget_Bytes}" GroupName="NetWidgetUnits" IsChecked="True" Style="{StaticResource ModeToggleButtonStyle}" />
                        <RadioButton x:Name="RadioBits" Margin="3,0,0,0" Checked="Option_Changed" Content="{DynamicResource Str_NetWidget_Bits}" GroupName="NetWidgetUnits" Style="{StaticResource ModeToggleButtonStyle}" />
                    </UniformGrid>
<TextBlock Margin="0,12,0,4" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource Str_NetWidget_Refresh}" />
<ComboBox x:Name="CmbRefresh" SelectionChanged="Option_Changed" />
</StackPanel>
</Border>
<Border Margin="0,0,0,10" Style="{StaticResource SidebarGroupCardStyle}">
<StackPanel>
<ContentControl Content="{DynamicResource Str_NetWidget_LookHeader}" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.PaletteOutline}" />
<TextBlock Margin="0,0,0,0" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource Str_NetWidget_Opacity}" />
<Slider x:Name="SliderOpacity" Margin="0,8,0,0" Maximum="1" Minimum="0.3" SmallChange="0.05" LargeChange="0.1" TickFrequency="0.05" ValueChanged="SliderOpacity_ValueChanged" Value="0.9" />
<CheckBox
    x:Name="ChkMini"
    Margin="0,0,0,0"
    Checked="Option_Changed"
    Unchecked="Option_Changed"
    Content="{DynamicResource Str_NetWidget_Mini}" />
<CheckBox
    x:Name="ChkMaker"
    Margin="0,8,0,0"
    Checked="Option_Changed"
    Unchecked="Option_Changed"
    Content="{DynamicResource Str_NetWidget_ShowMaker}"
    IsChecked="True" />
<CheckBox
    x:Name="ChkClickThrough"
    Margin="0,8,0,0"
    Checked="Option_Changed"
    Unchecked="Option_Changed"
    Content="{DynamicResource Str_NetWidget_ClickThrough}" />
</StackPanel>
</Border>
<TextBlock Margin="2,2,2,0" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource Str_NetWidget_Hint}" TextWrapping="Wrap" />
</StackPanel>
</controls:ToolSidebar>
    </Grid>
</UserControl>
