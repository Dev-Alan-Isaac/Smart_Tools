<UserControl
    x:Class="Smart_Tools.WPF.Views.RegexTesterView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:models="clr-namespace:Smart_Tools.WPF.Models"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    x:Name="Root"
    AllowDrop="True"
    Loaded="Root_Loaded"
    PreviewDragLeave="Root_DragLeave"
    PreviewDragOver="Root_DragOver"
    PreviewDrop="Root_Drop"
    PreviewKeyDown="Root_PreviewKeyDown"
    SizeChanged="Root_SizeChanged">

    <!--
        Backend: Controllers/RegexManager.cs (matching, line:column, replace
        preview, reading text files, folder search, CSV, settings) and
        RegexManager.Breakdown.cs (the plain-words pattern breakdown);
        Models/RegexTesterModel.cs. This file and the code-behind are UI only.
    -->

    <UserControl.Resources>

        <!--  Breakdown: the piece of the pattern as a chip, coloured by kind  -->
        <DataTemplate x:Key="BreakdownTokenTemplate" DataType="{x:Type models:RegexBreakdownRow}">
            <Border
                x:Name="Chip"
                Margin="0,4"
                Padding="7,2"
                HorizontalAlignment="Left"
                VerticalAlignment="Top"
                Background="{DynamicResource StatusInfoBg}"
                CornerRadius="6">
                <TextBlock
                    x:Name="ChipText"
                    MaxWidth="150"
                    FontFamily="Consolas"
                    FontSize="11.5"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource StatusInfoFg}"
                    Text="{Binding DisplayToken, Mode=OneWay}"
                    TextWrapping="Wrap" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Group">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusWarningBg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Anchor">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusSuccessBg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusSuccessFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Alternation">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource AccentFill}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="White" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Option">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource AccentColorSubtle}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource AccentColor}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Comment">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource RowBg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource TextSecondary}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Problem">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusErrorBg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  Groups grid: "Whole match" rows stand out, group rows are muted  -->
        <DataTemplate x:Key="GroupNameTemplate" DataType="{x:Type models:RegexMatchRow}">
            <Border
                x:Name="Chip"
                Padding="6,1"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="{DynamicResource RowBg}"
                CornerRadius="6">
                <TextBlock
                    x:Name="ChipText"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextSecondary}"
                    Text="{Binding GroupName, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsWholeMatch}" Value="True">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource AccentColorSubtle}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource AccentColor}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="MonoCellText" TargetType="TextBlock">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
            <Setter Property="ToolTip" Value="{Binding Text, RelativeSource={RelativeSource Self}}" />
        </Style>

        <Style x:Key="MutedCellText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">

        <!--  No page header: MainWindow's header card shows the tool's icon and name.  -->

        <Grid Margin="16,8,16,16">

            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OptionsColumn" Width="280" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= OPTIONS SIDEBAR =================  -->

            <Border Grid.Column="0" Style="{StaticResource SidebarPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Button
                            x:Name="BtnCollapseOptions"
                            MinHeight="45"
                            HorizontalContentAlignment="Left"
                            Click="BtnCollapseOptions_Click"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Foreground="{DynamicResource SidebarText}"
                            ToolTip="{DynamicResource Str_Common_SidebarToggleTooltip}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="OverridesDefaultStyle" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Margin="16,0,0,0" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Kind="TuneVariant" />
                                <TextBlock
                                    x:Name="TxtOptionsHeaderLabel"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{DynamicResource Str_Common_OptionsLabel}" />
                            </StackPanel>
                        </Button>
                        <Separator
                            x:Name="SepHeader"
                            Margin="16,4"
                            Style="{StaticResource SidebarSeparatorStyle}" />
                    </StackPanel>

                    <ScrollViewer
                        x:Name="OptionsScrollViewer"
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16,4,16,16">

                            <!--  ============ INPUT SOURCE ============  -->
                            <Border ctl:Tour.Key="Str_Tour_RegexTester_Source" ctl:Tour.Order="1" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Regex_InputSourceHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.SourceBranch}" />

                                    <UniformGrid Columns="3" ToolTip="{DynamicResource Str_Regex_InputSourceTooltip}">
                                        <RadioButton
                                            x:Name="RadioModeText"
                                            Margin="0,0,2,0"
                                            Click="Mode_Click"
                                            GroupName="RegexSource"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="Text">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="18"
                                                    Height="18"
                                                    HorizontalAlignment="Center"
                                                    Kind="FormTextbox" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    HorizontalAlignment="Center"
                                                    Text="{DynamicResource Str_FileDiff_ColHeaderText}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="RadioModeFile"
                                            Margin="2,0"
                                            Click="Mode_Click"
                                            GroupName="RegexSource"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="File">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="18"
                                                    Height="18"
                                                    HorizontalAlignment="Center"
                                                    Kind="FileDocumentOutline" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    HorizontalAlignment="Center"
                                                    Text="{DynamicResource Str_QR_InputFile}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="RadioModeFolder"
                                            Margin="2,0,0,0"
                                            Click="Mode_Click"
                                            GroupName="RegexSource"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="Folder">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="18"
                                                    Height="18"
                                                    HorizontalAlignment="Center"
                                                    Kind="FolderSearchOutline" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    HorizontalAlignment="Center"
                                                    Text="{DynamicResource Str_Common_ColHeaderFolder}" />
                                            </StackPanel>
                                        </RadioButton>
                                    </UniformGrid>

                                    <TextBlock
                                        x:Name="TxtModeHint"
                                        Margin="2,8,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource SidebarTextMuted}"
                                        TextWrapping="Wrap" />

                                    <!--  File  -->
                                    <StackPanel
                                        x:Name="PanelFileSource"
                                        Margin="0,10,0,0"
                                        Visibility="Collapsed">
                                        <Button
                                            x:Name="BtnChooseFile"
                                            HorizontalAlignment="Stretch"
                                            Click="BtnChooseFile_Click"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            ToolTip="{DynamicResource Str_Regex_ChooseFileTooltip}">
                                            <Grid HorizontalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon
                                                    Grid.Column="0"
                                                    Width="16"
                                                    Height="16"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Kind="FileFindOutline" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_Common_ChooseFile}" TextWrapping="Wrap" />
                                            </Grid>
                                        </Button>
                                        <Border
                                            Margin="0,8,0,0"
                                            Padding="10,8"
                                            Background="{DynamicResource SidebarInputBg}"
                                            BorderBrush="{DynamicResource SidebarInputBorder}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon
                                                    Width="16"
                                                    Height="16"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource AccentColor}"
                                                    Kind="FileDocumentOutline" />
                                                <StackPanel Grid.Column="1">
                                                    <TextBlock
                                                        x:Name="TxtFilePath"
                                                        FontSize="11.5"
                                                        FontWeight="SemiBold"
                                                        Foreground="{DynamicResource SidebarText}"
                                                        Text="{DynamicResource Str_Common_NoFileSelected}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        x:Name="TxtFileInfo"
                                                        FontSize="11"
                                                        Foreground="{DynamicResource SidebarTextMuted}"
                                                        Text="{DynamicResource Str_RegexTester_OrDropAFile}"
                                                        TextTrimming="CharacterEllipsis" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>

                                    <!--  Folder  -->
                                    <StackPanel
                                        x:Name="PanelFolderSource"
                                        Margin="0,10,0,0"
                                        Visibility="Collapsed">
                                        <Button
                                            x:Name="BtnChooseFolder"
                                            HorizontalAlignment="Stretch"
                                            Click="BtnChooseFolder_Click"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            ToolTip="{DynamicResource Str_Regex_ChooseFolderTooltip}">
                                            <Grid HorizontalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon
                                                    Grid.Column="0"
                                                    Width="16"
                                                    Height="16"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Kind="FolderOpenOutline" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_Common_ChooseFolder}" TextWrapping="Wrap" />
                                            </Grid>
                                        </Button>
                                        <Border
                                            Margin="0,8,0,0"
                                            Padding="10,8"
                                            Background="{DynamicResource SidebarInputBg}"
                                            BorderBrush="{DynamicResource SidebarInputBorder}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon
                                                    Width="16"
                                                    Height="16"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource AccentColor}"
                                                    Kind="FolderOutline" />
                                                <TextBlock
                                                    x:Name="TxtFolderPath"
                                                    Grid.Column="1"
                                                    VerticalAlignment="Center"
                                                    FontSize="11.5"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource SidebarText}"
                                                    Text="{DynamicResource Str_Common_NoFolderSelected}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </Grid>
                                        </Border>
                                        <CheckBox
                                            x:Name="ChkIncludeSubfolders"
                                            Margin="0,10,0,0"
                                            Click="Option_Click"
                                            Content="{DynamicResource Str_Common_IncludeSubfolders}"
                                            Foreground="{DynamicResource SidebarText}"
                                            IsChecked="True"
                                            ToolTip="{DynamicResource Str_Regex_IncludeSubfoldersTooltip}"
                                            controls:ChoiceIcon.Kind="FolderMultipleOutline"
                                            Style="{StaticResource ToggleChipCheckBoxStyle}" />
                                        <TextBlock
                                            Margin="2,10,0,4"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource SidebarText}"
                                            Text="{DynamicResource Str_RegexTester_OnlyTheseFiles}" />
                                        <Border Style="{StaticResource InputBarStyle}">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon
                                                    Width="15"
                                                    Height="15"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource AccentColor}"
                                                    Kind="FilterVariant" />
                                                <TextBox
                                                    x:Name="TxtFileFilter"
                                                    Grid.Column="1"
                                                    FontFamily="Consolas"
                                                    Style="{StaticResource BareTextBox}"
                                                    Tag="* = every file"
                                                    TextChanged="TxtFileFilter_TextChanged"
                                                    ToolTip="{DynamicResource Str_RegexTester_FileTypesToSearch}" />
                                            </Grid>
                                        </Border>
                                        <TextBlock
                                            Margin="2,6,0,0"
                                            FontSize="11"
                                            Foreground="{DynamicResource SidebarTextMuted}"
                                            Text="{DynamicResource Str_RegexTester_BinaryFilesLinksAnd}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!--  ============ EXAMPLES ============  -->
                            <Border ctl:Tour.Key="Str_Tour_RegexTester_Examples" ctl:Tour.Order="2" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Regex_ExamplesHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.LightbulbOnOutline}" />
                                    <ComboBox
                                        x:Name="CmbPatternPresets"
                                        SelectionChanged="CmbPatternPresets_SelectionChanged"
                                        ToolTip="{DynamicResource Str_Regex_ExamplesTooltip}" />
                                    <TextBlock
                                        Margin="2,6,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource SidebarTextMuted}"
                                        Text="{DynamicResource Str_Regex_ExamplesHint}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!--  ============ FLAGS ============  -->
                            <Border ctl:Tour.Key="Str_Tour_RegexTester_Flags" ctl:Tour.Order="3" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Regex_FlagsHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.FlagOutline}" />
                                    <CheckBox
                                        x:Name="ChkIgnoreCase"
                                        Margin="0,0,0,6"
                                        Click="Option_Click"
                                        Content="{DynamicResource Str_Regex_IgnoreCase}"
                                        Foreground="{DynamicResource SidebarText}"
                                        ToolTip="{DynamicResource Str_Common_IgnoreCaseTooltip}"
                                        controls:ChoiceIcon.Kind="FormatLetterCase"
                                        Style="{StaticResource ToggleChipCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="ChkMultiline"
                                        Margin="0,0,0,6"
                                        Click="Option_Click"
                                        Content="{DynamicResource Str_Regex_Multiline}"
                                        Foreground="{DynamicResource SidebarText}"
                                        ToolTip="{DynamicResource Str_Regex_MultilineTooltip}"
                                        controls:ChoiceIcon.Kind="Regex"
                                        Style="{StaticResource ToggleChipCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="ChkSingleline"
                                        Margin="0,0,0,6"
                                        Click="Option_Click"
                                        Content="{DynamicResource Str_Regex_Singleline}"
                                        Foreground="{DynamicResource SidebarText}"
                                        ToolTip="{DynamicResource Str_Common_DotMatchesNewlineTooltip}"
                                        controls:ChoiceIcon.Kind="Regex"
                                        Style="{StaticResource ToggleChipCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="ChkIgnoreWhitespace"
                                        Margin="0,0,0,6"
                                        Click="Option_Click"
                                        Content="{DynamicResource Str_RegexTester_IgnoreWhitespaceX}"
                                        Foreground="{DynamicResource SidebarText}"
                                        ToolTip="{DynamicResource Str_RegexTester_SpacesInThePattern}"
                                        controls:ChoiceIcon.Kind="KeyboardSpace"
                                        Style="{StaticResource ToggleChipCheckBoxStyle}" />
                                    <TextBlock
                                        x:Name="TxtFlagsSummary"
                                        Margin="0,8,0,0"
                                        FontFamily="Consolas"
                                        FontSize="11"
                                        Foreground="{DynamicResource SidebarTextMuted}"
                                        TextWrapping="Wrap"
                                        ToolTip="{DynamicResource Str_RegexTester_TheSameFlagsWritten}" />
                                </StackPanel>
                            </Border>

                            <!--  ============ QUICK REFERENCE ============  -->
                            <Border Margin="0,0,0,4" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Regex_QuickReference}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.BookOpenVariant}" />
                                    <TextBlock
                                        Margin="2,0,0,8"
                                        FontSize="11"
                                        Foreground="{DynamicResource SidebarTextMuted}"
                                        Text="{DynamicResource Str_RegexTester_ClickAPieceTo}"
                                        TextWrapping="Wrap" />
                                    <!--  Filled from code (QuickReference), so each chip can insert itself  -->
                                    <StackPanel x:Name="QuickRefList" ToolTip="{DynamicResource Str_Regex_QuickReferenceTooltip}" />
                                    <TextBlock
                                        Margin="2,8,0,0"
                                        FontSize="10"
                                        FontStyle="Italic"
                                        Foreground="{DynamicResource SidebarTextMuted}"
                                        Text="{DynamicResource Str_Regex_CombineHint}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel x:Name="OptionsBottomPanel" Grid.Row="2" />
                </Grid>
            </Border>

            <!--  ================= MAIN =================  -->

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Run bar  -->
                <Border
                    Grid.Row="0"
                    Margin="0,0,0,12"
                    Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button
                            x:Name="BtnRunTest"
                            ctl:Tour.Key="Str_Tour_RegexTester_Run" ctl:Tour.Order="5"
                            MinWidth="170"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Click="BtnRunTest_Click"
                            Style="{StaticResource AccentPrimaryButtonStyle}"
                            ToolTip="{DynamicResource Str_Regex_RunTestTooltip}">
                            <Grid HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon
                                    Grid.Column="0"
                                    x:Name="IconRunTest"
                                    Width="18"
                                    Height="18"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Kind="Play" />
                                <TextBlock
                                    Grid.Column="1"
                                    x:Name="TxtRunTestLabel"
                                    VerticalAlignment="Center"
                                    Text="{DynamicResource Str_Regex_RunTest}" TextWrapping="Wrap" />
                            </Grid>
                        </Button>

                        <controls:ExportButton
                            x:Name="BtnExportCsv"
                            Grid.Column="1"
                            Margin="0,0,16,0"
                            VerticalAlignment="Center"
                            IsEnabled="False"
                            ToolTip="{DynamicResource Str_Regex_ExportCsvTooltip}">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Click="MenuExportCsv_Click" Header="{DynamicResource Str_Common_ExportAsCsv}">
                                        <MenuItem.Icon>
                                            <materialDesign:PackIcon Kind="FileDelimitedOutline" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </Button.ContextMenu>
                        </controls:ExportButton>

                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <ProgressBar
                                x:Name="ProgressRegex"
                                Height="8"
                                Margin="0,0,0,6"
                                Maximum="100"
                                ToolTip="{DynamicResource Str_Regex_ProgressTooltip}"
                                Visibility="Collapsed" />
                            <TextBlock
                                x:Name="TxtProgress"
                                FontSize="11.5"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="{DynamicResource Str_Regex_ProgressInitial}"
                                TextTrimming="CharacterEllipsis"
                                ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                        </StackPanel>

                        <TextBlock
                            x:Name="TxtProgressPercent"
                            Grid.Column="3"
                            MinWidth="54"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="{DynamicResource AccentColor}"
                            TextAlignment="Right"
                            Visibility="Collapsed" />
                    </Grid>
                </Border>

                <!--  Pattern  -->
                <Border
                    Grid.Row="1"
                    Margin="0,0,0,12"
                    Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentControl
                                VerticalAlignment="Center"
                                Content="{DynamicResource Str_Regex_PatternHeader}"
                                Style="{StaticResource CardHeader}"
                                Tag="{x:Static materialDesign:PackIconKind.Regex}" />
                            <Border
                                x:Name="PillMatchState"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Background="{DynamicResource RowBg}"
                                Style="{StaticResource IconStatusPillStyle}"
                                ToolTip="{Binding Text, ElementName=TxtProgress}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        x:Name="IconMatchState"
                                        Width="13"
                                        Height="13"
                                        Margin="0,0,5,0"
                                        VerticalAlignment="Center"
                                        Foreground="{Binding Foreground, ElementName=TxtMatchState}"
                                        Kind="Regex" />
                                    <TextBlock
                                        x:Name="TxtMatchState"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Text="{DynamicResource Str_RegexTester_TypeAPattern}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <Border Style="{StaticResource InputBarStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon
                                    Width="18"
                                    Height="18"
                                    Margin="2,0,6,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource AccentColor}"
                                    Kind="SlashForward" />
                                <TextBox
                                    x:Name="PatternTextBox"
                                    ctl:Tour.Key="Str_Tour_RegexTester_Pattern" ctl:Tour.Order="4"
                                    Grid.Column="1"
                                    AcceptsTab="False"
                                    FontFamily="Consolas"
                                    FontSize="14"
                                    Style="{StaticResource BareTextBox}"
                                    Tag="e.g. [a-zA-Z0-9._%+-]+@[a-zA-Z0-9.-]+\.[a-z]{2,}"
                                    TextChanged="PatternTextBox_TextChanged"
                                    ToolTip="{DynamicResource Str_Regex_PatternTooltip}" />
                                <TextBlock
                                    x:Name="TxtFlagLetters"
                                    Grid.Column="2"
                                    Margin="6,0,6,0"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource AccentColor}"
                                    ToolTip="{DynamicResource Str_RegexTester_FlagsThatAreOn}" />
                                <Button
                                    x:Name="BtnCopyPattern"
                                    Grid.Column="3"
                                    Margin="3,3,3,3"
                                    Click="BtnCopyPattern_Click"
                                    ToolTip="{DynamicResource Str_RegexTester_CopyThePattern}"
                                    Style="{StaticResource ListToolButtonStyle}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="ContentCopy" />
                                </Button>
                            </Grid>
                        </Border>

                        <!--  Error: what's wrong and where  -->
                        <Border
                            x:Name="PatternErrorBanner"
                            Margin="0,8,0,0"
                            Padding="10,8"
                            Background="{DynamicResource StatusErrorBg}"
                            CornerRadius="8"
                            Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    Margin="0,1,8,0"
                                    VerticalAlignment="Top"
                                    Foreground="{DynamicResource StatusErrorFg}"
                                    Kind="AlertCircleOutline" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock
                                        x:Name="TxtPatternError"
                                        FontSize="11.5"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource StatusErrorFg}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="TxtPatternErrorPointer"
                                        Margin="0,4,0,0"
                                        FontFamily="Consolas"
                                        FontSize="12"
                                        Foreground="{DynamicResource StatusErrorFg}"
                                        Visibility="Collapsed" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <!--  Replace preview  -->
                        <Border Margin="0,8,0,0" Style="{StaticResource InputBarStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    Margin="6,0,0,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource AccentColor}"
                                    Kind="FindReplace" />
                                <TextBox
                                    x:Name="TxtReplacement"
                                    Grid.Column="1"
                                    Margin="6,0,0,0"
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    Style="{StaticResource BareTextBox}"
                                    Tag="Replace with… (optional - $1 or ${name} puts a group back)"
                                    TextChanged="TxtReplacement_TextChanged"
                                    ToolTip="{DynamicResource Str_RegexTester_ShowsWhatTheText}" />
                            </Grid>
                        </Border>
                    </StackPanel>
                </Border>

                <!--  ================= TEXT / FILE MODE =================  -->
                <Grid x:Name="TextFilePanel" Grid.Row="2">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="1*" MinHeight="140" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="1.25*" MinHeight="200" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="1*" MinHeight="170" />
                    </Grid.RowDefinitions>

                    <!--  Test text  -->
                    <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentControl
                                    VerticalAlignment="Center"
                                    Content="{DynamicResource Str_Regex_TestText}"
                                    Style="{StaticResource CardHeader}"
                                    Tag="{x:Static materialDesign:PackIconKind.TextBoxEditOutline}" />
                                <TextBlock
                                    x:Name="TxtInputInfo"
                                    Grid.Column="1"
                                    Margin="12,0,0,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{DynamicResource TextSecondary}"
                                    TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <TextBox
                                x:Name="TxtInput"
                                Grid.Row="1"
                                Style="{StaticResource CodeTextBox}"
                                Tag="Paste or type text to test your pattern against... (or drop a file here)"
                                TextChanged="TxtInput_TextChanged"
                                ToolTip="{DynamicResource Str_Regex_TestTextTooltip}" />
                        </Grid>
                    </Border>

                    <!--  Highlighted matches + breakdown  -->
                    <Grid Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentControl
                                        VerticalAlignment="Center"
                                        Content="{DynamicResource Str_Regex_HighlightedMatches}"
                                        Style="{StaticResource CardHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.Marker}" />
                                    <StackPanel
                                        x:Name="PanelOutputView"
                                        Grid.Column="2"
                                        Orientation="Horizontal"
                                        Visibility="Collapsed">
                                        <RadioButton
                                            x:Name="RadioViewMatches"
                                            Margin="0,0,4,0"
                                            Click="OutputView_Click"
                                            GroupName="RegexOutput"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            ToolTip="{DynamicResource Str_RegexTester_TheTextWithEach}">
                                            <Grid HorizontalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon
                                                    Grid.Column="0"
                                                    Width="14"
                                                    Height="14"
                                                    Margin="0,0,5,0"
                                                    VerticalAlignment="Center"
                                                    Kind="Marker" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_FileDiff_TabMatches}" TextWrapping="Wrap" />
                                            </Grid>
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="RadioViewReplaced"
                                            Click="OutputView_Click"
                                            GroupName="RegexOutput"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            ToolTip="{DynamicResource Str_RegexTester_TheTextAfterReplacing}">
                                            <Grid HorizontalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon
                                                    Grid.Column="0"
                                                    Width="14"
                                                    Height="14"
                                                    Margin="0,0,5,0"
                                                    VerticalAlignment="Center"
                                                    Kind="FindReplace" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_RegexTester_Replaced}" TextWrapping="Wrap" />
                                            </Grid>
                                        </RadioButton>
                                        <Button
                                            x:Name="BtnCopyReplaced"
                                            Margin="4,0,0,0"
                                            Click="BtnCopyReplaced_Click"
                                            ToolTip="{DynamicResource Str_RegexTester_CopyTheReplacedText}"
                                            Style="{StaticResource ListToolButtonStyle}">
                                            <materialDesign:PackIcon
                                                Width="16"
                                                Height="16"
                                                Kind="ContentCopy" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <RichTextBox
                                    x:Name="RichTextOutput"
                                    ctl:Tour.Key="Str_Tour_RegexTester_Matches" ctl:Tour.Order="6"
                                    Grid.Row="1"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    FontFamily="Consolas"
                                    FontSize="13"
                                    Foreground="{DynamicResource TextPrimary}"
                                    HorizontalScrollBarVisibility="Disabled"
                                    IsDocumentEnabled="True"
                                    IsReadOnly="True"
                                    ToolTip="{DynamicResource Str_Regex_HighlightedMatchesTooltip}"
                                    VerticalScrollBarVisibility="Auto" />
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <StackPanel Margin="0,0,0,8">
                                    <ContentControl
                                        Content="{DynamicResource Str_Regex_PatternBreakdown}"
                                        Style="{StaticResource CardHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.FileTreeOutline}" />
                                    <TextBlock
                                        Margin="0,4,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Text="{DynamicResource Str_Regex_PatternBreakdownHint}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                                <Grid Grid.Row="1">
                                    <DataGrid
                                        x:Name="DataGridBreakdown"
                                        AutoGenerateColumns="False"
                                        CanUserAddRows="False"
                                        CanUserReorderColumns="False"
                                        CanUserSortColumns="False"
                                        HeadersVisibility="Column"
                                        HorizontalScrollBarVisibility="Disabled"
                                        IsReadOnly="True"
                                        MinRowHeight="34"
                                        SelectionChanged="DataGridBreakdown_SelectionChanged"
                                        SelectionMode="Single"
                                        ToolTip="{DynamicResource Str_Regex_BreakdownGridTooltip}"
                                        VirtualizingPanel.IsVirtualizing="True"
                                        VirtualizingPanel.ScrollUnit="Pixel">
                                        <DataGrid.Columns>
                                            <DataGridTemplateColumn
                                                Width="Auto"
                                                MinWidth="80"
                                                CellTemplate="{StaticResource BreakdownTokenTemplate}"
                                                Header="{DynamicResource Str_Regex_ColHeaderPart}" />
                                            <DataGridTextColumn
                                                Width="*"
                                                Binding="{Binding Meaning, Mode=OneWay}"
                                                FontSize="11.5"
                                                Header="{DynamicResource Str_Regex_ColHeaderMeaning}">
                                                <DataGridTextColumn.ElementStyle>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="TextWrapping" Value="Wrap" />
                                                        <Setter Property="VerticalAlignment" Value="Center" />
                                                        <Setter Property="Margin" Value="0,5" />
                                                    </Style>
                                                </DataGridTextColumn.ElementStyle>
                                            </DataGridTextColumn>
                                        </DataGrid.Columns>
                                    </DataGrid>

                                    <StackPanel
                                        x:Name="BreakdownEmptyStatePanel"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center">
                                        <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.FileTreeOutline}" />
                                        <TextBlock
                                            MaxWidth="260"
                                            Margin="0,10,0,0"
                                            HorizontalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextSecondary}"
                                            Text="{DynamicResource Str_Regex_BreakdownEmptyHint}"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>
                    </Grid>

                    <!--  Groups  -->
                    <Border Grid.Row="4" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <ContentControl
                                    VerticalAlignment="Center"
                                    Content="{DynamicResource Str_Regex_MatchGroups}"
                                    Style="{StaticResource CardHeader}"
                                    Tag="{x:Static materialDesign:PackIconKind.TableEye}" />
                                <TextBlock
                                    Grid.Column="1"
                                    Margin="12,0,0,0"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{DynamicResource Str_RegexTester_ClickARowTo}" />
                            </Grid>
                            <DataGrid
                                x:Name="DataGridGroupsSingle"
                                Grid.Row="1"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                CanUserReorderColumns="False"
                                ClipboardCopyMode="ExcludeHeader"
                                FontSize="12"
                                IsReadOnly="True"
                                MinRowHeight="32"
                                SelectionChanged="DataGridGroupsSingle_SelectionChanged"
                                SelectionMode="Single"
                                ToolTip="{DynamicResource Str_Regex_MatchGroupsTooltip}"
                                VirtualizingPanel.IsVirtualizing="True"
                                VirtualizingPanel.ScrollUnit="Pixel">
                                <DataGrid.Columns>
                                    <DataGridTextColumn
                                        Width="52"
                                        Binding="{Binding MatchNumber, Mode=OneWay}"
                                        ElementStyle="{StaticResource MutedCellText}"
                                        Header="#" />
                                    <DataGridTemplateColumn
                                        Width="110"
                                        CellTemplate="{StaticResource GroupNameTemplate}"
                                        Header="{DynamicResource Str_Regex_ColHeaderGroupNum}"
                                        SortMemberPath="GroupNumber" />
                                    <DataGridTextColumn
                                        Width="*"
                                        Binding="{Binding GroupValue, Mode=OneWay}"
                                        ElementStyle="{StaticResource MonoCellText}"
                                        Header="{DynamicResource Str_Regex_ColHeaderGroupValue}" />
                                    <DataGridTextColumn
                                        Width="80"
                                        Binding="{Binding LineColumn, Mode=OneWay}"
                                        ElementStyle="{StaticResource MutedCellText}"
                                        Header="{DynamicResource Str_RegexTester_LineCol}"
                                        SortMemberPath="Position" />
                                    <DataGridTextColumn
                                        Width="80"
                                        Binding="{Binding Position, Mode=OneWay}"
                                        ElementStyle="{StaticResource MutedCellText}"
                                        Header="{DynamicResource Str_Regex_ColHeaderPosition}" />
                                    <DataGridTextColumn
                                        Width="64"
                                        Binding="{Binding Length, Mode=OneWay}"
                                        ElementStyle="{StaticResource MutedCellText}"
                                        Header="{DynamicResource Str_Password_LengthHeader}" />
                                </DataGrid.Columns>
                            </DataGrid>
                            <StackPanel
                                x:Name="GroupsEmptyStatePanel"
                                Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <TextBlock
                                    x:Name="TxtGroupsEmpty"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{DynamicResource Str_RegexTester_MatchesAndTheirGroups}" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>

                <!--  ================= FOLDER MODE =================  -->
                <Border
                    x:Name="FolderPanel"
                    Grid.Row="2"
                    Style="{StaticResource CardStyle}"
                    Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <ContentControl
                                VerticalAlignment="Center"
                                Content="{DynamicResource Str_Regex_MatchesAcrossFiles}"
                                Style="{StaticResource CardHeader}"
                                Tag="{x:Static materialDesign:PackIconKind.FolderSearchOutline}" />
                            <WrapPanel
                                x:Name="FolderPillsPanel"
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                HorizontalAlignment="Right"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                                <Border
                                    x:Name="SummaryPill"
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource StatusInfoBg}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    ToolTip="{DynamicResource Str_Regex_TotalMatchesTooltip}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource StatusInfoFg}"
                                            Kind="Regex" />
                                        <TextBlock
                                            x:Name="TxtSummaryCount"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource StatusInfoFg}"
                                            Text="{DynamicResource Str_Regex_ZeroMatches}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    x:Name="PillFiles"
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource StatusSuccessBg}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    ToolTip="{DynamicResource Str_RegexTester_FilesWithAtLeast}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource StatusSuccessFg}"
                                            Kind="FileCheckOutline" />
                                        <TextBlock
                                            x:Name="TxtFilesCount"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource StatusSuccessFg}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    x:Name="PillSkipped"
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource StatusWarningBg}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource StatusWarningFg}"
                                            Kind="FileHidden" />
                                        <TextBlock
                                            x:Name="TxtSkippedCount"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource StatusWarningFg}" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </Grid>

                        <DataGrid
                            x:Name="DataGridGroupsFolder"
                            Grid.Row="1"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            CanUserReorderColumns="False"
                            ClipboardCopyMode="ExcludeHeader"
                            FontSize="12"
                            IsReadOnly="True"
                            MinRowHeight="32"
                            SelectionMode="Extended"
                            ToolTip="{DynamicResource Str_Regex_FolderGridTooltip}"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.ScrollUnit="Pixel"
                            Visibility="Collapsed">
                            <DataGrid.Columns>
                                <DataGridTextColumn
                                    Width="1.3*"
                                    Binding="{Binding FileName, Mode=OneWay}"
                                    Header="{DynamicResource Str_Common_ColHeaderFileName}">
                                    <DataGridTextColumn.ElementStyle>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="VerticalAlignment" Value="Center" />
                                            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
                                            <Setter Property="ToolTip" Value="{Binding FullPath}" />
                                        </Style>
                                    </DataGridTextColumn.ElementStyle>
                                </DataGridTextColumn>
                                <DataGridTextColumn
                                    Width="80"
                                    Binding="{Binding LineColumn, Mode=OneWay}"
                                    ElementStyle="{StaticResource MutedCellText}"
                                    Header="{DynamicResource Str_RegexTester_LineCol}"
                                    SortMemberPath="Line" />
                                <DataGridTextColumn
                                    Width="52"
                                    Binding="{Binding MatchNumber, Mode=OneWay}"
                                    ElementStyle="{StaticResource MutedCellText}"
                                    Header="#" />
                                <DataGridTemplateColumn
                                    Width="110"
                                    CellTemplate="{StaticResource GroupNameTemplate}"
                                    Header="{DynamicResource Str_Regex_ColHeaderGroupNum}"
                                    SortMemberPath="GroupNumber" />
                                <DataGridTextColumn
                                    Width="2*"
                                    Binding="{Binding GroupValue, Mode=OneWay}"
                                    ElementStyle="{StaticResource MonoCellText}"
                                    Header="{DynamicResource Str_Regex_ColHeaderGroupValue}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel
                            x:Name="FolderEmptyStatePanel"
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <ContentControl
                                x:Name="FolderEmptyBadge"
                                Style="{StaticResource EmptyStateBadge}"
                                Tag="{x:Static materialDesign:PackIconKind.FolderSearchOutline}" />
                            <TextBlock
                                x:Name="TxtFolderEmptyTitle"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Center"
                                FontSize="15"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextPrimary}"
                                Text="{DynamicResource Str_RegexTester_SearchEveryFileIn}" />
                            <TextBlock
                                x:Name="TxtFolderEmptyHint"
                                MaxWidth="440"
                                Margin="0,4,0,14"
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="{DynamicResource Str_Regex_FolderEmptyHint}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                            <Button
                                x:Name="BtnEmptyChooseFolder"
                                HorizontalAlignment="Center"
                                Click="BtnChooseFolder_Click"
                                Style="{StaticResource PrimaryButtonStyle}">
                                <Grid HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon
                                        Grid.Column="0"
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Kind="FolderOpenOutline" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_Common_ChooseFolder}" TextWrapping="Wrap" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!--  Drop overlay: a file opens in File mode, a folder in Folder mode  -->
        <Border
            x:Name="DropOverlay"
            Margin="16,8,16,16"
            Panel.ZIndex="10"
            Style="{StaticResource DropZoneStyle}">
            <Grid>
                <Rectangle
                    RadiusX="14"
                    RadiusY="14"
                    Stroke="{DynamicResource AccentColor}"
                    StrokeDashArray="6 4"
                    StrokeThickness="2" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.TrayArrowDown}" />
                    <TextBlock
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        Text="{DynamicResource Str_RegexTester_DropToTestThe}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondary}"
                        Text="{DynamicResource Str_RegexTester_AFileOpensIn}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
