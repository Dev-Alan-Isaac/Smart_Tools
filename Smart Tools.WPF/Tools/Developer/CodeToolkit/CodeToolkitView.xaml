<UserControl
    x:Class="Smart_Tools.WPF.Views.CodeToolkitView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    x:Name="Root"
    AllowDrop="True"
    Loaded="Root_Loaded"
    PreviewDragEnter="Root_PreviewDragEnter"
    PreviewDragLeave="Root_PreviewDragLeave"
    PreviewDragOver="Root_PreviewDragOver"
    PreviewDrop="Root_PreviewDrop"
    PreviewKeyDown="Root_PreviewKeyDown">

    <!--
        Backend: Controllers/CodeToolkitManager.cs (+ CodeToolkitEngine.cs,
        CodeDiffEngine.cs) and Models/CodeToolkitModel.cs. Code-behind only
        wires controls. Look & feel: shared view kit (Themes/Controls.xaml)
        + UiMotion.cs.
    -->

    <UserControl.Resources>

        <!--  A file or folder on the Files card: click a file to open it in Input  -->
        <DataTemplate x:Key="SourceTemplate" DataType="{x:Type ctl:BatchSource}">
            <Border
                x:Name="Row"
                Padding="4,3"
                Background="Transparent"
                Cursor="Hand"
                CornerRadius="7"
                MouseLeftButtonUp="SourceRow_Click"
                Tag="{Binding}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Border
                        Width="26"
                        Height="26"
                        Margin="0,0,8,0"
                        Background="{DynamicResource AccentColorSubtle}"
                        CornerRadius="7">
                        <materialDesign:PackIcon
                            x:Name="SourceIcon"
                            Width="14"
                            Height="14"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource AccentColor}"
                            Kind="FileCodeOutline" />
                    </Border>
                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource SidebarText}"
                            Text="{Binding Name}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding FullPath}" />
                        <TextBlock
                            Margin="0,1,0,0"
                            FontSize="10.5"
                            Foreground="{DynamicResource SidebarTextMuted}"
                            Text="{Binding Subtitle}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <Button
                        Grid.Column="2"
                        Width="24"
                        Height="24"
                        Margin="6,0,0,0"
                        VerticalAlignment="Center"
                        Click="BtnRemoveSource_Click"
                        Style="{StaticResource IconButtonStyle}"
                        Tag="{Binding}"
                        ToolTip="{DynamicResource Str_LoudnessMeter_TakeThisOffThe}">
                        <materialDesign:PackIcon
                            Width="13"
                            Height="13"
                            Kind="Close" />
                    </Button>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                    <Setter TargetName="SourceIcon" Property="Kind" Value="Folder" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                    <Setter TargetName="Row" Property="Background" Value="{DynamicResource SidebarItemHoverBg}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  Small icon button in a card header toolbar  -->
        <Style
            x:Key="PaneToolButton"
            BasedOn="{StaticResource NeutralIconButtonStyle}"
            TargetType="Button">
            <Setter Property="Padding" Value="0" />
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="2,0,0,0" />
        </Style>

        <Style x:Key="PaneToolIcon" TargetType="materialDesign:PackIcon">
            <Setter Property="Width" Value="16" />
            <Setter Property="Height" Value="16" />
        </Style>

        <!--  Muted caption under an editor  -->
        <Style x:Key="PaneFooterText" TargetType="TextBlock">
            <Setter Property="Margin" Value="2,8,0,0" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>

        <!--  Invisible splitter with an accent hint on hover  -->
        <Style x:Key="PaneSplitter" TargetType="GridSplitter">
            <Setter Property="HorizontalAlignment" Value="Stretch" />
            <Setter Property="VerticalAlignment" Value="Stretch" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="ResizeBehavior" Value="PreviousAndNext" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="GridSplitter">
                        <Grid Background="Transparent">
                            <Border
                                x:Name="Grip"
                                Width="4"
                                Height="40"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Background="{DynamicResource CardBorder}"
                                CornerRadius="2"
                                Opacity="0" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="ResizeDirection" Value="Rows">
                                <Setter TargetName="Grip" Property="Width" Value="40" />
                                <Setter TargetName="Grip" Property="Height" Value="4" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Grip" Property="Opacity" Value="1" />
                                <Setter TargetName="Grip" Property="Background" Value="{DynamicResource AccentColor}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  One diff row: tinted by Kind from theme tokens, accent edge when selected  -->
        <Style x:Key="DiffRowStyle" TargetType="ListBoxItem">
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ListBoxItem">
                        <Border
                            x:Name="Bd"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="3,0,0,0">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding Kind}" Value="Added">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource StatusSuccessBg}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource StatusSuccessFg}" />
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Kind}" Value="Removed">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource StatusErrorBg}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource StatusErrorFg}" />
                            </DataTrigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="DiffRowTemplate">
            <Grid TextElement.FontFamily="Consolas" TextElement.FontSize="12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="46" />
                    <ColumnDefinition Width="20" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Padding="0,2,8,2"
                    Foreground="{DynamicResource TextSecondary}"
                    Opacity="0.8"
                    Text="{Binding OldNumberText}"
                    TextAlignment="Right" />
                <TextBlock
                    Grid.Column="1"
                    Padding="0,2,8,2"
                    Foreground="{DynamicResource TextSecondary}"
                    Opacity="0.8"
                    Text="{Binding NewNumberText}"
                    TextAlignment="Right" />
                <TextBlock
                    x:Name="SignText"
                    Grid.Column="2"
                    Padding="0,2"
                    FontWeight="Bold"
                    Text="{Binding Sign}" />
                <TextBlock
                    Grid.Column="3"
                    Padding="0,2,12,2"
                    Foreground="{DynamicResource TextPrimary}"
                    Text="{Binding Text}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Added">
                    <Setter TargetName="SignText" Property="Foreground" Value="{DynamicResource StatusSuccessFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Removed">
                    <Setter TargetName="SignText" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">

        <!--  No page header: MainWindow's header card shows the tool's icon and name.  -->

        <Grid Margin="16,8,16,16">

            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OptionsColumn" Width="280" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= OPTIONS SIDEBAR =================  -->

            <Border Grid.Column="0" Style="{StaticResource SidebarPanelStyle}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Button
                            x:Name="BtnCollapseOptions"
                            MinHeight="45"
                            HorizontalContentAlignment="Left"
                            Click="BtnCollapseOptions_Click"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Foreground="{DynamicResource SidebarText}"
                            ToolTip="{DynamicResource Str_Common_SidebarToggleTooltip}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="OverridesDefaultStyle" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Margin="16,0,0,0" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Kind="TuneVariant" />
                                <TextBlock
                                    x:Name="TxtOptionsHeaderLabel"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{DynamicResource Str_Common_OptionsLabel}" />
                            </StackPanel>
                        </Button>

                        <Separator
                            x:Name="SepHeader"
                            Margin="16,4"
                            Style="{StaticResource SidebarSeparatorStyle}" />
                    </StackPanel>

                    <ScrollViewer
                        x:Name="OptionsScrollViewer"
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto">

                        <StackPanel Margin="16,4,16,16">

                            <!--  ============ FILES (Minify and Beautify: open one, or run on many) ============  -->
                            <StackPanel x:Name="PanelFiles">
                                <controls:InputFolderCard
                                    x:Name="InputCard"
                                    ctl:Tour.Key="Str_Tour_CodeToolkit_Files"
                                    ctl:Tour.Order="0"
                                    ClearRequested="InputCard_ClearRequested"
                                    Header="{DynamicResource Str_CodeToolkit_FilesHeader}"
                                    HeaderIcon="FileMultipleOutline"
                                    IncludeSubfoldersChanged="InputCard_IncludeSubfoldersChanged"
                                    ItemTemplate="{StaticResource SourceTemplate}"
                                    Mode="Files"
                                    PathsAdded="InputCard_PathsAdded" />

                                <StackPanel x:Name="PanelBatch" Visibility="Collapsed">
                                    <Border Margin="0,0,0,10" Style="{StaticResource SidebarGroupCardStyle}">
                                        <StackPanel>
                                            <Button
                                                x:Name="BtnRunAll"
                                                MinHeight="38"
                                                Click="BtnRunAll_Click"
                                                Style="{StaticResource AccentPrimaryButtonStyle}"
                                                ToolTip="{DynamicResource Str_CodeToolkit_RunAllTip}">
                                                <StackPanel Orientation="Horizontal">
                                                    <materialDesign:PackIcon
                                                        x:Name="IconRunAll"
                                                        Width="16"
                                                        Height="16"
                                                        Margin="0,0,6,0"
                                                        VerticalAlignment="Center"
                                                        Kind="PlaylistPlay" />
                                                    <TextBlock
                                                        x:Name="TxtRunAll"
                                                        VerticalAlignment="Center"
                                                        Text="{DynamicResource Str_CodeToolkit_RunAll}" />
                                                </StackPanel>
                                            </Button>
                                            <TextBlock Style="{StaticResource SidebarHint}" Text="{DynamicResource Str_CodeToolkit_RunAllHint}" />
                                        </StackPanel>
                                    </Border>
                                    <controls:OutputFolderCard
                                        x:Name="OutputCard"
                                        Header="{DynamicResource Str_CodeToolkit_SaveFilesTo}"
                                        HeaderIcon="FolderOutline"
                                        ToolName="Code Toolkit" />
                                </StackPanel>
                            </StackPanel>

                            <!--  ============ TOOL ============  -->
                            <Border ctl:Tour.Key="Str_Tour_CodeToolkit_Tool" ctl:Tour.Order="1" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_CodeToolkit_Tool}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.CodeBraces}" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <RadioButton
                                            x:Name="ModeMinify"
                                            Grid.Column="0"
                                            Checked="Mode_Checked"
                                            GroupName="ToolMode"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            ToolTip="{DynamicResource Str_Code_ModeMinifyTooltip}">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="17"
                                                    Height="17"
                                                    HorizontalAlignment="Center"
                                                    Kind="ArrowCollapseHorizontal" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    HorizontalAlignment="Center"
                                                    Text="{DynamicResource Str_Code_ModeMinify}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="ModeBeautify"
                                            Grid.Column="2"
                                            Checked="Mode_Checked"
                                            GroupName="ToolMode"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            ToolTip="{DynamicResource Str_Code_ModeBeautifyTooltip}">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="17"
                                                    Height="17"
                                                    HorizontalAlignment="Center"
                                                    Kind="AutoFix" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    HorizontalAlignment="Center"
                                                    Text="{DynamicResource Str_Code_ModeBeautify}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="ModeDiff"
                                            Grid.Column="4"
                                            Checked="Mode_Checked"
                                            GroupName="ToolMode"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            ToolTip="{DynamicResource Str_Code_ModeCompareTooltip}">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="17"
                                                    Height="17"
                                                    HorizontalAlignment="Center"
                                                    Kind="CompareHorizontal" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    HorizontalAlignment="Center"
                                                    Text="{DynamicResource Str_Code_ModeCompare}" />
                                            </StackPanel>
                                        </RadioButton>
                                    </Grid>

                                    <TextBlock
                                        x:Name="TxtModeHint"
                                        Margin="0,8,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource SidebarTextMuted}"
                                        Text="{DynamicResource Str_CodeToolkit_ShrinkCodeByRemoving}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!--  ============ LANGUAGE (Minify / Beautify) ============  -->
                            <Border x:Name="LanguageSection" ctl:Tour.Key="Str_Tour_CodeToolkit_Language" ctl:Tour.Order="2" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Settings_Language}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.CodeTags}" />

                                    <Grid ToolTip="{DynamicResource Str_Code_LanguageTooltip}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="4" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <RadioButton
                                            x:Name="LangCss"
                                            Grid.Row="0"
                                            Grid.Column="0"
                                            Checked="Language_Checked"
                                            GroupName="CodeLanguage"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="Css">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="17"
                                                    Height="17"
                                                    HorizontalAlignment="Center"
                                                    Kind="LanguageCss3" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    HorizontalAlignment="Center"
                                                    Text="{DynamicResource Str_CodeToolkit_Css}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="LangJs"
                                            Grid.Row="0"
                                            Grid.Column="2"
                                            Checked="Language_Checked"
                                            GroupName="CodeLanguage"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="Js">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="17"
                                                    Height="17"
                                                    HorizontalAlignment="Center"
                                                    Kind="LanguageJavascript" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    HorizontalAlignment="Center"
                                                    Text="{DynamicResource Str_CodeToolkit_Javascript}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="LangHtml"
                                            Grid.Row="2"
                                            Grid.Column="0"
                                            Checked="Language_Checked"
                                            GroupName="CodeLanguage"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="Html">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="17"
                                                    Height="17"
                                                    HorizontalAlignment="Center"
                                                    Kind="LanguageHtml5" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    HorizontalAlignment="Center"
                                                    Text="{DynamicResource Str_CodeToolkit_Html}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="LangJson"
                                            Grid.Row="2"
                                            Grid.Column="2"
                                            Checked="Language_Checked"
                                            GroupName="CodeLanguage"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="Json">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="17"
                                                    Height="17"
                                                    HorizontalAlignment="Center"
                                                    Kind="CodeJson" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    HorizontalAlignment="Center"
                                                    Text="{DynamicResource Str_ApiTester_Json}" />
                                            </StackPanel>
                                        </RadioButton>
                                    </Grid>

                                    <StackPanel
                                        x:Name="LanguageHintPanel"
                                        Margin="0,8,0,0"
                                        Orientation="Horizontal"
                                        Visibility="Collapsed">
                                        <materialDesign:PackIcon
                                            Width="12"
                                            Height="12"
                                            Margin="0,0,4,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource AccentColor}"
                                            Kind="LightningBoltOutline" />
                                        <TextBlock
                                            x:Name="TxtLanguageHint"
                                            FontSize="11"
                                            Foreground="{DynamicResource SidebarTextMuted}"
                                            Text="{DynamicResource Str_CodeToolkit_DetectedFromContent}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!--  ============ INDENTATION (Beautify) ============  -->
                            <Border
                                x:Name="BeautifyOptionsSection"
                                Style="{StaticResource SidebarGroupCardStyle}"
                                Visibility="Collapsed">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_CodeToolkit_Indentation}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.FormatIndentIncrease}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <RadioButton
                                            x:Name="Indent2"
                                            Grid.Column="0"
                                            Checked="Indent_Checked"
                                            Content="{DynamicResource Str_CodeToolkit_2Spaces}"
                                            GroupName="CodeIndent"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="TwoSpaces" />
                                        <RadioButton
                                            x:Name="Indent4"
                                            Grid.Column="2"
                                            Checked="Indent_Checked"
                                            Content="{DynamicResource Str_CodeToolkit_4Spaces}"
                                            GroupName="CodeIndent"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="FourSpaces" />
                                        <RadioButton
                                            x:Name="IndentTab"
                                            Grid.Column="4"
                                            Checked="Indent_Checked"
                                            Content="{DynamicResource Str_CodeToolkit_Tab}"
                                            GroupName="CodeIndent"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="Tab" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!--  ============ WHAT MINIFY DOES (Minify) ============  -->
                            <Border
                                x:Name="MinifyInfoSection"
                                Margin="0,0,0,12"
                                Padding="10,8"
                                Background="{DynamicResource StatusInfoBg}"
                                CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon
                                        Width="14"
                                        Height="14"
                                        Margin="0,1,7,0"
                                        VerticalAlignment="Top"
                                        Foreground="{DynamicResource StatusInfoFg}"
                                        Kind="InformationOutline" />
                                    <TextBlock
                                        x:Name="TxtMinifyNote"
                                        Grid.Column="1"
                                        FontSize="11"
                                        Foreground="{DynamicResource StatusInfoFg}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </Border>

                            <!--  ============ COMPARE OPTIONS (Diff) ============  -->
                            <Border
                                x:Name="DiffOptionsSection"
                                Style="{StaticResource SidebarGroupCardStyle}"
                                Visibility="Collapsed">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Code_ModeCompare}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.SelectCompare}" />
                                    <CheckBox
                                        x:Name="ChkIgnoreWhitespace"
                                        Margin="0,0,0,6"
                                        Checked="DiffOption_Changed"
                                        Content="{DynamicResource Str_CodeToolkit_IgnoreWhitespaceChanges}"
                                        Foreground="{DynamicResource SidebarText}"
                                        ToolTip="{DynamicResource Str_CodeToolkit_IndentationAndRunsOf}"
                                        Unchecked="DiffOption_Changed" />
                                    <CheckBox
                                        x:Name="ChkIgnoreCase"
                                        Checked="DiffOption_Changed"
                                        Content="{DynamicResource Str_Regex_IgnoreCase}"
                                        Foreground="{DynamicResource SidebarText}"
                                        ToolTip="{DynamicResource Str_CodeToolkit_ColorAndColorCount}"
                                        Unchecked="DiffOption_Changed" />
                                </StackPanel>
                            </Border>

                            <!--  ============ BEHAVIOUR ============  -->
                            <Border Margin="0,0,0,4" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_CodeToolkit_Behaviour}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.LightningBoltOutline}" />
                                    <CheckBox
                                        x:Name="ChkLiveUpdate"
                                        Checked="LiveUpdate_Changed"
                                        Content="{DynamicResource Str_CodeToolkit_UpdateAsYouType}"
                                        Foreground="{DynamicResource SidebarText}"
                                        IsChecked="True"
                                        ToolTip="{DynamicResource Str_CodeToolkit_ReRunAutomaticallyA}"
                                        Unchecked="LiveUpdate_Changed" />
                                    <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="12"
                                            Height="12"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource SidebarTextMuted}"
                                            Kind="KeyboardReturn" />
                                        <TextBlock
                                            FontSize="11"
                                            Foreground="{DynamicResource SidebarTextMuted}"
                                            Text="{DynamicResource Str_CodeToolkit_CtrlEnterRunsCtrl}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--  ================= MAIN AREA =================  -->

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Run bar: hero action + live status + result chips  -->
                <Border
                    Grid.Row="0"
                    Margin="0,0,0,12"
                    Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button
                            x:Name="BtnRun"
                            ctl:Tour.Key="Str_Tour_CodeToolkit_Run" ctl:Tour.Order="4"
                            Grid.Column="0"
                            MinWidth="150"
                            Margin="0,0,14,0"
                            VerticalAlignment="Center"
                            Click="BtnRun_Click"
                            Style="{StaticResource AccentPrimaryButtonStyle}"
                            ToolTip="{DynamicResource Str_Code_RunTooltip}">
                            <Grid HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon
                                    Grid.Column="0"
                                    x:Name="IconRun"
                                    Width="18"
                                    Height="18"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Kind="ArrowCollapseHorizontal" />
                                <TextBlock
                                    Grid.Column="1"
                                    x:Name="TxtRunLabel"
                                    VerticalAlignment="Center"
                                    Text="{DynamicResource Str_Code_ModeMinify}" TextWrapping="Wrap" />
                            </Grid>
                        </Button>

                        <Border
                            x:Name="BorderStatus"
                            Grid.Column="1"
                            HorizontalAlignment="Left"
                            VerticalAlignment="Center"
                            Background="{DynamicResource RowBg}"
                            Style="{StaticResource IconStatusPillStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    x:Name="IconStatus"
                                    Width="13"
                                    Height="13"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Foreground="{Binding Foreground, ElementName=TxtStats}"
                                    Kind="InformationOutline" />
                                <TextBlock
                                    x:Name="TxtStats"
                                    FontSize="11.5"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{DynamicResource Str_CodeToolkit_PasteCodeDropA}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>

                        <StackPanel
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Border
                                x:Name="ChipSize"
                                Margin="6,0,0,0"
                                Background="{DynamicResource RowBg}"
                                Style="{StaticResource IconStatusPillStyle}"
                                ToolTip="{DynamicResource Str_CodeToolkit_SizeBeforeAfterUtf}"
                                Visibility="Collapsed">
                                <TextBlock
                                    x:Name="TxtSizeChip"
                                    FontSize="11.5"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimary}" />
                            </Border>
                            <Border
                                x:Name="ChipSaved"
                                Margin="6,0,0,0"
                                Background="{DynamicResource StatusSuccessBg}"
                                Style="{StaticResource IconStatusPillStyle}"
                                Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        x:Name="IconSaved"
                                        Width="13"
                                        Height="13"
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center"
                                        Foreground="{Binding Foreground, ElementName=TxtSavedChip}"
                                        Kind="ArrowCollapseHorizontal" />
                                    <TextBlock
                                        x:Name="TxtSavedChip"
                                        FontSize="11.5"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource StatusSuccessFg}" />
                                </StackPanel>
                            </Border>
                            <Border
                                x:Name="ChipAdded"
                                Margin="6,0,0,0"
                                Background="{DynamicResource StatusSuccessBg}"
                                Style="{StaticResource IconStatusPillStyle}"
                                ToolTip="{DynamicResource Str_CodeToolkit_LinesOnlyInModified}"
                                Visibility="Collapsed">
                                <TextBlock
                                    x:Name="TxtAddedChip"
                                    FontSize="11.5"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource StatusSuccessFg}" />
                            </Border>
                            <Border
                                x:Name="ChipRemoved"
                                Margin="6,0,0,0"
                                Background="{DynamicResource StatusErrorBg}"
                                Style="{StaticResource IconStatusPillStyle}"
                                ToolTip="{DynamicResource Str_CodeToolkit_LinesOnlyInOriginal}"
                                Visibility="Collapsed">
                                <TextBlock
                                    x:Name="TxtRemovedChip"
                                    FontSize="11.5"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource StatusErrorFg}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  Error banner: one-line summary, expandable detail, jump to the spot  -->
                <Border
                    x:Name="ErrorBanner"
                    Grid.Row="1"
                    Margin="0,0,0,12"
                    Padding="12,6"
                    Background="{DynamicResource StatusErrorBg}"
                    CornerRadius="8"
                    Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Expander
                            x:Name="ExpError"
                            VerticalAlignment="Center"
                            Background="Transparent"
                            BorderThickness="0"
                            Foreground="{DynamicResource StatusErrorFg}"
                            IsExpanded="False">
                            <Expander.Header>
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="15"
                                        Height="15"
                                        Margin="0,0,7,0"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource StatusErrorFg}"
                                        Kind="AlertCircleOutline" />
                                    <TextBlock
                                        x:Name="TxtErrorSummary"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource StatusErrorFg}"
                                        Text="{DynamicResource Str_Code_ErrorSummary}"
                                        TextTrimming="CharacterEllipsis"
                                        TextWrapping="NoWrap" />
                                </StackPanel>
                            </Expander.Header>
                            <TextBlock
                                x:Name="TxtError"
                                Margin="22,6,0,2"
                                FontSize="12"
                                Foreground="{DynamicResource StatusErrorFg}"
                                TextWrapping="Wrap" />
                        </Expander>
                        <Button
                            x:Name="BtnGoToError"
                            Grid.Column="1"
                            MinHeight="28"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Click="BtnGoToError_Click"
                            ToolTip="{DynamicResource Str_CodeToolkit_PutTheCursorOn}"
                            Visibility="Collapsed">
                            <Grid HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon
                                    Grid.Column="0"
                                    Width="14"
                                    Height="14"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Kind="SubdirectoryArrowLeft" />
                                <TextBlock Grid.Column="1" x:Name="TxtGoToError" VerticalAlignment="Center" Text="{DynamicResource Str_CodeToolkit_GoToLine}" TextWrapping="Wrap" />
                            </Grid>
                        </Button>
                    </Grid>
                </Border>

                <!--  ============ TRANSFORM (Minify / Beautify) ============  -->
                <Grid x:Name="PanelTransform" Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="220" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="*" MinWidth="220" />
                    </Grid.ColumnDefinitions>

                    <!--  Input  -->
                    <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentControl
                                    Content="{DynamicResource Str_Code_InputLabel}"
                                    Style="{StaticResource CardHeader}"
                                    Tag="{x:Static materialDesign:PackIconKind.FileCodeOutline}" />
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <Button
                                        x:Name="BtnLoadFile"
                                        Click="BtnLoadFile_Click"
                                        Style="{StaticResource PaneToolButton}"
                                        ToolTip="{DynamicResource Str_Code_LoadFileTooltip}">
                                        <materialDesign:PackIcon Kind="FolderOpenOutline" Style="{StaticResource PaneToolIcon}" />
                                    </Button>
                                    <Button
                                        x:Name="BtnPasteInput"
                                        Click="BtnPasteInput_Click"
                                        Style="{StaticResource PaneToolButton}"
                                        ToolTip="{DynamicResource Str_CodeToolkit_ReplaceInputWithThe}">
                                        <materialDesign:PackIcon Kind="ContentPaste" Style="{StaticResource PaneToolIcon}" />
                                    </Button>
                                    <Button
                                        x:Name="BtnClearInput"
                                        Click="BtnClearInput_Click"
                                        Style="{StaticResource PaneToolButton}"
                                        ToolTip="{DynamicResource Str_CodeToolkit_ClearInputAndOutput}">
                                        <materialDesign:PackIcon Kind="Eraser" Style="{StaticResource PaneToolIcon}" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <TextBox
                                x:Name="TxtInput"
                                ctl:Tour.Key="Str_Tour_CodeToolkit_Input" ctl:Tour.Order="3"
                                Grid.Row="1"
                                Style="{StaticResource CodeTextBoxNoWrap}"
                                TextChanged="TxtInput_TextChanged"
                                ToolTip="{DynamicResource Str_Code_InputTooltip}" />

                            <StackPanel
                                x:Name="InputEmptyPanel"
                                Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                                <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.FileCodeOutline}" />
                                <TextBlock
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimary}"
                                    Text="{DynamicResource Str_CodeToolkit_PasteOrDropYour}" />
                                <TextBlock
                                    Margin="0,4,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="11.5"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{DynamicResource Str_CodeToolkit_CssJavascriptHtmlOr}" />
                            </StackPanel>

                            <TextBlock
                                x:Name="TxtInputInfo"
                                Grid.Row="2"
                                Style="{StaticResource PaneFooterText}"
                                Text="{DynamicResource Str_CodeToolkit_Empty}" />
                        </Grid>
                    </Border>

                    <GridSplitter
                        Grid.Column="1"
                        Width="12"
                        ResizeDirection="Columns"
                        Style="{StaticResource PaneSplitter}" />

                    <!--  Output  -->
                    <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentControl
                                    Content="{DynamicResource Str_Code_OutputLabel}"
                                    Style="{StaticResource CardHeader}"
                                    Tag="{x:Static materialDesign:PackIconKind.FileCheckOutline}" />
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <Button
                                        x:Name="BtnUseOutput"
                                        Click="BtnUseOutput_Click"
                                        IsEnabled="False"
                                        Style="{StaticResource PaneToolButton}"
                                        ToolTip="{DynamicResource Str_CodeToolkit_UseTheOutputAs}">
                                        <materialDesign:PackIcon Kind="ArrowLeftBoldBoxOutline" Style="{StaticResource PaneToolIcon}" />
                                    </Button>
                                    <Button
                                        x:Name="BtnCopyOutput"
                                        Click="BtnCopyOutput_Click"
                                        IsEnabled="False"
                                        Style="{StaticResource PaneToolButton}"
                                        ToolTip="{DynamicResource Str_Code_CopyOutputTooltip}">
                                        <materialDesign:PackIcon Kind="ContentCopy" Style="{StaticResource PaneToolIcon}" />
                                    </Button>
                                    <Button
                                        x:Name="BtnSaveOutput"
                                        Click="BtnSaveOutput_Click"
                                        IsEnabled="False"
                                        Style="{StaticResource PaneToolButton}"
                                        ToolTip="{DynamicResource Str_Code_SaveOutputTooltip}">
                                        <materialDesign:PackIcon Kind="ContentSaveOutline" Style="{StaticResource PaneToolIcon}" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <TextBox
                                x:Name="TxtOutput"
                                ctl:Tour.Key="Str_Tour_CodeToolkit_Output" ctl:Tour.Order="5"
                                Grid.Row="1"
                                IsReadOnly="True"
                                Style="{StaticResource CodeTextBoxNoWrap}"
                                ToolTip="{DynamicResource Str_Code_OutputTooltip}" />

                            <StackPanel
                                x:Name="OutputEmptyPanel"
                                Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                                <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.AutoFix}" />
                                <TextBlock
                                    x:Name="TxtOutputEmpty"
                                    MaxWidth="260"
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{DynamicResource Str_CodeToolkit_TheResultAppearsHere}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>

                            <TextBlock
                                x:Name="TxtOutputInfo"
                                Grid.Row="2"
                                Style="{StaticResource PaneFooterText}"
                                Text=" " />
                        </Grid>
                    </Border>
                </Grid>

                <!--  ============ COMPARE ============  -->
                <Grid
                    x:Name="PanelDiff"
                    Grid.Row="2"
                    Visibility="Collapsed">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="2*" MinHeight="120" />
                        <RowDefinition Height="12" />
                        <RowDefinition Height="3*" MinHeight="140" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="200" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" MinWidth="200" />
                        </Grid.ColumnDefinitions>

                        <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentControl
                                        Content="{DynamicResource Str_Code_OriginalLabel}"
                                        Style="{StaticResource CardHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.FileDocumentMultipleOutline}" />
                                    <Button
                                        x:Name="BtnLoadOriginal"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Click="BtnLoadOriginal_Click"
                                        Style="{StaticResource PaneToolButton}"
                                        ToolTip="{DynamicResource Str_CodeToolkit_LoadAFileAs}">
                                        <materialDesign:PackIcon Kind="FolderOpenOutline" Style="{StaticResource PaneToolIcon}" />
                                    </Button>
                                </Grid>
                                <TextBox
                                    x:Name="TxtDiffOriginal"
                                    Grid.Row="1"
                                    Style="{StaticResource CodeTextBoxNoWrap}"
                                    TextChanged="TxtDiff_TextChanged"
                                    ToolTip="{DynamicResource Str_Code_OriginalTooltip}" />
                            </Grid>
                        </Border>

                        <GridSplitter
                            Grid.Column="1"
                            Width="12"
                            ResizeDirection="Columns"
                            Style="{StaticResource PaneSplitter}" />

                        <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentControl
                                        Content="{DynamicResource Str_Code_ModifiedLabel}"
                                        Style="{StaticResource CardHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.TextBoxEditOutline}" />
                                    <StackPanel
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <Button
                                            x:Name="BtnSwapDiff"
                                            Click="BtnSwapDiff_Click"
                                            Style="{StaticResource PaneToolButton}"
                                            ToolTip="{DynamicResource Str_CodeToolkit_SwapOriginalAndModified}">
                                            <materialDesign:PackIcon Kind="SwapHorizontal" Style="{StaticResource PaneToolIcon}" />
                                        </Button>
                                        <Button
                                            x:Name="BtnLoadModified"
                                            Click="BtnLoadModified_Click"
                                            Style="{StaticResource PaneToolButton}"
                                            ToolTip="{DynamicResource Str_CodeToolkit_LoadAFileAs2}">
                                            <materialDesign:PackIcon Kind="FolderOpenOutline" Style="{StaticResource PaneToolIcon}" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                                <TextBox
                                    x:Name="TxtDiffModified"
                                    Grid.Row="1"
                                    Style="{StaticResource CodeTextBoxNoWrap}"
                                    TextChanged="TxtDiff_TextChanged"
                                    ToolTip="{DynamicResource Str_Code_ModifiedTooltip}" />
                            </Grid>
                        </Border>
                    </Grid>

                    <GridSplitter
                        Grid.Row="1"
                        Height="12"
                        ResizeDirection="Rows"
                        Style="{StaticResource PaneSplitter}" />

                    <!--  Differences  -->
                    <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentControl
                                    Content="{DynamicResource Str_Code_DifferencesLabel}"
                                    Style="{StaticResource CardHeader}"
                                    Tag="{x:Static materialDesign:PackIconKind.CompareHorizontal}" />
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <TextBlock
                                        x:Name="TxtChangePosition"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        FontSize="11.5"
                                        Foreground="{DynamicResource TextSecondary}" />
                                    <Button
                                        x:Name="BtnPrevChange"
                                        Click="BtnPrevChange_Click"
                                        IsEnabled="False"
                                        Style="{StaticResource PaneToolButton}"
                                        ToolTip="{DynamicResource Str_CodeToolkit_PreviousChangeShiftF8}">
                                        <materialDesign:PackIcon Kind="ChevronUp" Style="{StaticResource PaneToolIcon}" />
                                    </Button>
                                    <Button
                                        x:Name="BtnNextChange"
                                        Click="BtnNextChange_Click"
                                        IsEnabled="False"
                                        Style="{StaticResource PaneToolButton}"
                                        ToolTip="{DynamicResource Str_CodeToolkit_NextChangeF8}">
                                        <materialDesign:PackIcon Kind="ChevronDown" Style="{StaticResource PaneToolIcon}" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <Border
                                Grid.Row="1"
                                Background="{DynamicResource InputBg}"
                                BorderBrush="{DynamicResource InputBorder}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <ListBox
                                    x:Name="DiffList"
                                    Margin="1"
                                    Background="Transparent"
                                    BorderThickness="0"
                                    ItemContainerStyle="{StaticResource DiffRowStyle}"
                                    ItemTemplate="{StaticResource DiffRowTemplate}"
                                    ScrollViewer.HorizontalScrollBarVisibility="Auto"
                                    ToolTip="{DynamicResource Str_Code_DiffResultTooltip}"
                                    VirtualizingPanel.IsVirtualizing="True"
                                    VirtualizingPanel.VirtualizationMode="Recycling" />
                            </Border>

                            <StackPanel
                                x:Name="DiffEmptyPanel"
                                Grid.Row="1"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                IsHitTestVisible="False">
                                <ContentControl
                                    x:Name="DiffEmptyBadge"
                                    Style="{StaticResource EmptyStateBadge}"
                                    Tag="{x:Static materialDesign:PackIconKind.CompareHorizontal}" />
                                <TextBlock
                                    x:Name="TxtDiffEmpty"
                                    MaxWidth="360"
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="12.5"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{DynamicResource Str_CodeToolkit_PasteTheOriginalOn}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Grid>
        </Grid>

        <!--  ================= DROP OVERLAY =================  -->
        <Border
            x:Name="DropOverlay"
            Margin="16,8,16,16"
            Panel.ZIndex="10"
            Style="{StaticResource DropZoneStyle}">
            <Grid>
                <Rectangle
                    RadiusX="14"
                    RadiusY="14"
                    Stroke="{DynamicResource AccentColor}"
                    StrokeDashArray="6 4"
                    StrokeThickness="2" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.TrayArrowDown}" />
                    <TextBlock
                        x:Name="TxtDropTitle"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        Text="{DynamicResource Str_CodeToolkit_DropAFileTo}" />
                    <TextBlock
                        x:Name="TxtDropHint"
                        Margin="0,4,0,0"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondary}"
                        Text="{DynamicResource Str_CodeToolkit_TheLanguageIsPicked}" />
                </StackPanel>
            </Grid>
        </Border>

    </Grid>

</UserControl>
