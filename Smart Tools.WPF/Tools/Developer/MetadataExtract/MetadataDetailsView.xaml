<UserControl
    x:Class="Smart_Tools.WPF.Views.MetadataDetailsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:models="clr-namespace:Smart_Tools.WPF.Models"
    x:Name="Root"
    Focusable="True"
    PreviewKeyDown="Root_PreviewKeyDown"
    Unloaded="Root_Unloaded">

    <!--
        The Metadata Extractor's details window (shown by AppModal.Present from MetadataExtractView):
        the file's picture on the left, everything found in it on the right as one card per group,
        and previous / next buttons that walk the list the way Find Similar's compare does.
        UI only; the rule for "which file next" is Controllers/MetadataDetailsNavigation.cs.
    -->

    <UserControl.Resources>

        <!--  One icon per kind of group  -->
        <Style x:Key="DetailsGroupIconStyle" TargetType="materialDesign:PackIcon">
            <Setter Property="Width" Value="18" />
            <Setter Property="Height" Value="18" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="Foreground" Value="{DynamicResource AccentColor}" />
            <Setter Property="Kind" Value="InformationOutline" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding Name}" Value="Video">
                    <Setter Property="Kind" Value="FilmstripBox" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Name}" Value="Audio">
                    <Setter Property="Kind" Value="MusicNote" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Name}" Value="Image">
                    <Setter Property="Kind" Value="ImageOutline" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Name}" Value="Camera">
                    <Setter Property="Kind" Value="CameraOutline" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Name}" Value="Location">
                    <Setter Property="Kind" Value="MapMarkerRadiusOutline" />
                    <Setter Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Name}" Value="Tags">
                    <Setter Property="Kind" Value="TagOutline" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Name}" Value="EXIF">
                    <Setter Property="Kind" Value="CodeBraces" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  The head of one group card  -->
        <DataTemplate x:Key="CardHeaderTemplate">
            <StackPanel Orientation="Horizontal">
                <materialDesign:PackIcon Margin="0,0,10,0" Style="{StaticResource DetailsGroupIconStyle}" />
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="14"
                    FontWeight="Bold"
                    Foreground="{DynamicResource TextPrimary}"
                    Text="{Binding Name}" />
                <TextBlock
                    Margin="10,0,0,0"
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource TextSecondary}"
                    Text="{Binding ItemCount}" />
            </StackPanel>
        </DataTemplate>

        <!--  One field: a label over its value; a click copies the value  -->
        <DataTemplate x:Key="TileTemplate" DataType="{x:Type models:MetadataField}">
            <Border
                Margin="0,0,10,10"
                Padding="14,10"
                BorderThickness="1"
                CornerRadius="10"
                Cursor="Hand"
                MouseLeftButtonUp="Tile_MouseLeftButtonUp">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Background" Value="{DynamicResource RowBg}" />
                        <Setter Property="BorderBrush" Value="Transparent" />
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <Border.ToolTip>
                    <StackPanel MaxWidth="420">
                        <TextBlock Text="{Binding Value}" TextWrapping="Wrap" />
                        <TextBlock
                            Margin="0,6,0,0"
                            FontSize="11"
                            Opacity="0.7"
                            Text="{DynamicResource Str_MetadataExtract_ClickToCopy}" />
                    </StackPanel>
                </Border.ToolTip>
                <StackPanel>
                    <TextBlock
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextSecondary}"
                        Text="{Binding Property}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        MaxHeight="58"
                        Margin="0,4,0,0"
                        FontSize="13"
                        Foreground="{DynamicResource TextPrimary}"
                        Text="{Binding Value}"
                        TextTrimming="CharacterEllipsis"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Border>
        </DataTemplate>
    </UserControl.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  ============ Header: the file, previous / next, close ============  -->
        <Grid Margin="0,0,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Border
                Width="42"
                Height="42"
                Margin="0,0,12,0"
                VerticalAlignment="Center"
                Background="{DynamicResource AccentFill}"
                CornerRadius="11">
                <materialDesign:PackIcon
                    x:Name="KindIcon"
                    Width="22"
                    Height="22"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="White"
                    Kind="TagMultiple" />
            </Border>

            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                <TextBlock
                    x:Name="TxtName"
                    FontSize="17"
                    FontWeight="Bold"
                    Foreground="{DynamicResource TextPrimary}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                <TextBlock
                    x:Name="TxtSub"
                    Margin="0,3,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextSecondary}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>

            <Border
                x:Name="NavPill"
                Grid.Column="2"
                Margin="12,0"
                Padding="4"
                VerticalAlignment="Center"
                Background="{DynamicResource RowBg}"
                CornerRadius="12">
                <StackPanel Orientation="Horizontal">
                    <Button
                        x:Name="BtnPrev"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Click="BtnPrev_Click"
                        Style="{StaticResource ListToolButtonStyle}"
                        ToolTip="{DynamicResource Str_MetadataDetails_PrevTip}">
                        <materialDesign:PackIcon
                            Width="18"
                            Height="18"
                            Kind="ChevronLeft" />
                    </Button>
                    <TextBlock
                        x:Name="TxtPosition"
                        MinWidth="58"
                        Margin="6,0"
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        TextAlignment="Center" />
                    <Button
                        x:Name="BtnNext"
                        Width="32"
                        Height="32"
                        Padding="0"
                        Click="BtnNext_Click"
                        Style="{StaticResource ListToolButtonStyle}"
                        ToolTip="{DynamicResource Str_MetadataDetails_NextTip}">
                        <materialDesign:PackIcon
                            Width="18"
                            Height="18"
                            Kind="ChevronRight" />
                    </Button>
                </StackPanel>
            </Border>

            <Button
                Grid.Column="3"
                Width="36"
                Height="36"
                Padding="0"
                VerticalAlignment="Center"
                Click="BtnClose_Click"
                Style="{StaticResource ListToolButtonStyle}"
                ToolTip="{DynamicResource Str_MetadataDetails_CloseTip}">
                <materialDesign:PackIcon
                    Width="18"
                    Height="18"
                    Kind="Close" />
            </Button>
        </Grid>

        <!--  ============ Body: picture on the left, information on the right ============  -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="24" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  Left: the file's picture, what it is, and what you can do with it  -->
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Border
                    MinHeight="220"
                    Background="{DynamicResource RowBg}"
                    CornerRadius="14">
                    <Grid>
                        <materialDesign:PackIcon
                            x:Name="ThumbIcon"
                            Width="72"
                            Height="72"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource TextSecondary}"
                            Kind="TagMultiple"
                            Opacity="0.45" />
                        <Image
                            x:Name="ThumbImage"
                            Margin="10"
                            RenderOptions.BitmapScalingMode="HighQuality"
                            Stretch="Uniform" />
                        <TextBlock
                            x:Name="TxtThumbState"
                            Margin="0,0,0,12"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Bottom"
                            FontSize="11"
                            Foreground="{DynamicResource TextSecondary}"
                            Text="{DynamicResource Str_MetadataDetails_LoadingPicture}"
                            Visibility="Collapsed" />
                    </Grid>
                </Border>

                <StackPanel Grid.Row="1" Margin="2,16,2,0">
                    <TextBlock
                        x:Name="TxtFactsMain"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        TextWrapping="Wrap" />
                    <TextBlock
                        x:Name="TxtFactsDate"
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondary}" />
                    <TextBlock
                        x:Name="TxtFactsFolder"
                        Margin="0,4,0,0"
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondary}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                </StackPanel>

                <Grid Grid.Row="2" Margin="0,16,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Button
                        Height="38"
                        Padding="0"
                        Click="BtnOpenFile_Click"
                        Style="{StaticResource ListToolButtonStyle}"
                        ToolTip="{DynamicResource Str_MetadataDetails_OpenFile}">
                        <materialDesign:PackIcon
                            Width="17"
                            Height="17"
                            Kind="OpenInNew" />
                    </Button>
                    <Button
                        x:Name="BtnOpenMap"
                        Grid.Column="2"
                        Height="38"
                        Padding="0"
                        Click="BtnOpenMap_Click"
                        Style="{StaticResource ListToolButtonStyle}"
                        ToolTip="{DynamicResource Str_MetadataExtract_ShowWhereItWas}">
                        <materialDesign:PackIcon
                            Width="17"
                            Height="17"
                            Kind="MapMarkerRadiusOutline" />
                    </Button>
                    <Button
                        Grid.Column="4"
                        Height="38"
                        Padding="0"
                        Click="BtnShowInFolder_Click"
                        Style="{StaticResource ListToolButtonStyle}"
                        ToolTip="{DynamicResource Str_LogViewer_ShowTheFileIn}">
                        <materialDesign:PackIcon
                            Width="17"
                            Height="17"
                            Kind="FolderSearchOutline" />
                    </Button>
                    <Button
                        x:Name="BtnCopyAll"
                        Grid.Column="6"
                        Height="38"
                        Padding="0"
                        Click="BtnCopyAll_Click"
                        Style="{StaticResource ListToolButtonStyle}"
                        ToolTip="{DynamicResource Str_MetadataDetails_CopyAll}">
                        <materialDesign:PackIcon
                            Width="17"
                            Height="17"
                            Kind="ContentCopy" />
                    </Button>
                </Grid>

                <TextBlock
                    x:Name="TxtNote"
                    Grid.Row="3"
                    Margin="2,12,2,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextSecondary}"
                    TextWrapping="Wrap" />
            </Grid>

            <!--  Right: everything found in the file  -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border
                    x:Name="ErrorBanner"
                    Margin="0,0,0,12"
                    Padding="12,8"
                    Background="{DynamicResource StatusErrorBg}"
                    CornerRadius="8"
                    Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon
                            Width="16"
                            Height="16"
                            Margin="0,1,8,0"
                            Foreground="{DynamicResource StatusErrorFg}"
                            Kind="AlertCircleOutline" />
                        <TextBlock
                            x:Name="TxtError"
                            Grid.Column="1"
                            FontSize="12"
                            Foreground="{DynamicResource StatusErrorFg}"
                            TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <Border
                    x:Name="FilterBar"
                    Grid.Row="1"
                    Margin="0,0,0,12"
                    Style="{StaticResource InputBarStyle}"
                    Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon
                            Width="16"
                            Height="16"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource AccentColor}"
                            Kind="Magnify" />
                        <TextBox
                            x:Name="TxtFilter"
                            Grid.Column="1"
                            Style="{StaticResource BareTextBox}"
                            Tag="{DynamicResource Str_MetadataDetails_Find}"
                            TextChanged="TxtFilter_TextChanged" />
                    </Grid>
                </Border>

                <ScrollViewer
                    x:Name="ScrollCards"
                    Grid.Row="2"
                    VerticalScrollBarVisibility="Auto"
                    Visibility="Collapsed">
                    <ItemsControl
                        x:Name="ItemsCards"
                        Focusable="False"
                        ItemTemplate="{StaticResource TileTemplate}">
                        <!--  The panel of an ItemsControl lays out the tiles inside each group card (GroupStyle.Panel would lay out the cards)  -->
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.GroupStyle>
                            <GroupStyle HeaderTemplate="{StaticResource CardHeaderTemplate}">
                                <GroupStyle.ContainerStyle>
                                    <Style TargetType="GroupItem">
                                        <Setter Property="Margin" Value="0,0,8,16" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="GroupItem">
                                                    <Border
                                                        Padding="18,16,8,6"
                                                        BorderBrush="{DynamicResource CardBorder}"
                                                        BorderThickness="1"
                                                        CornerRadius="14">
                                                        <StackPanel>
                                                            <ContentPresenter Margin="0,0,0,14" />
                                                            <ItemsPresenter />
                                                        </StackPanel>
                                                    </Border>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </GroupStyle.ContainerStyle>
                            </GroupStyle>
                        </ItemsControl.GroupStyle>
                    </ItemsControl>
                </ScrollViewer>

                <StackPanel
                    x:Name="EmptyPanel"
                    Grid.Row="2"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                    <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.CursorDefaultClickOutline}" />
                    <TextBlock
                        x:Name="TxtEmpty"
                        MaxWidth="320"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondary}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
