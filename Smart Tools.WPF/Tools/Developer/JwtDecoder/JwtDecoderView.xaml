<UserControl
    x:Class="Smart_Tools.WPF.Views.JwtDecoderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="clr-namespace:Smart_Tools.WPF.Models"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    x:Name="Root"
    d:DesignHeight="700"
    d:DesignWidth="1100"
    mc:Ignorable="d"
    Loaded="View_Loaded">

    <!--
        JWT Decoder - read a token's header, payload, and times. Offline: nothing is sent or saved, and the signature is not checked.
        Backend: Controllers/JwtDecoderManager.cs; Models/JwtDecoderModel.cs. UI only here.
    -->

    <UserControl.Resources>
        <FontFamily x:Key="JwtMono">Cascadia Mono, Consolas, Courier New</FontFamily>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">

        <!--  No page header: MainWindow's header card shows the tool's icon and name.  -->

        <Grid Margin="16,8,16,16">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Token in, status pills out  -->
            <Border Margin="0,0,0,12" ctl:Tour.Key="Str_Tour_JwtDecoder_Token" ctl:Tour.Order="1" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentControl
                            Content="{DynamicResource Str_Jwt_TokenHeader}"
                            Style="{StaticResource CardHeader}"
                            Tag="{x:Static materialDesign:PackIconKind.KeyChainVariant}" />
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button
                                Margin="0,0,4,0"
                                Click="BtnPaste_Click"
                                Style="{StaticResource ListToolButtonStyle}"
                                ToolTip="{DynamicResource Str_Jwt_Paste}">
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    Kind="ContentPaste" />
                            </Button>
                            <Button
                                Click="BtnClear_Click"
                                Style="{StaticResource ListToolDangerButtonStyle}"
                                ToolTip="{DynamicResource Str_Jwt_Clear}">
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    Kind="DeleteSweepOutline" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <TextBox
                        x:Name="TxtToken"
                        Height="84"
                        Margin="0,10,0,0"
                        VerticalContentAlignment="Top"
                        AcceptsReturn="True"
                        FontFamily="{StaticResource JwtMono}"
                        FontSize="12"
                        TextChanged="TxtToken_TextChanged"
                        TextWrapping="Wrap"
                        VerticalScrollBarVisibility="Auto"
                        Tag="{DynamicResource Str_Jwt_TokenHint}" />

                    <WrapPanel x:Name="PillRow" Margin="0,10,0,0" Visibility="Collapsed">
                        <Border x:Name="PillTime" Margin="0,0,8,0" Style="{StaticResource IconStatusPillStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    x:Name="IconTime"
                                    Width="13"
                                    Height="13"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Kind="ClockOutline" />
                                <TextBlock
                                    x:Name="TxtTime"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border x:Name="PillAlg" Margin="0,0,8,0" Style="{StaticResource IconStatusPillStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    x:Name="IconAlg"
                                    Width="13"
                                    Height="13"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Kind="Function" />
                                <TextBlock
                                    x:Name="TxtAlg"
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    FontWeight="SemiBold" />
                            </StackPanel>
                        </Border>
                        <Border
                            Background="{DynamicResource StatusInfoBg}"
                            Style="{StaticResource IconStatusPillStyle}"
                            ToolTip="{DynamicResource Str_Jwt_NotVerifiedTip}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="13"
                                    Height="13"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource StatusInfoFg}"
                                    Kind="ShieldOffOutline" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource StatusInfoFg}"
                                    Text="{DynamicResource Str_Jwt_NotVerified}" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>
                </StackPanel>
            </Border>

            <!--  Decoded parts  -->
            <Grid Grid.Row="1">
                <Grid x:Name="PanelContent" d:Visibility="Visible" Visibility="Collapsed">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="12" />
                        <ColumnDefinition Width="1.3*" />
                    </Grid.ColumnDefinitions>

                    <!--  Header + signature  -->
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Border ctl:Tour.Key="Str_Tour_JwtDecoder_Header" ctl:Tour.Order="2" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentControl
                                        Content="{DynamicResource Str_Jwt_Header}"
                                        Style="{StaticResource CardHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.CodeJson}" />
                                    <Button
                                        Grid.Column="1"
                                        Click="BtnCopyHeader_Click"
                                        Style="{StaticResource ListToolButtonStyle}"
                                        ToolTip="{DynamicResource Str_Jwt_Copy}">
                                        <materialDesign:PackIcon
                                            Width="16"
                                            Height="16"
                                            Kind="ContentCopy" />
                                    </Button>
                                </Grid>
                                <TextBox
                                    x:Name="TxtHeader" Height="Auto"
                                    Grid.Row="1"
                                    Margin="0,10,0,0"
                                    VerticalContentAlignment="Top"
                                    AcceptsReturn="True"
                                    FontFamily="{StaticResource JwtMono}"
                                    FontSize="12"
                                    HorizontalScrollBarVisibility="Auto"
                                    IsReadOnly="True"
                                    VerticalScrollBarVisibility="Auto" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <ContentControl
                                    Content="{DynamicResource Str_Jwt_Signature}"
                                    Style="{StaticResource CardHeader}"
                                    Tag="{x:Static materialDesign:PackIconKind.Fingerprint}" />
                                <TextBlock
                                    x:Name="TxtSignature"
                                    Margin="0,10,0,0"
                                    FontFamily="{StaticResource JwtMono}"
                                    FontSize="11.5"
                                    Foreground="{DynamicResource TextPrimary}"
                                    MaxHeight="64"
                                    TextTrimming="CharacterEllipsis"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="TxtSignatureNote"
                                    Margin="0,6,0,0"
                                    FontSize="11.5"
                                    Foreground="{DynamicResource TextSecondary}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!--  Payload + claims  -->
                    <Grid Grid.Column="2">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="12" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Border ctl:Tour.Key="Str_Tour_JwtDecoder_Payload" ctl:Tour.Order="3" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentControl
                                        Content="{DynamicResource Str_Jwt_Payload}"
                                        Style="{StaticResource CardHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.CodeBraces}" />
                                    <Button
                                        Grid.Column="1"
                                        Click="BtnCopyPayload_Click"
                                        Style="{StaticResource ListToolButtonStyle}"
                                        ToolTip="{DynamicResource Str_Jwt_Copy}">
                                        <materialDesign:PackIcon
                                            Width="16"
                                            Height="16"
                                            Kind="ContentCopy" />
                                    </Button>
                                </Grid>
                                <TextBox
                                    x:Name="TxtPayload" Height="Auto"
                                    Grid.Row="1"
                                    Margin="0,10,0,0"
                                    VerticalContentAlignment="Top"
                                    AcceptsReturn="True"
                                    FontFamily="{StaticResource JwtMono}"
                                    FontSize="12"
                                    HorizontalScrollBarVisibility="Auto"
                                    IsReadOnly="True"
                                    VerticalScrollBarVisibility="Auto" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" ctl:Tour.Key="Str_Tour_JwtDecoder_Claims" ctl:Tour.Order="4" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <ContentControl
                                    Content="{DynamicResource Str_Jwt_Claims}"
                                    Style="{StaticResource CardHeader}"
                                    Tag="{x:Static materialDesign:PackIconKind.FormatListBulleted}" />
                                <DataGrid
                                    x:Name="GridClaims"
                                    Grid.Row="1"
                                    Margin="0,8,0,0"
                                    AutoGenerateColumns="False"
                                    CanUserAddRows="False"
                                    FontSize="12"
                                    IsReadOnly="True"
                                    MinRowHeight="34"
                                    SelectionMode="Single"
                                    VerticalScrollBarVisibility="Auto">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn
                                            Width="110"
                                            Binding="{Binding Name}"
                                            ElementStyle="{StaticResource EllipsisCellTextStyle}"
                                            Header="{DynamicResource Str_Jwt_ColClaim}" />
                                        <DataGridTextColumn
                                            Width="*"
                                            MinWidth="80"
                                            Binding="{Binding Value}"
                                            ElementStyle="{StaticResource EllipsisCellTextStyle}"
                                            Header="{DynamicResource Str_Jwt_ColValue}" />
                                        <DataGridTextColumn
                                            Width="1.4*"
                                            MinWidth="80"
                                            Binding="{Binding Meaning}"
                                            ElementStyle="{StaticResource EllipsisCellTextStyle}"
                                            Header="{DynamicResource Str_Jwt_ColMeaning}" />
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </Grid>
                </Grid>

                <!--  Nothing pasted yet, or the token can't be read  -->
                <StackPanel
                    x:Name="PanelEmpty"
                    MaxWidth="460"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    d:Visibility="Collapsed"
                    IsHitTestVisible="False">
                    <ContentControl x:Name="EmptyBadge" Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.KeyChainVariant}" />
                    <TextBlock
                        x:Name="TxtEmptyTitle"
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}" />
                    <TextBlock
                        x:Name="TxtEmptyHint"
                        Margin="0,4,0,0"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondary}"
                        TextAlignment="Center"
                        TextWrapping="Wrap" />
                </StackPanel>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
