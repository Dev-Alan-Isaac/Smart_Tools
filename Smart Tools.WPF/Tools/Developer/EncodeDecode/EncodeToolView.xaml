<UserControl
    x:Class="Smart_Tools.WPF.Views.EncodeToolView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    x:Name="Root"
    Loaded="Root_Loaded"
    Unloaded="Root_Unloaded">

    <!--
        Backend: Controllers/EncodeToolManager.cs (+ .Files.cs) and Models/EncodeToolModel.cs.
        UI only here. What is typed is never saved, only the setup.
    -->

    <UserControl.Resources>

        <FontFamily x:Key="EncMonoFont">Cascadia Mono, Consolas, Courier New</FontFamily>

        <Style x:Key="EncSideLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarText}" />
            <Setter Property="Margin" Value="2,0,0,4" />
        </Style>

        <Style x:Key="EncSideHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextMuted}" />
            <Setter Property="Margin" Value="2,6,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="EncPillText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>

        <Style x:Key="EncSectionLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="12" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <DataTemplate x:Key="NoteTemplate">
            <StackPanel Margin="0,0,0,3" Orientation="Horizontal">
                <materialDesign:PackIcon
                    Width="14"
                    Height="14"
                    Margin="0,1,6,0"
                    VerticalAlignment="Top"
                    Foreground="{DynamicResource StatusInfoFg}"
                    Kind="InformationOutline" />
                <TextBlock
                    MaxWidth="640"
                    FontSize="11.5"
                    Foreground="{DynamicResource TextSecondary}"
                    Text="{Binding}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </DataTemplate>

        <!--  "Good to know" cards, one per mode. x:Shared is off so each is its own instance.  -->
        <Border
            x:Key="FactsBase64"
            Margin="0,16,0,0"
            Padding="16,14,0,0"
            x:Shared="False"
            Background="{DynamicResource RowBg}"
            CornerRadius="12">
            <StackPanel>
                <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                    <materialDesign:PackIcon
                        Width="16"
                        Height="16"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource AccentColor}"
                        Kind="LightbulbOnOutline" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        Text="{DynamicResource Str_EncTool_GoodToKnow}" />
                </StackPanel>
                <UniformGrid Columns="2">
                    <controls:InfoFact
                        Title="{DynamicResource Str_EncTool_Fact_B641_T}"
                        Body="{DynamicResource Str_EncTool_Fact_B641_B}"
                        Icon="ShieldAlertOutline" />
                    <controls:InfoFact
                        Title="{DynamicResource Str_EncTool_Fact_B642_T}"
                        Body="{DynamicResource Str_EncTool_Fact_B642_B}"
                        Icon="ArrowExpandHorizontal" />
                    <controls:InfoFact
                        Title="{DynamicResource Str_EncTool_Fact_B643_T}"
                        Body="{DynamicResource Str_EncTool_Fact_B643_B}"
                        Icon="Equal" />
                    <controls:InfoFact
                        Title="{DynamicResource Str_EncTool_Fact_B644_T}"
                        Body="{DynamicResource Str_EncTool_Fact_B644_B}"
                        Icon="LinkVariant" />
                    <controls:InfoFact
                        Title="{DynamicResource Str_EncTool_Fact_B645_T}"
                        Body="{DynamicResource Str_EncTool_Fact_B645_B}"
                        Icon="Translate" />
                    <controls:InfoFact
                        Title="{DynamicResource Str_EncTool_Fact_B646_T}"
                        Body="{DynamicResource Str_EncTool_Fact_B646_B}"
                        Icon="FormatLineSpacing" />
                </UniformGrid>
            </StackPanel>
        </Border>
        <Border
            x:Key="FactsUrl"
            Margin="0,16,0,0"
            Padding="16,14,0,0"
            x:Shared="False"
            Background="{DynamicResource RowBg}"
            CornerRadius="12">
            <StackPanel>
                <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                    <materialDesign:PackIcon
                        Width="16"
                        Height="16"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource AccentColor}"
                        Kind="LightbulbOnOutline" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        Text="{DynamicResource Str_EncTool_GoodToKnow}" />
                </StackPanel>
                <UniformGrid Columns="2">
                    <controls:InfoFact
                        Title="{DynamicResource Str_EncTool_Fact_Url1_T}"
                        Body="{DynamicResource Str_EncTool_Fact_Url1_B}"
                        Icon="LinkVariant" />
                    <controls:InfoFact
                        Title="{DynamicResource Str_EncTool_Fact_Url2_T}"
                        Body="{DynamicResource Str_EncTool_Fact_Url2_B}"
                        Icon="Percent" />
                    <controls:InfoFact
                        Title="{DynamicResource Str_EncTool_Fact_Url3_T}"
                        Body="{DynamicResource Str_EncTool_Fact_Url3_B}"
                        Icon="Plus" />
                    <controls:InfoFact
                        Title="{DynamicResource Str_EncTool_Fact_Url4_T}"
                        Body="{DynamicResource Str_EncTool_Fact_Url4_B}"
                        Icon="Translate" />
                    <controls:InfoFact
                        Title="{DynamicResource Str_EncTool_Fact_Url5_T}"
                        Body="{DynamicResource Str_EncTool_Fact_Url5_B}"
                        Icon="Repeat" />
                </UniformGrid>
            </StackPanel>
        </Border>
        <Border
            x:Key="FactsHtml"
            Margin="0,16,0,0"
            Padding="16,14,0,0"
            x:Shared="False"
            Background="{DynamicResource RowBg}"
            CornerRadius="12">
            <StackPanel>
                <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                    <materialDesign:PackIcon
                        Width="16"
                        Height="16"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource AccentColor}"
                        Kind="LightbulbOnOutline" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        Text="{DynamicResource Str_EncTool_GoodToKnow}" />
                </StackPanel>
                <UniformGrid Columns="2">
                    <controls:InfoFact
                        Title="{DynamicResource Str_EncTool_Fact_Html1_T}"
                        Body="{DynamicResource Str_EncTool_Fact_Html1_B}"
                        Icon="CodeTags" />
                    <controls:InfoFact
                        Title="{DynamicResource Str_EncTool_Fact_Html2_T}"
                        Body="{DynamicResource Str_EncTool_Fact_Html2_B}"
                        Icon="Numeric" />
                    <controls:InfoFact
                        Title="{DynamicResource Str_EncTool_Fact_Html3_T}"
                        Body="{DynamicResource Str_EncTool_Fact_Html3_B}"
                        Icon="BookOpenVariant" />
                    <controls:InfoFact
                        Title="{DynamicResource Str_EncTool_Fact_Html4_T}"
                        Body="{DynamicResource Str_EncTool_Fact_Html4_B}"
                        Icon="ShieldAlertOutline" />
                </UniformGrid>
            </StackPanel>
        </Border>
        <Border
            x:Key="FactsFile"
            Margin="0,16,0,0"
            Padding="16,14,0,0"
            x:Shared="False"
            Background="{DynamicResource RowBg}"
            CornerRadius="12">
            <StackPanel>
                <StackPanel Margin="0,0,0,12" Orientation="Horizontal">
                    <materialDesign:PackIcon
                        Width="16"
                        Height="16"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource AccentColor}"
                        Kind="LightbulbOnOutline" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="13"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        Text="{DynamicResource Str_EncTool_GoodToKnow}" />
                </StackPanel>
                <UniformGrid Columns="2">
                    <controls:InfoFact
                        Title="{DynamicResource Str_EncTool_Fact_File1_T}"
                        Body="{DynamicResource Str_EncTool_Fact_File1_B}"
                        Icon="ImageOutline" />
                    <controls:InfoFact
                        Title="{DynamicResource Str_EncTool_Fact_File2_T}"
                        Body="{DynamicResource Str_EncTool_Fact_File2_B}"
                        Icon="ArrowExpandHorizontal" />
                    <controls:InfoFact
                        Title="{DynamicResource Str_EncTool_Fact_File3_T}"
                        Body="{DynamicResource Str_EncTool_Fact_File3_B}"
                        Icon="FileDownloadOutline" />
                    <controls:InfoFact
                        Title="{DynamicResource Str_EncTool_Fact_File4_T}"
                        Body="{DynamicResource Str_EncTool_Fact_File4_B}"
                        Icon="ShieldLockOutline" />
                </UniformGrid>
            </StackPanel>
        </Border>

    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">

        <!--  No page header: MainWindow's header card shows the tool's icon and name.  -->

        <Grid Margin="16,8,16,16">

            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OptionsColumn" Width="280" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= OPTIONS SIDEBAR =================  -->

            <Border Grid.Column="0" Style="{StaticResource SidebarPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Button
                            x:Name="BtnCollapseOptions"
                            MinHeight="45"
                            HorizontalContentAlignment="Left"
                            Click="BtnCollapseOptions_Click"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Foreground="{DynamicResource SidebarText}"
                            ToolTip="{DynamicResource Str_Common_SidebarToggleTooltip}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="OverridesDefaultStyle" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Margin="16,0,0,0" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Kind="TuneVariant" />
                                <TextBlock
                                    x:Name="TxtOptionsHeaderLabel"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{DynamicResource Str_Common_OptionsLabel}" />
                            </StackPanel>
                        </Button>
                        <Separator
                            x:Name="SepHeader"
                            Margin="16,4"
                            Style="{StaticResource SidebarSeparatorStyle}" />
                    </StackPanel>

                    <ScrollViewer
                        x:Name="OptionsScrollViewer"
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16,4,16,16">

                            <!--  ============ TEXT ENCODING ============  -->
                            <Border x:Name="TextEncodingPanel" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_EncTool_TextEncHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.Translate}" />
                                    <Border Style="{StaticResource InputBarStyle}">
                                        <ComboBox
                                            x:Name="CmbTextEncoding"
                                            VerticalContentAlignment="Center"
                                            SelectedIndex="0"
                                            SelectionChanged="Option_SelectionChanged"
                                            Style="{StaticResource BareComboBox}">
                                            <ComboBoxItem Content="UTF-8" Tag="Utf8" />
                                            <ComboBoxItem Content="{DynamicResource Str_EncodeDecode_Utf}" Tag="Utf16" />
                                            <ComboBoxItem Content="{DynamicResource Str_EncodeDecode_LatinIso}" Tag="Latin1" />
                                        </ComboBox>
                                    </Border>
                                    <TextBlock Style="{StaticResource EncSideHint}" Text="{DynamicResource Str_EncTool_TextEncHint}" />
                                </StackPanel>
                            </Border>

                            <!--  ============ BASE64 OPTIONS ============  -->
                            <Border x:Name="Base64OptionsPanel" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_EncTool_B64Header}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.Tune}" />
                                    <TextBlock Style="{StaticResource EncSideLabel}" Text="{DynamicResource Str_EncTool_AlphabetLabel}" />
                                    <UniformGrid x:Name="AlphabetChips" Columns="2">
                                        <RadioButton
                                            x:Name="RadioAlphaStd"
                                            Margin="0,0,2,0"
                                            Click="Option_Click"
                                            Content="{DynamicResource Str_EncTool_AlphaStandard}"
                                            GroupName="EncAlpha"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleButtonStyle}" />
                                        <RadioButton
                                            x:Name="RadioAlphaUrl"
                                            Margin="2,0,0,0"
                                            Click="Option_Click"
                                            Content="{DynamicResource Str_EncTool_AlphaUrlSafe}"
                                            GroupName="EncAlpha"
                                            Style="{StaticResource ModeToggleButtonStyle}" />
                                    </UniformGrid>
                                    <CheckBox
                                        x:Name="ChkPadding"
                                        Margin="0,12,0,0"
                                        Click="Option_Click"
                                        Foreground="{DynamicResource SidebarText}"
                                        IsChecked="True">
                                        <TextBlock Text="{DynamicResource Str_EncTool_Padding}" TextWrapping="Wrap" />
                                    </CheckBox>
                                    <CheckBox
                                        x:Name="ChkWrap"
                                        Margin="0,8,0,0"
                                        Click="Option_Click"
                                        Foreground="{DynamicResource SidebarText}">
                                        <TextBlock Text="{DynamicResource Str_EncTool_Wrap}" TextWrapping="Wrap" />
                                    </CheckBox>
                                    <TextBlock x:Name="TxtB64Hint" Style="{StaticResource EncSideHint}" />
                                </StackPanel>
                            </Border>

                            <!--  ============ URL OPTIONS ============  -->
                            <Border
                                x:Name="UrlOptionsPanel"
                                Style="{StaticResource SidebarGroupCardStyle}"
                                Visibility="Collapsed">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_EncTool_UrlHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.LinkVariant}" />
                                    <TextBlock Style="{StaticResource EncSideLabel}" Text="{DynamicResource Str_EncTool_ScopeLabel}" />
                                    <UniformGrid x:Name="ScopeChips" Columns="2">
                                        <RadioButton
                                            x:Name="RadioScopeComponent"
                                            Margin="0,0,2,0"
                                            Click="Option_Click"
                                            Content="{DynamicResource Str_EncTool_ScopeComponent}"
                                            GroupName="EncScope"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleButtonStyle}" />
                                        <RadioButton
                                            x:Name="RadioScopeFull"
                                            Margin="2,0,0,0"
                                            Click="Option_Click"
                                            Content="{DynamicResource Str_EncTool_ScopeFull}"
                                            GroupName="EncScope"
                                            Style="{StaticResource ModeToggleButtonStyle}" />
                                    </UniformGrid>
                                    <TextBlock x:Name="TxtScopeHint" Style="{StaticResource EncSideHint}" />
                                    <CheckBox
                                        x:Name="ChkSpaceAsPlus"
                                        Margin="0,12,0,0"
                                        Click="Option_Click"
                                        Foreground="{DynamicResource SidebarText}">
                                        <TextBlock Text="{DynamicResource Str_EncTool_SpacePlus}" TextWrapping="Wrap" />
                                    </CheckBox>
                                    <TextBlock Style="{StaticResource EncSideHint}" Text="{DynamicResource Str_EncTool_SpacePlusHint}" />
                                </StackPanel>
                            </Border>

                            <!--  ============ HTML OPTIONS ============  -->
                            <Border
                                x:Name="HtmlOptionsPanel"
                                Style="{StaticResource SidebarGroupCardStyle}"
                                Visibility="Collapsed">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_EncTool_HtmlHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.LanguageHtml5}" />
                                    <CheckBox
                                        x:Name="ChkHtmlAll"
                                        Click="Option_Click"
                                        Foreground="{DynamicResource SidebarText}">
                                        <TextBlock Text="{DynamicResource Str_EncTool_HtmlAll}" TextWrapping="Wrap" />
                                    </CheckBox>
                                    <TextBlock x:Name="TxtHtmlHint" Style="{StaticResource EncSideHint}" />
                                </StackPanel>
                            </Border>

                            <!--  ============ FILE OPTIONS ============  -->
                            <Border
                                x:Name="FileOptionsPanel"
                                Style="{StaticResource SidebarGroupCardStyle}"
                                Visibility="Collapsed">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_EncTool_FileHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.FileOutline}" />
                                    <CheckBox
                                        x:Name="ChkDataUri"
                                        Click="Option_Click"
                                        Foreground="{DynamicResource SidebarText}">
                                        <TextBlock Text="{DynamicResource Str_EncTool_DataUri}" TextWrapping="Wrap" />
                                    </CheckBox>
                                    <TextBlock x:Name="TxtFileHint" Style="{StaticResource EncSideHint}" />
                                </StackPanel>
                            </Border>

                            <!--  ============ VIEW ============  -->
                            <Border Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_EncTool_ViewHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.EyeOutline}" />
                                    <CheckBox
                                        x:Name="ChkShowHex"
                                        Click="ChkShowHex_Click"
                                        Foreground="{DynamicResource SidebarText}">
                                        <TextBlock Text="{DynamicResource Str_EncTool_ShowHex}" TextWrapping="Wrap" />
                                    </CheckBox>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--  ================= MAIN =================  -->

            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  Mode tabs: Base64 / URL / HTML / File  -->
                    <Border Grid.Row="0" Margin="0,0,0,12" BorderBrush="{DynamicResource CardBorder}" BorderThickness="0,0,0,1">
                        <StackPanel ctl:Tour.Key="Str_Tour_EncodeDecode_Format" ctl:Tour.Order="1" Orientation="Horizontal">
                            <RadioButton
                                x:Name="RadioModeBase64"
                                Click="Mode_Click"
                                Content="{DynamicResource Str_EncTool_ModeBase64}"
                                GroupName="EncMode"
                                IsChecked="True"
                                Tag="Base64"
                                controls:ChoiceIcon.Kind="FileCodeOutline"
                                Style="{StaticResource ModeTabStyle}" />
                            <RadioButton
                                x:Name="RadioModeUrl"
                                Click="Mode_Click"
                                Content="{DynamicResource Str_EncTool_ModeUrl}"
                                GroupName="EncMode"
                                Tag="Url"
                                controls:ChoiceIcon.Kind="Link"
                                Style="{StaticResource ModeTabStyle}" />
                            <RadioButton
                                x:Name="RadioModeHtml"
                                Click="Mode_Click"
                                Content="{DynamicResource Str_EncTool_ModeHtml}"
                                GroupName="EncMode"
                                Tag="Html"
                                controls:ChoiceIcon.Kind="CodeTags"
                                Style="{StaticResource ModeTabStyle}" />
                            <RadioButton
                                x:Name="RadioModeFile"
                                Click="Mode_Click"
                                Content="{DynamicResource Str_EncTool_ModeFile}"
                                GroupName="EncMode"
                                Tag="File"
                                controls:ChoiceIcon.Kind="FileOutline"
                                Style="{StaticResource ModeTabStyle}" />
                        </StackPanel>
                    </Border>


                    <Grid Grid.Row="1" Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentControl
                            x:Name="HeaderTitle"
                            VerticalAlignment="Center"
                            Content="{DynamicResource Str_EncTool_ModeBase64}"
                            Style="{StaticResource CardHeader}"
                            Tag="{x:Static materialDesign:PackIconKind.SwapHorizontal}" />
                        <Border
                            x:Name="CopiedPill"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Background="{DynamicResource StatusSuccessBg}"
                            Style="{StaticResource IconStatusPillStyle}"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="13"
                                    Height="13"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource StatusSuccessFg}"
                                    Kind="Check" />
                                <TextBlock
                                    x:Name="TxtPillText"
                                    FontSize="11.5"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource StatusSuccessFg}"
                                    Text="{DynamicResource Str_EncTool_Copied}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <ScrollViewer
                        Grid.Row="2"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="0,0,10,0">

                            <!--  Direction row  -->
                            <Grid x:Name="DirectionRow" SizeChanged="DirectionRow_SizeChanged">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <UniformGrid Width="260" Columns="2">
                                    <RadioButton
                                        x:Name="RadioEncode"
                                        Margin="0,0,2,0"
                                        Click="Direction_Click"
                                        Content="{DynamicResource Str_EncTool_Encode}"
                                        GroupName="EncDirection"
                                        IsChecked="True"
                                        Style="{StaticResource ModeToggleButtonStyle}"
                                        Tag="Encode" />
                                    <RadioButton
                                        x:Name="RadioDecode"
                                        Margin="2,0,0,0"
                                        Click="Direction_Click"
                                        Content="{DynamicResource Str_EncTool_Decode}"
                                        GroupName="EncDirection"
                                        Style="{StaticResource ModeToggleButtonStyle}"
                                        Tag="Decode" />
                                </UniformGrid>
                                <Button
                                    x:Name="BtnSwap"
                                    ctl:Tour.Key="Str_Tour_EncodeDecode_Swap" ctl:Tour.Order="3"
                                    Grid.Column="1"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    Click="BtnSwap_Click"
                                    Style="{StaticResource ListToolButtonStyle}"
                                    ToolTip="{DynamicResource Str_EncTool_SwapTooltip}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="SwapVertical" />
                                </Button>
                                <StackPanel
                                    x:Name="DirectionActions"
                                    Grid.Column="2"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <Button
                                        x:Name="BtnOpen"
                                        MinHeight="36"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Click="BtnOpen_Click"
                                        Style="{StaticResource PrimaryButtonStyle}">
                                        <Grid HorizontalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon
                                                Grid.Column="0"
                                                Width="16"
                                                Height="16"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Kind="FolderOpenOutline" />
                                            <TextBlock
                                                Grid.Column="1"
                                                x:Name="TxtOpenLabel"
                                                VerticalAlignment="Center"
                                                Text="{DynamicResource Str_EncTool_OpenFile}" TextWrapping="Wrap" />
                                        </Grid>
                                    </Button>
                                    <Button Padding="0"
                                        Width="36"
                                        Height="36"
                                        VerticalAlignment="Center"
                                        Click="BtnClear_Click"
                                        Style="{StaticResource NeutralIconButtonStyle}"
                                        ToolTip="{DynamicResource Str_EncTool_ClearTooltip}">
                                        <materialDesign:PackIcon
                                            Width="18"
                                            Height="18"
                                            Kind="DeleteOutline" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!--  File (encode): the chosen file  -->
                            <Border
                                x:Name="FileDropArea"
                                Margin="0,14,0,0"
                                Padding="16,18"
                                AllowDrop="True"
                                Background="{DynamicResource RowBg}"
                                BorderBrush="{DynamicResource InputBorder}"
                                BorderThickness="1"
                                CornerRadius="12"
                                DragLeave="FileDropArea_DragLeave"
                                DragOver="FileDropArea_DragOver"
                                Drop="FileDropArea_Drop"
                                Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <ContentControl
                                        x:Name="FileBadge"
                                        Width="44"
                                        Height="44"
                                        Margin="0,0,14,0"
                                        VerticalAlignment="Center"
                                        Style="{StaticResource EmptyStateBadge}"
                                        Tag="{x:Static materialDesign:PackIconKind.TrayArrowDown}" />
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <TextBlock
                                            x:Name="TxtFileName"
                                            FontSize="13.5"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextPrimary}"
                                            Text="{DynamicResource Str_EncTool_DropFileTitle}"
                                            TextTrimming="CharacterEllipsis" />
                                        <TextBlock
                                            x:Name="TxtFileInfo"
                                            Margin="0,2,0,0"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextSecondary}"
                                            Text="{DynamicResource Str_EncTool_DropFileHint}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                            <!--  Input  -->
                            <StackPanel x:Name="InputSection" ctl:Tour.Key="Str_Tour_EncodeDecode_Input" ctl:Tour.Order="2" Margin="0,16,0,0">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="15"
                                            Height="15"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource AccentColor}"
                                            Kind="TextBoxEditOutline" />
                                        <TextBlock Style="{StaticResource EncSectionLabel}" Text="{DynamicResource Str_EncTool_Input}" />
                                    </StackPanel>
                                    <Border
                                        Grid.Column="1"
                                        Background="{DynamicResource RowBg}"
                                        Style="{StaticResource IconStatusPillStyle}">
                                        <TextBlock x:Name="TxtInputCount" Style="{StaticResource EncPillText}" />
                                    </Border>
                                </Grid>
                                <TextBox
                                    x:Name="TxtInput"
                                    MinHeight="150"
                                    MaxHeight="260"
                                    AllowDrop="True"
                                    FontFamily="{StaticResource EncMonoFont}"
                                    PreviewDragOver="TxtInput_PreviewDragOver"
                                    PreviewDrop="TxtInput_PreviewDrop"
                                    Style="{StaticResource CodeTextBox}"
                                    Tag="{DynamicResource Str_EncTool_InputHint}"
                                    TextChanged="TxtInput_TextChanged" />
                            </StackPanel>

                            <!--  Status line and notes  -->
                            <Border
                                x:Name="StatusBanner"
                                Margin="0,12,0,0"
                                Padding="12,9"
                                HorizontalAlignment="Left"
                                CornerRadius="8"
                                Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        x:Name="StatusIcon"
                                        Width="16"
                                        Height="16"
                                        Margin="0,1,8,0"
                                        VerticalAlignment="Top" />
                                    <TextBlock
                                        x:Name="TxtStatus"
                                        MaxWidth="700"
                                        FontSize="12.5"
                                        FontWeight="SemiBold"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>
                            <ItemsControl
                                x:Name="NotesList"
                                Margin="2,8,0,0"
                                ItemTemplate="{StaticResource NoteTemplate}" />

                            <!--  Output  -->
                            <StackPanel x:Name="OutputSection" ctl:Tour.Key="Str_Tour_EncodeDecode_Output" ctl:Tour.Order="4" Margin="0,14,0,0">
                                <Grid Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="15"
                                            Height="15"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource AccentColor}"
                                            Kind="TextBoxCheckOutline" />
                                        <TextBlock Style="{StaticResource EncSectionLabel}" Text="{DynamicResource Str_EncTool_Output}" />
                                    </StackPanel>
                                    <WrapPanel
                                        Grid.Column="1"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center">
                                        <Border
                                            x:Name="PillIn"
                                            Margin="0,0,6,0"
                                            Background="{DynamicResource RowBg}"
                                            Style="{StaticResource IconStatusPillStyle}"
                                            Visibility="Collapsed">
                                            <TextBlock x:Name="TxtPillIn" Style="{StaticResource EncPillText}" />
                                        </Border>
                                        <Border
                                            x:Name="PillOut"
                                            Margin="0,0,6,0"
                                            Background="{DynamicResource RowBg}"
                                            Style="{StaticResource IconStatusPillStyle}"
                                            Visibility="Collapsed">
                                            <TextBlock x:Name="TxtPillOut" Style="{StaticResource EncPillText}" />
                                        </Border>
                                        <Border
                                            x:Name="PillRatio"
                                            Background="{DynamicResource AccentColorSubtle}"
                                            Style="{StaticResource IconStatusPillStyle}"
                                            Visibility="Collapsed">
                                            <TextBlock
                                                x:Name="TxtPillRatio"
                                                FontSize="11.5"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource AccentColor}" />
                                        </Border>
                                    </WrapPanel>
                                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                                        <Button
                                            x:Name="BtnCopy"
                                            Margin="0,0,6,0"
                                            Click="BtnCopy_Click"
                                            Style="{StaticResource ListToolButtonStyle}"
                                            ToolTip="{DynamicResource Str_EncTool_Copy}">
                                            <materialDesign:PackIcon
                                                Width="16"
                                                Height="16"
                                                Kind="ContentCopy" />
                                        </Button>
                                        <Button
                                            x:Name="BtnSave"
                                            Click="BtnSave_Click"
                                            Style="{StaticResource ListToolButtonStyle}"
                                            ToolTip="{DynamicResource Str_EncTool_SaveTooltip}">
                                            <materialDesign:PackIcon
                                                Width="16"
                                                Height="16"
                                                Kind="ContentSaveOutline" />
                                        </Button>
                                    </StackPanel>
                                </Grid>

                                <TextBox
                                    x:Name="TxtOutput"
                                    MinHeight="150"
                                    MaxHeight="260"
                                    FontFamily="{StaticResource EncMonoFont}"
                                    IsReadOnly="True"
                                    Style="{StaticResource CodeTextBox}"
                                    Tag="{DynamicResource Str_EncTool_OutputHint}" />

                                <!--  Shown instead of the text when the decoded bytes are a file  -->
                                <Border
                                    x:Name="BinaryPanel"
                                    Padding="16,16"
                                    Background="{DynamicResource RowBg}"
                                    CornerRadius="12"
                                    Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ContentControl
                                            Width="44"
                                            Height="44"
                                            Margin="0,0,14,0"
                                            VerticalAlignment="Center"
                                            Style="{StaticResource EmptyStateBadge}"
                                            Tag="{x:Static materialDesign:PackIconKind.FileQuestionOutline}" />
                                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                            <TextBlock
                                                x:Name="TxtBinaryTitle"
                                                FontSize="13.5"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource TextPrimary}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Margin="0,2,0,0"
                                                FontSize="12"
                                                Foreground="{DynamicResource TextSecondary}"
                                                Text="{DynamicResource Str_EncTool_BinaryHint}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button
                                            Grid.Column="2"
                                            MinHeight="36"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center"
                                            Click="BtnSave_Click"
                                            Style="{StaticResource PrimaryButtonStyle}">
                                            <Grid HorizontalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon
                                                    Grid.Column="0"
                                                    Width="16"
                                                    Height="16"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Kind="ContentSaveOutline" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_EncTool_SaveAsFile}" TextWrapping="Wrap" />
                                            </Grid>
                                        </Button>
                                    </Grid>
                                </Border>

                                <StackPanel
                                    x:Name="HexSection"
                                    Margin="0,12,0,0"
                                    Visibility="Collapsed">
                                    <StackPanel Margin="0,0,0,6" Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="15"
                                            Height="15"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource AccentColor}"
                                            Kind="Hexadecimal" />
                                        <TextBlock Style="{StaticResource EncSectionLabel}" Text="{DynamicResource Str_EncTool_HexTitle}" />
                                    </StackPanel>
                                    <TextBox
                                        x:Name="TxtHex"
                                        Height="170"
                                        FontFamily="{StaticResource EncMonoFont}"
                                        IsReadOnly="True"
                                        Style="{StaticResource CodeTextBoxNoWrap}" />
                                </StackPanel>
                            </StackPanel>

                            <!--  Empty hint  -->
                            <TextBlock
                                x:Name="TxtEmptyHint"
                                Margin="2,10,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="{DynamicResource Str_EncTool_EmptyHint}"
                                TextWrapping="Wrap" />

                            <!--  Good to know (one per mode)  -->
                            <ContentControl x:Name="FactsHost" />

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
