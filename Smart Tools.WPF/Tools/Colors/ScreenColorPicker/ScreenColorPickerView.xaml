<UserControl
    x:Class="Smart_Tools.WPF.Views.ScreenColorPickerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    x:Name="Root"
    PreviewKeyDown="Root_PreviewKeyDown">

    <!--
        Backend: Controllers/ScreenColorPickerManager.cs (reading pixels, formats, settings)
        + .Windows.cs (screen capture); Models/ScreenColorPickerModel.cs. The full-screen
        eyedropper is Views/ScreenColorPickerOverlay.cs. UI only here.
    -->

    <Grid Background="{DynamicResource ContentBg}">
        <Grid Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OptionsColumn" Width="280" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= OPTIONS SIDEBAR =================  -->
            <Border Grid.Column="0" Style="{StaticResource SidebarPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Button
                            x:Name="BtnCollapseOptions"
                            MinHeight="45"
                            HorizontalContentAlignment="Left"
                            Click="BtnCollapseOptions_Click"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Foreground="{DynamicResource SidebarText}"
                            ToolTip="{DynamicResource Str_Common_SidebarToggleTooltip}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="OverridesDefaultStyle" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Margin="16,0,0,0" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Kind="TuneVariant" />
                                <TextBlock
                                    x:Name="TxtOptionsHeaderLabel"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{DynamicResource Str_Common_OptionsLabel}" />
                            </StackPanel>
                        </Button>
                        <Separator
                            x:Name="SepHeader"
                            Margin="16,4"
                            Style="{StaticResource SidebarSeparatorStyle}" />
                    </StackPanel>

                    <ScrollViewer
                        x:Name="OptionsScrollViewer"
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16">

                            <!--  ============ PICKING ============  -->
                            <Border ctl:Tour.Key="Str_Tour_ScreenColorPicker_Picking" ctl:Tour.Order="1" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_ScreenColor_PickingHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.Eyedropper}" />
                                    <TextBlock
                                        Margin="0,0,0,6"
                                        Style="{StaticResource FieldLabel}"
                                        Text="{DynamicResource Str_ScreenColor_SampleLabel}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <RadioButton
                                            x:Name="RadioSamplePixel"
                                            Checked="Sample_Checked"
                                            Content="{DynamicResource Str_ScreenColor_SamplePixel}"
                                            GroupName="ScreenColorSample"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="Pixel"
                                            ToolTip="{DynamicResource Str_ScreenColor_SamplePixelTip}" />
                                        <RadioButton
                                            x:Name="RadioSample3"
                                            Grid.Column="2"
                                            Checked="Sample_Checked"
                                            Content="3 × 3"
                                            GroupName="ScreenColorSample"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="Average3"
                                            ToolTip="{DynamicResource Str_ScreenColor_SampleAvgTip}" />
                                        <RadioButton
                                            x:Name="RadioSample5"
                                            Grid.Column="4"
                                            Checked="Sample_Checked"
                                            Content="5 × 5"
                                            GroupName="ScreenColorSample"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="Average5"
                                            ToolTip="{DynamicResource Str_ScreenColor_SampleAvgTip}" />
                                    </Grid>
                                    <CheckBox
                                        x:Name="ChkHideWhilePicking"
                                        Margin="0,12,0,0"
                                        Checked="Option_Changed"
                                        Content="{DynamicResource Str_ScreenColor_HideWhilePicking}"
                                        Foreground="{DynamicResource SidebarText}"
                                        IsChecked="True"
                                        ToolTip="{DynamicResource Str_ScreenColor_HideWhilePickingTip}"
                                        Unchecked="Option_Changed" />
                                </StackPanel>
                            </Border>

                            <!--  ============ COPY ============  -->
                            <Border ctl:Tour.Key="Str_Tour_ScreenColorPicker_Copy" ctl:Tour.Order="2" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_ScreenColor_CopyHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.ContentCopy}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <RadioButton
                                            x:Name="RadioFormatHex"
                                            Checked="Format_Checked"
                                            Content="HEX"
                                            GroupName="ScreenColorFormat"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="Hex" />
                                        <RadioButton
                                            x:Name="RadioFormatRgb"
                                            Grid.Column="2"
                                            Checked="Format_Checked"
                                            Content="RGB"
                                            GroupName="ScreenColorFormat"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="Rgb" />
                                        <RadioButton
                                            x:Name="RadioFormatHsl"
                                            Grid.Column="4"
                                            Checked="Format_Checked"
                                            Content="HSL"
                                            GroupName="ScreenColorFormat"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="Hsl" />
                                        <RadioButton
                                            x:Name="RadioFormatCss"
                                            Grid.Column="6"
                                            Checked="Format_Checked"
                                            Content="CSS"
                                            GroupName="ScreenColorFormat"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="CssRgb"
                                            ToolTip="{DynamicResource Str_ScreenColor_FormatCssTip}" />
                                    </Grid>
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        Style="{StaticResource FieldLabel}"
                                        Text="{DynamicResource Str_ScreenColor_ExampleLabel}" />
                                    <TextBlock
                                        x:Name="TxtFormatExample"
                                        Margin="0,8,0,0"
                                        FontFamily="Consolas"
                                        FontSize="11.5"
                                        Foreground="{DynamicResource SidebarText}"
                                        Opacity="0.8" />
                                    <CheckBox
                                        x:Name="ChkAutoCopy"
                                        Margin="0,10,0,0"
                                        Checked="Option_Changed"
                                        Content="{DynamicResource Str_ScreenColor_AutoCopy}"
                                        Foreground="{DynamicResource SidebarText}"
                                        IsChecked="True"
                                        Unchecked="Option_Changed" />
                                </StackPanel>
                            </Border>

                            <!--  ============ TIPS ============  -->
                            <Border
                                Margin="0,4,0,0"
                                Padding="10,8"
                                Background="{DynamicResource StatusInfoBg}"
                                CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon
                                        Width="14"
                                        Height="14"
                                        Margin="0,1,8,0"
                                        VerticalAlignment="Top"
                                        Foreground="{DynamicResource StatusInfoFg}"
                                        Kind="LightbulbOnOutline" />
                                    <TextBlock
                                        Grid.Column="1"
                                        FontSize="10.5"
                                        Foreground="{DynamicResource StatusInfoFg}"
                                        Text="{DynamicResource Str_ScreenColor_Tips}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--  ================= MAIN AREA =================  -->
            <Grid Grid.Column="2">
                <!--  Picked colour card: like the Color Picker's "Current color" card, the actions live inside it (no run bar)  -->
                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  Header: title, status, and the pick / favorite buttons  -->
                        <Grid Margin="0,0,0,12">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ContentControl
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Content="{DynamicResource Str_ScreenColor_PickedHeader}"
                                Style="{StaticResource CardHeader}"
                                Tag="{x:Static materialDesign:PackIconKind.Eyedropper}" />

                            <Border
                                x:Name="BorderStatus"
                                Grid.Column="1"
                                MaxWidth="360"
                                Margin="12,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{DynamicResource RowBg}"
                                Style="{StaticResource IconStatusPillStyle}"
                                Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        x:Name="IconStatus"
                                        Width="13"
                                        Height="13"
                                        Margin="0,0,5,0"
                                        VerticalAlignment="Center"
                                        Foreground="{Binding Foreground, ElementName=TxtStatus}"
                                        Kind="CheckCircleOutline" />
                                    <TextBlock
                                        x:Name="TxtStatus"
                                        FontSize="11.5"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextSecondary}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>

                            <Button
                                x:Name="BtnFavorite"
                                Grid.Column="2"
                                Margin="0,0,8,0"
                                VerticalAlignment="Center"
                                Click="BtnFavorite_Click"
                                IsEnabled="False"
                                Style="{StaticResource ListToolPrimaryButtonStyle}"
                                ToolTip="{DynamicResource Str_ScreenColor_FavoriteTip}">
                                <Grid HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon
                                        Grid.Column="0"
                                        x:Name="IconFavorite"
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Kind="Star" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_ScreenColor_Favorite}" TextWrapping="Wrap" />
                                </Grid>
                            </Button>

                            <Button
                                x:Name="BtnPick"
                                ctl:Tour.Key="Str_Tour_ScreenColorPicker_Pick"
                                ctl:Tour.Order="3"
                                Grid.Column="3"
                                VerticalAlignment="Center"
                                Click="BtnPick_Click"
                                Style="{StaticResource ListToolPrimaryButtonStyle}"
                                ToolTip="{DynamicResource Str_ScreenColor_PickTip}">
                                <Grid HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon
                                        Grid.Column="0"
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Kind="Eyedropper" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_ScreenColor_Pick}" TextWrapping="Wrap" />
                                </Grid>
                            </Button>
                        </Grid>

                        <!--  Picked colour  -->
                        <Grid Grid.Row="1">
                            <ScrollViewer
                                x:Name="ResultPanel"
                                ctl:Tour.Key="Str_Tour_ScreenColorPicker_Result"
                                ctl:Tour.Order="4"
                                HorizontalScrollBarVisibility="Disabled"
                                VerticalScrollBarVisibility="Auto"
                                Visibility="Collapsed">
                                <Grid Height="{Binding ViewportHeight, ElementName=ResultPanel}" MinHeight="380">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition
                                            Width="*"
                                            MinWidth="240"
                                            MaxWidth="460" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="1.4*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <Border
                                            x:Name="SwatchBig"
                                            MinHeight="150"
                                            BorderBrush="{DynamicResource CardBorder}"
                                            BorderThickness="1"
                                            CornerRadius="14">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock
                                                    x:Name="TxtSwatchHex"
                                                    HorizontalAlignment="Center"
                                                    FontFamily="Consolas"
                                                    FontSize="34"
                                                    FontWeight="SemiBold" />
                                                <TextBlock
                                                    x:Name="TxtSwatchPos"
                                                    Margin="0,4,0,0"
                                                    HorizontalAlignment="Center"
                                                    FontSize="12"
                                                    Opacity="0.85" />
                                            </StackPanel>
                                        </Border>

                                        <!--  Text contrast on this colour  -->
                                        <StackPanel Grid.Row="1">
                                            <TextBlock
                                                Margin="0,14,0,6"
                                                FontSize="11.5"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource TextSecondary}"
                                                Text="{DynamicResource Str_ScreenColor_ContrastHeader}" />
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="8" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    x:Name="ChipWhite"
                                                    Padding="12,10"
                                                    BorderBrush="{DynamicResource CardBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="10">
                                                    <StackPanel>
                                                        <TextBlock
                                                            FontSize="18"
                                                            FontWeight="Bold"
                                                            Foreground="White"
                                                            Text="Aa" />
                                                        <TextBlock
                                                            x:Name="TxtWhiteRatio"
                                                            FontSize="11"
                                                            Foreground="White" />
                                                    </StackPanel>
                                                </Border>
                                                <Border
                                                    x:Name="ChipBlack"
                                                    Grid.Column="2"
                                                    Padding="12,10"
                                                    BorderBrush="{DynamicResource CardBorder}"
                                                    BorderThickness="1"
                                                    CornerRadius="10">
                                                    <StackPanel>
                                                        <TextBlock
                                                            FontSize="18"
                                                            FontWeight="Bold"
                                                            Foreground="Black"
                                                            Text="Aa" />
                                                        <TextBlock
                                                            x:Name="TxtBlackRatio"
                                                            FontSize="11"
                                                            Foreground="Black" />
                                                    </StackPanel>
                                                </Border>
                                            </Grid>
                                        </StackPanel>
                                    </Grid>

                                    <!--  Every way of writing it; the tiles are built in code  -->
                                    <UniformGrid
                                        x:Name="ValueRows"
                                        Grid.Column="2"
                                        Columns="2" />
                                </Grid>
                            </ScrollViewer>

                            <!--  Nothing picked yet  -->
                            <StackPanel
                                x:Name="EmptyState"
                                MaxWidth="420"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.Eyedropper}" />
                                <TextBlock
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimary}"
                                    Text="{DynamicResource Str_ScreenColor_EmptyTitle}" />
                                <TextBlock
                                    Margin="0,6,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{DynamicResource Str_ScreenColor_EmptyHint}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>

                        <!--  This session  -->
                        <Grid
                            x:Name="SessionPanel"
                            Grid.Row="2"
                            Margin="0,12,0,0">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,6">
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="11.5"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{DynamicResource Str_ScreenColor_SessionHeader}" />
                                <Button
                                    x:Name="BtnClearSession"
                                    Width="32"
                                    Height="32"
                                    HorizontalAlignment="Right"
                                    Click="BtnClearSession_Click"
                                    Style="{StaticResource ListToolDangerButtonStyle}"
                                    ToolTip="{DynamicResource Str_ScreenColor_ClearSession}"
                                    Visibility="Collapsed">
                                    <materialDesign:PackIcon
                                        Width="17"
                                        Height="17"
                                        Kind="PlaylistRemove" />
                                </Button>
                            </Grid>
                            <WrapPanel x:Name="SessionStrip" Grid.Row="1" />
                        </Grid>

                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
