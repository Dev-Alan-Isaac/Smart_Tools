<UserControl
    x:Class="Smart_Tools.WPF.Views.ColorPickerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    x:Name="Root"
    Loaded="Root_Loaded"
    PreviewKeyDown="Root_PreviewKeyDown">

    <!--
        Backend: Controllers/ColorManager.cs + ColorHistoryStore.cs and
        Models/ColorModel.cs. Code-behind only wires controls.
        Look & feel: shared view kit (Themes/Controls.xaml) + UiMotion.cs.
    -->

    <UserControl.Resources>

        <!--  Shade/tint block: stretches to fill its UniformGrid cell  -->
        <Style
            x:Key="ShadeButtonStyle"
            BasedOn="{StaticResource SwatchButtonStyle}"
            TargetType="Button">
            <Setter Property="Width" Value="Auto" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="2,0" />
        </Style>

        <!--  "HEX" / "RGB" / "HSL" row label  -->
        <Style x:Key="ValueLabel" TargetType="TextBlock">
            <Setter Property="Width" Value="40" />
            <Setter Property="VerticalAlignment" Value="Center" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>

        <Style
            x:Key="ChannelBox"
            BasedOn="{StaticResource BareTextBox}"
            TargetType="TextBox">
            <Setter Property="FontFamily" Value="Consolas" />
            <Setter Property="HorizontalContentAlignment" Value="Center" />
        </Style>

        <!--  Batch status chip, coloured from theme tokens by Status (enum)  -->
        <DataTemplate x:Key="BatchStatusChipTemplate">
            <Border
                x:Name="Chip"
                Padding="7,3,9,3"
                HorizontalAlignment="Left"
                Background="{DynamicResource StatusSuccessBg}"
                CornerRadius="8"
                ToolTip="{Binding Message}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon
                        x:Name="ChipIcon"
                        Width="13"
                        Height="13"
                        Margin="0,0,5,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource StatusSuccessFg}"
                        Kind="CheckCircleOutline" />
                    <TextBlock
                        x:Name="ChipText"
                        VerticalAlignment="Center"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource StatusSuccessFg}"
                        Text="{Binding Message}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusErrorBg}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="AlertCircleOutline" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">

        <!--  No page header: MainWindow's header card shows the tool's icon and name.  -->

        <Grid Margin="16,8,16,16">

            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OptionsColumn" Width="280" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= OPTIONS SIDEBAR =================  -->

            <Border Grid.Column="0" Style="{StaticResource SidebarPanelStyle}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Button
                            x:Name="BtnCollapseOptions"
                            MinHeight="45"
                            HorizontalContentAlignment="Left"
                            Click="BtnCollapseOptions_Click"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Foreground="{DynamicResource SidebarText}"
                            ToolTip="{DynamicResource Str_Common_SidebarToggleTooltip}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="OverridesDefaultStyle" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Margin="16,0,0,0" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Kind="TuneVariant" />
                                <TextBlock
                                    x:Name="TxtOptionsHeaderLabel"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{DynamicResource Str_Common_OptionsLabel}" />
                            </StackPanel>
                        </Button>

                        <Separator
                            x:Name="SepHeader"
                            Margin="16,4"
                            Style="{StaticResource SidebarSeparatorStyle}" />
                    </StackPanel>

                    <ScrollViewer
                        x:Name="OptionsScrollViewer"
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto">

                        <StackPanel Margin="16,4,16,16">

                            <!--  ============ MODE ============  -->
                            <Border x:Name="ModeTogglePanel" ctl:Tour.Key="Str_Tour_ColorPicker_Mode" ctl:Tour.Order="1" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Color_ModeHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.TuneVariant}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <RadioButton
                                            x:Name="RadioModeSingle"
                                            Grid.Column="0"
                                            Checked="RadioMode_Checked"
                                            GroupName="ColorMode"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            ToolTip="{DynamicResource Str_Color_ModeSingleTooltip}">
                                            <Grid HorizontalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon
                                                    Grid.Column="0"
                                                    Width="15"
                                                    Height="15"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Kind="EyedropperVariant" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_Common_ModeSingle}" TextWrapping="Wrap" />
                                            </Grid>
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="RadioModeBatch"
                                            Grid.Column="2"
                                            Checked="RadioMode_Checked"
                                            GroupName="ColorMode"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            ToolTip="{DynamicResource Str_Color_ModeBatchTooltip}">
                                            <Grid HorizontalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon
                                                    Grid.Column="0"
                                                    Width="15"
                                                    Height="15"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Kind="FormatListBulleted" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_Common_ModeBatch}" TextWrapping="Wrap" />
                                            </Grid>
                                        </RadioButton>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!--  ============ SINGLE: RECENT + FAVORITES ============  -->
                            <StackPanel x:Name="PanelSingleMode">

                                <Border Style="{StaticResource SidebarGroupCardStyle}">
                                    <StackPanel>
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <ContentControl
                                                Content="{DynamicResource Str_Color_RecentColorsHeader}"
                                                Style="{StaticResource SidebarGroupHeader}"
                                                Tag="{x:Static materialDesign:PackIconKind.History}" />
                                            <Button
                                                x:Name="BtnClearRecent"
                                                Grid.Column="1"
                                                Margin="0,0,0,10"
                                                VerticalAlignment="Center"
                                                Click="BtnClearRecent_Click"
                                                Style="{StaticResource ListToolDangerButtonStyle}"
                                                ToolTip="{DynamicResource Str_ColorPicker_ClearRecentColors}">
                                                <materialDesign:PackIcon
                                                    Width="16"
                                                    Height="16"
                                                    Kind="DeleteSweepOutline" />
                                            </Button>
                                        </Grid>

                                        <WrapPanel
                                            x:Name="RecentColorsPanel"
                                            Margin="3,3,0,0"
                                            ToolTip="{DynamicResource Str_Color_RecentColorsTooltip}" />

                                        <TextBlock
                                            x:Name="TxtRecentEmptyHint"
                                            FontSize="11"
                                            Foreground="{DynamicResource SidebarTextMuted}"
                                            Text="{DynamicResource Str_ColorPicker_ColorsYouPickShow}"
                                            TextWrapping="Wrap"
                                            Visibility="Collapsed" />
                                    </StackPanel>
                                </Border>

                                <Border ctl:Tour.Key="Str_Tour_ColorPicker_Favorites" ctl:Tour.Order="5" Style="{StaticResource SidebarGroupCardStyle}">
                                    <StackPanel>
                                        <ContentControl
                                            Content="{DynamicResource Str_Color_FavoritesHeader}"
                                            Style="{StaticResource SidebarGroupHeader}"
                                            Tag="{x:Static materialDesign:PackIconKind.Star}" />

                                        <WrapPanel
                                            x:Name="FavoritesPanel"
                                            Margin="3,3,0,0"
                                            ToolTip="{DynamicResource Str_Color_FavoritesTooltip}" />

                                        <TextBlock
                                            x:Name="TxtFavoritesEmptyHint"
                                            FontSize="11"
                                            Foreground="{DynamicResource SidebarTextMuted}"
                                            Text="{DynamicResource Str_ColorPicker_PressTheStarNext}"
                                            TextWrapping="Wrap"
                                            Visibility="Collapsed" />
                                    </StackPanel>
                                </Border>

                                <StackPanel Margin="4,2,0,0" Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="12"
                                        Height="12"
                                        Margin="0,0,5,0"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource SidebarTextMuted}"
                                        Kind="InformationOutline" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{DynamicResource SidebarTextMuted}"
                                        Text="{DynamicResource Str_ColorPicker_RightClickASwatch}" />
                                </StackPanel>
                            </StackPanel>

                            <!--  ============ BATCH: INPUT + EXPORT ============  -->
                            <StackPanel x:Name="PanelBatchMode" Visibility="Collapsed">

                                <!--  Colors written inside files  -->
                                <Border Style="{StaticResource SidebarGroupCardStyle}">
                                    <StackPanel>
                                        <ContentControl
                                            Content="{DynamicResource Str_Color_ScanHeader}"
                                            Style="{StaticResource SidebarGroupHeader}"
                                            Tag="{x:Static materialDesign:PackIconKind.FileSearchOutline}" />
                                        <TextBlock
                                            Margin="0,0,0,10"
                                            FontSize="11"
                                            Foreground="{DynamicResource SidebarTextMuted}"
                                            Text="{DynamicResource Str_Color_ScanIntro}"
                                            TextWrapping="Wrap" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="6" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Button
                                                x:Name="BtnScanFiles"
                                                Click="BtnScanFiles_Click"
                                                Style="{StaticResource AccentPrimaryButtonStyle}"
                                                ToolTip="{DynamicResource Str_Color_ScanFilesTooltip}">
                                                <Grid HorizontalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <materialDesign:PackIcon
                                                        Width="16"
                                                        Height="16"
                                                        Margin="0,0,6,0"
                                                        VerticalAlignment="Center"
                                                        Kind="FileSearchOutline" />
                                                    <TextBlock
                                                        Grid.Column="1"
                                                        VerticalAlignment="Center"
                                                        Text="{DynamicResource Str_Color_ScanFiles}"
                                                        TextWrapping="Wrap" />
                                                </Grid>
                                            </Button>
                                            <Button Padding="0"
                                                x:Name="BtnScanFolder"
                                                Grid.Column="2"
                                                Width="34"
                                                Height="34"
                                                Click="BtnScanFolder_Click"
                                                Style="{StaticResource NeutralIconButtonStyle}"
                                                ToolTip="{DynamicResource Str_Color_ScanFolderTooltip}">
                                                <materialDesign:PackIcon
                                                    Width="16"
                                                    Height="16"
                                                    Kind="FolderSearchOutline" />
                                            </Button>
                                        </Grid>
                                        <CheckBox
                                            x:Name="ChkUniqueColors"
                                            Margin="0,10,0,0"
                                            Click="ChkUniqueColors_Click"
                                            Content="{DynamicResource Str_Color_ScanUnique}"
                                            IsChecked="True"
                                            ToolTip="{DynamicResource Str_Color_ScanUniqueTooltip}"
                                            controls:ChoiceIcon.Kind="Palette"
                                            Style="{StaticResource ToggleChipCheckBoxStyle}" />
                                        <TextBlock
                                            Margin="0,8,0,0"
                                            FontSize="10.5"
                                            Foreground="{DynamicResource SidebarTextMuted}"
                                            Text="{DynamicResource Str_Color_ScanFormats}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource SidebarGroupCardStyle}">
                                    <StackPanel>
                                        <ContentControl
                                            Content="{DynamicResource Str_Color_BatchInputHeader}"
                                            Style="{StaticResource SidebarGroupHeader}"
                                            Tag="{x:Static materialDesign:PackIconKind.FormatListBulleted}" />

                                        <TextBox
                                            x:Name="TxtBatchInput"
                                            Height="110"
                                            Padding="8,6"
                                            VerticalContentAlignment="Top"
                                            AcceptsReturn="True"
                                            FontFamily="Consolas"
                                            FontSize="12"
                                            Tag="#FF0000&#10;0, 255, 0&#10;hsl(240, 100%, 50%)&#10;tomato"
                                            TextChanged="TxtBatchInput_TextChanged"
                                            TextWrapping="NoWrap"
                                            ToolTip="{DynamicResource Str_Color_BatchInputTooltip}"
                                            VerticalScrollBarVisibility="Auto" />

                                        <TextBlock
                                            x:Name="TxtBatchLineCount"
                                            Margin="0,4,0,8"
                                            HorizontalAlignment="Right"
                                            FontSize="11"
                                            Foreground="{DynamicResource SidebarTextMuted}"
                                            Text="{DynamicResource Str_ColorPicker_OneColorPerLine}" />

                                        <Button
                                            x:Name="BtnPasteBatch"
                                            MinHeight="30"
                                            Margin="0,0,0,10"
                                            Click="BtnPasteBatch_Click"
                                            ToolTip="{DynamicResource Str_ColorPicker_AddTheColorsOn}">
                                            <Grid HorizontalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon
                                                    Grid.Column="0"
                                                    Width="14"
                                                    Height="14"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Kind="ContentPaste" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_ColorPicker_Paste}" TextWrapping="Wrap" />
                                            </Grid>
                                        </Button>

                                        <Button
                                            x:Name="BtnConvertBatch"
                                            HorizontalAlignment="Stretch"
                                            Click="BtnConvertBatch_Click"
                                            Style="{StaticResource AccentPrimaryButtonStyle}"
                                            ToolTip="{DynamicResource Str_Color_ConvertAllTooltip}">
                                            <Grid HorizontalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon
                                                    Grid.Column="0"
                                                    Width="17"
                                                    Height="17"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Kind="PlayCircleOutline" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_Color_ConvertAll}" TextWrapping="Wrap" />
                                            </Grid>
                                        </Button>
                                        <TextBlock
                                            Margin="0,6,0,0"
                                            HorizontalAlignment="Center"
                                            FontSize="11"
                                            Foreground="{DynamicResource SidebarTextMuted}"
                                            Text="{DynamicResource Str_ColorPicker_CtrlEnter}" />
                                    </StackPanel>
                                </Border>

                                <Border Margin="0,0,0,4" Style="{StaticResource SidebarGroupCardStyle}">
                                    <StackPanel>
                                        <controls:ExportButton
                                            x:Name="BtnExportBatch"
                                            HorizontalAlignment="Stretch"
                                            IsEnabled="False"
                                            ToolTip="{DynamicResource Str_Color_ExportBatchTooltip}">
                                            <Button.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem
                                                        Click="MenuExport_Click"
                                                        Header="{DynamicResource Str_Common_ExportAsCsv}"
                                                        Tag="Csv">
                                                        <MenuItem.Icon>
                                                            <materialDesign:PackIcon Kind="FileDelimitedOutline" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem
                                                        Click="MenuExport_Click"
                                                        Header="{DynamicResource Str_Common_ExportAsJson}"
                                                        Tag="Json">
                                                        <MenuItem.Icon>
                                                            <materialDesign:PackIcon Kind="CodeJson" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                    <MenuItem
                                                        Click="MenuExport_Click"
                                                        Header="{DynamicResource Str_Common_ExportAsXml}"
                                                        Tag="Xml">
                                                        <MenuItem.Icon>
                                                            <materialDesign:PackIcon Kind="CodeTags" />
                                                        </MenuItem.Icon>
                                                    </MenuItem>
                                                </ContextMenu>
                                            </Button.ContextMenu>
                                        </controls:ExportButton>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--  ================= MAIN AREA =================  -->

            <Grid Grid.Column="2">

                <!--  ================= SINGLE MODE =================  -->
                <Grid x:Name="SingleModeArea">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="14" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" MinWidth="320" />
                        <ColumnDefinition Width="14" />
                        <ColumnDefinition Width="*" MinWidth="260" />
                    </Grid.ColumnDefinitions>

                    <!--  ========== Current color: swatch, values, contrast ==========  -->
                    <Border
                        Grid.Row="0"
                        Grid.ColumnSpan="3"
                        Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" MinWidth="240" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  Big swatch: floats on a shadow layer; shows "Aa" in the best text color  -->
                            <Grid Width="132" Height="132">
                                <!--  Shadow layer (no text inside, so the Effect can't blur anything)  -->
                                <Border
                                    Background="{DynamicResource CardBg}"
                                    CornerRadius="18"
                                    Effect="{DynamicResource CardElevation}" />
                                <Border
                                    x:Name="PreviewSwatch"
                                    Background="#FF6B6B"
                                    BorderBrush="{DynamicResource CardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="18"
                                    ToolTip="{DynamicResource Str_Color_PreviewSwatchTooltip}">
                                    <Grid>
                                        <TextBlock
                                            x:Name="TxtPreviewSample"
                                            Margin="14,10,0,0"
                                            FontSize="26"
                                            FontWeight="Bold"
                                            Foreground="Black"
                                            Text="Aa" />
                                        <TextBlock
                                            x:Name="TxtPreviewHex"
                                            Margin="14,0,0,12"
                                            VerticalAlignment="Bottom"
                                            FontFamily="Consolas"
                                            FontSize="13"
                                            FontWeight="SemiBold"
                                            Foreground="Black"
                                            Text="#FF6B6B" />
                                    </Grid>
                                </Border>
                            </Grid>

                            <!--  HEX / RGB / HSL  -->
                            <StackPanel Grid.Column="2" VerticalAlignment="Center">

                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock
                                        DockPanel.Dock="Left"
                                        Style="{StaticResource ValueLabel}"
                                        Text="{DynamicResource Str_ColorPicker_Hex}" />
                                    <Button
                                        x:Name="BtnCopyHex"
                                        Margin="6,0,0,0"
                                        Click="BtnCopyHex_Click"
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource ListToolButtonStyle}"
                                        ToolTip="{DynamicResource Str_Color_CopyHexTooltip}">
                                        <materialDesign:PackIcon
                                            Width="16"
                                            Height="16"
                                            Kind="ContentCopy" />
                                    </Button>
                                    <Border x:Name="HexBar" ctl:Tour.Key="Str_Tour_ColorPicker_Values" ctl:Tour.Order="3" Style="{StaticResource InputBarStyle}">
                                        <TextBox
                                            x:Name="TxtHex"
                                            FontFamily="Consolas"
                                            KeyDown="ColorField_KeyDown"
                                            LostFocus="TxtHex_LostFocus"
                                            Style="{StaticResource BareTextBox}"
                                            Tag="#RRGGBB, rgb(), hsl() or a name"
                                            ToolTip="{DynamicResource Str_Color_HexFieldTooltip}" />
                                    </Border>
                                </DockPanel>

                                <DockPanel Margin="0,0,0,8">
                                    <TextBlock
                                        DockPanel.Dock="Left"
                                        Style="{StaticResource ValueLabel}"
                                        Text="{DynamicResource Str_ColorWheel_ModeRgb}" />
                                    <Button
                                        x:Name="BtnCopyRgb"
                                        Margin="6,0,0,0"
                                        Click="BtnCopyRgb_Click"
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource ListToolButtonStyle}"
                                        ToolTip="{DynamicResource Str_Color_CopyRgbTooltip}">
                                        <materialDesign:PackIcon
                                            Width="16"
                                            Height="16"
                                            Kind="ContentCopy" />
                                    </Button>
                                    <Border x:Name="RgbBar" Style="{StaticResource InputBarStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox
                                                x:Name="TxtR"
                                                KeyDown="ColorField_KeyDown"
                                                LostFocus="RgbField_LostFocus"
                                                Style="{StaticResource ChannelBox}"
                                                Tag="R"
                                                ToolTip="{DynamicResource Str_Color_RedChannelTooltip}" />
                                            <Border Grid.Column="1" Style="{StaticResource InputBarDivider}" />
                                            <TextBox
                                                x:Name="TxtG"
                                                Grid.Column="2"
                                                KeyDown="ColorField_KeyDown"
                                                LostFocus="RgbField_LostFocus"
                                                Style="{StaticResource ChannelBox}"
                                                Tag="G"
                                                ToolTip="{DynamicResource Str_Color_GreenChannelTooltip}" />
                                            <Border Grid.Column="3" Style="{StaticResource InputBarDivider}" />
                                            <TextBox
                                                x:Name="TxtB"
                                                Grid.Column="4"
                                                KeyDown="ColorField_KeyDown"
                                                LostFocus="RgbField_LostFocus"
                                                Style="{StaticResource ChannelBox}"
                                                Tag="B"
                                                ToolTip="{DynamicResource Str_Color_BlueChannelTooltip}" />
                                        </Grid>
                                    </Border>
                                </DockPanel>

                                <DockPanel>
                                    <TextBlock
                                        DockPanel.Dock="Left"
                                        Style="{StaticResource ValueLabel}"
                                        Text="{DynamicResource Str_ColorWheel_ModeHsl}" />
                                    <Button
                                        x:Name="BtnCopyHsl"
                                        Margin="6,0,0,0"
                                        Click="BtnCopyHsl_Click"
                                        DockPanel.Dock="Right"
                                        Style="{StaticResource ListToolButtonStyle}"
                                        ToolTip="{DynamicResource Str_Color_CopyHslTooltip}">
                                        <materialDesign:PackIcon
                                            Width="16"
                                            Height="16"
                                            Kind="ContentCopy" />
                                    </Button>
                                    <Border x:Name="HslBar" Style="{StaticResource InputBarStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <TextBox
                                                x:Name="TxtH"
                                                KeyDown="ColorField_KeyDown"
                                                LostFocus="HslField_LostFocus"
                                                Style="{StaticResource ChannelBox}"
                                                Tag="H"
                                                ToolTip="{DynamicResource Str_Color_HueTooltip}" />
                                            <Border Grid.Column="1" Style="{StaticResource InputBarDivider}" />
                                            <TextBox
                                                x:Name="TxtS"
                                                Grid.Column="2"
                                                KeyDown="ColorField_KeyDown"
                                                LostFocus="HslField_LostFocus"
                                                Style="{StaticResource ChannelBox}"
                                                Tag="S"
                                                ToolTip="{DynamicResource Str_Color_SaturationTooltip}" />
                                            <Border Grid.Column="3" Style="{StaticResource InputBarDivider}" />
                                            <TextBox
                                                x:Name="TxtL"
                                                Grid.Column="4"
                                                KeyDown="ColorField_KeyDown"
                                                LostFocus="HslField_LostFocus"
                                                Style="{StaticResource ChannelBox}"
                                                Tag="L"
                                                ToolTip="{DynamicResource Str_Color_LightnessTooltip}" />
                                        </Grid>
                                    </Border>
                                </DockPanel>

                                <!--  One shared message line for all three rows  -->
                                <TextBlock
                                    x:Name="TxtFieldError"
                                    Margin="40,6,0,0"
                                    FontSize="11"
                                    Foreground="{DynamicResource StatusErrorFg}"
                                    TextWrapping="Wrap"
                                    Visibility="Collapsed" />

                                <!--  Kept for older string resources / code that references them  -->
                                <TextBlock
                                    x:Name="TxtHexError"
                                    Text="{DynamicResource Str_Color_InvalidHexError}"
                                    Visibility="Collapsed" />
                                <TextBlock
                                    x:Name="TxtRgbError"
                                    Text="{DynamicResource Str_Color_InvalidNumberError}"
                                    Visibility="Collapsed" />
                                <TextBlock
                                    x:Name="TxtHslError"
                                    Text="{DynamicResource Str_Color_InvalidNumberError}"
                                    Visibility="Collapsed" />
                            </StackPanel>

                            <!--  Favorite + contrast  -->
                            <StackPanel
                                Grid.Column="4"
                                MinWidth="170"
                                VerticalAlignment="Center">
                                <Button
                                    x:Name="BtnAddFavorite"
                                    ctl:Tour.Key="Str_Tour_ColorPicker_Favorite"
                                    ctl:Tour.Order="4"
                                    Margin="0,0,0,12"
                                    HorizontalAlignment="Stretch"
                                    Click="BtnAddFavorite_Click"
                                    Style="{StaticResource ListToolPrimaryButtonStyle}"
                                    ToolTip="{DynamicResource Str_Color_AddToFavoritesTooltip}">
                                    <Grid HorizontalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon
                                            Grid.Column="0"
                                            x:Name="IconFavorite"
                                            Width="16"
                                            Height="16"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            Kind="StarOutline" />
                                        <TextBlock
                                            Grid.Column="1"
                                            x:Name="TxtFavoriteLabel"
                                            VerticalAlignment="Center"
                                            Text="{DynamicResource Str_Color_AddToFavorites}" TextWrapping="Wrap" />
                                    </Grid>
                                </Button>

                                <TextBlock
                                    Margin="0,0,0,6"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{DynamicResource Str_ColorPicker_TextContrastWcag}" />

                                <!--  White text on the color  -->
                                <Border
                                    x:Name="ContrastWhiteTile"
                                    Margin="0,0,0,6"
                                    Padding="10,6"
                                    Background="#FF6B6B"
                                    CornerRadius="8"
                                    ToolTip="{DynamicResource Str_ColorPicker_WhiteTextOnThis}">
                                    <DockPanel>
                                        <Border
                                            x:Name="GradeWhitePill"
                                            Padding="6,1"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource StatusSuccessBg}"
                                            CornerRadius="6"
                                            DockPanel.Dock="Right">
                                            <TextBlock
                                                x:Name="TxtGradeWhite"
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource StatusSuccessFg}"
                                                Text="AA" />
                                        </Border>
                                        <TextBlock
                                            x:Name="TxtContrastWhite"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Foreground="White"
                                            Text="Aa  3.1:1" />
                                    </DockPanel>
                                </Border>

                                <!--  Black text on the color  -->
                                <Border
                                    x:Name="ContrastBlackTile"
                                    Padding="10,6"
                                    Background="#FF6B6B"
                                    CornerRadius="8"
                                    ToolTip="{DynamicResource Str_ColorPicker_BlackTextOnThis}">
                                    <DockPanel>
                                        <Border
                                            x:Name="GradeBlackPill"
                                            Padding="6,1"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource StatusSuccessBg}"
                                            CornerRadius="6"
                                            DockPanel.Dock="Right">
                                            <TextBlock
                                                x:Name="TxtGradeBlack"
                                                FontSize="11"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource StatusSuccessFg}"
                                                Text="AA" />
                                        </Border>
                                        <TextBlock
                                            x:Name="TxtContrastBlack"
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Foreground="Black"
                                            Text="Aa  6.8:1" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  ========== Visual picker + shades ==========  -->
                    <Border
                        Grid.Row="2"
                        Grid.Column="0"
                        Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" MinHeight="140" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <ContentControl
                                Margin="0,0,0,10"
                                Content="{DynamicResource Str_Color_VisualPickerTitle}"
                                Style="{StaticResource CardHeader}"
                                Tag="{x:Static materialDesign:PackIconKind.SelectColor}" />

                            <!--  Saturation (x) / brightness (y) square  -->
                            <Border
                                Grid.Row="1"
                                BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1"
                                CornerRadius="8">
                                <Grid
                                    x:Name="SvArea"
                                    ctl:Tour.Key="Str_Tour_ColorPicker_Picker"
                                    ctl:Tour.Order="2"
                                    Background="Transparent"
                                    ClipToBounds="True"
                                    Cursor="Cross"
                                    LostMouseCapture="SvArea_LostMouseCapture"
                                    MouseLeftButtonDown="SvArea_MouseLeftButtonDown"
                                    MouseLeftButtonUp="SvArea_MouseLeftButtonUp"
                                    MouseMove="SvArea_MouseMove"
                                    SizeChanged="PickerArea_SizeChanged"
                                    ToolTip="{DynamicResource Str_Color_SvAreaTooltip}">
                                    <Border x:Name="SvHueLayer" CornerRadius="8" />
                                    <Border CornerRadius="8">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                <GradientStop Offset="0" Color="#FFFFFFFF" />
                                                <GradientStop Offset="1" Color="#00FFFFFF" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <Border CornerRadius="8">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Offset="0" Color="#00000000" />
                                                <GradientStop Offset="1" Color="#FF000000" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>

                                    <!--  Cursor: white ring inside a soft dark ring, readable on any color  -->
                                    <Grid
                                        x:Name="SvCursor"
                                        Width="18"
                                        Height="18"
                                        HorizontalAlignment="Left"
                                        VerticalAlignment="Top"
                                        IsHitTestVisible="False">
                                        <Ellipse Stroke="#66000000" StrokeThickness="4" />
                                        <Ellipse
                                            Margin="1"
                                            Stroke="White"
                                            StrokeThickness="2.5" />
                                    </Grid>
                                </Grid>
                            </Border>

                            <!--  Hue bar  -->
                            <Grid
                                x:Name="HueArea"
                                Grid.Row="2"
                                Height="18"
                                Margin="0,12,0,0"
                                Background="Transparent"
                                Cursor="Hand"
                                LostMouseCapture="HueArea_LostMouseCapture"
                                MouseLeftButtonDown="HueArea_MouseLeftButtonDown"
                                MouseLeftButtonUp="HueArea_MouseLeftButtonUp"
                                MouseMove="HueArea_MouseMove"
                                SizeChanged="PickerArea_SizeChanged"
                                ToolTip="{DynamicResource Str_Color_HueAreaTooltip}">
                                <Border CornerRadius="8">
                                    <Border.Background>
                                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                            <GradientStop Offset="0.000" Color="#FF0000" />
                                            <GradientStop Offset="0.167" Color="#FFFF00" />
                                            <GradientStop Offset="0.333" Color="#00FF00" />
                                            <GradientStop Offset="0.500" Color="#00FFFF" />
                                            <GradientStop Offset="0.667" Color="#0000FF" />
                                            <GradientStop Offset="0.833" Color="#FF00FF" />
                                            <GradientStop Offset="1.000" Color="#FF0000" />
                                        </LinearGradientBrush>
                                    </Border.Background>
                                </Border>
                                <Grid
                                    x:Name="HueCursor"
                                    Width="12"
                                    Height="24"
                                    Margin="0,-3,0,0"
                                    HorizontalAlignment="Left"
                                    VerticalAlignment="Top"
                                    IsHitTestVisible="False">
                                    <Border
                                        BorderBrush="#66000000"
                                        BorderThickness="3"
                                        CornerRadius="6" />
                                    <Border
                                        Margin="1"
                                        BorderBrush="White"
                                        BorderThickness="2.5"
                                        CornerRadius="5" />
                                </Grid>
                            </Grid>

                            <!--  Shades & tints of the current hue  -->
                            <StackPanel Grid.Row="3" Margin="0,14,0,0">
                                <TextBlock
                                    Margin="0,0,0,6"
                                    FontSize="11"
                                    FontWeight="Bold"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{DynamicResource Str_ColorPicker_ShadesAmpTints}" />
                                <UniformGrid
                                    x:Name="ShadesPanel"
                                    Margin="-2,0"
                                    Rows="1" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  ========== Eyedropper ==========  -->
                    <Border
                        Grid.Row="2"
                        Grid.Column="2"
                        Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentControl
                                    Content="{DynamicResource Str_Color_EyedropperTitle}"
                                    Style="{StaticResource CardHeader}"
                                    Tag="{x:Static materialDesign:PackIconKind.Eyedropper}" />
                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                    <Button Padding="0"
                                        x:Name="BtnPasteImage"
                                        Width="30"
                                        Height="30"
                                        Margin="0,0,4,0"
                                        Click="BtnPasteImage_Click"
                                        Style="{StaticResource NeutralIconButtonStyle}"
                                        ToolTip="{DynamicResource Str_ColorPicker_PasteAnImageFrom}">
                                        <materialDesign:PackIcon
                                            Width="15"
                                            Height="15"
                                            Kind="ContentPaste" />
                                    </Button>
                                    <Button
                                        x:Name="BtnLoadImage"
                                        Click="BtnLoadImage_Click"
                                        ToolTip="{DynamicResource Str_Color_LoadImageTooltip}">
                                        <Grid HorizontalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon
                                                Grid.Column="0"
                                                Width="14"
                                                Height="14"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Kind="ImagePlus" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_Color_LoadImage}" TextWrapping="Wrap" />
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!--  Drop target + image  -->
                            <Border
                                x:Name="EyedropperDropArea"
                                Grid.Row="1"
                                AllowDrop="True"
                                Background="{DynamicResource RowBg}"
                                CornerRadius="8"
                                DragEnter="EyedropperDropArea_DragEnter"
                                DragLeave="EyedropperDropArea_DragLeave"
                                DragOver="EyedropperDropArea_DragOver"
                                Drop="EyedropperDropArea_Drop">
                                <Grid>
                                    <Image
                                        x:Name="EyedropperImage"
                                        Margin="6"
                                        Cursor="Cross"
                                        MouseLeave="EyedropperImage_MouseLeave"
                                        MouseLeftButtonDown="EyedropperImage_MouseLeftButtonDown"
                                        MouseMove="EyedropperImage_MouseMove"
                                        Stretch="Uniform"
                                        ToolTip="{DynamicResource Str_Color_EyedropperImageTooltip}" />

                                    <!--  Empty state with a dashed drop target  -->
                                    <Grid x:Name="EyedropperEmptyState" IsHitTestVisible="False">
                                        <Rectangle
                                            Margin="1"
                                            RadiusX="10"
                                            RadiusY="10"
                                            Stroke="{DynamicResource CardBorder}"
                                            StrokeDashArray="5 4"
                                            StrokeThickness="1.5" />
                                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.ImageOutline}" />
                                            <TextBlock
                                                MaxWidth="240"
                                                Margin="0,12,0,0"
                                                HorizontalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{DynamicResource TextSecondary}"
                                                Text="{DynamicResource Str_Color_EyedropperEmptyHint}"
                                                TextAlignment="Center"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                HorizontalAlignment="Center"
                                                FontSize="11"
                                                Foreground="{DynamicResource TextSecondary}"
                                                Opacity="0.8"
                                                Text="{DynamicResource Str_ColorPicker_DropAnImageHere}" />
                                        </StackPanel>
                                    </Grid>

                                    <!--  Drag hover highlight  -->
                                    <Border
                                        x:Name="EyedropperDropHighlight"
                                        IsHitTestVisible="False"
                                        Style="{StaticResource DropZoneStyle}">
                                        <Rectangle
                                            RadiusX="10"
                                            RadiusY="10"
                                            Stroke="{DynamicResource AccentColor}"
                                            StrokeDashArray="6 4"
                                            StrokeThickness="2" />
                                    </Border>

                                    <!--  Magnifier loupe: pixel-level zoom with a crosshair on the pixel a click picks  -->
                                    <Popup
                                        x:Name="MagnifierPopup"
                                        AllowsTransparency="True"
                                        IsHitTestVisible="False"
                                        Placement="Relative"
                                        PlacementTarget="{Binding ElementName=EyedropperImage}"
                                        PopupAnimation="None"
                                        StaysOpen="True">
                                        <Border
                                            Padding="6"
                                            Background="{DynamicResource CardBg}"
                                            BorderBrush="{DynamicResource CardBorder}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                            <StackPanel>
                                                <Border
                                                    Width="150"
                                                    Height="150"
                                                    ClipToBounds="True"
                                                    CornerRadius="6">
                                                    <Grid>
                                                        <Image
                                                            x:Name="MagnifierImage"
                                                            Width="150"
                                                            Height="150"
                                                            RenderOptions.BitmapScalingMode="NearestNeighbor"
                                                            Stretch="Fill" />
                                                        <Canvas>
                                                            <Rectangle
                                                                x:Name="MagnifierCrosshair"
                                                                Fill="Transparent"
                                                                IsHitTestVisible="False"
                                                                Stroke="White"
                                                                StrokeThickness="2" />
                                                        </Canvas>
                                                    </Grid>
                                                </Border>
                                                <StackPanel
                                                    Margin="0,6,0,0"
                                                    HorizontalAlignment="Center"
                                                    Orientation="Horizontal">
                                                    <Border
                                                        x:Name="MagnifierSwatch"
                                                        Width="14"
                                                        Height="14"
                                                        Margin="0,0,6,0"
                                                        VerticalAlignment="Center"
                                                        BorderBrush="{DynamicResource CardBorder}"
                                                        BorderThickness="1"
                                                        CornerRadius="4" />
                                                    <TextBlock
                                                        x:Name="TxtMagnifierInfo"
                                                        VerticalAlignment="Center"
                                                        FontFamily="Consolas"
                                                        FontSize="11"
                                                        Foreground="{DynamicResource TextPrimary}"
                                                        Text="{DynamicResource Str_ColorPicker_Ffffff}" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Border>
                                    </Popup>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>

                <!--  ================= BATCH MODE =================  -->
                <Border
                    x:Name="BatchModeArea"
                    AllowDrop="True"
                    DragOver="BatchArea_DragOver"
                    Drop="BatchArea_Drop"
                    Style="{StaticResource CardStyle}"
                    Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentControl
                                Content="{DynamicResource Str_Common_BatchResultsTitle}"
                                Style="{StaticResource CardHeader}"
                                Tag="{x:Static materialDesign:PackIconKind.ViewGridOutline}" />
                            <Border
                                x:Name="SummaryPill"
                                Grid.Column="1"
                                VerticalAlignment="Center"
                                Background="{DynamicResource StatusSuccessBg}"
                                Style="{StaticResource IconStatusPillStyle}"
                                ToolTip="{DynamicResource Str_Color_BatchResultsPillTooltip}"
                                Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="13"
                                        Height="13"
                                        Margin="0,0,5,0"
                                        VerticalAlignment="Center"
                                        Foreground="{Binding Foreground, ElementName=TxtSummaryCount}"
                                        Kind="CheckAll" />
                                    <TextBlock
                                        x:Name="TxtSummaryCount"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource StatusSuccessFg}"
                                        Text="{DynamicResource Str_Color_BatchResultsPillInitial}" />
                                </StackPanel>
                            </Border>
                            <Border
                                x:Name="FailedPill"
                                Grid.Column="2"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource StatusErrorBg}"
                                Style="{StaticResource IconStatusPillStyle}"
                                ToolTip="{DynamicResource Str_ColorPicker_LinesThatCouldnT}"
                                Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="13"
                                        Height="13"
                                        Margin="0,0,5,0"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource StatusErrorFg}"
                                        Kind="AlertCircleOutline" />
                                    <TextBlock
                                        x:Name="TxtFailedCount"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource StatusErrorFg}" />
                                </StackPanel>
                            </Border>
                        </Grid>

                        <DataGrid
                            x:Name="DataGridBatch"
                            Grid.Row="1"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            EnableRowVirtualization="True"
                            IsReadOnly="True"
                            MinRowHeight="38"
                            ToolTip="{DynamicResource Str_Color_BatchGridTooltip}"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn
                                    Width="46"
                                    CellStyle="{StaticResource CompactCellStyle}"
                                    Header="">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border
                                                Width="24"
                                                Height="24"
                                                Background="{Binding SwatchHex}"
                                                BorderBrush="{DynamicResource CardBorder}"
                                                BorderThickness="1"
                                                CornerRadius="6" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn
                                    ElementStyle="{StaticResource EllipsisCellTextStyle}"
                                    Width="2*"
                                    Binding="{Binding Input}"
                                    FontFamily="Consolas"
                                    Header="{DynamicResource Str_Common_ColHeaderInput}" />
                                <DataGridTextColumn
                                    ElementStyle="{StaticResource EllipsisCellTextStyle}"
                                    Width="1.5*"
                                    Binding="{Binding Source}"
                                    Header="{DynamicResource Str_Color_ColFoundIn}" />
                                <DataGridTextColumn
                                    ElementStyle="{StaticResource EllipsisCellTextStyle}"
                                    Width="*"
                                    Binding="{Binding Hex}"
                                    FontFamily="Consolas"
                                    Header="{DynamicResource Str_ColorPicker_Hex}" />
                                <DataGridTextColumn
                                    ElementStyle="{StaticResource EllipsisCellTextStyle}"
                                    Width="*"
                                    Binding="{Binding Rgb}"
                                    Header="{DynamicResource Str_ColorWheel_ModeRgb}" />
                                <DataGridTextColumn
                                    ElementStyle="{StaticResource EllipsisCellTextStyle}"
                                    Width="1.3*"
                                    Binding="{Binding Hsl}"
                                    Header="{DynamicResource Str_ColorWheel_ModeHsl}" />
                                <DataGridTemplateColumn
                                    Width="1.6*"
                                    CellTemplate="{StaticResource BatchStatusChipTemplate}"
                                    Header="{DynamicResource Str_Common_ColHeaderStatus}"
                                    SortMemberPath="Status" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel
                            x:Name="BatchEmptyStatePanel"
                            Grid.Row="1"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                            <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.PaletteSwatchOutline}" />
                            <TextBlock
                                MaxWidth="340"
                                Margin="0,12,0,0"
                                HorizontalAlignment="Center"
                                FontSize="12.5"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="{DynamicResource Str_Color_BatchEmptyHint}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
