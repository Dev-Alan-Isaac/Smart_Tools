<UserControl
    x:Class="Smart_Tools.WPF.Views.ContrastCheckerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:models="clr-namespace:Smart_Tools.WPF.Controllers"
    x:Name="Root"
    Focusable="True"
    Loaded="Root_Loaded"
    Unloaded="Root_Unloaded">

    <!--  Backend: Controllers/ContrastCheckerManager.cs (table + fix finder) on top of ColorManager. UI only here.  -->

    <UserControl.Resources>
        <Style x:Key="CcLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <Style x:Key="PairGroupLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextMuted}" />
            <Setter Property="Margin" Value="2,10,0,6" />
        </Style>

        <!--  A ready-made pair in the sidebar: shows "Aa" in its own colors.  -->
        <Style x:Key="PairChip" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,6,6" />
            <Setter Property="Width" Value="58" />
            <Setter Property="Height" Value="40" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="{TemplateBinding Background}" BorderBrush="{DynamicResource SidebarInputBorder}" BorderThickness="1" CornerRadius="8">
                            <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="15" FontWeight="Bold" Foreground="{TemplateBinding Foreground}" Text="Aa" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  A color box you can click to open the color window  -->
        <Style x:Key="SwatchBox" TargetType="Border">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="0,0,8,0" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Cursor" Value="Hand" />
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                    <Setter Property="BorderThickness" Value="2" />
                </Trigger>
            </Style.Triggers>
        </Style>

        <DataTemplate x:Key="CheckTemplate" DataType="{x:Type models:ContrastCheck}">
            <Grid Margin="0,5">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="80" />
                </Grid.ColumnDefinitions>
                <TextBlock VerticalAlignment="Center" FontSize="13" Foreground="{DynamicResource TextPrimary}" Text="{Binding Label}" />
                <TextBlock Grid.Column="1" Margin="12,0,16,0" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{Binding Needs}" />
                <Border x:Name="Pill" Grid.Column="2" HorizontalAlignment="Right" Padding="12,3" Background="{DynamicResource StatusErrorBg}" CornerRadius="10">
                    <TextBlock x:Name="PillText" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource StatusErrorFg}" Text="{DynamicResource Str_Palette_Fail}" />
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Pass}" Value="True">
                    <Setter TargetName="Pill" Property="Background" Value="{DynamicResource StatusSuccessBg}" />
                    <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource StatusSuccessFg}" />
                    <Setter TargetName="PillText" Property="Text" Value="{DynamicResource Str_Palette_Pass}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">
        <Grid Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= OPTIONS SIDEBAR =================  -->
            <controls:ToolSidebar>
                <StackPanel>
<Border ctl:Tour.Key="Str_Tour_ContrastChecker_Pairs" ctl:Tour.Order="1" Margin="0,0,0,10" Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl Content="{DynamicResource Str_ContrastChecker_QuickPairs}" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.PaletteSwatchOutline}" />

                            <!--  Ready-made pairs by use (built in code), then the user's own  -->
                            <StackPanel x:Name="PairGroups" />

                            <Grid Margin="0,2,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock VerticalAlignment="Bottom" Style="{StaticResource PairGroupLabel}" Text="{DynamicResource Str_ContrastChecker_GroupYours}" />
                                <Button Padding="0" x:Name="BtnSavePair" Grid.Column="1" Width="28" Height="28" Margin="0,8,0,0" Click="BtnSavePair_Click" Style="{StaticResource NeutralIconButtonStyle}" ToolTip="{DynamicResource Str_ContrastChecker_SavePairTooltip}">
                                    <materialDesign:PackIcon Width="15" Height="15" Kind="PlusCircleOutline" />
                                </Button>
                            </Grid>
                            <WrapPanel x:Name="CustomPairPanel" />
                            <TextBlock x:Name="TxtCustomHint" Margin="2,0,0,0" FontSize="10.5" Foreground="{DynamicResource SidebarTextMuted}" TextWrapping="Wrap" Text="{DynamicResource Str_ContrastChecker_YoursHint}" />

                            <TextBlock Margin="2,10,0,0" FontSize="10.5" Foreground="{DynamicResource SidebarTextMuted}" TextWrapping="Wrap" Text="{DynamicResource Str_ContrastChecker_ClickAPairTo}" />
                        </StackPanel>
                    </Border>

                    <Border ctl:Tour.Key="Str_Tour_ContrastChecker_Rules" ctl:Tour.Order="2" Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl Content="{DynamicResource Str_ContrastChecker_WhatPasses}" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.InformationOutline}" />
<Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource AccentColor}" CornerRadius="9">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10.5" FontWeight="Bold" Foreground="White" Text="1" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource SidebarText}" TextWrapping="Wrap" Text="{DynamicResource Str_ContrastChecker_Walk1Title}" />
                                    <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource SidebarTextMuted}" TextWrapping="Wrap" Text="{DynamicResource Str_ContrastChecker_Walk1Body}" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource AccentColor}" CornerRadius="9">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10.5" FontWeight="Bold" Foreground="White" Text="2" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource SidebarText}" TextWrapping="Wrap" Text="{DynamicResource Str_ContrastChecker_Walk2Title}" />
                                    <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource SidebarTextMuted}" TextWrapping="Wrap" Text="{DynamicResource Str_ContrastChecker_Walk2Body}" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource AccentColor}" CornerRadius="9">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10.5" FontWeight="Bold" Foreground="White" Text="3" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource SidebarText}" TextWrapping="Wrap" Text="{DynamicResource Str_ContrastChecker_Walk3Title}" />
                                    <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource SidebarTextMuted}" TextWrapping="Wrap" Text="{DynamicResource Str_ContrastChecker_Walk3Body}" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource AccentColor}" CornerRadius="9">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10.5" FontWeight="Bold" Foreground="White" Text="4" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource SidebarText}" TextWrapping="Wrap" Text="{DynamicResource Str_ContrastChecker_Walk4Title}" />
                                    <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource SidebarTextMuted}" TextWrapping="Wrap" Text="{DynamicResource Str_ContrastChecker_Walk4Body}" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,10,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Border Width="18" Height="18" HorizontalAlignment="Left" VerticalAlignment="Top" Background="{DynamicResource AccentColor}" CornerRadius="9">
                                    <TextBlock HorizontalAlignment="Center" VerticalAlignment="Center" FontSize="10.5" FontWeight="Bold" Foreground="White" Text="5" />
                                </Border>
                                <StackPanel Grid.Column="1">
                                    <TextBlock FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource SidebarText}" TextWrapping="Wrap" Text="{DynamicResource Str_ContrastChecker_Walk5Title}" />
                                    <TextBlock Margin="0,2,0,0" FontSize="11" Foreground="{DynamicResource SidebarTextMuted}" TextWrapping="Wrap" Text="{DynamicResource Str_ContrastChecker_Walk5Body}" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                </StackPanel>
            </controls:ToolSidebar>

            <!--  ================= MAIN AREA =================  -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="320" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="*" MinWidth="320" />
                </Grid.ColumnDefinitions>

                <!--  ========== The two colors and the result ==========  -->
                <Border Grid.ColumnSpan="3" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="*" MinWidth="260" />
                            <ColumnDefinition Width="18" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  The pair as a tile  -->
                        <Grid Width="132" Height="132">
                            <Border Background="{DynamicResource CardBg}" CornerRadius="18" Effect="{DynamicResource CardElevation}" />
                            <Border x:Name="HeroTile" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="18">
                                <Grid>
                                    <TextBlock x:Name="HeroSample" Margin="14,10,0,0" FontSize="36" FontWeight="Bold" Text="Aa" />
                                    <TextBlock x:Name="HeroSmall" Margin="14,0,0,12" VerticalAlignment="Bottom" FontFamily="Consolas" FontSize="12" FontWeight="SemiBold" Text="{DynamicResource Str_ContrastChecker_TextOnBackground}" />
                                </Grid>
                            </Border>
                        </Grid>

                        <!--  The two boxes  -->
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="52" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="10" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <TextBlock Style="{StaticResource CcLabel}" Text="{DynamicResource Str_FileDiff_ColHeaderText}" />
                                <Border x:Name="SwatchFg" Grid.Column="1" MouseLeftButtonUp="SwatchFg_Click" Style="{StaticResource SwatchBox}" ToolTip="{DynamicResource Str_ContrastChecker_ClickToOpenThe}" />
                                <Border Grid.Column="2" Style="{StaticResource InputBarStyle}">
                                    <TextBox x:Name="TxtFg" VerticalContentAlignment="Center" FontFamily="Consolas" Style="{StaticResource BareTextBox}" TextChanged="Color_TextChanged" ToolTip="#RRGGBB, rgb(), hsl() or a name like tomato" />
                                </Border>

                                <TextBlock Grid.Row="2" Style="{StaticResource CcLabel}" Text="{DynamicResource Str_Common_Back}" />
                                <Border x:Name="SwatchBg" Grid.Row="2" Grid.Column="1" MouseLeftButtonUp="SwatchBg_Click" Style="{StaticResource SwatchBox}" ToolTip="{DynamicResource Str_ContrastChecker_ClickToOpenThe}" />
                                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource InputBarStyle}">
                                    <TextBox x:Name="TxtBg" VerticalContentAlignment="Center" FontFamily="Consolas" Style="{StaticResource BareTextBox}" TextChanged="Color_TextChanged" ToolTip="#RRGGBB, rgb(), hsl() or a name like white" />
                                </Border>

                                <Button x:Name="BtnSwap" Grid.RowSpan="3" Grid.Column="3" Width="34" Height="34" Margin="8,0,0,0" Click="BtnSwap_Click" Style="{StaticResource ListToolButtonStyle}" ToolTip="{DynamicResource Str_ContrastChecker_SwapTheTwoColors}">
                                    <materialDesign:PackIcon Width="16" Height="16" Kind="SwapVertical" />
                                </Button>
                            </Grid>
                            <TextBlock x:Name="TxtColorError" Margin="0,8,0,0" FontSize="11" Foreground="{DynamicResource StatusErrorFg}" TextWrapping="Wrap" />
                        </StackPanel>

                        <!--  The ratio  -->
                        <StackPanel Grid.Column="4" MinWidth="190" VerticalAlignment="Center">
                            <TextBlock FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource Str_ContrastChecker_ContrastRatio}" />
                            <TextBlock x:Name="TxtRatio" Margin="0,2,0,0" FontSize="40" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                            <TextBlock x:Name="TxtVerdict" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentColor}" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  ========== Live preview ==========  -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <ContentControl Margin="0,0,0,10" Content="{DynamicResource Str_ContrastChecker_LivePreview}" Style="{StaticResource CardHeader}" Tag="{x:Static materialDesign:PackIconKind.FormatText}" />
                        <Border ctl:Tour.Key="Str_Tour_ContrastChecker_Preview" ctl:Tour.Order="3" x:Name="Preview" Grid.Row="1" Padding="28" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="12">
                            <ScrollViewer VerticalScrollBarVisibility="Auto">
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock x:Name="PreviewLarge" FontSize="34" FontWeight="Bold" Text="{DynamicResource Str_ContrastChecker_LargeTextSample}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="PreviewNormal" Margin="0,14,0,0" FontSize="16" Text="{DynamicResource Str_ContrastChecker_NormalTextSampleThe}" TextWrapping="Wrap" />
                                    <TextBlock x:Name="PreviewSmall" Margin="0,12,0,0" FontSize="12" Text="{DynamicResource Str_ContrastChecker_SmallPrintSampleThe}" TextWrapping="Wrap" />
                                    <Border x:Name="PreviewButton" Margin="0,22,0,0" Padding="18,9" HorizontalAlignment="Left" BorderThickness="2" CornerRadius="8">
                                        <TextBlock x:Name="PreviewButtonText" FontSize="14" FontWeight="SemiBold" Text="{DynamicResource Str_ContrastChecker_AButtonOrField}" />
                                    </Border>
                                </StackPanel>
                            </ScrollViewer>
                        </Border>
                    </Grid>
                </Border>

                <!--  ========== WCAG table and fixes ==========  -->
                <Border Grid.Row="2" Grid.Column="2" Style="{StaticResource CardStyle}">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <ContentControl Margin="0,0,0,6" Content="{DynamicResource Str_ContrastChecker_WcagChecks}" Style="{StaticResource CardHeader}" Tag="{x:Static materialDesign:PackIconKind.ShieldCheckOutline}" />
                            <TextBlock x:Name="TxtExplain" Margin="0,0,0,12" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />

                            <!--  Where the pair sits between 1 : 1 and 21 : 1 (log scale, so the 3, 4.5 and 7 steps are easy to see)  -->
                            <Grid Height="26" Margin="0,0,0,2">
                                <Border Height="14" VerticalAlignment="Center" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" ClipToBounds="True" CornerRadius="7">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36*" />
                                            <ColumnDefinition Width="13.4*" />
                                            <ColumnDefinition Width="14.5*" />
                                            <ColumnDefinition Width="36.1*" />
                                        </Grid.ColumnDefinitions>
                                        <Border Background="{DynamicResource StatusErrorBg}" />
                                        <Border Grid.Column="1" Background="{DynamicResource StatusWarningBg}" />
                                        <Border Grid.Column="2" Background="{DynamicResource StatusSuccessBg}" />
                                        <Border Grid.Column="3" Background="{DynamicResource StatusSuccessFg}" Opacity="0.55" />
                                    </Grid>
                                </Border>
                                <Grid x:Name="ScaleMarkerHost" IsHitTestVisible="False" Visibility="Collapsed">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition x:Name="MarkLeft" Width="0.5*" />
                                        <ColumnDefinition x:Name="MarkRight" Width="0.5*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Width="5" Margin="0,0,-2.5,0" HorizontalAlignment="Right" Background="{DynamicResource TextPrimary}" BorderBrush="{DynamicResource CardBg}" BorderThickness="1" CornerRadius="3" />
                                </Grid>
                            </Grid>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36*" />
                                    <ColumnDefinition Width="13.4*" />
                                    <ColumnDefinition Width="14.5*" />
                                    <ColumnDefinition Width="36.1*" />
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <TextBlock HorizontalAlignment="Left" FontSize="10" Foreground="{DynamicResource TextSecondary}" Text="1" />
                                    <TextBlock HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource TextSecondary}" Text="3" />
                                </Grid>
                                <TextBlock Grid.Column="1" HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource TextSecondary}" Text="4.5" />
                                <TextBlock Grid.Column="2" HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource TextSecondary}" Text="7" />
                                <TextBlock Grid.Column="3" HorizontalAlignment="Right" FontSize="10" Foreground="{DynamicResource TextSecondary}" Text="21" />
                            </Grid>
                            <Grid Margin="0,2,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="36*" />
                                    <ColumnDefinition Width="13.4*" />
                                    <ColumnDefinition Width="14.5*" />
                                    <ColumnDefinition Width="36.1*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock HorizontalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource StatusErrorFg}" Text="{DynamicResource Str_Palette_Fail}" />
                                <TextBlock Grid.Column="1" HorizontalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource StatusWarningFg}" Text="{DynamicResource Str_ContrastChecker_ScaleLarge}" />
                                <TextBlock Grid.Column="2" HorizontalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource StatusSuccessFg}" Text="AA" />
                                <TextBlock Grid.Column="3" HorizontalAlignment="Center" FontSize="10.5" FontWeight="SemiBold" Foreground="{DynamicResource StatusSuccessFg}" Text="AAA" />
                            </Grid>

                            <ItemsControl ctl:Tour.Key="Str_Tour_ContrastChecker_Checks" ctl:Tour.Order="4" x:Name="CheckList" ItemTemplate="{StaticResource CheckTemplate}" />

                            <TextBlock Margin="0,20,0,6" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource Str_ContrastChecker_ClosestTextColorThat}" />
                            <Border Margin="0,0,0,8" Padding="10,8" Background="{DynamicResource RowBg}" CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="SwatchAa" Width="28" Height="28" Margin="0,0,10,0" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="7" />
                                    <TextBlock x:Name="TxtAa" Grid.Column="1" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" />
                                    <Button x:Name="BtnUseAa" Grid.Column="2" Click="BtnUseAa_Click" MinHeight="32" Content="{DynamicResource Str_ContrastChecker_UseIt}" />
                                </Grid>
                            </Border>
                            <Border Padding="10,8" Background="{DynamicResource RowBg}" CornerRadius="10">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="SwatchAaa" Width="28" Height="28" Margin="0,0,10,0" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="7" />
                                    <TextBlock x:Name="TxtAaa" Grid.Column="1" VerticalAlignment="Center" FontSize="12.5" Foreground="{DynamicResource TextPrimary}" />
                                    <Button x:Name="BtnUseAaa" Grid.Column="2" Click="BtnUseAaa_Click" MinHeight="32" Content="{DynamicResource Str_ContrastChecker_UseIt}" />
                                </Grid>
                            </Border>
                            <TextBlock Margin="0,10,0,0" FontSize="11" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" Text="{DynamicResource Str_ContrastChecker_OnlyTheLightnessOf}" />
                        </StackPanel>
                    </ScrollViewer>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
