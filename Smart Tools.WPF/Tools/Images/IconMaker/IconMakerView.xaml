<UserControl
    x:Class="Smart_Tools.WPF.Views.IconMakerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    x:Name="Root"
    Focusable="True"
    AllowDrop="True"
    DragOver="Root_DragOver"
    Drop="Root_Drop"
    Loaded="Root_Loaded"
    Unloaded="Root_Unloaded">

    <!--  Backend: Controllers/IconMakerManager.cs (resizing, .ico, favicon set). UI only here.  -->

    <UserControl.Resources>
        <Style x:Key="ImHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextMuted}" />
            <Setter Property="Margin" Value="2,6,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">
        <Grid Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= OPTIONS SIDEBAR =================  -->
            <controls:ToolSidebar>
                <StackPanel x:Name="SidebarStack">
                    <Border Margin="0,0,0,10" Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl Content="PICTURE" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.ImageOutline}" />
                            <Button Margin="0,8,0,0" MinHeight="36" HorizontalContentAlignment="Left" Click="BtnOpen_Click">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,6,0" Kind="FolderOpenOutline" />
                                    <TextBlock x:Name="TxtFileName" MaxWidth="170" Text="Choose a picture" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="TxtSourceInfo" Style="{StaticResource ImHint}" Text="Or drop a picture anywhere on this page. PNG, JPG, BMP, GIF, TIFF or ICO." />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,0,0,10" Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl Content="SHAPE" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.CropSquare}" />
                            <UniformGrid Margin="0,6,0,0" Columns="2">
                                <RadioButton x:Name="RadioFit" Margin="0,0,2,0" Click="Option_Click" Content="Fit" GroupName="ImFit" IsChecked="True" Style="{StaticResource ModeToggleButtonStyle}" />
                                <RadioButton x:Name="RadioFill" Margin="2,0,0,0" Click="Option_Click" Content="Fill" GroupName="ImFit" Style="{StaticResource ModeToggleButtonStyle}" />
                            </UniformGrid>
                            <TextBlock x:Name="TxtFitHint" Style="{StaticResource ImHint}" />
                        </StackPanel>
                    </Border>

                    <Border Margin="0,0,0,10" Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl Content="SIZES IN THE .ICO" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.ResizeBottomRight}" />
                            <WrapPanel Margin="0,8,0,0">
                                <CheckBox x:Name="Size16" Margin="0,0,14,6" Click="Option_Click" Content="16" Tag="16" />
                                <CheckBox x:Name="Size24" Margin="0,0,14,6" Click="Option_Click" Content="24" Tag="24" />
                                <CheckBox x:Name="Size32" Margin="0,0,14,6" Click="Option_Click" Content="32" Tag="32" />
                                <CheckBox x:Name="Size48" Margin="0,0,14,6" Click="Option_Click" Content="48" Tag="48" />
                                <CheckBox x:Name="Size64" Margin="0,0,14,6" Click="Option_Click" Content="64" Tag="64" />
                                <CheckBox x:Name="Size128" Margin="0,0,14,6" Click="Option_Click" Content="128" Tag="128" />
                                <CheckBox x:Name="Size256" Margin="0,0,14,6" Click="Option_Click" Content="256" Tag="256" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource ImHint}" Text="Windows picks the best size for each place it shows the icon. 16, 32, 48 and 256 cover most needs." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl Content="ZOOM" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.MagnifyPlusOutline}" />
                            <TextBlock Style="{StaticResource ImHint}" Text="Turn the mouse wheel over the icons to zoom in and out. Double-click an icon, or press Reset, to go back to real size." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </controls:ToolSidebar>

            <!--  ================= MAIN AREA =================  -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  ========== Source picture and saving ==========  -->
                <Border Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <DockPanel>
                            <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Orientation="Horizontal">
                                <Border x:Name="DonePill" Margin="0,0,10,0" VerticalAlignment="Center" Background="{DynamicResource StatusSuccessBg}" Style="{StaticResource IconStatusPillStyle}" Visibility="Collapsed">
                                    <TextBlock x:Name="TxtDonePill" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource StatusSuccessFg}" />
                                </Border>
                                <Button x:Name="BtnSet" MinHeight="38" Margin="0,0,8,0" Click="BtnSet_Click" IsEnabled="False" ToolTip="Save favicon.ico, the PNG sizes websites ask for, a manifest and the HTML lines">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,6,0" Kind="Web" />
                                        <TextBlock Text="Save favicon set" />
                                    </StackPanel>
                                </Button>
                                <Button x:Name="BtnIco" MinHeight="38" Click="BtnIco_Click" IsEnabled="False" Style="{StaticResource AccentPrimaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" Kind="ContentSaveOutline" />
                                        <TextBlock VerticalAlignment="Center" Text="Save .ico" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>

                            <Border Width="84" Height="84" Margin="0,0,16,0" DockPanel.Dock="Left" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="14">
                                <Grid>
                                    <materialDesign:PackIcon x:Name="HeroPlaceholder" Width="34" Height="34" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Kind="ImageOutline" />
                                    <Image x:Name="HeroImage" Margin="4" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform" />
                                </Grid>
                            </Border>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock FontSize="11" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Text="SOURCE PICTURE" />
                                <TextBlock x:Name="HeroName" Margin="0,2,0,0" FontSize="18" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Text="No picture yet" TextTrimming="CharacterEllipsis" />
                                <TextBlock x:Name="HeroInfo" Margin="0,2,0,0" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="Choose or drop a picture to see it at every icon size." />
                            </StackPanel>
                        </DockPanel>
                        <Border x:Name="StatusBanner" Margin="0,12,0,0" Padding="12,9" HorizontalAlignment="Left" CornerRadius="10" Visibility="Collapsed">
                            <TextBlock x:Name="TxtStatus" MaxWidth="900" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <!--  ========== One card per size (wheel = zoom) ==========  -->
                <Grid Grid.Row="2">
                    <ScrollViewer x:Name="PreviewScroll" HorizontalScrollBarVisibility="Auto" PreviewMouseWheel="Preview_MouseWheel" SizeChanged="PreviewScroll_SizeChanged" VerticalScrollBarVisibility="Auto">
                        <ItemsControl x:Name="PreviewList" Margin="0,0,4,4">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,14,14" MouseLeftButtonDown="Card_MouseLeftButtonDown" Style="{StaticResource CardStyle}">
                                        <StackPanel>
                                            <DockPanel Margin="0,0,0,10">
                                                <Button Width="30" Height="30" Margin="14,0,0,0" Click="BtnSavePng_Click" DockPanel.Dock="Right" Style="{StaticResource ListToolButtonStyle}" Tag="{Binding Size}" ToolTip="Save this size as a PNG">
                                                    <materialDesign:PackIcon Width="15" Height="15" Kind="ContentSaveOutline" />
                                                </Button>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Text="{Binding Label}" />
                                                    <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondary}" Text="{Binding Note}" />
                                                </StackPanel>
                                            </DockPanel>
                                            <Border Width="{Binding Box}" Height="{Binding Box}" HorizontalAlignment="Left" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6">
                                                <Border.Background>
                                                    <DrawingBrush TileMode="Tile" Viewport="0,0,12,12" ViewportUnits="Absolute">
                                                        <DrawingBrush.Drawing>
                                                            <DrawingGroup>
                                                                <GeometryDrawing Brush="{DynamicResource InputBg}"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,12,12" /></GeometryDrawing.Geometry></GeometryDrawing>
                                                                <GeometryDrawing Brush="{DynamicResource InputBorder}"><GeometryDrawing.Geometry><GeometryGroup><RectangleGeometry Rect="0,0,6,6" /><RectangleGeometry Rect="6,6,6,6" /></GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing>
                                                            </DrawingGroup>
                                                        </DrawingBrush.Drawing>
                                                    </DrawingBrush>
                                                </Border.Background>
                                                <Image Width="{Binding Display}" Height="{Binding Display}" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="NearestNeighbor" Source="{Binding Picture}" />
                                            </Border>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>

                    <!--  Zoom badge  -->
                    <Border x:Name="ZoomBadge" Margin="0,0,24,10" Padding="4" HorizontalAlignment="Right" VerticalAlignment="Bottom" Background="{DynamicResource CardBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="10" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock x:Name="TxtZoom" Margin="8,0,8,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="×1" />
                            <Button Width="28" Height="28" Click="BtnZoomReset_Click" Style="{StaticResource ListToolButtonStyle}" ToolTip="Back to real size">
                                <materialDesign:PackIcon Width="14" Height="14" Kind="MagnifyRemoveOutline" />
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border x:Name="PreviewEmpty" Style="{StaticResource CardStyle}">
                        <StackPanel MaxWidth="320" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.ImageSizeSelectActual}" />
                            <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="Choose a picture" />
                            <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="You will see it at every icon size here, each in its own card, exactly as it will be saved." TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
