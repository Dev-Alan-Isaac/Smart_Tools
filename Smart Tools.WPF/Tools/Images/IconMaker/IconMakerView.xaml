<UserControl
    x:Class="Smart_Tools.WPF.Views.IconMakerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    x:Name="Root"
    Focusable="True"
    AllowDrop="True"
    DragOver="Root_DragOver"
    Drop="Root_Drop"
    Loaded="Root_Loaded"
    Unloaded="Root_Unloaded">

    <!--  Backend: Controllers/IconMakerManager.cs (resizing, .ico, favicon set). UI only here.  -->

    <UserControl.Resources>
        <Style x:Key="ImLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarText}" />
            <Setter Property="Margin" Value="2,10,0,4" />
        </Style>
        <Style x:Key="ImHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextMuted}" />
            <Setter Property="Margin" Value="2,6,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">
        <Grid Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Border Style="{StaticResource SidebarPanelStyle}">
                <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                    <StackPanel x:Name="SidebarStack" Margin="16,12,16,16">
                        <Border Style="{StaticResource SidebarGroupCardStyle}">
                            <StackPanel>
                                <ContentControl Content="PICTURE" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.ImageOutline}" />
                                <Button Margin="0,8,0,0" HorizontalContentAlignment="Left" Click="BtnOpen_Click" Style="{StaticResource ListToolButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,6,0" Kind="FolderOpenOutline" />
                                        <TextBlock x:Name="TxtFileName" MaxWidth="190" Text="Choose a picture" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </Button>
                                <TextBlock x:Name="TxtSourceInfo" Style="{StaticResource ImHint}" Text="Or drop a picture anywhere on this page. PNG, JPG, BMP, GIF, TIFF or ICO." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SidebarGroupCardStyle}">
                            <StackPanel>
                                <ContentControl Content="SHAPE" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.CropSquare}" />
                                <UniformGrid Margin="0,6,0,0" Columns="2">
                                    <RadioButton x:Name="RadioFit" Margin="0,0,2,0" Click="Option_Click" Content="Fit" GroupName="ImFit" IsChecked="True" Style="{StaticResource ModeToggleButtonStyle}" />
                                    <RadioButton x:Name="RadioFill" Margin="2,0,0,0" Click="Option_Click" Content="Fill" GroupName="ImFit" Style="{StaticResource ModeToggleButtonStyle}" />
                                </UniformGrid>
                                <TextBlock x:Name="TxtFitHint" Style="{StaticResource ImHint}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SidebarGroupCardStyle}">
                            <StackPanel>
                                <ContentControl Content="SIZES IN THE .ICO" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.ResizeBottomRight}" />
                                <WrapPanel Margin="0,8,0,0">
                                    <CheckBox x:Name="Size16" Margin="0,0,14,6" Click="Option_Click" Content="16" Tag="16" />
                                    <CheckBox x:Name="Size24" Margin="0,0,14,6" Click="Option_Click" Content="24" Tag="24" />
                                    <CheckBox x:Name="Size32" Margin="0,0,14,6" Click="Option_Click" Content="32" Tag="32" />
                                    <CheckBox x:Name="Size48" Margin="0,0,14,6" Click="Option_Click" Content="48" Tag="48" />
                                    <CheckBox x:Name="Size64" Margin="0,0,14,6" Click="Option_Click" Content="64" Tag="64" />
                                    <CheckBox x:Name="Size128" Margin="0,0,14,6" Click="Option_Click" Content="128" Tag="128" />
                                    <CheckBox x:Name="Size256" Margin="0,0,14,6" Click="Option_Click" Content="256" Tag="256" />
                                </WrapPanel>
                                <TextBlock Style="{StaticResource ImHint}" Text="Windows picks the best size for each place it shows the icon. 16, 32, 48 and 256 cover most needs." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Border>

            <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentControl VerticalAlignment="Center" Content="Preview" Style="{StaticResource CardHeader}" Tag="{x:Static materialDesign:PackIconKind.ImageSizeSelectActual}" />
                        <Border x:Name="DonePill" Grid.Column="1" Margin="12,0,0,0" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource StatusSuccessBg}" Style="{StaticResource IconStatusPillStyle}" Visibility="Collapsed">
                            <TextBlock x:Name="TxtDonePill" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource StatusSuccessFg}" />
                        </Border>
                    </Grid>

                    <Border x:Name="StatusBanner" Grid.Row="1" Margin="0,0,0,10" Padding="12,9" HorizontalAlignment="Left" CornerRadius="10" Visibility="Collapsed">
                        <TextBlock x:Name="TxtStatus" MaxWidth="760" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                    </Border>

                    <Border Grid.Row="2" Background="{DynamicResource RowBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="12">
                        <Grid>
                            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="PreviewList" Margin="16">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate>
                                            <WrapPanel />
                                        </ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <StackPanel Margin="0,0,24,20">
                                                <Border Width="{Binding Box}" Height="{Binding Box}" HorizontalAlignment="Left" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1">
                                                    <Border.Background>
                                                        <DrawingBrush TileMode="Tile" Viewport="0,0,12,12" ViewportUnits="Absolute">
                                                            <DrawingBrush.Drawing>
                                                                <DrawingGroup>
                                                                    <GeometryDrawing Brush="{DynamicResource InputBg}"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,12,12" /></GeometryDrawing.Geometry></GeometryDrawing>
                                                                    <GeometryDrawing Brush="{DynamicResource InputBorder}"><GeometryDrawing.Geometry><GeometryGroup><RectangleGeometry Rect="0,0,6,6" /><RectangleGeometry Rect="6,6,6,6" /></GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing>
                                                                </DrawingGroup>
                                                            </DrawingBrush.Drawing>
                                                        </DrawingBrush>
                                                    </Border.Background>
                                                    <Image Width="{Binding Size}" Height="{Binding Size}" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="NearestNeighbor" Source="{Binding Picture}" />
                                                </Border>
                                                <TextBlock Margin="0,4,0,0" FontSize="11" Foreground="{DynamicResource TextSecondary}" Text="{Binding Label}" />
                                            </StackPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                            <StackPanel x:Name="PreviewEmpty" MaxWidth="300" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.ImageSizeSelectActual}" />
                                <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="Choose a picture" />
                                <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="You will see it at every icon size here, exactly as it will be saved." TextAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="3" Margin="0,12,0,0" HorizontalAlignment="Right" Orientation="Horizontal">
                        <Button x:Name="BtnSet" MinHeight="36" Margin="0,0,8,0" Click="BtnSet_Click" IsEnabled="False" Style="{StaticResource ListToolButtonStyle}" ToolTip="Save favicon.ico, the PNG sizes websites ask for, a manifest and the HTML lines">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,6,0" Kind="Web" />
                                <TextBlock Text="Save favicon set" />
                            </StackPanel>
                        </Button>
                        <Button x:Name="BtnIco" MinHeight="36" Click="BtnIco_Click" IsEnabled="False" Style="{StaticResource AccentPrimaryButtonStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" Kind="ContentSaveOutline" />
                                <TextBlock VerticalAlignment="Center" Text="Save .ico" />
                            </StackPanel>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
