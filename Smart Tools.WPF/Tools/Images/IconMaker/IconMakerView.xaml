<UserControl
    x:Class="Smart_Tools.WPF.Views.IconMakerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    x:Name="Root"
    Focusable="True"
    AllowDrop="True"
    DragOver="Root_DragOver"
    Drop="Root_Drop"
    Loaded="Root_Loaded"
    Unloaded="Root_Unloaded">

    <!--  Backend: Controllers/IconMakerManager.cs (resizing, .ico, favicon set). UI only here.  -->

    <UserControl.Resources>
        <Style x:Key="ImHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextMuted}" />
            <Setter Property="Margin" Value="2,6,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">
        <Grid Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= OPTIONS SIDEBAR =================  -->
            <controls:ToolSidebar>
                <StackPanel x:Name="SidebarStack">
                    <Border ctl:Tour.Key="Str_Tour_IconMaker_Picture" ctl:Tour.Order="1" Margin="0,0,0,10" Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl Content="{DynamicResource Str_BulkResize_ColName}" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.ImageOutline}" />
                            <Button Margin="0,8,0,0" MinHeight="36" HorizontalContentAlignment="Left" Click="BtnOpen_Click">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,6,0" Kind="FolderOpenOutline" />
                                    <TextBlock x:Name="TxtFileName" MaxWidth="170" Text="{DynamicResource Str_IconMaker_ChooseAPicture}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Button>
                            <TextBlock x:Name="TxtSourceInfo" Style="{StaticResource ImHint}" Text="{DynamicResource Str_IconMaker_OrDropAPicture}" />
                        </StackPanel>
                    </Border>

                    <Border ctl:Tour.Key="Str_Tour_IconMaker_Shape" ctl:Tour.Order="2" Margin="0,0,0,10" Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl Content="{DynamicResource Str_ImageEditor_Shape}" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.CropSquare}" />
                            <UniformGrid Margin="0,6,0,0" Columns="2">
                                <RadioButton x:Name="RadioFit" Margin="0,0,2,0" Click="Option_Click" Content="{DynamicResource Str_SvgTool_ZoomFitLabel}" GroupName="ImFit" IsChecked="True" Style="{StaticResource ModeToggleButtonStyle}" />
                                <RadioButton x:Name="RadioFill" Margin="2,0,0,0" Click="Option_Click" Content="{DynamicResource Str_IconMaker_Fill}" GroupName="ImFit" Style="{StaticResource ModeToggleButtonStyle}" />
                            </UniformGrid>
                            <TextBlock x:Name="TxtFitHint" Style="{StaticResource ImHint}" />
                        </StackPanel>
                    </Border>

                    <Border ctl:Tour.Key="Str_Tour_IconMaker_Sizes" ctl:Tour.Order="3" Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl Content="{DynamicResource Str_Rest_IcoSizes}" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.ResizeBottomRight}" />
                            <WrapPanel Margin="0,8,0,0">
                                <CheckBox x:Name="Size16" Click="Option_Click" Content="16" Style="{StaticResource ToggleChipCheckBoxStyle}" Tag="16" />
                                <CheckBox x:Name="Size24" Click="Option_Click" Content="24" Style="{StaticResource ToggleChipCheckBoxStyle}" Tag="24" />
                                <CheckBox x:Name="Size32" Click="Option_Click" Content="32" Style="{StaticResource ToggleChipCheckBoxStyle}" Tag="32" />
                                <CheckBox x:Name="Size48" Click="Option_Click" Content="48" Style="{StaticResource ToggleChipCheckBoxStyle}" Tag="48" />
                                <CheckBox x:Name="Size64" Click="Option_Click" Content="64" Style="{StaticResource ToggleChipCheckBoxStyle}" Tag="64" />
                                <CheckBox x:Name="Size128" Click="Option_Click" Content="128" Style="{StaticResource ToggleChipCheckBoxStyle}" Tag="128" />
                                <CheckBox x:Name="Size256" Click="Option_Click" Content="256" Style="{StaticResource ToggleChipCheckBoxStyle}" Tag="256" />
                            </WrapPanel>
                            <TextBlock Style="{StaticResource ImHint}" Text="{DynamicResource Str_IconMaker_WindowsPicksTheBest}" />
                        </StackPanel>
                    </Border>

                </StackPanel>
            </controls:ToolSidebar>

            <!--  ================= MAIN AREA =================  -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  ========== Slim bar: source picture and saving ==========  -->
                <Border x:Name="ActionBar" Padding="14,10" Style="{StaticResource CardStyle}">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" VerticalAlignment="Center" Orientation="Horizontal">
                            <Border x:Name="DonePill" Margin="0,0,10,0" VerticalAlignment="Center" Background="{DynamicResource StatusSuccessBg}" Style="{StaticResource IconStatusPillStyle}" Visibility="Collapsed">
                                <TextBlock x:Name="TxtDonePill" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource StatusSuccessFg}" />
                            </Border>
                            <Button x:Name="BtnSet" MinHeight="36" Margin="0,0,8,0" Click="BtnSet_Click" IsEnabled="False" ToolTip="{DynamicResource Str_IconMaker_SaveFaviconIcoThe}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,6,0" Kind="Web" />
                                    <TextBlock Text="{DynamicResource Str_IconMaker_SaveFaviconSet}" />
                                </StackPanel>
                            </Button>
                            <Button ctl:Tour.Key="Str_Tour_IconMaker_Save" ctl:Tour.Order="5" x:Name="BtnIco" MinHeight="36" Click="BtnIco_Click" IsEnabled="False" Style="{StaticResource AccentPrimaryButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" Kind="ContentSaveOutline" />
                                    <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_Rest_SaveIco}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>

                        <Border Width="48" Height="48" Margin="0,0,14,0" DockPanel.Dock="Left" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8">
                            <Grid>
                                <materialDesign:PackIcon x:Name="HeroPlaceholder" Width="22" Height="22" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Kind="ImageOutline" />
                                <Image x:Name="HeroImage" Margin="3" RenderOptions.BitmapScalingMode="HighQuality" Stretch="Uniform" />
                            </Grid>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="HeroName" FontSize="15" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource Str_IconMaker_NoPictureYet}" TextTrimming="CharacterEllipsis" />
                            <TextBlock x:Name="HeroInfo" Margin="0,1,0,0" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource Str_IconMaker_ChooseOrDropA}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!--  ========== Stage (the chosen size, fitted to the free space) + real-size column ==========  -->
                <Grid Grid.Row="1" Margin="0,14,0,0">
                    <Grid x:Name="PreviewArea" Visibility="Collapsed">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="240" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Border ctl:Tour.Key="Str_Tour_IconMaker_Preview" ctl:Tour.Order="4" Style="{StaticResource CardStyle}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="12" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <DockPanel>
                                    <Button Width="32" Height="32" Margin="12,0,0,0" Click="BtnSaveStage_Click" DockPanel.Dock="Right" Style="{StaticResource ListToolButtonStyle}" ToolTip="{DynamicResource Str_IconMaker_SaveThisSizeAs}">
                                        <materialDesign:PackIcon Width="16" Height="16" Kind="ContentSaveOutline" />
                                    </Button>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock x:Name="StageTitle" FontSize="14" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" />
                                        <TextBlock x:Name="StageNote" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DockPanel>
                                <Border Grid.Row="2" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="8" ClipToBounds="True">
                                    <Border.Background>
                                        <DrawingBrush TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
                                            <DrawingBrush.Drawing>
                                                <DrawingGroup>
                                                    <GeometryDrawing Brush="{DynamicResource InputBg}"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,16,16" /></GeometryDrawing.Geometry></GeometryDrawing>
                                                    <GeometryDrawing Brush="{DynamicResource InputBorder}"><GeometryDrawing.Geometry><GeometryGroup><RectangleGeometry Rect="0,0,8,8" /><RectangleGeometry Rect="8,8,8,8" /></GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing>
                                                </DrawingGroup>
                                            </DrawingBrush.Drawing>
                                        </DrawingBrush>
                                    </Border.Background>
                                    <Image x:Name="StageImage" Margin="24" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Uniform" />
                                </Border>
                            </Grid>
                        </Border>

                        <!--  Every ticked size at its real pixel size; click one to show it on the stage  -->
                        <Border Grid.Column="2" Padding="10" Style="{StaticResource CardStyle}">
                            <ScrollViewer HorizontalScrollBarVisibility="Disabled" VerticalScrollBarVisibility="Auto">
                                <ItemsControl x:Name="PreviewList" Margin="0,0,4,0">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border x:Name="Tile" Margin="0,0,0,8" Padding="10,8" Background="Transparent" BorderBrush="Transparent" BorderThickness="1.5" Cursor="Hand" CornerRadius="10" MouseLeftButtonDown="Tile_MouseLeftButtonDown" Tag="{Binding Size}">
                                                <DockPanel>
                                                    <Button Width="28" Height="28" Margin="10,0,0,0" VerticalAlignment="Top" Click="BtnSavePng_Click" DockPanel.Dock="Right" Style="{StaticResource ListToolButtonStyle}" Tag="{Binding Size}" ToolTip="{DynamicResource Str_IconMaker_SaveThisSizeAs}">
                                                        <materialDesign:PackIcon Width="14" Height="14" Kind="ContentSaveOutline" />
                                                    </Button>
                                                    <Border Width="{Binding Box}" Height="{Binding Box}" Margin="0,0,12,0" VerticalAlignment="Center" DockPanel.Dock="Left" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="4">
                                                        <Border.Background>
                                                            <DrawingBrush TileMode="Tile" Viewport="0,0,8,8" ViewportUnits="Absolute">
                                                                <DrawingBrush.Drawing>
                                                                    <DrawingGroup>
                                                                        <GeometryDrawing Brush="{DynamicResource InputBg}"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,8,8" /></GeometryDrawing.Geometry></GeometryDrawing>
                                                                        <GeometryDrawing Brush="{DynamicResource InputBorder}"><GeometryDrawing.Geometry><GeometryGroup><RectangleGeometry Rect="0,0,4,4" /><RectangleGeometry Rect="4,4,4,4" /></GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing>
                                                                    </DrawingGroup>
                                                                </DrawingBrush.Drawing>
                                                            </DrawingBrush>
                                                        </Border.Background>
                                                        <Image Width="{Binding Size}" Height="{Binding Size}" HorizontalAlignment="Center" VerticalAlignment="Center" RenderOptions.BitmapScalingMode="NearestNeighbor" Source="{Binding Picture}" />
                                                    </Border>
                                                    <StackPanel MinWidth="90" VerticalAlignment="Center">
                                                        <TextBlock FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Text="{Binding Label}" />
                                                        <TextBlock MaxWidth="140" FontSize="11" Foreground="{DynamicResource TextSecondary}" Text="{Binding Note}" TextWrapping="Wrap" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                            <DataTemplate.Triggers>
                                                <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                                    <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                                                    <Setter TargetName="Tile" Property="Background" Value="{DynamicResource AccentColorSubtle}" />
                                                </DataTrigger>
                                            </DataTemplate.Triggers>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </Border>
                    </Grid>

                    <Border x:Name="PreviewEmpty" Style="{StaticResource CardStyle}">
                        <StackPanel MaxWidth="320" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                            <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.ImageSizeSelectActual}" />
                            <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource Str_IconMaker_ChooseAPicture}" />
                            <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource Str_IconMaker_YouWillSeeIt}" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>

                <Border x:Name="StatusBanner" Grid.Row="1" Margin="0,24,0,0" Padding="12,9" HorizontalAlignment="Center" VerticalAlignment="Top" CornerRadius="10" Visibility="Collapsed">
                    <TextBlock x:Name="TxtStatus" MaxWidth="700" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
