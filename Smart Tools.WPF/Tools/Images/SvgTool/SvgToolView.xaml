<UserControl
    x:Class="Smart_Tools.WPF.Views.SvgToolView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    x:Name="Root"
    AllowDrop="True"
    IsVisibleChanged="Root_IsVisibleChanged"
    Loaded="Root_Loaded"
    PreviewDragLeave="Root_PreviewDragLeave"
    PreviewDragOver="Root_PreviewDragOver"
    PreviewDrop="Root_PreviewDrop"
    PreviewKeyDown="Root_PreviewKeyDown">

    <!--
        Backend: Controllers/SvgToolManager.cs (files, info, pages, settings) +
        Controllers/SvgOptimizer.cs (the optimizer); Models/SvgToolModel.cs. UI only here.
        The preview is a WebView2 created in code inside PreviewHost; the SVG is shown in an
        img element (so it can never run scripts), served from a virtual host.
        PNG export captures a page of the exact size through the DevTools protocol.
    -->

    <UserControl.Resources>
        <Style
            x:Key="ZoomButton"
            BasedOn="{StaticResource NeutralIconButtonStyle}"
            TargetType="Button">
            <Setter Property="Width" Value="30" />
            <Setter Property="Height" Value="30" />
            <Setter Property="Margin" Value="2,0,0,0" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">
        <Grid Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OptionsColumn" Width="280" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= OPTIONS SIDEBAR =================  -->
            <Border Grid.Column="0" Style="{StaticResource SidebarPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Button
                            x:Name="BtnCollapseOptions"
                            MinHeight="45"
                            HorizontalContentAlignment="Left"
                            Click="BtnCollapseOptions_Click"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Foreground="{DynamicResource SidebarText}"
                            ToolTip="{DynamicResource Str_Common_SidebarToggleTooltip}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="OverridesDefaultStyle" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Margin="16,0,0,0" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Kind="TuneVariant" />
                                <TextBlock
                                    x:Name="TxtOptionsHeaderLabel"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{DynamicResource Str_Common_OptionsLabel}" />
                            </StackPanel>
                        </Button>
                        <Separator
                            x:Name="SepHeader"
                            Margin="16,4"
                            Style="{StaticResource SidebarSeparatorStyle}" />
                    </StackPanel>

                    <ScrollViewer
                        x:Name="OptionsScrollViewer"
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16">

                            <!--  ============ BACKGROUND ============  -->
                            <Border ctl:Tour.Key="Str_Tour_SvgTool_Background" ctl:Tour.Order="1" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_SvgTool_BackgroundHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.ImageFilterBlackWhite}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <RadioButton
                                            x:Name="RadioBgLight"
                                            Grid.Column="0"
                                            Checked="Bg_Checked"
                                            Content="{DynamicResource Str_SvgTool_BgLight}"
                                            GroupName="SvgBg"
                                            Style="{StaticResource ModeToggleButtonStyle}" />
                                        <RadioButton
                                            x:Name="RadioBgDark"
                                            Grid.Column="2"
                                            Checked="Bg_Checked"
                                            Content="{DynamicResource Str_SvgTool_BgDark}"
                                            GroupName="SvgBg"
                                            Style="{StaticResource ModeToggleButtonStyle}" />
                                        <RadioButton
                                            x:Name="RadioBgChecker"
                                            Grid.Column="4"
                                            Checked="Bg_Checked"
                                            Content="{DynamicResource Str_SvgTool_BgChecker}"
                                            GroupName="SvgBg"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleButtonStyle}" />
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!--  ============ CLEAN UP ============  -->
                            <Border ctl:Tour.Key="Str_Tour_SvgTool_CleanUp" ctl:Tour.Order="2" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_SvgTool_CleanUpHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.Broom}" />
                                    <CheckBox
                                        x:Name="ChkStripComments"
                                        Margin="0"
                                        Checked="Option_Changed"
                                        Content="{DynamicResource Str_SvgTool_StripComments}"
                                        Foreground="{DynamicResource SidebarText}"
                                        IsChecked="True"
                                        Unchecked="Option_Changed" />
                                    <CheckBox
                                        x:Name="ChkStripMetadata"
                                        Margin="0,8,0,0"
                                        Checked="Option_Changed"
                                        Content="{DynamicResource Str_SvgTool_StripMetadata}"
                                        Foreground="{DynamicResource SidebarText}"
                                        IsChecked="True"
                                        ToolTip="{DynamicResource Str_SvgTool_StripMetadataTip}"
                                        Unchecked="Option_Changed" />
                                    <CheckBox
                                        x:Name="ChkStripTitleDesc"
                                        Margin="0,8,0,0"
                                        Checked="Option_Changed"
                                        Content="{DynamicResource Str_SvgTool_StripTitleDesc}"
                                        Foreground="{DynamicResource SidebarText}"
                                        ToolTip="{DynamicResource Str_SvgTool_StripTitleDescTip}"
                                        Unchecked="Option_Changed" />
                                    <CheckBox
                                        x:Name="ChkRemoveScripts"
                                        Margin="0,8,0,0"
                                        Checked="Option_Changed"
                                        Content="{DynamicResource Str_SvgTool_RemoveScripts}"
                                        Foreground="{DynamicResource SidebarText}"
                                        ToolTip="{DynamicResource Str_SvgTool_RemoveScriptsTip}"
                                        Unchecked="Option_Changed" />
                                    <CheckBox
                                        x:Name="ChkRemoveUnusedDefs"
                                        Margin="0,8,0,0"
                                        Checked="Option_Changed"
                                        Content="{DynamicResource Str_SvgTool_RemoveUnusedDefs}"
                                        Foreground="{DynamicResource SidebarText}"
                                        IsChecked="True"
                                        ToolTip="{DynamicResource Str_SvgTool_RemoveUnusedDefsTip}"
                                        Unchecked="Option_Changed" />
                                    <CheckBox
                                        x:Name="ChkRemoveUnusedIds"
                                        Margin="0,8,0,0"
                                        Checked="Option_Changed"
                                        Content="{DynamicResource Str_SvgTool_RemoveUnusedIds}"
                                        Foreground="{DynamicResource SidebarText}"
                                        IsChecked="True"
                                        ToolTip="{DynamicResource Str_SvgTool_RemoveUnusedIdsTip}"
                                        Unchecked="Option_Changed" />
                                    <CheckBox
                                        x:Name="ChkRemoveEmpty"
                                        Margin="0,8,0,0"
                                        Checked="Option_Changed"
                                        Content="{DynamicResource Str_SvgTool_RemoveEmpty}"
                                        Foreground="{DynamicResource SidebarText}"
                                        IsChecked="True"
                                        Unchecked="Option_Changed" />
                                </StackPanel>
                            </Border>

                            <!--  ============ SHRINK ============  -->
                            <Border ctl:Tour.Key="Str_Tour_SvgTool_Shrink" ctl:Tour.Order="3" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_SvgTool_ShrinkHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.AutoFix}" />
                                    <CheckBox
                                        x:Name="ChkDefaults"
                                        Margin="0"
                                        Checked="Option_Changed"
                                        Content="{DynamicResource Str_SvgTool_DropDefaults}"
                                        Foreground="{DynamicResource SidebarText}"
                                        IsChecked="True"
                                        ToolTip="{DynamicResource Str_SvgTool_DropDefaultsTip}"
                                        Unchecked="Option_Changed" />
                                    <CheckBox
                                        x:Name="ChkColors"
                                        Margin="0,8,0,0"
                                        Checked="Option_Changed"
                                        Content="{DynamicResource Str_SvgTool_ShortenColors}"
                                        Foreground="{DynamicResource SidebarText}"
                                        IsChecked="True"
                                        Unchecked="Option_Changed" />
                                    <CheckBox
                                        x:Name="ChkMergePaths"
                                        Margin="0,8,0,0"
                                        Checked="Option_Changed"
                                        Content="{DynamicResource Str_SvgTool_MergePaths}"
                                        Foreground="{DynamicResource SidebarText}"
                                        ToolTip="{DynamicResource Str_SvgTool_MergePathsTip}"
                                        Unchecked="Option_Changed" />
                                    <CheckBox
                                        x:Name="ChkRoundNumbers"
                                        Margin="0,8,0,0"
                                        Checked="Option_Changed"
                                        Content="{DynamicResource Str_SvgTool_RoundNumbers}"
                                        Foreground="{DynamicResource SidebarText}"
                                        IsChecked="True"
                                        Unchecked="Option_Changed" />
                                    <Grid x:Name="PrecisionRow" Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Foreground="{DynamicResource SidebarText}"
                                            Text="{DynamicResource Str_SvgTool_Precision}" />
                                        <Border
                                            Grid.Column="1"
                                            Padding="7,1"
                                            VerticalAlignment="Center"
                                            Background="{DynamicResource AccentFill}"
                                            CornerRadius="8">
                                            <TextBlock
                                                x:Name="TxtPrecisionValue"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="White"
                                                Text="3" />
                                        </Border>
                                    </Grid>
                                    <Slider
                                        x:Name="SliderPrecision"
                                        Margin="0,4,0,0"
                                        IsSnapToTickEnabled="True"
                                        LargeChange="1"
                                        Maximum="6"
                                        Minimum="0"
                                        SmallChange="1"
                                        TickFrequency="1"
                                        ToolTip="{DynamicResource Str_SvgTool_PrecisionTip}"
                                        ValueChanged="SliderPrecision_ValueChanged"
                                        Value="3" />
                                    <CheckBox
                                        x:Name="ChkMinify"
                                        Margin="0,8,0,0"
                                        Checked="Option_Changed"
                                        Content="{DynamicResource Str_SvgTool_Minify}"
                                        Foreground="{DynamicResource SidebarText}"
                                        IsChecked="True"
                                        Unchecked="Option_Changed" />
                                </StackPanel>
                            </Border>

                            <!--  ============ EXPORT PNG ============  -->
                            <Border ctl:Tour.Key="Str_Tour_SvgTool_Export" ctl:Tour.Order="4" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_SvgTool_ExportHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.FileExportOutline}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <RadioButton
                                            x:Name="RadioExp256"
                                            Grid.Column="0"
                                            Checked="Export_Checked"
                                            Content="256"
                                            GroupName="SvgExport"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="256" />
                                        <RadioButton
                                            x:Name="RadioExp512"
                                            Grid.Column="2"
                                            Checked="Export_Checked"
                                            Content="512"
                                            GroupName="SvgExport"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="512" />
                                        <RadioButton
                                            x:Name="RadioExp1024"
                                            Grid.Column="4"
                                            Checked="Export_Checked"
                                            Content="1024"
                                            GroupName="SvgExport"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="1024" />
                                        <RadioButton
                                            x:Name="RadioExp2048"
                                            Grid.Column="6"
                                            Checked="Export_Checked"
                                            Content="2048"
                                            GroupName="SvgExport"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="2048" />
                                    </Grid>
                                    <TextBlock
                                        x:Name="TxtExportSize"
                                        Margin="0,8,0,0"
                                        FontSize="11.5"
                                        Foreground="{DynamicResource SidebarText}"
                                        Opacity="0.8"
                                        Text="{DynamicResource Str_SvgTool_ExportWidthHint}"
                                        TextWrapping="Wrap" />
                                    <CheckBox
                                        x:Name="ChkExportTransparent"
                                        Margin="0,10,0,0"
                                        Checked="Export_Checked"
                                        Content="{DynamicResource Str_SvgTool_ExportTransparent}"
                                        Foreground="{DynamicResource SidebarText}"
                                        IsChecked="True"
                                        Unchecked="Export_Checked" />
                                </StackPanel>
                            </Border>

                            <!--  ============ ENGINE (WebView2 runtime status) ============  -->
                            <Border
                                x:Name="EngineCard"
                                Margin="0,4,0,0"
                                Padding="10,8"
                                Background="{DynamicResource StatusInfoBg}"
                                CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon
                                        x:Name="IconEngine"
                                        Width="14"
                                        Height="14"
                                        Margin="0,1,8,0"
                                        VerticalAlignment="Top"
                                        Foreground="{DynamicResource StatusInfoFg}"
                                        Kind="{x:Static materialDesign:PackIconKind.MicrosoftEdge}" />
                                    <StackPanel Grid.Column="1">
                                        <TextBlock
                                            x:Name="TxtEngineTitle"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource StatusInfoFg}"
                                            Text="{DynamicResource Str_SvgTool_EngineStarting}" />
                                        <TextBlock
                                            x:Name="TxtEngineHint"
                                            Margin="0,2,0,0"
                                            FontSize="11"
                                            Foreground="{DynamicResource StatusInfoFg}"
                                            Text="{DynamicResource Str_SvgTool_EngineHint}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--  ================= MAIN AREA =================  -->
            <Border ctl:Tour.Key="Str_Tour_SvgTool_Preview" ctl:Tour.Order="5" Grid.Column="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  File name + status  -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentControl
                            x:Name="DocHeader"
                            VerticalAlignment="Center"
                            Content="{DynamicResource Str_Common_PreviewHeader}"
                            Style="{StaticResource CardHeader}"
                            Tag="{x:Static materialDesign:PackIconKind.VectorSquare}" />
                        <Border
                            x:Name="BorderStatus"
                            Grid.Column="2"
                            MaxWidth="420"
                            VerticalAlignment="Center"
                            Background="{DynamicResource RowBg}"
                            Style="{StaticResource IconStatusPillStyle}"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    x:Name="IconStatus"
                                    Width="13"
                                    Height="13"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Foreground="{Binding Foreground, ElementName=TxtStatus}"
                                    Kind="{x:Static materialDesign:PackIconKind.CheckCircleOutline}" />
                                <TextBlock
                                    x:Name="TxtStatus"
                                    FontSize="11.5"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextSecondary}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!--  Facts about the file  -->
                    <WrapPanel
                        x:Name="InfoPills"
                        Grid.Row="1"
                        Margin="0,0,0,10"
                        Visibility="Collapsed">
                        <Border
                            x:Name="PillSize"
                            Margin="0,0,6,6"
                            Background="{DynamicResource RowBg}"
                            Style="{StaticResource IconStatusPillStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="13"
                                    Height="13"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Foreground="{Binding Foreground, ElementName=TxtPillSize}"
                                    Kind="{x:Static materialDesign:PackIconKind.ArrowExpandAll}" />
                                <TextBlock
                                    x:Name="TxtPillSize"
                                    FontSize="11.5"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                        </Border>
                        <Border
                            x:Name="PillElements"
                            Margin="0,0,6,6"
                            Background="{DynamicResource RowBg}"
                            Style="{StaticResource IconStatusPillStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="13"
                                    Height="13"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Foreground="{Binding Foreground, ElementName=TxtPillElements}"
                                    Kind="{x:Static materialDesign:PackIconKind.VectorPolyline}" />
                                <TextBlock
                                    x:Name="TxtPillElements"
                                    FontSize="11.5"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                        </Border>
                        <Border
                            x:Name="PillBytes"
                            Margin="0,0,6,6"
                            Background="{DynamicResource RowBg}"
                            Style="{StaticResource IconStatusPillStyle}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    x:Name="IconPillBytes"
                                    Width="13"
                                    Height="13"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Foreground="{Binding Foreground, ElementName=TxtPillBytes}"
                                    Kind="{x:Static materialDesign:PackIconKind.FileOutline}" />
                                <TextBlock
                                    x:Name="TxtPillBytes"
                                    FontSize="11.5"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                        </Border>
                        <Border
                            x:Name="PillWarning"
                            Margin="0,0,6,6"
                            Background="{DynamicResource StatusWarningBg}"
                            Style="{StaticResource IconStatusPillStyle}"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="13"
                                    Height="13"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource StatusWarningFg}"
                                    Kind="{x:Static materialDesign:PackIconKind.AlertOutline}" />
                                <TextBlock
                                    x:Name="TxtPillWarning"
                                    FontSize="11.5"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource StatusWarningFg}" />
                            </StackPanel>
                        </Border>
                    </WrapPanel>

                    <!--  View toolbar: version, pane, zoom  -->
                    <Border
                        Grid.Row="2"
                        Margin="0,0,0,10"
                        Padding="6,5"
                        Background="{DynamicResource RowBg}"
                        CornerRadius="8">
                        <Grid x:Name="ToolbarGrid" SizeChanged="ToolbarGrid_SizeChanged">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Horizontal">
                                <RadioButton
                                    x:Name="RadioVerOriginal"
                                    MinWidth="104"
                                    Checked="Version_Checked"
                                    GroupName="SvgVersion"
                                    IsChecked="True"
                                    Style="{StaticResource ModeToggleButtonStyle}">
                                    <Grid HorizontalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon
                                            Grid.Column="0"
                                            Width="15"
                                            Height="15"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            Kind="{x:Static materialDesign:PackIconKind.FileOutline}" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_SvgTool_VersionOriginal}" TextWrapping="Wrap" />
                                    </Grid>
                                </RadioButton>
                                <RadioButton
                                    x:Name="RadioVerOptimized"
                                    MinWidth="104"
                                    Margin="4,0,0,0"
                                    Checked="Version_Checked"
                                    GroupName="SvgVersion"
                                    IsEnabled="False"
                                    Style="{StaticResource ModeToggleButtonStyle}">
                                    <Grid HorizontalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon
                                            Grid.Column="0"
                                            Width="15"
                                            Height="15"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            Kind="{x:Static materialDesign:PackIconKind.AutoFix}" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_SvgTool_VersionOptimized}" TextWrapping="Wrap" />
                                    </Grid>
                                </RadioButton>
                            </StackPanel>

                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                <RadioButton
                                    x:Name="RadioPanePreview"
                                    Width="38"
                                    Checked="Pane_Checked"
                                    GroupName="SvgPane"
                                    IsChecked="True"
                                    Style="{StaticResource ModeToggleButtonStyle}"
                                    ToolTip="{DynamicResource Str_SvgTool_PanePreview}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="{x:Static materialDesign:PackIconKind.EyeOutline}" />
                                </RadioButton>
                                <RadioButton
                                    x:Name="RadioPaneCode"
                                    Width="38"
                                    Margin="4,0,0,0"
                                    Checked="Pane_Checked"
                                    GroupName="SvgPane"
                                    Style="{StaticResource ModeToggleButtonStyle}"
                                    ToolTip="{DynamicResource Str_SvgTool_PaneCode}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="{x:Static materialDesign:PackIconKind.CodeTags}" />
                                </RadioButton>
                            </StackPanel>

                            <StackPanel
                                x:Name="ZoomBar"
                                Grid.Column="4"
                                Orientation="Horizontal">
                                <Button
                                    x:Name="BtnFit"
                                    Click="BtnFit_Click"
                                    Style="{StaticResource ZoomButton}"
                                    ToolTip="{DynamicResource Str_SvgTool_ZoomFit}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="{x:Static materialDesign:PackIconKind.FitToPageOutline}" />
                                </Button>
                                <Button
                                    x:Name="BtnActual"
                                    Click="BtnActual_Click"
                                    Style="{StaticResource ZoomButton}"
                                    ToolTip="{DynamicResource Str_SvgTool_ZoomActual}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="{x:Static materialDesign:PackIconKind.MagnifyScan}" />
                                </Button>
                                <Button
                                    x:Name="BtnZoomOut"
                                    Click="BtnZoomOut_Click"
                                    Style="{StaticResource ZoomButton}"
                                    ToolTip="{DynamicResource Str_SvgTool_ZoomOut}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="{x:Static materialDesign:PackIconKind.MagnifyMinusOutline}" />
                                </Button>
                                <TextBlock
                                    x:Name="TxtZoom"
                                    MinWidth="46"
                                    Margin="2,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{DynamicResource Str_SvgTool_ZoomFitLabel}"
                                    TextAlignment="Center" />
                                <Button
                                    x:Name="BtnZoomIn"
                                    Click="BtnZoomIn_Click"
                                    Style="{StaticResource ZoomButton}"
                                    ToolTip="{DynamicResource Str_SvgTool_ZoomIn}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="{x:Static materialDesign:PackIconKind.MagnifyPlusOutline}" />
                                </Button>
                            </StackPanel>
                        </Grid>
                    </Border>

                    <!--  Stage  -->
                    <Border
                        Grid.Row="3"
                        Background="{DynamicResource RowBg}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <Grid>
                            <!--  The WebView2 is added here from code  -->
                            <Grid
                                x:Name="PreviewHost"
                                Margin="1"
                                Visibility="Collapsed" />

                            <TextBox
                                x:Name="TxtCode"
                                Height="Auto"
                                Margin="1"
                                VerticalAlignment="Stretch"
                                VerticalContentAlignment="Top"
                                AcceptsReturn="True"
                                HorizontalScrollBarVisibility="Auto"
                                IsReadOnly="True"
                                Style="{StaticResource CodeTextBox}"
                                TextWrapping="NoWrap"
                                VerticalScrollBarVisibility="Auto"
                                Visibility="Collapsed" />

                            <!--  Nothing open yet  -->
                            <StackPanel
                                x:Name="EmptyState"
                                MaxWidth="420"
                                Margin="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                                <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.VectorSquare}" />
                                <TextBlock
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimary}"
                                    Text="{DynamicResource Str_SvgTool_EmptyTitle}"
                                    TextAlignment="Center" />
                                <TextBlock
                                    Margin="0,6,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{DynamicResource Str_SvgTool_NoFileHint}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                                <StackPanel
                                    Margin="0,14,0,0"
                                    HorizontalAlignment="Center"
                                    Orientation="Horizontal">
                                    <Button Click="BtnOpen_Click" Style="{StaticResource PrimaryButtonStyle}">
                                        <Grid HorizontalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon
                                                Grid.Column="0"
                                                Width="15"
                                                Height="15"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Kind="FolderOpenOutline" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_Common_OpenFile}" TextWrapping="Wrap" />
                                        </Grid>
                                    </Button>
                                    <Button
                                        Margin="8,0,0,0"
                                        Click="BtnPaste_Click"
                                        Style="{StaticResource PrimaryButtonStyle}">
                                        <Grid HorizontalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon
                                                Grid.Column="0"
                                                Width="15"
                                                Height="15"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Kind="ContentPaste" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_SvgTool_Paste}" TextWrapping="Wrap" />
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </StackPanel>

                            <!--  Loading, or the runtime is missing  -->
                            <StackPanel
                                x:Name="PreviewFallback"
                                MaxWidth="360"
                                Margin="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                                <ContentControl
                                    x:Name="PreviewFallbackBadge"
                                    Style="{StaticResource EmptyStateBadge}"
                                    Tag="{x:Static materialDesign:PackIconKind.MicrosoftEdge}" />
                                <TextBlock
                                    x:Name="TxtPreviewFallbackTitle"
                                    Margin="0,12,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimary}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                                <TextBlock
                                    x:Name="TxtPreviewFallbackHint"
                                    Margin="0,6,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextSecondary}"
                                    TextAlignment="Center"
                                    TextWrapping="Wrap" />
                                <Button
                                    x:Name="BtnGetWebView2"
                                    Margin="0,14,0,0"
                                    HorizontalAlignment="Center"
                                    Click="BtnGetWebView2_Click"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    Visibility="Collapsed">
                                    <Grid HorizontalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon
                                            Grid.Column="0"
                                            Width="15"
                                            Height="15"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            Kind="{x:Static materialDesign:PackIconKind.OpenInNew}" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_SvgTool_GetWebView2}" TextWrapping="Wrap" />
                                    </Grid>
                                </Button>
                            </StackPanel>

                            <!--  Busy (optimizing a big file, exporting)  -->
                            <ProgressBar
                                x:Name="BusyBar"
                                Height="3"
                                VerticalAlignment="Top"
                                IsIndeterminate="True"
                                Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <!--  Actions  -->
                    <Grid Grid.Row="4" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Orientation="Horizontal">
                            <Button Click="BtnOpen_Click" Style="{StaticResource PrimaryButtonStyle}">
                                <Grid HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon
                                        Grid.Column="0"
                                        Width="14"
                                        Height="14"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Kind="FolderOpenOutline" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_Common_OpenFile}" TextWrapping="Wrap" />
                                </Grid>
                            </Button>
                            <Button
                                Margin="8,0,0,0"
                                Click="BtnPaste_Click"
                                ToolTip="{DynamicResource Str_SvgTool_PasteTip}">
                                <Grid HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon
                                        Grid.Column="0"
                                        Width="14"
                                        Height="14"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Kind="ContentPaste" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_SvgTool_Paste}" TextWrapping="Wrap" />
                                </Grid>
                            </Button>
                        </StackPanel>

                        <StackPanel
                            Grid.Column="2"
                            HorizontalAlignment="Right"
                            Orientation="Horizontal">
                            <Button
                                x:Name="BtnCopy"
                                Click="BtnCopy_Click"
                                IsEnabled="False"
                                ToolTip="{DynamicResource Str_SvgTool_CopyTip}"
                                Style="{StaticResource ListToolButtonStyle}">
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    Kind="ContentCopy" />
                            </Button>
                            <Button
                                x:Name="BtnSave"
                                Margin="8,0,0,0"
                                Click="BtnSave_Click"
                                IsEnabled="False"
                                Style="{StaticResource ListToolPrimaryButtonStyle}">
                                <Grid HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon
                                        Grid.Column="0"
                                        Width="14"
                                        Height="14"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Kind="ContentSaveOutline" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_SvgTool_SaveOptimized}" TextWrapping="Wrap" />
                                </Grid>
                            </Button>
                            <controls:ExportButton
                                x:Name="BtnExportPng"
                                Margin="8,0,0,0"
                                IsEnabled="False">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Click="MenuExportPng_Click" Header="{DynamicResource Str_SvgTool_ExportPng}">
                                            <MenuItem.Icon>
                                                <materialDesign:PackIcon Kind="FileImageOutline" />
                                            </MenuItem.Icon>
                                        </MenuItem>
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </controls:ExportButton>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!--  Drop target  -->
        <Border
            x:Name="DropOverlay"
            Margin="16,8,16,16"
            Panel.ZIndex="10"
            Style="{StaticResource DropZoneStyle}">
            <Grid>
                <Rectangle
                    RadiusX="14"
                    RadiusY="14"
                    Stroke="{DynamicResource AccentColor}"
                    StrokeDashArray="6 4"
                    StrokeThickness="2" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.TrayArrowDown}" />
                    <TextBlock
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        Text="{DynamicResource Str_SvgTool_DropToOpen}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
