<UserControl
    x:Class="Smart_Tools.WPF.Controls.ImageViewerControl"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:models="clr-namespace:Smart_Tools.WPF.Models"
    x:Name="Root"
    AllowDrop="True"
    DragLeave="Root_DragLeave"
    DragOver="Root_DragOver"
    Drop="Root_Drop"
    Focusable="True"
    Loaded="Root_Loaded"
    PreviewKeyDown="Root_PreviewKeyDown"
    Unloaded="Root_Unloaded">

    <!--
        Backend: Controllers/ImageViewerManager.cs (finding images, the list,
        browse order, zoom and rotation maths, settings) and
        ImageViewerManager.Imaging.cs (decoding with photo orientation,
        thumbnails, saving). Models/ImageViewerModel.cs. This file and the
        code-behind are UI only. The stage is fixed-dark (#0E0F12) with the
        same player chrome as Video Replay; everything around it uses theme
        tokens.
    -->

    <UserControl.Resources>

        <!--  ============ Player chrome (same as Video Replay) ============  -->

        <Style
            x:Key="PlayerPrimaryButtonStyle"
            BasedOn="{StaticResource PlayerIconButtonStyle}"
            TargetType="Button">
            <Setter Property="Width" Value="50" />
            <Setter Property="Height" Value="50" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Background="{DynamicResource AccentFill}"
                            CornerRadius="25">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.88" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.74" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Playlist: thumbnail (loaded only for rows on screen)  -->
        <DataTemplate x:Key="ThumbCellTemplate" DataType="{x:Type models:ImageQueueItem}">
            <Border
                Width="34"
                Height="34"
                HorizontalAlignment="Center"
                Background="{DynamicResource RowBg}"
                ClipToBounds="True"
                CornerRadius="6">
                <Grid>
                    <materialDesign:PackIcon
                        Width="16"
                        Height="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextSecondary}"
                        Kind="ImageOutline" />
                    <Image
                        RenderOptions.BitmapScalingMode="HighQuality"
                        Source="{Binding Thumbnail}"
                        Stretch="UniformToFill" />
                </Grid>
            </Border>
        </DataTemplate>

        <!--  Playlist: name + folder  -->
        <DataTemplate x:Key="NameCellTemplate" DataType="{x:Type models:ImageQueueItem}">
            <StackPanel VerticalAlignment="Center" ToolTip="{Binding FullPath}">
                <TextBlock
                    Foreground="{DynamicResource TextPrimary}"
                    Text="{Binding Name}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Margin="0,1,0,0"
                    FontSize="11"
                    Foreground="{DynamicResource TextSecondary}"
                    Text="{Binding Folder}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">

        <!--  No page header: MainWindow's header card shows the tool's icon and name.  -->

        <Grid Margin="16,8,16,16">

            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OptionsColumn" Width="280" />
                <ColumnDefinition x:Name="OptionsGapColumn" Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= OPTIONS SIDEBAR =================  -->

            <Border
                x:Name="OptionsSidebar"
                Grid.Column="0"
                Style="{StaticResource SidebarPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Button
                            x:Name="BtnCollapseOptions"
                            MinHeight="45"
                            HorizontalContentAlignment="Left"
                            Click="BtnCollapseOptions_Click"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Foreground="{DynamicResource SidebarText}"
                            ToolTip="{DynamicResource Str_Common_SidebarToggleTooltip}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="OverridesDefaultStyle" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Margin="16,0,0,0" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Kind="TuneVariant" />
                                <TextBlock
                                    x:Name="TxtOptionsHeaderLabel"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{DynamicResource Str_Common_OptionsLabel}" />
                            </StackPanel>
                        </Button>
                        <Separator
                            x:Name="SepHeader"
                            Margin="16,4"
                            Style="{StaticResource SidebarSeparatorStyle}" />
                    </StackPanel>

                    <ScrollViewer
                        x:Name="OptionsScrollViewer"
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16,4,16,16">

                            <!--  ============ FILES ============  -->
                            <Border ctl:Tour.Key="Str_Tour_ImageViewer_Files" ctl:Tour.Order="1" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Common_Files}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.FileMultipleOutline}" />

                                    <Border
                                        x:Name="DropArea"
                                        MinHeight="64"
                                        Margin="0,0,0,10"
                                        AllowDrop="True"
                                        Background="{DynamicResource SidebarInputBg}"
                                        BorderBrush="{DynamicResource SidebarInputBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8"
                                        DragLeave="DropArea_DragLeave"
                                        DragOver="DropArea_DragOver"
                                        Drop="DropArea_Drop">
                                        <Grid>
                                            <ListBox
                                                x:Name="QueueList"
                                                MaxHeight="170"
                                                Padding="4"
                                                Background="Transparent"
                                                BorderThickness="0"
                                                ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                                ScrollViewer.VerticalScrollBarVisibility="Auto">
                                                <ListBox.ItemContainerStyle>
                                                    <Style TargetType="ListBoxItem">
                                                        <Setter Property="Padding" Value="0" />
                                                        <Setter Property="Margin" Value="0,0,0,2" />
                                                        <Setter Property="Focusable" Value="False" />
                                                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                                        <Setter Property="Template">
                                                            <Setter.Value>
                                                                <ControlTemplate TargetType="ListBoxItem">
                                                                    <Border
                                                                        x:Name="RowBorder"
                                                                        Background="Transparent"
                                                                        CornerRadius="8">
                                                                        <ContentPresenter Margin="6,5" />
                                                                    </Border>
                                                                    <ControlTemplate.Triggers>
                                                                        <Trigger Property="IsMouseOver" Value="True">
                                                                            <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource SidebarItemHoverBg}" />
                                                                        </Trigger>
                                                                    </ControlTemplate.Triggers>
                                                                </ControlTemplate>
                                                            </Setter.Value>
                                                        </Setter>
                                                    </Style>
                                                </ListBox.ItemContainerStyle>
                                                <ListBox.ItemTemplate>
                                                    <DataTemplate DataType="{x:Type models:ImageQueueGroup}">
                                                        <Grid ToolTip="{Binding ToolTip}">
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="Auto" />
                                                                <ColumnDefinition Width="*" />
                                                                <ColumnDefinition Width="Auto" />
                                                            </Grid.ColumnDefinitions>
                                                            <Border
                                                                Width="26"
                                                                Height="26"
                                                                Margin="0,0,8,0"
                                                                Background="{DynamicResource AccentColorSubtle}"
                                                                CornerRadius="7">
                                                                <materialDesign:PackIcon
                                                                    x:Name="GroupIcon"
                                                                    Width="14"
                                                                    Height="14"
                                                                    HorizontalAlignment="Center"
                                                                    VerticalAlignment="Center"
                                                                    Foreground="{DynamicResource AccentColor}"
                                                                    Kind="FileMultipleOutline" />
                                                            </Border>
                                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                                <TextBlock
                                                                    FontSize="12"
                                                                    FontWeight="SemiBold"
                                                                    Foreground="{DynamicResource SidebarText}"
                                                                    Text="{Binding Name}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                                <TextBlock
                                                                    Margin="0,1,0,0"
                                                                    FontSize="11"
                                                                    Foreground="{DynamicResource SidebarTextMuted}"
                                                                    Text="{Binding Subtitle}"
                                                                    TextTrimming="CharacterEllipsis" />
                                                            </StackPanel>
                                                            <Button
                                                                Grid.Column="2"
                                                                Width="24"
                                                                Height="24"
                                                                Margin="6,0,0,0"
                                                                VerticalAlignment="Center"
                                                                Click="BtnRemoveQueueGroup_Click"
                                                                Style="{StaticResource IconButtonStyle}"
                                                                Tag="{Binding}"
                                                                ToolTip="{DynamicResource Str_BackgroundRemover_TakeTheseImagesOff}">
                                                                <materialDesign:PackIcon
                                                                    Width="13"
                                                                    Height="13"
                                                                    Kind="Close" />
                                                            </Button>
                                                        </Grid>
                                                        <DataTemplate.Triggers>
                                                            <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                                                <Setter TargetName="GroupIcon" Property="Kind" Value="Folder" />
                                                            </DataTrigger>
                                                        </DataTemplate.Triggers>
                                                    </DataTemplate>
                                                </ListBox.ItemTemplate>
                                            </ListBox>

                                            <StackPanel
                                                x:Name="QueueEmptyHint"
                                                Margin="10,12"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                IsHitTestVisible="False">
                                                <materialDesign:PackIcon
                                                    Width="22"
                                                    Height="22"
                                                    HorizontalAlignment="Center"
                                                    Foreground="{DynamicResource SidebarTextMuted}"
                                                    Kind="TrayArrowDown" />
                                                <TextBlock
                                                    Margin="0,4,0,0"
                                                    FontSize="11"
                                                    Foreground="{DynamicResource SidebarTextMuted}"
                                                    Text="{DynamicResource Str_Common_DragDropFilesFolder}"
                                                    TextAlignment="Center"
                                                    TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Button
                                            x:Name="BtnAddImages"
                                            Click="BtnAddImages_Click"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            ToolTip="{DynamicResource Str_BackgroundRemover_AddImagesToThe}">
                                            <Grid HorizontalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon
                                                    Grid.Column="0"
                                                    Width="16"
                                                    Height="16"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Kind="FilePlusOutline" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_Validate_AddFiles}" TextWrapping="Wrap" />
                                            </Grid>
                                        </Button>
                                        <Button
                                            x:Name="BtnAddFolder"
                                            Grid.Column="1"
                                            Width="34"
                                            Height="34"
                                            Margin="6,0,0,0"
                                            Click="BtnAddFolder_Click"
                                            Style="{StaticResource NeutralIconButtonStyle}"
                                            ToolTip="{DynamicResource Str_BackgroundRemover_AddEveryImageIn}">
                                            <materialDesign:PackIcon
                                                Width="16"
                                                Height="16"
                                                Kind="FolderPlusOutline" />
                                        </Button>
                                        <Button
                                            x:Name="BtnClearSources"
                                            Grid.Column="2"
                                            Width="34"
                                            Height="34"
                                            Margin="6,0,0,0"
                                            Click="BtnClearQueue_Click"
                                            Style="{StaticResource NeutralIconButtonStyle}"
                                            ToolTip="{DynamicResource Str_BackgroundRemover_TakeEverythingOffThe}">
                                            <materialDesign:PackIcon
                                                Width="16"
                                                Height="16"
                                                Kind="PlaylistRemove" />
                                        </Button>
                                    </Grid>

                                    <CheckBox
                                        x:Name="ChkIncludeSubfolders"
                                        Margin="0,10,0,0"
                                        Checked="Option_Changed"
                                        Content="{DynamicResource Str_Common_IncludeSubfolders}"
                                        Foreground="{DynamicResource SidebarText}"
                                        IsChecked="True"
                                        ToolTip="{DynamicResource Str_ImageViewerControl_WhenAddingAFolder}"
                                        Unchecked="Option_Changed" />
                                </StackPanel>
                            </Border>

                            <!--  ============ BROWSE ============  -->
                            <Border ctl:Tour.Key="Str_Tour_ImageViewer_Browse" ctl:Tour.Order="2" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Settings_Browse}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.ImageMultiple}" />
                                    <UniformGrid Columns="2">
                                        <RadioButton
                                            x:Name="RadioBrowseSequential"
                                            Margin="0,0,3,0"
                                            Click="Mode_Click"
                                            GroupName="BrowseMode"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="Sequential"
                                            ToolTip="{DynamicResource Str_ImageViewerControl_PreviousNextAndThe}">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="18"
                                                    Height="18"
                                                    HorizontalAlignment="Center"
                                                    Kind="ArrowRightBoldBoxOutline" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    HorizontalAlignment="Center"
                                                    Text="{DynamicResource Str_AudioReplayControl_InOrder}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="RadioBrowseShuffle"
                                            Margin="3,0,0,0"
                                            Click="Mode_Click"
                                            GroupName="BrowseMode"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="Shuffle"
                                            ToolTip="{DynamicResource Str_ImageViewerControl_EveryImageOnceIn}">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="18"
                                                    Height="18"
                                                    HorizontalAlignment="Center"
                                                    Kind="ShuffleVariant" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    HorizontalAlignment="Center"
                                                    Text="{DynamicResource Str_AudioReplayControl_Shuffle}" />
                                            </StackPanel>
                                        </RadioButton>
                                    </UniformGrid>
                                    <TextBlock
                                        x:Name="TxtModeHint"
                                        Margin="2,10,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource SidebarTextMuted}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!--  ============ SLIDESHOW ============  -->
                            <Border ctl:Tour.Key="Str_Tour_ImageViewer_Slideshow" ctl:Tour.Order="3" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_ImageViewerControl_Slideshow}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.PresentationPlay}" />
                                    <TextBlock
                                        Margin="0,4,0,6"
                                        Style="{StaticResource FieldLabel}"
                                        Text="{DynamicResource Str_ImageViewerControl_EachImageShowsFor}" />
                                    <UniformGrid x:Name="SpeedTiles" Columns="4">
                                        <RadioButton
                                            x:Name="RadioSpeed2"
                                            Margin="0,0,2,0"
                                            Click="Speed_Click"
                                            Content="2 s"
                                            GroupName="SlideshowSpeed"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="2" />
                                        <RadioButton
                                            x:Name="RadioSpeed3"
                                            Margin="2,0"
                                            Click="Speed_Click"
                                            Content="3 s"
                                            GroupName="SlideshowSpeed"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="3" />
                                        <RadioButton
                                            x:Name="RadioSpeed5"
                                            Margin="2,0"
                                            Click="Speed_Click"
                                            Content="5 s"
                                            GroupName="SlideshowSpeed"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="5" />
                                        <RadioButton
                                            x:Name="RadioSpeed10"
                                            Margin="2,0,0,0"
                                            Click="Speed_Click"
                                            Content="10 s"
                                            GroupName="SlideshowSpeed"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="10" />
                                    </UniformGrid>
                                    <TextBlock
                                        Margin="2,10,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource SidebarTextMuted}"
                                        Text="{DynamicResource Str_ImageViewerControl_TheRingAroundPlay}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!--  ============ KEYBOARD ============  -->
                            <Border ctl:Tour.Key="Str_Tour_ImageViewer_Keyboard" ctl:Tour.Order="4" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_ImageViewerControl_Keyboard}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.KeyboardOutline}" />
                                    <TextBlock
                                        FontSize="11"
                                        Foreground="{DynamicResource SidebarTextMuted}"
                                        LineHeight="18"
                                        TextWrapping="Wrap">
                                        <Run
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource SidebarText}"
                                            Text="← →" />
                                        previous / next image<LineBreak />
                                        <Run
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource SidebarText}"
                                            Text="{DynamicResource Str_ImageViewerControl_Space}" />
                                        slideshow ·<Run
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource SidebarText}"
                                            Text="R" />
                                        turn right (Shift: left)<LineBreak />
                                        <Run
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource SidebarText}"
                                            Text="+ −" />
                                        zoom (or Ctrl + mouse wheel)<LineBreak />
                                        <Run
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource SidebarText}"
                                            Text="0" />
                                        fit ·<Run
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource SidebarText}"
                                            Text="1" />
                                        actual size (or double-click)<LineBreak />
                                        <Run
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource SidebarText}"
                                            Text="{DynamicResource Str_ImageViewerControl_HomeEnd}" />
                                        first / last image</TextBlock>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--  ================= VIEWER + PLAYLIST =================  -->

            <Grid Grid.Column="2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition x:Name="PlaylistColumn" Width="380" />
                </Grid.ColumnDefinitions>

                <!--  Viewer card  -->
                <Border Grid.Column="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!--  Fixed-dark stage: image + viewer chrome  -->
                        <Border
                            x:Name="Stage"
                            Background="{DynamicResource MediaStageBg}"
                            ClipToBounds="True"
                            CornerRadius="12">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>

                                <ScrollViewer
                                    x:Name="ImageScrollViewer"
                                    Margin="6,6,6,0"
                                    Focusable="False"
                                    HorizontalScrollBarVisibility="Auto"
                                    PreviewMouseWheel="ImageScrollViewer_PreviewMouseWheel"
                                    SizeChanged="ImageScrollViewer_SizeChanged"
                                    VerticalScrollBarVisibility="Auto">
                                    <Image
                                        x:Name="MainImage"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        MouseLeftButtonDown="MainImage_MouseLeftButtonDown"
                                        MouseLeftButtonUp="MainImage_MouseLeftButtonUp"
                                        MouseMove="MainImage_MouseMove"
                                        RenderOptions.BitmapScalingMode="HighQuality"
                                        Stretch="Fill">
                                        <Image.LayoutTransform>
                                            <TransformGroup>
                                                <ScaleTransform x:Name="ImageScale" ScaleX="1" ScaleY="1" />
                                                <RotateTransform x:Name="ImageRotate" Angle="0" />
                                            </TransformGroup>
                                        </Image.LayoutTransform>
                                    </Image>
                                </ScrollViewer>

                                <!--  Nothing on screen  -->
                                <StackPanel
                                    x:Name="NoImagePanel"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    IsHitTestVisible="False">
                                    <Border
                                        Width="64"
                                        Height="64"
                                        HorizontalAlignment="Center"
                                        Background="{DynamicResource MediaChromeFill}"
                                        CornerRadius="32">
                                        <materialDesign:PackIcon
                                            Width="30"
                                            Height="30"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource MediaStageTextSoft}"
                                            Kind="ImageOutline" />
                                    </Border>
                                    <TextBlock
                                        x:Name="TxtEmptyHint"
                                        MaxWidth="340"
                                        Margin="0,12,0,0"
                                        HorizontalAlignment="Center"
                                        FontSize="13"
                                        Foreground="{DynamicResource MediaStageTextSoft}"
                                        Text="{DynamicResource Str_ImageViewerControl_AddImagesOnThe}"
                                        TextAlignment="Center"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <!--  Couldn't open this one  -->
                                <Border
                                    x:Name="LoadErrorPanel"
                                    Padding="18,14"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource MediaChromeBg}"
                                    CornerRadius="12"
                                    Visibility="Collapsed">
                                    <StackPanel MaxWidth="320" Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="18"
                                            Height="18"
                                            Margin="0,0,10,0"
                                            VerticalAlignment="Top"
                                            Foreground="{DynamicResource MediaStageError}"
                                            Kind="ImageBrokenVariant" />
                                        <TextBlock
                                            x:Name="TxtLoadError"
                                            MaxWidth="290"
                                            FontSize="12"
                                            Foreground="{DynamicResource MediaStageText}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>

                                <!--  Opening a large image  -->
                                <ProgressBar
                                    x:Name="ProgressLoading"
                                    Height="3"
                                    Margin="18,10,18,0"
                                    VerticalAlignment="Top"
                                    IsIndeterminate="True"
                                    Visibility="Collapsed" />

                                <!--  Viewer chrome  -->
                                <Grid Grid.Row="1" Margin="16,8,16,12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <!--  Zoom  -->
                                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                        <Button
                                            x:Name="BtnZoomOut"
                                            Click="BtnZoomOut_Click"
                                            Style="{StaticResource PlayerIconButtonStyle}"
                                            ToolTip="{DynamicResource Str_ImageViewerControl_ZoomOut}">
                                            <materialDesign:PackIcon
                                                Width="18"
                                                Height="18"
                                                Kind="MagnifyMinusOutline" />
                                        </Button>
                                        <TextBlock
                                            x:Name="TxtZoomLevel"
                                            MinWidth="48"
                                            Margin="4,0"
                                            VerticalAlignment="Center"
                                            FontFamily="Consolas"
                                            FontSize="11.5"
                                            Foreground="{DynamicResource MediaStageTextSoft}"
                                            Text="100%"
                                            TextAlignment="Center" />
                                        <Button
                                            x:Name="BtnZoomIn"
                                            Click="BtnZoomIn_Click"
                                            Style="{StaticResource PlayerIconButtonStyle}"
                                            ToolTip="{DynamicResource Str_ImageViewerControl_ZoomIn}">
                                            <materialDesign:PackIcon
                                                Width="18"
                                                Height="18"
                                                Kind="MagnifyPlusOutline" />
                                        </Button>
                                        <Button
                                            x:Name="BtnZoomFit"
                                            Margin="8,0,0,0"
                                            Click="BtnZoomFit_Click"
                                            Style="{StaticResource PlayerIconButtonStyle}"
                                            ToolTip="{DynamicResource Str_ImageViewerControl_FitToTheWindow}">
                                            <materialDesign:PackIcon
                                                Width="18"
                                                Height="18"
                                                Kind="FitToScreenOutline" />
                                        </Button>
                                        <Button
                                            x:Name="BtnZoom100"
                                            Margin="6,0,0,0"
                                            Click="BtnZoom100_Click"
                                            Style="{StaticResource PlayerIconButtonStyle}"
                                            ToolTip="{DynamicResource Str_ImageViewerControl_ActualSizeOneImage}">
                                            <materialDesign:PackIcon
                                                Width="18"
                                                Height="18"
                                                Kind="NumericOneBoxOutline" />
                                        </Button>
                                    </StackPanel>

                                    <!--  Previous / slideshow / next  -->
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button
                                            x:Name="BtnPrevious"
                                            VerticalAlignment="Center"
                                            Click="BtnPrevious_Click"
                                            Style="{StaticResource PlayerIconButtonStyle}"
                                            ToolTip="{DynamicResource Str_ImageViewerControl_PreviousImage}">
                                            <materialDesign:PackIcon
                                                Width="20"
                                                Height="20"
                                                Kind="SkipPrevious" />
                                        </Button>

                                        <!--  The ring fills up until the next slideshow image; the grid is bigger than the button so it shows outside its edge.  -->
                                        <Grid
                                            Width="68"
                                            Height="68"
                                            Margin="8,0">
                                            <controls:CountdownRing x:Name="SlideshowCountdownRing" />
                                            <Button
                                                x:Name="BtnSlideshowPlayPause"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Center"
                                                Click="BtnSlideshowPlayPause_Click"
                                                Style="{StaticResource PlayerPrimaryButtonStyle}"
                                                ToolTip="{DynamicResource Str_ImageViewerControl_StartOrStopThe}">
                                                <materialDesign:PackIcon
                                                    x:Name="IconSlideshowPlayPause"
                                                    Width="24"
                                                    Height="24"
                                                    Kind="Play" />
                                            </Button>
                                        </Grid>

                                        <Button
                                            x:Name="BtnNext"
                                            VerticalAlignment="Center"
                                            Click="BtnNext_Click"
                                            Style="{StaticResource PlayerIconButtonStyle}"
                                            ToolTip="{DynamicResource Str_ImageViewerControl_NextImage}">
                                            <materialDesign:PackIcon
                                                Width="20"
                                                Height="20"
                                                Kind="SkipNext" />
                                        </Button>
                                    </StackPanel>

                                    <!--  Turn + save  -->
                                    <StackPanel
                                        Grid.Column="2"
                                        HorizontalAlignment="Right"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <Button
                                            x:Name="BtnRotateLeft"
                                            Click="BtnRotateLeft_Click"
                                            Style="{StaticResource PlayerIconButtonStyle}"
                                            ToolTip="{DynamicResource Str_ImageViewerControl_TurnLeftShiftR}">
                                            <materialDesign:PackIcon
                                                Width="18"
                                                Height="18"
                                                Kind="RotateLeft" />
                                        </Button>
                                        <Button
                                            x:Name="BtnRotateRight"
                                            Margin="6,0,0,0"
                                            Click="BtnRotateRight_Click"
                                            Style="{StaticResource PlayerIconButtonStyle}"
                                            ToolTip="{DynamicResource Str_ImageViewerControl_TurnRightR}">
                                            <materialDesign:PackIcon
                                                Width="18"
                                                Height="18"
                                                Kind="RotateRight" />
                                        </Button>
                                        <Button
                                            x:Name="BtnSaveImageAs"
                                            Margin="10,0,0,0"
                                            Click="BtnSaveImageAs_Click"
                                            IsEnabled="False"
                                            Style="{StaticResource PlayerIconButtonStyle}"
                                            ToolTip="{DynamicResource Str_ImageViewerControl_SaveACopyTurned}">
                                            <materialDesign:PackIcon
                                                Width="18"
                                                Height="18"
                                                Kind="ContentSaveOutline" />
                                        </Button>
                                        <Button
                                            x:Name="BtnTheater"
                                            Margin="6,0,0,0"
                                            Click="BtnTheater_Click"
                                            Style="{StaticResource PlayerIconButtonStyle}"
                                            ToolTip="{DynamicResource Str_ImageViewerControl_HideBothSidePanels}">
                                            <materialDesign:PackIcon
                                                x:Name="IconTheater"
                                                Width="18"
                                                Height="18"
                                                Kind="ArrowExpand" />
                                        </Button>
                                    </StackPanel>
                                </Grid>
                            </Grid>
                        </Border>

                        <!--  Now viewing  -->
                        <Grid Grid.Row="1" Margin="4,12,4,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock
                                    x:Name="TxtFileName"
                                    FontSize="14"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimary}"
                                    Text="{DynamicResource Str_AudioReplayControl_NothingLoaded}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Name="TxtImageInfo"
                                    Margin="0,2,0,0"
                                    FontSize="11.5"
                                    Foreground="{DynamicResource TextSecondary}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <Border
                                x:Name="PillPosition"
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource AccentColorSubtle}"
                                Style="{StaticResource IconStatusPillStyle}"
                                Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        x:Name="IconModePill"
                                        Width="13"
                                        Height="13"
                                        Margin="0,0,5,0"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource AccentColor}"
                                        Kind="ImageMultipleOutline" />
                                    <TextBlock
                                        x:Name="TxtPosition"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource AccentColor}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Grid>
                </Border>

                <!--  Playlist collapse strip  -->
                <Button
                    x:Name="BtnTogglePlaylist"
                    Grid.Column="1"
                    Width="26"
                    Margin="6,0"
                    Click="BtnTogglePlaylist_Click"
                    Style="{StaticResource PanelToggleButtonStyle}"
                    ToolTip="{DynamicResource Str_ImageViewerControl_ShowOrHideThe}">
                    <materialDesign:PackIcon
                        x:Name="IconTogglePlaylist"
                        Width="20"
                        Height="20"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Kind="ChevronRight" />
                </Button>

                <!--  Image list  -->
                <Border
                    x:Name="PlaylistPanel"
                    Grid.Column="2"
                    Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentControl
                                VerticalAlignment="Center"
                                Content="{DynamicResource Str_ImgPdf_ImagesHeader}"
                                Style="{StaticResource CardHeader}"
                                Tag="{x:Static materialDesign:PackIconKind.ImageMultipleOutline}" />
                            <Border
                                x:Name="SummaryPill"
                                Grid.Column="1"
                                Background="{DynamicResource StatusInfoBg}"
                                Style="{StaticResource IconStatusPillStyle}"
                                ToolTip="{DynamicResource Str_ImageViewerControl_ImagesInTheList}"
                                Visibility="Collapsed">
                                <TextBlock
                                    x:Name="TxtSummaryCount"
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource StatusInfoFg}" />
                            </Border>
                        </Grid>

                        <StackPanel
                            x:Name="ListTools"
                            Grid.Row="1"
                            Margin="0,0,0,10"
                            Orientation="Horizontal">
                            <Button
                                x:Name="BtnMoveUp"
                                Width="32"
                                Height="32"
                                Click="BtnMoveUp_Click"
                                Style="{StaticResource NeutralIconButtonStyle}"
                                ToolTip="{DynamicResource Str_ImageViewerControl_MoveEarlier}">
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    Kind="ArrowUp" />
                            </Button>
                            <Button
                                x:Name="BtnMoveDown"
                                Width="32"
                                Height="32"
                                Margin="4,0,0,0"
                                Click="BtnMoveDown_Click"
                                Style="{StaticResource NeutralIconButtonStyle}"
                                ToolTip="{DynamicResource Str_ImageViewerControl_MoveLater}">
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    Kind="ArrowDown" />
                            </Button>
                            <Button
                                x:Name="BtnSortByName"
                                Width="32"
                                Height="32"
                                Margin="10,0,0,0"
                                Click="BtnSortByName_Click"
                                Style="{StaticResource NeutralIconButtonStyle}"
                                ToolTip="{DynamicResource Str_ImageViewerControl_SortByName}">
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    Kind="SortAlphabeticalAscending" />
                            </Button>
                            <Button
                                x:Name="BtnSortByDate"
                                Width="32"
                                Height="32"
                                Margin="4,0,0,0"
                                Click="BtnSortByDate_Click"
                                Style="{StaticResource NeutralIconButtonStyle}"
                                ToolTip="{DynamicResource Str_PdfToolkit_DateOrderOldestFirst}">
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    Kind="SortCalendarAscending" />
                            </Button>
                        </StackPanel>

                        <DataGrid ctl:Tour.Key="Str_Tour_ImageViewer_Queue" ctl:Tour.Order="5"
                            x:Name="DataGridQueue"
                            Grid.Row="2"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            CanUserSortColumns="False"
                            FontSize="12"
                            IsReadOnly="True"
                            LoadingRow="DataGridQueue_LoadingRow"
                            MouseDoubleClick="DataGridQueue_MouseDoubleClick"
                            PreviewKeyDown="DataGridQueue_PreviewKeyDown"
                            MinRowHeight="46"
                            RowStyle="{StaticResource PlaylistRowStyle}"
                            SelectionChanged="DataGridQueue_SelectionChanged"
                            SelectionMode="Extended"
                            ToolTip="{DynamicResource Str_ImageViewerControl_DoubleClickOrEnter}"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.ScrollUnit="Pixel"
                            VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Click="MenuPlay_Click">
                                        <MenuItem.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="15"
                                                    Height="15"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Kind="PlayCircleOutline" />
                                                <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_AudioReplayControl_Play}" />
                                            </StackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem Click="MenuShowInFolder_Click">
                                        <MenuItem.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="15"
                                                    Height="15"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Kind="FolderOpenOutline" />
                                                <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_Validate_MenuShowInFolder}" />
                                            </StackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                    <MenuItem Click="MenuDeleteFile_Click">
                                        <MenuItem.Header>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="15"
                                                    Height="15"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Kind="DeleteOutline" />
                                                <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_VideoReplay_DeleteFile}" />
                                            </StackPanel>
                                        </MenuItem.Header>
                                    </MenuItem>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="34" CellStyle="{StaticResource CheckBoxCellStyle}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <CheckBox
                                                Click="ItemCheckBox_Click"
                                                IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                Style="{StaticResource DataGridCheckBoxStyle}"
                                                ToolTip="{DynamicResource Str_ImageViewerControl_TickToRemoveWith}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTemplateColumn
                                    Width="46"
                                    CellStyle="{StaticResource CompactCellStyle}"
                                    CellTemplate="{StaticResource ThumbCellTemplate}" />
                                <DataGridTemplateColumn
                                    Width="*"
                                    MinWidth="70"
                                    CellTemplate="{StaticResource NameCellTemplate}"
                                    Header="{DynamicResource Str_ImgEdit_ColHeaderImage}" />
                                <DataGridTextColumn
                                    ElementStyle="{StaticResource EllipsisCellTextStyle}"
                                    x:Name="ColSize"
                                    Width="64"
                                    Binding="{Binding SizeDisplay, Mode=OneWay}"
                                    CellStyle="{StaticResource CompactCellStyle}"
                                    Header="{DynamicResource Str_Common_SizeHeader}" />
                                <DataGridTemplateColumn Width="38" CellStyle="{StaticResource CompactCellStyle}">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Button
                                                Width="24"
                                                Height="24"
                                                HorizontalAlignment="Center"
                                                Click="BtnRemoveFromQueue_Click"
                                                Style="{StaticResource IconButtonStyle}"
                                                ToolTip="{DynamicResource Str_ImageViewerControl_RemoveFromTheList}">
                                                <materialDesign:PackIcon
                                                    Width="13"
                                                    Height="13"
                                                    Foreground="{DynamicResource StatusErrorFg}"
                                                    Kind="Close" />
                                            </Button>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>

                        <controls:EmptyStateCard
                            x:Name="EmptyStatePanel"
                            Grid.Row="2"
                            Description="{DynamicResource Str_ImageViewerControl_DragImagesOrA}"
                            DescriptionMaxWidth="260"
                            Icon="ImageMultipleOutline"
                            IsHitTestVisible="False" />

                        <!--  ============ PLAYLIST ACTIONS ============  -->
                        <Grid Grid.Row="3" Margin="0,8,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button
                                x:Name="BtnSelectAll"
                                Grid.Column="0"
                                Width="34"
                                Height="34"
                                Margin="0,0,6,0"
                                Click="BtnSelectAll_Click"
                                Style="{StaticResource NeutralIconButtonStyle}"
                                ToolTip="{DynamicResource Str_ImageViewerControl_TickEveryImage}">
                                <materialDesign:PackIcon
                                    Width="17"
                                    Height="17"
                                    Kind="CheckboxMultipleMarkedOutline" />
                            </Button>

                            <Button
                                x:Name="BtnDeselectAll"
                                Grid.Column="1"
                                Width="34"
                                Height="34"
                                Click="BtnDeselectAll_Click"
                                Style="{StaticResource NeutralIconButtonStyle}"
                                ToolTip="{DynamicResource Str_ImageViewerControl_UntickEveryImage}">
                                <materialDesign:PackIcon
                                    Width="17"
                                    Height="17"
                                    Kind="CheckboxMultipleBlankOutline" />
                            </Button>

                            <Button
                                x:Name="BtnRemoveSelected"
                                Grid.Column="3"
                                Margin="0,0,6,0"
                                Click="BtnRemoveSelected_Click"
                                ToolTip="{DynamicResource Str_ImageViewerControl_RemoveTheTickedImages}"
                                Style="{StaticResource ListToolButtonStyle}">
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    Kind="PlaylistRemove" />
                            </Button>

                            <Button
                                x:Name="BtnClearQueue"
                                Grid.Column="4"
                                Click="BtnClearQueue_Click"
                                ToolTip="{DynamicResource Str_ImageViewerControl_RemoveEveryImageFrom}"
                                Style="{StaticResource ListToolDangerButtonStyle}">
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    Kind="DeleteSweepOutline" />
                            </Button>
                        </Grid>

                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!--  Drop overlay: anywhere on the page  -->
        <Border
            x:Name="DropOverlay"
            Margin="16,8,16,16"
            Panel.ZIndex="10"
            Style="{StaticResource DropZoneStyle}">
            <Grid>
                <Rectangle
                    RadiusX="14"
                    RadiusY="14"
                    Stroke="{DynamicResource AccentColor}"
                    StrokeDashArray="6 4"
                    StrokeThickness="2" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.TrayArrowDown}" />
                    <TextBlock
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        Text="{DynamicResource Str_ImageViewerControl_DropToAddTo}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondary}"
                        Text="{DynamicResource Str_ImageConvertPDF_ImagesAndWholeFolders}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
