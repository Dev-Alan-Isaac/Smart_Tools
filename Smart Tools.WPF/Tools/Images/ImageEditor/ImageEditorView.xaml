<UserControl
    x:Class="Smart_Tools.WPF.Views.ImageEditingView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:models="clr-namespace:Smart_Tools.WPF.Models"
    x:Name="Root"
    AllowDrop="True"
    DragLeave="Root_DragLeave"
    DragOver="Root_DragOver"
    Drop="Root_Drop"
    Focusable="True"
    Loaded="Root_Loaded"
    PreviewKeyDown="Root_PreviewKeyDown">

    <!--
        Backend: Controllers/ImageEditingManager.cs (rotate/flip maths, crop
        mapping, sizes, names, folders, settings), ImageEditingManager.Run.cs
        (export batch), ImageEditingManager.Imaging.cs (Magick.NET render,
        preview/thumbnail loading); Models/ImageEditingModel.cs. This file and
        the code-behind are UI only. Edits are stored per image and applied
        when saving - the originals are never changed.
    -->

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!--  Round button on the fixed-dark preview stage  -->
        <Style x:Key="StageIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource MediaStageText}" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Background="{DynamicResource MediaChromeFill}"
                            CornerRadius="18">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MediaChromeFillHover}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource MediaChromeFillPressed}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.35" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Sidebar tool tile (icon over label)  -->
        <Style
            x:Key="ToolTileStyle"
            BasedOn="{StaticResource NeutralIconButtonStyle}"
            TargetType="Button">
            <Setter Property="Height" Value="54" />
            <Setter Property="HorizontalAlignment" Value="Stretch" />
        </Style>

        <!--  Crop mode toggle  -->
        <Style x:Key="CropToggleStyle" TargetType="ToggleButton">
            <Setter Property="Height" Value="36" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarText}" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border
                            x:Name="Bd"
                            Background="{DynamicResource SidebarInputBg}"
                            BorderBrush="{DynamicResource SidebarInputBorder}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentFill}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentFill}" />
                                <Setter Property="Foreground" Value="White" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  List: highlight the image on the stage  -->
        <Style
            x:Key="QueueRowStyle"
            BasedOn="{StaticResource {x:Type DataGridRow}}"
            TargetType="DataGridRow">
            <Style.Triggers>
                <DataTrigger Binding="{Binding IsNowShowing}" Value="True">
                    <Setter Property="Background" Value="{DynamicResource AccentColorSubtle}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Unreadable">
                    <Setter Property="Opacity" Value="0.55" />
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!--  List: thumbnail  -->
        <DataTemplate x:Key="ThumbCellTemplate" DataType="{x:Type models:ImageItem}">
            <Border
                Width="42"
                Height="42"
                Background="{DynamicResource MediaStageBg}"
                CornerRadius="8">
                <Grid>
                    <Image
                        Margin="2"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        Source="{Binding Thumbnail}"
                        Stretch="Uniform" />
                    <materialDesign:PackIcon
                        x:Name="NoThumb"
                        Width="16"
                        Height="16"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource MediaStageTextMuted}"
                        Kind="FileImageOutline"
                        Visibility="Collapsed" />
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Thumbnail}" Value="{x:Null}">
                    <Setter TargetName="NoThumb" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Unreadable">
                    <Setter TargetName="NoThumb" Property="Kind" Value="ImageOffOutline" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  List: name, size, edited / status chips  -->
        <DataTemplate x:Key="NameCellTemplate" DataType="{x:Type models:ImageItem}">
            <StackPanel VerticalAlignment="Center" ToolTip="{Binding FullPath}">
                <TextBlock
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimary}"
                    Text="{Binding Name}"
                    TextTrimming="CharacterEllipsis" />
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        VerticalAlignment="Center"
                        FontSize="11"
                        Foreground="{DynamicResource TextSecondary}"
                        Text="{Binding Dimensions}"
                        TextTrimming="CharacterEllipsis" />
                    <Border
                        Grid.Column="1"
                        Margin="6,0,0,0"
                        Padding="6,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource AccentColorSubtle}"
                        CornerRadius="8"
                        ToolTip="{Binding EditSummary}"
                        Visibility="{Binding HasEdits, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                Width="10"
                                Height="10"
                                Margin="0,0,3,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource AccentColor}"
                                Kind="PencilOutline" />
                            <TextBlock
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource AccentColor}"
                                Text="{DynamicResource Str_ImgEdit_EditedBadge}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                    <Border
                        Grid.Column="2"
                        x:Name="StatusChip"
                        Margin="6,0,0,0"
                        Padding="6,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource StatusInfoBg}"
                        CornerRadius="8"
                        ToolTip="{Binding Message}"
                        Visibility="{Binding HasStatus, Converter={StaticResource BoolToVisibility}}">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                x:Name="StatusIcon"
                                Width="10"
                                Height="10"
                                Margin="0,0,3,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource StatusInfoFg}"
                                Kind="Autorenew" />
                            <TextBlock
                                x:Name="StatusText"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource StatusInfoFg}"
                                Text="{Binding StatusText}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                    </Border>
                </Grid>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Done">
                    <Setter TargetName="StatusChip" Property="Background" Value="{DynamicResource StatusSuccessBg}" />
                    <Setter TargetName="StatusIcon" Property="Kind" Value="CheckCircleOutline" />
                    <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource StatusSuccessFg}" />
                    <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource StatusSuccessFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter TargetName="StatusChip" Property="Background" Value="{DynamicResource StatusErrorBg}" />
                    <Setter TargetName="StatusIcon" Property="Kind" Value="AlertCircleOutline" />
                    <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                    <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Unreadable">
                    <Setter TargetName="StatusChip" Property="Background" Value="{DynamicResource StatusErrorBg}" />
                    <Setter TargetName="StatusIcon" Property="Kind" Value="ImageOffOutline" />
                    <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                    <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                    <Setter TargetName="StatusChip" Property="Background" Value="{DynamicResource StatusWarningBg}" />
                    <Setter TargetName="StatusIcon" Property="Kind" Value="CloseCircleOutline" />
                    <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                    <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>


        <!--  Input card: one queued item  -->
        <DataTemplate x:Key="QueueItemTemplate" DataType="{x:Type models:ImageEditGroup}">
            <Grid ToolTip="{Binding ToolTip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="26"
                    Height="26"
                    Margin="0,0,8,0"
                    Background="{DynamicResource AccentColorSubtle}"
                    CornerRadius="7">
                    <materialDesign:PackIcon
                        x:Name="GroupIcon"
                        Width="14"
                        Height="14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource AccentColor}"
                        Kind="FileMultipleOutline" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource SidebarText}"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Margin="0,1,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource SidebarTextMuted}"
                        Text="{Binding Subtitle}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button
                    Grid.Column="2"
                    Width="24"
                    Height="24"
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    Click="BtnRemoveGroup_Click"
                    Style="{StaticResource IconButtonStyle}"
                    Tag="{Binding}"
                    ToolTip="{DynamicResource Str_BackgroundRemover_TakeTheseImagesOff}">
                    <materialDesign:PackIcon
                        Width="13"
                        Height="13"
                        Kind="Close" />
                </Button>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                    <Setter TargetName="GroupIcon" Property="Kind" Value="Folder" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">

        <!--  No page header: MainWindow's header card shows the tool's icon and name.  -->

        <Grid Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OptionsColumn" Width="280" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= OPTIONS SIDEBAR =================  -->

            <Border Grid.Column="0" Style="{StaticResource SidebarPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Button
                            x:Name="BtnCollapseOptions"
                            MinHeight="45"
                            HorizontalContentAlignment="Left"
                            Click="BtnCollapseOptions_Click"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Foreground="{DynamicResource SidebarText}"
                            ToolTip="{DynamicResource Str_Common_SidebarToggleTooltip}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="OverridesDefaultStyle" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Margin="16,0,0,0" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Kind="TuneVariant" />
                                <TextBlock
                                    x:Name="TxtOptionsHeaderLabel"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{DynamicResource Str_Common_OptionsLabel}" />
                            </StackPanel>
                        </Button>
                        <Separator
                            x:Name="SepHeader"
                            Margin="16,4"
                            Style="{StaticResource SidebarSeparatorStyle}" />
                    </StackPanel>

                    <ScrollViewer
                        x:Name="OptionsScrollViewer"
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16,4,16,16">

                            <!--  ============ FILES ============  -->
                            <controls:InputFolderCard
                                ctl:Tour.Key="Str_Tour_ImageEditor_Input" ctl:Tour.Order="1"
                                x:Name="InputCard"
                                ClearRequested="InputCard_ClearRequested"
                                Header="{DynamicResource Str_Common_Files}"
                                HeaderIcon="FileMultipleOutline"
                                IncludeSubfoldersChanged="InputCard_IncludeSubfoldersChanged"
                                ItemTemplate="{StaticResource QueueItemTemplate}"
                                PathsAdded="InputCard_PathsAdded" />


                            <!--  ============ ROTATE & FLIP ============  -->
                            <Border ctl:Tour.Key="Str_Tour_ImageEditor_Rotate" ctl:Tour.Order="2" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_ImgEdit_RotateFlipHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.RotateRight}" />
                                    <UniformGrid x:Name="TransformTools" Columns="2">
                                        <Button
                                            x:Name="BtnRotateLeft"
                                            Margin="0,0,6,6"
                                            Click="BtnRotateLeft_Click"
                                            Style="{StaticResource ToolTileStyle}"
                                            ToolTip="{DynamicResource Str_ImgEdit_RotateLeftTooltip}">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="20"
                                                    Height="20"
                                                    HorizontalAlignment="Center"
                                                    Kind="RotateLeft" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    HorizontalAlignment="Center"
                                                    FontSize="12"
                                                    Text="{DynamicResource Str_ImageEditor_Left}" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            x:Name="BtnRotateRight"
                                            Margin="0,0,6,6"
                                            Click="BtnRotateRight_Click"
                                            Style="{StaticResource ToolTileStyle}"
                                            ToolTip="{DynamicResource Str_ImgEdit_RotateRightTooltip}">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="20"
                                                    Height="20"
                                                    HorizontalAlignment="Center"
                                                    Kind="RotateRight" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    HorizontalAlignment="Center"
                                                    FontSize="12"
                                                    Text="{DynamicResource Str_ImageEditor_Right}" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            x:Name="BtnFlipHorizontal"
                                            Margin="0,0,6,6"
                                            Click="BtnFlipHorizontal_Click"
                                            Style="{StaticResource ToolTileStyle}"
                                            ToolTip="{DynamicResource Str_ImgEdit_FlipHorizontalTooltip}">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="20"
                                                    Height="20"
                                                    HorizontalAlignment="Center"
                                                    Kind="FlipHorizontal" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    HorizontalAlignment="Center"
                                                    FontSize="12"
                                                    Text="{DynamicResource Str_ImageEditor_Mirror}" />
                                            </StackPanel>
                                        </Button>
                                        <Button
                                            x:Name="BtnFlipVertical"
                                            Margin="0,0,6,6"
                                            Click="BtnFlipVertical_Click"
                                            Style="{StaticResource ToolTileStyle}"
                                            ToolTip="{DynamicResource Str_ImgEdit_FlipVerticalTooltip}">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="20"
                                                    Height="20"
                                                    HorizontalAlignment="Center"
                                                    Kind="FlipVertical" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    HorizontalAlignment="Center"
                                                    FontSize="12"
                                                    Text="{DynamicResource Str_ImageEditor_Flip}" />
                                            </StackPanel>
                                        </Button>
                                    </UniformGrid>
                                    <CheckBox
                                        x:Name="ChkApplyToAllChecked"
                                        Margin="0,10,0,0"
                                        Checked="Setting_Changed"
                                        Content="{DynamicResource Str_ImgEdit_ApplyToAllChecked}"
                                        Foreground="{DynamicResource SidebarText}"
                                        ToolTip="{DynamicResource Str_ImgEdit_ApplyToAllCheckedTooltip}"
                                        Unchecked="Setting_Changed"
                                        controls:ChoiceIcon.Kind="ShieldCheckOutline"
                                        Style="{StaticResource ToggleChipCheckBoxStyle}" />
                                </StackPanel>
                            </Border>

                            <!--  ============ CROP ============  -->
                            <Border ctl:Tour.Key="Str_Tour_ImageEditor_Crop" ctl:Tour.Order="3" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_ImgEdit_CropHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.Crop}" />
                                    <ToggleButton
                                        x:Name="BtnToggleCrop"
                                        Click="BtnToggleCrop_Click"
                                        Style="{StaticResource CropToggleStyle}"
                                        ToolTip="{DynamicResource Str_ImageEditor_DragOnThePicture}">
                                        <Grid HorizontalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon
                                                Grid.Column="0"
                                                Width="16"
                                                Height="16"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Kind="CropFree" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_ImgEdit_DrawCropArea}" TextWrapping="Wrap" />
                                        </Grid>
                                    </ToggleButton>
                                    <TextBlock
                                        Margin="0,12,0,6"
                                        Style="{StaticResource FieldLabel}"
                                        Text="{DynamicResource Str_ImageEditor_Shape}" />
                                    <StackPanel>
                                        <!--  Top row: Full-width Free option  -->
                                        <RadioButton
                                            Margin="0,0,0,4"
                                            HorizontalAlignment="Stretch"
                                            Click="CropAspect_Click"
                                            Content="{DynamicResource Str_ImageEditor_Free}"
                                            FontSize="11"
                                            GroupName="CropAspect"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="Free"
                                            ToolTip="{DynamicResource Str_ImageEditor_AnyShape}" />

                                        <!--  Bottom row: 2x2 Grid for the remaining 4 options  -->
                                        <UniformGrid x:Name="CropAspectChips" Columns="2">
                                            <RadioButton
                                                Margin="0,0,2,2"
                                                Click="CropAspect_Click"
                                                Content="1:1"
                                                FontSize="11"
                                                GroupName="CropAspect"
                                                Style="{StaticResource ModeToggleButtonStyle}"
                                                Tag="1:1"
                                                ToolTip="{DynamicResource Str_ImageEditor_Square}" />
                                            <RadioButton
                                                Margin="2,0,0,2"
                                                Click="CropAspect_Click"
                                                Content="4:3"
                                                FontSize="11"
                                                GroupName="CropAspect"
                                                Style="{StaticResource ModeToggleButtonStyle}"
                                                Tag="4:3" />
                                            <RadioButton
                                                Margin="0,2,2,0"
                                                Click="CropAspect_Click"
                                                Content="3:2"
                                                FontSize="11"
                                                GroupName="CropAspect"
                                                Style="{StaticResource ModeToggleButtonStyle}"
                                                Tag="3:2" />
                                            <RadioButton
                                                Margin="2,2,0,0"
                                                Click="CropAspect_Click"
                                                Content="16:9"
                                                FontSize="11"
                                                GroupName="CropAspect"
                                                Style="{StaticResource ModeToggleButtonStyle}"
                                                Tag="16:9" />
                                        </UniformGrid>
                                    </StackPanel>
                                    <UniformGrid Margin="0,10,0,0" Columns="2">
                                        <!--  Apply Button  -->
                                        <Button
                                            x:Name="BtnApplyCrop"
                                            Margin="0,0,3,0"
                                            HorizontalAlignment="Stretch"
                                            Click="BtnApplyCrop_Click"
                                            IsEnabled="False"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            ToolTip="{DynamicResource Str_ImageEditor_KeepTheSelectedArea}">
                                            <Grid HorizontalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource Str_ImgEdit_ApplyCrop}" TextWrapping="Wrap" />
                                            </Grid>
                                        </Button>

                                        <!--  Clear Button (Now sharing PrimaryButtonStyle for identical sizing)  -->
                                        <Button
                                            x:Name="BtnClearCrop"
                                            Margin="3,0,0,0"
                                            HorizontalAlignment="Stretch"
                                            Click="BtnClearCrop_Click"
                                            IsEnabled="False"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            ToolTip="{DynamicResource Str_ImageEditor_RemoveTheCrop}">
                                            <Grid HorizontalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <TextBlock Grid.Column="0" VerticalAlignment="Center" Text="{DynamicResource Str_ImgEdit_ClearCrop}" TextWrapping="Wrap" />
                                            </Grid>
                                        </Button>
                                    </UniformGrid>
                                    <TextBlock
                                        x:Name="TxtCropHint"
                                        Margin="0,8,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource SidebarTextMuted}"
                                        Text="{DynamicResource Str_ImageEditor_CropWorksOnThe}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!--  ============ RESIZE ============  -->
                            <Border Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_ImgEdit_ResizeHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.ImageSizeSelectLarge}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock
                                                Margin="0,4,0,6"
                                                Style="{StaticResource FieldLabel}"
                                                Text="{DynamicResource Str_ImgEdit_WidthLabel}" />
                                            <TextBox
                                                x:Name="TxtResizeWidth"
                                                PreviewTextInput="Digits_PreviewTextInput"
                                                TextChanged="Resize_TextChanged"
                                                ToolTip="{DynamicResource Str_ImgEdit_ResizeWidthTooltip}" />
                                        </StackPanel>
                                        <TextBlock
                                            Grid.Column="1"
                                            Margin="8,18,8,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource SidebarTextMuted}"
                                            Text="×" />
                                        <StackPanel Grid.Column="2">
                                            <TextBlock
                                                Margin="0,4,0,6"
                                                Style="{StaticResource FieldLabel}"
                                                Text="{DynamicResource Str_ImgEdit_HeightLabel}" />
                                            <TextBox
                                                x:Name="TxtResizeHeight"
                                                PreviewTextInput="Digits_PreviewTextInput"
                                                TextChanged="Resize_TextChanged"
                                                ToolTip="{DynamicResource Str_ImgEdit_ResizeHeightTooltip}" />
                                        </StackPanel>
                                    </Grid>
                                    <CheckBox
                                        x:Name="ChkMaintainAspect"
                                        Margin="0,10,0,0"
                                        Checked="Resize_Changed"
                                        Content="{DynamicResource Str_ImgEdit_MaintainAspectRatio}"
                                        Foreground="{DynamicResource SidebarText}"
                                        IsChecked="True"
                                        ToolTip="{DynamicResource Str_ImageEditor_FitInsideTheWidth}"
                                        Unchecked="Resize_Changed"
                                        controls:ChoiceIcon.Kind="FitToPageOutline"
                                        Style="{StaticResource ToggleChipCheckBoxStyle}" />
                                    <CheckBox
                                        x:Name="ChkAllowEnlarge"
                                        Margin="0,8,0,0"
                                        Checked="Resize_Changed"
                                        Content="{DynamicResource Str_ImageEditor_EnlargeSmallerImages}"
                                        Foreground="{DynamicResource SidebarText}"
                                        ToolTip="{DynamicResource Str_ImageEditor_OffImagesAlreadySmaller}"
                                        Unchecked="Resize_Changed"
                                        controls:ChoiceIcon.Kind="ArrowExpandAll"
                                        Style="{StaticResource ToggleChipCheckBoxStyle}" />
                                    <TextBlock
                                        x:Name="TxtResizeHint"
                                        Margin="0,8,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource SidebarTextMuted}"
                                        Text="{DynamicResource Str_ImageEditor_LeaveEmptyToKeep}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!--  ============ SAVE AS ============  -->
                            <Border Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_MicRecorder_OutputHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.ContentSaveOutline}" />
                                    <TextBlock
                                        Margin="0,4,0,6"
                                        Style="{StaticResource FieldLabel}"
                                        Text="{DynamicResource Str_VideoEditor_Format}" />
                                    <UniformGrid x:Name="FormatChips" Columns="3">
                                        <RadioButton
                                            Margin="0,0,2,4"
                                            Click="Format_Click"
                                            Content="{DynamicResource Str_BackgroundRemover_Jpg}"
                                            GroupName="Format"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="Jpg"
                                            ToolTip="{DynamicResource Str_ImageEditor_PhotosSmallFiles}" />
                                        <RadioButton
                                            Margin="2,0,2,4"
                                            Click="Format_Click"
                                            Content="{DynamicResource Str_BarcodeGenerator_Png}"
                                            GroupName="Format"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="Png"
                                            ToolTip="{DynamicResource Str_FileConverter_LosslessKeepsTransparency}" />
                                        <RadioButton
                                            Margin="2,0,0,4"
                                            Click="Format_Click"
                                            Content="{DynamicResource Str_BackgroundRemover_Webp}"
                                            GroupName="Format"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="Webp"
                                            ToolTip="{DynamicResource Str_ImageEditor_SmallerThanJpgKeeps}" />
                                        <RadioButton
                                            Margin="0,0,2,0"
                                            Click="Format_Click"
                                            Content="{DynamicResource Str_FileConverter_Bmp}"
                                            GroupName="Format"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="Bmp" />
                                        <RadioButton
                                            Margin="2,0"
                                            Click="Format_Click"
                                            Content="{DynamicResource Str_FileConverter_Gif}"
                                            GroupName="Format"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="Gif"
                                            ToolTip="{DynamicResource Str_ImageEditor_256Colours}" />
                                        <RadioButton
                                            Margin="2,0,0,0"
                                            Click="Format_Click"
                                            Content="{DynamicResource Str_FileConverter_Tiff}"
                                            GroupName="Format"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="Tiff"
                                            ToolTip="{DynamicResource Str_ImageEditor_LosslessForPrint}" />
                                    </UniformGrid>

                                    <StackPanel x:Name="PanelQuality" Margin="0,12,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                Style="{StaticResource FieldLabel}"
                                                Text="{DynamicResource Str_Convert_QualityLabel}" />
                                            <Border
                                                Grid.Column="1"
                                                Background="{DynamicResource AccentColorSubtle}"
                                                Style="{StaticResource IconStatusPillStyle}">
                                                <TextBlock
                                                    x:Name="TxtQualityValue"
                                                    FontSize="11.5"
                                                    FontWeight="Bold"
                                                    Foreground="{DynamicResource AccentColor}"
                                                    Text="90" />
                                            </Border>
                                        </Grid>
                                        <Slider
                                            x:Name="SliderQuality"
                                            Margin="0,4,0,0"
                                            IsSnapToTickEnabled="True"
                                            LargeChange="5"
                                            Maximum="100"
                                            Minimum="40"
                                            SmallChange="1"
                                            TickFrequency="1"
                                            ToolTip="{DynamicResource Str_ImageEditor_HigherSharperAndBigger}"
                                            ValueChanged="SliderQuality_ValueChanged"
                                            Value="90" />
                                    </StackPanel>

                                    <TextBlock
                                        Margin="0,12,0,6"
                                        Style="{StaticResource FieldLabel}"
                                        Text="{DynamicResource Str_ImageEditor_AddToFileNames}" />
                                    <TextBox
                                        x:Name="TxtNameSuffix"
                                        Text="_edited"
                                        TextChanged="NameSuffix_TextChanged"
                                        ToolTip="{DynamicResource Str_ImageEditor_AddedBeforeTheExtension}" />
                                    <TextBlock
                                        x:Name="TxtNameExample"
                                        Margin="0,6,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource SidebarTextMuted}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Border>

                            <!--  ============ SAVE TO ============  -->
                            <!--  The shared Output card (folder for this session only).  -->
                            <controls:OutputFolderCard
                                ctl:Tour.Key="Str_Tour_ImageEditor_Output" ctl:Tour.Order="4"
                                x:Name="OutputCard"
                                Margin="0,10,0,0"
                                Header="{DynamicResource Str_BackgroundRemover_SaveTo}"
                                HeaderIcon="ContentSaveOutline"
                                ToolName="Image Editor" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--  ================= MAIN AREA =================  -->

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Run bar  -->
                <Border Margin="0,0,0,14" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            ctl:Tour.Key="Str_Tour_ImageEditor_Run" ctl:Tour.Order="5"
                            x:Name="BtnRunAction"
                            MinWidth="180"
                            VerticalAlignment="Center"
                            Click="BtnRunAction_Click"
                            Style="{StaticResource AccentPrimaryButtonStyle}"
                            ToolTip="{DynamicResource Str_ImgEdit_ExportButtonTooltip}">
                            <Grid HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon
                                    Grid.Column="0"
                                    x:Name="IconRun"
                                    Width="18"
                                    Height="18"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Kind="ContentSaveAllOutline" />
                                <TextBlock
                                    Grid.Column="1"
                                    x:Name="TxtRunLabel"
                                    VerticalAlignment="Center"
                                    Text="{DynamicResource Str_ImgEdit_ExportButton}" TextWrapping="Wrap" />
                            </Grid>
                        </Button>
                        <Button
                            x:Name="BtnOpenOutput"
                            Grid.Column="1"
                            Margin="8,0,16,0"
                            VerticalAlignment="Center"
                            Click="BtnOpenOutput_Click"
                            ToolTip="{DynamicResource Str_ImageEditor_OpenTheFolderThe}"
                            Style="{StaticResource ListToolButtonStyle}">
                            <materialDesign:PackIcon
                                Width="16"
                                Height="16"
                                Kind="FolderOpenOutline" />
                        </Button>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center">
                            <ProgressBar
                                x:Name="ProgressEdit"
                                Height="8"
                                Maximum="100" />
                            <TextBlock
                                x:Name="TxtProgress"
                                Margin="0,6,0,0"
                                FontSize="11.5"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="{DynamicResource Str_ImgEdit_ProgressInitial}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock
                            x:Name="TxtProgressPercent"
                            Grid.Column="3"
                            MinWidth="54"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="{DynamicResource AccentColor}"
                            TextAlignment="Right" />
                    </Grid>
                </Border>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition x:Name="QueueColumn" Width="400" />
                    </Grid.ColumnDefinitions>

                    <!--  ================= PREVIEW =================  -->
                    <Border ctl:Tour.Key="Str_Tour_ImageEditor_Preview" ctl:Tour.Order="6" Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock
                                        x:Name="TxtNowShowing"
                                        FontSize="14"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource TextPrimary}"
                                        Text="{DynamicResource Str_Common_NothingLoaded}"
                                        TextTrimming="CharacterEllipsis" />
                                    <TextBlock
                                        x:Name="TxtNowShowingMeta"
                                        Margin="0,2,0,0"
                                        FontSize="11.5"
                                        Foreground="{DynamicResource TextSecondary}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel
                                    Grid.Column="1"
                                    HorizontalAlignment="Right"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal">
                                <Border
                                    x:Name="EditSummaryPill"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource AccentColorSubtle}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource AccentColor}"
                                            Kind="PencilOutline" />
                                        <TextBlock
                                            x:Name="TxtEditSummary"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource AccentColor}" />
                                    </StackPanel>
                                </Border>
                                    <Button
                                        x:Name="BtnUndo"
                                        Margin="0,0,4,0"
                                        Click="BtnUndo_Click"
                                        IsEnabled="False"
                                        Style="{StaticResource ListToolButtonStyle}"
                                        ToolTip="{DynamicResource Str_ImageEditor_Undo}">
                                        <materialDesign:PackIcon Width="17" Height="17" Kind="UndoVariant" />
                                    </Button>
                                    <Button
                                        x:Name="BtnRedo"
                                        Margin="0,0,10,0"
                                        Click="BtnRedo_Click"
                                        IsEnabled="False"
                                        Style="{StaticResource ListToolButtonStyle}"
                                        ToolTip="{DynamicResource Str_ImageEditor_Redo}">
                                        <materialDesign:PackIcon Width="17" Height="17" Kind="RedoVariant" />
                                    </Button>
                                    <Button
                                        x:Name="BtnResetTransform"
                                        Click="BtnResetTransform_Click"
                                        Style="{StaticResource ListToolButtonStyle}"
                                        ToolTip="{DynamicResource Str_ImageEditor_UndoTheRotationMirroring}">
                                        <materialDesign:PackIcon Width="17" Height="17" Kind="Restore" />
                                    </Button>
                                </StackPanel>
                            </Grid>

                            <!--  Fixed-dark stage: the picture should look the same in both themes.  -->
                            <Border
                                x:Name="PreviewStage"
                                Grid.Row="1"
                                Background="{DynamicResource MediaStageBg}"
                                ClipToBounds="True"
                                CornerRadius="12"
                                SizeChanged="PreviewStage_SizeChanged">
                                <Grid>
                                    <Viewbox
                                        Margin="16"
                                        Stretch="Uniform"
                                        StretchDirection="Both">
                                        <Image
                                            x:Name="PreviewImage"
                                            RenderOptions.BitmapScalingMode="HighQuality"
                                            Stretch="None" />
                                    </Viewbox>

                                    <!--  Drawn in screen pixels over the picture's bounds (outside the Viewbox, so lines stay crisp).  -->
                                    <Canvas
                                        x:Name="OverlayCanvas"
                                        Background="Transparent"
                                        IsHitTestVisible="False"
                                        MouseLeftButtonDown="OverlayCanvas_MouseLeftButtonDown"
                                        MouseLeftButtonUp="OverlayCanvas_MouseLeftButtonUp"
                                        MouseMove="OverlayCanvas_MouseMove">
                                        <Path
                                            x:Name="CropMask"
                                            Fill="#000000"
                                            IsHitTestVisible="False"
                                            Opacity="0.55"
                                            Visibility="Collapsed" />
                                        <Rectangle
                                            x:Name="CropRectVisual"
                                            IsHitTestVisible="False"
                                            Stroke="White"
                                            StrokeThickness="1.5"
                                            Visibility="Collapsed" />
                                        <Border
                                            x:Name="CropSizeBadge"
                                            Padding="7,2"
                                            Background="{DynamicResource MediaChromeBg}"
                                            CornerRadius="8"
                                            IsHitTestVisible="False"
                                            Visibility="Collapsed">
                                            <TextBlock
                                                x:Name="TxtCropSize"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="White" />
                                        </Border>
                                    </Canvas>

                                    <StackPanel
                                        x:Name="NoImagePanel"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        IsHitTestVisible="False">
                                        <materialDesign:PackIcon
                                            Width="40"
                                            Height="40"
                                            HorizontalAlignment="Center"
                                            Foreground="{DynamicResource MediaStageTextMuted}"
                                            Kind="ImageEditOutline" />
                                        <TextBlock
                                            Margin="0,10,0,0"
                                            HorizontalAlignment="Center"
                                            FontSize="12.5"
                                            Foreground="{DynamicResource MediaStageTextSubtle}"
                                            Text="{DynamicResource Str_ImgEdit_PreviewEmptyHint}"
                                            TextAlignment="Center"
                                            TextWrapping="Wrap" />
                                    </StackPanel>

                                    <!--  Crop mode banner  -->
                                    <Border
                                        x:Name="CropBanner"
                                        Margin="0,12,0,0"
                                        Padding="12,6"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource MediaPanelBg}"
                                        CornerRadius="12"
                                        IsHitTestVisible="False"
                                        Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon
                                                Width="14"
                                                Height="14"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Foreground="White"
                                                Kind="CropFree" />
                                            <TextBlock
                                                FontSize="11.5"
                                                Foreground="White"
                                                Text="{DynamicResource Str_ImageEditor_DragToSelectEnter}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                            </Border>

                            <!--  Prev / counter / next  -->
                            <Border
                                Grid.Row="2"
                                Margin="0,10,0,0"
                                Padding="8"
                                Background="{DynamicResource MediaStageBg}"
                                CornerRadius="12">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Button
                                        x:Name="BtnPrevious"
                                        Click="BtnPrevious_Click"
                                        Style="{StaticResource StageIconButtonStyle}"
                                        ToolTip="{DynamicResource Str_ImgEdit_PrevImageTooltip}">
                                        <materialDesign:PackIcon
                                            Width="20"
                                            Height="20"
                                            Kind="ChevronLeft" />
                                    </Button>
                                    <StackPanel
                                        Grid.Column="1"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Orientation="Horizontal">
                                        <Button
                                            Margin="0,0,6,0"
                                            Click="BtnRotateLeft_Click"
                                            Style="{StaticResource StageIconButtonStyle}"
                                            ToolTip="{DynamicResource Str_ImageEditor_RotateLeftShiftR}">
                                            <materialDesign:PackIcon
                                                Width="17"
                                                Height="17"
                                                Kind="RotateLeft" />
                                        </Button>
                                        <TextBlock
                                            x:Name="TxtPosition"
                                            MinWidth="70"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource MediaStageText}"
                                            TextAlignment="Center" />
                                        <Button
                                            Margin="6,0,0,0"
                                            Click="BtnRotateRight_Click"
                                            Style="{StaticResource StageIconButtonStyle}"
                                            ToolTip="{DynamicResource Str_ImageEditor_RotateRightR}">
                                            <materialDesign:PackIcon
                                                Width="17"
                                                Height="17"
                                                Kind="RotateRight" />
                                        </Button>
                                    </StackPanel>
                                    <Button
                                        x:Name="BtnNext"
                                        Grid.Column="2"
                                        Click="BtnNext_Click"
                                        Style="{StaticResource StageIconButtonStyle}"
                                        ToolTip="{DynamicResource Str_ImgEdit_NextImageTooltip}">
                                        <materialDesign:PackIcon
                                            Width="20"
                                            Height="20"
                                            Kind="ChevronRight" />
                                    </Button>
                                </Grid>
                            </Border>
                        </Grid>
                    </Border>

                    <!--  Collapse strip  -->
                    <Button
                        x:Name="BtnToggleQueue"
                        Grid.Column="1"
                        Width="26"
                        Margin="6,0"
                        Click="BtnToggleQueue_Click"
                        Style="{StaticResource PanelToggleButtonStyle}"
                        ToolTip="{DynamicResource Str_ImgEdit_ToggleQueueTooltip}">
                        <materialDesign:PackIcon
                            x:Name="IconToggleQueue"
                            Width="20"
                            Height="20"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Foreground="White"
                            Kind="ChevronRight" />
                    </Button>

                    <!--  ================= IMAGE LIST =================  -->
                    <Border
                        x:Name="QueuePanel"
                        Grid.Column="2"
                        Style="{StaticResource CardStyle}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentControl
                                    VerticalAlignment="Center"
                                    Content="{DynamicResource Str_ImgEdit_ImagesLabel}"
                                    Style="{StaticResource CardHeader}"
                                    Tag="{x:Static materialDesign:PackIconKind.ImageMultipleOutline}" />
                                <Border
                                    x:Name="SummaryPill"
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    Background="{DynamicResource StatusInfoBg}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        x:Name="TxtSummaryCount"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource StatusInfoFg}" />
                                </Border>
                            </Grid>

                            <StackPanel
                                x:Name="ListTools"
                                Grid.Row="1"
                                Margin="0,0,0,10"
                                Orientation="Horizontal">
                                <Button Padding="0"
                                    x:Name="BtnMoveUp"
                                    Width="32"
                                    Height="32"
                                    Click="BtnMoveUp_Click"
                                    Style="{StaticResource NeutralIconButtonStyle}"
                                    ToolTip="{DynamicResource Str_ImageViewerControl_MoveEarlier}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="ArrowUp" />
                                </Button>
                                <Button Padding="0"
                                    x:Name="BtnMoveDown"
                                    Width="32"
                                    Height="32"
                                    Margin="4,0,0,0"
                                    Click="BtnMoveDown_Click"
                                    Style="{StaticResource NeutralIconButtonStyle}"
                                    ToolTip="{DynamicResource Str_ImageViewerControl_MoveLater}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="ArrowDown" />
                                </Button>
                                <Button Padding="0"
                                    x:Name="BtnSortByName"
                                    Width="32"
                                    Height="32"
                                    Margin="10,0,0,0"
                                    Click="BtnSortByName_Click"
                                    Style="{StaticResource NeutralIconButtonStyle}"
                                    ToolTip="{DynamicResource Str_ImageViewerControl_SortByName}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="SortAlphabeticalAscending" />
                                </Button>
                                <Button Padding="0"
                                    x:Name="BtnSortByDate"
                                    Width="32"
                                    Height="32"
                                    Margin="4,0,0,0"
                                    Click="BtnSortByDate_Click"
                                    Style="{StaticResource NeutralIconButtonStyle}"
                                    ToolTip="{DynamicResource Str_PdfToolkit_DateOrderOldestFirst}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="SortCalendarAscending" />
                                </Button>
                            </StackPanel>

                            <Grid Grid.Row="2">
                                <DataGrid
                                    x:Name="DataGridQueue"
                                    AutoGenerateColumns="False"
                                    CanUserAddRows="False"
                                    CanUserSortColumns="False"
                                    FontSize="12"
                                    HeadersVisibility="None"
                                    IsReadOnly="True"
                                    MinRowHeight="56"
                                    RowStyle="{StaticResource QueueRowStyle}"
                                    SelectionChanged="DataGridQueue_SelectionChanged"
                                    SelectionMode="Single"
                                    VirtualizingPanel.IsVirtualizing="True"
                                    VirtualizingPanel.ScrollUnit="Pixel"
                                    VirtualizingPanel.VirtualizationMode="Recycling">
                                    <DataGrid.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Click="MenuShowInFolder_Click">
                                                <MenuItem.Header>
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon
                                                            Width="15"
                                                            Height="15"
                                                            Margin="0,0,8,0"
                                                            VerticalAlignment="Center"
                                                            Kind="FolderOpenOutline" />
                                                        <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_Validate_MenuShowInFolder}" />
                                                    </StackPanel>
                                                </MenuItem.Header>
                                            </MenuItem>
                                            <MenuItem Click="MenuDeleteFile_Click">
                                                <MenuItem.Header>
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon
                                                            Width="15"
                                                            Height="15"
                                                            Margin="0,0,8,0"
                                                            VerticalAlignment="Center"
                                                            Kind="DeleteOutline" />
                                                        <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_VideoReplay_DeleteFile}" />
                                                    </StackPanel>
                                                </MenuItem.Header>
                                            </MenuItem>
                                        </ContextMenu>
                                    </DataGrid.ContextMenu>
                                    <DataGrid.Columns>
                                        <DataGridTemplateColumn Width="34" CellStyle="{StaticResource CheckBoxCellStyle}">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <CheckBox
                                                        Checked="ItemCheckBox_Changed"
                                                        IsChecked="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        Style="{StaticResource DataGridCheckBoxStyle}"
                                                        ToolTip="{DynamicResource Str_ImgEdit_IncludeImageTooltip}"
                                                        Unchecked="ItemCheckBox_Changed" />
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                        <DataGridTemplateColumn
                                            Width="52"
                                            CellStyle="{StaticResource CompactCellStyle}"
                                            CellTemplate="{StaticResource ThumbCellTemplate}" />
                                        <DataGridTemplateColumn Width="*" CellTemplate="{StaticResource NameCellTemplate}" />
                                        <DataGridTemplateColumn Width="38" CellStyle="{StaticResource CompactCellStyle}">
                                            <DataGridTemplateColumn.CellTemplate>
                                                <DataTemplate>
                                                    <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                                                        <Button
                                                            Width="24"
                                                            Height="24"
                                                            Click="BtnRemoveFromQueue_Click"
                                                            Style="{StaticResource IconButtonStyle}"
                                                            ToolTip="{DynamicResource Str_ImgEdit_RemoveFromListTooltip}">
                                                            <materialDesign:PackIcon
                                                                Width="13"
                                                                Height="13"
                                                                Foreground="{DynamicResource StatusErrorFg}"
                                                                Kind="Close" />
                                                        </Button>
                                                    </StackPanel>
                                                </DataTemplate>
                                            </DataGridTemplateColumn.CellTemplate>
                                        </DataGridTemplateColumn>
                                    </DataGrid.Columns>
                                </DataGrid>

                                <controls:EmptyStateCard
                                    x:Name="EmptyStatePanel"
                                    Description="{DynamicResource Str_Common_DragDropHint}"
                                    DescriptionMaxWidth="260"
                                    Icon="ImageMultipleOutline"
                                    IsHitTestVisible="False" />
                            </Grid>

                            <!--  ============ PLAYLIST ACTIONS ============  -->
                            <Grid Grid.Row="3" Margin="0,8,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <Button Padding="0"
                                    x:Name="BtnSelectAll"
                                    Grid.Column="0"
                                    Width="34"
                                    Height="34"
                                    Margin="0,0,6,0"
                                    Click="BtnSelectAll_Click"
                                    Style="{StaticResource NeutralIconButtonStyle}"
                                    ToolTip="{DynamicResource Str_Common_SelectAll}">
                                    <materialDesign:PackIcon
                                        Width="17"
                                        Height="17"
                                        Kind="CheckboxMultipleMarkedOutline" />
                                </Button>

                                <Button Padding="0"
                                    x:Name="BtnDeselectAll"
                                    Grid.Column="1"
                                    Width="34"
                                    Height="34"
                                    Click="BtnDeselectAll_Click"
                                    Style="{StaticResource NeutralIconButtonStyle}"
                                    ToolTip="{DynamicResource Str_Common_DeselectAll}">
                                    <materialDesign:PackIcon
                                        Width="17"
                                        Height="17"
                                        Kind="CheckboxMultipleBlankOutline" />
                                </Button>

                                <Button
                                    x:Name="BtnRemoveSelected"
                                    Grid.Column="3"
                                    Margin="0,0,6,0"
                                    Click="BtnRemoveSelected_Click"
                                    ToolTip="{DynamicResource Str_ImageViewerControl_RemoveTheTickedImages}"
                                    Style="{StaticResource ListToolButtonStyle}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="PlaylistRemove" />
                                </Button>

                                <Button
                                    x:Name="BtnClearAll"
                                    Grid.Column="4"
                                    Click="BtnClearAll_Click"
                                    ToolTip="{DynamicResource Str_ImageEditor_EmptyTheListThe}"
                                    Style="{StaticResource ListToolDangerButtonStyle}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="DeleteSweepOutline" />
                                </Button>
                            </Grid>
                        </Grid>
                    </Border>

                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
