<UserControl
    x:Class="Smart_Tools.WPF.Views.VoiceChangerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:models="clr-namespace:Smart_Tools.WPF.Models"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    x:Name="Root"
    AllowDrop="True"
    DragLeave="Root_DragLeave"
    DragOver="Root_DragOver"
    Drop="Root_Drop"
    Loaded="Root_Loaded"
    Unloaded="Root_Unloaded">

    <!--
        Backend: Controllers/VoiceChangerManager.cs (rendering files, the live
        microphone chain, playback - effects from Controllers/
        VoiceChangerDsp.cs) + VoiceChangerManager.Files.cs (finding files, the
        Files card list, names, clipping guard, settings); Models/
        VoiceChangerModel.cs. UI only here.
    -->

    <UserControl.Resources>



        <!--  Input card: one queued item  -->
        <DataTemplate x:Key="QueueItemTemplate" DataType="{x:Type models:VoiceChangerGroup}">
            <Grid ToolTip="{Binding ToolTip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="26"
                    Height="26"
                    Margin="0,0,8,0"
                    Background="{DynamicResource AccentColorSubtle}"
                    CornerRadius="7">
                    <materialDesign:PackIcon
                        x:Name="GroupIcon"
                        Width="14"
                        Height="14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource AccentColor}"
                        Kind="FileMultipleOutline" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource SidebarText}"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Margin="0,1,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource SidebarTextMuted}"
                        Text="{Binding Subtitle}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button
                    Grid.Column="2"
                    Width="24"
                    Height="24"
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    Click="BtnRemoveGroup_Click"
                    Style="{StaticResource IconButtonStyle}"
                    Tag="{Binding}"
                    ToolTip="{DynamicResource Str_VoiceChanger_TakeTheseAudioFiles}">
                    <materialDesign:PackIcon
                        Width="13"
                        Height="13"
                        Kind="Close" />
                </Button>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                    <Setter TargetName="GroupIcon" Property="Kind" Value="Folder" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">

        <!--  No page header: MainWindow's header card shows the tool's icon and name.  -->

        <Grid Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OptionsColumn" Width="290" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Filled by a tool hub (Speech / Audio Editor / Voice Studio) with its tab strip; empty and zero-height when the tool is opened alone  -->
            <ContentPresenter x:Name="HubTabsHost" Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="1" />


            <!--  ================= SIDEBAR =================  -->

            <Border Grid.RowSpan="2" Grid.Column="0" Style="{StaticResource SidebarPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Button
                            x:Name="BtnCollapseOptions"
                            MinHeight="45"
                            HorizontalContentAlignment="Left"
                            Click="BtnCollapseOptions_Click"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Foreground="{DynamicResource SidebarText}"
                            ToolTip="{DynamicResource Str_Common_SidebarToggleTooltip}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="OverridesDefaultStyle" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Margin="16,0,0,0" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Kind="TuneVariant" />
                                <TextBlock
                                    x:Name="TxtOptionsHeaderLabel"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{DynamicResource Str_Common_OptionsLabel}" />
                            </StackPanel>
                        </Button>

                        <Separator
                            x:Name="SepHeader"
                            Margin="16,4"
                            Style="{StaticResource SidebarSeparatorStyle}" />
                    </StackPanel>

                    <ScrollViewer
                        x:Name="OptionsScrollViewer"
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16">

                            <!--  ============ SOURCE ============  -->
                            <Border ctl:Tour.Key="Str_Tour_VoiceChanger_Source" ctl:Tour.Order="1" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_VoiceChanger_ChangeTheVoiceIn}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.SwapHorizontal}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <RadioButton
                                            x:Name="RadioModeFiles"
                                            Click="Mode_Click"
                                            GroupName="VoiceChangerMode"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            ToolTip="{DynamicResource Str_VoiceChanger_MakeAChangedCopy}">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="20"
                                                    Height="20"
                                                    HorizontalAlignment="Center"
                                                    Kind="FileMusicOutline" />
                                                <TextBlock
                                                    Margin="0,4,0,0"
                                                    HorizontalAlignment="Center"
                                                    Text="{DynamicResource Str_Validate_AudioFiles}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="RadioModeLive"
                                            Grid.Column="2"
                                            Click="Mode_Click"
                                            GroupName="VoiceChangerMode"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            ToolTip="{DynamicResource Str_VoiceChanger_ChangeYourMicrophoneAs}">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="20"
                                                    Height="20"
                                                    HorizontalAlignment="Center"
                                                    Kind="Microphone" />
                                                <TextBlock
                                                    Margin="0,4,0,0"
                                                    HorizontalAlignment="Center"
                                                    Text="{DynamicResource Str_VoiceChanger_LiveMic}" />
                                            </StackPanel>
                                        </RadioButton>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <StackPanel x:Name="FilesCard">
                                <!--
                                    ============ FILES ============
                                    Same card as Validate Data, Convert Files and Images to PDF: drop area
                                    listing what was added (one row per folder, one for loose
                                    files), Add files / Add folder / Clear, Include subfolders.
                                -->
                                <controls:InputFolderCard
                                    ctl:Tour.Key="Str_Tour_VoiceChanger_Input"
                                    ctl:Tour.Order="2"
                                    x:Name="InputCard"
                                    ClearRequested="InputCard_ClearRequested"
                                    Header="{DynamicResource Str_Common_Files}"
                                    HeaderIcon="FileMultipleOutline"
                                    IncludeSubfoldersChanged="InputCard_IncludeSubfoldersChanged"
                                    ItemTemplate="{StaticResource QueueItemTemplate}"
                                    PathsAdded="InputCard_PathsAdded" />

                            </StackPanel>

                            <!--  ============ LIVE MIC ============  -->
                            <Border
                                x:Name="LiveMicGroup"
                                Style="{StaticResource SidebarGroupCardStyle}"
                                Visibility="Collapsed">
                                <StackPanel>
                                    <Grid>
                                        <ContentControl
                                            Content="{DynamicResource Str_MicRecorder_Device}"
                                            Style="{StaticResource SidebarGroupHeader}"
                                            Tag="{x:Static materialDesign:PackIconKind.MicrophoneOutline}" />
                                        <Button
                                            x:Name="BtnRefreshDevices"
                                            Margin="0,-6,0,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Click="BtnRefreshDevices_Click"
                                            Style="{StaticResource ListToolButtonStyle}"
                                            ToolTip="{DynamicResource Str_InstrumentTuner_LookAgainAfterPlugging}">
                                            <materialDesign:PackIcon
                                                x:Name="IconRefresh"
                                                Width="15"
                                                Height="15"
                                                Kind="Refresh"
                                                RenderTransformOrigin="0.5,0.5" />
                                        </Button>
                                    </Grid>
                                    <Border Style="{StaticResource InputBarStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon
                                                Width="16"
                                                Height="16"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource TextSecondary}"
                                                Kind="Microphone" />
                                            <ComboBox
                                                x:Name="DeviceCombo"
                                                Grid.Column="1"
                                                Margin="4,0,4,0"
                                                DisplayMemberPath="Name"
                                                SelectionChanged="DeviceCombo_SelectionChanged"
                                                Style="{StaticResource BareComboBox}"
                                                ToolTip="{DynamicResource Str_VoiceChanger_TheMicrophoneToChange}" />
                                        </Grid>
                                    </Border>
                                    <TextBlock
                                        x:Name="TxtDeviceHint"
                                        Style="{StaticResource SidebarHint}"
                                        Text="{DynamicResource Str_VoiceChanger_UseHeadphonesFromSpeakers}" />

                                    <!--
                                        Send to: the default speakers, or a virtual audio cable
                                        (e.g. VB-Audio "CABLE Input") so Discord, Zoom, OBS...
                                        can pick the changed voice as their microphone.
                                    -->
                                    <TextBlock
                                        Margin="0,12,0,6"
                                        Style="{StaticResource FieldLabel}"
                                        Text="{DynamicResource Str_VoiceChanger_SendTheChangedVoice}" />
                                    <Border Style="{StaticResource InputBarStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon
                                                x:Name="IconOutput"
                                                Width="16"
                                                Height="16"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource TextSecondary}"
                                                Kind="Speaker" />
                                            <ComboBox
                                                x:Name="OutputCombo"
                                                Grid.Column="1"
                                                Margin="4,0,4,0"
                                                DisplayMemberPath="Name"
                                                SelectionChanged="OutputCombo_SelectionChanged"
                                                Style="{StaticResource BareComboBox}"
                                                ToolTip="{DynamicResource Str_VoiceChanger_PickAVirtualCable}" />
                                        </Grid>
                                    </Border>
                                    <CheckBox
                                        x:Name="ChkHearYourself"
                                        Margin="0,8,0,0"
                                        Checked="HearYourself_Changed"
                                        Content="{DynamicResource Str_VoiceChanger_HearYourselfToo}"
                                        Foreground="{DynamicResource SidebarText}"
                                        IsChecked="True"
                                        ToolTip="{DynamicResource Str_VoiceChanger_WhileTheVoiceGoes}"
                                        Unchecked="HearYourself_Changed" />

                                    <!--  What to pick in the other app - or how to get a cable  -->
                                    <Border
                                        x:Name="CableInfo"
                                        Margin="0,10,0,0"
                                        Padding="10,8"
                                        Background="{DynamicResource StatusInfoBg}"
                                        CornerRadius="8">
                                        <StackPanel>
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="14"
                                                    Height="14"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource StatusInfoFg}"
                                                    Kind="CableData" />
                                                <TextBlock
                                                    x:Name="TxtCableTitle"
                                                    FontSize="11.5"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource StatusInfoFg}"
                                                    Text="{DynamicResource Str_VoiceChanger_UseItInOther}" />
                                            </StackPanel>
                                            <TextBlock
                                                x:Name="TxtCableHint"
                                                Margin="0,4,0,0"
                                                FontSize="11"
                                                Foreground="{DynamicResource StatusInfoFg}"
                                                Text=""
                                                TextWrapping="Wrap" />
                                            <Button
                                                x:Name="BtnGetCable"
                                                Margin="0,6,0,0"
                                                HorizontalAlignment="Left"
                                                Click="BtnGetCable_Click"
                                                Style="{StaticResource SegmentedActionButtonStyle}"
                                                ToolTip="{DynamicResource Str_VoiceChanger_OpensVbAudioCom}">
                                                <Grid HorizontalAlignment="Center">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="*" />
                                                    </Grid.ColumnDefinitions>
                                                    <materialDesign:PackIcon
                                                        Grid.Column="0"
                                                        Width="14"
                                                        Height="14"
                                                        Margin="0,0,6,0"
                                                        VerticalAlignment="Center"
                                                        Kind="OpenInNew" />
                                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_VoiceChanger_GetAFreeVirtual}" TextWrapping="Wrap" />
                                                </Grid>
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!--  ============ QUICK VOICES ============  -->
                            <Border ctl:Tour.Key="Str_Tour_VoiceChanger_Voices" ctl:Tour.Order="3" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_VoiceChanger_QuickVoices}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.Creation}" />
                                    <UniformGrid Columns="2">
                                        <Button
                                            x:Name="BtnPresetChipmunk"
                                            Margin="0,0,3,6"
                                            Click="BtnPreset_Click"
                                            Style="{StaticResource SegmentedActionButtonStyle}"
                                            Tag="Chipmunk"
                                            ToolTip="{DynamicResource Str_VoiceChanger_HighAndFastSounding}">
                                            <Grid HorizontalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon
                                                    Grid.Column="0"
                                                    Width="15"
                                                    Height="15"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Kind="ArrowUpBold" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_VoiceChanger_Chipmunk}" TextWrapping="Wrap" />
                                            </Grid>
                                        </Button>
                                        <Button
                                            x:Name="BtnPresetDeepVoice"
                                            Margin="3,0,0,6"
                                            Click="BtnPreset_Click"
                                            Style="{StaticResource SegmentedActionButtonStyle}"
                                            Tag="DeepVoice"
                                            ToolTip="{DynamicResource Str_VoiceChanger_LowAndHeavy}">
                                            <Grid HorizontalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon
                                                    Grid.Column="0"
                                                    Width="15"
                                                    Height="15"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Kind="ArrowDownBold" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_VoiceChanger_Deep}" TextWrapping="Wrap" />
                                            </Grid>
                                        </Button>
                                        <Button
                                            x:Name="BtnPresetRobot"
                                            Margin="0,0,3,6"
                                            Click="BtnPreset_Click"
                                            Style="{StaticResource SegmentedActionButtonStyle}"
                                            Tag="Robot"
                                            ToolTip="{DynamicResource Str_VoiceChanger_BuzzyAndMetallic}">
                                            <Grid HorizontalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon
                                                    Grid.Column="0"
                                                    Width="15"
                                                    Height="15"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Kind="Robot" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_VoiceChanger_Robot}" TextWrapping="Wrap" />
                                            </Grid>
                                        </Button>
                                        <Button
                                            x:Name="BtnPresetCaveEcho"
                                            Margin="3,0,0,6"
                                            Click="BtnPreset_Click"
                                            Style="{StaticResource SegmentedActionButtonStyle}"
                                            Tag="CaveEcho"
                                            ToolTip="{DynamicResource Str_VoiceChanger_BigEchoingSpace}">
                                            <Grid HorizontalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon
                                                    Grid.Column="0"
                                                    Width="15"
                                                    Height="15"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Kind="Waves" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_VoiceChanger_Cave}" TextWrapping="Wrap" />
                                            </Grid>
                                        </Button>
                                        <Button
                                            x:Name="BtnPresetGirl"
                                            Margin="0,0,3,6"
                                            Click="BtnPreset_Click"
                                            Style="{StaticResource SegmentedActionButtonStyle}"
                                            Tag="Girl"
                                            ToolTip="{DynamicResource Str_VoiceChanger_GirlTip}">
                                            <Grid HorizontalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon
                                                    Grid.Column="0"
                                                    Width="15"
                                                    Height="15"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Kind="HumanFemaleGirl" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_VoiceChanger_Girl}" TextWrapping="Wrap" />
                                            </Grid>
                                        </Button>
                                        <Button
                                            x:Name="BtnPresetMan"
                                            Margin="3,0,0,6"
                                            Click="BtnPreset_Click"
                                            Style="{StaticResource SegmentedActionButtonStyle}"
                                            Tag="Man"
                                            ToolTip="{DynamicResource Str_VoiceChanger_ManTip}">
                                            <Grid HorizontalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon
                                                    Grid.Column="0"
                                                    Width="15"
                                                    Height="15"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Kind="HumanMale" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_VoiceChanger_Man}" TextWrapping="Wrap" />
                                            </Grid>
                                        </Button>
                                        <Button
                                            x:Name="BtnPresetGrandma"
                                            Margin="0,0,3,0"
                                            Click="BtnPreset_Click"
                                            Style="{StaticResource SegmentedActionButtonStyle}"
                                            Tag="Grandma"
                                            ToolTip="{DynamicResource Str_VoiceChanger_GrandmaTip}">
                                            <Grid HorizontalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon
                                                    Grid.Column="0"
                                                    Width="15"
                                                    Height="15"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Kind="HumanFemale" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_VoiceChanger_Grandma}" TextWrapping="Wrap" />
                                            </Grid>
                                        </Button>
                                        <Button
                                            x:Name="BtnPresetGrandpa"
                                            Margin="3,0,0,0"
                                            Click="BtnPreset_Click"
                                            Style="{StaticResource SegmentedActionButtonStyle}"
                                            Tag="Grandpa"
                                            ToolTip="{DynamicResource Str_VoiceChanger_GrandpaTip}">
                                            <Grid HorizontalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon
                                                    Grid.Column="0"
                                                    Width="15"
                                                    Height="15"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Kind="HumanCane" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_VoiceChanger_Grandpa}" TextWrapping="Wrap" />
                                            </Grid>
                                        </Button>
                                    </UniformGrid>
                                    <Button
                                        x:Name="BtnPresetReset"
                                        Margin="0,8,0,0"
                                        Click="BtnPreset_Click"
                                        Style="{StaticResource SegmentedActionButtonStyle}"
                                        Tag="None"
                                        ToolTip="{DynamicResource Str_VoiceChanger_NoPitchChangeRobot}">
                                        <Grid HorizontalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon
                                                Grid.Column="0"
                                                Width="15"
                                                Height="15"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Kind="Restore" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_VoiceChanger_NaturalVoice}" TextWrapping="Wrap" />
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!--  ============ PITCH ============  -->
                            <Border ctl:Tour.Key="Str_Tour_VoiceChanger_Pitch" ctl:Tour.Order="4" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_TTS_Pitch}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.ArrowUpDown}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock Style="{StaticResource SliderLabel}" Text="{DynamicResource Str_VoiceChanger_LowerHigher}" />
                                        <Border Grid.Column="1" Style="{StaticResource SliderValuePill}">
                                            <TextBlock
                                                x:Name="TxtPitchValue"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="White"
                                                Text="{DynamicResource Str_VoiceChanger_NoShift}" />
                                        </Border>
                                    </Grid>
                                    <Slider
                                        x:Name="SliderPitch"
                                        Margin="0,6,0,0"
                                        IsMoveToPointEnabled="True"
                                        IsSnapToTickEnabled="True"
                                        Maximum="12"
                                        Minimum="-12"
                                        TickFrequency="0.5"
                                        ToolTip="{DynamicResource Str_VoiceChanger_InSemitones12Is}"
                                        ValueChanged="Effect_ValueChanged"
                                        Value="0" />
                                </StackPanel>
                            </Border>

                            <!--  ============ ROBOT + ECHO ============  -->
                            <Border Margin="0,0,0,4" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_VoiceChanger_Effects}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.Waveform}" />
                                    <CheckBox
                                        x:Name="ChkRobot"
                                        Checked="Effect_Changed"
                                        Content="{DynamicResource Str_VoiceChanger_Robot}"
                                        Foreground="{DynamicResource SidebarText}"
                                        ToolTip="{DynamicResource Str_VoiceChanger_MixesTheVoiceWith}"
                                        Unchecked="Effect_Changed" />
                                    <CheckBox
                                        x:Name="ChkEcho"
                                        Margin="0,8,0,0"
                                        Checked="Effect_Changed"
                                        Content="{DynamicResource Str_VoiceChanger_Echo}"
                                        Foreground="{DynamicResource SidebarText}"
                                        ToolTip="{DynamicResource Str_VoiceChanger_ARepeatingFadingCopy}"
                                        Unchecked="Effect_Changed" />

                                    <StackPanel x:Name="EchoPanel" Margin="0,10,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource SliderLabel}" Text="{DynamicResource Str_VoiceChanger_Delay}" />
                                            <Border Grid.Column="1" Style="{StaticResource SliderValuePill}">
                                                <TextBlock
                                                    x:Name="TxtEchoDelayValue"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="White"
                                                    Text="220 ms" />
                                            </Border>
                                        </Grid>
                                        <Slider
                                            x:Name="SliderEchoDelay"
                                            Margin="0,6,0,10"
                                            IsMoveToPointEnabled="True"
                                            Maximum="600"
                                            Minimum="50"
                                            ToolTip="{DynamicResource Str_VoiceChanger_TimeBetweenRepeats}"
                                            ValueChanged="Effect_ValueChanged"
                                            Value="220" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource SliderLabel}" Text="{DynamicResource Str_VoiceChanger_Repeats}" />
                                            <Border Grid.Column="1" Style="{StaticResource SliderValuePill}">
                                                <TextBlock
                                                    x:Name="TxtEchoFeedbackValue"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="White"
                                                    Text="35%" />
                                            </Border>
                                        </Grid>
                                        <Slider
                                            x:Name="SliderEchoFeedback"
                                            Margin="0,6,0,10"
                                            IsMoveToPointEnabled="True"
                                            Maximum="0.85"
                                            Minimum="0"
                                            ToolTip="{DynamicResource Str_VoiceChanger_HowMuchOfEach}"
                                            ValueChanged="Effect_ValueChanged"
                                            Value="0.35" />

                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Style="{StaticResource SliderLabel}" Text="{DynamicResource Str_VoiceChanger_EchoLoudness}" />
                                            <Border Grid.Column="1" Style="{StaticResource SliderValuePill}">
                                                <TextBlock
                                                    x:Name="TxtEchoMixValue"
                                                    FontSize="11"
                                                    FontWeight="SemiBold"
                                                    Foreground="White"
                                                    Text="35%" />
                                            </Border>
                                        </Grid>
                                        <Slider
                                            x:Name="SliderEchoMix"
                                            Margin="0,6,0,0"
                                            IsMoveToPointEnabled="True"
                                            Maximum="1"
                                            Minimum="0"
                                            ToolTip="{DynamicResource Str_VoiceChanger_HowLoudTheEcho}"
                                            ValueChanged="Effect_ValueChanged"
                                            Value="0.35" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--  ================= MAIN =================  -->

            <Grid Grid.Row="1" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  ============ ACTION ============  -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button
                            x:Name="BtnPrimaryAction"
                            ctl:Tour.Key="Str_Tour_VoiceChanger_Run"
                            ctl:Tour.Order="5"
                            MinWidth="190"
                            VerticalAlignment="Center"
                            Click="BtnPrimaryAction_Click"
                            Style="{StaticResource AccentPrimaryButtonStyle}">
                            <Grid HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon
                                    Grid.Column="0"
                                    x:Name="IconPrimary"
                                    Width="18"
                                    Height="18"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Kind="AutoFix" />
                                <TextBlock
                                    Grid.Column="1"
                                    x:Name="TxtPrimaryLabel"
                                    VerticalAlignment="Center"
                                    Text="{DynamicResource Str_VoiceChanger_ChangeVoice}" TextWrapping="Wrap" />
                            </Grid>
                        </Button>

                        <StackPanel
                            Grid.Column="1"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center">
                            <TextBlock
                                x:Name="StatusText"
                                FontSize="12.5"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="{DynamicResource Str_VoiceChanger_AddAudioFilesPick}"
                                TextTrimming="CharacterEllipsis" />
                            <ProgressBar
                                x:Name="ProgressRender"
                                Height="6"
                                Margin="0,6,0,0"
                                Maximum="1"
                                Visibility="Collapsed" />
                            <WrapPanel Margin="0,8,0,0">
                                <Border
                                    Margin="0,0,6,0"
                                    Background="{DynamicResource AccentColorSubtle}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    ToolTip="{DynamicResource Str_VoiceChanger_TheEffectThatWill}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource AccentColor}"
                                            Kind="Tune" />
                                        <TextBlock
                                            x:Name="TxtEffectPill"
                                            FontSize="11.5"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource AccentColor}"
                                            Text="{DynamicResource Str_VoiceChanger_NoEffect}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    x:Name="LivePill"
                                    Background="{DynamicResource StatusErrorBg}"
                                    RenderTransformOrigin="0.5,0.5"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <Ellipse
                                            Width="8"
                                            Height="8"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            Fill="{DynamicResource StatusErrorFg}" />
                                        <TextBlock
                                            FontSize="11.5"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource StatusErrorFg}"
                                            Text="{DynamicResource Str_HardwareSensors_Live}" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  ============ RESULTS ============  -->
                <!--  ============ WAVEFORMS: the original above, the changed voice below; click either to play from there ============  -->
                <Border
                    Grid.Row="2"
                    Padding="12"
                    ctl:Tour.Key="Str_Tour_VoiceChanger_Wave"
                    ctl:Tour.Order="5"
                    Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <TextBlock Margin="2,0,0,4" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource Str_VoiceHub_Original}" />
                        <controls:WaveFrame x:Name="WaveOriginal" Height="96" MinHeight="96" />
                        <TextBlock Margin="2,10,0,4" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource Str_VoiceHub_Changed}" />
                        <controls:WaveFrame x:Name="WaveChanged" Height="96" MinHeight="96" />
                    </StackPanel>
                </Border>

                <Border Grid.Row="4" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentControl
                                Content="{DynamicResource Str_VoiceChanger_ChangedVoices}"
                                Style="{StaticResource CardHeader}"
                                Tag="{x:Static materialDesign:PackIconKind.PlaylistMusic}" />
                            <Border
                                x:Name="CountPill"
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{DynamicResource AccentColorSubtle}"
                                Style="{StaticResource IconStatusPillStyle}"
                                Visibility="Collapsed">
                                <TextBlock
                                    x:Name="TxtCount"
                                    FontSize="11.5"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource AccentColor}"
                                    Text="0" />
                            </Border>
                            <Button
                                x:Name="BtnSaveAll"
                                Grid.Column="2"
                                MinHeight="36"
                                Margin="0,0,8,0"
                                Click="BtnSaveAll_Click"
                                IsEnabled="False"
                                Style="{StaticResource ListToolPrimaryButtonStyle}"
                                ToolTip="{DynamicResource Str_VoiceChanger_SaveEveryUnsavedResult}">
                                <Grid HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon
                                        Grid.Column="0"
                                        Width="15"
                                        Height="15"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Kind="ContentSaveAllOutline" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_VoiceChanger_SaveAll}" TextWrapping="Wrap" />
                                </Grid>
                            </Button>
                            <Button Padding="0"
                                x:Name="BtnClearTakes"
                                Grid.Column="3"
                                Width="36"
                                Height="36"
                                Click="BtnClearTakes_Click"
                                IsEnabled="False"
                                Style="{StaticResource ListToolDangerButtonStyle}"
                                ToolTip="{DynamicResource Str_MicRecorder_EmptyTheListSaved}">
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    Kind="DeleteSweepOutline" />
                            </Button>
                        </Grid>

                        <Grid Grid.Row="1">
                            <ListBox
                                x:Name="ListBoxTakes"
                                ctl:Tour.Key="Str_Tour_VoiceChanger_Takes"
                                ctl:Tour.Order="6"
                                ItemContainerStyle="{StaticResource FileCardListItemStyle}"
                                MouseDoubleClick="ListBoxTakes_MouseDoubleClick"
                                SelectionChanged="ListBoxTakes_SelectionChanged"
                                Style="{StaticResource FileCardListBoxStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:VoiceChangerTake}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                x:Name="Badge"
                                                Width="34"
                                                Height="34"
                                                Margin="0,0,10,0"
                                                Background="{DynamicResource AccentColorSubtle}"
                                                CornerRadius="9">
                                                <materialDesign:PackIcon
                                                    x:Name="BadgeIcon"
                                                    Width="17"
                                                    Height="17"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource AccentColor}"
                                                    Kind="AccountVoice" />
                                            </Border>
                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock
                                                    FontSize="12.5"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource TextPrimary}"
                                                    Text="{Binding DisplayName}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip="{Binding FilePath}" />
                                                <TextBlock
                                                    Margin="0,2,0,0"
                                                    FontSize="11"
                                                    Foreground="{DynamicResource TextSecondary}"
                                                    Text="{Binding Details}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <Button Padding="0"
                                                    Width="30"
                                                    Height="30"
                                                    Click="BtnPlayTake_Click"
                                                    Style="{StaticResource NeutralIconButtonStyle}"
                                                    Tag="{Binding}"
                                                    ToolTip="{DynamicResource Str_MicRecorder_PlayStop}">
                                                    <materialDesign:PackIcon
                                                        x:Name="PlayIcon"
                                                        Width="16"
                                                        Height="16"
                                                        Kind="Play" />
                                                </Button>
                                                <Button Padding="0"
                                                    Width="30"
                                                    Height="30"
                                                    Margin="2,0,0,0"
                                                    Click="BtnSaveTake_Click"
                                                    Style="{StaticResource NeutralIconButtonStyle}"
                                                    Tag="{Binding}"
                                                    ToolTip="{DynamicResource Str_MicRecorder_SaveAs}">
                                                    <materialDesign:PackIcon
                                                        Width="16"
                                                        Height="16"
                                                        Kind="ContentSaveOutline" />
                                                </Button>
                                                <Button Padding="0"
                                                    x:Name="BtnShowTake"
                                                    Width="30"
                                                    Height="30"
                                                    Margin="2,0,0,0"
                                                    Click="BtnShowTake_Click"
                                                    Style="{StaticResource NeutralIconButtonStyle}"
                                                    Tag="{Binding}"
                                                    ToolTip="{DynamicResource Str_Validate_MenuShowInFolder}"
                                                    Visibility="Collapsed">
                                                    <materialDesign:PackIcon
                                                        Width="16"
                                                        Height="16"
                                                        Kind="FolderOpenOutline" />
                                                </Button>
                                                <Button
                                                    Width="30"
                                                    Height="30"
                                                    Margin="2,0,0,0"
                                                    Click="BtnRemoveTake_Click"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    Tag="{Binding}"
                                                    ToolTip="{DynamicResource Str_MicRecorder_TakeOffTheList}">
                                                    <materialDesign:PackIcon
                                                        Width="14"
                                                        Height="14"
                                                        Kind="Close" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter TargetName="PlayIcon" Property="Kind" Value="Stop" />
                                                <Setter TargetName="BadgeIcon" Property="Kind" Value="VolumeHigh" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSaved}" Value="True">
                                                <Setter TargetName="BtnShowTake" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSaved}" Value="False">
                                                <Setter TargetName="Badge" Property="Background" Value="{DynamicResource StatusWarningBg}" />
                                                <Setter TargetName="BadgeIcon" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <controls:EmptyStateCard
                                x:Name="TakesEmptyPanel"
                                Title="{DynamicResource Str_VoiceChanger_NothingChangedYet}"
                                Description="{DynamicResource Str_VoiceChanger_EachChangedFileLands}"
                                Icon="AccountVoice"
                                IsHitTestVisible="False" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
