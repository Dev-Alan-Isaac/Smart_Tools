<UserControl
    x:Class="Smart_Tools.WPF.Views.LoudnessView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:models="clr-namespace:Smart_Tools.WPF.Models"
    x:Name="Root"
    Focusable="True"
    Loaded="Root_Loaded">

    <!--  Backend: Controllers/LoudnessManager.cs (ffmpeg loudnorm measuring, normalized copies, report). UI only here.  -->

    <UserControl.Resources>
        <!--  A file in the sidebar list  -->
        <DataTemplate x:Key="SourceTemplate" DataType="{x:Type models:LoudnessItem}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="26" Height="26" Margin="0,0,8,0" Background="{DynamicResource AccentColorSubtle}" CornerRadius="7">
                    <materialDesign:PackIcon Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentColor}" Kind="MusicNote" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SidebarText}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                    <TextBlock Margin="0,1,0,0" FontSize="10.5" Foreground="{DynamicResource SidebarTextMuted}" Text="{Binding Folder}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="2" Width="24" Height="24" Margin="6,0,0,0" VerticalAlignment="Center" Click="BtnRemoveFile_Click" Style="{StaticResource IconButtonStyle}" Tag="{Binding}" ToolTip="Take this off the list">
                    <materialDesign:PackIcon Width="13" Height="13" Kind="Close" />
                </Button>
            </Grid>
        </DataTemplate>

        <!--  Small status tag inside a cell  -->
        <Style x:Key="TagPillStyle" TargetType="Border">
            <Setter Property="Padding" Value="8,2" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="HorizontalAlignment" Value="Left" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--  File name, with the folder (or the copy / the reason) underneath  -->
        <DataTemplate x:Key="FileCellTemplate" DataType="{x:Type models:LoudnessItem}">
            <StackPanel VerticalAlignment="Center">
                <TextBlock FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                <TextBlock x:Name="Detail" FontSize="11" Foreground="{DynamicResource TextSecondary}" Text="{Binding Folder}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}" />
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Done">
                    <Setter TargetName="Detail" Property="Text" Value="{Binding OutputPath}" />
                    <Setter TargetName="Detail" Property="ToolTip" Value="{Binding OutputPath}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter TargetName="Detail" Property="Text" Value="{Binding Message}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Silent">
                    <Setter TargetName="Detail" Property="Text" Value="{Binding Message}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  On target / too loud / too quiet / may clip  -->
        <DataTemplate x:Key="VerdictCellTemplate" DataType="{x:Type models:LoudnessItem}">
            <Border x:Name="Pill" Background="{DynamicResource RowBg}" Style="{StaticResource TagPillStyle}" Visibility="Collapsed">
                <TextBlock x:Name="PillText" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Text="{Binding VerdictText}" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Verdict}" Value="OnTarget">
                    <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Pill" Property="Background" Value="{DynamicResource StatusSuccessBg}" />
                    <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource StatusSuccessFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Verdict}" Value="TooLoud">
                    <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Pill" Property="Background" Value="{DynamicResource StatusWarningBg}" />
                    <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Verdict}" Value="TooQuiet">
                    <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Pill" Property="Background" Value="{DynamicResource StatusWarningBg}" />
                    <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Verdict}" Value="MayClip">
                    <Setter TargetName="Pill" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Pill" Property="Background" Value="{DynamicResource StatusErrorBg}" />
                    <Setter TargetName="PillText" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  Waiting / measured / copy saved / failed  -->
        <DataTemplate x:Key="StatusCellTemplate" DataType="{x:Type models:LoudnessItem}">
            <TextBlock x:Name="StatusText" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Text="{Binding StatusText}" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Done">
                    <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource StatusSuccessFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Silent">
                    <Setter TargetName="StatusText" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  Loudness in bold  -->
        <Style x:Key="StrongCellTextStyle" BasedOn="{StaticResource EllipsisCellTextStyle}" TargetType="TextBlock">
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">
        <Grid Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= OPTIONS SIDEBAR =================  -->
            <controls:ToolSidebar>
                <StackPanel x:Name="SidebarStack">
                    <controls:InputFolderCard ctl:Tour.Key="Str_Tour_Loudness_Input" ctl:Tour.Order="1"
                        x:Name="InputCard"
                        ClearRequested="InputCard_ClearRequested"
                        Header="Audio files"
                        HeaderIcon="MusicBoxMultipleOutline"
                        ItemTemplate="{StaticResource SourceTemplate}"
                        Mode="Files"
                        PathsAdded="InputCard_PathsAdded"
                        ShowSubfolders="False" />

                    <Border ctl:Tour.Key="Str_Tour_Loudness_Target" ctl:Tour.Order="2" Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl Content="TARGET" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.BullseyeArrow}" />
                            <UniformGrid Margin="0,8,0,0" Columns="2">
                                <RadioButton x:Name="RadioLoudness" Margin="0,0,2,0" Checked="Option_Changed" Content="Loudness" GroupName="LmMode" IsChecked="True" Style="{StaticResource ModeToggleButtonStyle}" ToolTip="Bring the whole file to a loudness (LUFS) - what streaming services measure" />
                                <RadioButton x:Name="RadioPeak" Margin="2,0,0,0" Checked="Option_Changed" Content="Peak" GroupName="LmMode" Style="{StaticResource ModeToggleButtonStyle}" ToolTip="Only raise or lower the loudest point to the ceiling below" />
                            </UniformGrid>

                            <StackPanel x:Name="LoudnessTargetPanel">
                                <TextBlock Margin="2,12,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SidebarTextMuted}" Text="Aim for" />
                                <ComboBox x:Name="CmbTarget" Margin="0,6,0,0" SelectionChanged="Option_Changed" />
                                <TextBox x:Name="TxtCustomLufs" Margin="0,6,0,0" Text="-14" TextChanged="Option_Changed" ToolTip="LUFS, between -40 and -5" Visibility="Collapsed" />
                            </StackPanel>

                            <TextBlock Margin="2,12,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SidebarTextMuted}" Text="Highest peak allowed (dBTP)" />
                            <ComboBox x:Name="CmbCeiling" Margin="0,6,0,0" SelectedIndex="0" SelectionChanged="Option_Changed">
                                <ComboBoxItem Content="-1.0" Tag="-1" />
                                <ComboBoxItem Content="-1.5" Tag="-1.5" />
                                <ComboBoxItem Content="-2.0" Tag="-2" />
                                <ComboBoxItem Content="-3.0" Tag="-3" />
                                <ComboBoxItem Content="0.0" Tag="0" />
                            </ComboBox>
                            <TextBlock Margin="2,6,0,0" FontSize="10.5" Foreground="{DynamicResource SidebarTextMuted}" TextWrapping="Wrap" Text="Changing the target only re-judges what was measured - nothing is read again." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl Content="COPIES" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.ContentCopy}" />
                            <TextBlock Margin="2,8,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SidebarTextMuted}" Text="Quality of MP3 / M4A / OGG copies (kbps)" />
                            <ComboBox x:Name="CmbBitrate" Margin="0,6,0,0" SelectedIndex="1" SelectionChanged="Option_Changed">
                                <ComboBoxItem Content="128" Tag="128" />
                                <ComboBoxItem Content="192" Tag="192" />
                                <ComboBoxItem Content="256" Tag="256" />
                                <ComboBoxItem Content="320" Tag="320" />
                            </ComboBox>
                        </StackPanel>
                    </Border>

                    <controls:OutputFolderCard ctl:Tour.Key="Str_Tour_Loudness_Output" ctl:Tour.Order="3"
                        x:Name="OutputCard"
                        AllowSameAsSource="True"
                        Header="Save copies to"
                        HeaderIcon="ContentSaveOutline"
                        SameAsSource="True"
                        ToolName="Loudness Meter" />

                    <Border Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl Content="GOOD TO KNOW" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.InformationOutline}" />
                            <TextBlock Margin="2,6,0,0" FontSize="10.5" Foreground="{DynamicResource SidebarTextMuted}" TextWrapping="Wrap" Text="Measuring only reads your files. Normalizing writes a new file named 'name (normalized)' and never changes or replaces the original; the copy is measured again so you see what you really got. Tags are kept, cover art is not." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </controls:ToolSidebar>

            <!--  ================= MAIN AREA =================  -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Run bar  -->
                <Border Grid.Row="0" Margin="0,0,0,14" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button ctl:Tour.Key="Str_Tour_Loudness_Measure" ctl:Tour.Order="4" x:Name="BtnMeasure" MinWidth="160" VerticalAlignment="Center" Click="BtnMeasure_Click" Style="{StaticResource AccentPrimaryButtonStyle}" ToolTip="Read every file and report its loudness (nothing is written)">
                            <Grid HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon x:Name="IconMeasure" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" Kind="Speedometer" />
                                <TextBlock x:Name="TxtMeasure" Grid.Column="1" VerticalAlignment="Center" Text="Measure" TextWrapping="Wrap" />
                            </Grid>
                        </Button>

                        <Button ctl:Tour.Key="Str_Tour_Loudness_Normalize" ctl:Tour.Order="5" x:Name="BtnNormalize" Grid.Column="1" MinHeight="36" Margin="8,0,0,0" VerticalAlignment="Center" Click="BtnNormalize_Click" Style="{StaticResource NeutralIconButtonStyle}" ToolTip="Write a normalized copy of every file (originals stay untouched)">
                            <Grid Margin="8,0" HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" Kind="VolumeHigh" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" FontSize="12" Text="Normalize copies" TextWrapping="Wrap" />
                            </Grid>
                        </Button>

                        <StackPanel Grid.Column="2" Margin="16,0,0,0" VerticalAlignment="Center">
                            <ProgressBar x:Name="Bar" Height="8" Maximum="100" />
                            <TextBlock x:Name="TxtProgress" Margin="0,6,0,0" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Text="Add audio files to start." TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock x:Name="TxtProgressPercent" Grid.Column="3" MinWidth="54" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentColor}" TextAlignment="Right" />
                    </Grid>
                </Border>

                <!--  Results  -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ContentControl VerticalAlignment="Center" Content="Loudness" Style="{StaticResource CardHeader}" Tag="{x:Static materialDesign:PackIconKind.Speedometer}" />

                            <WrapPanel x:Name="SummaryPanel" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                <Border x:Name="PillFiles" Margin="0,2,6,2" Background="{DynamicResource StatusInfoBg}" Style="{StaticResource IconStatusPillStyle}" ToolTip="Files in the list">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource StatusInfoFg}" Kind="MusicNote" />
                                        <TextBlock x:Name="TxtSummaryFiles" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource StatusInfoFg}" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="PillOnTarget" Margin="0,2,6,2" Background="{DynamicResource StatusSuccessBg}" Style="{StaticResource IconStatusPillStyle}" ToolTip="Within 1 LU of the target" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource StatusSuccessFg}" Kind="CheckCircleOutline" />
                                        <TextBlock x:Name="TxtSummaryOnTarget" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource StatusSuccessFg}" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="PillOff" Margin="0,2,6,2" Background="{DynamicResource StatusWarningBg}" Style="{StaticResource IconStatusPillStyle}" ToolTip="Louder or quieter than the target" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource StatusWarningFg}" Kind="VolumeVibrate" />
                                        <TextBlock x:Name="TxtSummaryOff" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource StatusWarningFg}" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="PillClip" Margin="0,2,6,2" Background="{DynamicResource StatusErrorBg}" Style="{StaticResource IconStatusPillStyle}" ToolTip="True peak above the ceiling - may distort" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource StatusErrorFg}" Kind="AlertCircleOutline" />
                                        <TextBlock x:Name="TxtSummaryClip" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource StatusErrorFg}" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="PillCopies" Margin="0,2,6,2" Background="{DynamicResource AccentColorSubtle}" Style="{StaticResource IconStatusPillStyle}" ToolTip="Normalized copies written" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentColor}" Kind="ContentSaveOutline" />
                                        <TextBlock x:Name="TxtSummaryCopies" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentColor}" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="PillFailed" Margin="0,2,6,2" Background="{DynamicResource StatusErrorBg}" Style="{StaticResource IconStatusPillStyle}" ToolTip="Hover a failed row for the reason" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource StatusErrorFg}" Kind="CloseCircleOutline" />
                                        <TextBlock x:Name="TxtSummaryFailed" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource StatusErrorFg}" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                                <Button x:Name="BtnCopyReport" Margin="0,0,6,0" Click="BtnCopyReport_Click" Style="{StaticResource ListToolButtonStyle}" ToolTip="Copy the report (CSV) to the clipboard">
                                    <materialDesign:PackIcon Width="16" Height="16" Kind="ContentCopy" />
                                </Button>
                                <Button x:Name="BtnSaveReport" Margin="0,0,6,0" Click="BtnSaveReport_Click" Style="{StaticResource ListToolButtonStyle}" ToolTip="Save the report as a CSV file">
                                    <materialDesign:PackIcon Width="16" Height="16" Kind="FileDelimitedOutline" />
                                </Button>
                                <Button x:Name="BtnClearList" Click="BtnClearList_Click" Style="{StaticResource ListToolDangerButtonStyle}" ToolTip="Empty the list (no files are touched)">
                                    <materialDesign:PackIcon Width="16" Height="16" Kind="DeleteSweepOutline" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Border x:Name="StatusBanner" Grid.Row="1" Margin="0,0,0,10" Padding="10,8" CornerRadius="8" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon x:Name="StatusIcon" Width="14" Height="14" Margin="0,1,8,0" VerticalAlignment="Top" Kind="AlertOutline" />
                                <TextBlock x:Name="TxtStatus" Grid.Column="1" FontSize="11.5" TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <DataGrid ctl:Tour.Key="Str_Tour_Loudness_Results" ctl:Tour.Order="6"
                            x:Name="ResultGrid"
                            Grid.Row="2"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            CanUserSortColumns="False"
                            FontSize="12"
                            IsReadOnly="True"
                            MinRowHeight="44"
                            PreviewKeyDown="ResultGrid_PreviewKeyDown"
                            PreviewMouseRightButtonDown="ResultGrid_PreviewMouseRightButtonDown"
                            SelectionMode="Extended"
                            ToolTip="Delete takes the selected files off the list (the files themselves are never touched). Right-click for more."
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.ScrollUnit="Pixel"
                            VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.Columns>
                                <DataGridTemplateColumn Width="2*" MinWidth="120" CellTemplate="{StaticResource FileCellTemplate}" Header="File" />
                                <DataGridTextColumn Width="62" Binding="{Binding DurationText}" ElementStyle="{StaticResource EllipsisCellTextStyle}" Header="Length" />
                                <DataGridTextColumn Width="96" Binding="{Binding LufsText}" ElementStyle="{StaticResource StrongCellTextStyle}" Header="Loudness" />
                                <DataGridTextColumn Width="96" Binding="{Binding PeakText}" ElementStyle="{StaticResource EllipsisCellTextStyle}" Header="True peak" />
                                <DataGridTextColumn Width="72" Binding="{Binding RangeText}" ElementStyle="{StaticResource EllipsisCellTextStyle}" Header="Range" />
                                <DataGridTextColumn Width="78" Binding="{Binding DeltaText}" ElementStyle="{StaticResource EllipsisCellTextStyle}" Header="Vs target" />
                                <DataGridTemplateColumn Width="104" CellTemplate="{StaticResource VerdictCellTemplate}" Header="Verdict" />
                                <DataGridTextColumn Width="96" Binding="{Binding AchievedText}" ElementStyle="{StaticResource EllipsisCellTextStyle}" Header="Copy" />
                                <DataGridTemplateColumn Width="100" CellTemplate="{StaticResource StatusCellTemplate}" Header="Status" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <controls:EmptyStateCard
                            x:Name="EmptyStatePanel"
                            Grid.Row="2"
                            Description="Drop audio files or folders on the left, pick where the copies go, then press Measure."
                            Icon="Speedometer"
                            IsHitTestVisible="False" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
