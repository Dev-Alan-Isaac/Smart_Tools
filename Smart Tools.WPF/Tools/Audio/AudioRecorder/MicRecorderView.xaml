<UserControl
    x:Class="Smart_Tools.WPF.Views.MicRecorderView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:models="clr-namespace:Smart_Tools.WPF.Models"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    x:Name="Root"
    Loaded="Root_Loaded"
    Unloaded="Root_Unloaded">

    <!--
        Backend: Controllers/MicRecorderManager.cs (NAudio capture, pause,
        hearing the input, playback) + MicRecorderManager.Files.cs (level
        meter maths, names, saving, temp folder, settings); Models/
        MicRecorderModel.cs. UI only here. Recording carries on if you
        switch to another tool; closing the app finishes and saves it.
    -->

    <UserControl.Resources>

    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">

        <!--  No page header: MainWindow's header card shows the tool's icon and name.  -->

        <Grid Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OptionsColumn" Width="290" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Filled by a tool hub (Speech / Audio Editor / Voice Studio) with its tab strip; empty and zero-height when the tool is opened alone  -->
            <ContentPresenter x:Name="HubTabsHost" Grid.Row="0" Grid.Column="2" Grid.ColumnSpan="1" />


            <!--  ================= SIDEBAR =================  -->

            <Border Grid.RowSpan="2" Grid.Column="0" Style="{StaticResource SidebarPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Button
                            x:Name="BtnCollapseOptions"
                            MinHeight="45"
                            HorizontalContentAlignment="Left"
                            Click="BtnCollapseOptions_Click"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Foreground="{DynamicResource SidebarText}"
                            ToolTip="{DynamicResource Str_Common_SidebarToggleTooltip}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="OverridesDefaultStyle" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Margin="16,0,0,0" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Kind="TuneVariant" />
                                <TextBlock
                                    x:Name="TxtOptionsHeaderLabel"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{DynamicResource Str_Common_OptionsLabel}" />
                            </StackPanel>
                        </Button>

                        <Separator
                            x:Name="SepHeader"
                            Margin="16,4"
                            Style="{StaticResource SidebarSeparatorStyle}" />
                    </StackPanel>

                    <ScrollViewer
                        x:Name="OptionsScrollViewer"
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16">

                            <!--  ============ MICROPHONE ============  -->
                            <Border ctl:Tour.Key="Str_Tour_MicRecorder_Device" ctl:Tour.Order="1" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <Grid>
                                        <ContentControl
                                            Content="{DynamicResource Str_MicRecorder_Device}"
                                            Style="{StaticResource SidebarGroupHeader}"
                                            Tag="{x:Static materialDesign:PackIconKind.MicrophoneOutline}" />
                                        <Button
                                            x:Name="BtnRefreshDevices"
                                            Margin="0,-6,0,0"
                                            HorizontalAlignment="Right"
                                            VerticalAlignment="Top"
                                            Click="BtnRefreshDevices_Click"
                                            ToolTip="{DynamicResource Str_InstrumentTuner_LookAgainAfterPlugging}"
                                            Style="{StaticResource ListToolButtonStyle}">
                                            <materialDesign:PackIcon
                                                x:Name="IconRefresh"
                                                Width="15"
                                                Height="15"
                                                Kind="Refresh"
                                                RenderTransformOrigin="0.5,0.5" />
                                        </Button>
                                    </Grid>

                                    <Border Style="{StaticResource InputBarStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon
                                                Width="16"
                                                Height="16"
                                                Margin="10,0,0,0"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource TextSecondary}"
                                                Kind="Microphone" />
                                            <ComboBox
                                                x:Name="DeviceCombo"
                                                Grid.Column="1"
                                                Margin="4,0,4,0"
                                                DisplayMemberPath="Name"
                                                SelectionChanged="DeviceCombo_SelectionChanged"
                                                Style="{StaticResource BareComboBox}"
                                                ToolTip="{DynamicResource Str_MicRecorder_TheMicrophoneToRecord}" />
                                        </Grid>
                                    </Border>

                                    <CheckBox
                                        x:Name="MonitorInputCheckBox"
                                        Margin="0,10,0,0"
                                        Checked="MonitorInput_Changed"
                                        Content="{DynamicResource Str_MicRecorder_HearYourselfWhileRecording}"
                                        Foreground="{DynamicResource SidebarText}"
                                        ToolTip="{DynamicResource Str_MicRecorder_PlaysTheMicrophoneThrough}"
                                        Unchecked="MonitorInput_Changed" />
                                    <TextBlock
                                        x:Name="TxtDeviceHint"
                                        Style="{StaticResource SidebarHint}"
                                        Text="{DynamicResource Str_MicRecorder_UseHeadphonesToHear}" />
                                </StackPanel>
                            </Border>

                            <!--  ============ QUALITY ============  -->
                            <Border ctl:Tour.Key="Str_Tour_MicRecorder_Quality" ctl:Tour.Order="2" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Convert_QualityLabel}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.TuneVertical}" />

                                    <TextBlock
                                        Margin="0,4,0,6"
                                        Style="{StaticResource FieldLabel}"
                                        Text="{DynamicResource Str_Convert_SampleRateLabel}" />
                                    <Border Style="{StaticResource InputBarStyle}">
                                        <ComboBox
                                            x:Name="SampleRateCombo"
                                            Margin="4,0"
                                            SelectionChanged="Format_Changed"
                                            Style="{StaticResource BareComboBox}"
                                            ToolTip="{DynamicResource Str_MicRecorder_441KhzIs}">
                                            <ComboBoxItem Content="{DynamicResource Str_MicRecorder_16KhzSpeech}" Tag="16000" />
                                            <ComboBoxItem Content="{DynamicResource Str_MicRecorder_2205Khz}" Tag="22050" />
                                            <ComboBoxItem Content="{DynamicResource Str_MicRecorder_441KhzCd}" Tag="44100" />
                                            <ComboBoxItem Content="{DynamicResource Str_MicRecorder_48KhzVideo}" Tag="48000" />
                                        </ComboBox>
                                    </Border>

                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <RadioButton
                                            x:Name="RadioMono"
                                            Checked="Format_Changed"
                                            Content="{DynamicResource Str_Synth_ModeMono}"
                                            GroupName="MicRecorderChannels"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            ToolTip="{DynamicResource Str_MicRecorder_OneChannelRightFor}" />
                                        <RadioButton
                                            x:Name="RadioStereo"
                                            Grid.Column="2"
                                            Checked="Format_Changed"
                                            Content="{DynamicResource Str_MicRecorder_Stereo}"
                                            GroupName="MicRecorderChannels"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            ToolTip="{DynamicResource Str_MicRecorder_TwoChannelsOnlyUseful}" />
                                    </Grid>

                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <RadioButton
                                            x:Name="Radio16Bit"
                                            Checked="Format_Changed"
                                            Content="{DynamicResource Str_MicRecorder_16Bit}"
                                            GroupName="MicRecorderBits"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            ToolTip="{DynamicResource Str_MicRecorder_StandardPlaysEverywhere}" />
                                        <RadioButton
                                            x:Name="Radio24Bit"
                                            Grid.Column="2"
                                            Checked="Format_Changed"
                                            Content="{DynamicResource Str_MicRecorder_24Bit}"
                                            GroupName="MicRecorderBits"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            ToolTip="{DynamicResource Str_MicRecorder_MoreHeadroomForQuiet}" />
                                    </Grid>

                                    <TextBlock
                                        x:Name="TxtFormatHint"
                                        Style="{StaticResource SidebarHint}"
                                        Text="{DynamicResource Str_MicRecorder_About5MbA}" />
                                </StackPanel>
                            </Border>

                            <!--  ============ SAVE TO ============  -->
                            <!--
                                The shared Output card (folder for this session only). File name and
                                "Save without asking" go in its Options, built in code-behind
                                (BuildOutputOptions) - no x:Name may go inside the card's Options (MC3093).
                            -->
                            <controls:OutputFolderCard
                                ctl:Tour.Key="Str_Tour_MicRecorder_Output"
                                ctl:Tour.Order="3"
                                x:Name="OutputCard"
                                Margin="0,0,0,4"
                                FolderChanged="OutputCard_FolderChanged"
                                Header="{DynamicResource Str_BackgroundRemover_SaveTo}"
                                HeaderIcon="ContentSaveOutline"
                                ToolName="Audio Recorder" />

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--  ================= MAIN =================  -->

            <Grid Grid.Row="1" Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  ============ RECORDER ============  -->
                <Border Grid.Row="0" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <!--  Big round record button: red dot to start, white square to stop  -->
                        <Button
                            x:Name="BtnRecord"
                            ctl:Tour.Key="Str_Tour_MicRecorder_Record"
                            ctl:Tour.Order="4"
                            Width="76"
                            Height="76"
                            Margin="0,0,18,0"
                            VerticalAlignment="Center"
                            Click="BtnRecord_Click"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            RenderTransformOrigin="0.5,0.5"
                            ToolTip="{DynamicResource Str_MicRecorder_StartRecording}">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Ellipse
                                            x:Name="Ring"
                                            Fill="{DynamicResource RowBg}"
                                            Stroke="{DynamicResource CardBorder}"
                                            StrokeThickness="2" />
                                        <Ellipse
                                            x:Name="Core"
                                            Margin="10"
                                            Fill="{DynamicResource DangerFill}" />
                                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource DangerFill}" />
                                        </Trigger>
                                        <Trigger Property="IsKeyboardFocused" Value="True">
                                            <Setter TargetName="Ring" Property="Stroke" Value="{DynamicResource AccentColor}" />
                                        </Trigger>
                                        <Trigger Property="IsEnabled" Value="False">
                                            <Setter TargetName="Core" Property="Opacity" Value="0.35" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                            <materialDesign:PackIcon
                                x:Name="IconRecord"
                                Width="28"
                                Height="28"
                                Foreground="White"
                                Kind="Microphone" />
                        </Button>

                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <StackPanel Orientation="Horizontal">
                                <Ellipse
                                    x:Name="RecDot"
                                    Width="12"
                                    Height="12"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    Fill="{DynamicResource StatusErrorFg}"
                                    Opacity="0.25"
                                    RenderTransformOrigin="0.5,0.5" />
                                <TextBlock
                                    x:Name="TxtElapsed"
                                    FontFamily="Consolas"
                                    FontSize="32"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimary}"
                                    Text="0:00" />
                            </StackPanel>

                            <!--  Level meter: green, then amber, red near clipping  -->
                            <Border
                                Height="10"
                                Margin="0,8,0,0"
                                Background="{DynamicResource RowBg}"
                                CornerRadius="5"
                                ToolTip="{DynamicResource Str_MicRecorder_InputLevelAimFor}">
                                <Border
                                    x:Name="LevelFill"
                                    HorizontalAlignment="Stretch"
                                    Background="{DynamicResource StatusSuccessFg}"
                                    CornerRadius="5"
                                    RenderTransformOrigin="0,0.5">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="LevelScale" ScaleX="0" />
                                    </Border.RenderTransform>
                                </Border>
                            </Border>

                            <TextBlock
                                x:Name="StatusText"
                                Margin="0,8,0,0"
                                FontSize="12"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="{DynamicResource Str_MicRecorder_PressTheRedButton}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <StackPanel
                            Grid.Column="2"
                            Margin="18,0,0,0"
                            VerticalAlignment="Center">
                            <Button
                                x:Name="BtnPause"
                                MinWidth="120"
                                Click="BtnPause_Click"
                                IsEnabled="False"
                                Style="{StaticResource PrimaryButtonStyle}"
                                ToolTip="{DynamicResource Str_MicRecorder_PauseTheMicrophoneStays}">
                                <Grid HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon
                                        Grid.Column="0"
                                        x:Name="IconPause"
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Kind="Pause" />
                                    <TextBlock
                                        Grid.Column="1"
                                        x:Name="TxtPauseLabel"
                                        VerticalAlignment="Center"
                                        Text="{DynamicResource Str_MicRecorder_Pause}" TextWrapping="Wrap" />
                                </Grid>
                            </Button>
                            <Border
                                x:Name="FormatPill"
                                Margin="0,8,0,0"
                                HorizontalAlignment="Center"
                                Background="{DynamicResource RowBg}"
                                Style="{StaticResource IconStatusPillStyle}">
                                <TextBlock
                                    x:Name="TxtFormat"
                                    FontSize="11"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{DynamicResource Str_MicRecorder_441KhzMono}" />
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  ============ RECORDINGS ============  -->
                <!--  ============ WAVEFORM: live while recording, the chosen take afterwards; click it to play from there ============  -->
                <Border
                    Grid.Row="2"
                    Padding="12"
                    ctl:Tour.Key="Str_Tour_MicRecorder_Wave"
                    ctl:Tour.Order="4"
                    Style="{StaticResource CardStyle}">
                    <controls:WaveFrame x:Name="WaveView" Height="150" />
                </Border>

                <Border Grid.Row="4" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentControl
                                Content="{DynamicResource Str_MicRecorder_TakesHeader}"
                                Style="{StaticResource CardHeader}"
                                Tag="{x:Static materialDesign:PackIconKind.PlaylistMusic}" />
                            <Border
                                x:Name="CountPill"
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Center"
                                Background="{DynamicResource AccentColorSubtle}"
                                Style="{StaticResource IconStatusPillStyle}"
                                Visibility="Collapsed">
                                <TextBlock
                                    x:Name="TxtCount"
                                    FontSize="11.5"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource AccentColor}"
                                    Text="0" />
                            </Border>
                            <Button
                                x:Name="BtnClearTakes"
                                Grid.Column="2"
                                Click="BtnClearTakes_Click"
                                IsEnabled="False"
                                ToolTip="{DynamicResource Str_MicRecorder_EmptyTheListSaved}"
                                Style="{StaticResource ListToolDangerButtonStyle}">
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    Kind="DeleteSweepOutline" />
                            </Button>
                        </Grid>

                        <Grid Grid.Row="1">
                            <ListBox
                                x:Name="ListBoxTakes"
                                ctl:Tour.Key="Str_Tour_MicRecorder_Takes"
                                ctl:Tour.Order="5"
                                ItemContainerStyle="{StaticResource FileCardListItemStyle}"
                                MouseDoubleClick="ListBoxTakes_MouseDoubleClick"
                                SelectionChanged="ListBoxTakes_SelectionChanged"
                                Style="{StaticResource FileCardListBoxStyle}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:MicRecorderTake}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>

                                            <Border
                                                x:Name="Badge"
                                                Width="34"
                                                Height="34"
                                                Margin="0,0,10,0"
                                                Background="{DynamicResource AccentColorSubtle}"
                                                CornerRadius="9">
                                                <materialDesign:PackIcon
                                                    x:Name="BadgeIcon"
                                                    Width="17"
                                                    Height="17"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource AccentColor}"
                                                    Kind="Waveform" />
                                            </Border>

                                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                                <TextBlock
                                                    FontSize="12.5"
                                                    FontWeight="SemiBold"
                                                    Foreground="{DynamicResource TextPrimary}"
                                                    Text="{Binding DisplayName}"
                                                    TextTrimming="CharacterEllipsis"
                                                    ToolTip="{Binding FilePath}" />
                                                <TextBlock
                                                    Margin="0,2,0,0"
                                                    FontSize="11"
                                                    Foreground="{DynamicResource TextSecondary}"
                                                    Text="{Binding Details}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </StackPanel>

                                            <StackPanel Grid.Column="2" Orientation="Horizontal">
                                                <Button Padding="0"
                                                    Width="30"
                                                    Height="30"
                                                    Click="BtnPlayTake_Click"
                                                    Style="{StaticResource NeutralIconButtonStyle}"
                                                    Tag="{Binding}"
                                                    ToolTip="{DynamicResource Str_MicRecorder_PlayStop}">
                                                    <materialDesign:PackIcon
                                                        x:Name="PlayIcon"
                                                        Width="16"
                                                        Height="16"
                                                        Kind="Play" />
                                                </Button>
                                                <Button Padding="0"
                                                    Width="30"
                                                    Height="30"
                                                    Margin="2,0,0,0"
                                                    Click="BtnSaveTake_Click"
                                                    Style="{StaticResource NeutralIconButtonStyle}"
                                                    Tag="{Binding}"
                                                    ToolTip="{DynamicResource Str_MicRecorder_SaveAs}">
                                                    <materialDesign:PackIcon
                                                        Width="16"
                                                        Height="16"
                                                        Kind="ContentSaveOutline" />
                                                </Button>
                                                <Button Padding="0"
                                                    x:Name="BtnShowTake"
                                                    Width="30"
                                                    Height="30"
                                                    Margin="2,0,0,0"
                                                    Click="BtnShowTake_Click"
                                                    Style="{StaticResource NeutralIconButtonStyle}"
                                                    Tag="{Binding}"
                                                    ToolTip="{DynamicResource Str_Validate_MenuShowInFolder}"
                                                    Visibility="Collapsed">
                                                    <materialDesign:PackIcon
                                                        Width="16"
                                                        Height="16"
                                                        Kind="FolderOpenOutline" />
                                                </Button>
                                                <Button
                                                    Width="30"
                                                    Height="30"
                                                    Margin="2,0,0,0"
                                                    Click="BtnRemoveTake_Click"
                                                    Style="{StaticResource IconButtonStyle}"
                                                    Tag="{Binding}"
                                                    ToolTip="{DynamicResource Str_MicRecorder_TakeOffTheList}">
                                                    <materialDesign:PackIcon
                                                        Width="14"
                                                        Height="14"
                                                        Kind="Close" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                                <Setter TargetName="PlayIcon" Property="Kind" Value="Stop" />
                                                <Setter TargetName="BadgeIcon" Property="Kind" Value="VolumeHigh" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSaved}" Value="True">
                                                <Setter TargetName="BtnShowTake" Property="Visibility" Value="Visible" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsSaved}" Value="False">
                                                <Setter TargetName="Badge" Property="Background" Value="{DynamicResource StatusWarningBg}" />
                                                <Setter TargetName="BadgeIcon" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <controls:EmptyStateCard
                                x:Name="TakesEmptyPanel"
                                Title="{DynamicResource Str_MicRecorder_NoRecordingsYet}"
                                Description="{DynamicResource Str_MicRecorder_EachRecordingLandsHere}"
                                Icon="MicrophoneOutline"
                                IsHitTestVisible="False" />
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
