<UserControl
    x:Class="Smart_Tools.WPF.Views.FolderTreeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:models="clr-namespace:Smart_Tools.WPF.Models"
    x:Name="Root"
    Focusable="True"
    Loaded="Root_Loaded">

    <!--  Backend: Controllers/FolderTreeManager.cs (scan, render, save). UI only here.  -->

    <UserControl.Resources>
        <!--  The folder row in the input card (same look as Rename's list; this tool keeps one folder)  -->
        <DataTemplate x:Key="QueueItemTemplate" DataType="{x:Type models:FolderListEntry}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="26"
                    Height="26"
                    Margin="0,0,8,0"
                    Background="{DynamicResource AccentColorSubtle}"
                    CornerRadius="7">
                    <materialDesign:PackIcon
                        Width="14"
                        Height="14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource AccentColor}"
                        Kind="Folder" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource SidebarText}"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding FullPath}" />
                    <TextBlock
                        Margin="0,1,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource SidebarTextMuted}"
                        Text="{Binding FullPath}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding FullPath}" />
                </StackPanel>
                <Button
                    Grid.Column="2"
                    Width="24"
                    Height="24"
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    Click="BtnRemoveSingleFolder_Click"
                    Style="{StaticResource IconButtonStyle}"
                    Tag="{Binding}"
                    ToolTip="{DynamicResource Str_Rename_RemoveFolderTooltip}">
                    <materialDesign:PackIcon
                        Width="13"
                        Height="13"
                        Kind="Close" />
                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">
        <Grid Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= OPTIONS SIDEBAR =================  -->
            <controls:ToolSidebar>
                <StackPanel x:Name="SidebarStack">
                    <controls:InputFolderCard ctl:Tour.Key="Str_Tour_FolderTree_Input" ctl:Tour.Order="1"
                        x:Name="InputCard"
                        ClearRequested="InputCard_ClearRequested"
                        Header="{DynamicResource Str_FolderTree_FolderToExport}"
                        HeaderIcon="FolderOutline"
                        ItemTemplate="{StaticResource QueueItemTemplate}"
                        Mode="Folders"
                        PathsAdded="InputCard_PathsAdded"
                        ShowSubfolders="False" />

                    <Border ctl:Tour.Key="Str_Tour_FolderTree_Format" ctl:Tour.Order="2" Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl Content="{DynamicResource Str_FolderTree_FormatHeader}" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.FileTreeOutline}" />
                            <ComboBox x:Name="CmbFormat" Margin="0,2,0,0" SelectedIndex="0" SelectionChanged="CmbFormat_SelectionChanged" ToolTip="{DynamicResource Str_FolderTree_FormatTooltip}">
                                <ComboBoxItem Tag="Text">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Kind="FileTreeOutline" />
                                        <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_FolderTree_TextTree}" />
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="Markdown">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Kind="LanguageMarkdownOutline" />
                                        <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_MarkdownHtmlEditor_Markdown}" />
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="Html">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Kind="LanguageHtml5" />
                                        <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_FolderTree_FmtHtml}" />
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="Json">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Kind="CodeJson" />
                                        <TextBlock VerticalAlignment="Center" Text="JSON" />
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="Xml">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Kind="Xml" />
                                        <TextBlock VerticalAlignment="Center" Text="XML" />
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="Yaml">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Kind="FileCodeOutline" />
                                        <TextBlock VerticalAlignment="Center" Text="YAML" />
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="Csv">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Kind="FileDelimitedOutline" />
                                        <TextBlock VerticalAlignment="Center" Text="CSV" />
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="Paths">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Kind="FormatListBulleted" />
                                        <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_FolderTree_FmtPaths}" />
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="Pdf">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Kind="FilePdfBox" />
                                        <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_FolderTree_FmtPdf}" />
                                    </StackPanel>
                                </ComboBoxItem>
                                <ComboBoxItem Tag="Image">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Kind="FileImageOutline" />
                                        <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_FolderTree_FmtImage}" />
                                    </StackPanel>
                                </ComboBoxItem>
                            </ComboBox>
                            <TextBlock x:Name="TxtFormatHint" Margin="2,8,0,0" FontSize="11" Foreground="{DynamicResource SidebarTextMuted}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <Border ctl:Tour.Key="Str_Tour_FolderTree_Options" ctl:Tour.Order="3" Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl Content="{DynamicResource Str_FolderTree_WhatToList}" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.TuneVariant}" />
                            <TextBlock Margin="2,8,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SidebarTextMuted}" Text="{DynamicResource Str_FolderTree_HowDeep}" />
                            <ComboBox x:Name="CmbDepth" Margin="0,6,0,0" SelectedIndex="0" SelectionChanged="Option_Changed">
                                <ComboBoxItem Content="{DynamicResource Str_FolderTree_AllLevels}" />
                                <ComboBoxItem Content="{DynamicResource Str_FolderTree_Level}" />
                                <ComboBoxItem Content="{DynamicResource Str_FolderTree_Levels}" />
                                <ComboBoxItem Content="{DynamicResource Str_FolderTree_Levels2}" />
                                <ComboBoxItem Content="{DynamicResource Str_FolderTree_Levels3}" />
                                <ComboBoxItem Content="{DynamicResource Str_FolderTree_Levels4}" />
                            </ComboBox>
                            <CheckBox x:Name="ChkFiles" Margin="2,12,0,0" Checked="Option_Changed" Content="{DynamicResource Str_FolderTree_IncludeFiles}" Foreground="{DynamicResource SidebarText}" IsChecked="True" Unchecked="Option_Changed" />
                            <CheckBox x:Name="ChkSize" Margin="2,8,0,0" Checked="Option_Changed" Content="{DynamicResource Str_FolderTree_ShowSizes}" Foreground="{DynamicResource SidebarText}" IsChecked="True" Unchecked="Option_Changed" />
                            <CheckBox x:Name="ChkDate" Margin="2,8,0,0" Checked="Option_Changed" Content="{DynamicResource Str_FolderTree_ShowModifiedDates}" Foreground="{DynamicResource SidebarText}" Unchecked="Option_Changed" />
                            <CheckBox x:Name="ChkHidden" Margin="2,8,0,0" Checked="Option_Changed" Content="{DynamicResource Str_FolderTree_IncludeHiddenAndSystem}" Foreground="{DynamicResource SidebarText}" Unchecked="Option_Changed" />
                            <CheckBox x:Name="ChkNoise" Margin="2,8,0,0" Checked="Option_Changed" Content="{DynamicResource Str_FolderTree_SkipGitNodeModules}" Foreground="{DynamicResource SidebarText}" IsChecked="True" Unchecked="Option_Changed" />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl Content="{DynamicResource Str_FolderTree_GoodToKnowHeader}" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.InformationOutline}" />
                            <TextBlock Margin="2,6,0,0" FontSize="10.5" Foreground="{DynamicResource SidebarTextMuted}" TextWrapping="Wrap" Text="{DynamicResource Str_FolderTree_ThisOnlyReadsYour}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </controls:ToolSidebar>

            <!--  ================= MAIN AREA =================  -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Run bar  -->
                <Border Grid.Row="0" Margin="0,0,0,14" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button ctl:Tour.Key="Str_Tour_FolderTree_Build" ctl:Tour.Order="4" x:Name="BtnStart" MinWidth="180" VerticalAlignment="Center" Click="BtnStart_Click" Style="{StaticResource AccentPrimaryButtonStyle}" ToolTip="{DynamicResource Str_FolderTree_ReadTheFolderAnd}">
                            <Grid HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon x:Name="IconStart" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" Kind="FileTreeOutline" />
                                <TextBlock x:Name="TxtStart" Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_FolderTree_BuildTree}" TextWrapping="Wrap" />
                            </Grid>
                        </Button>

                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <ProgressBar x:Name="Bar" Height="8" Maximum="100" />
                            <TextBlock x:Name="TxtProgress" Margin="0,6,0,0" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource Str_FolderTree_ChooseAFolderTo}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock x:Name="TxtProgressPercent" Grid.Column="2" MinWidth="54" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentColor}" TextAlignment="Right" />
                    </Grid>
                </Border>

                <!--  Tree  -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ContentControl VerticalAlignment="Center" Content="{DynamicResource Str_FolderTree_Tree}" Style="{StaticResource CardHeader}" Tag="{x:Static materialDesign:PackIconKind.FileTreeOutline}" />

                            <WrapPanel x:Name="SummaryPanel" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                <Border Margin="0,2,6,2" Background="{DynamicResource StatusInfoBg}" Style="{StaticResource IconStatusPillStyle}" ToolTip="{DynamicResource Str_FolderTree_FoldersListed}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource StatusInfoFg}" Kind="FolderOutline" />
                                        <TextBlock x:Name="TxtSummaryFolders" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource StatusInfoFg}" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,2,6,2" Background="{DynamicResource StatusSuccessBg}" Style="{StaticResource IconStatusPillStyle}" ToolTip="{DynamicResource Str_FolderTree_FilesListed}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource StatusSuccessFg}" Kind="FileOutline" />
                                        <TextBlock x:Name="TxtSummaryFiles" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource StatusSuccessFg}" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,2,6,2" Background="{DynamicResource AccentColorSubtle}" Style="{StaticResource IconStatusPillStyle}" ToolTip="{DynamicResource Str_FolderTree_TotalSizeOfThe}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentColor}" Kind="Database" />
                                        <TextBlock x:Name="TxtSummarySize" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentColor}" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="PillUnreadable" Margin="0,2,6,2" Background="{DynamicResource StatusWarningBg}" Style="{StaticResource IconStatusPillStyle}" ToolTip="{DynamicResource Str_FolderTree_FoldersThatCouldNot}" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource StatusWarningFg}" Kind="LockOutline" />
                                        <TextBlock x:Name="TxtSummaryUnreadable" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource StatusWarningFg}" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                                <Button x:Name="BtnCopy" Margin="0,0,6,0" Click="BtnCopy_Click" IsEnabled="False" Style="{StaticResource ListToolButtonStyle}" ToolTip="{DynamicResource Str_FolderTree_CopyTheTreeTo}">
                                    <materialDesign:PackIcon Width="16" Height="16" Kind="ContentCopy" />
                                </Button>
                                <Button x:Name="BtnSave" Click="BtnSave_Click" IsEnabled="False" Style="{StaticResource ListToolButtonStyle}" ToolTip="{DynamicResource Str_FolderTree_SaveTheTreeTo}">
                                    <materialDesign:PackIcon Width="16" Height="16" Kind="ContentSaveOutline" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Border x:Name="StatusBanner" Grid.Row="1" Margin="0,0,0,10" Padding="10,8" CornerRadius="8" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon x:Name="StatusIcon" Width="14" Height="14" Margin="0,1,8,0" VerticalAlignment="Top" Kind="AlertOutline" />
                                <TextBlock x:Name="TxtStatus" Grid.Column="1" FontSize="11.5" TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Background="{DynamicResource RowBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="12">
                            <Grid>
                                <TextBox ctl:Tour.Key="Str_Tour_FolderTree_Preview" ctl:Tour.Order="5" x:Name="TxtPreview" Padding="12" HorizontalAlignment="Stretch" VerticalAlignment="Stretch" Background="Transparent" BorderThickness="0" FontSize="13" Foreground="{DynamicResource TextPrimary}" IsReadOnly="True" PreviewMouseWheel="TxtPreview_PreviewMouseWheel" Style="{StaticResource CodeTextBoxNoWrap}" ToolTip="{DynamicResource Str_Rest_CtrlWheelZoom}" />
                                <StackPanel x:Name="PreviewEmpty" MaxWidth="340" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.FileTreeOutline}" />
                                    <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource Str_FolderTree_PickAFolder}" />
                                    <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource Str_FolderTree_DropAFolderOn}" TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
