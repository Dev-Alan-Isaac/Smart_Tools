<UserControl
    x:Class="Smart_Tools.WPF.Views.FileSearchView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:models="clr-namespace:Smart_Tools.WPF.Models"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    x:Name="Root"
    AllowDrop="True"
    Loaded="Root_Loaded"
    PreviewDragLeave="Root_DragLeave"
    PreviewDragOver="Root_DragOver"
    PreviewDrop="Root_Drop"
    SizeChanged="Root_SizeChanged"
    Unloaded="Root_Unloaded">

    <!--
        Backend: Controllers/FileSearchManager.cs (finding files, matching,
        unique values, streaming rows in order) and FileSearchManager.Export.cs
        (CSV/TXT, copy, settings); Models/FileSearchModel.cs. This file and
        the code-behind are UI only.
    -->

    <UserControl.Resources>

        <!--  A pattern that can be ticked: several at once  -->
        <Style x:Key="PatternCheckStyle" TargetType="CheckBox">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarText}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Border
                            x:Name="Bd"
                            Padding="8,6"
                            Background="{DynamicResource SidebarInputBg}"
                            BorderBrush="{DynamicResource SidebarInputBorder}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon
                                    x:Name="Box"
                                    Width="16"
                                    Height="16"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource SidebarTextMuted}"
                                    Kind="CheckboxBlankOutline" />
                                <ContentPresenter Grid.Column="1" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentColorSubtle}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                                <Setter TargetName="Box" Property="Kind" Value="CheckboxMarked" />
                                <Setter TargetName="Box" Property="Foreground" Value="{DynamicResource AccentColor}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="Bd" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <DataTemplate x:Key="PatternChoiceTemplate" DataType="{x:Type models:FileSearchPatternChoice}">
            <Grid Margin="0,0,0,5" ToolTip="{Binding Tooltip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox
                    x:Name="Check"
                    IsChecked="{Binding IsChecked, Mode=TwoWay}"
                    Style="{StaticResource PatternCheckStyle}">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <TextBlock
                                FontSize="11.5"
                                FontWeight="SemiBold"
                                Text="{Binding Name}"
                                TextTrimming="CharacterEllipsis" />
                            <Border
                                x:Name="WildTag"
                                Margin="6,0,0,0"
                                Padding="5,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource StatusInfoBg}"
                                CornerRadius="5"
                                Visibility="Collapsed">
                                <TextBlock
                                    FontSize="9.5"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource StatusInfoFg}"
                                    Text="{DynamicResource Str_SearchFile_Wildcard}" />
                            </Border>
                            <materialDesign:PackIcon
                                x:Name="ErrorIcon"
                                Width="13"
                                Height="13"
                                Margin="6,0,0,0"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource StatusErrorFg}"
                                Kind="AlertCircleOutline"
                                Visibility="Collapsed" />
                        </StackPanel>
                        <TextBlock
                            Margin="0,1,0,0"
                            FontFamily="Consolas"
                            FontSize="10"
                            Foreground="{DynamicResource SidebarTextMuted}"
                            Text="{Binding Pattern}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </CheckBox>
                <Button
                    x:Name="RemoveButton"
                    Grid.Column="1"
                    Width="24"
                    Height="24"
                    Margin="4,0,0,0"
                    VerticalAlignment="Center"
                    Click="BtnRemovePattern_Click"
                    Style="{StaticResource IconButtonStyle}"
                    Tag="{Binding}"
                    ToolTip="{DynamicResource Str_Search_RemovePatternTooltip}"
                    Visibility="Collapsed">
                    <materialDesign:PackIcon
                        Width="12"
                        Height="12"
                        Kind="Close" />
                </Button>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsSaved}" Value="False">
                    <Setter TargetName="RemoveButton" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsWildcard}" Value="True">
                    <Setter TargetName="WildTag" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding HasError}" Value="True">
                    <Setter TargetName="ErrorIcon" Property="Visibility" Value="Visible" />
                    <Setter TargetName="Check" Property="IsEnabled" Value="False" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  Results: file name over its folder  -->
        <DataTemplate x:Key="FileCellTemplate" DataType="{x:Type models:FileSearchResult}">
            <StackPanel VerticalAlignment="Center" ToolTip="{Binding FullPath}">
                <TextBlock
                    Foreground="{DynamicResource TextPrimary}"
                    Text="{Binding Name, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    x:Name="FolderText"
                    Margin="0,1,0,0"
                    FontSize="11"
                    Foreground="{DynamicResource TextSecondary}"
                    Text="{Binding Folder, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
            </StackPanel>
        </DataTemplate>

        <!--  Results: the match, with the whole line in the tooltip  -->
        <DataTemplate x:Key="MatchCellTemplate" DataType="{x:Type models:FileSearchResult}">
            <StackPanel VerticalAlignment="Center" ToolTip="{Binding LineText}">
                <TextBlock
                    FontFamily="Consolas"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimary}"
                    Text="{Binding MatchText, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
                <TextBlock
                    Margin="0,1,0,0"
                    FontFamily="Consolas"
                    FontSize="11"
                    Foreground="{DynamicResource TextSecondary}"
                    Text="{Binding SegmentsText, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Style.Triggers>
                                <Trigger Property="Text" Value="">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                </Trigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </StackPanel>
        </DataTemplate>

        <!--  Results: how often a unique value was found  -->
        <DataTemplate x:Key="SeenCellTemplate" DataType="{x:Type models:FileSearchResult}">
            <Border
                x:Name="Chip"
                Padding="7,1"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="{DynamicResource RowBg}"
                CornerRadius="8"
                ToolTip="{Binding SeenTooltip}">
                <TextBlock
                    x:Name="ChipText"
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextSecondary}"
                    Text="{Binding SeenLabel}"
                    TextTrimming="CharacterEllipsis" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding SeenMore}" Value="True">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusInfoBg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusInfoFg}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  Results: which pattern found it  -->
        <DataTemplate x:Key="PatternCellTemplate" DataType="{x:Type models:FileSearchResult}">
            <Border
                Padding="7,1"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="{DynamicResource AccentColorSubtle}"
                CornerRadius="8">
                <TextBlock
                    FontSize="11"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource AccentColor}"
                    Text="{Binding PatternName, Mode=OneWay}"
                    TextTrimming="CharacterEllipsis" />
            </Border>
        </DataTemplate>

        <!--  Results: name or content  -->
        <DataTemplate x:Key="KindCellTemplate" DataType="{x:Type models:FileSearchResult}">
            <Border
                x:Name="Chip"
                Padding="7,1"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="{DynamicResource StatusSuccessBg}"
                CornerRadius="8">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon
                        x:Name="ChipIcon"
                        Width="12"
                        Height="12"
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource StatusSuccessFg}"
                        Kind="TextBoxSearchOutline" />
                    <TextBlock
                        x:Name="ChipText"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource StatusSuccessFg}"
                        Text="{Binding KindLabel, Mode=OneWay}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="FileName">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusWarningBg}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="FileDocumentOutline" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <Style x:Key="MutedCellText" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="VerticalAlignment" Value="Center" />
        <Setter Property="TextTrimming" Value="CharacterEllipsis" />
        </Style>


        <!--  Input card: one queued item  -->
        <DataTemplate x:Key="QueueItemTemplate" DataType="{x:Type models:FileSearchFolder}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="26"
                    Height="26"
                    Margin="0,0,8,0"
                    Background="{DynamicResource AccentColorSubtle}"
                    CornerRadius="7">
                    <materialDesign:PackIcon
                        Width="14"
                        Height="14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource AccentColor}"
                        Kind="Folder" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource SidebarText}"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding FullPath}" />
                    <TextBlock
                        Margin="0,1,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource SidebarTextMuted}"
                        Text="{Binding FullPath}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding FullPath}" />
                </StackPanel>
                <Button
                    Grid.Column="2"
                    Width="24"
                    Height="24"
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    Click="BtnRemoveSingleFolder_Click"
                    Style="{StaticResource IconButtonStyle}"
                    Tag="{Binding}"
                    ToolTip="{DynamicResource Str_Search_RemoveFolderTooltip}">
                    <materialDesign:PackIcon
                        Width="13"
                        Height="13"
                        Kind="Close" />
                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">

        <!--  No page header: MainWindow's header card shows the tool's icon and name.  -->

        <Grid Margin="16,8,16,16">

            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OptionsColumn" Width="280" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= OPTIONS SIDEBAR =================  -->

            <Border Grid.Column="0" Style="{StaticResource SidebarPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Button
                            x:Name="BtnCollapseOptions"
                            MinHeight="45"
                            HorizontalContentAlignment="Left"
                            Click="BtnCollapseOptions_Click"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Foreground="{DynamicResource SidebarText}"
                            ToolTip="{DynamicResource Str_Common_SidebarToggleTooltip}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="OverridesDefaultStyle" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Margin="16,0,0,0" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Kind="TuneVariant" />
                                <TextBlock
                                    x:Name="TxtOptionsHeaderLabel"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{DynamicResource Str_Common_OptionsLabel}" />
                            </StackPanel>
                        </Button>
                        <Separator
                            x:Name="SepHeader"
                            Margin="16,4"
                            Style="{StaticResource SidebarSeparatorStyle}" />
                    </StackPanel>

                    <ScrollViewer
                        x:Name="OptionsScrollViewer"
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16,4,16,16">

                            <!--  ============ FOLDERS ============  -->
                            <controls:InputFolderCard
                                x:Name="InputCard"
                                ctl:Tour.Key="Str_Tour_SearchFiles_Input" ctl:Tour.Order="1"
                                ClearRequested="InputCard_ClearRequested"
                                Header="{DynamicResource Str_Search_FoldersHeader}"
                                HeaderIcon="FolderSearchOutline"
                                IncludeSubfoldersChanged="InputCard_IncludeSubfoldersChanged"
                                ItemTemplate="{StaticResource QueueItemTemplate}"
                                Mode="Folders"
                                PathsAdded="InputCard_PathsAdded" />


                            <!--  ============ SEARCH MODE ============  -->
                            <Border ctl:Tour.Key="Str_Tour_SearchFiles_Options" ctl:Tour.Order="2" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Search_OptionsHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.TextSearch}" />
                                    <UniformGrid Columns="3">
                                        <RadioButton
                                            x:Name="RadioModeText"
                                            Margin="0,0,2,0"
                                            Click="Mode_Click"
                                            GroupName="SearchMode"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="Text"
                                            ToolTip="{DynamicResource Str_SearchFile_FindThisTextAnywhere}">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="18"
                                                    Height="18"
                                                    HorizontalAlignment="Center"
                                                    Kind="FormatText" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    HorizontalAlignment="Center"
                                                    Text="{DynamicResource Str_FileDiff_ColHeaderText}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="RadioModeWildcard"
                                            Margin="2,0"
                                            Click="Mode_Click"
                                            GroupName="SearchMode"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="Wildcard"
                                            ToolTip="{DynamicResource Str_Search_UseWildcardsTooltip}">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="18"
                                                    Height="18"
                                                    HorizontalAlignment="Center"
                                                    Kind="Asterisk" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    HorizontalAlignment="Center"
                                                    Text="{DynamicResource Str_SearchFile_Wildcard}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="RadioModeRegex"
                                            Margin="2,0,0,0"
                                            Click="Mode_Click"
                                            GroupName="SearchMode"
                                            Style="{StaticResource ModeToggleTallStyle}"
                                            Tag="Regex"
                                            ToolTip="{DynamicResource Str_Search_UseRegexTooltip}">
                                            <StackPanel>
                                                <materialDesign:PackIcon
                                                    Width="18"
                                                    Height="18"
                                                    HorizontalAlignment="Center"
                                                    Kind="Regex" />
                                                <TextBlock
                                                    Margin="0,3,0,0"
                                                    HorizontalAlignment="Center"
                                                    Text="{DynamicResource Str_Log_RegexCheckbox}" />
                                            </StackPanel>
                                        </RadioButton>
                                    </UniformGrid>
                                    <TextBlock
                                        x:Name="TxtModeHint"
                                        Margin="2,8,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource SidebarTextMuted}"
                                        TextWrapping="Wrap" />

                                    <CheckBox
                                        x:Name="ChkSearchFileNames"
                                        Margin="0,10,0,0"
                                        Click="Option_Click"
                                        Content="{DynamicResource Str_Search_SearchFileNames}"
                                        Foreground="{DynamicResource SidebarText}"
                                        IsChecked="True"
                                        ToolTip="{DynamicResource Str_Search_SearchFileNamesTooltip}" />
                                    <CheckBox
                                        x:Name="ChkSearchFileContents"
                                        Margin="0,8,0,0"
                                        Click="Option_Click"
                                        Content="{DynamicResource Str_Search_SearchFileContents}"
                                        Foreground="{DynamicResource SidebarText}"
                                        IsChecked="True"
                                        ToolTip="{DynamicResource Str_Search_SearchFileContentsTooltip}" />
                                    <CheckBox
                                        x:Name="ChkCaseSensitive"
                                        Margin="0,8,0,0"
                                        Click="Option_Click"
                                        Content="{DynamicResource Str_Search_CaseSensitive}"
                                        Foreground="{DynamicResource SidebarText}"
                                        ToolTip="{DynamicResource Str_Common_MatchCaseTooltip}" />
                                    <CheckBox
                                        x:Name="ChkWholeWordOnly"
                                        Margin="0,8,0,0"
                                        Click="Option_Click"
                                        Content="{DynamicResource Str_Common_WholeWordOnly}"
                                        Foreground="{DynamicResource SidebarText}"
                                        ToolTip="{DynamicResource Str_Common_WholeWordOnlyTooltip}" />
                                </StackPanel>
                            </Border>

                            <!--  ============ PATTERNS (regex mode) ============  -->
                            <Border
                                x:Name="PanelRegexOptions"
                                ctl:Tour.Key="Str_Tour_SearchFiles_Patterns" ctl:Tour.Order="3"
                                Style="{StaticResource SidebarGroupCardStyle}"
                                Visibility="Collapsed">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ContentControl
                                            Content="{DynamicResource Str_Search_CommonPatterns}"
                                            Style="{StaticResource SidebarGroupHeader}"
                                            Tag="{x:Static materialDesign:PackIconKind.CheckboxMultipleMarkedOutline}" />
                                        <StackPanel
                                            Grid.Column="1"
                                            VerticalAlignment="Top"
                                            Orientation="Horizontal">
                                            <Button Padding="0"
                                                x:Name="BtnTickAllPatterns"
                                                Width="26"
                                                Height="26"
                                                Click="BtnTickAllPatterns_Click"
                                                Style="{StaticResource NeutralIconButtonStyle}"
                                                ToolTip="{DynamicResource Str_SearchFile_TickEveryPattern}">
                                                <materialDesign:PackIcon
                                                    Width="14"
                                                    Height="14"
                                                    Kind="CheckboxMultipleMarkedOutline" />
                                            </Button>
                                            <Button Padding="0"
                                                x:Name="BtnUntickAllPatterns"
                                                Width="26"
                                                Height="26"
                                                Margin="2,0,0,0"
                                                Click="BtnUntickAllPatterns_Click"
                                                Style="{StaticResource NeutralIconButtonStyle}"
                                                ToolTip="{DynamicResource Str_SearchFile_UntickEveryPattern}">
                                                <materialDesign:PackIcon
                                                    Width="14"
                                                    Height="14"
                                                    Kind="CheckboxMultipleBlankOutline" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock
                                        Margin="2,0,0,8"
                                        FontSize="11"
                                        Foreground="{DynamicResource SidebarTextMuted}"
                                        Text="{DynamicResource Str_SearchFile_TickAsManyAs}"
                                        TextWrapping="Wrap" />
                                    <ScrollViewer
                                        MaxHeight="300"
                                        HorizontalScrollBarVisibility="Disabled"
                                        VerticalScrollBarVisibility="Auto">
                                        <ItemsControl
                                            x:Name="LstRegexPatterns"
                                            ItemTemplate="{StaticResource PatternChoiceTemplate}"
                                            ToolTip="{DynamicResource Str_Search_PatternListTooltip}" />
                                    </ScrollViewer>
                                    <TextBlock
                                        x:Name="TxtPatternCount"
                                        Margin="2,6,0,0"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource SidebarText}" />
                                </StackPanel>
                            </Border>

                            <!--  ============ RESULTS ============  -->
                            <Border Margin="0,0,0,4" ctl:Tour.Key="Str_Tour_SearchFiles_Results" ctl:Tour.Order="4" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Search_ResultsTitle}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.FilterVariant}" />
                                    <CheckBox
                                        x:Name="ChkUniqueMatchesOnly"
                                        Click="Option_Click"
                                        Content="{DynamicResource Str_SearchFile_ListEachValueOnly}"
                                        Foreground="{DynamicResource SidebarText}"
                                        ToolTip="{DynamicResource Str_SearchFile_AValueFoundAgain}" />
                                    <TextBlock
                                        Margin="22,2,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource SidebarTextMuted}"
                                        Text="{DynamicResource Str_SearchFile_AcrossAllFilesRepeats}"
                                        TextWrapping="Wrap" />
                                    <CheckBox
                                        x:Name="ChkRegexFirstMatchOnly"
                                        Margin="0,10,0,0"
                                        Click="Option_Click"
                                        Content="{DynamicResource Str_SearchFile_AtMostOneRow}"
                                        Foreground="{DynamicResource SidebarText}"
                                        ToolTip="{DynamicResource Str_Search_StopAtFirstMatchTooltip}" />
                                    <TextBlock
                                        x:Name="TxtFirstMatchHint"
                                        Margin="22,2,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource SidebarTextMuted}"
                                        Text="{DynamicResource Str_SearchFile_StopsReadingAFile}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>

                    <StackPanel x:Name="OptionsBottomPanel" Grid.Row="2" />
                </Grid>
            </Border>

            <!--  ================= MAIN =================  -->

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Search bar + progress  -->
                <Border
                    Grid.Row="0"
                    Margin="0,0,0,12"
                    Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <Grid>
                            <!--  Search button on the left, the search box fills the rest  -->
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!--  Text / wildcard  -->
                            <Border
                                x:Name="PanelSearchText"
                                Grid.Column="1"
                                Style="{StaticResource InputBarStyle}">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon
                                        x:Name="IconSearchText"
                                        Width="18"
                                        Height="18"
                                        Margin="12,0,6,0"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource AccentColor}"
                                        Kind="Magnify" />
                                    <TextBox
                                        x:Name="TxtSearchText"
                                        Grid.Column="1"
                                        FontSize="14"
                                        KeyDown="SearchBox_KeyDown"
                                        Style="{StaticResource BareTextBox}"
                                        Tag="What are you looking for?"
                                        TextChanged="TxtSearchText_TextChanged"
                                        ToolTip="{DynamicResource Str_Search_TextTooltip}" />
                                </Grid>
                            </Border>

                            <!--  Regex: type a pattern; Enter or + adds it to the ticked list  -->
                            <Border
                                x:Name="PanelRegexInput"
                                Grid.Column="1"
                                Style="{StaticResource InputBarStyle}"
                                Visibility="Collapsed">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon
                                        Width="18"
                                        Height="18"
                                        Margin="2,0,0,0"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource AccentColor}"
                                        Kind="Regex" />
                                    <TextBox
                                        x:Name="TxtRegexPattern"
                                        Grid.Column="1"
                                        FontFamily="Consolas"
                                        FontSize="14"
                                        KeyDown="TxtRegexPattern_KeyDown"
                                        Style="{StaticResource BareTextBox}"
                                        Tag="Type a pattern (optional) - Enter adds it to the list"
                                        TextChanged="TxtRegexPattern_TextChanged"
                                        ToolTip="{DynamicResource Str_Search_PatternTooltip}" />
                                    <Button Padding="0"
                                        x:Name="BtnAddRegexPattern"
                                        Grid.Column="2"
                                        Width="30"
                                        Height="30"
                                        Margin="3,2,3,2"
                                        Click="BtnAddRegexPattern_Click"
                                        Style="{StaticResource NeutralIconButtonStyle}"
                                        ToolTip="{DynamicResource Str_Search_AddPatternTooltip}">
                                        <materialDesign:PackIcon
                                            Width="16"
                                            Height="16"
                                            Kind="Plus" />
                                    </Button>
                                </Grid>
                            </Border>

                            <Button
                                x:Name="BtnSearchFiles"
                                ctl:Tour.Key="Str_Tour_SearchFiles_Run" ctl:Tour.Order="5"
                                Grid.Column="0"
                                MinWidth="150"
                                Margin="0,0,10,0"
                                VerticalAlignment="Center"
                                Click="BtnSearchFiles_Click"
                                Style="{StaticResource AccentPrimaryButtonStyle}"
                                ToolTip="{DynamicResource Str_Search_RunSearchTooltip}">
                                <Grid HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon
                                        Grid.Column="0"
                                        x:Name="IconSearch"
                                        Width="18"
                                        Height="18"
                                        Margin="0,0,8,0"
                                        VerticalAlignment="Center"
                                        Kind="FileSearchOutline" />
                                    <TextBlock
                                        Grid.Column="1"
                                        x:Name="TxtSearchLabel"
                                        VerticalAlignment="Center"
                                        Text="{DynamicResource Str_Search_RunSearchButton}" TextWrapping="Wrap" />
                                </Grid>
                            </Button>
                        </Grid>

                        <TextBlock
                            x:Name="TxtRegexValidation"
                            Margin="4,6,0,0"
                            FontSize="11"
                            Foreground="{DynamicResource TextSecondary}"
                            TextWrapping="Wrap"
                            Visibility="Collapsed" />

                        <!--  What's wrong before a search can start  -->
                        <Border
                            x:Name="SearchErrorBanner"
                            Margin="0,8,0,0"
                            Padding="10,8"
                            Background="{DynamicResource StatusErrorBg}"
                            CornerRadius="8"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource StatusErrorFg}"
                                    Kind="AlertCircleOutline" />
                                <TextBlock
                                    x:Name="TxtSearchError"
                                    VerticalAlignment="Center"
                                    FontSize="11.5"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource StatusErrorFg}"
                                    TextWrapping="Wrap" />
                            </StackPanel>
                        </Border>

                        <Grid Margin="0,12,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <ProgressBar
                                    x:Name="ProgressSearch"
                                    Height="8"
                                    Maximum="100"
                                    ToolTip="{DynamicResource Str_Search_ProgressTooltip}" />
                                <TextBlock
                                    x:Name="TxtProgress"
                                    Margin="0,6,0,0"
                                    FontSize="11.5"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{DynamicResource Str_Search_ProgressInitial}"
                                    TextTrimming="CharacterEllipsis"
                                    ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                            </StackPanel>
                            <TextBlock
                                x:Name="TxtProgressPercent"
                                Grid.Column="1"
                                MinWidth="54"
                                Margin="16,0,0,0"
                                VerticalAlignment="Center"
                                FontSize="20"
                                FontWeight="Bold"
                                Foreground="{DynamicResource AccentColor}"
                                TextAlignment="Right" />
                        </Grid>
                    </StackPanel>
                </Border>

                <!--  Results  -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <ContentControl
                                VerticalAlignment="Center"
                                Content="{DynamicResource Str_Search_ResultsTitle}"
                                Style="{StaticResource CardHeader}"
                                Tag="{x:Static materialDesign:PackIconKind.FileSearchOutline}" />

                            <WrapPanel
                                x:Name="SummaryPanel"
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                                <Border
                                    x:Name="PillResults"
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource StatusInfoBg}"
                                    Style="{StaticResource IconStatusPillStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource StatusInfoFg}"
                                            Kind="FormatListBulleted" />
                                        <TextBlock
                                            x:Name="TxtResultCount"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource StatusInfoFg}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    x:Name="PillFiles"
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource StatusSuccessBg}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    ToolTip="{DynamicResource Str_SearchFile_FilesWithAMatch}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource StatusSuccessFg}"
                                            Kind="FileCheckOutline" />
                                        <TextBlock
                                            x:Name="TxtFilesCount"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource StatusSuccessFg}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    x:Name="PillSkipped"
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource StatusWarningBg}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource StatusWarningFg}"
                                            Kind="FileHidden" />
                                        <TextBlock
                                            x:Name="TxtSkippedCount"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource StatusWarningFg}" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <StackPanel
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Border Width="190" Style="{StaticResource InputBarStyle}">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon
                                            Width="14"
                                            Height="14"
                                            Margin="10,0,6,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource AccentColor}"
                                            Kind="FilterOutline" />
                                        <TextBox
                                            x:Name="TxtResultFilter"
                                            Grid.Column="1"
                                            Style="{StaticResource BareTextBox}"
                                            Tag="Filter results"
                                            TextChanged="TxtResultFilter_TextChanged"
                                            ToolTip="{DynamicResource Str_SearchFile_ShowOnlyRowsWhose}" />
                                    </Grid>
                                </Border>
                                <!--  Export: a menu of the three ways to save (spreadsheet, values as text, text report)  -->
                                <controls:ExportButton
                                    x:Name="BtnExportResults"
                                    Margin="6,0,0,0"
                                    Click="BtnExportResults_Click"
                                    IsEnabled="False"
                                    ToolTip="{DynamicResource Str_SearchFile_SaveTheResultsAs}">
                                    <Button.ContextMenu>
                                        <ContextMenu x:Name="ExportMenu" Placement="Bottom">
                                            <MenuItem
                                                x:Name="MenuExportCsv"
                                                Click="MenuExport_Click"
                                                Header="{DynamicResource Str_SearchFile_SpreadsheetCsvEveryColumn}"
                                                Tag="Csv">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="FileDelimitedOutline" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem
                                                x:Name="MenuExportValues"
                                                Click="MenuExport_Click"
                                                Header="{DynamicResource Str_SearchFile_TextFileJustThe}"
                                                Tag="TextValues">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="FormatListText" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                            <MenuItem
                                                x:Name="MenuExportReport"
                                                Click="MenuExport_Click"
                                                Header="{DynamicResource Str_SearchFile_TextFileReportWith}"
                                                Tag="TextReport">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="TextBoxOutline" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </controls:ExportButton>
                                <Button
                                    x:Name="BtnCopyValues"
                                    Margin="8,0,0,0"
                                    Click="BtnCopyValues_Click"
                                    IsEnabled="False"
                                    Style="{StaticResource ListToolButtonStyle}"
                                    ToolTip="{DynamicResource Str_SearchFile_CopyTheMatchedValues}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="ContentCopy" />
                                </Button>
                                <Button
                                    x:Name="BtnClearResults"
                                    Margin="8,0,0,0"
                                    Click="BtnClearResults_Click"
                                    IsEnabled="False"
                                    Style="{StaticResource ListToolDangerButtonStyle}"
                                    ToolTip="{DynamicResource Str_Search_ClearTooltip}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="DeleteSweepOutline" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <DataGrid
                            x:Name="DataGridResults"
                            ctl:Tour.Key="Str_Tour_SearchFiles_Matches" ctl:Tour.Order="6"
                            Grid.Row="1"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            CanUserReorderColumns="False"
                            ClipboardCopyMode="ExcludeHeader"
                            EnableColumnVirtualization="True"
                            EnableRowVirtualization="True"
                            FontSize="12"
                            IsReadOnly="True"
                            MouseDoubleClick="DataGridResults_MouseDoubleClick"
                            MinRowHeight="44"
                            SelectionMode="Extended"
                            ToolTip="{DynamicResource Str_Search_GridTooltip}"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.ScrollUnit="Pixel"
                            VirtualizingPanel.VirtualizationMode="Recycling"
                            Visibility="Collapsed">
                            <DataGrid.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Click="MenuCopyMatch_Click" Header="{DynamicResource Str_SearchFile_CopyMatch}">
                                        <MenuItem.Icon>
                                            <materialDesign:PackIcon Kind="ContentCopy" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Click="MenuCopyPath_Click" Header="{DynamicResource Str_SearchFile_CopyFilePath}">
                                        <MenuItem.Icon>
                                            <materialDesign:PackIcon Kind="FileLinkOutline" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <Separator />
                                    <MenuItem Click="MenuOpenFile_Click" Header="{DynamicResource Str_SearchFile_OpenFile}">
                                        <MenuItem.Icon>
                                            <materialDesign:PackIcon Kind="OpenInNew" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                    <MenuItem Click="MenuShowInFolder_Click" Header="{DynamicResource Str_Validate_MenuShowInFolder}">
                                        <MenuItem.Icon>
                                            <materialDesign:PackIcon Kind="FolderOpenOutline" />
                                        </MenuItem.Icon>
                                    </MenuItem>
                                </ContextMenu>
                            </DataGrid.ContextMenu>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn
                                    Width="2*"
                                    CellTemplate="{StaticResource MatchCellTemplate}"
                                    Header="{DynamicResource Str_Search_ColHeaderMatch}"
                                    SortMemberPath="MatchText" />
                                <DataGridTemplateColumn
                                    x:Name="ColSeen"
                                    Width="120"
                                    CellTemplate="{StaticResource SeenCellTemplate}"
                                    Header="{DynamicResource Str_SearchFile_Found}"
                                    SortMemberPath="Occurrences"
                                    Visibility="Collapsed" />
                                <DataGridTemplateColumn
                                    x:Name="ColPattern"
                                    Width="120"
                                    CellTemplate="{StaticResource PatternCellTemplate}"
                                    Header="{DynamicResource Str_Regex_PatternHeader}"
                                    SortMemberPath="PatternName"
                                    Visibility="Collapsed" />
                                <DataGridTemplateColumn
                                    x:Name="ColFolder"
                                    Width="2*"
                                    CellTemplate="{StaticResource FileCellTemplate}"
                                    Header="{DynamicResource Str_Search_ColHeaderFile}"
                                    SortMemberPath="FullPath" />
                                <DataGridTextColumn
                                    x:Name="ColLine"
                                    Width="80"
                                    Binding="{Binding LineLabel, Mode=OneWay}"
                                    ElementStyle="{StaticResource MutedCellText}"
                                    Header="{DynamicResource Str_Search_ColHeaderLine}"
                                    SortMemberPath="LineNumber" />
                                <DataGridTemplateColumn
                                    x:Name="ColType"
                                    Width="100"
                                    CellTemplate="{StaticResource KindCellTemplate}"
                                    Header="{DynamicResource Str_Search_ColHeaderType}"
                                    SortMemberPath="Kind" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <controls:EmptyStateCard
                            x:Name="EmptyStatePanel"
                            Title="{DynamicResource Str_SearchFile_FindTextCodesAnd}"
                            Grid.Row="1"
                            Description="{DynamicResource Str_SearchFile_AddOneOrMore}"
                            DescriptionMaxWidth="460"
                            Icon="FileSearchOutline" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>

        <!--  Drop overlay: folders are added to the list  -->
        <Border
            x:Name="DropOverlay"
            Margin="16,8,16,16"
            Panel.ZIndex="10"
            Style="{StaticResource DropZoneStyle}">
            <Grid>
                <Rectangle
                    RadiusX="14"
                    RadiusY="14"
                    Stroke="{DynamicResource AccentColor}"
                    StrokeDashArray="6 4"
                    StrokeThickness="2" />
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                    <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.FolderPlusOutline}" />
                    <TextBlock
                        Margin="0,12,0,0"
                        HorizontalAlignment="Center"
                        FontSize="15"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        Text="{DynamicResource Str_SearchFile_DropFoldersToSearch}" />
                    <TextBlock
                        Margin="0,4,0,0"
                        HorizontalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondary}"
                        Text="{DynamicResource Str_SearchFile_ADroppedFileAdds}" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
