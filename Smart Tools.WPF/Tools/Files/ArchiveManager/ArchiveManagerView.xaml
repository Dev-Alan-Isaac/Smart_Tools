<UserControl
    x:Class="Smart_Tools.WPF.Views.ArchiveManagerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:models="clr-namespace:Smart_Tools.WPF.Models"
    x:Name="Root"
    Focusable="True"
    Loaded="Root_Loaded">

    <!--  Backend: ArchiveManager.cs (runs the bundled 7-Zip), Core\ (split sets, command lines, listing). UI only here.  -->

    <UserControl.Resources>
        <!--  A file or folder row in the input cards  -->
        <DataTemplate x:Key="PathItemTemplate" DataType="{x:Type models:FolderListEntry}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="26"
                    Height="26"
                    Margin="0,0,8,0"
                    Background="{DynamicResource AccentColorSubtle}"
                    CornerRadius="7">
                    <materialDesign:PackIcon
                        Width="14"
                        Height="14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource AccentColor}">
                        <materialDesign:PackIcon.Style>
                            <Style TargetType="materialDesign:PackIcon">
                                <Setter Property="Kind" Value="FileOutline" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                        <Setter Property="Kind" Value="Folder" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </materialDesign:PackIcon.Style>
                    </materialDesign:PackIcon>
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource SidebarText}"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding FullPath}" />
                    <TextBlock
                        Margin="0,1,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource SidebarTextMuted}"
                        Text="{Binding FullPath}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding FullPath}" />
                </StackPanel>
                <Button
                    Grid.Column="2"
                    Width="24"
                    Height="24"
                    Margin="6,0,0,0"
                    Padding="0"
                    VerticalAlignment="Center"
                    Click="BtnRemovePath_Click"
                    Style="{StaticResource IconButtonStyle}"
                    Tag="{Binding}"
                    ToolTip="{DynamicResource Str_Archive_RemovePath}">
                    <materialDesign:PackIcon
                        Width="13"
                        Height="13"
                        Kind="Close" />
                </Button>
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="NameCellTemplate" DataType="{x:Type models:ArchiveRow}">
            <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                <materialDesign:PackIcon
                    Width="16"
                    Height="16"
                    Margin="0,0,8,0"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource AccentColor}">
                    <materialDesign:PackIcon.Style>
                        <Style TargetType="materialDesign:PackIcon">
                            <Setter Property="Kind" Value="FileOutline" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                                    <Setter Property="Kind" Value="FolderOutline" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </materialDesign:PackIcon.Style>
                </materialDesign:PackIcon>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding Path}" />
                    <TextBlock
                        FontSize="11"
                        Foreground="{DynamicResource TextSecondary}"
                        Text="{Binding Folder}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding Path}" />
                </StackPanel>
            </StackPanel>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">
        <Grid Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= OPTIONS SIDEBAR =================  -->
            <controls:ToolSidebar>
                <StackPanel x:Name="SidebarStack">

                    <Border ctl:Tour.Key="Str_Tour_Archive_Mode" ctl:Tour.Order="1" Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl Content="{DynamicResource Str_Archive_ModeHeader}" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.ZipBoxOutline}" />
                            <UniformGrid Columns="2">
                                <RadioButton
                                    x:Name="RbExtract"
                                    Margin="0,0,2,0"
                                    Checked="Mode_Click"
                                    Content="{DynamicResource Str_Archive_ModeExtract}"
                                    GroupName="ArchiveMode"
                                    IsChecked="True"
                                    controls:ChoiceIcon.Kind="PackageUp"
                                    Style="{StaticResource ModeToggleTallStyle}"
                                    Tag="Extract" />
                                <RadioButton
                                    x:Name="RbCreate"
                                    Margin="2,0,0,0"
                                    Checked="Mode_Click"
                                    Content="{DynamicResource Str_Archive_ModeCreate}"
                                    GroupName="ArchiveMode"
                                    controls:ChoiceIcon.Kind="PackageDown"
                                    Style="{StaticResource ModeToggleTallStyle}"
                                    Tag="Create" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <!--  ============ OPEN / EXTRACT ============  -->
                    <StackPanel x:Name="PanelExtract">
                        <controls:InputFolderCard
                            ctl:Tour.Key="Str_Tour_Archive_Input"
                            ctl:Tour.Order="2"
                            x:Name="InputCard"
                            ClearRequested="InputCard_ClearRequested"
                            Header="{DynamicResource Str_Archive_ArchiveHeader}"
                            HeaderIcon="ZipBoxOutline"
                            ItemTemplate="{StaticResource PathItemTemplate}"
                            Mode="Files"
                            ShowSubfolders="False"
                            PathsAdded="InputCard_PathsAdded" />

                        <Border Style="{StaticResource SidebarGroupCardStyle}">
                            <StackPanel>
                                <ContentControl Content="{DynamicResource Str_Archive_PasswordHeader}" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.LockOutline}" />
                                <PasswordBox x:Name="PwdOpen" Margin="0,2,0,0" KeyDown="PwdOpen_KeyDown" />
                                <TextBlock Style="{StaticResource SidebarHint}" Text="{DynamicResource Str_Archive_PasswordNote}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--  ============ CREATE ============  -->
                    <StackPanel x:Name="PanelCreate" Visibility="Collapsed">
                        <controls:InputFolderCard
                            x:Name="CreateInput"
                            ClearRequested="CreateInput_ClearRequested"
                            Header="{DynamicResource Str_Archive_FilesHeader}"
                            HeaderIcon="FolderMultipleOutline"
                            ItemTemplate="{StaticResource PathItemTemplate}"
                            Mode="Files"
                            ShowSubfolders="False"
                            PathsAdded="CreateInput_PathsAdded" />

                        <Border ctl:Tour.Key="Str_Tour_Archive_Options" ctl:Tour.Order="3" Style="{StaticResource SidebarGroupCardStyle}">
                            <StackPanel>
                                <ContentControl Content="{DynamicResource Str_Archive_FormatHeader}" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.TuneVariant}" />
                                <ComboBox x:Name="CmbFormat" Margin="0,2,0,0" SelectionChanged="Option_Changed">
                                    <ComboBoxItem Tag="SevenZip">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Kind="ArchiveOutline" />
                                            <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_Archive_Fmt7z}" />
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="Zip">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Kind="ZipBoxOutline" />
                                            <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_Archive_FmtZip}" />
                                        </StackPanel>
                                    </ComboBoxItem>
                                    <ComboBoxItem Tag="Tar">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,8,0" VerticalAlignment="Center" Kind="PackageVariantClosed" />
                                            <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_Archive_FmtTar}" />
                                        </StackPanel>
                                    </ComboBoxItem>
                                </ComboBox>
                                <TextBlock Margin="0,12,0,6" Style="{StaticResource FieldLabel}" Text="{DynamicResource Str_Archive_LevelHeader}" />
                                <ComboBox x:Name="CmbLevel" SelectionChanged="Option_Changed">
                                    <ComboBoxItem Content="{DynamicResource Str_Archive_LevelStore}" Tag="Store" />
                                    <ComboBoxItem Content="{DynamicResource Str_Archive_LevelFast}" Tag="Fast" />
                                    <ComboBoxItem Content="{DynamicResource Str_Archive_LevelNormal}" Tag="Normal" />
                                    <ComboBoxItem Content="{DynamicResource Str_Archive_LevelMax}" Tag="Maximum" />
                                </ComboBox>
                                <TextBlock Margin="0,12,0,6" Style="{StaticResource FieldLabel}" Text="{DynamicResource Str_Archive_NameHeader}" />
                                <Border Style="{StaticResource InputBarStyle}">
                                    <TextBox x:Name="TxtName" MaxLength="100" Style="{StaticResource BareTextBox}" />
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SidebarGroupCardStyle}">
                            <StackPanel>
                                <ContentControl Content="{DynamicResource Str_Archive_SplitHeader}" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.ContentCut}" />
                                <CheckBox
                                    x:Name="ChkSplit"
                                    Margin="2,2,0,0"
                                    Checked="Option_Changed"
                                    Content="{DynamicResource Str_Archive_SplitCheck}"
                                    Foreground="{DynamicResource SidebarText}"
                                    ToolTip="{DynamicResource Str_Archive_SplitTip}"
                                    Unchecked="Option_Changed" />
                                <StackPanel x:Name="PanelSplitSize" Margin="0,8,0,0">
                                    <Border Style="{StaticResource InputBarStyle}">
                                        <TextBox x:Name="TxtSplit" LostFocus="Option_Changed" Style="{StaticResource BareTextBox}" />
                                    </Border>
                                    <controls:PresetChips
                                        x:Name="PresetSplit"
                                        Margin="0,6,0,0"
                                        Columns="3"
                                        Items="100 MB:100m;700 MB:700m;1 GB:1g;2 GB:2g;4 GB:4g;8 GB:8g"
                                        PresetChosen="Split_Chosen" />
                                </StackPanel>
                                <TextBlock Style="{StaticResource SidebarHint}" Text="{DynamicResource Str_Archive_SplitNote}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource SidebarGroupCardStyle}">
                            <StackPanel>
                                <ContentControl Content="{DynamicResource Str_Archive_PasswordHeader}" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.LockOutline}" />
                                <PasswordBox x:Name="PwdCreate" Margin="0,2,0,0" PasswordChanged="Option_PasswordChanged" />
                                <CheckBox
                                    x:Name="ChkHideNames"
                                    Margin="2,10,0,0"
                                    Checked="Option_Changed"
                                    Content="{DynamicResource Str_Archive_HideNames}"
                                    Foreground="{DynamicResource SidebarText}"
                                    IsChecked="True"
                                    Unchecked="Option_Changed" />
                                <TextBlock x:Name="TxtPasswordNote" Style="{StaticResource SidebarHint}" Text="{DynamicResource Str_Archive_PasswordCreateNote}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <controls:OutputFolderCard
                        ctl:Tour.Key="Str_Tour_Archive_Output"
                        ctl:Tour.Order="4"
                        x:Name="OutputCard"
                        AllowSameAsSource="True"
                        Header="{DynamicResource Str_Archive_ExtractTo}"
                        HeaderIcon="FolderOutline"
                        SameAsSource="True"
                        ToolName="Archive Manager" />

                    <Border Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl Content="{DynamicResource Str_Archive_GoodToKnow}" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.InformationOutline}" />
                            <TextBlock Margin="2,6,0,0" FontSize="10.5" Foreground="{DynamicResource SidebarTextMuted}" Text="{DynamicResource Str_Archive_GoodToKnowText}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </controls:ToolSidebar>

            <!--  ================= MAIN AREA =================  -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Run bar  -->
                <Border Grid.Row="0" Margin="0,0,0,14" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button
                            ctl:Tour.Key="Str_Tour_Archive_Run"
                            ctl:Tour.Order="5"
                            x:Name="BtnStart"
                            MinWidth="180"
                            VerticalAlignment="Center"
                            Click="BtnStart_Click"
                            Style="{StaticResource AccentPrimaryButtonStyle}">
                            <Grid HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon x:Name="IconStart" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" Kind="PackageUp" />
                                <TextBlock x:Name="TxtStart" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </Grid>
                        </Button>

                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <ProgressBar x:Name="Bar" Height="8" Maximum="100" />
                            <TextBlock x:Name="TxtProgress" Margin="0,6,0,0" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock x:Name="TxtPercent" Grid.Column="2" MinWidth="54" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentColor}" TextAlignment="Right" />
                    </Grid>
                </Border>

                <!--  Contents  -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ContentControl x:Name="HeaderContents" VerticalAlignment="Center" Content="{DynamicResource Str_Archive_Contents}" Style="{StaticResource CardHeader}" Tag="{x:Static materialDesign:PackIconKind.FormatListBulleted}" />

                            <WrapPanel x:Name="SummaryPanel" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                <Border Margin="0,2,6,2" Background="{DynamicResource StatusSuccessBg}" Style="{StaticResource IconStatusPillStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource StatusSuccessFg}" Kind="FileOutline" />
                                        <TextBlock x:Name="TxtSumFiles" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource StatusSuccessFg}" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="PillFolders" Margin="0,2,6,2" Background="{DynamicResource StatusInfoBg}" Style="{StaticResource IconStatusPillStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource StatusInfoFg}" Kind="FolderOutline" />
                                        <TextBlock x:Name="TxtSumFolders" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource StatusInfoFg}" />
                                    </StackPanel>
                                </Border>
                                <Border Margin="0,2,6,2" Background="{DynamicResource AccentColorSubtle}" Style="{StaticResource IconStatusPillStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentColor}" Kind="Database" />
                                        <TextBlock x:Name="TxtSumSize" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentColor}" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="PillParts" Margin="0,2,6,2" Background="{DynamicResource AccentColorSubtle}" Style="{StaticResource IconStatusPillStyle}" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentColor}" Kind="ContentCut" />
                                        <TextBlock x:Name="TxtSumParts" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentColor}" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="PillLocked" Margin="0,2,6,2" Background="{DynamicResource StatusWarningBg}" Style="{StaticResource IconStatusPillStyle}" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource StatusWarningFg}" Kind="LockOutline" />
                                        <TextBlock x:Name="TxtSumLocked" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource StatusWarningFg}" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                                <Button x:Name="BtnExtractSelected" Margin="0,0,6,0" Click="BtnExtractSelected_Click" IsEnabled="False" Style="{StaticResource ListToolButtonStyle}" ToolTip="{DynamicResource Str_Archive_ExtractSelectedTip}">
                                    <materialDesign:PackIcon Width="16" Height="16" Kind="ExportVariant" />
                                </Button>
                                <Button x:Name="BtnTest" Margin="0,0,6,0" Click="BtnTest_Click" IsEnabled="False" Style="{StaticResource ListToolButtonStyle}" ToolTip="{DynamicResource Str_Archive_TestTip}">
                                    <materialDesign:PackIcon Width="16" Height="16" Kind="ShieldCheckOutline" />
                                </Button>
                                <Button x:Name="BtnShowResult" Click="BtnShowResult_Click" IsEnabled="False" Style="{StaticResource ListToolButtonStyle}" ToolTip="{DynamicResource Str_Archive_ShowResultTip}">
                                    <materialDesign:PackIcon Width="16" Height="16" Kind="FolderOpenOutline" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Border x:Name="StatusBanner" Grid.Row="1" Margin="0,0,0,10" Padding="10,8" CornerRadius="8" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon x:Name="StatusIcon" Width="14" Height="14" Margin="0,1,8,0" VerticalAlignment="Top" Kind="AlertOutline" />
                                <TextBlock x:Name="TxtStatus" Grid.Column="1" FontSize="11.5" TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <Grid Grid.Row="2">
                            <DataGrid
                                ctl:Tour.Key="Str_Tour_Archive_Contents"
                                ctl:Tour.Order="6"
                                x:Name="GridEntries"
                                AutoGenerateColumns="False"
                                CanUserAddRows="False"
                                FontSize="12"
                                IsReadOnly="True"
                                MinRowHeight="40"
                                SelectionChanged="GridEntries_SelectionChanged"
                                SelectionMode="Extended"
                                VerticalScrollBarVisibility="Auto">
                                <DataGrid.Columns>
                                    <DataGridTemplateColumn Width="3*" MinWidth="180" CellTemplate="{StaticResource NameCellTemplate}" Header="{DynamicResource Str_Archive_ColName}" SortMemberPath="Path" />
                                    <DataGridTextColumn Width="100" Binding="{Binding SizeText, Mode=OneWay}" ElementStyle="{StaticResource EllipsisCellTextStyle}" Header="{DynamicResource Str_Archive_ColSize}" SortMemberPath="Size" />
                                    <DataGridTextColumn Width="100" Binding="{Binding PackedText, Mode=OneWay}" ElementStyle="{StaticResource EllipsisCellTextStyle}" Header="{DynamicResource Str_Archive_ColPacked}" SortMemberPath="Packed" />
                                    <DataGridTextColumn Width="150" Binding="{Binding ModifiedText, Mode=OneWay}" ElementStyle="{StaticResource EllipsisCellTextStyle}" Header="{DynamicResource Str_Archive_ColModified}" SortMemberPath="Modified" />
                                    <DataGridTemplateColumn Width="44" Header="">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate DataType="{x:Type models:ArchiveRow}">
                                                <materialDesign:PackIcon
                                                    Width="15"
                                                    Height="15"
                                                    HorizontalAlignment="Center"
                                                    VerticalAlignment="Center"
                                                    Foreground="{DynamicResource StatusWarningFg}"
                                                    Kind="LockOutline"
                                                    ToolTip="{DynamicResource Str_Archive_LockedRowTip}">
                                                    <materialDesign:PackIcon.Style>
                                                        <Style TargetType="materialDesign:PackIcon">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Encrypted}" Value="True">
                                                                    <Setter Property="Visibility" Value="Visible" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </materialDesign:PackIcon.Style>
                                                </materialDesign:PackIcon>
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>

                            <StackPanel x:Name="EmptyState" MaxWidth="360" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.ZipBoxOutline}" />
                                <TextBlock x:Name="TxtEmptyTitle" Margin="0,12,0,0" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                <TextBlock x:Name="TxtEmptyHint" Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextAlignment="Center" TextWrapping="Wrap" />
                            </StackPanel>
                        </Grid>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
