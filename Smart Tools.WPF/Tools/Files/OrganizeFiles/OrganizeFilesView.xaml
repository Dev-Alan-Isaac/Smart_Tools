<UserControl
    x:Class="Smart_Tools.WPF.Views.OrganizeFilesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:models="clr-namespace:Smart_Tools.WPF.Models"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    x:Name="Root"
    Loaded="Root_Loaded"
    SizeChanged="Root_SizeChanged">

    <!--
        Backend: Controllers/OrganizeManager.cs (folder names per rule, the
        plan, name clashes, settings, undo journal), OrganizeManager.Run.cs
        (scan, metadata, move/copy, undo), OrganizeManager.Media.cs
        (ffprobe), OrganizeManager.Images.cs (Magick.NET);
        Models/OrganizeFilesModel.cs. This file and the code-behind are UI only.
        The preview rebuilds itself whenever a setting changes.
    -->

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />

        <!--  One rule card in the Sort plan (main area)  -->
        <DataTemplate x:Key="StepTemplate" DataType="{x:Type models:OrganizeStepRow}">
            <Border
                Width="300" Margin="0,0,10,10"
                Padding="10"
                Background="{DynamicResource RowBg}"
                CornerRadius="8">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Border
                        Width="22"
                        Height="22"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Background="{DynamicResource AccentFill}"
                        CornerRadius="11">
                        <TextBlock
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="White"
                            Text="{Binding Number}" />
                    </Border>

                    <!--
                        Flat list (no GroupStyle): with grouping, the items
                        under the Video / Audio / Image headings couldn't be
                        picked with the app's ComboBox style. The group is a
                        small label on each item instead.
                    -->
                    <ComboBox
                        Grid.Column="1"
                        ItemsSource="{Binding CriterionChoices, ElementName=Root}"
                        SelectedValue="{Binding Criterion, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                        SelectedValuePath="Criterion"
                        ToolTip="{DynamicResource Str_OrganizeFiles_WhatThisLevelOf}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:OrganizeCriterionChoice}">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        x:Name="GroupLabel"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        FontSize="11"
                                        FontWeight="Bold"
                                        Foreground="{DynamicResource AccentColor}"
                                        Text="{Binding Group}" />
                                    <TextBlock VerticalAlignment="Center" Text="{Binding Label}" />
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding Group}" Value="General">
                                        <Setter TargetName="GroupLabel" Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>

                    <TextBlock
                        Grid.Row="1"
                        Grid.Column="1"
                        Margin="0,5,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource TextSecondary}"
                        Text="{Binding Hint}"
                        TextWrapping="Wrap"
                        Visibility="{Binding HasHint, Converter={StaticResource BoolToVisibility}}" />

                    <Grid
                        Grid.Row="2"
                        Grid.ColumnSpan="2"
                        Margin="0,8,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <CheckBox
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource SidebarText}"
                            IsChecked="{Binding GroupUnknownAsOther, Mode=TwoWay}"
                            ToolTip="{DynamicResource Str_OrganizeFiles_FilesThisRuleCan}">
                            <TextBlock
                                FontSize="11"
                                Text="{DynamicResource Str_OrganizeFiles_UnsortedIntoOther}"
                                TextWrapping="Wrap" />
                        </CheckBox>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button
                                Width="24"
                                Height="24"
                                Click="BtnStepUp_Click"
                                IsEnabled="{Binding CanMoveUp}"
                                Style="{StaticResource IconButtonStyle}"
                                Tag="{Binding}"
                                ToolTip="{DynamicResource Str_OrganizeFiles_MoveUpALevel}">
                                <materialDesign:PackIcon
                                    Width="14"
                                    Height="14"
                                    Kind="ChevronUp" />
                            </Button>
                            <Button
                                Width="24"
                                Height="24"
                                Margin="2,0"
                                Click="BtnStepDown_Click"
                                IsEnabled="{Binding CanMoveDown}"
                                Style="{StaticResource IconButtonStyle}"
                                Tag="{Binding}"
                                ToolTip="{DynamicResource Str_OrganizeFiles_MoveDownALevel}">
                                <materialDesign:PackIcon
                                    Width="14"
                                    Height="14"
                                    Kind="ChevronDown" />
                            </Button>
                            <Button
                                Width="24"
                                Height="24"
                                Click="BtnStepRemove_Click"
                                Style="{StaticResource IconButtonStyle}"
                                Tag="{Binding}"
                                ToolTip="{DynamicResource Str_Log_RemoveRuleTooltip}">
                                <materialDesign:PackIcon
                                    Width="13"
                                    Height="13"
                                    Kind="Close" />
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </DataTemplate>

        <!--  Grid: group header = destination folder  -->
        <DataTemplate x:Key="GroupHeaderTemplate">
            <Border
                Margin="0,8,0,2"
                Padding="10,6"
                Background="{DynamicResource RowBg}"
                CornerRadius="8">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon
                        Width="16"
                        Height="16"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource AccentColor}"
                        Kind="FolderOutline" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        Text="{Binding Name.Name}" />
                    <Border
                        Margin="8,0,0,0"
                        Padding="7,1"
                        VerticalAlignment="Center"
                        Background="{DynamicResource AccentColorSubtle}"
                        CornerRadius="8">
                        <TextBlock
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="{DynamicResource AccentColor}"
                            Text="{Binding ItemCount, StringFormat={}{0:N0}}" />
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!--  Grid: file kind icon  -->
        <DataTemplate x:Key="KindCellTemplate" DataType="{x:Type models:OrganizeFileItem}">
            <Border
                Width="30"
                Height="30"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource AccentColorSubtle}"
                CornerRadius="8">
                <materialDesign:PackIcon
                    x:Name="KindIcon"
                    Width="16"
                    Height="16"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{DynamicResource AccentColor}"
                    Kind="FileOutline" />
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="Video">
                    <Setter TargetName="KindIcon" Property="Kind" Value="Filmstrip" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Audio">
                    <Setter TargetName="KindIcon" Property="Kind" Value="MusicNote" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="Image">
                    <Setter TargetName="KindIcon" Property="Kind" Value="ImageOutline" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  Grid: name + where it is now (and the new name if it had to change)  -->
        <DataTemplate x:Key="NameCellTemplate" DataType="{x:Type models:OrganizeFileItem}">
            <StackPanel VerticalAlignment="Center" ToolTip="{Binding FullPath}">
                <TextBlock
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimary}"
                    Text="{Binding Name}"
                    TextTrimming="CharacterEllipsis" />
                <Grid Margin="0,1,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        Grid.Column="0"
                        x:Name="FromText"
                        FontSize="11"
                        Foreground="{DynamicResource TextSecondary}"
                        Text="{Binding SourceFolderDisplay, StringFormat=from {0}}"
                        TextTrimming="CharacterEllipsis" />
                    <TextBlock
                        Grid.Column="1"
                        x:Name="RenamedText"
                        Margin="8,0,0,0"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource StatusWarningFg}"
                        Text="{Binding DestinationName, StringFormat=saved as {0}}"
                        TextTrimming="CharacterEllipsis"
                        Visibility="Collapsed" />
                </Grid>
            </StackPanel>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding SourceFolderDisplay}" Value="">
                    <Setter TargetName="FromText" Property="Text" Value="from the top level" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsRenamed}" Value="True">
                    <Setter TargetName="RenamedText" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  Grid: status chip. Replaces the hard-coded light brushes that didn't work in the dark theme.  -->
        <DataTemplate x:Key="StatusCellTemplate" DataType="{x:Type models:OrganizeFileItem}">
            <Border
                x:Name="Chip"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="{DynamicResource StatusInfoBg}"
                Style="{StaticResource IconStatusPillStyle}"
                ToolTip="{Binding Message}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon
                        x:Name="ChipIcon"
                        Width="12"
                        Height="12"
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource StatusInfoFg}"
                        Kind="ArrowRightBold" />
                    <TextBlock
                        x:Name="ChipText"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource StatusInfoFg}"
                        Text="{Binding StatusText}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="InPlace">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource RowBg}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="CheckAll" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource TextSecondary}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource TextSecondary}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Moved">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusSuccessBg}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="CheckCircleOutline" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource StatusSuccessFg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusSuccessFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Copied">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusSuccessBg}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="ContentCopy" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource StatusSuccessFg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusSuccessFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Duplicate">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource RowBg}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="ContentDuplicate" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource TextSecondary}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource TextSecondary}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusErrorBg}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="AlertCircleOutline" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusWarningBg}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="CloseCircleOutline" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  The folder row in the input card (same look as Rename's list; this tool keeps one folder)  -->
        <DataTemplate x:Key="QueueItemTemplate" DataType="{x:Type models:FolderListEntry}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="26"
                    Height="26"
                    Margin="0,0,8,0"
                    Background="{DynamicResource AccentColorSubtle}"
                    CornerRadius="7">
                    <materialDesign:PackIcon
                        Width="14"
                        Height="14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource AccentColor}"
                        Kind="Folder" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource SidebarText}"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding FullPath}" />
                    <TextBlock
                        Margin="0,1,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource SidebarTextMuted}"
                        Text="{Binding FullPath}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding FullPath}" />
                </StackPanel>
                <Button
                    Grid.Column="2"
                    Width="24"
                    Height="24"
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    Click="BtnRemoveSingleFolder_Click"
                    Style="{StaticResource IconButtonStyle}"
                    Tag="{Binding}"
                    ToolTip="{DynamicResource Str_Rename_RemoveFolderTooltip}">
                    <materialDesign:PackIcon
                        Width="13"
                        Height="13"
                        Kind="Close" />
                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">

        <!--  No page header: MainWindow's header card shows the tool's icon and name.  -->

        <Grid Margin="16,8,16,16">

            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OptionsColumn" Width="280" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= OPTIONS SIDEBAR =================  -->

            <Border Grid.Column="0" Style="{StaticResource SidebarPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Button
                            x:Name="BtnCollapseOptions"
                            MinHeight="45"
                            HorizontalContentAlignment="Left"
                            Click="BtnCollapseOptions_Click"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Foreground="{DynamicResource SidebarText}"
                            ToolTip="{DynamicResource Str_Common_SidebarToggleTooltip}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="OverridesDefaultStyle" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Margin="16,0,0,0" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Kind="TuneVariant" />
                                <TextBlock
                                    x:Name="TxtOptionsHeaderLabel"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{DynamicResource Str_Common_OptionsLabel}" />
                            </StackPanel>
                        </Button>
                        <Separator
                            x:Name="SepHeader"
                            Margin="16,4"
                            Style="{StaticResource SidebarSeparatorStyle}" />
                    </StackPanel>

                    <ScrollViewer
                        x:Name="OptionsScrollViewer"
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16,4,16,16">

                            <!--  ============ FOLDERS ============  -->
                            <controls:InputFolderCard
                                x:Name="InputCard"
                                ctl:Tour.Key="Str_Tour_OrganizeFiles_Input" ctl:Tour.Order="1"
                                ClearRequested="InputCard_ClearRequested"
                                Header="{DynamicResource Str_Organize_SourceFolder}"
                                HeaderIcon="FolderOutline"
                                IncludeSubfolders="False"
                                IncludeSubfoldersChanged="InputCard_IncludeSubfoldersChanged"
                                ItemTemplate="{StaticResource QueueItemTemplate}"
                                Mode="Folders"
                                PathsAdded="InputCard_PathsAdded" />

                            <!--  ============ DESTINATION ============  -->
                            <Border ctl:Tour.Key="Str_Tour_OrganizeFiles_Destination" ctl:Tour.Order="2" Style="{StaticResource SidebarGroupCardStyle}">
                                    <StackPanel>
                                        <ContentControl
                                            Content="{DynamicResource Str_OrganizeFiles_PutOrganizedFilesIn}"
                                            Style="{StaticResource SidebarGroupHeader}"
                                            Tag="{x:Static materialDesign:PackIconKind.FolderArrowRightOutline}" />
                                        <UniformGrid Columns="2" ToolTip="{DynamicResource Str_Organize_UseSourceAsDestinationTooltip}">
                                            <RadioButton
                                                x:Name="RadioSameFolder"
                                                Margin="0,0,2,0"
                                                Click="RadioDestination_Click"
                                                Content="{DynamicResource Str_OrganizeFiles_SameFolder}"
                                                GroupName="Destination"
                                                IsChecked="True"
                                                Style="{StaticResource ModeToggleButtonStyle}" />
                                            <RadioButton
                                                x:Name="RadioOtherFolder"
                                                Margin="2,0,0,0"
                                                Click="RadioDestination_Click"
                                                Content="{DynamicResource Str_OrganizeFiles_AnotherFolder}"
                                                GroupName="Destination"
                                                Style="{StaticResource ModeToggleButtonStyle}" />
                                        </UniformGrid>

                                        <Grid
                                            x:Name="PanelDestination"
                                            Margin="0,8,0,0"
                                            Visibility="Collapsed">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                MinHeight="34"
                                                Padding="10,0"
                                                Background="{DynamicResource SidebarInputBg}"
                                                BorderBrush="{DynamicResource SidebarInputBorder}"
                                                BorderThickness="1"
                                                CornerRadius="8"
                                                ToolTip="{DynamicResource Str_Organize_DestinationFolderTooltip}">
                                                <TextBlock
                                                    x:Name="TxtDestinationFolder"
                                                    VerticalAlignment="Center"
                                                    FontSize="11.5"
                                                    Foreground="{DynamicResource SidebarText}"
                                                    Text="{DynamicResource Str_OrganizeFiles_ChooseAFolder}"
                                                    TextTrimming="CharacterEllipsis" />
                                            </Border>
                                            <Button Padding="0"
                                                x:Name="BtnBrowseDestination"
                                                Grid.Column="1"
                                                Width="34"
                                                Height="34"
                                                Margin="6,0,0,0"
                                                Click="BtnBrowseDestination_Click"
                                                Style="{StaticResource NeutralIconButtonStyle}"
                                                ToolTip="{DynamicResource Str_Organize_BrowseDestinationTooltip}">
                                                <materialDesign:PackIcon
                                                    Width="16"
                                                    Height="16"
                                                    Kind="FolderOpenOutline" />
                                            </Button>
                                        </Grid>

                                        <CheckBox
                                            x:Name="ChkSkipHidden"
                                            Margin="0,8,0,0"
                                            Checked="ScanOption_Changed"
                                            Content="{DynamicResource Str_OrganizeFiles_LeaveHiddenAndSystem}"
                                            Foreground="{DynamicResource SidebarText}"
                                            IsChecked="True"
                                            ToolTip="{DynamicResource Str_OrganizeFiles_DonTMoveDesktop}"
                                            Unchecked="ScanOption_Changed" />
                                    </StackPanel>
                            </Border>

                            <!--  ============ HOW ============  -->
                            <Border ctl:Tour.Key="Str_Tour_OrganizeFiles_Steps" ctl:Tour.Order="3" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Organize_LayoutHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.FileTreeOutline}" />

                                    <!--  Layout choice: one full-width row each (three thirds of the sidebar clipped the labels)  -->
                                    <StackPanel>
                                        <RadioButton
                                            x:Name="RadioLayoutRules"
                                            Margin="0,0,0,4"
                                            Click="RadioLayout_Click"
                                            GroupName="Layout" IsChecked="True"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="Rules"
                                            ToolTip="{DynamicResource Str_OrganizeFiles_SortIntoFoldersBy}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="17"
                                                    Height="17"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Kind="FormatListNumbered" />
                                                <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_OrganizeFiles_ByRules}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="RadioLayoutFlatten"
                                            Margin="0,0,0,4"
                                            Click="RadioLayout_Click"
                                            GroupName="Layout"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="Flatten"
                                            ToolTip="{DynamicResource Str_Organize_FlattenTooltip}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="17"
                                                    Height="17"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Kind="ArrowCollapseVertical" />
                                                <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_OrganizeFiles_Flatten}" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton
                                            x:Name="RadioLayoutKeep"
                                            Margin="0,0,0,0"
                                            Click="RadioLayout_Click"
                                            GroupName="Layout"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="KeepStructure"
                                            ToolTip="{DynamicResource Str_Organize_PreserveTooltip}">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="17"
                                                    Height="17"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Kind="FolderMultipleOutline" />
                                                <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_OrganizeFiles_KeepFolders}" />
                                            </StackPanel>
                                        </RadioButton>
                                    </StackPanel>

                                    <TextBlock
                                        x:Name="TxtLayoutHint"
                                        Margin="0,10,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource SidebarTextMuted}"
                                        TextWrapping="Wrap" />

                                    <!--  Example Banner  -->
                                    <Border
                                        Margin="0,8,0,0"
                                        Padding="10,7"
                                        Background="{DynamicResource AccentColorSubtle}"
                                        CornerRadius="8"
                                        ToolTip="{DynamicResource Str_OrganizeFiles_WhereAPhotoCalled}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon
                                                Width="14"
                                                Height="14"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource AccentColor}"
                                                Kind="SubdirectoryArrowRight" />
                                            <TextBlock
                                                x:Name="TxtExample"
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource AccentColor}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Border>

                                </StackPanel>
                            </Border>

                            <!--  ============ OPTIONS ============  -->
                            <Border Margin="0,0,0,4" ctl:Tour.Key="Str_Tour_OrganizeFiles_Options" ctl:Tour.Order="4" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Common_OptionsHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.Tune}" />
                                    <UniformGrid Columns="2" ToolTip="{DynamicResource Str_Organize_MoveFilesTooltip}">
                                        <RadioButton
                                            x:Name="RadioMove"
                                            Margin="0,0,2,0"
                                            Click="RadioMove_Click"
                                            Content="{DynamicResource Str_OrganizeFiles_Move}"
                                            GroupName="MoveCopy"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleButtonStyle}" />
                                        <RadioButton
                                            x:Name="RadioCopy"
                                            Margin="2,0,0,0"
                                            Click="RadioMove_Click"
                                            Content="{DynamicResource Str_Common_Copy}"
                                            GroupName="MoveCopy"
                                            Style="{StaticResource ModeToggleButtonStyle}" />
                                    </UniformGrid>
                                    <CheckBox
                                        x:Name="ChkRemoveEmptyFolders"
                                        Margin="0,10,0,0"
                                        Checked="Option_Changed"
                                        Content="{DynamicResource Str_Organize_RemoveEmptyFolders}"
                                        Foreground="{DynamicResource SidebarText}"
                                        IsChecked="True"
                                        ToolTip="{DynamicResource Str_Organize_RemoveEmptyFoldersTooltip}"
                                        Unchecked="Option_Changed" />
                                    <Border
                                        Margin="0,10,0,0"
                                        Padding="10,8"
                                        Background="{DynamicResource StatusInfoBg}"
                                        CornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon
                                                Width="14"
                                                Height="14"
                                                Margin="0,1,8,0"
                                                VerticalAlignment="Top"
                                                Foreground="{DynamicResource StatusInfoFg}"
                                                Kind="Undo" />
                                            <TextBlock
                                                Grid.Column="1"
                                                FontSize="11"
                                                Foreground="{DynamicResource StatusInfoFg}"
                                                Text="{DynamicResource Str_OrganizeFiles_TheLastRunCan}"
                                                TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!--  Kept (empty) for existing code that references it  -->
                    <StackPanel x:Name="OptionsBottomPanel" Grid.Row="2" />
                </Grid>
            </Border>

            <!--  ================= MAIN AREA =================  -->

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Run bar  -->
                <Border
                    Grid.Row="0"
                    Margin="0,0,0,14"
                    Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button
                            x:Name="BtnOrganizeFiles"
                            ctl:Tour.Key="Str_Tour_OrganizeFiles_Run" ctl:Tour.Order="5"
                            MinWidth="180"
                            VerticalAlignment="Center"
                            Click="BtnOrganizeFiles_Click"
                            Style="{StaticResource AccentPrimaryButtonStyle}"
                            ToolTip="{DynamicResource Str_OrganizeFiles_MoveOrCopyEvery}">
                            <Grid HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon
                                    Grid.Column="0"
                                    x:Name="IconOrganize"
                                    Width="18"
                                    Height="18"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Kind="FolderMoveOutline" />
                                <TextBlock
                                    Grid.Column="1"
                                    x:Name="TxtOrganizeLabel"
                                    VerticalAlignment="Center"
                                    Text="{DynamicResource Str_Organize_MoveFiles}" TextWrapping="Wrap" />
                            </Grid>
                        </Button>

                        <Button Padding="0"
                            x:Name="BtnUndoOrganize"
                            Grid.Column="1"
                            Width="36"
                            Height="36"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Click="BtnUndoOrganize_Click"
                            IsEnabled="False"
                            Style="{StaticResource NeutralIconButtonStyle}"
                            ToolTip="{DynamicResource Str_Organize_UndoTooltip}">
                            <materialDesign:PackIcon
                                Width="17"
                                Height="17"
                                Kind="Undo" />
                        </Button>

                        <Button Padding="0"
                            x:Name="BtnRefresh"
                            Grid.Column="2"
                            Width="36"
                            Height="36"
                            Margin="6,0,16,0"
                            VerticalAlignment="Center"
                            Click="BtnRefresh_Click"
                            Style="{StaticResource ListToolButtonStyle}"
                            ToolTip="{DynamicResource Str_OrganizeFiles_ReadTheFolderAgain}">
                            <materialDesign:PackIcon
                                Width="17"
                                Height="17"
                                Kind="Refresh" />
                        </Button>

                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                            <ProgressBar
                                x:Name="ProgressOrganize"
                                Height="8"
                                Maximum="100"
                                ToolTip="{DynamicResource Str_Organize_ProgressTooltip}" />
                            <TextBlock
                                x:Name="TxtProgress"
                                Margin="0,6,0,0"
                                FontSize="11.5"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="{DynamicResource Str_OrganizeFiles_ChooseAFolderTo}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock
                            x:Name="TxtProgressPercent"
                            Grid.Column="4"
                            MinWidth="54"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="{DynamicResource AccentColor}"
                            TextAlignment="Right" />
                    </Grid>
                </Border>

                <!--
                    Sort plan: the rules, side by side across the page (they were stacked in the 280 px sidebar, too narrow for a
                    drop-down plus its options). Shown only for "By rules"; code toggles this Border through PanelSteps.
                -->
                <Border
                    x:Name="PanelSteps"
                    Grid.Row="1"
                    Margin="0,0,0,14"
                    Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <DockPanel Margin="0,0,0,10">
                            <TextBlock
                                x:Name="TxtStepsHint"
                                VerticalAlignment="Center"
                                DockPanel.Dock="Right"
                                FontSize="11.5"
                                Foreground="{DynamicResource TextSecondary}" />
                            <ContentControl
                                VerticalAlignment="Center"
                                Content="{DynamicResource Str_Organize_StepsHeader}"
                                Style="{StaticResource CardHeader}"
                                Tag="{x:Static materialDesign:PackIconKind.FileTreeOutline}" />
                        </DockPanel>

                        <ItemsControl
                            x:Name="StepsList"
                            Focusable="False"
                            ItemTemplate="{StaticResource StepTemplate}"
                            ToolTip="{DynamicResource Str_Organize_StepsListTooltip}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>

                        <DockPanel Margin="0,2,0,0">
                            <Button
                                x:Name="BtnAddStep"
                                MinHeight="36"
                                Margin="0,0,16,0"
                                Click="BtnAddStep_Click"
                                Style="{StaticResource NeutralIconButtonStyle}"
                                ToolTip="{DynamicResource Str_Organize_AddStepTooltip}">
                                <TextBlock Margin="6,0" VerticalAlignment="Center" Text="{DynamicResource Str_Organize_AddStep}" />
                            </Button>
                            <CheckBox
                                x:Name="ChkEmoji"
                                VerticalAlignment="Center"
                                Checked="PlanOption_Changed"
                                Content="{DynamicResource Str_OrganizeFiles_EmojiOnCategoryFolders}"
                                IsChecked="True"
                                ToolTip="{DynamicResource Str_OrganizeFiles_NameCategoryFoldersLike}"
                                Unchecked="PlanOption_Changed" />
                        </DockPanel>
                    </StackPanel>
                </Border>

                <!--  Preview  -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ContentControl
                                VerticalAlignment="Center"
                                Content="{DynamicResource Str_Organize_ResultsTitle}"
                                Style="{StaticResource CardHeader}"
                                Tag="{x:Static materialDesign:PackIconKind.FileTreeOutline}" />

                            <WrapPanel
                                x:Name="SummaryPanel"
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                                <Border
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource StatusInfoBg}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    ToolTip="{DynamicResource Str_OrganizeFiles_FilesThatWillBe}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource StatusInfoFg}"
                                            Kind="FileMultipleOutline" />
                                        <TextBlock
                                            x:Name="TxtSummaryFiles"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource StatusInfoFg}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource AccentColorSubtle}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    ToolTip="{DynamicResource Str_OrganizeFiles_FoldersTheyLlGo}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource AccentColor}"
                                            Kind="FolderMultipleOutline" />
                                        <TextBlock
                                            x:Name="TxtSummaryFolders"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource AccentColor}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    x:Name="PillInPlace"
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource RowBg}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    ToolTip="{DynamicResource Str_OrganizeFiles_AlreadyInTheRight}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource TextSecondary}"
                                            Kind="CheckAll" />
                                        <TextBlock
                                            x:Name="TxtSummaryInPlace"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextSecondary}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    x:Name="PillRenamed"
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource StatusWarningBg}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    ToolTip="{DynamicResource Str_OrganizeFiles_TwoFilesWouldGet}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource StatusWarningFg}"
                                            Kind="RenameOutline" />
                                        <TextBlock
                                            x:Name="TxtSummaryRenamed"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource StatusWarningFg}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    x:Name="PillDone"
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource StatusSuccessBg}"
                                    Style="{StaticResource IconStatusPillStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource StatusSuccessFg}"
                                            Kind="CheckCircleOutline" />
                                        <TextBlock
                                            x:Name="TxtSummaryDone"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource StatusSuccessFg}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    x:Name="PillFailed"
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource StatusErrorBg}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    ToolTip="{DynamicResource Str_FileConverter_HoverAFailedRow}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource StatusErrorFg}"
                                            Kind="AlertCircleOutline" />
                                        <TextBlock
                                            x:Name="TxtSummaryFailed"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource StatusErrorFg}" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <StackPanel
                                x:Name="ActionsPanel"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Button
                                    x:Name="BtnCollapseFolders"
                                    Margin="0,0,6,0"
                                    Click="BtnCollapseFolders_Click"
                                    Style="{StaticResource ListToolButtonStyle}"
                                    ToolTip="{DynamicResource Str_Shortcut_GroupsCollapseAll}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="UnfoldLessHorizontal" />
                                </Button>
                                <Button
                                    x:Name="BtnExpandFolders"
                                    Margin="0,0,6,0"
                                    Click="BtnExpandFolders_Click"
                                    Style="{StaticResource ListToolButtonStyle}"
                                    ToolTip="{DynamicResource Str_Shortcut_GroupsExpandAll}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="UnfoldMoreHorizontal" />
                                </Button>
                                <Button
                                    x:Name="BtnOpenDestination"
                                    Margin="0,0,6,0"
                                    Click="BtnOpenDestination_Click"
                                    Style="{StaticResource ListToolButtonStyle}"
                                    ToolTip="{DynamicResource Str_OrganizeFiles_OpenTheDestinationFolder}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="FolderOpenOutline" />
                                </Button>
                                <Button
                                    x:Name="BtnResetOrganize"
                                    Click="BtnResetOrganize_Click"
                                    Style="{StaticResource ListToolDangerButtonStyle}"
                                    ToolTip="{DynamicResource Str_Organize_ClearTooltip}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="DeleteSweepOutline" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Border
                            x:Name="FfprobeWarning"
                            Grid.Row="1"
                            Margin="0,0,0,10"
                            Padding="10,8"
                            Background="{DynamicResource StatusWarningBg}"
                            CornerRadius="8"
                            Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon
                                    Width="14"
                                    Height="14"
                                    Margin="0,1,8,0"
                                    VerticalAlignment="Top"
                                    Foreground="{DynamicResource StatusWarningFg}"
                                    Kind="AlertOutline" />
                                <TextBlock
                                    x:Name="TxtWarning"
                                    Grid.Column="1"
                                    FontSize="11.5"
                                    Foreground="{DynamicResource StatusWarningFg}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <DataGrid
                            x:Name="DataGridPreview"
                            ctl:Tour.Key="Str_Tour_OrganizeFiles_Preview" ctl:Tour.Order="6"
                            Grid.Row="2"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            CanUserSortColumns="False"
                            FontSize="12"
                            IsReadOnly="True"
                            MouseDoubleClick="DataGridPreview_MouseDoubleClick"
                            MinRowHeight="46"
                            SelectionMode="Extended"
                            ToolTip="{DynamicResource Str_Organize_GridTooltip}"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                            VirtualizingPanel.ScrollUnit="Pixel"
                            VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.GroupStyle>
                                <GroupStyle ContainerStyle="{StaticResource CollapsibleGroupItemStyle}" HeaderTemplate="{StaticResource GroupHeaderTemplate}" />
                            </DataGrid.GroupStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn
                                    Width="46"
                                    CellStyle="{StaticResource CompactCellStyle}"
                                    CellTemplate="{StaticResource KindCellTemplate}" />
                                <DataGridTemplateColumn
                                    Width="3*"
                                    MinWidth="90"
                                    CellTemplate="{StaticResource NameCellTemplate}"
                                    Header="{DynamicResource Str_Common_ColHeaderName}" />
                                <DataGridTextColumn
                                    ElementStyle="{StaticResource EllipsisCellTextStyle}"
                                    Width="80"
                                    Binding="{Binding Size}"
                                    Header="{DynamicResource Str_Common_ColHeaderSize}" />
                                <DataGridTextColumn
                                    ElementStyle="{StaticResource EllipsisCellTextStyle}"
                                    x:Name="ColModified"
                                    Width="130"
                                    Binding="{Binding ModifiedText}"
                                    Header="{DynamicResource Str_Organize_ColHeaderModified}" />
                                <DataGridTemplateColumn
                                    Width="130"
                                    CellTemplate="{StaticResource StatusCellTemplate}"
                                    Header="{DynamicResource Str_Common_ColHeaderStatus}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <controls:EmptyStateCard
                            x:Name="EmptyStatePanel"
                            Grid.Row="2"
                            Description="{DynamicResource Str_OrganizeFiles_ChooseAFolderOn}"
                            Icon="FileTreeOutline"
                            IsHitTestVisible="False" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
