<UserControl
    x:Class="Smart_Tools.WPF.Views.RenameFilesView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:models="clr-namespace:Smart_Tools.WPF.Models"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    x:Name="Root"
    Loaded="Root_Loaded"
    SizeChanged="Root_SizeChanged">

    <!--
        Backend: Controllers/RenameManager.cs (new names per rule, safe
        Windows names, clashes, the plan, settings, undo journal) and
        RenameManager.Run.cs (reading folders, renaming - swaps and chains
        included - and undo); Models/RenameFilesModel.cs. This file and the
        code-behind are UI only. The preview rebuilds itself when a setting
        changes, and Rename always runs the plan for the current settings.
    -->

    <UserControl.Resources>

        <!--  Method list: icon + name. Read by Tag (the enum name), never by position.  -->
        <Style x:Key="MethodItemText" TargetType="TextBlock">
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>

        <!--  Grid: group header = folder  -->
        <DataTemplate x:Key="GroupHeaderTemplate">
            <Border
                Margin="0,8,0,2"
                Padding="10,6"
                Background="{DynamicResource RowBg}"
                CornerRadius="8">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon
                        Width="16"
                        Height="16"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource AccentColor}"
                        Kind="FolderOutline" />
                    <TextBlock
                        MaxWidth="700"
                        VerticalAlignment="Center"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding Name}" />
                    <Border
                        Margin="8,0,0,0"
                        Padding="7,1"
                        VerticalAlignment="Center"
                        Background="{DynamicResource AccentColorSubtle}"
                        CornerRadius="8">
                        <TextBlock
                            FontSize="11"
                            FontWeight="Bold"
                            Foreground="{DynamicResource AccentColor}"
                            Text="{Binding ItemCount, StringFormat={}{0:N0}}" />
                    </Border>
                </StackPanel>
            </Border>
        </DataTemplate>

        <!--  Grid: current name  -->
        <DataTemplate x:Key="OriginalCellTemplate" DataType="{x:Type models:RenamePreviewItem}">
            <TextBlock
                x:Name="Original"
                VerticalAlignment="Center"
                Foreground="{DynamicResource TextPrimary}"
                Text="{Binding OriginalName}"
                TextTrimming="CharacterEllipsis"
                ToolTip="{Binding FullPath}" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsChanged}" Value="True">
                    <Setter TargetName="Original" Property="Foreground" Value="{DynamicResource TextSecondary}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  Grid: arrow between the names  -->
        <DataTemplate x:Key="ArrowCellTemplate" DataType="{x:Type models:RenamePreviewItem}">
            <materialDesign:PackIcon
                x:Name="Arrow"
                Width="15"
                Height="15"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{DynamicResource AccentColor}"
                Kind="ArrowRight" />
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsChanged}" Value="False">
                    <Setter TargetName="Arrow" Property="Foreground" Value="{DynamicResource TextSecondary}" />
                    <Setter TargetName="Arrow" Property="Opacity" Value="0.4" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  Grid: new name, with a " (2)" note when the name had to change to avoid a clash  -->
        <DataTemplate x:Key="NewNameCellTemplate" DataType="{x:Type models:RenamePreviewItem}">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock
                    Grid.Column="0"
                    x:Name="NewText"
                    VerticalAlignment="Center"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource AccentColor}"
                    Text="{Binding NewName}"
                    TextTrimming="CharacterEllipsis"
                    ToolTip="{Binding Message}" />
                <Border
                    Grid.Column="1"
                    x:Name="AdjustedPill"
                    Margin="8,0,0,0"
                    Padding="6,1"
                    VerticalAlignment="Center"
                    Background="{DynamicResource StatusWarningBg}"
                    CornerRadius="8"
                    ToolTip="{Binding Message}"
                    Visibility="Collapsed">
                    <StackPanel Orientation="Horizontal">
                        <materialDesign:PackIcon
                            Width="11"
                            Height="11"
                            Margin="0,0,3,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource StatusWarningFg}"
                            Kind="RenameOutline" />
                        <TextBlock
                            FontSize="10"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource StatusWarningFg}"
                            Text="{DynamicResource Str_RenameFiles_NameTaken}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                </Border>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsChanged}" Value="False">
                    <Setter TargetName="NewText" Property="Foreground" Value="{DynamicResource TextSecondary}" />
                    <Setter TargetName="NewText" Property="FontWeight" Value="Normal" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsAdjusted}" Value="True">
                    <Setter TargetName="AdjustedPill" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Invalid">
                    <Setter TargetName="NewText" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  Grid: status chip. The reason is in the tooltip.  -->
        <DataTemplate x:Key="StatusCellTemplate" DataType="{x:Type models:RenamePreviewItem}">
            <Border
                x:Name="Chip"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                Background="{DynamicResource StatusInfoBg}"
                Style="{StaticResource IconStatusPillStyle}"
                ToolTip="{Binding Message}">
                <StackPanel Orientation="Horizontal">
                    <materialDesign:PackIcon
                        x:Name="ChipIcon"
                        Width="12"
                        Height="12"
                        Margin="0,0,4,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource StatusInfoFg}"
                        Kind="ArrowRightBold" />
                    <TextBlock
                        x:Name="ChipText"
                        FontSize="11"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource StatusInfoFg}"
                        Text="{Binding StatusText}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="NoChange">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource RowBg}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="Minus" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource TextSecondary}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource TextSecondary}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Invalid">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusWarningBg}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="AlertOutline" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Renamed">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusSuccessBg}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="CheckCircleOutline" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource StatusSuccessFg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusSuccessFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusErrorBg}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="AlertCircleOutline" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Cancelled">
                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource StatusWarningBg}" />
                    <Setter TargetName="ChipIcon" Property="Kind" Value="CloseCircleOutline" />
                    <Setter TargetName="ChipIcon" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>


        <!--  Input card: one queued item  -->
        <DataTemplate x:Key="QueueItemTemplate" DataType="{x:Type models:FolderListEntry}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="26"
                    Height="26"
                    Margin="0,0,8,0"
                    Background="{DynamicResource AccentColorSubtle}"
                    CornerRadius="7">
                    <materialDesign:PackIcon
                        Width="14"
                        Height="14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource AccentColor}"
                        Kind="Folder" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource SidebarText}"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding FullPath}" />
                    <TextBlock
                        Margin="0,1,0,0"
                        FontSize="11"
                        Foreground="{DynamicResource SidebarTextMuted}"
                        Text="{Binding FullPath}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding FullPath}" />
                </StackPanel>
                <Button
                    Grid.Column="2"
                    Width="24"
                    Height="24"
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    Click="BtnRemoveSingleFolder_Click"
                    Style="{StaticResource IconButtonStyle}"
                    Tag="{Binding}"
                    ToolTip="{DynamicResource Str_Rename_RemoveFolderTooltip}">
                    <materialDesign:PackIcon
                        Width="13"
                        Height="13"
                        Kind="Close" />
                </Button>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">

        <!--  No page header: MainWindow's header card shows the tool's icon and name.  -->

        <Grid Margin="16,8,16,16">

            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OptionsColumn" Width="280" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= OPTIONS SIDEBAR =================  -->

            <Border Grid.Column="0" Style="{StaticResource SidebarPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Button
                            x:Name="BtnCollapseOptions"
                            MinHeight="45"
                            HorizontalContentAlignment="Left"
                            Click="BtnCollapseOptions_Click"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Foreground="{DynamicResource SidebarText}"
                            ToolTip="{DynamicResource Str_Common_SidebarToggleTooltip}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="OverridesDefaultStyle" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Margin="16,0,0,0" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Kind="TuneVariant" />
                                <TextBlock
                                    x:Name="TxtOptionsHeaderLabel"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{DynamicResource Str_Common_OptionsLabel}" />
                            </StackPanel>
                        </Button>
                        <Separator
                            x:Name="SepHeader"
                            Margin="16,4"
                            Style="{StaticResource SidebarSeparatorStyle}" />
                    </StackPanel>

                    <ScrollViewer
                        x:Name="OptionsScrollViewer"
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16,4,16,16">

                            <!--  ============ FOLDERS ============  -->
                            <controls:InputFolderCard
                                x:Name="InputCard"
                                ctl:Tour.Key="Str_Tour_RenameFiles_Input" ctl:Tour.Order="1"
                                ClearRequested="InputCard_ClearRequested"
                                Header="{DynamicResource Str_Rename_SourceFolderHeader}"
                                HeaderIcon="FolderMultipleOutline"
                                IncludeSubfoldersChanged="InputCard_IncludeSubfoldersChanged"
                                ItemTemplate="{StaticResource QueueItemTemplate}"
                                Mode="Folders"
                                PathsAdded="InputCard_PathsAdded" />

                            <!--  ============ SCAN OPTIONS ============  -->
                            <Border Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Common_OptionsLabel}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.Tune}" />
                                    <CheckBox
                                        x:Name="ChkSkipHidden"
                                        Checked="ScanOption_Changed"
                                        Content="{DynamicResource Str_OrganizeFiles_LeaveHiddenAndSystem}"
                                        Foreground="{DynamicResource SidebarText}"
                                        IsChecked="True"
                                        ToolTip="{DynamicResource Str_RenameFiles_DonTRenameDesktop}"
                                        Unchecked="ScanOption_Changed" />
                                </StackPanel>
                            </Border>


                            <!--  ============ METHOD ============  -->
                            <Border ctl:Tour.Key="Str_Tour_RenameFiles_Method" ctl:Tour.Order="2" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Rename_MethodHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.RenameOutline}" />

                                    <ComboBox
                                        x:Name="CmbRenameMethod"
                                        SelectedIndex="0"
                                        SelectionChanged="CmbRenameMethod_SelectionChanged"
                                        ToolTip="{DynamicResource Str_Rename_MethodTooltip}">
                                        <ComboBoxItem Tag="FindReplace">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="15"
                                                    Height="15"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Kind="FindReplace" />
                                                <TextBlock Style="{StaticResource MethodItemText}" Text="{DynamicResource Str_RenameFiles_FindAmpReplace}" />
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="PrefixSuffix">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="15"
                                                    Height="15"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Kind="FormatTextbox" />
                                                <TextBlock Style="{StaticResource MethodItemText}" Text="{DynamicResource Str_RenameFiles_AddPrefixSuffix}" />
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="NumberSequence">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="15"
                                                    Height="15"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Kind="Counter" />
                                                <TextBlock Style="{StaticResource MethodItemText}" Text="{DynamicResource Str_RenameFiles_NumberFiles}" />
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="ChangeCase">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="15"
                                                    Height="15"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Kind="FormatLetterCase" />
                                                <TextBlock Style="{StaticResource MethodItemText}" Text="{DynamicResource Str_RenameFiles_ChangeCase}" />
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="TrimStrip">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="15"
                                                    Height="15"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Kind="ContentCut" />
                                                <TextBlock Style="{StaticResource MethodItemText}" Text="{DynamicResource Str_RenameFiles_TrimCharacters}" />
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="RegexReplace">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="15"
                                                    Height="15"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Kind="Regex" />
                                                <TextBlock Style="{StaticResource MethodItemText}" Text="{DynamicResource Str_RenameFiles_PatternRegex}" />
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="RemoveCharacters">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="15"
                                                    Height="15"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Kind="EraserVariant" />
                                                <TextBlock Style="{StaticResource MethodItemText}" Text="{DynamicResource Str_RenameFiles_RemoveCharacters}" />
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="CleanSuffixes">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="15"
                                                    Height="15"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Kind="ContentDuplicate" />
                                                <TextBlock Style="{StaticResource MethodItemText}" Text="{DynamicResource Str_RenameFiles_CleanSuffixes}" />
                                            </StackPanel>
                                        </ComboBoxItem>
                                        <ComboBoxItem Tag="ReplaceName">
                                            <StackPanel Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="15"
                                                    Height="15"
                                                    Margin="0,0,8,0"
                                                    VerticalAlignment="Center"
                                                    Kind="RenameBox" />
                                                <TextBlock Style="{StaticResource MethodItemText}" Text="{DynamicResource Str_RenameFiles_ReplaceName}" />
                                            </StackPanel>
                                        </ComboBoxItem>
                                    </ComboBox>

                                    <TextBlock
                                        x:Name="TxtMethodHint"
                                        Margin="2,8,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource SidebarTextMuted}"
                                        TextWrapping="Wrap" />

                                    <!--  One panel per method (only the chosen one shows)  -->

                                    <StackPanel x:Name="PanelFindReplace" Margin="0,6,0,0">
                                        <TextBlock
                                            Margin="0,12,0,6"
                                            Style="{StaticResource FieldLabel}"
                                            Text="{DynamicResource Str_Rename_Find}" />
                                        <TextBox
                                            x:Name="TxtFind"
                                            Tag="Text to find"
                                            TextChanged="Setting_Changed"
                                            ToolTip="{DynamicResource Str_Rename_FindTooltip}" />
                                        <TextBlock
                                            Margin="0,12,0,6"
                                            Style="{StaticResource FieldLabel}"
                                            Text="{DynamicResource Str_Rename_ReplaceWith}" />
                                        <TextBox
                                            x:Name="TxtReplace"
                                            Tag="Leave empty to delete it"
                                            TextChanged="Setting_Changed"
                                            ToolTip="{DynamicResource Str_Rename_ReplaceWithTooltip}" />
                                        <CheckBox
                                            x:Name="ChkMatchCase"
                                            Margin="0,10,0,0"
                                            Checked="Setting_Changed"
                                            Content="{DynamicResource Str_Rename_MatchCase}"
                                            Foreground="{DynamicResource SidebarText}"
                                            ToolTip="{DynamicResource Str_Common_MatchCaseTooltip}"
                                            Unchecked="Setting_Changed" />
                                        <CheckBox
                                            x:Name="ChkWholeWord"
                                            Margin="0,8,0,0"
                                            Checked="Setting_Changed"
                                            Content="{DynamicResource Str_Common_WholeWordOnly}"
                                            Foreground="{DynamicResource SidebarText}"
                                            ToolTip="{DynamicResource Str_RenameFiles_OnlyWhereItIsn}"
                                            Unchecked="Setting_Changed" />
                                    </StackPanel>

                                    <StackPanel
                                        x:Name="PanelPrefixSuffix"
                                        Margin="0,6,0,0"
                                        Visibility="Collapsed">
                                        <TextBlock
                                            Margin="0,6,0,4"
                                            Style="{StaticResource FieldLabel}"
                                            Text="{DynamicResource Str_Rename_Prefix}" />
                                        <TextBox
                                            x:Name="TxtPrefix"
                                            Tag="Added at the start"
                                            TextChanged="Setting_Changed"
                                            ToolTip="{DynamicResource Str_Rename_PrefixTooltip}" />
                                        <TextBlock
                                            Margin="0,10,0,4"
                                            Style="{StaticResource FieldLabel}"
                                            Text="{DynamicResource Str_Rename_Suffix}" />
                                        <TextBox
                                            x:Name="TxtSuffix"
                                            Tag="Added at the end"
                                            TextChanged="Setting_Changed"
                                            ToolTip="{DynamicResource Str_Rename_SuffixTooltip}" />
                                        <CheckBox
                                            x:Name="ChkSuffixBeforeExtension"
                                            Margin="0,10,0,0"
                                            Checked="Setting_Changed"
                                            Content="{DynamicResource Str_Rename_SuffixBeforeExt}"
                                            Foreground="{DynamicResource SidebarText}"
                                            IsChecked="True"
                                            ToolTip="{DynamicResource Str_Rename_SuffixBeforeExtTooltip}"
                                            Unchecked="Setting_Changed" />
                                    </StackPanel>

                                    <StackPanel
                                        x:Name="PanelReplaceName"
                                        Margin="0,6,0,0"
                                        Visibility="Collapsed">
                                        <TextBlock
                                            Margin="0,6,0,4"
                                            Style="{StaticResource FieldLabel}"
                                            Text="{DynamicResource Str_RenameFiles_NewName}" />
                                        <TextBox
                                            x:Name="TxtNewName"
                                            Tag="For example: album"
                                            TextChanged="Setting_Changed"
                                            ToolTip="{DynamicResource Str_RenameFiles_NewNameTooltip}" />
                                        <CheckBox
                                            x:Name="ChkWindowsStyle"
                                            Margin="0,10,0,0"
                                            Checked="Setting_Changed"
                                            Content="{DynamicResource Str_RenameFiles_WindowsStyle}"
                                            Foreground="{DynamicResource SidebarText}"
                                            IsChecked="True"
                                            ToolTip="{DynamicResource Str_RenameFiles_WindowsStyleTooltip}"
                                            Unchecked="Setting_Changed" />
                                    </StackPanel>

                                    <StackPanel
                                        x:Name="PanelNumberSequence"
                                        Margin="0,6,0,0"
                                        Visibility="Collapsed">
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock
                                                    Margin="0,0,0,4"
                                                    Style="{StaticResource FieldLabel}"
                                                    Text="{DynamicResource Str_RenameFiles_Start}" />
                                                <TextBox
                                                    x:Name="TxtStartAt"
                                                    Text="1"
                                                    TextChanged="Setting_Changed"
                                                    ToolTip="{DynamicResource Str_Rename_StartAtTooltip}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock
                                                    Margin="0,0,0,4"
                                                    Style="{StaticResource FieldLabel}"
                                                    Text="{DynamicResource Str_RenameFiles_Step}" />
                                                <TextBox
                                                    x:Name="TxtIncrement"
                                                    Text="1"
                                                    TextChanged="Setting_Changed"
                                                    ToolTip="{DynamicResource Str_Rename_IncrementTooltip}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="4">
                                                <TextBlock
                                                    Margin="0,0,0,4"
                                                    Style="{StaticResource FieldLabel}"
                                                    Text="{DynamicResource Str_RenameFiles_Digits}" />
                                                <TextBox
                                                    x:Name="TxtPadding"
                                                    Text="3"
                                                    TextChanged="Setting_Changed"
                                                    ToolTip="{DynamicResource Str_Rename_PaddingTooltip}" />
                                            </StackPanel>
                                        </Grid>

                                        <StackPanel x:Name="PanelSeparator">
                                        <TextBlock
                                            Margin="0,10,0,4"
                                            Style="{StaticResource FieldLabel}"
                                            Text="{DynamicResource Str_Password_SeparatorHeader}" />
                                        <TextBox
                                            x:Name="TxtSeparator"
                                            Tag="Between name and number"
                                            Text="_"
                                            TextChanged="Setting_Changed"
                                            ToolTip="{DynamicResource Str_RenameFiles_WhatGoesBetweenThe}" />
                                        </StackPanel>

                                        <StackPanel x:Name="PanelNumberPosition">
                                        <TextBlock
                                            Margin="0,10,0,6"
                                            Style="{StaticResource FieldLabel}"
                                            Text="{DynamicResource Str_Rename_Position}" />
                                        <UniformGrid Columns="3" ToolTip="{DynamicResource Str_Rename_PositionTooltip}">
                                            <RadioButton
                                                x:Name="RadioNumberSuffix"
                                                Margin="0,0,2,0"
                                                Click="Option_Click"
                                                Content="{DynamicResource Str_BackgroundRemover_After}"
                                                GroupName="NumberPosition"
                                                IsChecked="True"
                                                Style="{StaticResource ModeToggleButtonStyle}"
                                                Tag="Suffix"
                                                ToolTip="{DynamicResource Str_RenameFiles_Holiday001}" />
                                            <RadioButton
                                                x:Name="RadioNumberPrefix"
                                                Margin="2,0"
                                                Click="Option_Click"
                                                Content="{DynamicResource Str_BackgroundRemover_Before}"
                                                GroupName="NumberPosition"
                                                Style="{StaticResource ModeToggleButtonStyle}"
                                                Tag="Prefix"
                                                ToolTip="{DynamicResource Str_RenameFiles_001Holiday}" />
                                            <RadioButton
                                                x:Name="RadioNumberReplace"
                                                Margin="2,0,0,0"
                                                Click="Option_Click"
                                                Content="{DynamicResource Str_RenameFiles_Only}"
                                                GroupName="NumberPosition"
                                                Style="{StaticResource ModeToggleButtonStyle}"
                                                Tag="ReplaceEntireName"
                                                ToolTip="{DynamicResource Str_RenameFiles_001TheNumberReplaces}" />
                                        </UniformGrid>
                                        </StackPanel>

                                        <TextBlock
                                            Margin="0,10,0,6"
                                            Style="{StaticResource FieldLabel}"
                                            Text="{DynamicResource Str_RenameFiles_NumberInOrderOf}" />
                                        <UniformGrid Columns="2">
                                            <RadioButton
                                                x:Name="RadioOrderName"
                                                Margin="0,0,2,0"
                                                Click="Option_Click"
                                                Content="{DynamicResource Str_Common_ColHeaderName}"
                                                GroupName="NumberOrder"
                                                IsChecked="True"
                                                Style="{StaticResource ModeToggleButtonStyle}"
                                                Tag="Name"
                                                ToolTip="{DynamicResource Str_RenameFiles_ByFileName2}" />
                                            <RadioButton
                                                x:Name="RadioOrderDate"
                                                Margin="2,0,0,0"
                                                Click="Option_Click"
                                                Content="{DynamicResource Str_RenameFiles_Date}"
                                                GroupName="NumberOrder"
                                                Style="{StaticResource ModeToggleButtonStyle}"
                                                Tag="DateModified"
                                                ToolTip="{DynamicResource Str_RenameFiles_OldestFirstPhotosCome}" />
                                        </UniformGrid>
                                        <CheckBox
                                            x:Name="ChkNumberPerFolder"
                                            Margin="0,10,0,0"
                                            Checked="Setting_Changed"
                                            Content="{DynamicResource Str_RenameFiles_StartAgainInEach}"
                                            Foreground="{DynamicResource SidebarText}"
                                            ToolTip="{DynamicResource Str_RenameFiles_EveryFolderStartsAt}"
                                            Unchecked="Setting_Changed" />
                                    </StackPanel>

                                    <StackPanel
                                        x:Name="PanelChangeCase"
                                        Margin="0,6,0,0"
                                        Visibility="Collapsed">
                                        <TextBlock
                                            Margin="0,6,0,4"
                                            Style="{StaticResource FieldLabel}"
                                            Text="{DynamicResource Str_Rename_CaseStyle}" />
                                        <ComboBox
                                            x:Name="ComboCaseStyle"
                                            SelectedIndex="0"
                                            SelectionChanged="Setting_Changed"
                                            ToolTip="{DynamicResource Str_Rename_CaseStyleTooltip}">
                                            <ComboBoxItem Content="{DynamicResource Str_RenameFiles_Uppercase}" Tag="Upper" />
                                            <ComboBoxItem Content="{DynamicResource Str_RenameFiles_Lowercase}" Tag="Lower" />
                                            <ComboBoxItem Content="{DynamicResource Str_RenameFiles_TitleCase}" Tag="Title" />
                                            <ComboBoxItem Content="{DynamicResource Str_RenameFiles_SentenceCase}" Tag="Sentence" />
                                            <ComboBoxItem Content="{DynamicResource Str_RenameFiles_Camelcase}" Tag="Camel" />
                                            <ComboBoxItem Content="{DynamicResource Str_RenameFiles_Pascalcase}" Tag="Pascal" />
                                        </ComboBox>
                                        <CheckBox
                                            x:Name="ChkCaseExtension"
                                            Margin="0,10,0,0"
                                            Checked="Setting_Changed"
                                            Content="{DynamicResource Str_Rename_ApplyToExtension}"
                                            Foreground="{DynamicResource SidebarText}"
                                            ToolTip="{DynamicResource Str_RenameFiles_UppercaseMakesTheExtension}"
                                            Unchecked="Setting_Changed" />
                                    </StackPanel>

                                    <StackPanel
                                        x:Name="PanelTrimStrip"
                                        Margin="0,6,0,0"
                                        Visibility="Collapsed">
                                        <Grid Margin="0,6,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="10" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock
                                                    Margin="0,0,0,4"
                                                    Style="{StaticResource FieldLabel}"
                                                    Text="{DynamicResource Str_Rename_TrimStart}" />
                                                <TextBox
                                                    x:Name="TxtTrimStart"
                                                    Text="0"
                                                    TextChanged="Setting_Changed"
                                                    ToolTip="{DynamicResource Str_Rename_TrimStartTooltip}" />
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock
                                                    Margin="0,0,0,4"
                                                    Style="{StaticResource FieldLabel}"
                                                    Text="{DynamicResource Str_Rename_TrimEnd}" />
                                                <TextBox
                                                    x:Name="TxtTrimEnd"
                                                    Text="0"
                                                    TextChanged="Setting_Changed"
                                                    ToolTip="{DynamicResource Str_Rename_TrimEndTooltip}" />
                                            </StackPanel>
                                        </Grid>
                                        <CheckBox
                                            x:Name="ChkStripSpaces"
                                            Margin="0,10,0,0"
                                            Checked="Setting_Changed"
                                            Content="{DynamicResource Str_Rename_StripSpaces}"
                                            Foreground="{DynamicResource SidebarText}"
                                            IsChecked="True"
                                            ToolTip="{DynamicResource Str_Rename_StripSpacesTooltip}"
                                            Unchecked="Setting_Changed" />
                                        <CheckBox
                                            x:Name="ChkCollapseSpaces"
                                            Margin="0,8,0,0"
                                            Checked="Setting_Changed"
                                            Content="{DynamicResource Str_Rename_CollapseSpaces}"
                                            Foreground="{DynamicResource SidebarText}"
                                            ToolTip="{DynamicResource Str_Rename_CollapseSpacesTooltip}"
                                            Unchecked="Setting_Changed" />
                                    </StackPanel>

                                    <StackPanel
                                        x:Name="PanelRegexReplace"
                                        Margin="0,6,0,0"
                                        Visibility="Collapsed">
                                        <TextBlock
                                            Margin="0,6,0,4"
                                            Style="{StaticResource FieldLabel}"
                                            Text="{DynamicResource Str_Rename_Pattern}" />
                                        <TextBox
                                            x:Name="TxtPattern"
                                            FontFamily="Consolas"
                                            Text="^(.*)$"
                                            TextChanged="Setting_Changed"
                                            ToolTip="{DynamicResource Str_Rename_PatternTooltip}" />
                                        <TextBlock
                                            Margin="0,10,0,4"
                                            Style="{StaticResource FieldLabel}"
                                            Text="{DynamicResource Str_Rename_Replacement}" />
                                        <TextBox
                                            x:Name="TxtReplacement"
                                            FontFamily="Consolas"
                                            Text="$1"
                                            TextChanged="Setting_Changed"
                                            ToolTip="{DynamicResource Str_Rename_ReplacementTooltip}" />
                                        <TextBlock
                                            Margin="2,6,0,0"
                                            FontSize="11"
                                            Foreground="{DynamicResource SidebarTextMuted}"
                                            Text="{DynamicResource Str_RenameFiles_Use12For}"
                                            TextWrapping="Wrap" />
                                        <CheckBox
                                            x:Name="ChkRegexCaseInsensitive"
                                            Margin="0,10,0,0"
                                            Checked="Setting_Changed"
                                            Content="{DynamicResource Str_Common_CaseInsensitive}"
                                            Foreground="{DynamicResource SidebarText}"
                                            IsChecked="True"
                                            ToolTip="{DynamicResource Str_Common_IgnoreCaseTooltip}"
                                            Unchecked="Setting_Changed" />
                                        <CheckBox
                                            x:Name="ChkReplaceAll"
                                            Margin="0,8,0,0"
                                            Checked="Setting_Changed"
                                            Content="{DynamicResource Str_Rename_ReplaceAllMatches}"
                                            Foreground="{DynamicResource SidebarText}"
                                            IsChecked="True"
                                            ToolTip="{DynamicResource Str_Rename_ReplaceAllMatchesTooltip}"
                                            Unchecked="Setting_Changed" />
                                    </StackPanel>

                                    <StackPanel
                                        x:Name="PanelRemoveCharacters"
                                        Margin="0,6,0,0"
                                        Visibility="Collapsed">
                                        <TextBlock
                                            Margin="0,6,0,4"
                                            Style="{StaticResource FieldLabel}"
                                            Text="{DynamicResource Str_Rename_CharsToRemove}" />
                                        <TextBox
                                            x:Name="TxtRemoveCharacters"
                                            Tag="For example -_#"
                                            TextChanged="Setting_Changed"
                                            ToolTip="{DynamicResource Str_Rename_CharsToRemoveTooltip}" />
                                        <CheckBox
                                            x:Name="ChkRemoveNumbers"
                                            Margin="0,10,0,0"
                                            Checked="Setting_Changed"
                                            Content="{DynamicResource Str_Rename_RemoveNumbers}"
                                            Foreground="{DynamicResource SidebarText}"
                                            ToolTip="{DynamicResource Str_Rename_RemoveNumbersTooltip}"
                                            Unchecked="Setting_Changed" />
                                        <CheckBox
                                            x:Name="ChkRemoveSymbols"
                                            Margin="0,8,0,0"
                                            Checked="Setting_Changed"
                                            Content="{DynamicResource Str_Rename_RemoveSymbols}"
                                            Foreground="{DynamicResource SidebarText}"
                                            ToolTip="{DynamicResource Str_Rename_RemoveSymbolsTooltip}"
                                            Unchecked="Setting_Changed" />
                                        <CheckBox
                                            x:Name="ChkRemoveSpaces"
                                            Margin="0,8,0,0"
                                            Checked="Setting_Changed"
                                            Content="{DynamicResource Str_Rename_RemoveSpaces}"
                                            Foreground="{DynamicResource SidebarText}"
                                            ToolTip="{DynamicResource Str_Rename_RemoveSpacesTooltip}"
                                            Unchecked="Setting_Changed" />
                                        <CheckBox
                                            x:Name="ChkRemoveDiacritics"
                                            Margin="0,8,0,0"
                                            Checked="Setting_Changed"
                                            Content="{DynamicResource Str_Rename_RemoveDiacritics}"
                                            Foreground="{DynamicResource SidebarText}"
                                            ToolTip="{DynamicResource Str_Rename_RemoveDiacriticsTooltip}"
                                            Unchecked="Setting_Changed" />
                                    </StackPanel>

                                    <StackPanel
                                        x:Name="PanelCleanSuffixes"
                                        Margin="0,6,0,0"
                                        Visibility="Collapsed">
                                        <CheckBox
                                            x:Name="ChkStripUnderscore"
                                            Margin="0,8,0,0"
                                            Checked="Setting_Changed"
                                            Content="{DynamicResource Str_Rename_StripUnderscore}"
                                            Foreground="{DynamicResource SidebarText}"
                                            IsChecked="True"
                                            ToolTip="{DynamicResource Str_Rename_StripUnderscoreTooltip}"
                                            Unchecked="Setting_Changed" />
                                        <CheckBox
                                            x:Name="ChkStripDash"
                                            Margin="0,8,0,0"
                                            Checked="Setting_Changed"
                                            Content="{DynamicResource Str_Rename_StripDash}"
                                            Foreground="{DynamicResource SidebarText}"
                                            IsChecked="True"
                                            ToolTip="{DynamicResource Str_Rename_StripDashTooltip}"
                                            Unchecked="Setting_Changed" />
                                        <CheckBox
                                            x:Name="ChkStripCopyWords"
                                            Margin="0,8,0,0"
                                            Checked="Setting_Changed"
                                            Content="{DynamicResource Str_Rename_StripCopyWords}"
                                            Foreground="{DynamicResource SidebarText}"
                                            IsChecked="True"
                                            ToolTip="{DynamicResource Str_Rename_StripCopyWordsTooltip}"
                                            Unchecked="Setting_Changed" />
                                        <CheckBox
                                            x:Name="ChkStripWindowsCounter"
                                            Margin="0,8,0,0"
                                            Checked="Setting_Changed"
                                            Content="{DynamicResource Str_Rename_StripWindowsCounter}"
                                            Foreground="{DynamicResource SidebarText}"
                                            IsChecked="True"
                                            ToolTip="{DynamicResource Str_Rename_StripWindowsCounterTooltip}"
                                            Unchecked="Setting_Changed" />
                                    </StackPanel>

                                    <!--  Input problems (a letter in a number box...)  -->
                                    <TextBlock
                                        x:Name="TxtSettingError"
                                        Margin="2,8,0,0"
                                        FontSize="11"
                                        Foreground="{DynamicResource StatusErrorFg}"
                                        TextWrapping="Wrap"
                                        Visibility="Collapsed" />

                                    <!--  Live example from the chosen files  -->
                                    <Border
                                        x:Name="ExampleBox"
                                        Margin="0,10,0,0"
                                        Padding="10,7"
                                        Background="{DynamicResource AccentColorSubtle}"
                                        CornerRadius="8"
                                        ToolTip="{DynamicResource Str_RenameFiles_TheFirstFileThese}"
                                        Visibility="Collapsed">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon
                                                Width="14"
                                                Height="14"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource AccentColor}"
                                                Kind="SubdirectoryArrowRight" />
                                            <TextBlock
                                                x:Name="TxtExample"
                                                Grid.Column="1"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource AccentColor}"
                                                TextTrimming="CharacterEllipsis" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!--  ============ EXTENSION ============  -->
                            <Border ctl:Tour.Key="Str_Tour_RenameFiles_Extension" ctl:Tour.Order="3" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Rename_ExtensionHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.FileOutline}" />
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>

                                        <!--  First Option: Full Width  -->
                                        <RadioButton
                                            x:Name="RadioExtKeep"
                                            Grid.Row="0"
                                            Margin="0,0,0,2"
                                            Click="Option_Click"
                                            Content="{DynamicResource Str_FindSimilar_KeepBadge}"
                                            GroupName="Extension"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="Keep"
                                            ToolTip="{DynamicResource Str_RenameFiles_LeaveTheExtensionAs}" />

                                        <!--  Middle Options: 1x2 Grid (Two columns)  -->
                                        <UniformGrid
                                            Grid.Row="1"
                                            Margin="0,2"
                                            Columns="2">
                                            <RadioButton
                                                x:Name="RadioExtLower"
                                                Margin="0,0,2,0"
                                                Click="Option_Click"
                                                Content="{DynamicResource Str_RenameFiles_LowercaseExtensionsText}"
                                                GroupName="Extension"
                                                Style="{StaticResource ModeToggleButtonStyle}"
                                                Tag="Lower"
                                                ToolTip="{DynamicResource Str_RenameFiles_LowercaseExtensions}" />
                                            <RadioButton
                                                x:Name="RadioExtUpper"
                                                Margin="2,0,0,0"
                                                Click="Option_Click"
                                                Content="{DynamicResource Str_RenameFiles_UppercaseExtensionsText}"
                                                GroupName="Extension"
                                                Style="{StaticResource ModeToggleButtonStyle}"
                                                Tag="Upper"
                                                ToolTip="{DynamicResource Str_RenameFiles_UppercaseExtensions}" />
                                        </UniformGrid>

                                        <!--  Last Option: Full Width  -->
                                        <RadioButton
                                            x:Name="RadioExtChange"
                                            Grid.Row="2"
                                            Margin="0,2,0,0"
                                            Click="Option_Click"
                                            Content="{DynamicResource Str_RenameFiles_New}"
                                            GroupName="Extension"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="Change"
                                            ToolTip="{DynamicResource Str_RenameFiles_GiveEveryFileThe}" />
                                    </Grid>
                                    <StackPanel
                                        x:Name="PanelNewExtension"
                                        Margin="0,10,0,0"
                                        Visibility="Collapsed">
                                        <TextBox
                                            x:Name="TxtNewExtension"
                                            Tag="New extension, e.g. jpg"
                                            TextChanged="Setting_Changed"
                                            ToolTip="{DynamicResource Str_RenameFiles_TypedWithOrWithout}" />
                                        <Border
                                            Margin="0,8,0,0"
                                            Padding="10,7"
                                            Background="{DynamicResource StatusWarningBg}"
                                            CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon
                                                    Width="14"
                                                    Height="14"
                                                    Margin="0,1,8,0"
                                                    VerticalAlignment="Top"
                                                    Foreground="{DynamicResource StatusWarningFg}"
                                                    Kind="AlertOutline" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    FontSize="11"
                                                    Foreground="{DynamicResource StatusWarningFg}"
                                                    Text="{DynamicResource Str_RenameFiles_OnlyTheNameChanges}"
                                                    TextWrapping="Wrap" />
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </StackPanel>
                            </Border>

                            <!--  ============ OPTIONS ============  -->
                            <Border Margin="0,0,0,4" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Rename_OptionsHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.Tune}" />
                                    <CheckBox
                                        x:Name="ChkAutoPreview"
                                        Checked="AutoPreview_Changed"
                                        Content="{DynamicResource Str_Rename_AutoPreview}"
                                        Foreground="{DynamicResource SidebarText}"
                                        IsChecked="True"
                                        ToolTip="{DynamicResource Str_RenameFiles_UpdateTheListAs}"
                                        Unchecked="AutoPreview_Changed" />
                                    <Border
                                        Margin="0,10,0,0"
                                        Padding="10,8"
                                        Background="{DynamicResource StatusInfoBg}"
                                        CornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon
                                                Width="14"
                                                Height="14"
                                                Margin="0,1,8,0"
                                                VerticalAlignment="Top"
                                                Foreground="{DynamicResource StatusInfoFg}"
                                                Kind="Undo" />
                                            <TextBlock
                                                Grid.Column="1"
                                                FontSize="11"
                                                Foreground="{DynamicResource StatusInfoFg}"
                                                Text="{DynamicResource Str_RenameFiles_TheLastRenameCan}"
                                                TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <!--  Kept (empty) for existing code that references it  -->
                    <StackPanel x:Name="OptionsBottomPanel" Grid.Row="2" />
                </Grid>
            </Border>

            <!--  ================= MAIN AREA =================  -->

            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Run bar  -->
                <Border
                    Grid.Row="0"
                    Margin="0,0,0,14"
                    Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button
                            x:Name="BtnRenameFiles"
                            ctl:Tour.Key="Str_Tour_RenameFiles_Run" ctl:Tour.Order="4"
                            MinWidth="170"
                            VerticalAlignment="Center"
                            Click="BtnRenameFiles_Click"
                            Style="{StaticResource AccentPrimaryButtonStyle}"
                            ToolTip="{DynamicResource Str_Rename_RenameButtonTooltip}">
                            <Grid HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon
                                    Grid.Column="0"
                                    x:Name="IconRename"
                                    Width="18"
                                    Height="18"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Kind="RenameOutline" />
                                <TextBlock
                                    Grid.Column="1"
                                    x:Name="TxtRenameLabel"
                                    VerticalAlignment="Center"
                                    Text="{DynamicResource Str_Rename_Title}" TextWrapping="Wrap" />
                            </Grid>
                        </Button>

                        <Button
                            x:Name="BtnUndoRename"
                            Grid.Column="1"
                            Width="36"
                            Height="36"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Click="BtnUndoRename_Click"
                            IsEnabled="False"
                            Style="{StaticResource NeutralIconButtonStyle}"
                            ToolTip="{DynamicResource Str_RenameFiles_UndoTheLastRename}">
                            <materialDesign:PackIcon
                                Width="17"
                                Height="17"
                                Kind="Undo" />
                        </Button>

                        <Button
                            x:Name="BtnGeneratePreview"
                            Grid.Column="2"
                            Width="36"
                            Height="36"
                            Margin="6,0,16,0"
                            VerticalAlignment="Center"
                            Click="BtnGeneratePreview_Click"
                            Style="{StaticResource NeutralIconButtonStyle}"
                            ToolTip="{DynamicResource Str_Rename_GeneratePreviewTooltip}">
                            <materialDesign:PackIcon
                                Width="17"
                                Height="17"
                                Kind="Refresh" />
                        </Button>

                        <StackPanel Grid.Column="3" VerticalAlignment="Center">
                            <ProgressBar
                                x:Name="ProgressRename"
                                Height="8"
                                Maximum="100"
                                ToolTip="{DynamicResource Str_Rename_ProgressTooltip}" />
                            <TextBlock
                                x:Name="TxtProgress"
                                Margin="0,6,0,0"
                                FontSize="11.5"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="{DynamicResource Str_RenameFiles_AddAFolderTo}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock
                            x:Name="TxtProgressPercent"
                            Grid.Column="4"
                            MinWidth="54"
                            Margin="16,0,0,0"
                            VerticalAlignment="Center"
                            FontSize="20"
                            FontWeight="Bold"
                            Foreground="{DynamicResource AccentColor}"
                            TextAlignment="Right" />
                    </Grid>
                </Border>

                <!--  Preview  -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ContentControl
                                VerticalAlignment="Center"
                                Content="{DynamicResource Str_Rename_ResultsTitle}"
                                Style="{StaticResource CardHeader}"
                                Tag="{x:Static materialDesign:PackIconKind.FormatListChecks}" />

                            <WrapPanel
                                x:Name="SummaryPanel"
                                Grid.Column="1"
                                Margin="10,0,0,0"
                                VerticalAlignment="Center"
                                Visibility="Collapsed">
                                <Border
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource StatusInfoBg}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    ToolTip="{DynamicResource Str_RenameFiles_FilesThatWillGet}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource StatusInfoFg}"
                                            Kind="RenameOutline" />
                                        <TextBlock
                                            x:Name="TxtSummaryReady"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource StatusInfoFg}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    x:Name="PillSame"
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource RowBg}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    ToolTip="{DynamicResource Str_RenameFiles_TheRulesDonT}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource TextSecondary}"
                                            Kind="Minus" />
                                        <TextBlock
                                            x:Name="TxtSummarySame"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextSecondary}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    x:Name="PillAdjusted"
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource StatusWarningBg}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    ToolTip="{DynamicResource Str_RenameFiles_TheNewNameWas}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource StatusWarningFg}"
                                            Kind="RenameOutline" />
                                        <TextBlock
                                            x:Name="TxtSummaryAdjusted"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource StatusWarningFg}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    x:Name="PillInvalid"
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource StatusWarningBg}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    ToolTip="{DynamicResource Str_FileGenerator_HoverARowS}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource StatusWarningFg}"
                                            Kind="AlertOutline" />
                                        <TextBlock
                                            x:Name="TxtSummaryInvalid"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource StatusWarningFg}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    x:Name="PillDone"
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource StatusSuccessBg}"
                                    Style="{StaticResource IconStatusPillStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource StatusSuccessFg}"
                                            Kind="CheckCircleOutline" />
                                        <TextBlock
                                            x:Name="TxtSummaryDone"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource StatusSuccessFg}" />
                                    </StackPanel>
                                </Border>
                                <Border
                                    x:Name="PillFailed"
                                    Margin="0,2,6,2"
                                    Background="{DynamicResource StatusErrorBg}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    ToolTip="{DynamicResource Str_FileConverter_HoverAFailedRow}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="13"
                                            Height="13"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource StatusErrorFg}"
                                            Kind="AlertCircleOutline" />
                                        <TextBlock
                                            x:Name="TxtSummaryFailed"
                                            FontSize="11"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource StatusErrorFg}" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <Button
                                x:Name="BtnReset"
                                Grid.Column="2"
                                VerticalAlignment="Center"
                                Click="BtnReset_Click"
                                ToolTip="{DynamicResource Str_Rename_ResetTooltip}"
                                Style="{StaticResource ListToolDangerButtonStyle}">
                                <materialDesign:PackIcon
                                    Width="16"
                                    Height="16"
                                    Kind="DeleteSweepOutline" />
                            </Button>
                        </Grid>

                        <!--  A problem with the settings themselves (a broken pattern)  -->
                        <Border
                            x:Name="PlanErrorBanner"
                            Grid.Row="1"
                            Margin="0,0,0,10"
                            Padding="10,8"
                            Background="{DynamicResource StatusErrorBg}"
                            CornerRadius="8"
                            Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon
                                    Width="14"
                                    Height="14"
                                    Margin="0,1,8,0"
                                    VerticalAlignment="Top"
                                    Foreground="{DynamicResource StatusErrorFg}"
                                    Kind="AlertCircleOutline" />
                                <TextBlock
                                    x:Name="TxtPlanError"
                                    Grid.Column="1"
                                    FontSize="11.5"
                                    Foreground="{DynamicResource StatusErrorFg}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <DataGrid
                            x:Name="DataGridPreview"
                            ctl:Tour.Key="Str_Tour_RenameFiles_Preview" ctl:Tour.Order="5"
                            Grid.Row="2"
                            AutoGenerateColumns="False"
                            CanUserAddRows="False"
                            CanUserSortColumns="False"
                            FontSize="12"
                            IsReadOnly="True"
                            MouseDoubleClick="DataGridPreview_MouseDoubleClick"
                            MinRowHeight="40"
                            SelectionMode="Extended"
                            ToolTip="{DynamicResource Str_Rename_GridTooltip}"
                            VirtualizingPanel.IsVirtualizing="True"
                            VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                            VirtualizingPanel.ScrollUnit="Pixel"
                            VirtualizingPanel.VirtualizationMode="Recycling">
                            <DataGrid.GroupStyle>
                                <GroupStyle HeaderTemplate="{StaticResource GroupHeaderTemplate}" />
                            </DataGrid.GroupStyle>
                            <DataGrid.Columns>
                                <DataGridTemplateColumn
                                    Width="2*"
                                    MinWidth="70"
                                    CellTemplate="{StaticResource OriginalCellTemplate}"
                                    Header="{DynamicResource Str_Rename_ColHeaderOriginalName}" />
                                <DataGridTemplateColumn
                                    Width="30"
                                    CellStyle="{StaticResource CompactCellStyle}"
                                    CellTemplate="{StaticResource ArrowCellTemplate}" />
                                <DataGridTemplateColumn
                                    Width="2*"
                                    MinWidth="70"
                                    CellTemplate="{StaticResource NewNameCellTemplate}"
                                    Header="{DynamicResource Str_Rename_ColHeaderNewName}" />
                                <DataGridTextColumn
                                    ElementStyle="{StaticResource EllipsisCellTextStyle}"
                                    x:Name="ColExtension"
                                    Width="70"
                                    Binding="{Binding Extension, Mode=OneWay}"
                                    Header="{DynamicResource Str_Rename_ColHeaderExtension}" />
                                <DataGridTemplateColumn
                                    Width="120"
                                    CellTemplate="{StaticResource StatusCellTemplate}"
                                    Header="{DynamicResource Str_Common_ColHeaderStatus}" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <controls:EmptyStateCard
                            x:Name="EmptyStatePanel"
                            Grid.Row="2"
                            Description="{DynamicResource Str_RenameFiles_AddAFolderOn}"
                            Icon="RenameOutline"
                            IsHitTestVisible="False" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
