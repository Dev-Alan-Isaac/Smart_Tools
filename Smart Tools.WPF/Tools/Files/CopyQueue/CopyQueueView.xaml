<UserControl
    x:Class="Smart_Tools.WPF.Views.CopyQueueView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:models="clr-namespace:Smart_Tools.WPF.Models"
    x:Name="Root"
    Focusable="True"
    Loaded="Root_Loaded">

    <!--  Backend: Controllers/CopyQueueManager.cs (planning, the verified copy/move, pause, undo, saved job) and SafeFileOps.cs. UI only here.  -->

    <UserControl.Resources>
        <!--  A file or folder added to the queue  -->
        <DataTemplate x:Key="SourceTemplate" DataType="{x:Type models:CopyQueueSource}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="26" Height="26" Margin="0,0,8,0" Background="{DynamicResource AccentColorSubtle}" CornerRadius="7">
                    <materialDesign:PackIcon x:Name="SourceIcon" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentColor}" Kind="FileOutline" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SidebarText}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Path}" />
                    <TextBlock Margin="0,1,0,0" FontSize="10.5" Foreground="{DynamicResource SidebarTextMuted}" Text="{Binding Parent}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="2" Width="24" Height="24" Margin="6,0,0,0" VerticalAlignment="Center" Click="BtnRemoveSource_Click" Style="{StaticResource IconButtonStyle}" Tag="{Binding}" ToolTip="Take this off the queue">
                    <materialDesign:PackIcon Width="13" Height="13" Kind="Close" />
                </Button>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                    <Setter TargetName="SourceIcon" Property="Kind" Value="Folder" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  One file in the queue  -->
        <DataTemplate x:Key="ItemTemplate" DataType="{x:Type models:CopyQueueItem}">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Source}" />
                    <TextBlock x:Name="Detail" FontSize="11" Foreground="{DynamicResource TextSecondary}" Text="{Binding Destination}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Message}" />
                </StackPanel>
                <TextBlock x:Name="StatusLabel" Grid.Column="1" Margin="12,0,4,0" VerticalAlignment="Center" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Text="{Binding StatusText}" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Done">
                    <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource StatusSuccessFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                    <Setter TargetName="Detail" Property="Text" Value="{Binding Message}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Skipped">
                    <Setter TargetName="StatusLabel" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                    <Setter TargetName="Detail" Property="Text" Value="{Binding Message}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="AlreadyThere">
                    <Setter TargetName="Detail" Property="Text" Value="{Binding Message}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">
        <Grid Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= OPTIONS SIDEBAR =================  -->
            <controls:ToolSidebar>
                <StackPanel x:Name="SidebarStack">
                    <controls:InputFolderCard
                        x:Name="InputCard"
                        ClearRequested="InputCard_ClearRequested"
                        Header="Files and folders to copy"
                        HeaderIcon="FolderMultipleOutline"
                        ItemTemplate="{StaticResource SourceTemplate}"
                        Mode="Files"
                        PathsAdded="InputCard_PathsAdded"
                        ShowSubfolders="False" />

                    <controls:InputFolderCard
                        x:Name="DestinationCard"
                        FolderChanged="DestinationCard_FolderChanged"
                        Header="Copy to"
                        HeaderIcon="FolderArrowDownOutline"
                        Mode="SingleFolder"
                        ShowSubfolders="False" />

                    <controls:InputFolderCard
                        x:Name="MoveDestinationCard"
                        FolderChanged="DestinationCard_FolderChanged"
                        Header="Move to"
                        HeaderIcon="FolderMoveOutline"
                        Mode="SingleFolder"
                        ShowSubfolders="False"
                        Visibility="Collapsed" />

                    <Border Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl Content="WHAT TO DO" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.TuneVariant}" />
                            <UniformGrid Margin="0,8,0,0" Columns="2">
                                <RadioButton x:Name="RadioCopy" Margin="0,0,2,0" Checked="Option_Changed" Content="Copy" GroupName="CqMode" IsChecked="True" Style="{StaticResource ModeToggleButtonStyle}" ToolTip="Copy - keep the originals" />
                                <RadioButton x:Name="RadioMove" Margin="2,0,0,0" Checked="Option_Changed" Content="Move" GroupName="CqMode" Style="{StaticResource ModeToggleButtonStyle}" ToolTip="Move - remove each original after its copy is checked" />
                            </UniformGrid>
                            <TextBlock Margin="2,6,0,0" FontSize="10.5" Foreground="{DynamicResource SidebarTextMuted}" TextWrapping="Wrap" Text="Copy keeps the originals. Move removes each original only after its copy is checked." />
                            <TextBlock Margin="2,12,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SidebarTextMuted}" Text="If a different file has the same name" />
                            <UniformGrid Margin="0,6,0,0" Columns="2">
                                <RadioButton x:Name="RadioKeepBoth" Margin="0,0,2,0" Checked="Option_Changed" Content="Keep both" GroupName="CqConflict" IsChecked="True" Style="{StaticResource ModeToggleButtonStyle}" ToolTip="Keep both (adds ' (2)')" />
                                <RadioButton x:Name="RadioSkip" Margin="2,0,0,0" Checked="Option_Changed" Content="Skip it" GroupName="CqConflict" Style="{StaticResource ModeToggleButtonStyle}" />
                            </UniformGrid>
                            <CheckBox x:Name="ChkVerify" Margin="2,12,0,0" Checked="Option_Changed" Content="Verify every copy" Foreground="{DynamicResource SidebarText}" IsChecked="True" Unchecked="Option_Changed" />
                            <TextBlock Margin="2,6,0,0" FontSize="10.5" Foreground="{DynamicResource SidebarTextMuted}" TextWrapping="Wrap" Text="Compares each copy to its original (SHA-256) before it counts. Moves are always verified." />
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl Content="GOOD TO KNOW" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.InformationOutline}" />
                            <TextBlock Margin="2,6,0,0" FontSize="10.5" Foreground="{DynamicResource SidebarTextMuted}" TextWrapping="Wrap" Text="Nothing is ever overwritten, and an original is only removed after its copy has been proven identical. Stop or a crash leaves the originals where they are. If the app closes mid-run, the queue comes back next time and files already done are recognised and skipped. Folders are copied with their empty subfolders; a move leaves the emptied source folders in place." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </controls:ToolSidebar>

            <!--  ================= MAIN AREA =================  -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Run bar  -->
                <Border Grid.Row="0" Margin="0,0,0,14" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button x:Name="BtnStart" MinWidth="180" VerticalAlignment="Center" Click="BtnStart_Click" Style="{StaticResource AccentPrimaryButtonStyle}" ToolTip="Copy or move everything in the queue">
                            <Grid HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon x:Name="IconStart" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" Kind="Play" />
                                <TextBlock x:Name="TxtStart" Grid.Column="1" VerticalAlignment="Center" Text="Start" TextWrapping="Wrap" />
                            </Grid>
                        </Button>

                        <Button x:Name="BtnPause" Grid.Column="1" Width="36" Height="36" Margin="8,0,0,0" VerticalAlignment="Center" Click="BtnPause_Click" IsEnabled="False" Style="{StaticResource NeutralIconButtonStyle}" ToolTip="Pause">
                            <materialDesign:PackIcon x:Name="IconPause" Width="17" Height="17" Kind="Pause" />
                        </Button>

                        <Button x:Name="BtnUndo" Grid.Column="2" Width="36" Height="36" Margin="6,0,16,0" VerticalAlignment="Center" Click="BtnUndo_Click" Style="{StaticResource ListToolButtonStyle}" ToolTip="Undo the last move" Visibility="Collapsed">
                            <materialDesign:PackIcon Width="17" Height="17" Kind="Undo" />
                        </Button>

                        <StackPanel Grid.Column="3" Margin="16,0,0,0" VerticalAlignment="Center">
                            <ProgressBar x:Name="Bar" Height="8" Maximum="100" ToolTip="Share of the data copied and verified so far" />
                            <TextBlock x:Name="TxtProgress" Margin="0,6,0,0" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Text="Add files or folders to start." TextTrimming="CharacterEllipsis" />
                        </StackPanel>

                        <TextBlock x:Name="TxtProgressPercent" Grid.Column="4" MinWidth="54" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentColor}" TextAlignment="Right" />
                    </Grid>
                </Border>

                <!--  Files  -->
                <Border Grid.Row="1" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <ContentControl VerticalAlignment="Center" Content="Files" Style="{StaticResource CardHeader}" Tag="{x:Static materialDesign:PackIconKind.FileMultipleOutline}" />

                            <WrapPanel x:Name="SummaryPanel" Grid.Column="1" Margin="10,0,0,0" VerticalAlignment="Center" Visibility="Collapsed">
                                <Border x:Name="PillFiles" Margin="0,2,6,2" Background="{DynamicResource StatusInfoBg}" Style="{StaticResource IconStatusPillStyle}" ToolTip="Files in the queue">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource StatusInfoFg}" Kind="FileMultipleOutline" />
                                        <TextBlock x:Name="TxtSummaryFiles" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource StatusInfoFg}" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="PillDone" Margin="0,2,6,2" Background="{DynamicResource StatusSuccessBg}" Style="{StaticResource IconStatusPillStyle}" ToolTip="Copied or moved" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource StatusSuccessFg}" Kind="CheckCircleOutline" />
                                        <TextBlock x:Name="TxtSummaryDone" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource StatusSuccessFg}" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="PillVerified" Margin="0,2,6,2" Background="{DynamicResource AccentColorSubtle}" Style="{StaticResource IconStatusPillStyle}" ToolTip="Compared to the original, byte for byte" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource AccentColor}" Kind="ShieldCheckOutline" />
                                        <TextBlock x:Name="TxtSummaryVerified" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentColor}" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="PillAlready" Margin="0,2,6,2" Background="{DynamicResource RowBg}" Style="{StaticResource IconStatusPillStyle}" ToolTip="An identical file was already at the destination" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Kind="CheckAll" />
                                        <TextBlock x:Name="TxtSummaryAlready" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="PillSkipped" Margin="0,2,6,2" Background="{DynamicResource StatusWarningBg}" Style="{StaticResource IconStatusPillStyle}" ToolTip="Skipped because a different file had the same name" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource StatusWarningFg}" Kind="SkipNextOutline" />
                                        <TextBlock x:Name="TxtSummarySkipped" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource StatusWarningFg}" />
                                    </StackPanel>
                                </Border>
                                <Border x:Name="PillFailed" Margin="0,2,6,2" Background="{DynamicResource StatusErrorBg}" Style="{StaticResource IconStatusPillStyle}" ToolTip="Hover a failed row for the reason" Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource StatusErrorFg}" Kind="AlertCircleOutline" />
                                        <TextBlock x:Name="TxtSummaryFailed" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource StatusErrorFg}" />
                                    </StackPanel>
                                </Border>
                            </WrapPanel>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center" Orientation="Horizontal">
                                <Button x:Name="BtnOpenDestination" Margin="0,0,6,0" Click="BtnOpenDestination_Click" Style="{StaticResource ListToolButtonStyle}" ToolTip="Open the destination folder">
                                    <materialDesign:PackIcon Width="16" Height="16" Kind="FolderOpenOutline" />
                                </Button>
                                <Button x:Name="BtnClearQueue" Click="BtnClearQueue_Click" Style="{StaticResource ListToolDangerButtonStyle}" ToolTip="Empty the queue (no files are touched)">
                                    <materialDesign:PackIcon Width="16" Height="16" Kind="DeleteSweepOutline" />
                                </Button>
                            </StackPanel>
                        </Grid>

                        <Border x:Name="StatusBanner" Grid.Row="1" Margin="0,0,0,10" Padding="10,8" CornerRadius="8" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon x:Name="StatusIcon" Width="14" Height="14" Margin="0,1,8,0" VerticalAlignment="Top" Kind="AlertOutline" />
                                <TextBlock x:Name="TxtStatus" Grid.Column="1" FontSize="11.5" TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <Border Grid.Row="2" Background="{DynamicResource RowBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="12">
                            <Grid>
                                <ListBox x:Name="ItemList" Padding="8" Background="Transparent" BorderThickness="0" ItemTemplate="{StaticResource ItemTemplate}" ScrollViewer.HorizontalScrollBarVisibility="Disabled" VirtualizingPanel.IsVirtualizing="True" />
                                <StackPanel x:Name="ListEmpty" MaxWidth="340" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.FolderMoveOutline}" />
                                    <TextBlock x:Name="TxtEmptyTitle" Margin="0,12,0,0" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="Add files or folders" />
                                    <TextBlock x:Name="TxtEmptyHint" Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="Drop them on the left, pick where they go, then press Start." TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
