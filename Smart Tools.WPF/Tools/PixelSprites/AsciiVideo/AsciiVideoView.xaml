<UserControl
    x:Class="Smart_Tools.WPF.Views.AsciiVideoView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    x:Name="Root"
    AllowDrop="True"
    Focusable="True"
    Loaded="Root_Loaded">

    <!--  Backend: AsciiVideoManager.cs (yt-dlp, FFmpeg, glyphs, the frame pipe), Core\ (maths, text file, player, command lines). UI only here.  -->

    <Grid Background="{DynamicResource ContentBg}">
        <Grid Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= OPTIONS SIDEBAR =================  -->
            <controls:ToolSidebar>
                <StackPanel x:Name="SidebarStack">

                    <Border ctl:Tour.Key="Str_Tour_AsciiVideo_Source" ctl:Tour.Order="1" Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl Content="{DynamicResource Str_AsciiVideo_SourceHeader}" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.MovieOpenOutline}" />
                            <UniformGrid Columns="2">
                                <RadioButton x:Name="RbLink" Margin="0,0,2,0" Checked="Source_Changed" Content="{DynamicResource Str_AsciiVideo_FromLink}" GroupName="AsciiSource" IsChecked="True" controls:ChoiceIcon.Kind="LinkVariant" Style="{StaticResource ModeToggleTallStyle}" />
                                <RadioButton x:Name="RbFile" Margin="2,0,0,0" Checked="Source_Changed" Content="{DynamicResource Str_AsciiVideo_FromFile}" GroupName="AsciiSource" controls:ChoiceIcon.Kind="FileVideoOutline" Style="{StaticResource ModeToggleTallStyle}" />
                            </UniformGrid>
                            <StackPanel x:Name="PanelLink" Margin="0,10,0,0">
                                <Border Style="{StaticResource InputBarStyle}">
                                    <TextBox x:Name="TxtUrl" Style="{StaticResource BareTextBox}" Tag="{DynamicResource Str_AsciiVideo_LinkPlaceholder}" />
                                </Border>
                                <Button Margin="0,8,0,0" Click="BtnPaste_Click" Style="{StaticResource NeutralIconButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center" Kind="ContentPaste" />
                                        <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_AsciiVideo_Paste}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <StackPanel x:Name="PanelFile" Margin="0,10,0,0" Visibility="Collapsed">
                                <TextBlock x:Name="TxtFile" Margin="2,0,0,0" FontSize="12" Foreground="{DynamicResource SidebarText}" TextTrimming="CharacterEllipsis" />
                                <Button Margin="0,8,0,0" Click="BtnChooseFile_Click" Style="{StaticResource NeutralIconButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center" Kind="FolderOpenOutline" />
                                        <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_AsciiVideo_ChooseFile}" />
                                    </StackPanel>
                                </Button>
                            </StackPanel>
                            <TextBlock Style="{StaticResource SidebarHint}" Text="{DynamicResource Str_AsciiVideo_SourceNote}" />
                        </StackPanel>
                    </Border>

                    <Border ctl:Tour.Key="Str_Tour_AsciiVideo_Look" ctl:Tour.Order="2" Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl Content="{DynamicResource Str_AsciiVideo_LookHeader}" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.FormatLetterCase}" />
                            <Grid Margin="0,2,0,4">
                                <TextBlock Style="{StaticResource FieldLabel}" Text="{DynamicResource Str_AsciiVideo_Width}" />
                                <TextBlock x:Name="TxtColumns" HorizontalAlignment="Right" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SidebarText}" />
                            </Grid>
                            <Slider x:Name="SliderColumns" IsSnapToTickEnabled="True" Maximum="240" Minimum="40" TickFrequency="4" ValueChanged="SliderColumns_ValueChanged" />
                            <TextBlock Margin="0,12,0,6" Style="{StaticResource FieldLabel}" Text="{DynamicResource Str_AsciiVideo_Fps}" />
                            <ComboBox x:Name="CmbFps" SelectionChanged="Option_Changed">
                                <ComboBoxItem Content="10" Tag="10" />
                                <ComboBoxItem Content="15" Tag="15" />
                                <ComboBoxItem Content="24" Tag="24" />
                                <ComboBoxItem Content="30" Tag="30" />
                            </ComboBox>
                            <TextBlock Margin="0,12,0,6" Style="{StaticResource FieldLabel}" Text="{DynamicResource Str_AsciiVideo_Characters}" />
                            <ComboBox x:Name="CmbRamp" SelectionChanged="Option_Changed">
                                <ComboBoxItem Content="{DynamicResource Str_AsciiVideo_RampSmooth}" Tag="Smooth" />
                                <ComboBoxItem Content="{DynamicResource Str_AsciiVideo_RampDetailed}" Tag="Detailed" />
                                <ComboBoxItem Content="{DynamicResource Str_AsciiVideo_RampBlocks}" Tag="Blocks" />
                                <ComboBoxItem Content="{DynamicResource Str_AsciiVideo_RampSharp}" Tag="Sharp" />
                            </ComboBox>
                            <TextBlock Margin="0,12,0,6" Style="{StaticResource FieldLabel}" Text="{DynamicResource Str_AsciiVideo_Colors}" />
                            <UniformGrid Columns="2">
                                <RadioButton x:Name="RbWhiteOnBlack" Margin="0,0,2,0" Checked="Option_Changed" Content="{DynamicResource Str_AsciiVideo_WhiteOnBlack}" GroupName="AsciiColors" IsChecked="True" Style="{StaticResource ModeToggleButtonStyle}" />
                                <RadioButton x:Name="RbBlackOnWhite" Margin="2,0,0,0" Checked="Option_Changed" Content="{DynamicResource Str_AsciiVideo_BlackOnWhite}" GroupName="AsciiColors" Style="{StaticResource ModeToggleButtonStyle}" />
                            </UniformGrid>
                        </StackPanel>
                    </Border>

                    <Border Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl Content="{DynamicResource Str_AsciiVideo_PartHeader}" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.ContentCut}" />
                            <CheckBox x:Name="ChkClip" Margin="2,2,0,0" Checked="Clip_Changed" Content="{DynamicResource Str_AsciiVideo_Clip}" Foreground="{DynamicResource SidebarText}" Unchecked="Clip_Changed" />
                            <Grid x:Name="PanelClip" Margin="0,8,0,0" Visibility="Collapsed">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="8" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Margin="0,0,0,4" Style="{StaticResource FieldLabel}" Text="{DynamicResource Str_AsciiVideo_From}" />
                                    <Border Style="{StaticResource InputBarStyle}"><TextBox x:Name="TxtFrom" Style="{StaticResource BareTextBox}" Tag="0:00" /></Border>
                                </StackPanel>
                                <StackPanel Grid.Column="2">
                                    <TextBlock Margin="0,0,0,4" Style="{StaticResource FieldLabel}" Text="{DynamicResource Str_AsciiVideo_To}" />
                                    <Border Style="{StaticResource InputBarStyle}"><TextBox x:Name="TxtTo" Style="{StaticResource BareTextBox}" Tag="1:00" /></Border>
                                </StackPanel>
                            </Grid>
                            <TextBlock Style="{StaticResource SidebarHint}" Text="{DynamicResource Str_AsciiVideo_PartNote}" />
                        </StackPanel>
                    </Border>

                    <Border ctl:Tour.Key="Str_Tour_AsciiVideo_Outputs" ctl:Tour.Order="3" Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl Content="{DynamicResource Str_AsciiVideo_OutputsHeader}" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.ExportVariant}" />
                            <CheckBox x:Name="ChkMp4" Margin="2,2,0,0" Checked="Option_Changed" Content="{DynamicResource Str_AsciiVideo_Mp4}" Foreground="{DynamicResource SidebarText}" Unchecked="Option_Changed" />
                            <CheckBox x:Name="ChkSound" Margin="22,6,0,0" Checked="Option_Changed" Content="{DynamicResource Str_AsciiVideo_Sound}" Foreground="{DynamicResource SidebarText}" Unchecked="Option_Changed" />
                            <CheckBox x:Name="ChkGif" Margin="2,8,0,0" Checked="Option_Changed" Content="{DynamicResource Str_AsciiVideo_Gif}" Foreground="{DynamicResource SidebarText}" ToolTip="{DynamicResource Str_AsciiVideo_GifTip}" Unchecked="Option_Changed" />
                            <CheckBox x:Name="ChkText" Margin="2,8,0,0" Checked="Option_Changed" Content="{DynamicResource Str_AsciiVideo_Text}" Foreground="{DynamicResource SidebarText}" ToolTip="{DynamicResource Str_AsciiVideo_TextTip}" Unchecked="Option_Changed" />
                        </StackPanel>
                    </Border>

                    <controls:OutputFolderCard x:Name="OutputCard" Header="{DynamicResource Str_AsciiVideo_SaveTo}" HeaderIcon="ContentSaveOutline" ToolName="ASCII Video" />
                </StackPanel>
            </controls:ToolSidebar>

            <!--  ================= MAIN AREA =================  -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Always visible: the user's own responsibility  -->
                <Border Grid.Row="0" Margin="0,0,0,14" Padding="14,10" Background="{DynamicResource StatusWarningBg}" CornerRadius="12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <materialDesign:PackIcon Width="18" Height="18" Margin="0,1,10,0" VerticalAlignment="Top" Foreground="{DynamicResource StatusWarningFg}" Kind="AlertOutline" />
                        <TextBlock Grid.Column="1" FontSize="12" Foreground="{DynamicResource StatusWarningFg}" Text="{DynamicResource Str_AsciiVideo_Disclaimer}" TextWrapping="Wrap" />
                    </Grid>
                </Border>

                <!--  Run bar  -->
                <Border Grid.Row="1" Margin="0,0,0,14" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button ctl:Tour.Key="Str_Tour_AsciiVideo_Run" ctl:Tour.Order="4" x:Name="BtnStart" MinWidth="190" VerticalAlignment="Center" Click="BtnStart_Click" Style="{StaticResource AccentPrimaryButtonStyle}">
                            <Grid HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon x:Name="IconStart" Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center" Kind="MovieFilterOutline" />
                                <TextBlock x:Name="TxtStart" Grid.Column="1" VerticalAlignment="Center" TextWrapping="Wrap" />
                            </Grid>
                        </Button>
                        <StackPanel Grid.Column="1" Margin="16,0,0,0" VerticalAlignment="Center">
                            <ProgressBar x:Name="Bar" Height="8" Maximum="100" />
                            <TextBlock x:Name="TxtProgress" Margin="0,6,0,0" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <TextBlock x:Name="TxtPercent" Grid.Column="2" MinWidth="54" Margin="16,0,0,0" VerticalAlignment="Center" FontSize="20" FontWeight="Bold" Foreground="{DynamicResource AccentColor}" TextAlignment="Right" />
                    </Grid>
                </Border>

                <!--  Preview and result  -->
                <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid Margin="0,0,0,10">
                            <ContentControl VerticalAlignment="Center" Content="{DynamicResource Str_AsciiVideo_Preview}" Style="{StaticResource CardHeader}" Tag="{x:Static materialDesign:PackIconKind.Eye}" />
                            <Button x:Name="BtnPreview" HorizontalAlignment="Right" Click="BtnPreview_Click" Style="{StaticResource NeutralIconButtonStyle}" ToolTip="{DynamicResource Str_AsciiVideo_PreviewTip}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center" Kind="ImageSearchOutline" />
                                    <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_AsciiVideo_PreviewButton}" />
                                </StackPanel>
                            </Button>
                        </Grid>

                        <Border x:Name="StatusBanner" Grid.Row="1" Margin="0,0,0,10" Padding="10,8" CornerRadius="8" Visibility="Collapsed">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon x:Name="StatusIcon" Width="14" Height="14" Margin="0,1,8,0" VerticalAlignment="Top" Kind="AlertOutline" />
                                <TextBlock x:Name="TxtStatus" Grid.Column="1" FontSize="11.5" TextWrapping="Wrap" />
                            </Grid>
                        </Border>

                        <!--  The frame is drawn as text in a fixed-width font, scaled to fit. While a frame shows, the code paints it in the video's own black / white.  -->
                        <Border x:Name="PreviewHost" Grid.Row="2" Padding="8" Background="{DynamicResource RowBg}" CornerRadius="10">
                            <Grid>
                                <Viewbox Stretch="Uniform">
                                    <TextBlock x:Name="TxtPreview" FontFamily="Consolas" FontSize="10" TextWrapping="NoWrap" />
                                </Viewbox>
                                <StackPanel x:Name="EmptyState" MaxWidth="380" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.MovieFilterOutline}" />
                                    <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource Str_AsciiVideo_EmptyTitle}" />
                                    <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource Str_AsciiVideo_EmptyHint}" TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>

                        <ItemsControl x:Name="ListOutputs" Grid.Row="3" Margin="0,10,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,0,6" Padding="10,6" Background="{DynamicResource RowBg}" CornerRadius="8">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextPrimary}" Text="{Binding}" TextTrimming="CharacterEllipsis" ToolTip="{Binding}" />
                                            <StackPanel Grid.Column="1" Orientation="Horizontal">
                                                <Button Margin="6,0,4,0" Padding="0" Click="BtnOpenOutput_Click" Style="{StaticResource ListToolButtonStyle}" Tag="{Binding}" ToolTip="{DynamicResource Str_AsciiVideo_OpenTip}">
                                                    <materialDesign:PackIcon Width="16" Height="16" Kind="PlayCircleOutline" />
                                                </Button>
                                                <Button Padding="0" Click="BtnShowOutput_Click" Style="{StaticResource ListToolButtonStyle}" Tag="{Binding}" ToolTip="{DynamicResource Str_AsciiVideo_ShowTip}">
                                                    <materialDesign:PackIcon Width="16" Height="16" Kind="FolderOpenOutline" />
                                                </Button>
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
