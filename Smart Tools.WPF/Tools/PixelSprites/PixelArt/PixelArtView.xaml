<UserControl
    x:Class="Smart_Tools.WPF.Views.PixelArtView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:models="clr-namespace:Smart_Tools.WPF.Models"
    x:Name="Root"
    Focusable="True"
    Loaded="Root_Loaded"
    PreviewKeyDown="Root_PreviewKeyDown"
    Unloaded="Root_Unloaded">

    <!--
        Backend: Controllers/PixelArtManager.cs (drawing, undo, frames), .Export.cs (colours, palettes, PNG, settings),
        .Render.cs (WPF pictures). Canvas: Controls/PixelCanvasControl.cs. UI only here.
    -->

    <UserControl.Resources>
        <Style x:Key="PxSideLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarText}" />
            <Setter Property="Margin" Value="2,10,0,4" />
        </Style>

        <Style x:Key="PxSideHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextMuted}" />
            <Setter Property="Margin" Value="2,6,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="PxPillText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>

        <!--  A palette colour. The data colour is the swatch itself, so it is the one allowed fixed colour.  -->
        <DataTemplate x:Key="SwatchTemplate" DataType="{x:Type models:PixelArtSwatch}">
            <Button
                Width="24"
                Height="24"
                Margin="0,0,4,4"
                Click="Swatch_Click"
                Cursor="Hand"
                FocusVisualStyle="{x:Null}"
                MouseRightButtonUp="Swatch_RightClick"
                Tag="{Binding}"
                ToolTip="{Binding Hex}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Ring"
                            BorderBrush="{DynamicResource SidebarInputBorder}"
                            BorderThickness="1"
                            CornerRadius="6">
                            <Border
                                Margin="2"
                                Background="{Binding Brush}"
                                CornerRadius="4" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                                <Setter TargetName="Ring" Property="BorderThickness" Value="2" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Ring" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

        <!--  A frame in the strip  -->
        <DataTemplate x:Key="FrameTemplate" DataType="{x:Type models:PixelArtFrameItem}">
            <Button
                Height="Auto"
                MinHeight="0"
                Margin="0,0,8,0"
                Padding="0"
                Click="Frame_Click"
                Cursor="Hand"
                FocusVisualStyle="{x:Null}"
                Tag="{Binding}">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Width="64"
                            Padding="4"
                            Background="{DynamicResource RowBg}"
                            BorderBrush="{DynamicResource CardBorder}"
                            BorderThickness="2"
                            CornerRadius="8">
                            <StackPanel>
                                <Border
                                    Width="54"
                                    Height="54"
                                    Background="{DynamicResource InputBg}"
                                    CornerRadius="4">
                                    <Image
                                        RenderOptions.BitmapScalingMode="NearestNeighbor"
                                        Source="{Binding Thumbnail}"
                                        Stretch="Uniform" />
                                </Border>
                                <TextBlock
                                    Margin="0,3,0,0"
                                    HorizontalAlignment="Center"
                                    FontSize="10.5"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{Binding Number}" />
                            </StackPanel>
                        </Border>
                        <ControlTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsCurrent}" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                            </DataTrigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColorHover}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
        </DataTemplate>

    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">

        <!--  No page header: MainWindow's header card shows the tool's icon and name.  -->

        <Grid Margin="16,8,16,16">

            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OptionsColumn" Width="280" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= OPTIONS SIDEBAR =================  -->

            <Border Grid.Column="0" Style="{StaticResource SidebarPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Button
                            x:Name="BtnCollapseOptions"
                            MinHeight="45"
                            HorizontalContentAlignment="Left"
                            Click="BtnCollapseOptions_Click"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Foreground="{DynamicResource SidebarText}"
                            ToolTip="{DynamicResource Str_Common_SidebarToggleTooltip}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="OverridesDefaultStyle" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Margin="16,0,0,0" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Kind="TuneVariant" />
                                <TextBlock
                                    x:Name="TxtOptionsHeaderLabel"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{DynamicResource Str_Common_OptionsLabel}" />
                            </StackPanel>
                        </Button>
                        <Separator
                            x:Name="SepHeader"
                            Margin="16,4"
                            Style="{StaticResource SidebarSeparatorStyle}" />
                    </StackPanel>

                    <ScrollViewer
                        x:Name="OptionsScrollViewer"
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16,4,16,16">

                            <!--  ============ COLOUR ============  -->
                            <Border
                                ctl:Tour.Key="Str_Tour_PixelArt_Color"
                                ctl:Tour.Order="2"
                                Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_PixelArt_ColorHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.PaletteOutline}" />
                                    <!--  Colour mixer: saturation (x) and brightness (y), hue, opacity. The cursors are fixed ring overlays, readable on any colour.  -->
                                    <Border
                                        Height="120"
                                        Margin="0,0,0,10"
                                        BorderBrush="{DynamicResource SidebarInputBorder}"
                                        BorderThickness="1"
                                        CornerRadius="8">
                                        <Grid
                                            x:Name="SvArea"
                                            Background="Transparent"
                                            ClipToBounds="True"
                                            Cursor="Cross"
                                            LostMouseCapture="PickerArea_LostMouseCapture"
                                            MouseLeftButtonDown="SvArea_MouseLeftButtonDown"
                                            MouseLeftButtonUp="PickerArea_MouseLeftButtonUp"
                                            MouseMove="SvArea_MouseMove"
                                            SizeChanged="PickerArea_SizeChanged"
                                            ToolTip="{DynamicResource Str_PixelArt_SvTip}">
                                            <Border x:Name="SvHueLayer" CornerRadius="7" />
                                            <Border CornerRadius="7">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                        <GradientStop Offset="0" Color="#FFFFFFFF" />
                                                        <GradientStop Offset="1" Color="#00FFFFFF" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Border CornerRadius="7">
                                                <Border.Background>
                                                    <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                        <GradientStop Offset="0" Color="#00000000" />
                                                        <GradientStop Offset="1" Color="#FF000000" />
                                                    </LinearGradientBrush>
                                                </Border.Background>
                                            </Border>
                                            <Grid
                                                x:Name="SvCursor"
                                                Width="16"
                                                Height="16"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                IsHitTestVisible="False">
                                                <Ellipse Stroke="#66000000" StrokeThickness="4" />
                                                <Ellipse
                                                    Margin="1"
                                                    Stroke="White"
                                                    StrokeThickness="2.5" />
                                            </Grid>
                                        </Grid>
                                    </Border>
                                    <Grid
                                        x:Name="HueArea"
                                        Height="16"
                                        Background="Transparent"
                                        Cursor="Hand"
                                        LostMouseCapture="PickerArea_LostMouseCapture"
                                        MouseLeftButtonDown="HueArea_MouseLeftButtonDown"
                                        MouseLeftButtonUp="PickerArea_MouseLeftButtonUp"
                                        MouseMove="HueArea_MouseMove"
                                        SizeChanged="PickerArea_SizeChanged"
                                        ToolTip="{DynamicResource Str_PixelArt_HueTip}">
                                        <Border CornerRadius="8">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop Offset="0.000" Color="#FF0000" />
                                                    <GradientStop Offset="0.167" Color="#FFFF00" />
                                                    <GradientStop Offset="0.333" Color="#00FF00" />
                                                    <GradientStop Offset="0.500" Color="#00FFFF" />
                                                    <GradientStop Offset="0.667" Color="#0000FF" />
                                                    <GradientStop Offset="0.833" Color="#FF00FF" />
                                                    <GradientStop Offset="1.000" Color="#FF0000" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Grid
                                            x:Name="HueCursor"
                                            Width="12"
                                            Height="22"
                                            Margin="0,-3,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            IsHitTestVisible="False">
                                            <Border
                                                BorderBrush="#66000000"
                                                BorderThickness="3"
                                                CornerRadius="6" />
                                            <Border
                                                Margin="1"
                                                BorderBrush="White"
                                                BorderThickness="2.5"
                                                CornerRadius="5" />
                                        </Grid>
                                    </Grid>
                                    <Grid
                                        x:Name="AlphaArea"
                                        Height="16"
                                        Margin="0,10,0,10"
                                        Background="Transparent"
                                        Cursor="Hand"
                                        LostMouseCapture="PickerArea_LostMouseCapture"
                                        MouseLeftButtonDown="AlphaArea_MouseLeftButtonDown"
                                        MouseLeftButtonUp="PickerArea_MouseLeftButtonUp"
                                        MouseMove="AlphaArea_MouseMove"
                                        SizeChanged="PickerArea_SizeChanged"
                                        ToolTip="{DynamicResource Str_PixelArt_AlphaTip}">
                                        <Border CornerRadius="8">
                                            <Border.Background>
                                                <DrawingBrush
                                                    TileMode="Tile"
                                                    Viewport="0,0,12,12"
                                                    ViewportUnits="Absolute">
                                                    <DrawingBrush.Drawing>
                                                        <DrawingGroup>
                                                            <GeometryDrawing Brush="{DynamicResource CheckerLight}">
                                                                <GeometryDrawing.Geometry>
                                                                    <RectangleGeometry Rect="0,0,12,12" />
                                                                </GeometryDrawing.Geometry>
                                                            </GeometryDrawing>
                                                            <GeometryDrawing Brush="{DynamicResource CheckerDark}">
                                                                <GeometryDrawing.Geometry>
                                                                    <GeometryGroup>
                                                                        <RectangleGeometry Rect="0,0,6,6" />
                                                                        <RectangleGeometry Rect="6,6,6,6" />
                                                                    </GeometryGroup>
                                                                </GeometryDrawing.Geometry>
                                                            </GeometryDrawing>
                                                        </DrawingGroup>
                                                    </DrawingBrush.Drawing>
                                                </DrawingBrush>
                                            </Border.Background>
                                        </Border>
                                        <Border CornerRadius="8">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,0">
                                                    <GradientStop x:Name="AlphaStart" Offset="0" Color="#00FF004D" />
                                                    <GradientStop x:Name="AlphaEnd" Offset="1" Color="#FFFF004D" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <Grid
                                            x:Name="AlphaCursor"
                                            Width="12"
                                            Height="22"
                                            Margin="0,-3,0,0"
                                            HorizontalAlignment="Left"
                                            VerticalAlignment="Top"
                                            IsHitTestVisible="False">
                                            <Border
                                                BorderBrush="#66000000"
                                                BorderThickness="3"
                                                CornerRadius="6" />
                                            <Border
                                                Margin="1"
                                                BorderBrush="White"
                                                BorderThickness="2.5"
                                                CornerRadius="5" />
                                        </Grid>
                                    </Grid>

                                    <Border x:Name="ColorBar" Style="{StaticResource InputBarStyle}">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border
                                                x:Name="CurrentColorSwatch"
                                                Width="22"
                                                Height="22"
                                                Margin="8,0,0,0"
                                                VerticalAlignment="Center"
                                                BorderBrush="{DynamicResource SidebarInputBorder}"
                                                BorderThickness="1"
                                                CornerRadius="11" />
                                            <TextBox
                                                x:Name="TxtColorHex"
                                                Grid.Column="1"
                                                VerticalContentAlignment="Center"
                                                FontFamily="Cascadia Mono, Consolas"
                                                LostFocus="TxtColorHex_LostFocus"
                                                Style="{StaticResource BareTextBox}"
                                                Tag="#RRGGBB"
                                                TextChanged="TxtColorHex_TextChanged" />
                                        </Grid>
                                    </Border>
                                    <TextBlock
                                        x:Name="TxtColorError"
                                        Margin="2,4,0,0"
                                        FontSize="10.5"
                                        Foreground="{DynamicResource StatusErrorFg}"
                                        Text="{DynamicResource Str_PixelArt_ColorBad}"
                                        TextWrapping="Wrap"
                                        Visibility="Collapsed" />

                                    <TextBlock Style="{StaticResource PxSideLabel}" Text="{DynamicResource Str_PixelArt_PaletteLabel}" />
                                    <Border Style="{StaticResource InputBarStyle}">
                                        <ComboBox
                                            x:Name="CmbPalette"
                                            VerticalContentAlignment="Center"
                                            SelectionChanged="CmbPalette_SelectionChanged"
                                            Style="{StaticResource BareComboBox}" />
                                    </Border>
                                    <ItemsControl
                                        x:Name="PaletteList"
                                        Margin="0,10,0,0"
                                        ItemTemplate="{StaticResource SwatchTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <WrapPanel />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                    <Button
                                        x:Name="BtnAddColor"
                                        Margin="0,4,0,0"
                                        Click="BtnAddColor_Click"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        ToolTip="{DynamicResource Str_PixelArt_AddColorTip}">
                                        <Grid HorizontalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon
                                                Grid.Column="0"
                                                Width="16"
                                                Height="16"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Kind="PlusCircleOutline" />
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Text="{DynamicResource Str_PixelArt_AddColor}"
                                                TextWrapping="Wrap" />
                                        </Grid>
                                    </Button>
                                    <TextBlock x:Name="TxtPaletteHint" Style="{StaticResource PxSideHint}" />
                                </StackPanel>
                            </Border>

                            <!--  ============ BRUSH ============  -->
                            <Border
                                ctl:Tour.Key="Str_Tour_PixelArt_Brush"
                                ctl:Tour.Order="3"
                                Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_PixelArt_BrushHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.Brush}" />
                                    <TextBlock
                                        Margin="2,0,0,4"
                                        FontSize="11"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource SidebarText}"
                                        Text="{DynamicResource Str_PixelArt_BrushSize}" />
                                    <UniformGrid Columns="4">
                                        <RadioButton
                                            x:Name="RadioBrush1"
                                            Margin="0,0,2,0"
                                            Click="Brush_Click"
                                            Content="1"
                                            GroupName="PxBrush"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="1" />
                                        <RadioButton
                                            x:Name="RadioBrush2"
                                            Margin="2,0"
                                            Click="Brush_Click"
                                            Content="2"
                                            GroupName="PxBrush"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="2" />
                                        <RadioButton
                                            x:Name="RadioBrush3"
                                            Margin="2,0"
                                            Click="Brush_Click"
                                            Content="3"
                                            GroupName="PxBrush"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="3" />
                                        <RadioButton
                                            x:Name="RadioBrush4"
                                            Margin="2,0,0,0"
                                            Click="Brush_Click"
                                            Content="4"
                                            GroupName="PxBrush"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="4" />
                                    </UniformGrid>

                                    <TextBlock Style="{StaticResource PxSideLabel}" Text="{DynamicResource Str_PixelArt_Mirror}" />
                                    <UniformGrid Columns="2">
                                        <RadioButton
                                            x:Name="RadioSymNone"
                                            Margin="0,0,2,4"
                                            Click="Symmetry_Click"
                                            Content="{DynamicResource Str_PixelArt_SymNone}"
                                            GroupName="PxSym"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="None" />
                                        <RadioButton
                                            x:Name="RadioSymBoth"
                                            Margin="2,0,0,4"
                                            Click="Symmetry_Click"
                                            Content="{DynamicResource Str_PixelArt_SymBoth}"
                                            GroupName="PxSym"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="Both" />
                                        <RadioButton
                                            x:Name="RadioSymH"
                                            Margin="0,0,2,0"
                                            Click="Symmetry_Click"
                                            Content="{DynamicResource Str_PixelArt_SymH}"
                                            GroupName="PxSym"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="Horizontal" />
                                        <RadioButton
                                            x:Name="RadioSymV"
                                            Margin="2,0,0,0"
                                            Click="Symmetry_Click"
                                            Content="{DynamicResource Str_PixelArt_SymV}"
                                            GroupName="PxSym"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="Vertical" />
                                    </UniformGrid>

                                    <CheckBox
                                        x:Name="ChkFilled"
                                        Margin="0,12,0,0"
                                        Click="Option_Click"
                                        Foreground="{DynamicResource SidebarText}">
                                        <TextBlock Text="{DynamicResource Str_PixelArt_Filled}" TextWrapping="Wrap" />
                                    </CheckBox>
                                </StackPanel>
                            </Border>

                            <!--  ============ CANVAS ============  -->
                            <Border
                                ctl:Tour.Key="Str_Tour_PixelArt_Canvas"
                                ctl:Tour.Order="4"
                                Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_PixelArt_CanvasHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.GridLarge}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="8" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel>
                                            <TextBlock
                                                Margin="2,0,0,4"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource SidebarText}"
                                                Text="{DynamicResource Str_Common_WidthPx}" />
                                            <Border Style="{StaticResource InputBarStyle}">
                                                <TextBox
                                                    x:Name="TxtNewWidth"
                                                    VerticalContentAlignment="Center"
                                                    Style="{StaticResource BareTextBox}"
                                                    Text="32"
                                                    TextChanged="TxtSize_TextChanged" />
                                            </Border>
                                        </StackPanel>
                                        <StackPanel Grid.Column="2">
                                            <TextBlock
                                                Margin="2,0,0,4"
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource SidebarText}"
                                                Text="{DynamicResource Str_Common_HeightPx}" />
                                            <Border Style="{StaticResource InputBarStyle}">
                                                <TextBox
                                                    x:Name="TxtNewHeight"
                                                    VerticalContentAlignment="Center"
                                                    Style="{StaticResource BareTextBox}"
                                                    Text="32"
                                                    TextChanged="TxtSize_TextChanged" />
                                            </Border>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock Style="{StaticResource PxSideLabel}" Text="{DynamicResource Str_PixelArt_SizePresetLabel}" />
                                    <controls:PresetChips Columns="3" Items="16 × 16:16;32 × 32:32;64 × 64:64;128 × 128:128;256 × 256:256" PresetChosen="SizePreset_Chosen" />
                                    <TextBlock
                                        x:Name="TxtSizeError"
                                        Margin="2,0,0,4"
                                        FontSize="10.5"
                                        Foreground="{DynamicResource StatusErrorFg}"
                                        Text="{DynamicResource Str_PixelArt_SizeBad}"
                                        TextWrapping="Wrap"
                                        Visibility="Collapsed" />

                                    <Button
                                        x:Name="BtnNewCanvas"
                                        Margin="0,4,0,0"
                                        Click="BtnNewCanvas_Click"
                                        Style="{StaticResource PrimaryButtonStyle}">
                                        <Grid HorizontalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon
                                                Grid.Column="0"
                                                Width="16"
                                                Height="16"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Kind="FilePlusOutline" />
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Text="{DynamicResource Str_PixelArt_NewCanvas}"
                                                TextWrapping="Wrap" />
                                        </Grid>
                                    </Button>

                                    <TextBlock Style="{StaticResource PxSideLabel}" Text="{DynamicResource Str_PixelArt_ResizeLabel}" />
                                    <UniformGrid Columns="2">
                                        <RadioButton
                                            x:Name="RadioAnchorTopLeft"
                                            Margin="0,0,2,0"
                                            Content="{DynamicResource Str_PixelArt_AnchorTopLeft}"
                                            GroupName="PxAnchor"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleButtonStyle}" />
                                        <RadioButton
                                            x:Name="RadioAnchorCenter"
                                            Margin="2,0,0,0"
                                            Content="{DynamicResource Str_PixelArt_AnchorCenter}"
                                            GroupName="PxAnchor"
                                            Style="{StaticResource ModeToggleButtonStyle}" />
                                    </UniformGrid>
                                    <Button
                                        x:Name="BtnResizeCanvas"
                                        Margin="0,8,0,0"
                                        Click="BtnResizeCanvas_Click"
                                        Style="{StaticResource PrimaryButtonStyle}">
                                        <Grid HorizontalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon
                                                Grid.Column="0"
                                                Width="16"
                                                Height="16"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Kind="ResizeBottomRight" />
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Text="{DynamicResource Str_PixelArt_ResizeCanvas}"
                                                TextWrapping="Wrap" />
                                        </Grid>
                                    </Button>
                                    <TextBlock Style="{StaticResource PxSideHint}" Text="{DynamicResource Str_PixelArt_CanvasHint}" />

                                    <Separator Margin="0,12" Style="{StaticResource SidebarSeparatorStyle}" />
                                    <Button
                                        x:Name="BtnOpenImage"
                                        Click="BtnOpenImage_Click"
                                        Style="{StaticResource PrimaryButtonStyle}"
                                        ToolTip="{DynamicResource Str_PixelArt_OpenImageTip}">
                                        <Grid HorizontalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon
                                                Grid.Column="0"
                                                Width="16"
                                                Height="16"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Kind="FolderOpenOutline" />
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                Text="{DynamicResource Str_PixelArt_OpenImage}"
                                                TextWrapping="Wrap" />
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!--  ============ VIEW ============  -->
                            <Border Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_PixelArt_ViewHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.EyeOutline}" />
                                    <CheckBox
                                        x:Name="ChkGrid"
                                        Click="ViewOption_Click"
                                        Foreground="{DynamicResource SidebarText}"
                                        IsChecked="True">
                                        <TextBlock Text="{DynamicResource Str_PixelArt_ShowGrid}" TextWrapping="Wrap" />
                                    </CheckBox>
                                    <TextBlock Style="{StaticResource PxSideHint}" Text="{DynamicResource Str_PixelArt_GridHint}" />
                                    <CheckBox
                                        x:Name="ChkOnion"
                                        Margin="0,10,0,0"
                                        Click="ViewOption_Click"
                                        Foreground="{DynamicResource SidebarText}">
                                        <TextBlock Text="{DynamicResource Str_PixelArt_OnionSkin}" TextWrapping="Wrap" />
                                    </CheckBox>
                                    <TextBlock Style="{StaticResource PxSideHint}" Text="{DynamicResource Str_PixelArt_OnionHint}" />
                                </StackPanel>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--  ================= MAIN =================  -->

            <Border
                Grid.Column="2"
                ctl:Tour.Key="Str_Tour_PixelArt_Drawing"
                ctl:Tour.Order="5"
                Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" MinHeight="220" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Header: title, stats, saved pill  -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentControl
                            VerticalAlignment="Center"
                            Content="{DynamicResource Str_PixelArt_CanvasCard}"
                            Style="{StaticResource CardHeader}"
                            Tag="{x:Static materialDesign:PackIconKind.GridLarge}" />
                        <WrapPanel
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">
                            <Border
                                Margin="0,0,6,0"
                                Background="{DynamicResource RowBg}"
                                Style="{StaticResource IconStatusPillStyle}">
                                <TextBlock x:Name="TxtPillSize" Style="{StaticResource PxPillText}" />
                            </Border>
                            <Border
                                Margin="0,0,6,0"
                                Background="{DynamicResource RowBg}"
                                Style="{StaticResource IconStatusPillStyle}">
                                <TextBlock x:Name="TxtPillZoom" Style="{StaticResource PxPillText}" />
                            </Border>
                            <Border
                                x:Name="PillCursor"
                                Background="{DynamicResource RowBg}"
                                Style="{StaticResource IconStatusPillStyle}"
                                Visibility="Collapsed">
                                <TextBlock
                                    x:Name="TxtPillCursor"
                                    FontFamily="Cascadia Mono, Consolas"
                                    Style="{StaticResource PxPillText}" />
                            </Border>
                        </WrapPanel>
                        <Border
                            x:Name="DonePill"
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            Background="{DynamicResource StatusSuccessBg}"
                            Style="{StaticResource IconStatusPillStyle}"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="13"
                                    Height="13"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource StatusSuccessFg}"
                                    Kind="Check" />
                                <TextBlock
                                    x:Name="TxtDonePill"
                                    FontSize="11.5"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource StatusSuccessFg}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!--  Tools (left) and toolbar (right)  -->
                    <Grid Grid.Row="1" Margin="0,0,0,10">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <WrapPanel
                            VerticalAlignment="Top"
                            ctl:Tour.Key="Str_Tour_PixelArt_Tools"
                            ctl:Tour.Order="1">
                            <RadioButton
                                x:Name="RadioToolPencil"
                                Width="40"
                                Height="34"
                                Margin="0,0,4,4"
                                Click="Tool_Click"
                                GroupName="PxTool"
                                IsChecked="True"
                                Style="{StaticResource ModeToggleButtonStyle}"
                                Tag="Pencil"
                                ToolTip="{DynamicResource Str_PixelArt_ToolPencil}">
                                <materialDesign:PackIcon
                                    Width="18"
                                    Height="18"
                                    HorizontalAlignment="Center"
                                    Kind="PencilOutline" />
                            </RadioButton>
                            <RadioButton
                                x:Name="RadioToolEraser"
                                Width="40"
                                Height="34"
                                Margin="0,0,4,4"
                                Click="Tool_Click"
                                GroupName="PxTool"
                                Style="{StaticResource ModeToggleButtonStyle}"
                                Tag="Eraser"
                                ToolTip="{DynamicResource Str_PixelArt_ToolEraser}">
                                <materialDesign:PackIcon
                                    Width="18"
                                    Height="18"
                                    HorizontalAlignment="Center"
                                    Kind="Eraser" />
                            </RadioButton>
                            <RadioButton
                                x:Name="RadioToolFill"
                                Width="40"
                                Height="34"
                                Margin="0,0,4,4"
                                Click="Tool_Click"
                                GroupName="PxTool"
                                Style="{StaticResource ModeToggleButtonStyle}"
                                Tag="Fill"
                                ToolTip="{DynamicResource Str_PixelArt_ToolFill}">
                                <materialDesign:PackIcon
                                    Width="18"
                                    Height="18"
                                    HorizontalAlignment="Center"
                                    Kind="FormatColorFill" />
                            </RadioButton>
                            <RadioButton
                                x:Name="RadioToolPicker"
                                Width="40"
                                Height="34"
                                Margin="0,0,4,4"
                                Click="Tool_Click"
                                GroupName="PxTool"
                                Style="{StaticResource ModeToggleButtonStyle}"
                                Tag="Picker"
                                ToolTip="{DynamicResource Str_PixelArt_ToolPicker}">
                                <materialDesign:PackIcon
                                    Width="18"
                                    Height="18"
                                    HorizontalAlignment="Center"
                                    Kind="Eyedropper" />
                            </RadioButton>
                            <RadioButton
                                x:Name="RadioToolLine"
                                Width="40"
                                Height="34"
                                Margin="0,0,4,4"
                                Click="Tool_Click"
                                GroupName="PxTool"
                                Style="{StaticResource ModeToggleButtonStyle}"
                                Tag="Line"
                                ToolTip="{DynamicResource Str_PixelArt_ToolLine}">
                                <materialDesign:PackIcon
                                    Width="18"
                                    Height="18"
                                    HorizontalAlignment="Center"
                                    Kind="VectorLine" />
                            </RadioButton>
                            <RadioButton
                                x:Name="RadioToolRectangle"
                                Width="40"
                                Height="34"
                                Margin="0,0,4,4"
                                Click="Tool_Click"
                                GroupName="PxTool"
                                Style="{StaticResource ModeToggleButtonStyle}"
                                Tag="Rectangle"
                                ToolTip="{DynamicResource Str_PixelArt_ToolRectangle}">
                                <materialDesign:PackIcon
                                    Width="18"
                                    Height="18"
                                    HorizontalAlignment="Center"
                                    Kind="RectangleOutline" />
                            </RadioButton>
                            <RadioButton
                                x:Name="RadioToolEllipse"
                                Width="40"
                                Height="34"
                                Margin="0,0,4,4"
                                Click="Tool_Click"
                                GroupName="PxTool"
                                Style="{StaticResource ModeToggleButtonStyle}"
                                Tag="Ellipse"
                                ToolTip="{DynamicResource Str_PixelArt_ToolEllipse}">
                                <materialDesign:PackIcon
                                    Width="18"
                                    Height="18"
                                    HorizontalAlignment="Center"
                                    Kind="EllipseOutline" />
                            </RadioButton>
                        </WrapPanel>
                        <WrapPanel
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Top">
                        <Button Padding="0"
                            x:Name="BtnUndo"
                            Width="34"
                            Height="34"
                            Margin="0,0,4,4"
                            Click="BtnUndo_Click"
                            Style="{StaticResource NeutralIconButtonStyle}"
                            ToolTip="{DynamicResource Str_PixelArt_Undo}">
                            <materialDesign:PackIcon
                                Width="17"
                                Height="17"
                                Kind="Undo" />
                        </Button>
                        <Button Padding="0"
                            x:Name="BtnRedo"
                            Width="34"
                            Height="34"
                            Margin="0,0,12,4"
                            Click="BtnRedo_Click"
                            Style="{StaticResource NeutralIconButtonStyle}"
                            ToolTip="{DynamicResource Str_PixelArt_Redo}">
                            <materialDesign:PackIcon
                                Width="17"
                                Height="17"
                                Kind="Redo" />
                        </Button>
                        <Button Padding="0"
                            Width="34"
                            Height="34"
                            Margin="0,0,4,4"
                            Click="BtnFlipH_Click"
                            Style="{StaticResource NeutralIconButtonStyle}"
                            ToolTip="{DynamicResource Str_PixelArt_FlipH}">
                            <materialDesign:PackIcon
                                Width="17"
                                Height="17"
                                Kind="FlipHorizontal" />
                        </Button>
                        <Button Padding="0"
                            Width="34"
                            Height="34"
                            Margin="0,0,4,4"
                            Click="BtnFlipV_Click"
                            Style="{StaticResource NeutralIconButtonStyle}"
                            ToolTip="{DynamicResource Str_PixelArt_FlipV}">
                            <materialDesign:PackIcon
                                Width="17"
                                Height="17"
                                Kind="FlipVertical" />
                        </Button>
                        <Button Padding="0"
                            Width="34"
                            Height="34"
                            Margin="0,0,4,4"
                            Click="BtnRotateLeft_Click"
                            Style="{StaticResource NeutralIconButtonStyle}"
                            ToolTip="{DynamicResource Str_PixelArt_RotateLeft}">
                            <materialDesign:PackIcon
                                Width="17"
                                Height="17"
                                Kind="RotateLeft" />
                        </Button>
                        <Button Padding="0"
                            Width="34"
                            Height="34"
                            Margin="0,0,4,4"
                            Click="BtnRotateRight_Click"
                            Style="{StaticResource NeutralIconButtonStyle}"
                            ToolTip="{DynamicResource Str_PixelArt_RotateRight}">
                            <materialDesign:PackIcon
                                Width="17"
                                Height="17"
                                Kind="RotateRight" />
                        </Button>
                        <Button Padding="0"
                            Width="34"
                            Height="34"
                            Margin="0,0,12,4"
                            Click="BtnClearFrame_Click"
                            Style="{StaticResource NeutralIconButtonStyle}"
                            ToolTip="{DynamicResource Str_PixelArt_ClearFrame}">
                            <materialDesign:PackIcon
                                Width="17"
                                Height="17"
                                Kind="DeleteOutline" />
                        </Button>
                        <Button Padding="0"
                            Width="34"
                            Height="34"
                            Margin="0,0,4,4"
                            Click="BtnZoomOut_Click"
                            Style="{StaticResource NeutralIconButtonStyle}"
                            ToolTip="{DynamicResource Str_PixelArt_ZoomOut}">
                            <materialDesign:PackIcon
                                Width="17"
                                Height="17"
                                Kind="MagnifyMinusOutline" />
                        </Button>
                        <Button Padding="0"
                            Width="34"
                            Height="34"
                            Margin="0,0,4,4"
                            Click="BtnZoomIn_Click"
                            Style="{StaticResource NeutralIconButtonStyle}"
                            ToolTip="{DynamicResource Str_PixelArt_ZoomIn}">
                            <materialDesign:PackIcon
                                Width="17"
                                Height="17"
                                Kind="MagnifyPlusOutline" />
                        </Button>
                        <Button Padding="0"
                            Width="34"
                            Height="34"
                            Margin="0,0,0,4"
                            Click="BtnFit_Click"
                            Style="{StaticResource NeutralIconButtonStyle}"
                            ToolTip="{DynamicResource Str_PixelArt_Fit}">
                            <materialDesign:PackIcon
                                Width="17"
                                Height="17"
                                Kind="FitToScreenOutline" />
                        </Button>
                        </WrapPanel>
                        <TextBlock
                            x:Name="TxtToolHint"
                            Grid.Row="1"
                            Grid.ColumnSpan="2"
                            Margin="2,2,0,0"
                            FontSize="11.5"
                            Foreground="{DynamicResource TextSecondary}"
                            TextWrapping="Wrap" />
                    </Grid>

                    <!--  Messages  -->
                    <Border
                        x:Name="StatusBanner"
                        Grid.Row="2"
                        Margin="0,0,0,10"
                        Padding="12,9"
                        HorizontalAlignment="Left"
                        CornerRadius="10"
                        Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon
                                x:Name="StatusIcon"
                                Width="16"
                                Height="16"
                                Margin="0,1,8,0"
                                VerticalAlignment="Top" />
                            <TextBlock
                                x:Name="TxtStatus"
                                MaxWidth="700"
                                FontSize="12.5"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!--  Canvas  -->
                    <Border
                        Grid.Row="3"
                        Background="{DynamicResource RowBg}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <ScrollViewer
                            x:Name="CanvasScroll"
                            HorizontalScrollBarVisibility="Auto"
                            SizeChanged="CanvasScroll_SizeChanged"
                            VerticalScrollBarVisibility="Auto">
                            <Border
                                x:Name="CanvasHost"
                                Margin="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1">
                                <controls:PixelCanvasControl
                                    x:Name="PixelCanvas"
                                    PixelMoved="PixelCanvas_PixelMoved"
                                    PixelPressed="PixelCanvas_PixelPressed"
                                    PixelReleased="PixelCanvas_PixelReleased"
                                    PointerLeft="PixelCanvas_PointerLeft"
                                    ZoomWheel="PixelCanvas_ZoomWheel" />
                            </Border>
                        </ScrollViewer>
                    </Border>

                    <!--  Frames  -->
                    <Border
                        x:Name="FramesCard"
                        Grid.Row="4"
                        Margin="0,12,0,0"
                        Padding="12,10"
                        Background="{DynamicResource RowBg}"
                        CornerRadius="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="15"
                                    Height="15"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource AccentColor}"
                                    Kind="Filmstrip" />
                                <TextBlock
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimary}"
                                    Text="{DynamicResource Str_PixelArt_Frames}" />
                                <TextBlock
                                    x:Name="TxtFrameCount"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="11.5"
                                    Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                            <WrapPanel
                                Grid.Column="1"
                                Margin="0,-4,0,6"
                                HorizontalAlignment="Right">
                                <Button Padding="0"
                                    x:Name="BtnFrameAdd"
                                    Width="30"
                                    Height="30"
                                    Margin="0,0,4,0"
                                    Click="BtnFrameAdd_Click"
                                    Style="{StaticResource NeutralIconButtonStyle}"
                                    ToolTip="{DynamicResource Str_PixelArt_FrameAdd}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="PlusBoxOutline" />
                                </Button>
                                <Button Padding="0"
                                    x:Name="BtnFrameDuplicate"
                                    Width="30"
                                    Height="30"
                                    Margin="0,0,4,0"
                                    Click="BtnFrameDuplicate_Click"
                                    Style="{StaticResource NeutralIconButtonStyle}"
                                    ToolTip="{DynamicResource Str_PixelArt_FrameDuplicate}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="ContentDuplicate" />
                                </Button>
                                <Button Padding="0"
                                    x:Name="BtnFrameLeft"
                                    Width="30"
                                    Height="30"
                                    Margin="0,0,4,0"
                                    Click="BtnFrameLeft_Click"
                                    Style="{StaticResource NeutralIconButtonStyle}"
                                    ToolTip="{DynamicResource Str_PixelArt_FrameLeft}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="ChevronLeft" />
                                </Button>
                                <Button Padding="0"
                                    x:Name="BtnFrameRight"
                                    Width="30"
                                    Height="30"
                                    Margin="0,0,4,0"
                                    Click="BtnFrameRight_Click"
                                    Style="{StaticResource NeutralIconButtonStyle}"
                                    ToolTip="{DynamicResource Str_PixelArt_FrameRight}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="ChevronRight" />
                                </Button>
                                <Button
                                    x:Name="BtnFrameDelete"
                                    Margin="0,0,10,0"
                                    Click="BtnFrameDelete_Click"
                                    Style="{StaticResource ListToolDangerButtonStyle}"
                                    ToolTip="{DynamicResource Str_PixelArt_FrameDelete}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="TrashCanOutline" />
                                </Button>
                                <Button Padding="0"
                                    x:Name="BtnPlay"
                                    Width="30"
                                    Height="30"
                                    Margin="0,0,6,0"
                                    Click="BtnPlay_Click"
                                    Style="{StaticResource NeutralIconButtonStyle}"
                                    ToolTip="{DynamicResource Str_PixelArt_Play}">
                                    <materialDesign:PackIcon
                                        x:Name="IconPlay"
                                        Width="16"
                                        Height="16"
                                        Kind="Play" />
                                </Button>
                                <Border
                                    Width="92"
                                    Height="30"
                                    VerticalAlignment="Center"
                                    Style="{StaticResource InputBarStyle}"
                                    ToolTip="{DynamicResource Str_PixelArt_Fps}">
                                    <ComboBox
                                        x:Name="CmbFps"
                                        VerticalContentAlignment="Center"
                                        SelectionChanged="CmbFps_SelectionChanged"
                                        Style="{StaticResource BareComboBox}">
                                        <ComboBoxItem Content="2 fps" Tag="2" />
                                        <ComboBoxItem Content="4 fps" Tag="4" />
                                        <ComboBoxItem Content="6 fps" Tag="6" />
                                        <ComboBoxItem
                                            Content="8 fps"
                                            IsSelected="True"
                                            Tag="8" />
                                        <ComboBoxItem Content="12 fps" Tag="12" />
                                        <ComboBoxItem Content="16 fps" Tag="16" />
                                        <ComboBoxItem Content="24 fps" Tag="24" />
                                    </ComboBox>
                                </Border>
                            </WrapPanel>
                            <Grid Grid.Row="1" Grid.ColumnSpan="2">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                                    <ItemsControl x:Name="FramesList" ItemTemplate="{StaticResource FrameTemplate}">
                                        <ItemsControl.ItemsPanel>
                                            <ItemsPanelTemplate>
                                                <StackPanel Orientation="Horizontal" />
                                            </ItemsPanelTemplate>
                                        </ItemsControl.ItemsPanel>
                                    </ItemsControl>
                                </ScrollViewer>
                                <Border
                                    Grid.Column="1"
                                    Width="84"
                                    Height="84"
                                    Margin="12,0,0,0"
                                    VerticalAlignment="Top"
                                    Background="{DynamicResource InputBg}"
                                    BorderBrush="{DynamicResource CardBorder}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    ToolTip="{DynamicResource Str_PixelArt_Preview}">
                                    <Image
                                        x:Name="PreviewImage"
                                        Margin="4"
                                        RenderOptions.BitmapScalingMode="NearestNeighbor"
                                        Stretch="Uniform" />
                                </Border>
                            </Grid>
                        </Grid>
                    </Border>

                    <!--  Export  -->
                    <Border Grid.Row="5" Margin="0,12,0,0">
                        <Grid x:Name="ExportRow" SizeChanged="ExportRow_SizeChanged">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <WrapPanel VerticalAlignment="Center">
                                <TextBlock
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimary}"
                                    Text="{DynamicResource Str_PixelArt_ExportScale}" />
                                <UniformGrid
                                    Width="270"
                                    Margin="0,0,12,0"
                                    Columns="5">
                                    <RadioButton
                                        x:Name="RadioScale1"
                                        Margin="0,0,2,0"
                                        Click="ExportOption_Click"
                                        Content="1×"
                                        GroupName="PxScale"
                                        Style="{StaticResource ModeToggleButtonStyle}"
                                        Tag="1" />
                                    <RadioButton
                                        x:Name="RadioScale2"
                                        Margin="2,0"
                                        Click="ExportOption_Click"
                                        Content="2×"
                                        GroupName="PxScale"
                                        Style="{StaticResource ModeToggleButtonStyle}"
                                        Tag="2" />
                                    <RadioButton
                                        x:Name="RadioScale4"
                                        Margin="2,0"
                                        Click="ExportOption_Click"
                                        Content="4×"
                                        GroupName="PxScale"
                                        Style="{StaticResource ModeToggleButtonStyle}"
                                        Tag="4" />
                                    <RadioButton
                                        x:Name="RadioScale8"
                                        Margin="2,0"
                                        Click="ExportOption_Click"
                                        Content="8×"
                                        GroupName="PxScale"
                                        IsChecked="True"
                                        Style="{StaticResource ModeToggleButtonStyle}"
                                        Tag="8" />
                                    <RadioButton
                                        x:Name="RadioScale16"
                                        Margin="2,0,0,0"
                                        Click="ExportOption_Click"
                                        Content="16×"
                                        GroupName="PxScale"
                                        Style="{StaticResource ModeToggleButtonStyle}"
                                        Tag="16" />
                                </UniformGrid>
                                <CheckBox
                                    x:Name="ChkSheet"
                                    Margin="0,0,10,0"
                                    VerticalAlignment="Center"
                                    Click="ExportOption_Click"
                                    Foreground="{DynamicResource TextPrimary}">
                                    <TextBlock Text="{DynamicResource Str_PixelArt_Sheet}" />
                                </CheckBox>
                                <StackPanel
                                    x:Name="ColumnsPanel"
                                    Margin="0,0,12,0"
                                    VerticalAlignment="Center"
                                    Orientation="Horizontal"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Text="{DynamicResource Str_PixelArt_Columns}" />
                                    <Border
                                        Width="92"
                                        Height="30"
                                        Style="{StaticResource InputBarStyle}">
                                        <TextBox
                                            x:Name="TxtColumns"
                                            VerticalContentAlignment="Center"
                                            Style="{StaticResource BareTextBox}"
                                            Text="1"
                                            TextChanged="ExportOption_TextChanged" />
                                    </Border>
                                </StackPanel>
                                <TextBlock
                                    x:Name="TxtExportInfo"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextSecondary}" />
                            </WrapPanel>
                            <StackPanel
                                x:Name="ExportActions"
                                Grid.Column="1"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Orientation="Horizontal">
                                <Button
                                    x:Name="BtnCopyImage"
                                    Margin="0,0,8,0"
                                    Click="BtnCopyImage_Click"
                                    Style="{StaticResource ListToolButtonStyle}"
                                    ToolTip="{DynamicResource Str_PixelArt_CopyImage}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="ContentCopy" />
                                </Button>
                                <controls:ExportButton x:Name="BtnExport">
                                    <Button.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Click="MenuExportPng_Click" Header="{DynamicResource Str_PixelArt_ExportPng}">
                                                <MenuItem.Icon>
                                                    <materialDesign:PackIcon Kind="FileImageOutline" />
                                                </MenuItem.Icon>
                                            </MenuItem>
                                        </ContextMenu>
                                    </Button.ContextMenu>
                                </controls:ExportButton>
                            </StackPanel>
                        </Grid>
                    </Border>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
