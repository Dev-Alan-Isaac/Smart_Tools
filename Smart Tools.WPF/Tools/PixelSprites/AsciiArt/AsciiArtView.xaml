<UserControl
    x:Class="Smart_Tools.WPF.Views.AsciiArtView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:models="clr-namespace:Smart_Tools.WPF.Models"
    x:Name="Root"
    AllowDrop="True"
    DragOver="Root_DragOver"
    Drop="Root_Drop"
    Focusable="True"
    Loaded="Root_Loaded"
    PreviewKeyDown="Root_PreviewKeyDown"
    PreviewTextInput="Root_PreviewTextInput"
    Unloaded="Root_Unloaded">

    <!--  Backend: AsciiArtManager (+ .Export), AsciiEditor (drawing), AsciiGlyphs / AsciiRender (fonts and drawing). UI only here.  -->

    <UserControl.Resources>
        <Style x:Key="AaLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarText}" />
            <Setter Property="Margin" Value="2,10,0,4" />
        </Style>
        <Style x:Key="AaHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextMuted}" />
            <Setter Property="Margin" Value="2,6,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <!--  A file or folder on the Pictures card  -->
        <DataTemplate x:Key="SourceTemplate" DataType="{x:Type models:PixelSource}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="26"
                    Height="26"
                    Margin="0,0,8,0"
                    Background="{DynamicResource AccentColorSubtle}"
                    CornerRadius="7">
                    <materialDesign:PackIcon
                        x:Name="SourceIcon"
                        Width="14"
                        Height="14"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource AccentColor}"
                        Kind="FileImageOutline" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource SidebarText}"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding FullPath}" />
                    <TextBlock
                        Margin="0,1,0,0"
                        FontSize="10.5"
                        Foreground="{DynamicResource SidebarTextMuted}"
                        Text="{Binding Subtitle}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button
                    Grid.Column="2"
                    Width="24"
                    Height="24"
                    Margin="6,0,0,0"
                    VerticalAlignment="Center"
                    Click="BtnRemoveSource_Click"
                    Style="{StaticResource IconButtonStyle}"
                    Tag="{Binding}"
                    ToolTip="{DynamicResource Str_LoudnessMeter_TakeThisOffThe}">
                    <materialDesign:PackIcon
                        Width="13"
                        Height="13"
                        Kind="Close" />
                </Button>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                    <Setter TargetName="SourceIcon" Property="Kind" Value="Folder" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  One picture in the list on the right  -->
        <DataTemplate x:Key="PictureTemplate" DataType="{x:Type models:AsciiItem}">
            <Grid Margin="0,3">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Border
                    Width="38"
                    Height="38"
                    Margin="0,0,10,0"
                    Background="{DynamicResource InputBg}"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1"
                    CornerRadius="6">
                    <Image
                        Margin="2"
                        RenderOptions.BitmapScalingMode="HighQuality"
                        Source="{Binding Thumbnail}"
                        Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock
                        FontSize="12.5"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        Text="{Binding Name}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding FullPath}" />
                    <TextBlock
                        x:Name="Sub"
                        FontSize="11"
                        Foreground="{DynamicResource TextSecondary}"
                        Text="{Binding StatusText}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter TargetName="Sub" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="Done">
                    <Setter TargetName="Sub" Property="Foreground" Value="{DynamicResource StatusSuccessFg}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">
        <Grid Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= OPTIONS SIDEBAR =================  -->
            <controls:ToolSidebar>
                <StackPanel>

                    <!--  Pictures: one or many, files or folders  -->
                    <controls:InputFolderCard
                        x:Name="InputCard"
                        ctl:Tour.Key="Str_Tour_AsciiArt_Picture"
                        ctl:Tour.Order="1"
                        ClearRequested="InputCard_ClearRequested"
                        Header="{DynamicResource Str_AsciiArt_Pictures}"
                        HeaderIcon="FileMultipleOutline"
                        IncludeSubfoldersChanged="InputCard_IncludeSubfoldersChanged"
                        ItemTemplate="{StaticResource SourceTemplate}"
                        Mode="Files"
                        PathsAdded="InputCard_PathsAdded" />

                    <!--  Convert / Draw  -->
                    <Border
                        Margin="0,0,0,10"
                        ctl:Tour.Key="Str_Tour_AsciiArt_Mode"
                        ctl:Tour.Order="2"
                        Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl
                                Content="{DynamicResource Str_AsciiArt_ModeHeader}"
                                Style="{StaticResource SidebarGroupHeader}"
                                Tag="{x:Static materialDesign:PackIconKind.SwapHorizontal}" />
                            <UniformGrid Margin="0,6,0,0" Columns="2">
                                <RadioButton
                                    x:Name="RadioModeConvert"
                                    Margin="0,0,3,0"
                                    Click="RadioMode_Click"
                                    GroupName="AsciiMode"
                                    IsChecked="True"
                                    Style="{StaticResource SidebarChoiceTileStyle}">
                                    <StackPanel>
                                        <materialDesign:PackIcon
                                            Width="22"
                                            Height="22"
                                            HorizontalAlignment="Center"
                                            Kind="ImageFilterBlackWhite" />
                                        <TextBlock
                                            Margin="0,4,0,0"
                                            HorizontalAlignment="Center"
                                            Text="{DynamicResource Str_AsciiArt_ModeConvert}" />
                                    </StackPanel>
                                </RadioButton>
                                <RadioButton
                                    x:Name="RadioModeDraw"
                                    Margin="3,0,0,0"
                                    Click="RadioMode_Click"
                                    GroupName="AsciiMode"
                                    Style="{StaticResource SidebarChoiceTileStyle}">
                                    <StackPanel>
                                        <materialDesign:PackIcon
                                            Width="22"
                                            Height="22"
                                            HorizontalAlignment="Center"
                                            Kind="LeadPencil" />
                                        <TextBlock
                                            Margin="0,4,0,0"
                                            HorizontalAlignment="Center"
                                            Text="{DynamicResource Str_AsciiArt_ModeDraw}" />
                                    </StackPanel>
                                </RadioButton>
                            </UniformGrid>
                            <TextBlock x:Name="TxtModeHint" Style="{StaticResource AaHint}" />
                        </StackPanel>
                    </Border>

                    <!--  ========== Convert options ==========  -->
                    <StackPanel x:Name="PanelConvert">

                        <Border
                            Margin="0,0,0,10"
                            ctl:Tour.Key="Str_Tour_AsciiArt_Detail"
                            ctl:Tour.Order="3"
                            Style="{StaticResource SidebarGroupCardStyle}">
                            <StackPanel>
                                <ContentControl
                                    Content="{DynamicResource Str_AsciiArt_DetailHeader}"
                                    Style="{StaticResource SidebarGroupHeader}"
                                    Tag="{x:Static materialDesign:PackIconKind.ImageSearchOutline}" />
                                <TextBlock x:Name="TxtColumnsLabel" Style="{StaticResource AaLabel}" />
                                <Slider
                                    x:Name="SliderColumns"
                                    Maximum="600"
                                    Minimum="20"
                                    SmallChange="1"
                                    LargeChange="20"
                                    ValueChanged="SliderColumns_ValueChanged" />
                                <CheckBox
                                    x:Name="ChkMatchOriginal"
                                    Margin="0,8,0,0"
                                    Click="Option_Click"
                                    Content="{DynamicResource Str_AsciiArt_MatchOriginal}"
                                    ToolTip="{DynamicResource Str_AsciiArt_MatchOriginalTip}"
                                    controls:ChoiceIcon.Kind="FileImageOutline"
                                    Style="{StaticResource ToggleChipCheckBoxStyle}" />
                                <CheckBox
                                    x:Name="ChkMatchShapes"
                                    Margin="0,8,0,0"
                                    Click="Option_Click"
                                    Content="{DynamicResource Str_AsciiArt_MatchShapes}"
                                    ToolTip="{DynamicResource Str_AsciiArt_MatchShapesTip}"
                                    controls:ChoiceIcon.Kind="AutoFix"
                                    Style="{StaticResource ToggleChipCheckBoxStyle}" />
                                <CheckBox
                                    x:Name="ChkSharpen"
                                    Margin="0,8,0,0"
                                    Click="Option_Click"
                                    Content="{DynamicResource Str_AsciiArt_Sharpen}"
                                    controls:ChoiceIcon.Kind="Pound"
                                    Style="{StaticResource ToggleChipCheckBoxStyle}" />
                                <CheckBox
                                    x:Name="ChkAutoLevels"
                                    Margin="0,8,0,0"
                                    Click="Option_Click"
                                    Content="{DynamicResource Str_AsciiArt_AutoLevels}"
                                    ToolTip="{DynamicResource Str_AsciiArt_AutoLevelsTip}"
                                    controls:ChoiceIcon.Kind="AutoFix"
                                    Style="{StaticResource ToggleChipCheckBoxStyle}" />
                                <TextBlock x:Name="TxtContrastLabel" Style="{StaticResource AaLabel}" />
                                <Slider
                                    x:Name="SliderContrast"
                                    Maximum="100"
                                    Minimum="-100"
                                    ValueChanged="SliderTone_ValueChanged" />
                                <TextBlock x:Name="TxtBrightnessLabel" Style="{StaticResource AaLabel}" />
                                <Slider
                                    x:Name="SliderBrightness"
                                    Maximum="100"
                                    Minimum="-100"
                                    ValueChanged="SliderTone_ValueChanged" />
                                <CheckBox
                                    x:Name="ChkInvert"
                                    Margin="0,8,0,0"
                                    Click="Option_Click"
                                    Content="{DynamicResource Str_AsciiArt_Invert}"
                                    ToolTip="{DynamicResource Str_AsciiArt_InvertTip}"
                                    controls:ChoiceIcon.Kind="AutoFix"
                                    Style="{StaticResource ToggleChipCheckBoxStyle}" />
                            </StackPanel>
                        </Border>

                        <Border
                            Margin="0,0,0,10"
                            ctl:Tour.Key="Str_Tour_AsciiArt_Characters"
                            ctl:Tour.Order="4"
                            Style="{StaticResource SidebarGroupCardStyle}">
                            <StackPanel>
                                <ContentControl
                                    Content="{DynamicResource Str_AsciiArt_CharactersHeader}"
                                    Style="{StaticResource SidebarGroupHeader}"
                                    Tag="{x:Static materialDesign:PackIconKind.FormatLetterCase}" />
                                <TextBlock Style="{StaticResource AaLabel}" Text="{DynamicResource Str_AsciiArt_CharSet}" />
                                <Border Style="{StaticResource InputBarStyle}">
                                    <ComboBox
                                        x:Name="CmbCharSet"
                                        VerticalContentAlignment="Center"
                                        SelectionChanged="Option_SelectionChanged"
                                        Style="{StaticResource BareComboBox}">
                                        <ComboBoxItem Content="{DynamicResource Str_AsciiArt_SetClassic}" Tag="Classic" />
                                        <ComboBoxItem Content="{DynamicResource Str_AsciiArt_SetClassicDetailed}" Tag="ClassicDetailed" />
                                        <ComboBoxItem Content="{DynamicResource Str_AsciiArt_SetLetters}" Tag="Letters" />
                                        <ComboBoxItem Content="{DynamicResource Str_AsciiArt_SetSpecial}" Tag="Special" />
                                        <ComboBoxItem Content="{DynamicResource Str_AsciiArt_SetMixed}" Tag="Mixed" />
                                        <ComboBoxItem Content="{DynamicResource Str_AsciiArt_SetCustom}" Tag="Custom" />
                                    </ComboBox>
                                </Border>
                                <StackPanel x:Name="PanelCustomChars" Visibility="Collapsed">
                                    <TextBlock Style="{StaticResource AaLabel}" Text="{DynamicResource Str_AsciiArt_CustomChars}" />
                                    <Border Style="{StaticResource InputBarStyle}">
                                        <TextBox
                                            x:Name="TxtCustomChars"
                                            VerticalContentAlignment="Center"
                                            MaxLength="200"
                                            Style="{StaticResource BareTextBox}"
                                            TextChanged="TxtCustomChars_TextChanged" />
                                    </Border>
                                </StackPanel>
                                <TextBlock x:Name="TxtCharHint" Style="{StaticResource AaHint}" />
                                <CheckBox
                                    x:Name="ChkUseSpace"
                                    Margin="0,8,0,0"
                                    Click="Option_Click"
                                    Content="{DynamicResource Str_AsciiArt_UseSpace}"
                                    ToolTip="{DynamicResource Str_AsciiArt_UseSpaceTip}"
                                    controls:ChoiceIcon.Kind="KeyboardSpace"
                                    Style="{StaticResource ToggleChipCheckBoxStyle}" />
                                <TextBlock Style="{StaticResource AaLabel}" Text="{DynamicResource Str_AsciiArt_Font}" />
                                <Border Style="{StaticResource InputBarStyle}">
                                    <ComboBox
                                        x:Name="CmbFont"
                                        VerticalContentAlignment="Center"
                                        SelectionChanged="Option_SelectionChanged"
                                        Style="{StaticResource BareComboBox}" />
                                </Border>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--  Colours and page: used in both modes  -->
                    <StackPanel>
                        <Border
                            Margin="0,0,0,10"
                            ctl:Tour.Key="Str_Tour_AsciiArt_Colors"
                            ctl:Tour.Order="5"
                            Style="{StaticResource SidebarGroupCardStyle}">
                            <StackPanel>
                                <ContentControl
                                    Content="{DynamicResource Str_Common_ColorsHeader}"
                                    Style="{StaticResource SidebarGroupHeader}"
                                    Tag="{x:Static materialDesign:PackIconKind.PaletteOutline}" />
                                <UniformGrid x:Name="GridColorMode" Margin="0,6,0,0" Columns="2">
                                    <RadioButton
                                        x:Name="RadioBlackWhite"
                                        Margin="0,0,3,0"
                                        Click="Option_Click"
                                        GroupName="AsciiColor"
                                        IsChecked="True"
                                        Style="{StaticResource SidebarChoiceTileStyle}">
                                        <StackPanel>
                                            <materialDesign:PackIcon
                                                Width="22"
                                                Height="22"
                                                HorizontalAlignment="Center"
                                                Kind="CircleHalfFull" />
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                HorizontalAlignment="Center"
                                                Text="{DynamicResource Str_AsciiArt_BlackWhite}" />
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton
                                        x:Name="RadioColored"
                                        Margin="3,0,0,0"
                                        Click="Option_Click"
                                        GroupName="AsciiColor"
                                        Style="{StaticResource SidebarChoiceTileStyle}">
                                        <StackPanel>
                                            <materialDesign:PackIcon
                                                Width="22"
                                                Height="22"
                                                HorizontalAlignment="Center"
                                                Kind="Palette" />
                                            <TextBlock
                                                Margin="0,4,0,0"
                                                HorizontalAlignment="Center"
                                                Text="{DynamicResource Str_AsciiArt_Colored}" />
                                        </StackPanel>
                                    </RadioButton>
                                </UniformGrid>
                                <TextBlock Style="{StaticResource AaLabel}" Text="{DynamicResource Str_AsciiArt_Page}" />
                                <UniformGrid Columns="2">
                                    <RadioButton
                                        x:Name="RadioPageDark"
                                        Margin="0,0,3,0"
                                        Click="Option_Click"
                                        GroupName="AsciiPage"
                                        IsChecked="True"
                                        Style="{StaticResource SidebarChoiceTileStyle}">
                                        <TextBlock HorizontalAlignment="Center" Text="{DynamicResource Str_AsciiArt_PageDark}" />
                                    </RadioButton>
                                    <RadioButton
                                        x:Name="RadioPageLight"
                                        Margin="3,0,0,0"
                                        Click="Option_Click"
                                        GroupName="AsciiPage"
                                        Style="{StaticResource SidebarChoiceTileStyle}">
                                        <TextBlock HorizontalAlignment="Center" Text="{DynamicResource Str_AsciiArt_PageLight}" />
                                    </RadioButton>
                                </UniformGrid>
                                <TextBlock Style="{StaticResource AaHint}" Text="{DynamicResource Str_AsciiArt_PageHint}" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--  ========== Draw options ==========  -->
                    <StackPanel x:Name="PanelDraw" Visibility="Collapsed">
                        <Border
                            Margin="0,0,0,10"
                            ctl:Tour.Key="Str_Tour_AsciiArt_Draw"
                            ctl:Tour.Order="6"
                            Style="{StaticResource SidebarGroupCardStyle}">
                            <StackPanel>
                                <ContentControl
                                    Content="{DynamicResource Str_AsciiArt_DrawHeader}"
                                    Style="{StaticResource SidebarGroupHeader}"
                                    Tag="{x:Static materialDesign:PackIconKind.LeadPencil}" />
                                <TextBlock Style="{StaticResource AaLabel}" Text="{DynamicResource Str_AsciiArt_Tool}" />
                                <Border Style="{StaticResource InputBarStyle}">
                                    <ComboBox
                                        x:Name="CmbTool"
                                        VerticalContentAlignment="Center"
                                        SelectionChanged="CmbTool_SelectionChanged"
                                        Style="{StaticResource BareComboBox}">
                                        <ComboBoxItem Content="{DynamicResource Str_AsciiArt_ToolPencil}" Tag="Pencil" />
                                        <ComboBoxItem Content="{DynamicResource Str_AsciiArt_ToolEraser}" Tag="Eraser" />
                                        <ComboBoxItem Content="{DynamicResource Str_AsciiArt_ToolFill}" Tag="Fill" />
                                        <ComboBoxItem Content="{DynamicResource Str_AsciiArt_ToolLine}" Tag="Line" />
                                        <ComboBoxItem Content="{DynamicResource Str_AsciiArt_ToolRectangle}" Tag="Rectangle" />
                                        <ComboBoxItem Content="{DynamicResource Str_AsciiArt_ToolText}" Tag="Text" />
                                        <ComboBoxItem Content="{DynamicResource Str_AsciiArt_ToolPicker}" Tag="Picker" />
                                    </ComboBox>
                                </Border>
                                <TextBlock x:Name="TxtToolHint" Style="{StaticResource AaHint}" />
                                <TextBlock Style="{StaticResource AaLabel}" Text="{DynamicResource Str_AsciiArt_DrawChar}" />
                                <Border Style="{StaticResource InputBarStyle}">
                                    <TextBox
                                        x:Name="TxtDrawChar"
                                        VerticalContentAlignment="Center"
                                        MaxLength="1"
                                        Style="{StaticResource BareTextBox}"
                                        TextChanged="TxtDrawChar_TextChanged" />
                                </Border>
                                <TextBlock Style="{StaticResource AaLabel}" Text="{DynamicResource Str_AsciiArt_DrawColor}" />
                                <Border Style="{StaticResource InputBarStyle}">
                                    <ComboBox
                                        x:Name="CmbDrawColor"
                                        VerticalContentAlignment="Center"
                                        SelectionChanged="CmbDrawColor_SelectionChanged"
                                        Style="{StaticResource BareComboBox}" />
                                </Border>
                                <CheckBox
                                    x:Name="ChkSymmetry"
                                    Margin="0,10,0,0"
                                    Click="ChkSymmetry_Click"
                                    Content="{DynamicResource Str_AsciiArt_Symmetry}"
                                    ToolTip="{DynamicResource Str_AsciiArt_SymmetryTip}"
                                    controls:ChoiceIcon.Kind="AutoFix"
                                    Style="{StaticResource ToggleChipCheckBoxStyle}" />
                                <UniformGrid Margin="0,10,0,0" Columns="3">
                                    <Button
                                        x:Name="BtnUndo"
                                        Margin="0,0,3,0"
                                        Click="BtnUndo_Click"
                                        Style="{StaticResource NeutralIconButtonStyle}"
                                        ToolTip="{DynamicResource Str_AsciiArt_Undo}">
                                        <materialDesign:PackIcon Width="18" Height="18" Kind="UndoVariant" />
                                    </Button>
                                    <Button
                                        x:Name="BtnRedo"
                                        Margin="3,0"
                                        Click="BtnRedo_Click"
                                        Style="{StaticResource NeutralIconButtonStyle}"
                                        ToolTip="{DynamicResource Str_AsciiArt_Redo}">
                                        <materialDesign:PackIcon Width="18" Height="18" Kind="RedoVariant" />
                                    </Button>
                                    <Button
                                        x:Name="BtnClear"
                                        Margin="3,0,0,0"
                                        Click="BtnClear_Click"
                                        Style="{StaticResource NeutralIconButtonStyle}"
                                        ToolTip="{DynamicResource Str_AsciiArt_ClearAll}">
                                        <materialDesign:PackIcon Width="18" Height="18" Kind="DeleteOutline" />
                                    </Button>
                                </UniformGrid>
                                <TextBlock Style="{StaticResource AaLabel}" Text="{DynamicResource Str_AsciiArt_GridSize}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border Style="{StaticResource InputBarStyle}">
                                        <TextBox
                                            x:Name="TxtDrawCols"
                                            VerticalContentAlignment="Center"
                                            MaxLength="3"
                                            Style="{StaticResource BareTextBox}"
                                            ToolTip="{DynamicResource Str_AsciiArt_Columns}" />
                                    </Border>
                                    <TextBlock
                                        Grid.Column="1"
                                        Margin="8,0"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource SidebarTextMuted}"
                                        Text="×" />
                                    <Border Grid.Column="2" Style="{StaticResource InputBarStyle}">
                                        <TextBox
                                            x:Name="TxtDrawRows"
                                            VerticalContentAlignment="Center"
                                            MaxLength="3"
                                            Style="{StaticResource BareTextBox}"
                                            ToolTip="{DynamicResource Str_AsciiArt_Rows}" />
                                    </Border>
                                </Grid>
                                <UniformGrid Margin="0,8,0,0" Columns="2">
                                    <Button
                                        Margin="0,0,3,0"
                                        Click="BtnApplySize_Click"
                                        Content="{DynamicResource Str_AsciiArt_ApplySize}"
                                        Style="{StaticResource NeutralIconButtonStyle}" />
                                    <Button
                                        Margin="3,0,0,0"
                                        Click="BtnNewBlank_Click"
                                        Content="{DynamicResource Str_AsciiArt_NewBlank}"
                                        Style="{StaticResource NeutralIconButtonStyle}" />
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!--  Save and copy  -->
                    <Border
                        Margin="0,0,0,10"
                        ctl:Tour.Key="Str_Tour_AsciiArt_Save"
                        ctl:Tour.Order="7"
                        Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl
                                Content="{DynamicResource Str_Code_Save}"
                                Style="{StaticResource SidebarGroupHeader}"
                                Tag="{x:Static materialDesign:PackIconKind.ContentSaveOutline}" />
                            <Button
                                x:Name="BtnSave"
                                MinHeight="36"
                                Margin="0,6,0,0"
                                Click="BtnSave_Click"
                                IsEnabled="False"
                                Style="{StaticResource AccentPrimaryButtonStyle}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Kind="ContentSave" />
                                    <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_AsciiArt_SaveAs}" />
                                </StackPanel>
                            </Button>
                            <UniformGrid Margin="0,8,0,0" Columns="2">
                                <Button
                                    x:Name="BtnCopyText"
                                    Margin="0,0,3,0"
                                    Click="BtnCopyText_Click"
                                    Content="{DynamicResource Str_AsciiArt_CopyText}"
                                    IsEnabled="False"
                                    Style="{StaticResource NeutralIconButtonStyle}" />
                                <Button
                                    x:Name="BtnCopyRich"
                                    Margin="3,0,0,0"
                                    Click="BtnCopyRich_Click"
                                    Content="{DynamicResource Str_AsciiArt_CopyRich}"
                                    IsEnabled="False"
                                    Style="{StaticResource NeutralIconButtonStyle}"
                                    ToolTip="{DynamicResource Str_AsciiArt_CopyRichTip}" />
                            </UniformGrid>
                            <TextBlock Style="{StaticResource AaHint}" Text="{DynamicResource Str_AsciiArt_SaveHint}" />
                        </StackPanel>
                    </Border>

                    <!--  Save every picture of the list in one go (shown when the list has two or more)  -->
                    <StackPanel x:Name="PanelBatch" Visibility="Collapsed">
                        <Border
                            Margin="0,0,0,10"
                            ctl:Tour.Key="Str_Tour_AsciiArt_SaveAll"
                            ctl:Tour.Order="8"
                            Style="{StaticResource SidebarGroupCardStyle}">
                            <StackPanel>
                                <ContentControl
                                    Content="{DynamicResource Str_AsciiArt_SaveAllHeader}"
                                    Style="{StaticResource SidebarGroupHeader}"
                                    Tag="{x:Static materialDesign:PackIconKind.ContentSaveAllOutline}" />
                                <TextBlock Style="{StaticResource AaLabel}" Text="{DynamicResource Str_AsciiArt_SaveAllFormat}" />
                                <Border Style="{StaticResource InputBarStyle}">
                                    <ComboBox
                                        x:Name="CmbBatchFormat"
                                        VerticalContentAlignment="Center"
                                        Style="{StaticResource BareComboBox}">
                                        <ComboBoxItem Content="{DynamicResource Str_AsciiArt_FormatTxt}" Tag="txt" />
                                        <ComboBoxItem Content="{DynamicResource Str_AsciiArt_FormatRtf}" Tag="rtf" />
                                        <ComboBoxItem Content="{DynamicResource Str_AsciiArt_FormatHtml}" Tag="html" />
                                        <ComboBoxItem Content="{DynamicResource Str_AsciiArt_FormatPng}" Tag="png" />
                                        <ComboBoxItem Content="{DynamicResource Str_AsciiArt_FormatAnsi}" Tag="ansi" />
                                    </ComboBox>
                                </Border>
                                <Button
                                    x:Name="BtnSaveAll"
                                    MinHeight="36"
                                    Margin="0,10,0,0"
                                    Click="BtnSaveAll_Click"
                                    Style="{StaticResource AccentPrimaryButtonStyle}">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            x:Name="IconSaveAll"
                                            Width="16"
                                            Height="16"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            Kind="ContentSaveAll" />
                                        <TextBlock
                                            x:Name="TxtSaveAll"
                                            VerticalAlignment="Center"
                                            Text="{DynamicResource Str_AsciiArt_SaveAll}" />
                                    </StackPanel>
                                </Button>
                                <TextBlock Style="{StaticResource AaHint}" Text="{DynamicResource Str_AsciiArt_SaveAllHint}" />
                            </StackPanel>
                        </Border>
                        <controls:OutputFolderCard
                            x:Name="OutputCard"
                            Header="{DynamicResource Str_AsciiArt_SaveAllTo}"
                            HeaderIcon="FolderOutline"
                            ToolName="ASCII Art Maker" />
                    </StackPanel>
                </StackPanel>
            </controls:ToolSidebar>

            <!--  ================= MAIN AREA =================  -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition x:Name="ListColumn" Width="Auto" />
                </Grid.ColumnDefinitions>

                <!--  Summary bar  -->
                <Border
                    Grid.ColumnSpan="2"
                    Padding="16,12"
                    Background="{DynamicResource CardBg}"
                    CornerRadius="14">
                    <StackPanel>
                        <DockPanel LastChildFill="True">
                            <StackPanel
                                DockPanel.Dock="Right"
                                Orientation="Horizontal"
                                VerticalAlignment="Center">
                                <Button
                                    x:Name="BtnFit"
                                    Margin="0,0,8,0"
                                    Click="BtnFit_Click"
                                    Style="{StaticResource NeutralIconButtonStyle}"
                                    ToolTip="{DynamicResource Str_AsciiArt_FitTip}">
                                    <materialDesign:PackIcon Width="18" Height="18" Kind="FitToPageOutline" />
                                </Button>
                                <Slider
                                    x:Name="SliderZoom"
                                    Width="140"
                                    VerticalAlignment="Center"
                                    Maximum="4"
                                    Minimum="0.1"
                                    ValueChanged="SliderZoom_ValueChanged" />
                                <TextBlock
                                    x:Name="TxtZoom"
                                    Width="46"
                                    Margin="8,0,0,0"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextSecondary}"
                                    TextAlignment="Right" />
                            </StackPanel>
                            <WrapPanel VerticalAlignment="Center">
                                <Border
                                    x:Name="PillSize"
                                    Margin="0,0,6,0"
                                    Background="{DynamicResource RowBg}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        x:Name="TxtPillSize"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextSecondary}" />
                                </Border>
                                <Border
                                    x:Name="PillChars"
                                    Margin="0,0,6,0"
                                    Background="{DynamicResource AccentColorSubtle}"
                                    Style="{StaticResource IconStatusPillStyle}"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        x:Name="TxtPillChars"
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource AccentColor}" />
                                </Border>
                                <TextBlock
                                    x:Name="TxtHeroHint"
                                    VerticalAlignment="Center"
                                    FontSize="12.5"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{DynamicResource Str_AsciiArt_HeroHint}" />
                            </WrapPanel>
                        </DockPanel>
                        <ProgressBar
                            x:Name="RunProgress"
                            Height="5"
                            Margin="0,10,0,0"
                            IsIndeterminate="True"
                            Visibility="Collapsed" />
                        <Border
                            x:Name="StatusBanner"
                            Margin="0,10,0,0"
                            Padding="12,9"
                            HorizontalAlignment="Left"
                            CornerRadius="10"
                            Visibility="Collapsed">
                            <TextBlock
                                x:Name="TxtStatus"
                                MaxWidth="900"
                                FontSize="12.5"
                                FontWeight="SemiBold"
                                TextWrapping="Wrap" />
                        </Border>
                    </StackPanel>
                </Border>

                <!--  Stage  -->
                <Border
                    Grid.Row="1"
                    Margin="0,14,0,0"
                    ctl:Tour.Key="Str_Tour_AsciiArt_Stage"
                    ctl:Tour.Order="8"
                    Background="{DynamicResource CardBg}"
                    ClipToBounds="True"
                    CornerRadius="14">
                    <Grid>
                        <ScrollViewer
                            x:Name="StageScroll"
                            HorizontalScrollBarVisibility="Auto"
                            VerticalScrollBarVisibility="Auto">
                            <Border
                                x:Name="ZoomHost"
                                Margin="14"
                                HorizontalAlignment="Left"
                                VerticalAlignment="Top"
                                CornerRadius="4"
                                ClipToBounds="True">
                                <Border.LayoutTransform>
                                    <ScaleTransform x:Name="ZoomScale" ScaleX="1" ScaleY="1" />
                                </Border.LayoutTransform>
                                <controls:AsciiGridControl x:Name="Stage" />
                            </Border>
                        </ScrollViewer>
                        <StackPanel
                            x:Name="EmptyState"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                            <materialDesign:PackIcon
                                Width="46"
                                Height="46"
                                HorizontalAlignment="Center"
                                Foreground="{DynamicResource TextSecondary}"
                                Kind="FormatLetterCase" />
                            <TextBlock
                                Margin="0,10,0,0"
                                MaxWidth="420"
                                FontSize="13"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="{DynamicResource Str_AsciiArt_EmptyState}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  The pictures (shown when there are two or more)  -->
                <Border
                    x:Name="PictureListCard"
                    Grid.Row="1"
                    Grid.Column="1"
                    Width="250"
                    Margin="14,14,0,0"
                    Padding="10"
                    Background="{DynamicResource CardBg}"
                    CornerRadius="14"
                    Visibility="Collapsed">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>
                        <TextBlock
                            x:Name="TxtListTitle"
                            Margin="4,2,0,8"
                            FontSize="13"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextPrimary}" />
                        <ListBox
                            x:Name="PictureList"
                            Grid.Row="1"
                            Background="Transparent"
                            BorderThickness="0"
                            ItemTemplate="{StaticResource PictureTemplate}"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            SelectionChanged="PictureList_SelectionChanged"
                            SelectionMode="Single" />
                    </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
