<UserControl
    x:Class="Smart_Tools.WPF.Views.SpritePackerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:models="clr-namespace:Smart_Tools.WPF.Models"
    x:Name="Root"
    Focusable="True"
    Loaded="Root_Loaded"
    Unloaded="Root_Unloaded">

    <!--
        Backend: Controllers/SpritePackerManager.cs (packing, slicing, coordinate files, saving, settings),
        .Files.cs (finding images, the list), .Render.cs (WPF pictures). Models/SpritePackerModel.cs. UI only here.
    -->

    <UserControl.Resources>

        <!--  Small one-click preset  -->
        <Style x:Key="SpChipStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,4,4" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarText}" />
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Padding="8,3"
                            Background="{DynamicResource SidebarInputBg}"
                            BorderBrush="{DynamicResource SidebarInputBorder}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentColorSubtle}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="SpSideLabel" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarText}" />
            <Setter Property="Margin" Value="2,10,0,4" />
        </Style>

        <Style x:Key="SpSideHint" TargetType="TextBlock">
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextMuted}" />
            <Setter Property="Margin" Value="2,6,0,0" />
            <Setter Property="TextWrapping" Value="Wrap" />
        </Style>

        <Style x:Key="SpPillText" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
        </Style>

        <!--  A Files card row (a folder or loose files)  -->
        <DataTemplate x:Key="GroupTemplate" DataType="{x:Type models:SpriteGroup}">
            <Grid ToolTip="{Binding ToolTip}">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="26" Height="26" Margin="0,0,8,0" Background="{DynamicResource AccentColorSubtle}" CornerRadius="7">
                    <materialDesign:PackIcon x:Name="GroupIcon" Width="14" Height="14" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource AccentColor}" Kind="FileMultipleOutline" />
                </Border>
                <StackPanel Grid.Column="1" VerticalAlignment="Center">
                    <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource SidebarText}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                    <TextBlock Margin="0,1,0,0" FontSize="10.5" Foreground="{DynamicResource SidebarTextMuted}" Text="{Binding Subtitle}" TextTrimming="CharacterEllipsis" />
                </StackPanel>
                <Button Grid.Column="2" Width="24" Height="24" Margin="6,0,0,0" VerticalAlignment="Center" Click="BtnRemoveGroup_Click" Style="{StaticResource IconButtonStyle}" Tag="{Binding}" ToolTip="{DynamicResource Str_SpritePacker_TakeOff}">
                    <materialDesign:PackIcon Width="13" Height="13" Kind="Close" />
                </Button>
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsFolder}" Value="True">
                    <Setter TargetName="GroupIcon" Property="Kind" Value="Folder" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <!--  One sprite in the list  -->
        <DataTemplate x:Key="SpriteTemplate" DataType="{x:Type models:SpriteItem}">
            <Grid Margin="0,2">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <CheckBox Margin="2,0,8,0" VerticalAlignment="Center" Click="SpriteCheck_Click" IsChecked="{Binding IsChecked, Mode=TwoWay}" ToolTip="{DynamicResource Str_SpritePacker_IncludeTip}" />
                <Border Grid.Column="1" Width="40" Height="40" Margin="0,0,10,0" Background="{DynamicResource InputBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="6">
                    <Image Margin="2" RenderOptions.BitmapScalingMode="NearestNeighbor" Source="{Binding Thumbnail}" Stretch="Uniform" />
                </Border>
                <StackPanel Grid.Column="2" VerticalAlignment="Center">
                    <TextBlock FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" ToolTip="{Binding FullPath}" />
                    <StackPanel Margin="0,1,0,0" Orientation="Horizontal">
                        <TextBlock FontSize="11" Foreground="{DynamicResource TextSecondary}" Text="{Binding SizeText}" />
                        <TextBlock Margin="6,0,0,0" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource AccentColor}" Text="{Binding TrimText}" ToolTip="{DynamicResource Str_SpritePacker_TrimTip}" />
                    </StackPanel>
                </StackPanel>
                <materialDesign:PackIcon x:Name="StatusIcon" Grid.Column="3" Width="18" Height="18" Margin="6,0,4,0" VerticalAlignment="Center" Kind="AlertCircleOutline" ToolTip="{Binding StatusText}" Visibility="Collapsed" />
            </Grid>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Status}" Value="Failed">
                    <Setter TargetName="StatusIcon" Property="Visibility" Value="Visible" />
                    <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Status}" Value="DoesNotFit">
                    <Setter TargetName="StatusIcon" Property="Visibility" Value="Visible" />
                    <Setter TargetName="StatusIcon" Property="Kind" Value="AlertOutline" />
                    <Setter TargetName="StatusIcon" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">

        <!--  No page header: MainWindow's header card shows the tool's icon and name.  -->

        <Grid Margin="16,8,16,16">

            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OptionsColumn" Width="280" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= OPTIONS SIDEBAR =================  -->

            <Border Grid.Column="0" Style="{StaticResource SidebarPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Button
                            x:Name="BtnCollapseOptions"
                            MinHeight="45"
                            HorizontalContentAlignment="Left"
                            Click="BtnCollapseOptions_Click"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Foreground="{DynamicResource SidebarText}"
                            ToolTip="{DynamicResource Str_Common_SidebarToggleTooltip}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="OverridesDefaultStyle" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Margin="16,0,0,0" Orientation="Horizontal">
                                <materialDesign:PackIcon Width="20" Height="20" VerticalAlignment="Center" Kind="TuneVariant" />
                                <TextBlock x:Name="TxtOptionsHeaderLabel" Margin="10,0,0,0" VerticalAlignment="Center" FontWeight="SemiBold" Text="{DynamicResource Str_Common_OptionsLabel}" />
                            </StackPanel>
                        </Button>
                        <Separator x:Name="SepHeader" Margin="16,4" Style="{StaticResource SidebarSeparatorStyle}" />
                    </StackPanel>

                    <ScrollViewer
                        x:Name="OptionsScrollViewer"
                        Grid.Row="1"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel x:Name="SidebarStack" Margin="16,4,16,16">

                            <!--  ============ MODE ============  -->
                            <Border ctl:Tour.Key="Str_Tour_SpritePacker_Mode" ctl:Tour.Order="1" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl Content="{DynamicResource Str_SpritePacker_ModeHeader}" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.SwapHorizontal}" />
                                    <UniformGrid Columns="2">
                                        <RadioButton x:Name="RadioModePack" Margin="0,0,2,0" Click="Mode_Click" Content="{DynamicResource Str_SpritePacker_ModePack}" GroupName="SpMode" IsChecked="True" Style="{StaticResource ModeToggleButtonStyle}" Tag="Pack" />
                                        <RadioButton x:Name="RadioModeSlice" Margin="2,0,0,0" Click="Mode_Click" Content="{DynamicResource Str_SpritePacker_ModeSlice}" GroupName="SpMode" Style="{StaticResource ModeToggleButtonStyle}" Tag="Slice" />
                                    </UniformGrid>
                                    <TextBlock x:Name="TxtModeHint" Style="{StaticResource SpSideHint}" />
                                </StackPanel>
                            </Border>

                            <!--  ================= PACK ================  -->
                            <StackPanel x:Name="PackSidebar">

                                <!--  ============ FILES ============  -->
                                <controls:InputFolderCard
                                    ctl:Tour.Key="Str_Tour_SpritePacker_Input" ctl:Tour.Order="2"
                                    x:Name="InputCard"
                                    ClearRequested="InputCard_ClearRequested"
                                    Header="{DynamicResource Str_Common_Files}"
                                    HeaderIcon="FileMultipleOutline"
                                    IncludeSubfoldersChanged="InputCard_IncludeSubfoldersChanged"
                                    ItemTemplate="{StaticResource GroupTemplate}"
                                    PathsAdded="InputCard_PathsAdded" />


                                <!--  ============ LAYOUT ============  -->
                                <Border Style="{StaticResource SidebarGroupCardStyle}">
                                    <StackPanel>
                                        <ContentControl Content="{DynamicResource Str_SpritePacker_LayoutHeader}" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.ViewGridPlusOutline}" />
                                        <TextBlock Margin="2,0,0,4" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SidebarText}" Text="{DynamicResource Str_SpritePacker_Padding}" />
                                        <Border Style="{StaticResource InputBarStyle}">
                                            <TextBox x:Name="TxtPadding" VerticalContentAlignment="Center" Style="{StaticResource BareTextBox}" Text="2" TextChanged="PackSetting_TextChanged" />
                                        </Border>
                                        <WrapPanel Margin="0,8,0,0">
                                            <Button Click="PaddingChip_Click" Content="0" Style="{StaticResource SpChipStyle}" Tag="0" />
                                            <Button Click="PaddingChip_Click" Content="1" Style="{StaticResource SpChipStyle}" Tag="1" />
                                            <Button Click="PaddingChip_Click" Content="2" Style="{StaticResource SpChipStyle}" Tag="2" />
                                            <Button Click="PaddingChip_Click" Content="4" Style="{StaticResource SpChipStyle}" Tag="4" />
                                            <Button Click="PaddingChip_Click" Content="8" Style="{StaticResource SpChipStyle}" Tag="8" />
                                        </WrapPanel>
                                        <TextBlock x:Name="TxtPaddingError" Margin="2,0,0,0" FontSize="10.5" Foreground="{DynamicResource StatusErrorFg}" Text="{DynamicResource Str_SpritePacker_PaddingBad}" TextWrapping="Wrap" Visibility="Collapsed" />
                                        <TextBlock Style="{StaticResource SpSideHint}" Text="{DynamicResource Str_SpritePacker_PaddingHint}" />

                                        <TextBlock Style="{StaticResource SpSideLabel}" Text="{DynamicResource Str_SpritePacker_MaxSheetSize}" />
                                        <UniformGrid Columns="5">
                                            <RadioButton x:Name="RadioMax512" Margin="0,0,2,0" Click="PackSetting_Click" Content="512" GroupName="SpMax" Style="{StaticResource ModeToggleButtonStyle}" Tag="512" />
                                            <RadioButton x:Name="RadioMax1024" Margin="2,0" Click="PackSetting_Click" Content="1K" GroupName="SpMax" Style="{StaticResource ModeToggleButtonStyle}" Tag="1024" />
                                            <RadioButton x:Name="RadioMax2048" Margin="2,0" Click="PackSetting_Click" Content="2K" GroupName="SpMax" IsChecked="True" Style="{StaticResource ModeToggleButtonStyle}" Tag="2048" />
                                            <RadioButton x:Name="RadioMax4096" Margin="2,0" Click="PackSetting_Click" Content="4K" GroupName="SpMax" Style="{StaticResource ModeToggleButtonStyle}" Tag="4096" />
                                            <RadioButton x:Name="RadioMax8192" Margin="2,0,0,0" Click="PackSetting_Click" Content="8K" GroupName="SpMax" Style="{StaticResource ModeToggleButtonStyle}" Tag="8192" />
                                        </UniformGrid>
                                        <TextBlock Style="{StaticResource SpSideHint}" Text="{DynamicResource Str_SpritePacker_MaxHint}" />

                                        <CheckBox x:Name="ChkPowerOfTwo" Margin="0,12,0,0" Click="PackSetting_Click" Foreground="{DynamicResource SidebarText}" IsChecked="True">
                                            <TextBlock Text="{DynamicResource Str_SpritePacker_PowerOfTwo}" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <TextBlock Style="{StaticResource SpSideHint}" Text="{DynamicResource Str_SpritePacker_PowerOfTwoHint}" />
                                        <CheckBox x:Name="ChkTrim" Margin="0,10,0,0" Click="PackSetting_Click" Foreground="{DynamicResource SidebarText}" IsChecked="True">
                                            <TextBlock Text="{DynamicResource Str_SpritePacker_Trim}" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <TextBlock Style="{StaticResource SpSideHint}" Text="{DynamicResource Str_SpritePacker_TrimHint}" />
                                    </StackPanel>
                                </Border>

                                <!--  ============ COORDINATES ============  -->
                                <Border Style="{StaticResource SidebarGroupCardStyle}">
                                    <StackPanel>
                                        <ContentControl Content="{DynamicResource Str_SpritePacker_CoordsHeader}" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.CodeJson}" />
                                        <UniformGrid Columns="2">
                                            <RadioButton x:Name="RadioFormatJson" Margin="0,0,2,4" Click="PackSetting_Click" Content="JSON" GroupName="SpFormat" IsChecked="True" Style="{StaticResource ModeToggleButtonStyle}" Tag="Json" />
                                            <RadioButton x:Name="RadioFormatCss" Margin="2,0,0,4" Click="PackSetting_Click" Content="CSS" GroupName="SpFormat" Style="{StaticResource ModeToggleButtonStyle}" Tag="Css" />
                                            <RadioButton x:Name="RadioFormatXml" Margin="0,0,2,0" Click="PackSetting_Click" Content="XML" GroupName="SpFormat" Style="{StaticResource ModeToggleButtonStyle}" Tag="Xml" />
                                            <RadioButton x:Name="RadioFormatNone" Margin="2,0,0,0" Click="PackSetting_Click" Content="{DynamicResource Str_SpritePacker_FormatNone}" GroupName="SpFormat" Style="{StaticResource ModeToggleButtonStyle}" Tag="None" />
                                        </UniformGrid>
                                        <TextBlock x:Name="TxtFormatHint" Style="{StaticResource SpSideHint}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!--  ================= SLICE ================  -->
                            <StackPanel x:Name="SliceSidebar" Visibility="Collapsed">

                                <!--  ============ SHEET ============  -->
                                <Border Style="{StaticResource SidebarGroupCardStyle}">
                                    <StackPanel>
                                        <ContentControl Content="{DynamicResource Str_SpritePacker_SheetHeader}" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.ImageOutline}" />
                                        <Border
                                            x:Name="SheetDropArea"
                                            MinHeight="64"
                                            Margin="0,0,0,10"
                                            AllowDrop="True"
                                            Background="{DynamicResource SidebarInputBg}"
                                            BorderBrush="{DynamicResource SidebarInputBorder}"
                                            BorderThickness="1"
                                            CornerRadius="10"
                                            DragLeave="SheetDrop_DragLeave"
                                            DragOver="SheetDrop_DragOver"
                                            Drop="SheetDrop_Drop">
                                            <StackPanel Margin="10,10" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <materialDesign:PackIcon x:Name="SheetIcon" Width="22" Height="22" HorizontalAlignment="Center" Foreground="{DynamicResource SidebarTextMuted}" Kind="TrayArrowDown" />
                                                <TextBlock x:Name="TxtSheetName" Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource SidebarText}" Text="{DynamicResource Str_SpritePacker_DropSheet}" TextAlignment="Center" TextTrimming="CharacterEllipsis" TextWrapping="Wrap" />
                                                <TextBlock x:Name="TxtSheetInfo" Margin="0,2,0,0" HorizontalAlignment="Center" FontSize="10.5" Foreground="{DynamicResource SidebarTextMuted}" TextAlignment="Center" />
                                            </StackPanel>
                                        </Border>
                                        <Button x:Name="BtnChooseSheet" Click="BtnChooseSheet_Click" Style="{StaticResource PrimaryButtonStyle}">
                                            <Grid HorizontalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon Grid.Column="0" Width="16" Height="16" Margin="0,0,6,0" VerticalAlignment="Center" Kind="FolderOpenOutline" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_SpritePacker_ChooseSheet}" TextWrapping="Wrap" />
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                </Border>

                                <!--  ============ GRID ============  -->
                                <Border Style="{StaticResource SidebarGroupCardStyle}">
                                    <StackPanel>
                                        <ContentControl Content="{DynamicResource Str_SpritePacker_GridHeader}" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.ViewGridOutline}" />
                                        <UniformGrid Columns="2">
                                            <RadioButton x:Name="RadioSplitCount" Margin="0,0,2,0" Click="SliceSetting_Click" Content="{DynamicResource Str_SpritePacker_SplitCount}" GroupName="SpSplit" IsChecked="True" Style="{StaticResource ModeToggleButtonStyle}" Tag="ByCount" />
                                            <RadioButton x:Name="RadioSplitCell" Margin="2,0,0,0" Click="SliceSetting_Click" Content="{DynamicResource Str_SpritePacker_SplitCell}" GroupName="SpSplit" Style="{StaticResource ModeToggleButtonStyle}" Tag="ByCellSize" />
                                        </UniformGrid>
                                        <Grid x:Name="CountPanel" Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Margin="2,0,0,4" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SidebarText}" Text="{DynamicResource Str_SpritePacker_Columns}" />
                                                <Border Style="{StaticResource InputBarStyle}">
                                                    <TextBox x:Name="TxtColumns" VerticalContentAlignment="Center" Style="{StaticResource BareTextBox}" Text="4" TextChanged="SliceSetting_TextChanged" />
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Margin="2,0,0,4" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SidebarText}" Text="{DynamicResource Str_SpritePacker_Rows}" />
                                                <Border Style="{StaticResource InputBarStyle}">
                                                    <TextBox x:Name="TxtRows" VerticalContentAlignment="Center" Style="{StaticResource BareTextBox}" Text="4" TextChanged="SliceSetting_TextChanged" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                        <Grid x:Name="CellPanel" Margin="0,10,0,0" Visibility="Collapsed">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Margin="2,0,0,4" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SidebarText}" Text="{DynamicResource Str_SpritePacker_CellWidth}" />
                                                <Border Style="{StaticResource InputBarStyle}">
                                                    <TextBox x:Name="TxtCellWidth" VerticalContentAlignment="Center" Style="{StaticResource BareTextBox}" Text="32" TextChanged="SliceSetting_TextChanged" />
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Margin="2,0,0,4" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SidebarText}" Text="{DynamicResource Str_SpritePacker_CellHeight}" />
                                                <Border Style="{StaticResource InputBarStyle}">
                                                    <TextBox x:Name="TxtCellHeight" VerticalContentAlignment="Center" Style="{StaticResource BareTextBox}" Text="32" TextChanged="SliceSetting_TextChanged" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                        <Grid Margin="0,10,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="8" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <StackPanel>
                                                <TextBlock Margin="2,0,0,4" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SidebarText}" Text="{DynamicResource Str_SpritePacker_Margin}" />
                                                <Border Style="{StaticResource InputBarStyle}">
                                                    <TextBox x:Name="TxtMargin" VerticalContentAlignment="Center" Style="{StaticResource BareTextBox}" Text="0" TextChanged="SliceSetting_TextChanged" />
                                                </Border>
                                            </StackPanel>
                                            <StackPanel Grid.Column="2">
                                                <TextBlock Margin="2,0,0,4" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource SidebarText}" Text="{DynamicResource Str_SpritePacker_Spacing}" />
                                                <Border Style="{StaticResource InputBarStyle}">
                                                    <TextBox x:Name="TxtSpacing" VerticalContentAlignment="Center" Style="{StaticResource BareTextBox}" Text="0" TextChanged="SliceSetting_TextChanged" />
                                                </Border>
                                            </StackPanel>
                                        </Grid>
                                        <TextBlock x:Name="TxtSliceNumbersError" Margin="2,6,0,0" FontSize="10.5" Foreground="{DynamicResource StatusErrorFg}" Text="{DynamicResource Str_SpritePacker_NumbersBad}" TextWrapping="Wrap" Visibility="Collapsed" />
                                        <TextBlock x:Name="TxtSliceInfo" Style="{StaticResource SpSideHint}" />

                                        <CheckBox x:Name="ChkSkipEmpty" Margin="0,12,0,0" Click="SliceSetting_Click" Foreground="{DynamicResource SidebarText}" IsChecked="True">
                                            <TextBlock Text="{DynamicResource Str_SpritePacker_SkipEmpty}" TextWrapping="Wrap" />
                                        </CheckBox>
                                        <TextBlock Style="{StaticResource SpSideHint}" Text="{DynamicResource Str_SpritePacker_SkipEmptyHint}" />

                                        <TextBlock Style="{StaticResource SpSideLabel}" Text="{DynamicResource Str_SpritePacker_NamePrefix}" />
                                        <Border Style="{StaticResource InputBarStyle}">
                                            <TextBox x:Name="TxtPrefix" VerticalContentAlignment="Center" Style="{StaticResource BareTextBox}" Text="sprite" TextChanged="SliceSetting_TextChanged" />
                                        </Border>
                                        <TextBlock x:Name="TxtPrefixExample" Style="{StaticResource SpSideHint}" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <!--  ============ SAVE TO ============  -->
                            <controls:OutputFolderCard
                                ctl:Tour.Key="Str_Tour_SpritePacker_Output" ctl:Tour.Order="3"
                                x:Name="OutputCard"
                                Margin="0,10,0,0"
                                AllowAskEachTime="True"
                                DefaultFileName="spritesheet"
                                FileExtension=".png"
                                Header="{DynamicResource Str_SpritePacker_SaveTo}"
                                HeaderIcon="ContentSaveOutline"
                                ShowFileName="True"
                                ToolName="Sprite Packer" />
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--  ================= MAIN =================  -->

            <Border ctl:Tour.Key="Str_Tour_SpritePacker_Preview" ctl:Tour.Order="5" Grid.Column="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!--  Header: stats, saved pill  -->
                    <Grid Margin="0,0,0,10">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentControl x:Name="HeaderTitle" VerticalAlignment="Center" Content="{DynamicResource Str_SpritePacker_ModePack}" Style="{StaticResource CardHeader}" Tag="{x:Static materialDesign:PackIconKind.ViewGridPlusOutline}" />
                        <WrapPanel Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center">
                            <Border x:Name="PillCount" Margin="0,0,6,0" Background="{DynamicResource RowBg}" Style="{StaticResource IconStatusPillStyle}">
                                <TextBlock x:Name="TxtPillCount" Style="{StaticResource SpPillText}" />
                            </Border>
                            <Border x:Name="PillSize" Margin="0,0,6,0" Background="{DynamicResource RowBg}" Style="{StaticResource IconStatusPillStyle}" Visibility="Collapsed">
                                <TextBlock x:Name="TxtPillSize" Style="{StaticResource SpPillText}" />
                            </Border>
                            <Border x:Name="PillUsed" Margin="0,0,6,0" Background="{DynamicResource AccentColorSubtle}" Style="{StaticResource IconStatusPillStyle}" Visibility="Collapsed">
                                <TextBlock x:Name="TxtPillUsed" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource AccentColor}" />
                            </Border>
                            <Border x:Name="PillWorking" Margin="0,0,6,0" Background="{DynamicResource RowBg}" Style="{StaticResource IconStatusPillStyle}" Visibility="Collapsed">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource TextSecondary}" Kind="Autorenew" />
                                    <TextBlock Style="{StaticResource SpPillText}" Text="{DynamicResource Str_SpritePacker_Working}" />
                                </StackPanel>
                            </Border>
                        </WrapPanel>
                        <Border x:Name="DonePill" Grid.Column="2" VerticalAlignment="Center" Background="{DynamicResource StatusSuccessBg}" Style="{StaticResource IconStatusPillStyle}" Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon Width="13" Height="13" Margin="0,0,5,0" VerticalAlignment="Center" Foreground="{DynamicResource StatusSuccessFg}" Kind="Check" />
                                <TextBlock x:Name="TxtDonePill" FontSize="11.5" FontWeight="SemiBold" Foreground="{DynamicResource StatusSuccessFg}" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!--  Messages  -->
                    <Border x:Name="StatusBanner" Grid.Row="1" Margin="0,0,0,10" Padding="12,9" HorizontalAlignment="Left" CornerRadius="10" Visibility="Collapsed">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon x:Name="StatusIcon" Width="16" Height="16" Margin="0,1,8,0" VerticalAlignment="Top" />
                            <TextBlock x:Name="TxtStatus" MaxWidth="760" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>

                    <!--  ============ PACK CONTENT ============  -->
                    <Grid x:Name="PackContent" Grid.Row="2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" MinWidth="250" MaxWidth="360" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="2*" />
                        </Grid.ColumnDefinitions>

                        <!--  Sprite list  -->
                        <Grid
                            x:Name="ListArea"
                            AllowDrop="True"
                            Background="Transparent"
                            DragLeave="ListArea_DragLeave"
                            DragOver="ListArea_DragOver"
                            Drop="ListArea_Drop">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <WrapPanel Margin="0,0,0,8">
                                <Button x:Name="BtnMoveUp" Width="32" Height="32" Margin="0,0,4,4" Click="BtnMoveUp_Click" Style="{StaticResource NeutralIconButtonStyle}" ToolTip="{DynamicResource Str_SpritePacker_MoveUp}">
                                    <materialDesign:PackIcon Width="16" Height="16" Kind="ArrowUp" />
                                </Button>
                                <Button x:Name="BtnMoveDown" Width="32" Height="32" Margin="0,0,4,4" Click="BtnMoveDown_Click" Style="{StaticResource NeutralIconButtonStyle}" ToolTip="{DynamicResource Str_SpritePacker_MoveDown}">
                                    <materialDesign:PackIcon Width="16" Height="16" Kind="ArrowDown" />
                                </Button>
                                <Button x:Name="BtnSortName" Width="32" Height="32" Margin="0,0,4,4" Click="BtnSortName_Click" Style="{StaticResource NeutralIconButtonStyle}" ToolTip="{DynamicResource Str_SpritePacker_SortName}">
                                    <materialDesign:PackIcon Width="16" Height="16" Kind="SortAlphabeticalAscending" />
                                </Button>
                                <Button x:Name="BtnRemoveSelected" Margin="0,0,4,4" Click="BtnRemoveSelected_Click" ToolTip="{DynamicResource Str_SpritePacker_RemoveSelected}" Style="{StaticResource ListToolButtonStyle}"><materialDesign:PackIcon Width="16" Height="16" Kind="PlaylistRemove" /></Button>
                            </WrapPanel>
                            <Border Grid.Row="1" Background="{DynamicResource RowBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="12">
                                <Grid>
                                    <ListBox
                                        x:Name="SpriteList"
                                        Padding="6"
                                        Background="Transparent"
                                        BorderThickness="0"
                                        ItemTemplate="{StaticResource SpriteTemplate}"
                                        KeyDown="SpriteList_KeyDown"
                                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                                        SelectionChanged="SpriteList_SelectionChanged"
                                        SelectionMode="Extended"
                                        VirtualizingPanel.IsVirtualizing="True" />
                                    <StackPanel x:Name="ListEmpty" MaxWidth="240" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.ImageMultipleOutline}" />
                                        <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource Str_SpritePacker_EmptyTitle}" />
                                        <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource Str_SpritePacker_EmptyHint}" TextAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>

                        <!--  Sheet preview  -->
                        <Grid Grid.Column="2">
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                            </Grid.RowDefinitions>
                            <Grid Margin="0,0,0,8" MinHeight="32">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel x:Name="PageNav" Orientation="Horizontal" Visibility="Collapsed">
                                    <Button x:Name="BtnPrevPage" Width="32" Height="32" Margin="0,0,4,0" Click="BtnPrevPage_Click" Style="{StaticResource NeutralIconButtonStyle}">
                                        <materialDesign:PackIcon Width="16" Height="16" Kind="ChevronLeft" />
                                    </Button>
                                    <TextBlock x:Name="TxtPageLabel" Margin="6,0,10,0" VerticalAlignment="Center" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
                                    <Button x:Name="BtnNextPage" Width="32" Height="32" Click="BtnNextPage_Click" Style="{StaticResource NeutralIconButtonStyle}">
                                        <materialDesign:PackIcon Width="16" Height="16" Kind="ChevronRight" />
                                    </Button>
                                </StackPanel>
                                <TextBlock x:Name="TxtHover" Grid.Column="1" Margin="12,0,0,0" VerticalAlignment="Center" FontFamily="Cascadia Mono, Consolas" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextTrimming="CharacterEllipsis" />
                            </Grid>
                            <Border Grid.Row="1" Background="{DynamicResource RowBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="12">
                                <Grid>
                                                                            <Viewbox x:Name="SheetViewbox" Margin="14" Stretch="Uniform" StretchDirection="Both">
                                            <Grid x:Name="SheetGrid" MouseLeave="SheetGrid_MouseLeave" MouseLeftButtonDown="SheetGrid_MouseLeftButtonDown" MouseMove="SheetGrid_MouseMove">
                                                <Grid.Background>
                                                <DrawingBrush TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
                                                    <DrawingBrush.Drawing>
                                                        <DrawingGroup>
                                                            <GeometryDrawing Brush="{DynamicResource InputBg}"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,16,16" /></GeometryDrawing.Geometry></GeometryDrawing>
                                                            <GeometryDrawing Brush="{DynamicResource InputBorder}"><GeometryDrawing.Geometry><GeometryGroup><RectangleGeometry Rect="0,0,8,8" /><RectangleGeometry Rect="8,8,8,8" /></GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing>
                                                        </DrawingGroup>
                                                    </DrawingBrush.Drawing>
                                                </DrawingBrush>
                                            </Grid.Background>
                                                <Image x:Name="SheetImage" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Fill" />
                                                <Canvas x:Name="HighlightLayer" IsHitTestVisible="False">
                                                    <Rectangle x:Name="SelectRect" Fill="#331E88E5" Stroke="#FF1E88E5" Visibility="Collapsed" />
                                                    <Rectangle x:Name="HoverRect" Fill="#33FFFFFF" Stroke="#FFFFFFFF" Visibility="Collapsed" />
                                                </Canvas>
                                            </Grid>
                                        </Viewbox>

                                    <StackPanel x:Name="PreviewEmpty" MaxWidth="300" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                        <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.ViewGridPlusOutline}" />
                                        <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource Str_SpritePacker_PreviewEmptyTitle}" />
                                        <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource Str_SpritePacker_PreviewEmptyHint}" TextAlignment="Center" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                        </Grid>
                    </Grid>

                    <!--  ============ SLICE CONTENT ============  -->
                    <Grid x:Name="SliceContent" Grid.Row="2" AllowDrop="True" Background="Transparent" DragLeave="SheetDrop_DragLeave" DragOver="SheetDrop_DragOver" Drop="SheetDrop_Drop" Visibility="Collapsed">
                        <Border Background="{DynamicResource RowBg}" BorderBrush="{DynamicResource CardBorder}" BorderThickness="1" CornerRadius="12">
                            <Grid>
                                                                    <Viewbox x:Name="SliceViewbox" Margin="14" Stretch="Uniform" StretchDirection="Both">
                                        <Grid x:Name="SliceGrid">
                                            <Grid.Background>
                                                <DrawingBrush TileMode="Tile" Viewport="0,0,16,16" ViewportUnits="Absolute">
                                                    <DrawingBrush.Drawing>
                                                        <DrawingGroup>
                                                            <GeometryDrawing Brush="{DynamicResource InputBg}"><GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,16,16" /></GeometryDrawing.Geometry></GeometryDrawing>
                                                            <GeometryDrawing Brush="{DynamicResource InputBorder}"><GeometryDrawing.Geometry><GeometryGroup><RectangleGeometry Rect="0,0,8,8" /><RectangleGeometry Rect="8,8,8,8" /></GeometryGroup></GeometryDrawing.Geometry></GeometryDrawing>
                                                        </DrawingGroup>
                                                    </DrawingBrush.Drawing>
                                                </DrawingBrush>
                                            </Grid.Background>
                                            <Image x:Name="SliceImage" RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Fill" />
                                            <Path x:Name="SkipPath" Fill="#99000000" IsHitTestVisible="False" />
                                            <Path x:Name="CellsPath" Stroke="#FF1E88E5" IsHitTestVisible="False" />
                                        </Grid>
                                    </Viewbox>

                                <StackPanel x:Name="SliceEmpty" MaxWidth="320" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                    <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.ContentCut}" />
                                    <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource Str_SpritePacker_SliceEmptyTitle}" />
                                    <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource Str_SpritePacker_SliceEmptyHint}" TextAlignment="Center" TextWrapping="Wrap" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </Grid>

                    <!--  Action bar  -->
                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock x:Name="TxtActionInfo" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextWrapping="Wrap" />
                            <ProgressBar x:Name="RunProgress" Height="4" Margin="0,6,12,0" Maximum="100" Visibility="Collapsed" />
                        </StackPanel>
                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button x:Name="BtnOpenResult" Margin="0,0,8,0" Click="BtnOpenResult_Click" ToolTip="{DynamicResource Str_SpritePacker_OpenResult}" Visibility="Collapsed" Style="{StaticResource ListToolButtonStyle}"><materialDesign:PackIcon Width="16" Height="16" Kind="FolderOpenOutline" /></Button>
                            <Button ctl:Tour.Key="Str_Tour_SpritePacker_Run" ctl:Tour.Order="4" x:Name="BtnRun" MinHeight="36" Click="BtnRun_Click" Style="{StaticResource AccentPrimaryButtonStyle}">
                                <Grid HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon Grid.Column="0" x:Name="IconRun" Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center" Kind="ContentSaveOutline" />
                                    <TextBlock Grid.Column="1" x:Name="TxtRun" VerticalAlignment="Center" Text="{DynamicResource Str_SpritePacker_SaveSheet}" TextWrapping="Wrap" />
                                </Grid>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
