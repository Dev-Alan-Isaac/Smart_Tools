<UserControl
    x:Class="Smart_Tools.WPF.Views.BatteryHealthView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    x:Name="Root"
    Focusable="True"
    Loaded="Root_Loaded"
    Unloaded="Root_Unloaded">

    <!--  Backend: Controllers/BatteryHealthManager.cs (WMI reading, wear level, Windows battery report). UI only here.  -->

    <UserControl.Resources>
        <!--  One battery: a big health card and a details card side by side  -->
        <DataTemplate x:Key="BatteryTemplate">
            <Grid MinHeight="220" Margin="0,0,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" MinWidth="280" />
                    <ColumnDefinition Width="14" />
                    <ColumnDefinition Width="1.4*" MinWidth="300" />
                </Grid.ColumnDefinitions>

                <Border Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>
                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Row="1" VerticalAlignment="Center">
                            <Viewbox MaxHeight="120" HorizontalAlignment="Left" Stretch="Uniform">
                                <TextBlock FontSize="80" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Text="{Binding HealthText}" />
                            </Viewbox>
                            <TextBlock FontSize="12" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Text="BATTERY HEALTH" />
                        </StackPanel>
                        <StackPanel Grid.Row="2">
                            <ProgressBar Height="10" Maximum="100" Value="{Binding HealthValue, Mode=OneWay}" />
                            <TextBlock Margin="0,10,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource AccentColor}" Text="{Binding Verdict}" TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Grid.Column="2" Style="{StaticResource CardStyle}">
                    <StackPanel>
                        <ContentControl Margin="0,0,0,8" Content="Details" Style="{StaticResource CardHeader}" Tag="{x:Static materialDesign:PackIconKind.FormatListBulleted}" />
                        <ItemsControl ItemsSource="{Binding Rows}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,5">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="200" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock FontSize="12.5" Foreground="{DynamicResource TextSecondary}" Text="{Binding Label}" />
                                        <TextBlock Grid.Column="1" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding Value}" TextWrapping="Wrap" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">
        <Grid Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= OPTIONS SIDEBAR =================  -->
            <controls:ToolSidebar>
                <StackPanel>
                    <Border ctl:Tour.Key="Str_Tour_BatteryHealth_Actions" ctl:Tour.Order="2" Margin="0,0,0,10" Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl Content="ACTIONS" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.LightningBoltOutline}" />
                            <Button ctl:Tour.Key="Str_Tour_BatteryHealth_Refresh" ctl:Tour.Order="3" x:Name="BtnRefresh" MinHeight="36" Margin="0,10,0,0" Click="BtnRefresh_Click" ToolTip="Read the battery again">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,6,0" Kind="Refresh" />
                                    <TextBlock Text="Refresh" />
                                </StackPanel>
                            </Button>
                            <Button ctl:Tour.Key="Str_Tour_BatteryHealth_Report" ctl:Tour.Order="4" x:Name="BtnReport" MinHeight="36" Margin="0,8,0,0" Click="BtnReport_Click" ToolTip="Make Windows' own detailed battery report and open it">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,6,0" Kind="FileChartOutline" />
                                    <TextBlock x:Name="TxtReport" Text="Windows battery report" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border ctl:Tour.Key="Str_Tour_BatteryHealth_About" ctl:Tour.Order="5" Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl Content="ABOUT THE NUMBERS" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.InformationOutline}" />
                            <TextBlock x:Name="TxtNote" Margin="2,8,0,0" FontSize="10.5" Foreground="{DynamicResource SidebarTextMuted}" TextWrapping="Wrap" Text="Health is the battery's full-charge capacity compared with the capacity it was designed for. Some laptops don't report every value. 80 % or more is normal wear; under 60 % is worth a replacement." />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </controls:ToolSidebar>

            <!--  ================= MAIN AREA =================  -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="StatusBanner" Margin="0,0,0,14" Padding="12,9" HorizontalAlignment="Left" CornerRadius="10" Visibility="Collapsed">
                    <TextBlock x:Name="TxtStatus" MaxWidth="900" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                </Border>

                <Grid Grid.Row="1">
                    <!--  One battery fills the height; several share it.  -->
                    <ItemsControl ctl:Tour.Key="Str_Tour_BatteryHealth_Details" ctl:Tour.Order="1" x:Name="BatteryList" ItemTemplate="{StaticResource BatteryTemplate}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="1" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                    </ItemsControl>
                    <Border x:Name="PanelNone" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                        <StackPanel MaxWidth="360" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.BatteryOff}" />
                            <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="No battery found" />
                            <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="This PC doesn't report a battery - that is normal for a desktop." TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
