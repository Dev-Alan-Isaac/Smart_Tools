<UserControl
    x:Class="Smart_Tools.WPF.Views.BatteryHealthView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    x:Name="Root"
    Focusable="True"
    Loaded="Root_Loaded"
    Unloaded="Root_Unloaded">

    <!--  Backend: Controllers/BatteryHealthManager.cs (WMI reading, wear level, Windows battery report). UI only here.  -->

    <UserControl.Resources>
        <!--
            A progress bar drawn as a battery: outline, terminal nub on the right, and a fill as long as the health.
            It stretches to whatever space it is given. The fill takes the bar's Foreground, which the card sets from
            the health level (green, amber, red).
        -->
        <Style x:Key="BatteryGaugeStyle" TargetType="ProgressBar">
            <Setter Property="Minimum" Value="0" />
            <Setter Property="Maximum" Value="100" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ProgressBar">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                            </Grid.ColumnDefinitions>
                            <Border BorderBrush="{DynamicResource TextSecondary}" BorderThickness="4" CornerRadius="22" Background="{DynamicResource RowBg}" Padding="7">
                                <Border x:Name="PART_Track" CornerRadius="15">
                                    <Border x:Name="PART_Indicator" HorizontalAlignment="Left" Background="{TemplateBinding Foreground}" CornerRadius="15" />
                                </Border>
                            </Border>
                            <Grid Grid.Column="1">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="2*" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <Border Grid.Row="1" Margin="3,0,0,0" Background="{DynamicResource TextSecondary}" CornerRadius="0,9,9,0" />
                            </Grid>
                        </Grid>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  One battery fills its share of the page: the battery bar with its percentage, then the numbers as tiles that share the rest  -->
        <DataTemplate x:Key="BatteryTemplate">
            <Border MinHeight="330" Margin="0,0,0,14" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="2*" MinHeight="120" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1.5*" MinHeight="120" />
                    </Grid.RowDefinitions>

                    <TextBlock Margin="0,0,0,12" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />

                    <Grid Grid.Row="1">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="20" />
                            <ColumnDefinition Width="*" MinWidth="170" />
                        </Grid.ColumnDefinitions>

                        <ProgressBar x:Name="Gauge" Value="{Binding HealthValue, Mode=OneWay}" Style="{StaticResource BatteryGaugeStyle}" ToolTip="{Binding Verdict}" />

                        <Viewbox Grid.Column="2" HorizontalAlignment="Left" VerticalAlignment="Center" Stretch="Uniform">
                            <StackPanel>
                                <TextBlock FontSize="64" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Text="{Binding HealthText}" />
                                <TextBlock FontSize="13" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource Str_BatteryHealth_BatteryHealth}" />
                            </StackPanel>
                        </Viewbox>
                    </Grid>

                    <Border x:Name="VerdictPill" Grid.Row="2" Margin="0,14,0,14" Padding="12,7" HorizontalAlignment="Left" Background="{DynamicResource RowBg}" CornerRadius="9">
                        <TextBlock x:Name="VerdictText" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Text="{Binding Verdict}" TextWrapping="Wrap" />
                    </Border>

                    <ItemsControl Grid.Row="3" ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="4" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border MinHeight="64" Margin="0,0,10,10" Padding="14,10" Background="{DynamicResource RowBg}" CornerRadius="12">
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" />
                                        <TextBlock Margin="0,3,0,0" FontSize="18" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding Value}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Good">
                    <Setter TargetName="Gauge" Property="Foreground" Value="{DynamicResource StatusSuccessFg}" />
                    <Setter TargetName="VerdictPill" Property="Background" Value="{DynamicResource StatusSuccessBg}" />
                    <Setter TargetName="VerdictText" Property="Foreground" Value="{DynamicResource StatusSuccessFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Fair">
                    <Setter TargetName="Gauge" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                    <Setter TargetName="VerdictPill" Property="Background" Value="{DynamicResource StatusWarningBg}" />
                    <Setter TargetName="VerdictText" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Poor">
                    <Setter TargetName="Gauge" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                    <Setter TargetName="VerdictPill" Property="Background" Value="{DynamicResource StatusErrorBg}" />
                    <Setter TargetName="VerdictText" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
        <!--  With several batteries each card is small: a short battery bar, the percentage and the verdict on one line, the numbers as small tiles  -->
        <DataTemplate x:Key="BatteryCompactTemplate">
            <Border Margin="0,0,0,12" Padding="16,12" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock Margin="0,0,0,8" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Text="{Binding Title}" TextTrimming="CharacterEllipsis" />

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <ProgressBar x:Name="Gauge" Width="230" Height="62" Value="{Binding HealthValue, Mode=OneWay}" Style="{StaticResource BatteryGaugeStyle}" ToolTip="{Binding Verdict}" />

                        <StackPanel Grid.Column="1" Margin="18,0,18,0" VerticalAlignment="Center">
                            <TextBlock FontSize="30" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Text="{Binding HealthText}" />
                            <TextBlock FontSize="10.5" FontWeight="Bold" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource Str_BatteryHealth_Health}" />
                        </StackPanel>

                        <Border x:Name="VerdictPill" Grid.Column="2" Padding="10,6" HorizontalAlignment="Left" VerticalAlignment="Center" Background="{DynamicResource RowBg}" CornerRadius="8">
                            <TextBlock x:Name="VerdictText" FontSize="12.5" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" Text="{Binding Verdict}" TextWrapping="Wrap" />
                        </Border>
                    </Grid>

                    <ItemsControl Margin="0,12,-6,0" ItemsSource="{Binding Rows}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <WrapPanel />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Border MinWidth="130" Margin="0,0,6,6" Padding="10,6" Background="{DynamicResource RowBg}" CornerRadius="9">
                                    <StackPanel>
                                        <TextBlock FontSize="10.5" Foreground="{DynamicResource TextSecondary}" Text="{Binding Label}" TextTrimming="CharacterEllipsis" ToolTip="{Binding Label}" />
                                        <TextBlock Margin="0,1,0,0" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding Value}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Level}" Value="Good">
                    <Setter TargetName="Gauge" Property="Foreground" Value="{DynamicResource StatusSuccessFg}" />
                    <Setter TargetName="VerdictPill" Property="Background" Value="{DynamicResource StatusSuccessBg}" />
                    <Setter TargetName="VerdictText" Property="Foreground" Value="{DynamicResource StatusSuccessFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Fair">
                    <Setter TargetName="Gauge" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                    <Setter TargetName="VerdictPill" Property="Background" Value="{DynamicResource StatusWarningBg}" />
                    <Setter TargetName="VerdictText" Property="Foreground" Value="{DynamicResource StatusWarningFg}" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Level}" Value="Poor">
                    <Setter TargetName="Gauge" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                    <Setter TargetName="VerdictPill" Property="Background" Value="{DynamicResource StatusErrorBg}" />
                    <Setter TargetName="VerdictText" Property="Foreground" Value="{DynamicResource StatusErrorFg}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>

        <ItemsPanelTemplate x:Key="BatteryFillPanel">
            <UniformGrid Columns="1" />
        </ItemsPanelTemplate>

        <ItemsPanelTemplate x:Key="BatteryStackPanel">
            <StackPanel />
        </ItemsPanelTemplate>
    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">
        <Grid Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= OPTIONS SIDEBAR =================  -->
            <controls:ToolSidebar>
                <StackPanel>
                    <Border ctl:Tour.Key="Str_Tour_BatteryHealth_Actions" ctl:Tour.Order="2" Margin="0,0,0,10" Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl Content="{DynamicResource Str_BatteryHealth_Actions}" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.LightningBoltOutline}" />
                            <Button ctl:Tour.Key="Str_Tour_BatteryHealth_Refresh" ctl:Tour.Order="3" x:Name="BtnRefresh" MinHeight="36" Margin="0,10,0,0" Click="BtnRefresh_Click" ToolTip="{DynamicResource Str_BatteryHealth_ReadTheBatteryAgain}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,6,0" Kind="Refresh" />
                                    <TextBlock Text="{DynamicResource Str_Common_Refresh}" />
                                </StackPanel>
                            </Button>
                            <Button ctl:Tour.Key="Str_Tour_BatteryHealth_Report" ctl:Tour.Order="4" x:Name="BtnReport" MinHeight="36" Margin="0,8,0,0" Click="BtnReport_Click" ToolTip="{DynamicResource Str_BatteryHealth_MakeWindowsOwnDetailed}">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon Width="16" Height="16" Margin="0,0,6,0" Kind="FileChartOutline" />
                                    <TextBlock x:Name="TxtReport" Text="{DynamicResource Str_BatteryHealth_WindowsBatteryReport}" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Border>

                    <Border ctl:Tour.Key="Str_Tour_BatteryHealth_About" ctl:Tour.Order="5" Style="{StaticResource SidebarGroupCardStyle}">
                        <StackPanel>
                            <ContentControl Content="{DynamicResource Str_BatteryHealth_AboutTheNumbers}" Style="{StaticResource SidebarGroupHeader}" Tag="{x:Static materialDesign:PackIconKind.InformationOutline}" />
                            <TextBlock x:Name="TxtNote" Margin="2,8,0,0" FontSize="10.5" Foreground="{DynamicResource SidebarTextMuted}" TextWrapping="Wrap" Text="{DynamicResource Str_BatteryHealth_HealthIsTheBattery}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </controls:ToolSidebar>

            <!--  ================= MAIN AREA =================  -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border x:Name="StatusBanner" Margin="0,0,0,14" Padding="12,9" HorizontalAlignment="Left" CornerRadius="10" Visibility="Collapsed">
                    <TextBlock x:Name="TxtStatus" MaxWidth="900" FontSize="12.5" FontWeight="SemiBold" TextWrapping="Wrap" />
                </Border>

                <Grid Grid.Row="1">
                    <!--
                        Each battery is its own card. One battery fills the whole page; several share it equally.
                        If the window is too short for them, the page scrolls instead of squeezing them.
                    -->
                    <ScrollViewer x:Name="BatteryScroll" SizeChanged="BatteryScroll_SizeChanged" VerticalScrollBarVisibility="Auto">
                        <ItemsControl
                            ctl:Tour.Key="Str_Tour_BatteryHealth_Details"
                            ctl:Tour.Order="1"
                            x:Name="BatteryList"
                            ItemTemplate="{StaticResource BatteryTemplate}"
                            ItemsPanel="{StaticResource BatteryFillPanel}" />
                    </ScrollViewer>
                    <Border x:Name="PanelNone" Style="{StaticResource CardStyle}" Visibility="Collapsed">
                        <StackPanel MaxWidth="360" HorizontalAlignment="Center" VerticalAlignment="Center">
                            <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.BatteryOff}" />
                            <TextBlock Margin="0,12,0,0" HorizontalAlignment="Center" FontSize="14" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{DynamicResource Str_BatteryHealth_NoBatteryFound}" />
                            <TextBlock Margin="0,6,0,0" HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{DynamicResource Str_BatteryHealth_ThisPcDoesnT}" TextAlignment="Center" TextWrapping="Wrap" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
