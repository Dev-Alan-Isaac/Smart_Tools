<UserControl
    x:Class="Smart_Tools.WPF.Views.MonitorTestView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    x:Name="Root"
    Loaded="Root_Loaded">

    <!--
        Backend: Controllers/MonitorTestManager.cs (pictures, numbers, timing), .Windows.cs (screens, refresh probe),
        Models/MonitorTestModel.cs. The pictures are Controls/MonitorPatternSurface.cs, shown full-screen by
        Views/MonitorTestWindow.cs. UI only here.
    -->

    <Grid Background="{DynamicResource ContentBg}">
        <Grid Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OptionsColumn" Width="280" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= OPTIONS SIDEBAR =================  -->
            <Border Grid.Column="0" Style="{StaticResource SidebarPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Button
                            x:Name="BtnCollapseOptions"
                            MinHeight="45"
                            HorizontalContentAlignment="Left"
                            Click="BtnCollapseOptions_Click"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Foreground="{DynamicResource SidebarText}"
                            ToolTip="{DynamicResource Str_Common_SidebarToggleTooltip}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="OverridesDefaultStyle" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Margin="16,0,0,0" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Kind="TuneVariant" />
                                <TextBlock
                                    x:Name="TxtOptionsHeaderLabel"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{DynamicResource Str_Common_OptionsLabel}" />
                            </StackPanel>
                        </Button>
                        <Separator
                            x:Name="SepHeader"
                            Margin="16,4"
                            Style="{StaticResource SidebarSeparatorStyle}" />
                    </StackPanel>

                    <ScrollViewer
                        x:Name="OptionsScrollViewer"
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16">

                            <!--  ============ SCREEN ============  -->
                            <Border ctl:Tour.Key="Str_Tour_MonitorTest_Screen" ctl:Tour.Order="1" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Monitor_ScreenHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.Monitor}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox
                                            x:Name="CmbScreen"
                                            SelectionChanged="CmbScreen_SelectionChanged"
                                            ToolTip="{DynamicResource Str_Monitor_ScreenTip}" />
                                        <Button
                                            Grid.Column="1"
                                            Margin="6,0,0,0"
                                            Click="BtnRefreshScreens_Click"
                                            Style="{StaticResource NeutralIconButtonStyle}"
                                            ToolTip="{DynamicResource Str_Monitor_RefreshScreens}">
                                            <materialDesign:PackIcon
                                                Width="16"
                                                Height="16"
                                                Kind="Refresh" />
                                        </Button>
                                    </Grid>
                                    <TextBlock
                                        x:Name="TxtScreenInfo"
                                        Margin="0,8,0,0"
                                        FontSize="11.5"
                                        Foreground="{DynamicResource SidebarText}"
                                        Opacity="0.85"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!--  ============ SLIDESHOW ============  -->
                            <Border ctl:Tour.Key="Str_Tour_MonitorTest_Play" ctl:Tour.Order="2" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Monitor_PlayHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.PlayCircleOutline}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Style="{DynamicResource FieldLabel}"
                                            Text="{DynamicResource Str_Monitor_Slideshow}" />
                                        <Border
                                            Grid.Column="1"
                                            Padding="7,1"
                                            Background="{DynamicResource AccentFill}"
                                            CornerRadius="8">
                                            <TextBlock
                                                x:Name="TxtSlideshow"
                                                FontSize="10.5"
                                                FontWeight="SemiBold"
                                                Foreground="White"
                                                Text="{DynamicResource Str_AudioTrimmer_NormOff}" />
                                        </Border>
                                    </Grid>
                                    <Slider
                                        x:Name="SliderSlideshow"
                                        Margin="0,4,0,0"
                                        IsSnapToTickEnabled="True"
                                        LargeChange="5"
                                        Maximum="30"
                                        Minimum="0"
                                        SmallChange="1"
                                        TickFrequency="1"
                                        ToolTip="{DynamicResource Str_Monitor_SlideshowTip}"
                                        ValueChanged="SliderSlideshow_ValueChanged"
                                        Value="0" />
                                    <CheckBox
                                        x:Name="ChkHints"
                                        Margin="0,12,0,0"
                                        Checked="Option_Changed"
                                        Content="{DynamicResource Str_Monitor_ShowHints}"
                                        Foreground="{DynamicResource SidebarText}"
                                        IsChecked="True"
                                        Unchecked="Option_Changed"
                                        controls:ChoiceIcon.Kind="Keyboard"
                                        Style="{StaticResource ToggleChipCheckBoxStyle}" />
                                </StackPanel>
                            </Border>

                            <!--  ============ TIPS ============  -->
                            <Border
                                Margin="0,4,0,0"
                                Padding="10,8"
                                Background="{DynamicResource StatusInfoBg}"
                                CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon
                                        Width="14"
                                        Height="14"
                                        Margin="0,1,8,0"
                                        VerticalAlignment="Top"
                                        Foreground="{DynamicResource StatusInfoFg}"
                                        Kind="LightbulbOnOutline" />
                                    <TextBlock
                                        Grid.Column="1"
                                        FontSize="10.5"
                                        Foreground="{DynamicResource StatusInfoFg}"
                                        Text="{DynamicResource Str_Monitor_Tips}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--  ================= MAIN AREA =================  -->
            <Grid Grid.Column="2">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!--  Run bar: the primary action is always top-left, same spot as in every tool  -->
                <Border
                    Grid.Row="0"
                    Margin="0,0,0,14"
                    Style="{StaticResource CardStyle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button
                            ctl:Tour.Key="Str_Tour_MonitorTest_Start" ctl:Tour.Order="3"
                            MinWidth="170"
                            VerticalAlignment="Center"
                            Click="BtnStart_Click"
                            Style="{StaticResource AccentPrimaryButtonStyle}">
                            <Grid HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon
                                    Grid.Column="0"
                                    Width="18"
                                    Height="18"
                                    Margin="0,0,8,0"
                                    VerticalAlignment="Center"
                                    Kind="Fullscreen" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_Monitor_Start}" TextWrapping="Wrap" />
                            </Grid>
                        </Button>

                        <TextBlock
                            Grid.Column="1"
                            Margin="16,0,16,0"
                            VerticalAlignment="Center"
                            FontSize="11.5"
                            Foreground="{DynamicResource TextSecondary}"
                            Text="{DynamicResource Str_Monitor_StartHint}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />

                        <Border
                            x:Name="BorderStatus"
                            Grid.Column="2"
                            MaxWidth="420"
                            VerticalAlignment="Center"
                            Background="{DynamicResource RowBg}"
                            Style="{StaticResource IconStatusPillStyle}"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    x:Name="IconStatus"
                                    Width="13"
                                    Height="13"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Foreground="{Binding Foreground, ElementName=TxtStatus}"
                                    Kind="InformationOutline" />
                                <TextBlock
                                    x:Name="TxtStatus"
                                    FontSize="11.5"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextSecondary}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </Grid>
                </Border>

                <!--  Test card  -->
                <Border ctl:Tour.Key="Str_Tour_MonitorTest_Results" ctl:Tour.Order="4" Grid.Row="1" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  Header  -->
                    <ContentControl
                        Margin="0,0,0,12"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center"
                        Content="{DynamicResource Str_Monitor_Header}"
                        Style="{StaticResource CardHeader}"
                        Tag="{x:Static materialDesign:PackIconKind.Monitor}" />

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <TextBlock
                                Margin="0,0,0,10"
                                FontSize="12"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="{DynamicResource Str_Monitor_Intro}"
                                TextWrapping="Wrap" />

                            <!--  The picture groups, built from code  -->
                            <StackPanel x:Name="Groups" />

                            <!--  Refresh rate  -->
                            <Border
                                Margin="0,8,0,0"
                                Padding="14,12"
                                Background="{DynamicResource RowBg}"
                                CornerRadius="12">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Monitor_RefreshHeader}"
                                        Style="{StaticResource CardHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.Speedometer}" />
                                    <TextBlock
                                        Margin="0,8,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Text="{DynamicResource Str_Monitor_RefreshIntro}"
                                        TextWrapping="Wrap" />
                                    <StackPanel Margin="0,10,0,0" Orientation="Horizontal">
                                        <Button
                                            x:Name="BtnMeasure"
                                            Click="BtnMeasure_Click"
                                            Style="{StaticResource PrimaryButtonStyle}">
                                            <Grid HorizontalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon
                                                    Grid.Column="0"
                                                    Width="15"
                                                    Height="15"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Kind="TimerSand" />
                                                <TextBlock
                                                    Grid.Column="1"
                                                    x:Name="TxtMeasure"
                                                    VerticalAlignment="Center"
                                                    Text="{DynamicResource Str_Monitor_Measure}" TextWrapping="Wrap" />
                                            </Grid>
                                        </Button>
                                        <ProgressBar
                                            x:Name="BarMeasure"
                                            Width="140"
                                            Height="6"
                                            Margin="12,0,0,0"
                                            VerticalAlignment="Center"
                                            Maximum="1"
                                            Visibility="Collapsed" />
                                    </StackPanel>
                                    <WrapPanel
                                        x:Name="RefreshPills"
                                        Margin="0,10,0,0"
                                        Visibility="Collapsed">
                                        <Border
                                            x:Name="PillReported"
                                            Margin="0,0,6,6"
                                            Background="{DynamicResource ContentBg}"
                                            Style="{StaticResource IconStatusPillStyle}">
                                            <TextBlock
                                                x:Name="TxtReported"
                                                FontSize="11.5"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource TextSecondary}" />
                                        </Border>
                                        <Border
                                            x:Name="PillMeasured"
                                            Margin="0,0,6,6"
                                            Background="{DynamicResource ContentBg}"
                                            Style="{StaticResource IconStatusPillStyle}">
                                            <TextBlock
                                                x:Name="TxtMeasured"
                                                FontSize="11.5"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource TextSecondary}" />
                                        </Border>
                                        <Border
                                            x:Name="PillJitter"
                                            Margin="0,0,6,6"
                                            Background="{DynamicResource ContentBg}"
                                            Style="{StaticResource IconStatusPillStyle}">
                                            <TextBlock
                                                x:Name="TxtJitter"
                                                FontSize="11.5"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource TextSecondary}" />
                                        </Border>
                                        <Border
                                            x:Name="PillMissed"
                                            Margin="0,0,6,6"
                                            Background="{DynamicResource ContentBg}"
                                            Style="{StaticResource IconStatusPillStyle}">
                                            <TextBlock
                                                x:Name="TxtMissed"
                                                FontSize="11.5"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource TextSecondary}" />
                                        </Border>
                                    </WrapPanel>
                                    <TextBlock
                                        x:Name="TxtRefreshVerdict"
                                        Margin="0,2,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextPrimary}"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!--  Suspect pixels  -->
                            <Border
                                x:Name="MarksCard"
                                Margin="0,12,0,0"
                                Padding="14,12"
                                Background="{DynamicResource RowBg}"
                                CornerRadius="12">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <ContentControl
                                            VerticalAlignment="Center"
                                            Content="{DynamicResource Str_Monitor_MarksHeader}"
                                            Style="{StaticResource CardHeader}"
                                            Tag="{x:Static materialDesign:PackIconKind.TargetVariant}" />
                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <Button
                                                x:Name="BtnCopyMarks"
                                                Click="BtnCopyMarks_Click"
                                                IsEnabled="False"
                                                ToolTip="{DynamicResource Str_Monitor_CopyMarks}"
                                                Style="{StaticResource ListToolButtonStyle}">
                                                <materialDesign:PackIcon
                                                    Width="16"
                                                    Height="16"
                                                    Kind="ContentCopy" />
                                            </Button>
                                            <Button
                                                x:Name="BtnClearMarks"
                                                Margin="4,0,0,0"
                                                Click="BtnClearMarks_Click"
                                                IsEnabled="False"
                                                Style="{StaticResource ListToolButtonStyle}"
                                                ToolTip="{DynamicResource Str_Monitor_ClearMarks}">
                                                <materialDesign:PackIcon
                                                    Width="16"
                                                    Height="16"
                                                    Kind="PlaylistRemove" />
                                            </Button>
                                        </StackPanel>
                                    </Grid>
                                    <TextBlock
                                        x:Name="TxtMarksEmpty"
                                        Margin="0,8,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Text="{DynamicResource Str_Monitor_MarksEmpty}"
                                        TextWrapping="Wrap" />
                                    <ItemsControl x:Name="MarksList" Margin="0,8,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock
                                                    Margin="0,2"
                                                    FontFamily="Consolas"
                                                    FontSize="12"
                                                    Foreground="{DynamicResource TextPrimary}"
                                                    Text="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                </Grid>
                </Border>
            </Grid>
        </Grid>
    </Grid>
</UserControl>
