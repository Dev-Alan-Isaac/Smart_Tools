<UserControl
    x:Class="Smart_Tools.WPF.Views.KeyboardMouseTestView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    x:Name="Root"
    Focusable="True"
    IsKeyboardFocusWithinChanged="Root_FocusChanged"
    IsVisibleChanged="Root_IsVisibleChanged"
    Loaded="Root_Loaded"
    PreviewKeyDown="Root_PreviewKeyDown"
    PreviewKeyUp="Root_PreviewKeyUp"
    PreviewMouseDown="Root_PreviewMouseDown">

    <!--
        Backend: Controllers/KeyboardMouseTestManager.cs (layout, rollover, chatter, polling and DPI maths),
        .Windows.cs (Raw Input on its own thread), Models/KeyboardMouseTestModel.cs. UI only here.
    -->

    <Grid Background="{DynamicResource ContentBg}">
        <Grid Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OptionsColumn" Width="280" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= OPTIONS SIDEBAR =================  -->
            <Border Grid.Column="0" Style="{StaticResource SidebarPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Button
                            x:Name="BtnCollapseOptions"
                            MinHeight="45"
                            HorizontalContentAlignment="Left"
                            Click="BtnCollapseOptions_Click"
                            Cursor="Hand"
                            FocusVisualStyle="{x:Null}"
                            Foreground="{DynamicResource SidebarText}"
                            ToolTip="{DynamicResource Str_Common_SidebarToggleTooltip}">
                            <Button.Style>
                                <Style TargetType="Button">
                                    <Setter Property="Background" Value="Transparent" />
                                    <Setter Property="BorderBrush" Value="Transparent" />
                                    <Setter Property="OverridesDefaultStyle" Value="True" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="Button">
                                                <Border Background="{TemplateBinding Background}">
                                                    <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                                                </Border>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </Button.Style>
                            <StackPanel Margin="16,0,0,0" Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    VerticalAlignment="Center"
                                    Kind="TuneVariant" />
                                <TextBlock
                                    x:Name="TxtOptionsHeaderLabel"
                                    Margin="10,0,0,0"
                                    VerticalAlignment="Center"
                                    FontWeight="SemiBold"
                                    Text="{DynamicResource Str_Common_OptionsLabel}" />
                            </StackPanel>
                        </Button>
                        <Separator
                            x:Name="SepHeader"
                            Margin="16,4"
                            Style="{StaticResource SidebarSeparatorStyle}" />
                    </StackPanel>

                    <ScrollViewer
                        x:Name="OptionsScrollViewer"
                        Grid.Row="1"
                        VerticalScrollBarVisibility="Auto">
                        <StackPanel Margin="16">

                            <Border ctl:Tour.Key="Str_Tour_KbMouse_Options" ctl:Tour.Order="1" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_KbMouse_OptionsHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.TuneVariant}" />

                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Style="{DynamicResource FieldLabel}"
                                            Text="{DynamicResource Str_KbMouse_ChatterLimit}" />
                                        <Border
                                            Grid.Column="1"
                                            Padding="7,1"
                                            Background="{DynamicResource AccentFill}"
                                            CornerRadius="8">
                                            <TextBlock
                                                x:Name="TxtChatterLimit"
                                                FontSize="10.5"
                                                FontWeight="SemiBold"
                                                Foreground="White"
                                                Text="30 ms" />
                                        </Border>
                                    </Grid>
                                    <Slider
                                        x:Name="SliderChatter"
                                        Margin="0,4,0,0"
                                        IsSnapToTickEnabled="True"
                                        LargeChange="10"
                                        Maximum="100"
                                        Minimum="5"
                                        SmallChange="1"
                                        TickFrequency="1"
                                        ToolTip="{DynamicResource Str_KbMouse_ChatterTip}"
                                        ValueChanged="Slider_ValueChanged"
                                        Value="30" />

                                    <StackPanel x:Name="PanelDpiOption" Margin="0,10,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Style="{DynamicResource FieldLabel}"
                                                Text="{DynamicResource Str_KbMouse_DpiDistance}" />
                                            <Border
                                                Grid.Column="1"
                                                Padding="7,1"
                                                Background="{DynamicResource AccentFill}"
                                                CornerRadius="8">
                                                <TextBlock
                                                    x:Name="TxtDpiDistance"
                                                    FontSize="10.5"
                                                    FontWeight="SemiBold"
                                                    Foreground="White"
                                                    Text="10 cm" />
                                            </Border>
                                        </Grid>
                                        <Slider
                                            x:Name="SliderDpiCm"
                                            Margin="0,4,0,0"
                                            IsSnapToTickEnabled="True"
                                            LargeChange="5"
                                            Maximum="40"
                                            Minimum="2"
                                            SmallChange="1"
                                            TickFrequency="1"
                                            ToolTip="{DynamicResource Str_KbMouse_DpiDistanceTip}"
                                            ValueChanged="Slider_ValueChanged"
                                            Value="10" />
                                    </StackPanel>

                                    <StackPanel x:Name="PanelMotionOption" Margin="0,10,0,0">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Style="{DynamicResource FieldLabel}"
                                                Text="{DynamicResource Str_KbMouse_MotionRange}" />
                                            <Border
                                                Grid.Column="1"
                                                Padding="7,1"
                                                Background="{DynamicResource AccentFill}"
                                                CornerRadius="8">
                                                <TextBlock
                                                    x:Name="TxtMotionRange"
                                                    FontSize="10.5"
                                                    FontWeight="SemiBold"
                                                    Foreground="White"
                                                    Text="3000" />
                                            </Border>
                                        </Grid>
                                        <Slider
                                            x:Name="SliderMotionRange"
                                            Margin="0,4,0,0"
                                            IsSnapToTickEnabled="True"
                                            LargeChange="1000"
                                            Maximum="10000"
                                            Minimum="500"
                                            SmallChange="250"
                                            TickFrequency="250"
                                            ToolTip="{DynamicResource Str_KbMouse_MotionRangeTip}"
                                            ValueChanged="Slider_ValueChanged"
                                            Value="3000" />
                                    </StackPanel>

                                    <CheckBox
                                        x:Name="ChkBlockKeys"
                                        Margin="0,12,0,0"
                                        Checked="Option_Changed"
                                        Foreground="{DynamicResource SidebarText}"
                                        IsChecked="True"
                                        ToolTip="{DynamicResource Str_KbMouse_BlockKeysTip}"
                                        Unchecked="Option_Changed"
                                        Content="{DynamicResource Str_KbMouse_BlockKeys}"
                                        controls:ChoiceIcon.Kind="KeyboardOff"
                                        Style="{StaticResource ToggleChipCheckBoxStyle}" />

                                    <Button
                                        Margin="0,12,0,0"
                                        HorizontalAlignment="Left"
                                        Click="BtnReset_Click"
                                        ToolTip="{DynamicResource Str_KbMouse_ResetTip}">
                                        <Grid HorizontalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon
                                                Grid.Column="0"
                                                Width="14"
                                                Height="14"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Kind="Restore" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_KbMouse_Reset}" TextWrapping="Wrap" />
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <Border
                                Margin="0,4,0,0"
                                Padding="10,8"
                                Background="{DynamicResource StatusInfoBg}"
                                CornerRadius="8">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon
                                        Width="14"
                                        Height="14"
                                        Margin="0,1,8,0"
                                        VerticalAlignment="Top"
                                        Foreground="{DynamicResource StatusInfoFg}"
                                        Kind="LightbulbOnOutline" />
                                    <TextBlock
                                        Grid.Column="1"
                                        FontSize="10.5"
                                        Foreground="{DynamicResource StatusInfoFg}"
                                        Text="{DynamicResource Str_KbMouse_Tips}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </Border>

                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--  ================= MAIN AREA =================  -->
            <Border ctl:Tour.Key="Str_Tour_KbMouse_Tests" ctl:Tour.Order="2" Grid.Column="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentControl
                            VerticalAlignment="Center"
                            Content="{DynamicResource Str_KbMouse_Header}"
                            Style="{StaticResource CardHeader}"
                            Tag="{x:Static materialDesign:PackIconKind.Keyboard}" />
                        <Border
                            x:Name="BorderStatus"
                            Grid.Column="2"
                            MaxWidth="420"
                            VerticalAlignment="Center"
                            Background="{DynamicResource RowBg}"
                            Style="{StaticResource IconStatusPillStyle}"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    x:Name="IconStatus"
                                    Width="13"
                                    Height="13"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Foreground="{Binding Foreground, ElementName=TxtStatus}"
                                    Kind="InformationOutline" />
                                <TextBlock
                                    x:Name="TxtStatus"
                                    FontSize="11.5"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextSecondary}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!--  Tabs  -->
                    <StackPanel
                        Grid.Row="1"
                        Margin="0,0,0,12"
                        Orientation="Horizontal">
                        <RadioButton
                            x:Name="RadioTabKeyboard"
                            MinWidth="120"
                            Checked="Tab_Checked"
                            GroupName="KbMouseTab"
                            IsChecked="True"
                            Style="{StaticResource ModeToggleButtonStyle}">
                            <Grid HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon
                                    Grid.Column="0"
                                    Width="15"
                                    Height="15"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Kind="Keyboard" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_KbMouse_TabKeyboard}" TextWrapping="Wrap" />
                            </Grid>
                        </RadioButton>
                        <RadioButton
                            x:Name="RadioTabMouse"
                            MinWidth="110"
                            Margin="4,0,0,0"
                            Checked="Tab_Checked"
                            GroupName="KbMouseTab"
                            Style="{StaticResource ModeToggleButtonStyle}">
                            <Grid HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon
                                    Grid.Column="0"
                                    Width="15"
                                    Height="15"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Kind="MouseVariant" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_KbMouse_TabMouse}" TextWrapping="Wrap" />
                            </Grid>
                        </RadioButton>
                        <RadioButton
                            x:Name="RadioTabReaction"
                            MinWidth="170"
                            Margin="4,0,0,0"
                            Checked="Tab_Checked"
                            GroupName="KbMouseTab"
                            Style="{StaticResource ModeToggleButtonStyle}">
                            <Grid HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon
                                    Grid.Column="0"
                                    Width="15"
                                    Height="15"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Kind="TimerOutline" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_KbMouse_TabReaction}" TextWrapping="Wrap" />
                            </Grid>
                        </RadioButton>
                    </StackPanel>

                    <Grid Grid.Row="2">

                        <!--  ================= KEYBOARD =================  -->
                        <ScrollViewer ctl:Tour.Key="Str_Tour_KbMouse_Keyboard" ctl:Tour.Order="3"
                            x:Name="PanelKeyboard"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <Grid Height="{Binding ViewportHeight, ElementName=PanelKeyboard}" MinHeight="540">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Border
                                    x:Name="BorderFocusHint"
                                    Margin="0,0,0,10"
                                    Padding="12,8"
                                    Background="{DynamicResource StatusWarningBg}"
                                    CornerRadius="8"
                                    Cursor="Hand"
                                    Visibility="Collapsed">
                                    <StackPanel Orientation="Horizontal">
                                        <materialDesign:PackIcon
                                            Width="15"
                                            Height="15"
                                            Margin="0,0,8,0"
                                            VerticalAlignment="Center"
                                            Foreground="{DynamicResource StatusWarningFg}"
                                            Kind="CursorDefaultClickOutline" />
                                        <TextBlock
                                            FontSize="12"
                                            Foreground="{DynamicResource StatusWarningFg}"
                                            Text="{DynamicResource Str_KbMouse_ClickToFocus}" />
                                    </StackPanel>
                                </Border>

                                <WrapPanel Grid.Row="1">
                                    <Border
                                        Margin="0,0,6,6"
                                        Background="{DynamicResource RowBg}"
                                        Style="{StaticResource IconStatusPillStyle}">
                                        <TextBlock
                                            x:Name="TxtPillTested"
                                            FontSize="11.5"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextSecondary}" />
                                    </Border>
                                    <Border
                                        Margin="0,0,6,6"
                                        Background="{DynamicResource RowBg}"
                                        Style="{StaticResource IconStatusPillStyle}">
                                        <TextBlock
                                            x:Name="TxtPillHeld"
                                            FontSize="11.5"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextSecondary}" />
                                    </Border>
                                    <Border
                                        x:Name="PillMax"
                                        Margin="0,0,6,6"
                                        Background="{DynamicResource RowBg}"
                                        Style="{StaticResource IconStatusPillStyle}">
                                        <TextBlock
                                            x:Name="TxtPillMax"
                                            FontSize="11.5"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextSecondary}" />
                                    </Border>
                                    <Border
                                        x:Name="PillChatter"
                                        Margin="0,0,6,6"
                                        Background="{DynamicResource RowBg}"
                                        Style="{StaticResource IconStatusPillStyle}">
                                        <TextBlock
                                            x:Name="TxtPillChatter"
                                            FontSize="11.5"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextSecondary}" />
                                    </Border>
                                </WrapPanel>

                                <Viewbox
                                    Grid.Row="2"
                                    Margin="0,4,0,0"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Stretch="Uniform"
                                    StretchDirection="Both">
                                    <Canvas x:Name="KeysCanvas" />
                                </Viewbox>

                                <StackPanel Grid.Row="3">
                                    <TextBlock
                                        x:Name="TxtRolloverVerdict"
                                        Margin="0,12,0,0"
                                        FontSize="12.5"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextPrimary}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="TxtMaxSet"
                                        Margin="0,2,0,0"
                                        FontFamily="Consolas"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextSecondary}"
                                        TextWrapping="Wrap" />
                                    <TextBlock
                                        x:Name="TxtChatterKeys"
                                        Margin="0,6,0,0"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextPrimary}"
                                        TextWrapping="Wrap" />
                                </StackPanel>

                                <TextBlock
                                    Grid.Row="4"
                                    Margin="0,14,0,6"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{DynamicResource Str_KbMouse_LogHeader}" />
                                <Border
                                    Grid.Row="5"
                                    Height="120"
                                    Padding="10,8"
                                    Background="{DynamicResource RowBg}"
                                    CornerRadius="10">
                                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                                        <StackPanel>
                                            <TextBlock
                                                x:Name="TxtLogEmpty"
                                                FontSize="12"
                                                Foreground="{DynamicResource TextSecondary}"
                                                Text="{DynamicResource Str_KbMouse_LogEmpty}" />
                                            <ItemsControl x:Name="LogList">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <TextBlock
                                                            FontFamily="Consolas"
                                                            FontSize="12"
                                                            Foreground="{DynamicResource TextPrimary}"
                                                            Text="{Binding}" />
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </ScrollViewer>
                                </Border>
                            </Grid>
                        </ScrollViewer>

                        <!--  ================= MOUSE =================  -->
                        <ScrollViewer ctl:Tour.Key="Str_Tour_KbMouse_Mouse" ctl:Tour.Order="4"
                            x:Name="PanelMouse"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto"
                            Visibility="Collapsed">
                            <Grid Height="{Binding ViewportHeight, ElementName=PanelMouse}" MinHeight="720">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="260" />
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <!--  The mouse  -->
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="*" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>
                                    <Viewbox
                                        VerticalAlignment="Top"
                                        Stretch="Uniform"
                                        StretchDirection="Both">
                                        <Grid Width="170" Height="270">
                                            <Border
                                                x:Name="MouseBody"
                                                Background="{DynamicResource RowBg}"
                                                BorderBrush="{DynamicResource CardBorder}"
                                                BorderThickness="2"
                                                CornerRadius="80,80,70,70" />
                                            <Border
                                                x:Name="MouseLeft"
                                                Width="66"
                                                Height="100"
                                                Margin="14,6,0,0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Background="{DynamicResource ContentBg}"
                                                CornerRadius="66,6,6,6" />
                                            <Border
                                                x:Name="MouseRight"
                                                Width="66"
                                                Height="100"
                                                Margin="0,6,14,0"
                                                HorizontalAlignment="Right"
                                                VerticalAlignment="Top"
                                                Background="{DynamicResource ContentBg}"
                                                CornerRadius="6,66,6,6" />
                                            <Border
                                                x:Name="MouseMiddle"
                                                Width="22"
                                                Height="46"
                                                Margin="0,34,0,0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Top"
                                                Background="{DynamicResource ContentBg}"
                                                BorderBrush="{DynamicResource CardBorder}"
                                                BorderThickness="1"
                                                CornerRadius="10" />
                                            <Border
                                                x:Name="WheelUpMark"
                                                Width="22"
                                                Height="12"
                                                Margin="0,16,0,0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Top"
                                                Background="{DynamicResource ContentBg}"
                                                CornerRadius="5" />
                                            <Border
                                                x:Name="WheelDownMark"
                                                Width="22"
                                                Height="12"
                                                Margin="0,86,0,0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Top"
                                                Background="{DynamicResource ContentBg}"
                                                CornerRadius="5" />
                                            <Border
                                                x:Name="MouseBack"
                                                Width="14"
                                                Height="34"
                                                Margin="2,126,0,0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Background="{DynamicResource ContentBg}"
                                                CornerRadius="5" />
                                            <Border
                                                x:Name="MouseForward"
                                                Width="14"
                                                Height="34"
                                                Margin="2,166,0,0"
                                                HorizontalAlignment="Left"
                                                VerticalAlignment="Top"
                                                Background="{DynamicResource ContentBg}"
                                                CornerRadius="5" />
                                            <!--  Movement indicator on the body of the mouse: a puck that leans the way it moves and a chevron pointing along it  -->
                                            <Canvas
                                                x:Name="MotionCanvas"
                                                Width="110"
                                                Height="110"
                                                Margin="0,134,0,0"
                                                HorizontalAlignment="Center"
                                                VerticalAlignment="Top"
                                                ToolTip="{DynamicResource Str_KbMouse_MotionHint}" />
                                        </Grid>
                                    </Viewbox>
                                    <TextBlock
                                        x:Name="TxtMouseNoInput"
                                        Grid.Row="1"
                                        Margin="0,8,0,0"
                                        FontSize="11.5"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Text="{DynamicResource Str_KbMouse_MouseHint}"
                                        TextWrapping="Wrap" />
                                </Grid>

                                <StackPanel Grid.Column="2">

                                    <!--  Polling rate  -->
                                    <Border
                                        Padding="14,12"
                                        Background="{DynamicResource RowBg}"
                                        CornerRadius="12">
                                        <StackPanel>
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                </Grid.ColumnDefinitions>
                                                <ContentControl
                                                    VerticalAlignment="Center"
                                                    Content="{DynamicResource Str_KbMouse_PollingHeader}"
                                                    Style="{StaticResource CardHeader}"
                                                    Tag="{x:Static materialDesign:PackIconKind.Speedometer}" />
                                                <Button Padding="0"
                                                    Grid.Column="1"
                                                    Width="40"
                                                    Click="BtnResetPolling_Click"
                                                    Style="{StaticResource NeutralIconButtonStyle}"
                                                    ToolTip="{DynamicResource Str_KbMouse_ResetPolling}">
                                                    <materialDesign:PackIcon
                                                        Width="16"
                                                        Height="16"
                                                        Kind="Restore" />
                                                </Button>
                                            </Grid>
                                            <TextBlock
                                                x:Name="TxtHz"
                                                Margin="0,8,0,0"
                                                FontSize="30"
                                                FontWeight="Bold"
                                                Foreground="{DynamicResource TextPrimary}"
                                                Text="—" />
                                            <TextBlock
                                                x:Name="TxtHzNote"
                                                FontSize="12"
                                                Foreground="{DynamicResource TextSecondary}"
                                                Text="{DynamicResource Str_KbMouse_PollingIdle}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                x:Name="TxtPollStats"
                                                Margin="0,6,0,0"
                                                FontFamily="Consolas"
                                                FontSize="12"
                                                Foreground="{DynamicResource TextPrimary}"
                                                TextWrapping="Wrap" />
                                            <Canvas
                                                x:Name="HistCanvas"
                                                Height="80"
                                                Margin="0,10,0,0" />
                                            <TextBlock
                                                x:Name="TxtPollVerdict"
                                                Margin="0,6,0,0"
                                                FontSize="12"
                                                Foreground="{DynamicResource TextPrimary}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>

                                    <!--  Buttons and wheel  -->
                                    <Border
                                        Margin="0,10,0,0"
                                        Padding="14,12"
                                        Background="{DynamicResource RowBg}"
                                        CornerRadius="12">
                                        <StackPanel>
                                            <ContentControl
                                                Content="{DynamicResource Str_KbMouse_ButtonsHeader}"
                                                Style="{StaticResource CardHeader}"
                                                Tag="{x:Static materialDesign:PackIconKind.CursorDefaultClickOutline}" />
                                            <StackPanel x:Name="ButtonsTable" Margin="0,8,0,0" />
                                            <TextBlock
                                                x:Name="TxtWheel"
                                                Margin="0,8,0,0"
                                                FontFamily="Consolas"
                                                FontSize="12"
                                                Foreground="{DynamicResource TextPrimary}"
                                                TextWrapping="Wrap" />
                                            <TextBlock
                                                x:Name="TxtMouseChatter"
                                                Margin="0,6,0,0"
                                                FontSize="12"
                                                Foreground="{DynamicResource TextPrimary}"
                                                TextWrapping="Wrap" />
                                            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                                <TextBlock
                                                    x:Name="TxtMotionArrow"
                                                    Width="30"
                                                    VerticalAlignment="Center"
                                                    FontSize="22"
                                                    FontWeight="Bold"
                                                    Foreground="{DynamicResource TextPrimary}"
                                                    Text="—" />
                                                <TextBlock
                                                    x:Name="TxtMotionStats"
                                                    VerticalAlignment="Center"
                                                    FontFamily="Consolas"
                                                    FontSize="12"
                                                    Foreground="{DynamicResource TextPrimary}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </Border>

                                    <!--  DPI  -->
                                    <Border
                                        Margin="0,10,0,0"
                                        Padding="14,12"
                                        Background="{DynamicResource RowBg}"
                                        CornerRadius="12">
                                        <StackPanel>
                                            <ContentControl
                                                Content="{DynamicResource Str_KbMouse_DpiHeader}"
                                                Style="{StaticResource CardHeader}"
                                                Tag="{x:Static materialDesign:PackIconKind.RulerSquare}" />
                                            <TextBlock
                                                x:Name="TxtDpiInstruction"
                                                Margin="0,8,0,0"
                                                FontSize="12"
                                                Foreground="{DynamicResource TextSecondary}"
                                                TextWrapping="Wrap" />
                                            <StackPanel Margin="0,8,0,0" Orientation="Horizontal">
                                                <Button
                                                    x:Name="BtnDpi"
                                                    Click="BtnDpi_Click"
                                                    Style="{StaticResource PrimaryButtonStyle}">
                                                    <Grid HorizontalAlignment="Center">
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition Width="Auto" />
                                                            <ColumnDefinition Width="*" />
                                                        </Grid.ColumnDefinitions>
                                                        <materialDesign:PackIcon
                                                            Grid.Column="0"
                                                            x:Name="IconDpi"
                                                            Width="15"
                                                            Height="15"
                                                            Margin="0,0,6,0"
                                                            VerticalAlignment="Center"
                                                            Kind="Play" />
                                                        <TextBlock
                                                            Grid.Column="1"
                                                            x:Name="TxtDpiButton"
                                                            VerticalAlignment="Center"
                                                            Text="{DynamicResource Str_KbMouse_DpiStart}" TextWrapping="Wrap" />
                                                    </Grid>
                                                </Button>
                                                <TextBlock
                                                    x:Name="TxtDpiLive"
                                                    Margin="12,0,0,0"
                                                    VerticalAlignment="Center"
                                                    FontFamily="Consolas"
                                                    FontSize="12"
                                                    Foreground="{DynamicResource TextSecondary}" />
                                            </StackPanel>
                                            <TextBlock
                                                x:Name="TxtDpiResult"
                                                Margin="0,8,0,0"
                                                FontSize="13"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource TextPrimary}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                    </Border>
                                </StackPanel>
                            </Grid>
                        </ScrollViewer>

                        <!--  ================= REACTION =================  -->
                        <ScrollViewer ctl:Tour.Key="Str_Tour_KbMouse_Reaction" ctl:Tour.Order="5"
                            x:Name="PanelReaction"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto"
                            Visibility="Collapsed">
                            <Grid Height="{Binding ViewportHeight, ElementName=PanelReaction}" MinHeight="470">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{DynamicResource Str_KbMouse_ReactionIntro}"
                                    TextWrapping="Wrap" />
                                <Border
                                    x:Name="ReactionTarget"
                                    Grid.Row="1"
                                    MinHeight="180"
                                    Margin="0,10,0,0"
                                    Background="{DynamicResource RowBg}"
                                    CornerRadius="14">
                                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                        <TextBlock
                                            x:Name="TxtReactionMain"
                                            HorizontalAlignment="Center"
                                            FontSize="26"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource TextPrimary}"
                                            Text="{DynamicResource Str_KbMouse_ReactionIdle}"
                                            TextAlignment="Center" />
                                        <TextBlock
                                            x:Name="TxtReactionSub"
                                            Margin="0,6,0,0"
                                            HorizontalAlignment="Center"
                                            FontSize="12.5"
                                            Foreground="{DynamicResource TextSecondary}"
                                            TextAlignment="Center" />
                                    </StackPanel>
                                </Border>
                                <StackPanel
                                    Grid.Row="2"
                                    Margin="0,10,0,0"
                                    Orientation="Horizontal">
                                    <Button
                                        x:Name="BtnReactionStart"
                                        Click="BtnReactionStart_Click"
                                        Style="{StaticResource AccentPrimaryButtonStyle}">
                                        <Grid HorizontalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon
                                                Grid.Column="0"
                                                Width="16"
                                                Height="16"
                                                Margin="0,0,7,0"
                                                VerticalAlignment="Center"
                                                Kind="Play" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_KbMouse_ReactionStart}" TextWrapping="Wrap" />
                                        </Grid>
                                    </Button>
                                </StackPanel>
                                <TextBlock
                                    x:Name="TxtReactionSummary"
                                    Grid.Row="3"
                                    Margin="0,12,0,0"
                                    FontSize="13"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimary}"
                                    TextWrapping="Wrap" />
                                <ScrollViewer
                                    Grid.Row="4"
                                    MaxHeight="120"
                                    VerticalScrollBarVisibility="Auto">
                                    <ItemsControl x:Name="ReactionList" Margin="0,6,0,0">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <TextBlock
                                                    FontFamily="Consolas"
                                                    FontSize="12"
                                                    Foreground="{DynamicResource TextPrimary}"
                                                    Text="{Binding}" />
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                                <TextBlock
                                    Grid.Row="5"
                                    Margin="0,10,0,0"
                                    FontSize="11.5"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{DynamicResource Str_KbMouse_ReactionNote}"
                                    TextWrapping="Wrap" />
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
