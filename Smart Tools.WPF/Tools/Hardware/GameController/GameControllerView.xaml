<UserControl
    x:Class="Smart_Tools.WPF.Views.GameControllerView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:ctl="clr-namespace:Smart_Tools.WPF.Controllers"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:models="clr-namespace:Smart_Tools.WPF.Models"
    x:Name="Root"
    IsVisibleChanged="Root_IsVisibleChanged"
    Loaded="Root_Loaded">

    <!--
        Backend: Controllers/GameControllerManager.cs (maths + analysis), .Windows.cs (XInput, joystick API, poller),
        Models/GameControllerModel.cs. The plots are Controls/ControllerPlots.cs. UI only here.
    -->

    <Grid Background="{DynamicResource ContentBg}">
        <Grid Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= OPTIONS SIDEBAR =================  -->
            <controls:ToolSidebar x:Name="Sidebar">
                        <StackPanel>

                            <!--  ============ CONTROLLER ============  -->
                            <Border ctl:Tour.Key="Str_Tour_GameCtl_Controller" ctl:Tour.Order="1" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_GameCtl_ControllerHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.Gamepad}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="40" />
                                        </Grid.ColumnDefinitions>
                                        <ComboBox x:Name="CmbController" SelectionChanged="CmbController_SelectionChanged">
                                            <ComboBox.ItemTemplate>
                                                <DataTemplate>
                                                    <StackPanel Orientation="Horizontal">
                                                        <materialDesign:PackIcon Width="18" Height="18" Margin="0,0,8,0" VerticalAlignment="Center">
                                                            <materialDesign:PackIcon.Style>
                                                                <Style TargetType="materialDesign:PackIcon">
                                                                    <Setter Property="Kind" Value="GamepadVariantOutline" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Family}" Value="{x:Static models:ControllerFamily.Xbox}">
                                                                            <Setter Property="Kind" Value="MicrosoftXboxController" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Family}" Value="{x:Static models:ControllerFamily.PlayStation}">
                                                                            <Setter Property="Kind" Value="SonyPlaystation" />
                                                                        </DataTrigger>
                                                                        <DataTrigger Binding="{Binding Family}" Value="{x:Static models:ControllerFamily.ExtraButtons}">
                                                                            <Setter Property="Kind" Value="GamepadSquare" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </materialDesign:PackIcon.Style>
                                                        </materialDesign:PackIcon>
                                                        <TextBlock VerticalAlignment="Center" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                                    </StackPanel>
                                                </DataTemplate>
                                            </ComboBox.ItemTemplate>
                                        </ComboBox>
                                        <Button
                                            Grid.Column="1"
                                            Margin="6,0,0,0"
                                            Click="BtnRefresh_Click"
                                            Style="{StaticResource NeutralIconButtonStyle}"
                                            ToolTip="{DynamicResource Str_GameCtl_Refresh}">
                                            <materialDesign:PackIcon
                                                Width="16"
                                                Height="16"
                                                Kind="Refresh" />
                                        </Button>
                                    </Grid>
                                    <TextBlock
                                        x:Name="TxtControllerInfo"
                                        Margin="0,8,0,0"
                                        FontSize="11.5"
                                        Foreground="{DynamicResource SidebarText}"
                                        Opacity="0.85"
                                        TextWrapping="Wrap" />
                                </StackPanel>
                            </Border>

                            <!--  ============ DETECTED LAYOUT ============  -->
                            <Border ctl:Tour.Key="Str_Tour_GameCtl_Layout" ctl:Tour.Order="2" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_GameCtl_LayoutHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.GamepadVariant}" />
                                    <Border
                                        Padding="12,10"
                                        Background="{DynamicResource SidebarInputBg}"
                                        CornerRadius="12">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Border Width="44" Height="44" Margin="0,0,12,0" Background="{DynamicResource AccentGradient}" CornerRadius="13">
                                                <materialDesign:PackIcon x:Name="IconLayout" Width="26" Height="26" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" Kind="GamepadVariant" />
                                            </Border>
                                            <TextBlock x:Name="TxtLayoutName" Grid.Column="1" Text="{DynamicResource Str_GameCtl_LayoutGeneric}" VerticalAlignment="Center" FontSize="13.5" FontWeight="SemiBold" Foreground="{DynamicResource SidebarText}" TextWrapping="Wrap" />
                                        </Grid>
                                    </Border>
                                    <TextBlock x:Name="TxtFamilyNote" Style="{StaticResource SidebarHint}" />

                                    <!--  What this app cannot see: paddles, levers and other extra buttons  -->
                                    <Border
                                        x:Name="ExtraNotice"
                                        Margin="0,12,0,0"
                                        Padding="11,9"
                                        Background="{DynamicResource StatusInfoBg}"
                                        CornerRadius="10">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon x:Name="IconExtraNotice" Width="16" Height="16" Margin="0,1,9,0" VerticalAlignment="Top" Foreground="{DynamicResource StatusInfoFg}" Kind="InformationOutline" />
                                            <StackPanel Grid.Column="1">
                                                <TextBlock x:Name="TxtExtraTitle" Text="{DynamicResource Str_GameCtl_ExtraStdTitle}" FontSize="12" FontWeight="SemiBold" Foreground="{DynamicResource StatusInfoFg}" TextWrapping="Wrap" />
                                                <TextBlock x:Name="TxtExtraBody" Text="{DynamicResource Str_GameCtl_ExtraStdBody}" Margin="0,3,0,0" FontSize="11" Foreground="{DynamicResource StatusInfoFg}" TextWrapping="Wrap" />
                                            </StackPanel>
                                        </Grid>
                                    </Border>
                                </StackPanel>
                            </Border>

                            <!--  ============ DEAD ZONES ============  -->
                            <Border ctl:Tour.Key="Str_Tour_GameCtl_Deadzone" ctl:Tour.Order="2" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_GameCtl_DeadzoneHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.CircleSlice_8}" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="4" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <RadioButton
                                            x:Name="RadioDzAxial"
                                            Checked="Dz_Changed"
                                            Content="{DynamicResource Str_GameCtl_ModeAxial}"
                                            GroupName="GameCtlDz"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="Axial"
                                            ToolTip="{DynamicResource Str_GameCtl_ModeAxialTip}" />
                                        <RadioButton
                                            x:Name="RadioDzRadial"
                                            Grid.Column="2"
                                            Checked="Dz_Changed"
                                            Content="{DynamicResource Str_GameCtl_ModeRadial}"
                                            GroupName="GameCtlDz"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="Radial"
                                            ToolTip="{DynamicResource Str_GameCtl_ModeRadialTip}" />
                                        <RadioButton
                                            x:Name="RadioDzScaled"
                                            Grid.Column="4"
                                            Checked="Dz_Changed"
                                            Content="{DynamicResource Str_GameCtl_ModeScaled}"
                                            GroupName="GameCtlDz"
                                            IsChecked="True"
                                            Style="{StaticResource ModeToggleButtonStyle}"
                                            Tag="ScaledRadial"
                                            ToolTip="{DynamicResource Str_GameCtl_ModeScaledTip}" />
                                    </Grid>

                                    <Grid Margin="0,12,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Style="{DynamicResource FieldLabel}"
                                            Text="{DynamicResource Str_GameCtl_LeftStick}" />
                                        <Border
                                            Grid.Column="1"
                                            Padding="7,1"
                                            Background="{DynamicResource AccentFill}"
                                            CornerRadius="8">
                                            <TextBlock
                                                x:Name="TxtDzLeft"
                                                FontSize="10.5"
                                                FontWeight="SemiBold"
                                                Foreground="White"
                                                Text="24%" />
                                        </Border>
                                    </Grid>
                                    <Slider
                                        x:Name="SliderDzLeft"
                                        Margin="0,4,0,0"
                                        IsSnapToTickEnabled="True"
                                        LargeChange="5"
                                        Maximum="50"
                                        Minimum="0"
                                        SmallChange="1"
                                        TickFrequency="1"
                                        ValueChanged="Dz_SliderChanged"
                                        Value="24" />

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Style="{DynamicResource FieldLabel}"
                                            Text="{DynamicResource Str_GameCtl_RightStick}" />
                                        <Border
                                            Grid.Column="1"
                                            Padding="7,1"
                                            Background="{DynamicResource AccentFill}"
                                            CornerRadius="8">
                                            <TextBlock
                                                x:Name="TxtDzRight"
                                                FontSize="10.5"
                                                FontWeight="SemiBold"
                                                Foreground="White"
                                                Text="27%" />
                                        </Border>
                                    </Grid>
                                    <Slider
                                        x:Name="SliderDzRight"
                                        Margin="0,4,0,0"
                                        IsSnapToTickEnabled="True"
                                        LargeChange="5"
                                        Maximum="50"
                                        Minimum="0"
                                        SmallChange="1"
                                        TickFrequency="1"
                                        ValueChanged="Dz_SliderChanged"
                                        Value="27" />

                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Style="{DynamicResource FieldLabel}"
                                            Text="{DynamicResource Str_GameCtl_Triggers}" />
                                        <Border
                                            Grid.Column="1"
                                            Padding="7,1"
                                            Background="{DynamicResource AccentFill}"
                                            CornerRadius="8">
                                            <TextBlock
                                                x:Name="TxtDzTrig"
                                                FontSize="10.5"
                                                FontWeight="SemiBold"
                                                Foreground="White"
                                                Text="12%" />
                                        </Border>
                                    </Grid>
                                    <Slider
                                        x:Name="SliderDzTrig"
                                        Margin="0,4,0,0"
                                        IsSnapToTickEnabled="True"
                                        LargeChange="5"
                                        Maximum="50"
                                        Minimum="0"
                                        SmallChange="1"
                                        TickFrequency="1"
                                        ValueChanged="Dz_SliderChanged"
                                        Value="12" />

                                    <Button
                                        Margin="0,10,0,0"
                                        HorizontalAlignment="Left"
                                        Click="BtnDzDefaults_Click"
                                        ToolTip="{DynamicResource Str_GameCtl_DefaultsTip}">
                                        <Grid HorizontalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon
                                                Grid.Column="0"
                                                Width="14"
                                                Height="14"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Kind="Restore" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_GameCtl_Defaults}" TextWrapping="Wrap" />
                                        </Grid>
                                    </Button>
                                </StackPanel>
                            </Border>

                            <!--  ============ VIBRATION ============  -->
                            <Border ctl:Tour.Key="Str_Tour_GameCtl_Vibration" ctl:Tour.Order="3" Style="{StaticResource SidebarGroupCardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_GameCtl_VibrationHeader}"
                                        Style="{StaticResource SidebarGroupHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.Vibrate}" />
                                    <StackPanel x:Name="VibrationPanel">
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Style="{DynamicResource FieldLabel}"
                                                Text="{DynamicResource Str_GameCtl_MotorLeft}" />
                                            <Border
                                                Grid.Column="1"
                                                Padding="7,1"
                                                Background="{DynamicResource AccentFill}"
                                                CornerRadius="8">
                                                <TextBlock
                                                    x:Name="TxtMotorLeft"
                                                    FontSize="10.5"
                                                    FontWeight="SemiBold"
                                                    Foreground="White"
                                                    Text="0%" />
                                            </Border>
                                        </Grid>
                                        <Slider
                                            x:Name="SliderMotorLeft"
                                            Margin="0,4,0,0"
                                            IsSnapToTickEnabled="True"
                                            LargeChange="10"
                                            Maximum="100"
                                            Minimum="0"
                                            SmallChange="5"
                                            TickFrequency="5"
                                            ValueChanged="Motor_SliderChanged"
                                            Value="0" />
                                        <Grid Margin="0,8,0,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="*" />
                                                <ColumnDefinition Width="Auto" />
                                            </Grid.ColumnDefinitions>
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Style="{DynamicResource FieldLabel}"
                                                Text="{DynamicResource Str_GameCtl_MotorRight}" />
                                            <Border
                                                Grid.Column="1"
                                                Padding="7,1"
                                                Background="{DynamicResource AccentFill}"
                                                CornerRadius="8">
                                                <TextBlock
                                                    x:Name="TxtMotorRight"
                                                    FontSize="10.5"
                                                    FontWeight="SemiBold"
                                                    Foreground="White"
                                                    Text="0%" />
                                            </Border>
                                        </Grid>
                                        <Slider
                                            x:Name="SliderMotorRight"
                                            Margin="0,4,0,0"
                                            IsSnapToTickEnabled="True"
                                            LargeChange="10"
                                            Maximum="100"
                                            Minimum="0"
                                            SmallChange="5"
                                            TickFrequency="5"
                                            ValueChanged="Motor_SliderChanged"
                                            Value="0" />
                                        <Button
                                            Margin="0,10,0,0"
                                            HorizontalAlignment="Left"
                                            Click="BtnPulse_Click"
                                            ToolTip="{DynamicResource Str_GameCtl_PulseTip}">
                                            <Grid HorizontalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon
                                                    Grid.Column="0"
                                                    Width="14"
                                                    Height="14"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Kind="LightningBolt" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_GameCtl_Pulse}" TextWrapping="Wrap" />
                                            </Grid>
                                        </Button>
                                    </StackPanel>
                                    <TextBlock
                                        x:Name="TxtVibrationNote"
                                        FontSize="11.5"
                                        Foreground="{DynamicResource SidebarText}"
                                        Opacity="0.85"
                                        Text="{DynamicResource Str_GameCtl_VibrationOnlyXInput}"
                                        TextWrapping="Wrap"
                                        Visibility="Collapsed" />
                                </StackPanel>
                            </Border>

                        </StackPanel>
            </controls:ToolSidebar>

            <!--  ================= MAIN AREA =================  -->
            <Border ctl:Tour.Key="Str_Tour_GameCtl_Pad" ctl:Tour.Order="4" Grid.Column="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--  Header, rate, status  -->
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentControl
                            x:Name="HeaderCard"
                            VerticalAlignment="Center"
                            Content="{DynamicResource Str_GameCtl_Header}"
                            Style="{StaticResource CardHeader}"
                            Tag="{x:Static materialDesign:PackIconKind.Gamepad}" />
                        <Border
                            x:Name="PillRate"
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource RowBg}"
                            Style="{StaticResource IconStatusPillStyle}"
                            ToolTip="{DynamicResource Str_GameCtl_RateTip}"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="13"
                                    Height="13"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Foreground="{Binding Foreground, ElementName=TxtRate}"
                                    Kind="Speedometer" />
                                <TextBlock
                                    x:Name="TxtRate"
                                    FontSize="11.5"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextSecondary}" />
                            </StackPanel>
                        </Border>
                        <Border
                            x:Name="BorderStatus"
                            Grid.Column="3"
                            MaxWidth="420"
                            VerticalAlignment="Center"
                            Background="{DynamicResource RowBg}"
                            Style="{StaticResource IconStatusPillStyle}"
                            Visibility="Collapsed">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    x:Name="IconStatus"
                                    Width="13"
                                    Height="13"
                                    Margin="0,0,5,0"
                                    VerticalAlignment="Center"
                                    Foreground="{Binding Foreground, ElementName=TxtStatus}"
                                    Kind="InformationOutline" />
                                <TextBlock
                                    x:Name="TxtStatus"
                                    FontSize="11.5"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextSecondary}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                        </Border>
                    </Grid>

                    <!--  Tabs  -->
                    <Grid
                        x:Name="TabBar"
                        Grid.Row="1"
                        Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <RadioButton
                            x:Name="RadioTabLive"
                            MinWidth="110"
                            Checked="Tab_Checked"
                            GroupName="GameCtlTab"
                            IsChecked="True"
                            Style="{StaticResource ModeToggleButtonStyle}">
                            <Grid HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon
                                    Grid.Column="0"
                                    Width="15"
                                    Height="15"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Kind="Pulse" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_GameCtl_TabLive}" TextWrapping="Wrap" />
                            </Grid>
                        </RadioButton>
                        <RadioButton
                            x:Name="RadioTabSticks"
                            Grid.Column="1"
                            MinWidth="150"
                            Margin="4,0,0,0"
                            Checked="Tab_Checked"
                            GroupName="GameCtlTab"
                            Style="{StaticResource ModeToggleButtonStyle}">
                            <Grid HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon
                                    Grid.Column="0"
                                    Width="15"
                                    Height="15"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Kind="CircleSlice_8" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_GameCtl_TabSticks}" TextWrapping="Wrap" />
                            </Grid>
                        </RadioButton>
                        <RadioButton
                            x:Name="RadioTabTriggers"
                            Grid.Column="2"
                            MinWidth="110"
                            Margin="4,0,0,0"
                            Checked="Tab_Checked"
                            GroupName="GameCtlTab"
                            Style="{StaticResource ModeToggleButtonStyle}">
                            <Grid HorizontalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon
                                    Grid.Column="0"
                                    Width="15"
                                    Height="15"
                                    Margin="0,0,6,0"
                                    VerticalAlignment="Center"
                                    Kind="ChartLineVariant" />
                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_GameCtl_TabTriggers}" TextWrapping="Wrap" />
                            </Grid>
                        </RadioButton>
                    </Grid>

                    <!--  Pages  -->
                    <Grid Grid.Row="2">

                        <!--  No controller  -->
                        <StackPanel
                            x:Name="EmptyState"
                            MaxWidth="440"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed">
                            <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.GamepadVariantOutline}" />
                            <TextBlock
                                Margin="0,12,0,0"
                                HorizontalAlignment="Center"
                                FontSize="14"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextPrimary}"
                                Text="{DynamicResource Str_GameCtl_EmptyTitle}" />
                            <TextBlock
                                Margin="0,6,0,0"
                                HorizontalAlignment="Center"
                                FontSize="12"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="{DynamicResource Str_GameCtl_EmptyHint}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                            <Button
                                Margin="0,14,0,0"
                                HorizontalAlignment="Center"
                                Click="BtnRefresh_Click"
                                Style="{StaticResource PrimaryButtonStyle}">
                                <Grid HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon
                                        Grid.Column="0"
                                        Width="15"
                                        Height="15"
                                        Margin="0,0,6,0"
                                        VerticalAlignment="Center"
                                        Kind="Refresh" />
                                    <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_GameCtl_Refresh}" TextWrapping="Wrap" />
                                </Grid>
                            </Button>
                        </StackPanel>

                        <!--  LIVE  -->
                        <ScrollViewer
                            x:Name="PanelLive"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <Grid Height="{Binding ViewportHeight, ElementName=PanelLive}" MinHeight="680">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" MinHeight="230" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock
                                            x:Name="TxtLeftTitle"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextSecondary}"
                                            Text="{DynamicResource Str_GameCtl_LeftStick}" />
                                        <controls:StickPlotControl
                                            x:Name="PlotLeft"
                                            Grid.Row="1"
                                            Margin="0,6,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            x:Name="TxtLeftValues"
                                            Grid.Row="2"
                                            Margin="0,6,0,0"
                                            FontFamily="Consolas"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextPrimary}" />
                                    </Grid>
                                    <Grid Grid.Column="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock
                                            x:Name="TxtRightTitle"
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextSecondary}"
                                            Text="{DynamicResource Str_GameCtl_RightStick}" />
                                        <controls:StickPlotControl
                                            x:Name="PlotRight"
                                            Grid.Row="1"
                                            Margin="0,6,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                        <TextBlock
                                            x:Name="TxtRightValues"
                                            Grid.Row="2"
                                            Margin="0,6,0,0"
                                            FontFamily="Consolas"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextPrimary}" />
                                    </Grid>
                                </Grid>

                                <TextBlock
                                    Grid.Row="1"
                                    Margin="0,6,0,0"
                                    FontSize="11"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{DynamicResource Str_GameCtl_PlotLegend}"
                                    TextWrapping="Wrap" />

                                <!--  Triggers (Xbox-style)  -->
                                <StackPanel
                                    x:Name="TriggerBars"
                                    Grid.Row="2"
                                    Margin="0,16,0,0">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Text="{DynamicResource Str_GameCtl_Triggers}" />
                                    <Grid Margin="0,6,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextPrimary}"
                                            x:Name="TxtLTName" Text="LT" />
                                        <ProgressBar
                                            x:Name="BarLT"
                                            Grid.Column="1"
                                            Height="10"
                                            Maximum="1"
                                            Minimum="0" />
                                        <TextBlock
                                            x:Name="TxtLT"
                                            Grid.Column="2"
                                            Margin="10,0,0,0"
                                            FontFamily="Consolas"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextPrimary}" />
                                    </Grid>
                                    <Grid Margin="0,8,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="36" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="120" />
                                        </Grid.ColumnDefinitions>
                                        <TextBlock
                                            VerticalAlignment="Center"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextPrimary}"
                                            x:Name="TxtRTName" Text="RT" />
                                        <ProgressBar
                                            x:Name="BarRT"
                                            Grid.Column="1"
                                            Height="10"
                                            Maximum="1"
                                            Minimum="0" />
                                        <TextBlock
                                            x:Name="TxtRT"
                                            Grid.Column="2"
                                            Margin="10,0,0,0"
                                            FontFamily="Consolas"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextPrimary}" />
                                    </Grid>
                                </StackPanel>

                                <!--  Other axes (generic controllers)  -->
                                <StackPanel
                                    x:Name="ExtraAxesPanel"
                                    Grid.Row="3"
                                    Margin="0,16,0,0"
                                    Visibility="Collapsed">
                                    <TextBlock
                                        FontSize="12"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Text="{DynamicResource Str_GameCtl_Axes}" />
                                    <StackPanel x:Name="ExtraAxesRows" Margin="0,6,0,0" />
                                </StackPanel>

                                <TextBlock
                                    Grid.Row="4"
                                    Margin="0,16,0,6"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{DynamicResource Str_GameCtl_Buttons}" />
                                <WrapPanel x:Name="ButtonsPanel" Grid.Row="5" />
                                <TextBlock
                                    x:Name="TxtPov"
                                    Grid.Row="6"
                                    Margin="0,8,0,0"
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextSecondary}" />
                            </Grid>
                        </ScrollViewer>

                        <!--  DRIFT AND RANGE  -->
                        <ScrollViewer
                            x:Name="PanelSticks"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto"
                            Visibility="Collapsed">
                            <Grid Height="{Binding ViewportHeight, ElementName=PanelSticks}" MinHeight="520">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{DynamicResource Str_GameCtl_SticksIntro}"
                                    TextWrapping="Wrap" />
                                <Grid Grid.Row="1" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>

                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" MinHeight="170" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextSecondary}"
                                            Text="{DynamicResource Str_GameCtl_LeftStick}" />
                                        <controls:StickPlotControl
                                            x:Name="PlotLeftTest"
                                            Grid.Row="1"
                                            Margin="0,6,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                        <StackPanel
                                            Grid.Row="2"
                                            Margin="0,8,0,0"
                                            Orientation="Horizontal">
                                            <Button
                                                x:Name="BtnRestLeft"
                                                Click="BtnRest_Click"
                                                Tag="L"
                                                ToolTip="{DynamicResource Str_GameCtl_RestTip}">
                                                <TextBlock Text="{DynamicResource Str_GameCtl_RestTest}" />
                                            </Button>
                                            <Button
                                                x:Name="BtnRangeLeft"
                                                Margin="6,0,0,0"
                                                Click="BtnRange_Click"
                                                Tag="L"
                                                ToolTip="{DynamicResource Str_GameCtl_RangeTip}">
                                                <TextBlock Text="{DynamicResource Str_GameCtl_RangeTest}" />
                                            </Button>
                                        </StackPanel>
                                        <TextBlock
                                            x:Name="TxtLeftResult"
                                            Grid.Row="3"
                                            Margin="0,8,0,0"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextPrimary}"
                                            TextWrapping="Wrap" />
                                        <Button
                                            x:Name="BtnUseLeft"
                                            Grid.Row="4"
                                            Margin="0,6,0,0"
                                            HorizontalAlignment="Left"
                                            Click="BtnUseSuggested_Click"
                                            Tag="L"
                                            Visibility="Collapsed">
                                            <TextBlock x:Name="TxtUseLeft" />
                                        </Button>
                                    </Grid>

                                    <Grid Grid.Column="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" MinHeight="170" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextSecondary}"
                                            Text="{DynamicResource Str_GameCtl_RightStick}" />
                                        <controls:StickPlotControl
                                            x:Name="PlotRightTest"
                                            Grid.Row="1"
                                            Margin="0,6,0,0"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center" />
                                        <StackPanel
                                            Grid.Row="2"
                                            Margin="0,8,0,0"
                                            Orientation="Horizontal">
                                            <Button
                                                x:Name="BtnRestRight"
                                                Click="BtnRest_Click"
                                                Tag="R"
                                                ToolTip="{DynamicResource Str_GameCtl_RestTip}">
                                                <TextBlock Text="{DynamicResource Str_GameCtl_RestTest}" />
                                            </Button>
                                            <Button
                                                x:Name="BtnRangeRight"
                                                Margin="6,0,0,0"
                                                Click="BtnRange_Click"
                                                Tag="R"
                                                ToolTip="{DynamicResource Str_GameCtl_RangeTip}">
                                                <TextBlock Text="{DynamicResource Str_GameCtl_RangeTest}" />
                                            </Button>
                                        </StackPanel>
                                        <TextBlock
                                            x:Name="TxtRightResult"
                                            Grid.Row="3"
                                            Margin="0,8,0,0"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextPrimary}"
                                            TextWrapping="Wrap" />
                                        <Button
                                            x:Name="BtnUseRight"
                                            Grid.Row="4"
                                            Margin="0,6,0,0"
                                            HorizontalAlignment="Left"
                                            Click="BtnUseSuggested_Click"
                                            Tag="R"
                                            Visibility="Collapsed">
                                            <TextBlock x:Name="TxtUseRight" />
                                        </Button>
                                    </Grid>
                                </Grid>
                            </Grid>
                        </ScrollViewer>

                        <!--  TRIGGERS  -->
                        <ScrollViewer
                            x:Name="PanelTriggers"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto"
                            Visibility="Collapsed">
                            <Grid Height="{Binding ViewportHeight, ElementName=PanelTriggers}" MinHeight="400">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="*" />
                                </Grid.RowDefinitions>
                                <TextBlock
                                    FontSize="12"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{DynamicResource Str_GameCtl_TriggersIntro}"
                                    TextWrapping="Wrap" />
                                <Grid Grid.Row="1" Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="16" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Grid>
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" MinHeight="140" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextSecondary}"
                                            Text="LT" />
                                        <controls:TriggerChartControl
                                            x:Name="ChartLT"
                                            Grid.Row="1"
                                            MaxHeight="320"
                                            Margin="0,6,0,0" />
                                        <Button
                                            x:Name="BtnRecLT"
                                            Grid.Row="2"
                                            Margin="0,8,0,0"
                                            HorizontalAlignment="Left"
                                            Click="BtnRecord_Click"
                                            Tag="L">
                                            <TextBlock Text="{DynamicResource Str_GameCtl_Record}" />
                                        </Button>
                                        <TextBlock
                                            x:Name="TxtLTResult"
                                            Grid.Row="3"
                                            Margin="0,8,0,0"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextPrimary}"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                    <Grid Grid.Column="2">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="*" MinHeight="140" />
                                            <RowDefinition Height="Auto" />
                                            <RowDefinition Height="Auto" />
                                        </Grid.RowDefinitions>
                                        <TextBlock
                                            FontSize="12"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextSecondary}"
                                            Text="RT" />
                                        <controls:TriggerChartControl
                                            x:Name="ChartRT"
                                            Grid.Row="1"
                                            MaxHeight="320"
                                            Margin="0,6,0,0" />
                                        <Button
                                            x:Name="BtnRecRT"
                                            Grid.Row="2"
                                            Margin="0,8,0,0"
                                            HorizontalAlignment="Left"
                                            Click="BtnRecord_Click"
                                            Tag="R">
                                            <TextBlock Text="{DynamicResource Str_GameCtl_Record}" />
                                        </Button>
                                        <TextBlock
                                            x:Name="TxtRTResult"
                                            Grid.Row="3"
                                            Margin="0,8,0,0"
                                            FontSize="12"
                                            Foreground="{DynamicResource TextPrimary}"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </ScrollViewer>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>
