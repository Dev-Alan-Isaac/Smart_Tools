<Window
    x:Class="Smart_Tools.WPF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Smart_Tools.WPF"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:Smart_Tools.WPF.Views"
    Title="{DynamicResource Str_App_Title}"
    Width="900"
    Height="550"
    MinWidth="360"
    MinHeight="420"
    Background="{DynamicResource ContentBg}"
    Closing="Window_Closing"
    FontFamily="{DynamicResource AppFont}"
    Icon="/Images/Icon.ico"
    PreviewKeyDown="Window_PreviewKeyDown"
    SizeChanged="Window_SizeChanged"
    StateChanged="Window_StateChanged"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized">

    <!--  Custom title bar: Windows draws only the resize frame, the caption is the TitleBar row below  -->
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="40"
            CornerRadius="0"
            GlassFrameThickness="0"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <!--  Shared easing so every motion in the shell feels like one family  -->
        <CubicEase x:Key="EaseOut" EasingMode="EaseOut" />
        <BackEase
            x:Key="EasePop"
            Amplitude="0.35"
            EasingMode="EaseOut" />

        <!--
            ============================================================
            NAV PILL
            - Hover: soft wash fades in and the content nudges 3px right
            - Active: tinted wash + gradient indicator bar that GROWS in
            (ScaleY 0 -> 1) instead of just appearing
            - Press: whole pill squeezes to 97% for tactile feedback
            Outer margin/padding metrics are unchanged so the compact
            sidebar layout in code-behind still lines up.
        -->
        <Style x:Key="SidebarNavButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarText}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border
                            x:Name="Bd"
                            Margin="8,2"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="BdScale" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <Grid>
                                <!--  Hover wash  -->
                                <Border
                                    x:Name="HoverOverlay"
                                    Background="{DynamicResource SidebarItemHoverBg}"
                                    CornerRadius="8"
                                    Opacity="0" />
                                <!--  Active wash (independent of hover)  -->
                                <Border
                                    x:Name="ActiveWash"
                                    Background="{DynamicResource AccentColorSubtle}"
                                    CornerRadius="8"
                                    Opacity="0" />
                                <!--  Keyboard focus ring (only visible when tabbing)  -->
                                <Border
                                    x:Name="FocusRing"
                                    BorderBrush="{DynamicResource AccentColor}"
                                    BorderThickness="1.5"
                                    CornerRadius="8"
                                    Opacity="0" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        x:Name="Indicator"
                                        Grid.Column="0"
                                        Width="3"
                                        Height="20"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource AccentGradient}"
                                        CornerRadius="2"
                                        Opacity="0"
                                        RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="IndicatorScale" ScaleX="1" ScaleY="0" />
                                        </Border.RenderTransform>
                                    </Border>
                                    <ContentPresenter
                                        Grid.Column="1"
                                        Margin="{TemplateBinding Padding}"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="Center">
                                        <ContentPresenter.RenderTransform>
                                            <TranslateTransform x:Name="ContentShift" X="0" />
                                        </ContentPresenter.RenderTransform>
                                    </ContentPresenter>
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!--  HOVER  -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="HoverOverlay"
                                                Storyboard.TargetProperty="Opacity"
                                                To="1"
                                                Duration="0:0:0.14" />
                                            <DoubleAnimation
                                                EasingFunction="{StaticResource EaseOut}"
                                                Storyboard.TargetName="ContentShift"
                                                Storyboard.TargetProperty="X"
                                                To="2"
                                                Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="HoverOverlay"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0"
                                                Duration="0:0:0.22" />
                                            <DoubleAnimation
                                                EasingFunction="{StaticResource EaseOut}"
                                                Storyboard.TargetName="ContentShift"
                                                Storyboard.TargetProperty="X"
                                                To="0"
                                                Duration="0:0:0.22" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <!--  PRESS  -->
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="BdScale"
                                                Storyboard.TargetProperty="ScaleX"
                                                To="0.97"
                                                Duration="0:0:0.08" />
                                            <DoubleAnimation
                                                Storyboard.TargetName="BdScale"
                                                Storyboard.TargetProperty="ScaleY"
                                                To="0.97"
                                                Duration="0:0:0.08" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                EasingFunction="{StaticResource EasePop}"
                                                Storyboard.TargetName="BdScale"
                                                Storyboard.TargetProperty="ScaleX"
                                                To="1"
                                                Duration="0:0:0.25" />
                                            <DoubleAnimation
                                                EasingFunction="{StaticResource EasePop}"
                                                Storyboard.TargetName="BdScale"
                                                Storyboard.TargetProperty="ScaleY"
                                                To="1"
                                                Duration="0:0:0.25" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <!--  ACTIVE PAGE  -->
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="ActiveWash"
                                                Storyboard.TargetProperty="Opacity"
                                                To="1"
                                                Duration="0:0:0.2" />
                                            <DoubleAnimation
                                                Storyboard.TargetName="Indicator"
                                                Storyboard.TargetProperty="Opacity"
                                                To="1"
                                                Duration="0:0:0.12" />
                                            <DoubleAnimation
                                                EasingFunction="{StaticResource EasePop}"
                                                Storyboard.TargetName="IndicatorScale"
                                                Storyboard.TargetProperty="ScaleY"
                                                To="1"
                                                Duration="0:0:0.3" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="ActiveWash"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0"
                                                Duration="0:0:0.2" />
                                            <DoubleAnimation
                                                Storyboard.TargetName="Indicator"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0"
                                                Duration="0:0:0.2" />
                                            <DoubleAnimation
                                                EasingFunction="{StaticResource EaseOut}"
                                                Storyboard.TargetName="IndicatorScale"
                                                Storyboard.TargetProperty="ScaleY"
                                                To="0"
                                                Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter Property="Foreground" Value="{DynamicResource AccentColor}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>

                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Section headers (DATA QUALITY, FILE MANAGEMENT, ...)  -->
        <Style x:Key="SidebarHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextMuted}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="20,22,0,6" />
            <Setter Property="Opacity" Value="0.75" />
        </Style>

        <!--
            Small standalone icon buttons (theme toggle, contact) - plain
            Buttons, not part of the MainNav group. Hover wash + a smooth
            squeeze-and-spring press instead of a hard snap.
        -->
        <Style x:Key="SidebarIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10"
                            RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="BdScale" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <Grid>
                                <Border
                                    x:Name="HoverOverlay"
                                    Background="{DynamicResource SidebarItemHoverBg}"
                                    CornerRadius="10"
                                    Opacity="0" />
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    RenderTransformOrigin="0.5,0.5">
                                    <ContentPresenter.RenderTransform>
                                        <RotateTransform x:Name="IconSpin" Angle="0" />
                                    </ContentPresenter.RenderTransform>
                                </ContentPresenter>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="HoverOverlay"
                                                Storyboard.TargetProperty="Opacity"
                                                To="1"
                                                Duration="0:0:0.14" />
                                            <DoubleAnimation
                                                EasingFunction="{StaticResource EasePop}"
                                                Storyboard.TargetName="IconSpin"
                                                Storyboard.TargetProperty="Angle"
                                                To="12"
                                                Duration="0:0:0.25" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="HoverOverlay"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0"
                                                Duration="0:0:0.22" />
                                            <DoubleAnimation
                                                EasingFunction="{StaticResource EaseOut}"
                                                Storyboard.TargetName="IconSpin"
                                                Storyboard.TargetProperty="Angle"
                                                To="0"
                                                Duration="0:0:0.22" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="BdScale"
                                                Storyboard.TargetProperty="ScaleX"
                                                To="0.88"
                                                Duration="0:0:0.08" />
                                            <DoubleAnimation
                                                Storyboard.TargetName="BdScale"
                                                Storyboard.TargetProperty="ScaleY"
                                                To="0.88"
                                                Duration="0:0:0.08" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                EasingFunction="{StaticResource EasePop}"
                                                Storyboard.TargetName="BdScale"
                                                Storyboard.TargetProperty="ScaleX"
                                                To="1"
                                                Duration="0:0:0.3" />
                                            <DoubleAnimation
                                                EasingFunction="{StaticResource EasePop}"
                                                Storyboard.TargetName="BdScale"
                                                Storyboard.TargetProperty="ScaleY"
                                                To="1"
                                                Duration="0:0:0.3" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Collapsible section header in the sidebar (chevron, colour dot,
            name, count). Built in code from ToolCatalogManager; Click folds
            the section open/closed.
        -->
        <Style x:Key="SidebarSectionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextMuted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Margin="8,6,8,1"
                            Padding="12,7,12,7"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarItemHoverBg}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Caption button (minimize / maximize / close) for the custom title bar.
            Glyph is a Segoe Fluent Icons / MDL2 character set as Content.
            Tag="Close" turns the hover red like a native Windows close button.
        -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowBg}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBorder}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="Tag" Value="Close" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DangerFill}" />
                                <Setter Property="Foreground" Value="White" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="40" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--  ================= TITLE BAR =================  -->
        <Grid
            x:Name="TitleBar"
            Grid.Row="0"
            Background="{DynamicResource ContentBg}">
            <StackPanel
                Margin="14,0,0,0"
                HorizontalAlignment="Left"
                VerticalAlignment="Center"
                IsHitTestVisible="False"
                Orientation="Horizontal">
                <Border
                    Width="20"
                    Height="20"
                    Margin="0,0,10,0"
                    Background="{DynamicResource AccentGradient}"
                    CornerRadius="6">
                    <materialDesign:PackIcon
                        Width="13"
                        Height="13"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="White"
                        Kind="ToolboxOutline" />
                </Border>
                <TextBlock
                    VerticalAlignment="Center"
                    FontSize="12"
                    Foreground="{DynamicResource TextSecondary}"
                    Text="{DynamicResource Str_App_Title}" />
            </StackPanel>

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button
                    x:Name="BtnWinMinimize"
                    Click="BtnWinMinimize_Click"
                    Content="&#xE921;"
                    Style="{StaticResource TitleBarButtonStyle}" />
                <Button
                    x:Name="BtnWinMaximize"
                    Click="BtnWinMaximize_Click"
                    Content="&#xE922;"
                    Style="{StaticResource TitleBarButtonStyle}" />
                <Button
                    x:Name="BtnWinClose"
                    Click="BtnWinClose_Click"
                    Content="&#xE8BB;"
                    Style="{StaticResource TitleBarButtonStyle}"
                    Tag="Close" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="252" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--
                ================= SIDEBAR =================
                The Effect renders outside the Border's own layout bounds and
                the parent Grid doesn't clip by default, so this soft shadow
                bleeds a few pixels into the content column - reads as a
                panel gently floating above the content instead of a flat
                block of color butted up against it.
            -->
            <!--
                Shadow caster for the sidebar. Kept as an EMPTY sibling rather
                than an Effect on the sidebar itself: an Effect on the panel
                would render all 45 nav items (and every hover animation)
                through an offscreen bitmap and drop their text to greyscale
                anti-aliasing. Panel.ZIndex keeps it above the content column
                so the shadow still falls onto it.
            -->
            <Border
                Grid.Column="0"
                Margin="12,0,0,12"
                Panel.ZIndex="1"
                Background="{DynamicResource SidebarBg}"
                CornerRadius="16"
                IsHitTestVisible="False">
                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="24"
                        Direction="270"
                        Opacity="0.16"
                        ShadowDepth="4"
                        Color="Black" />
                </Border.Effect>
            </Border>

            <Border
                Grid.Column="0"
                Margin="12,0,0,12"
                Panel.ZIndex="2"
                Background="{DynamicResource SidebarBg}"
                CornerRadius="16">
                <Grid>

                    <!--
                        Soft accent glow behind the brand area. Uses the theme's
                        AccentGradient at low opacity and fades it out downward
                        with an OpacityMask, so it follows Light/Dark automatically
                        and adds depth without a hard edge.
                    -->
                    <Border
                        Height="170"
                        VerticalAlignment="Top"
                        Background="{DynamicResource AccentGradient}"
                        CornerRadius="16,16,0,0"
                        IsHitTestVisible="False"
                        Opacity="0.07">
                        <Border.OpacityMask>
                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                <GradientStop Offset="0" Color="Black" />
                                <GradientStop Offset="1" Color="Transparent" />
                            </LinearGradientBrush>
                        </Border.OpacityMask>
                    </Border>

                    <DockPanel>

                        <!--  App title / logo area  -->
                        <Border
                            Padding="18,20,18,16"
                            BorderBrush="{DynamicResource SidebarBorder}"
                            BorderThickness="0,0,0,1"
                            DockPanel.Dock="Top">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel
                                    Grid.Column="0"
                                    Margin="-10,0,0,0"
                                    Orientation="Horizontal">

                                    <!--  Gradient brand badge - purely decorative, no code-behind reference  -->
                                    <Border
                                        Width="34"
                                        Height="34"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Top"
                                        Background="{DynamicResource AccentGradient}"
                                        CornerRadius="10">
                                        <Border.Effect>
                                            <DropShadowEffect
                                                BlurRadius="12"
                                                Direction="270"
                                                Opacity="0.18"
                                                ShadowDepth="3"
                                                Color="Black" />
                                        </Border.Effect>
                                        <materialDesign:PackIcon
                                            Width="19"
                                            Height="19"
                                            HorizontalAlignment="Center"
                                            VerticalAlignment="Center"
                                            Foreground="White"
                                            Kind="ToolboxOutline" />
                                    </Border>

                                    <StackPanel>
                                        <TextBlock
                                            x:Name="TxtAppTitle"
                                            FontSize="18"
                                            FontWeight="Bold"
                                            Foreground="{DynamicResource SidebarText}"
                                            MouseLeftButtonDown="TxtAppTitle_MouseLeftButtonDown"
                                            Text="{DynamicResource Str_App_Title}" />
                                        <TextBlock
                                            x:Name="TxtAppSubtitle"
                                            Margin="0,2,0,0"
                                            FontSize="11"
                                            Foreground="{DynamicResource SidebarTextMuted}"
                                            Text="{DynamicResource Str_App_Subtitle}" />
                                    </StackPanel>
                                </StackPanel>

                                <StackPanel
                                    Grid.Column="1"
                                    VerticalAlignment="Top"
                                    Orientation="Horizontal">

                                    <Button
                                        x:Name="BtnContactDeveloper"
                                        Click="BtnContactDeveloper_Click"
                                        Style="{StaticResource SidebarIconButtonStyle}"
                                        ToolTip="{DynamicResource Str_Main_ContactDeveloper}">
                                        <materialDesign:PackIcon
                                            Width="17"
                                            Height="17"
                                            Foreground="{DynamicResource SidebarText}"
                                            Kind="EmailOutline" />
                                    </Button>

                                    <Button
                                        x:Name="BtnThemeToggle"
                                        Margin="2,0,0,0"
                                        Click="BtnThemeToggle_Click"
                                        Style="{StaticResource SidebarIconButtonStyle}"
                                        ToolTip="{DynamicResource Str_Main_SwitchBetweenLightAnd}">
                                        <materialDesign:PackIcon
                                            x:Name="IconThemeToggle"
                                            Width="18"
                                            Height="18"
                                            Foreground="{DynamicResource SidebarText}"
                                            Kind="WeatherNight" />
                                    </Button>

                                </StackPanel>

                            </Grid>
                        </Border>

                        <!--
                            Home (all tools as cards + search) - pinned above the
                            sections. Ctrl+K anywhere opens it with search focused.
                        -->
                        <StackPanel Margin="0,8,0,0" DockPanel.Dock="Top">
                            <RadioButton
                                x:Name="BtnHome"
                                Click="BtnHome_Click"
                                GroupName="MainNav"
                                Style="{StaticResource SidebarNavButtonStyle}"
                                ToolTip="{DynamicResource Str_Main_HomeEveryToolWith}">
                                <Grid HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon
                                        Grid.Column="0"
                                        Width="18"
                                        Height="18"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Kind="HomeOutline" />
                                    <TextBlock
                                        x:Name="LblHome"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="{DynamicResource Str_Main_Home}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </RadioButton>
                        </StackPanel>

                        <!--  Settings pinned at the bottom  -->
                        <Border
                            Padding="0,6,0,10"
                            BorderBrush="{DynamicResource SidebarBorder}"
                            BorderThickness="0,1,0,0"
                            DockPanel.Dock="Bottom">
                            <RadioButton
                                x:Name="BtnSettings"
                                Click="BtnSettings_Click"
                                GroupName="MainNav"
                                Style="{StaticResource SidebarNavButtonStyle}"
                                ToolTip="{DynamicResource Str_Nav_Settings}">
                                <Grid HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon
                                        Grid.Column="0"
                                        Width="18"
                                        Height="18"
                                        Margin="0,0,10,0"
                                        VerticalAlignment="Center"
                                        Kind="Cog" />
                                    <TextBlock
                                        x:Name="LblSettings"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Text="{DynamicResource Str_Nav_Settings}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </RadioButton>
                        </Border>

                        <!--
                            Recent + the sections (Data Quality, Files, ... Music ...)
                            are built in code-behind from Controllers/ToolCatalogManager.cs
                            - the one list of tools. To move a tool to another section,
                            change it there; nothing here.
                        -->
                        <ScrollViewer
                            x:Name="NavScroll"
                            HorizontalScrollBarVisibility="Disabled"
                            VerticalScrollBarVisibility="Auto">
                            <StackPanel
                                x:Name="NavPanel"
                                Margin="0,0,0,12"
                                KeyboardNavigation.DirectionalNavigation="Cycle" />
                        </ScrollViewer>


                    </DockPanel>
                </Grid>
            </Border>

            <!--  ================= CONTENT AREA =================  -->
            <Border Grid.Column="1" Background="{DynamicResource ContentBg}">

                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!--
                        ================= PAGE HEADER CARD =================
                        Replaces the flat full-width breadcrumb strip with a
                        rounded card that floats over the content background.
                        Shows the active tool's icon (in a gradient badge that
                        pops on every navigation) plus "Smart Tools › Section"
                        above the tool name. Icon + section are filled in by
                        NavigateTo in code-behind.
                    -->
                    <!--  Shadow layer (empty) + card on top: crisp header text  -->
                    <Border
                        Grid.Row="0"
                        Margin="16,4,16,8"
                        Background="{DynamicResource CardBg}"
                        CornerRadius="12"
                        Effect="{DynamicResource CardElevation}"
                        IsHitTestVisible="False" />
                    <Border
                        Grid.Row="0"
                        Margin="16,4,16,8"
                        Padding="14,10,18,10"
                        Background="{DynamicResource CardBg}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1"
                        CornerRadius="12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <!--  Back to the page that was open before this one (hidden until there is one)  -->
                            <Button
                                x:Name="BtnBack"
                                Grid.Column="0"
                                Width="36"
                                Height="36"
                                Margin="0,0,10,0"
                                Padding="0"
                                VerticalAlignment="Center"
                                Click="BtnBack_Click"
                                Style="{StaticResource NeutralIconButtonStyle}"
                                ToolTip="{DynamicResource Str_Shell_Back}"
                                Visibility="Collapsed">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    Kind="ArrowLeft" />
                            </Button>

                            <Border
                                x:Name="ActiveToolBadge"
                                Grid.Column="1"
                                Width="36"
                                Height="36"
                                Margin="0,0,12,0"
                                VerticalAlignment="Center"
                                Background="{DynamicResource AccentGradient}"
                                CornerRadius="9"
                                RenderTransformOrigin="0.5,0.5">
                                <Border.RenderTransform>
                                    <ScaleTransform x:Name="ActiveToolBadgeScale" ScaleX="1" ScaleY="1" />
                                </Border.RenderTransform>
                                <materialDesign:PackIcon
                                    x:Name="IconActiveTool"
                                    Width="20"
                                    Height="20"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="White"
                                    Kind="HomeOutline" />
                            </Border>

                            <StackPanel Grid.Column="2" VerticalAlignment="Center">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock
                                        FontSize="11.5"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Text="{DynamicResource Str_App_Title}" />
                                    <TextBlock
                                        Margin="6,0"
                                        FontSize="11.5"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Text="›" />
                                    <TextBlock
                                        x:Name="TxtBreadcrumbSection"
                                        FontSize="11.5"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Text="{DynamicResource Str_Main_Home}" />
                                </StackPanel>
                                <TextBlock
                                    x:Name="TxtBreadcrumbActive"
                                    Margin="0,1,0,0"
                                    FontSize="17"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextPrimary}"
                                    Text="{DynamicResource Str_Main_Home}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>

                            <!--  Starts the guided tour of the page that is open (enabled only when the page has one)  -->
                            <Button
                                x:Name="BtnHelpTour"
                                Grid.Column="3"
                                Width="90"
                                Margin="12,0,0,0"
                                VerticalAlignment="Center"
                                Click="BtnHelpTour_Click"
                                Style="{StaticResource NeutralIconButtonStyle}"
                                ToolTip="{DynamicResource Str_Tour_Help}"
                                ToolTipService.ShowOnDisabled="True">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        VerticalAlignment="Center"
                                        Kind="HelpCircleOutline" />
                                    <TextBlock Margin="6,0,0,0" Text="{DynamicResource Str_Tour_HelpButton}" />
                                </StackPanel>
                            </Button>
                        </Grid>
                    </Border>

                    <!--
                        No ScrollViewer here on purpose: this Grid row now gives the
                        active view a bounded height equal to the window's content
                        area. Each view manages its own internal scrolling (its
                        options sidebar has its own ScrollViewer, and any DataGrid
                        scrolls internally via VerticalScrollBarVisibility="Auto").
                        Wrapping this in a ScrollViewer would hand every child an
                        effectively infinite available height, which is what let a
                        large DataGrid (e.g. 10,000+ rows) balloon the whole page
                        instead of scrolling within its own bounds.
                    -->
                    <ContentControl
                        x:Name="MainContentArea"
                        Grid.Row="1"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                        <!--  Animated by NavigateTo: each tool fades + slides up into place  -->
                        <ContentControl.RenderTransform>
                            <TranslateTransform x:Name="ContentSlide" Y="0" />
                        </ContentControl.RenderTransform>
                    </ContentControl>

                    <!--  Guided tour: over the header and the page, hidden until the Help button is used  -->
                    <views:TourOverlay x:Name="TourLayer" Grid.RowSpan="2" />

                </Grid>

            </Border>

        </Grid>
    </Grid>
</Window>
