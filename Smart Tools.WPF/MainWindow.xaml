<Window
    x:Class="Smart_Tools.WPF.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="clr-namespace:Smart_Tools.WPF"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:views="clr-namespace:Smart_Tools.WPF.Views"
    Title="{DynamicResource Str_App_Title}"
    Width="900"
    Height="550"
    MinWidth="520"
    MinHeight="420"
    Background="{DynamicResource ContentBg}"
    Closing="Window_Closing"
    FontFamily="{DynamicResource AppFont}"
    Icon="/Images/Icon.ico"
    PreviewKeyDown="Window_PreviewKeyDown"
    SizeChanged="Window_SizeChanged"
    StateChanged="Window_StateChanged"
    WindowStartupLocation="CenterScreen"
    WindowState="Maximized">

    <!--  Custom title bar: Windows draws only the resize frame, the caption is the TitleBar row below  -->
    <WindowChrome.WindowChrome>
        <WindowChrome
            CaptionHeight="52"
            CornerRadius="0"
            GlassFrameThickness="0"
            ResizeBorderThickness="6"
            UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Window.Resources>

        <!--  Shared easing so every motion in the shell feels like one family  -->
        <CubicEase x:Key="EaseOut" EasingMode="EaseOut" />
        <BackEase
            x:Key="EasePop"
            Amplitude="0.35"
            EasingMode="EaseOut" />

        <!--
            ============================================================
            NAV PILL
            - Hover: soft wash fades in and the content nudges 3px right
            - Active: tinted wash + gradient indicator bar that GROWS in
            (ScaleY 0 -> 1) instead of just appearing
            - Press: whole pill squeezes to 97% for tactile feedback
            Outer margin/padding metrics are unchanged so the compact
            sidebar layout in code-behind still lines up.
        -->
        <Style x:Key="SidebarNavButtonStyle" TargetType="RadioButton">
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Foreground" Value="{DynamicResource SidebarText}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="18,9" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border
                            x:Name="Bd"
                            Margin="8,2"
                            Background="{TemplateBinding Background}"
                            CornerRadius="8"
                            RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="BdScale" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <Grid>
                                <!--  Hover wash  -->
                                <Border
                                    x:Name="HoverOverlay"
                                    Background="{DynamicResource SidebarItemHoverBg}"
                                    CornerRadius="8"
                                    Opacity="0" />
                                <!--  Active wash (independent of hover)  -->
                                <Border
                                    x:Name="ActiveWash"
                                    Background="{DynamicResource AccentColorSubtle}"
                                    CornerRadius="8"
                                    Opacity="0" />
                                <!--  Keyboard focus ring (only visible when tabbing)  -->
                                <Border
                                    x:Name="FocusRing"
                                    BorderBrush="{DynamicResource AccentColor}"
                                    BorderThickness="1.5"
                                    CornerRadius="8"
                                    Opacity="0" />

                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="4" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Border
                                        x:Name="Indicator"
                                        Grid.Column="0"
                                        Width="3"
                                        Height="20"
                                        HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource AccentGradient}"
                                        CornerRadius="2"
                                        Opacity="0"
                                        RenderTransformOrigin="0.5,0.5">
                                        <Border.RenderTransform>
                                            <ScaleTransform x:Name="IndicatorScale" ScaleX="1" ScaleY="0" />
                                        </Border.RenderTransform>
                                    </Border>
                                    <ContentPresenter
                                        Grid.Column="1"
                                        Margin="{TemplateBinding Padding}"
                                        HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                        VerticalAlignment="Center">
                                        <ContentPresenter.RenderTransform>
                                            <TranslateTransform x:Name="ContentShift" X="0" />
                                        </ContentPresenter.RenderTransform>
                                    </ContentPresenter>
                                </Grid>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <!--  HOVER  -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="HoverOverlay"
                                                Storyboard.TargetProperty="Opacity"
                                                To="1"
                                                Duration="0:0:0.14" />
                                            <DoubleAnimation
                                                EasingFunction="{StaticResource EaseOut}"
                                                Storyboard.TargetName="ContentShift"
                                                Storyboard.TargetProperty="X"
                                                To="2"
                                                Duration="0:0:0.18" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="HoverOverlay"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0"
                                                Duration="0:0:0.22" />
                                            <DoubleAnimation
                                                EasingFunction="{StaticResource EaseOut}"
                                                Storyboard.TargetName="ContentShift"
                                                Storyboard.TargetProperty="X"
                                                To="0"
                                                Duration="0:0:0.22" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <!--  PRESS  -->
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="BdScale"
                                                Storyboard.TargetProperty="ScaleX"
                                                To="0.97"
                                                Duration="0:0:0.08" />
                                            <DoubleAnimation
                                                Storyboard.TargetName="BdScale"
                                                Storyboard.TargetProperty="ScaleY"
                                                To="0.97"
                                                Duration="0:0:0.08" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                EasingFunction="{StaticResource EasePop}"
                                                Storyboard.TargetName="BdScale"
                                                Storyboard.TargetProperty="ScaleX"
                                                To="1"
                                                Duration="0:0:0.25" />
                                            <DoubleAnimation
                                                EasingFunction="{StaticResource EasePop}"
                                                Storyboard.TargetName="BdScale"
                                                Storyboard.TargetProperty="ScaleY"
                                                To="1"
                                                Duration="0:0:0.25" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>

                            <!--  ACTIVE PAGE  -->
                            <Trigger Property="IsChecked" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="ActiveWash"
                                                Storyboard.TargetProperty="Opacity"
                                                To="1"
                                                Duration="0:0:0.2" />
                                            <DoubleAnimation
                                                Storyboard.TargetName="Indicator"
                                                Storyboard.TargetProperty="Opacity"
                                                To="1"
                                                Duration="0:0:0.12" />
                                            <DoubleAnimation
                                                EasingFunction="{StaticResource EasePop}"
                                                Storyboard.TargetName="IndicatorScale"
                                                Storyboard.TargetProperty="ScaleY"
                                                To="1"
                                                Duration="0:0:0.3" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="ActiveWash"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0"
                                                Duration="0:0:0.2" />
                                            <DoubleAnimation
                                                Storyboard.TargetName="Indicator"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0"
                                                Duration="0:0:0.2" />
                                            <DoubleAnimation
                                                EasingFunction="{StaticResource EaseOut}"
                                                Storyboard.TargetName="IndicatorScale"
                                                Storyboard.TargetProperty="ScaleY"
                                                To="0"
                                                Duration="0:0:0.2" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                                <Setter Property="Foreground" Value="{DynamicResource AccentColor}" />
                                <Setter Property="FontWeight" Value="SemiBold" />
                            </Trigger>

                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="FocusRing" Property="Opacity" Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Section headers (DATA QUALITY, FILE MANAGEMENT, ...)  -->
        <Style x:Key="SidebarHeaderStyle" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextMuted}" />
            <Setter Property="FontSize" Value="10.5" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="20,22,0,6" />
            <Setter Property="Opacity" Value="0.75" />
        </Style>

        <!--
            Small standalone icon buttons (theme toggle, contact) - plain
            Buttons, not part of the MainNav group. Hover wash + a smooth
            squeeze-and-spring press instead of a hard snap.
        -->
        <Style x:Key="SidebarIconButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="32" />
            <Setter Property="Height" Value="32" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Background="{TemplateBinding Background}"
                            CornerRadius="10"
                            RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="BdScale" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <Grid>
                                <Border
                                    x:Name="HoverOverlay"
                                    Background="{DynamicResource SidebarItemHoverBg}"
                                    CornerRadius="10"
                                    Opacity="0" />
                                <ContentPresenter
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    RenderTransformOrigin="0.5,0.5">
                                    <ContentPresenter.RenderTransform>
                                        <RotateTransform x:Name="IconSpin" Angle="0" />
                                    </ContentPresenter.RenderTransform>
                                </ContentPresenter>
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="HoverOverlay"
                                                Storyboard.TargetProperty="Opacity"
                                                To="1"
                                                Duration="0:0:0.14" />
                                            <DoubleAnimation
                                                EasingFunction="{StaticResource EasePop}"
                                                Storyboard.TargetName="IconSpin"
                                                Storyboard.TargetProperty="Angle"
                                                To="12"
                                                Duration="0:0:0.25" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="HoverOverlay"
                                                Storyboard.TargetProperty="Opacity"
                                                To="0"
                                                Duration="0:0:0.22" />
                                            <DoubleAnimation
                                                EasingFunction="{StaticResource EaseOut}"
                                                Storyboard.TargetName="IconSpin"
                                                Storyboard.TargetProperty="Angle"
                                                To="0"
                                                Duration="0:0:0.22" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="BdScale"
                                                Storyboard.TargetProperty="ScaleX"
                                                To="0.88"
                                                Duration="0:0:0.08" />
                                            <DoubleAnimation
                                                Storyboard.TargetName="BdScale"
                                                Storyboard.TargetProperty="ScaleY"
                                                To="0.88"
                                                Duration="0:0:0.08" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                EasingFunction="{StaticResource EasePop}"
                                                Storyboard.TargetName="BdScale"
                                                Storyboard.TargetProperty="ScaleX"
                                                To="1"
                                                Duration="0:0:0.3" />
                                            <DoubleAnimation
                                                EasingFunction="{StaticResource EasePop}"
                                                Storyboard.TargetName="BdScale"
                                                Storyboard.TargetProperty="ScaleY"
                                                To="1"
                                                Duration="0:0:0.3" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Collapsible section header in the sidebar (chevron, colour dot,
            name, count). Built in code from ToolCatalogManager; Click folds
            the section open/closed.
        -->
        <Style x:Key="SidebarSectionButtonStyle" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource SidebarTextMuted}" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Margin="8,6,8,1"
                            Padding="12,7,12,7"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarItemHoverBg}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--
            Caption button (minimize / maximize / close) for the custom title bar.
            Glyph is a Segoe Fluent Icons / MDL2 character set as Content.
            Tag="Close" turns the hover red like a native Windows close button.
        -->
        <Style x:Key="TitleBarButtonStyle" TargetType="Button">
            <Setter Property="Width" Value="46" />
            <Setter Property="Height" Value="40" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontFamily" Value="Segoe Fluent Icons, Segoe MDL2 Assets" />
            <Setter Property="FontSize" Value="10" />
            <Setter Property="Focusable" Value="False" />
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd" Background="Transparent">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowBg}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource CardBorder}" />
                            </Trigger>
                            <MultiTrigger>
                                <MultiTrigger.Conditions>
                                    <Condition Property="IsMouseOver" Value="True" />
                                    <Condition Property="Tag" Value="Close" />
                                </MultiTrigger.Conditions>
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource DangerFill}" />
                                <Setter Property="Foreground" Value="White" />
                            </MultiTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>


        <!--
            ============================================================
            COMMAND BAR (title bar) controls: flat 36 px icon buttons, an icon toggle for Home / Settings that shows which page is
            open, and the search field that opens the tool search (Ctrl+K). All of them take clicks inside the window caption.
        -->
        <Style x:Key="TitleIconButtonStyle" TargetType="Button">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowBg}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleNavToggleStyle" TargetType="RadioButton">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="2,0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border
                            x:Name="Bd"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="8">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowBg}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentColorSubtle}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentColor}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="TitleSearchStyle" TargetType="Button">
            <Setter Property="WindowChrome.IsHitTestVisibleInChrome" Value="True" />
            <Setter Property="Height" Value="34" />
            <Setter Property="Cursor" Value="IBeam" />
            <Setter Property="Foreground" Value="{DynamicResource TextSecondary}" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Padding="12,0,6,0"
                            Background="{DynamicResource CardBg}"
                            BorderBrush="{DynamicResource CardBorder}"
                            BorderThickness="1"
                            CornerRadius="8">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource InputBorder}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="52" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!--
            ================= COMMAND BAR (the title bar) =================
            Left: brand, Back, Home, and where you are (tool icon, section > tool). Middle: the tool search (Ctrl+K opens the same).
            Right: Help (guided tour of the page), contact, theme, Settings, and the window buttons. There is no tool list down the
            side any more: the tool gets the whole width, and Home lists every tool by section with Recent and Favorites.
        -->
        <Grid
            x:Name="TitleBar"
            Grid.Row="0"
            SizeChanged="TitleBar_SizeChanged"
            Background="{DynamicResource ContentBg}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel
                x:Name="TitleLeft"
                Grid.Column="0"
                Margin="12,0,8,0"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <!--  Brand: part of the title bar's drag area. (The memorial easter egg is typing "toxy" in a search, see Controllers/MemorialEgg.cs.)  -->
                <Border
                    x:Name="BrandArea"
                    Margin="0,0,10,0"
                    VerticalAlignment="Stretch">
                    <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                        <Border
                            Width="26"
                            Height="26"
                            Margin="0,0,8,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AccentFill}"
                            CornerRadius="7">
                            <materialDesign:PackIcon
                                Width="16"
                                Height="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="White"
                                Kind="ToolboxOutline" />
                        </Border>
                        <TextBlock
                            x:Name="TxtAppTitle"
                            VerticalAlignment="Center"
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimary}"
                            Text="{DynamicResource Str_App_Title}" />
                    </StackPanel>
                </Border>
                <TextBlock
                    x:Name="TxtAppSubtitle"
                    Text="{DynamicResource Str_App_Subtitle}"
                    Visibility="Collapsed" />

                <Border
                    Width="1"
                    Height="20"
                    Margin="2,0,6,0"
                    Background="{DynamicResource CardBorder}" />

                <!--  Back to the page that was open before this one (hidden until there is one)  -->
                <Button
                    x:Name="BtnBack"
                    Click="BtnBack_Click"
                    Style="{StaticResource TitleIconButtonStyle}"
                    ToolTip="{DynamicResource Str_Shell_Back}"
                    Visibility="Collapsed">
                    <materialDesign:PackIcon
                        Width="18"
                        Height="18"
                        Kind="ArrowLeft" />
                </Button>

                <RadioButton
                    x:Name="BtnHome"
                    Click="BtnHome_Click"
                    GroupName="MainNav"
                    Style="{StaticResource TitleNavToggleStyle}"
                    ToolTip="{DynamicResource Str_Main_HomeEveryToolWith}">
                    <Grid>
                        <materialDesign:PackIcon
                            Width="18"
                            Height="18"
                            Kind="HomeOutline" />
                        <TextBlock
                            x:Name="LblHome"
                            Text="{DynamicResource Str_Main_Home}"
                            Visibility="Collapsed" />
                    </Grid>
                </RadioButton>

                <!--  Where you are: the tool's icon, its section and its name  -->
                <Border
                    x:Name="ActiveToolBadge"
                    Width="28"
                    Height="28"
                    Margin="10,0,10,0"
                    VerticalAlignment="Center"
                    Background="{DynamicResource AccentColorSubtle}"
                    CornerRadius="7"
                    IsHitTestVisible="False"
                    RenderTransformOrigin="0.5,0.5">
                    <Border.RenderTransform>
                        <ScaleTransform x:Name="ActiveToolBadgeScale" ScaleX="1" ScaleY="1" />
                    </Border.RenderTransform>
                    <materialDesign:PackIcon
                        x:Name="IconActiveTool"
                        Width="17"
                        Height="17"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource AccentColor}"
                        Kind="HomeOutline" />
                </Border>
                <StackPanel
                    x:Name="BreadcrumbPanel"
                    VerticalAlignment="Center"
                    IsHitTestVisible="False"
                    Orientation="Horizontal">
                    <TextBlock
                        x:Name="TxtBreadcrumbSection"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondary}"
                        Text="{DynamicResource Str_Main_Home}" />
                    <TextBlock
                        x:Name="TxtBreadcrumbChevron"
                        Margin="6,0"
                        VerticalAlignment="Center"
                        FontSize="12"
                        Foreground="{DynamicResource TextSecondary}"
                        Text="›" />
                    <TextBlock
                        x:Name="TxtBreadcrumbActive"
                        MaxWidth="320"
                        VerticalAlignment="Center"
                        FontSize="14"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        Text="{DynamicResource Str_Main_Home}"
                        TextTrimming="CharacterEllipsis" />
                </StackPanel>
            </StackPanel>

            <!--  Tool search: opens the same search as Ctrl+K, from any page  -->
            <Button
                x:Name="BtnSearchTools"
                Grid.Column="2"
                Width="420"
                Margin="8,0"
                VerticalAlignment="Center"
                Click="BtnSearchTools_Click"
                Style="{StaticResource TitleSearchStyle}"
                ToolTip="{DynamicResource Str_Shell_SearchTip}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon
                        x:Name="IconSearch"
                        Width="16"
                        Height="16"
                        Margin="0,0,8,0"
                        VerticalAlignment="Center"
                        Kind="Magnify" />
                    <TextBlock
                        x:Name="TxtSearchLabel"
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="12.5"
                        Text="{DynamicResource Str_Shell_Search}"
                        TextTrimming="CharacterEllipsis" />
                    <Border
                        x:Name="SearchKeyChip"
                        Grid.Column="2"
                        Padding="6,1"
                        VerticalAlignment="Center"
                        Background="{DynamicResource RowBg}"
                        BorderBrush="{DynamicResource CardBorder}"
                        BorderThickness="1"
                        CornerRadius="5">
                        <TextBlock FontSize="11" Text="Ctrl+K" />
                    </Border>
                </Grid>
            </Button>

            <StackPanel
                x:Name="TitleRight"
                Grid.Column="4"
                VerticalAlignment="Center"
                Orientation="Horizontal">
                <!--  Starts the guided tour of the page that is open (enabled only when the page has one)  -->
                <Button
                    x:Name="BtnHelpTour"
                    Click="BtnHelpTour_Click"
                    Style="{StaticResource TitleIconButtonStyle}"
                    ToolTip="{DynamicResource Str_Tour_Help}"
                    ToolTipService.ShowOnDisabled="True">
                    <materialDesign:PackIcon
                        Width="18"
                        Height="18"
                        Kind="HelpCircleOutline" />
                </Button>
                <Button
                    x:Name="BtnContactDeveloper"
                    Click="BtnContactDeveloper_Click"
                    Style="{StaticResource TitleIconButtonStyle}"
                    ToolTip="{DynamicResource Str_Main_ContactDeveloper}">
                    <materialDesign:PackIcon
                        Width="18"
                        Height="18"
                        Kind="EmailOutline" />
                </Button>
                <Button
                    x:Name="BtnThemeToggle"
                    Click="BtnThemeToggle_Click"
                    Style="{StaticResource TitleIconButtonStyle}"
                    ToolTip="{DynamicResource Str_Main_SwitchBetweenLightAnd}">
                    <materialDesign:PackIcon
                        x:Name="IconThemeToggle"
                        Width="18"
                        Height="18"
                        Kind="WeatherNight" />
                </Button>
                <RadioButton
                    x:Name="BtnSettings"
                    Click="BtnSettings_Click"
                    GroupName="MainNav"
                    Style="{StaticResource TitleNavToggleStyle}"
                    ToolTip="{DynamicResource Str_Nav_Settings}">
                    <Grid>
                        <materialDesign:PackIcon
                            Width="18"
                            Height="18"
                            Kind="CogOutline" />
                        <TextBlock
                            x:Name="LblSettings"
                            Text="{DynamicResource Str_Nav_Settings}"
                            Visibility="Collapsed" />
                    </Grid>
                </RadioButton>

                <Border
                    Width="1"
                    Height="20"
                    Margin="8,0,4,0"
                    Background="{DynamicResource CardBorder}" />

                <Button
                    x:Name="BtnWinMinimize"
                    Click="BtnWinMinimize_Click"
                    Content="&#xE921;"
                    Style="{StaticResource TitleBarButtonStyle}"
                    ToolTip="{DynamicResource Str_Win_Minimize}" />
                <Button
                    x:Name="BtnWinMaximize"
                    Click="BtnWinMaximize_Click"
                    Content="&#xE922;"
                    Style="{StaticResource TitleBarButtonStyle}"
                    ToolTip="{DynamicResource Str_Win_Maximize}" />
                <Button
                    x:Name="BtnWinClose"
                    Click="BtnWinClose_Click"
                    Content="&#xE8BB;"
                    Style="{StaticResource TitleBarButtonStyle}"
                    Tag="Close"
                    ToolTip="{DynamicResource Str_Win_Close}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="SidebarColumn" Width="0" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--
                The old tool list. Hidden: Home and the search replace it. Kept (empty, collapsed) only because the code still fills
                NavPanel; remove it together with that code once the new layout is settled.
            -->
            <ScrollViewer
                x:Name="NavScroll"
                Grid.Column="0"
                Visibility="Collapsed">
                <StackPanel x:Name="NavPanel" />
            </ScrollViewer>

            <!--  ================= CONTENT AREA =================  -->
            <Border Grid.Column="1" Background="{DynamicResource ContentBg}">
                <Grid>
                    <!--
                        No ScrollViewer here on purpose: the active view gets a bounded height equal to the window's content area and
                        manages its own scrolling (a ScrollViewer here would let a huge DataGrid balloon the page).
                    -->
                    <ContentControl
                        x:Name="MainContentArea"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch">
                        <!--  Animated by NavigateTo: each tool fades + slides up into place  -->
                        <ContentControl.RenderTransform>
                            <TranslateTransform x:Name="ContentSlide" Y="0" />
                        </ContentControl.RenderTransform>
                    </ContentControl>

                    <!--  First time a tool opens: what it does + its tour (bottom right, goes away by itself)  -->
                    <views:ToolTipCard x:Name="ToolTip1st" />

                    <!--  Guided tour: over the page, hidden until the Help button is used  -->
                    <views:TourOverlay x:Name="TourLayer" />
                </Grid>
            </Border>
        </Grid>

        <!--  Shared modal (AppModal): message boxes are added here, over the title bar and the page  -->
        <Grid
            x:Name="ModalHost"
            Grid.RowSpan="2"
            Panel.ZIndex="1000" />
    </Grid>
</Window>
