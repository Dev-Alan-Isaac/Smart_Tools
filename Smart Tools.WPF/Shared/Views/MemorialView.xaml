<UserControl
    x:Class="Smart_Tools.WPF.Views.MemorialView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!--
        Memorial: a quiet tribute card, in the style of a printed memorial card.
        Serif type, a thin double frame, an oval portrait, no buttons or effects.
        Leaving the page is done with the Back button in the window's header card.
    -->
    <UserControl.Resources>
        <FontFamily x:Key="MemorialSerif">Georgia, Cambria, Times New Roman</FontFamily>
    </UserControl.Resources>

    <Grid
        x:Name="RootGrid"
        Background="{DynamicResource ContentBg}"
        Opacity="0">

        <!--
            Optional full-page background image. Both this and the dimming
            overlay below start Collapsed - the code-behind only shows them
            if BackgroundImagePath actually points to a real file, so an
            empty/missing path just leaves the plain ContentBg showing.
        -->
        <Image
            x:Name="ImgBackground"
            Stretch="UniformToFill"
            Visibility="Collapsed" />

        <Border
            x:Name="BackgroundOverlay"
            Background="#B3000000"
            Visibility="Collapsed" />

        <Viewbox
            Margin="32"
            Stretch="Uniform"
            StretchDirection="Both">
            <Border
                Width="760"
                Margin="40"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1"
                CornerRadius="4"
                SnapsToDevicePixels="True">

                <Border.Effect>
                    <DropShadowEffect
                        BlurRadius="60"
                        Opacity="0.35"
                        ShadowDepth="0"
                        Color="Black" />
                </Border.Effect>

                <!--  Second, finer line inside the card: the classic memorial-card frame  -->
                <Border
                    Margin="16"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1"
                    CornerRadius="2"
                    SnapsToDevicePixels="True">

                    <StackPanel Margin="64,64,64,72" HorizontalAlignment="Stretch">

                        <TextBlock
                            HorizontalAlignment="Center"
                            FontFamily="{StaticResource MemorialSerif}"
                            FontSize="20"
                            Foreground="{DynamicResource TextSecondary}"
                            Text="{DynamicResource Str_Memorial_Heading}"
                            TextAlignment="Center" />

                        <!--
                            Portrait: an oval photo inside a thin double ring. The photo
                            starts Collapsed and replaces the flower only if PhotoPath
                            resolves to a real image file.
                        -->
                        <Grid
                            Width="280"
                            Height="350"
                            Margin="0,40,0,44"
                            HorizontalAlignment="Center">
                            <Ellipse
                                Stroke="{DynamicResource TextSecondary}"
                                StrokeThickness="1"
                                Opacity="0.55" />
                            <Ellipse
                                Margin="11"
                                Stroke="{DynamicResource TextSecondary}"
                                StrokeThickness="1"
                                Opacity="0.35" />
                            <Ellipse
                                x:Name="EllipsePhoto"
                                Margin="22"
                                Visibility="Collapsed" />
                            <materialDesign:PackIcon
                                x:Name="IconFallback"
                                Width="64"
                                Height="64"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextSecondary}"
                                Kind="FlowerTulip" />
                        </Grid>

                        <TextBlock
                            x:Name="TxtMemorialName"
                            HorizontalAlignment="Center"
                            FontFamily="{StaticResource MemorialSerif}"
                            FontSize="64"
                            Foreground="{DynamicResource TextPrimary}"
                            Text="{DynamicResource Str_Memorial_Name}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />

                        <TextBlock
                            x:Name="TxtMemorialDates"
                            Margin="0,16,0,0"
                            HorizontalAlignment="Center"
                            FontFamily="{StaticResource MemorialSerif}"
                            FontSize="24"
                            Foreground="{DynamicResource TextSecondary}"
                            Text="{DynamicResource Str_Memorial_Dates}"
                            TextAlignment="Center" />

                        <!--  Divider: a fine line with one small flower  -->
                        <Grid Margin="60,44,60,38">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Height="1"
                                VerticalAlignment="Center"
                                Background="{DynamicResource CardBorder}" />
                            <materialDesign:PackIcon
                                Grid.Column="1"
                                Width="22"
                                Height="22"
                                Margin="20,0"
                                Foreground="{DynamicResource TextSecondary}"
                                Kind="FlowerTulip"
                                Opacity="0.7" />
                            <Border
                                Grid.Column="2"
                                Height="1"
                                VerticalAlignment="Center"
                                Background="{DynamicResource CardBorder}" />
                        </Grid>

                        <TextBlock
                            x:Name="TxtMemorialMessage"
                            FontFamily="{StaticResource MemorialSerif}"
                            FontSize="26"
                            FontStyle="Italic"
                            Foreground="{DynamicResource TextPrimary}"
                            LineHeight="40"
                            Text="{DynamicResource Str_Memorial_Message}"
                            TextAlignment="Center"
                            TextWrapping="Wrap" />

                    </StackPanel>
                </Border>
            </Border>
        </Viewbox>

    </Grid>

</UserControl>
