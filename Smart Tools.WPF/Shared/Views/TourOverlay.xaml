<UserControl
    x:Class="Smart_Tools.WPF.Views.TourOverlay"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Focusable="True"
    PreviewKeyDown="Overlay_PreviewKeyDown"
    SizeChanged="Overlay_SizeChanged"
    Visibility="Collapsed">

    <!--
        Guided-tour layer: dims the page, cuts a spotlight around the step's control and
        shows a card next to it. Logic lives in TourOverlay.xaml.cs; the steps come from
        Controllers/Tour.cs. Sits over the page area of MainWindow, below the title bar.
    -->

    <Grid ClipToBounds="True">

        <!--  Dim layer with the spotlight cut out (the clip geometry is set in code)  -->
        <Path
            x:Name="Dim"
            Fill="{DynamicResource TourScrim}"
            MouseLeftButtonDown="Dim_MouseLeftButtonDown" />

        <Canvas>

            <!--  Ring around the highlighted control  -->
            <Border
                x:Name="Ring"
                BorderBrush="{DynamicResource AccentColor}"
                BorderThickness="2"
                CornerRadius="10"
                IsHitTestVisible="False" />

            <!--  Shadow layer (empty) + card on top: crisp text  -->
            <Border
                x:Name="CardShadow"
                Background="{DynamicResource CardBg}"
                CornerRadius="12"
                Effect="{DynamicResource CardElevation}"
                IsHitTestVisible="False" />
            <Border
                x:Name="Card"
                Width="320"
                Padding="16,14,16,12"
                Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1"
                CornerRadius="12">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock
                            x:Name="TxtTitle"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimary}"
                            TextWrapping="Wrap" />
                        <TextBlock
                            x:Name="TxtProgress"
                            Grid.Column="1"
                            Margin="12,2,0,0"
                            VerticalAlignment="Top"
                            FontSize="11.5"
                            Foreground="{DynamicResource TextSecondary}" />
                    </Grid>
                    <TextBlock
                        x:Name="TxtBody"
                        Margin="0,6,0,0"
                        FontSize="13"
                        Foreground="{DynamicResource TextSecondary}"
                        TextWrapping="Wrap" />

                    <Grid Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button
                            x:Name="BtnSkip"
                            Width="70"
                            Click="BtnSkip_Click"
                            Content="{DynamicResource Str_Tour_Skip}"
                            Style="{StaticResource NeutralIconButtonStyle}" />
                        <Button
                            x:Name="BtnBack"
                            Grid.Column="2"
                            Width="40"
                            Margin="0,0,8,0"
                            Click="BtnBack_Click"
                            Content="{DynamicResource Str_Tour_Back}"
                            Style="{StaticResource NeutralIconButtonStyle}" />
                        <Button
                            x:Name="BtnNext"
                            Grid.Column="3"
                            Click="BtnNext_Click"
                            Style="{StaticResource PrimaryButtonStyle}" />
                    </Grid>
                </StackPanel>
            </Border>
        </Canvas>
    </Grid>
</UserControl>
