<UserControl
    x:Class="Smart_Tools.WPF.Views.TranslateSettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:models="clr-namespace:Smart_Tools.WPF.Models"
    Unloaded="Root_Unloaded">

    <!--  The Translation languages section of Settings - UI only. Logic: TranslateManager (catalog, download, custom pairs).  -->
    <UserControl.Resources>
        <DataTemplate x:Key="ModelRowTemplate" DataType="{x:Type models:TranslateModelItem}">
            <Border
                Margin="0,0,0,6"
                Padding="12,8,8,8"
                Background="{DynamicResource RowBg}"
                CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            FontSize="12.5"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimary}"
                            Text="{Binding Display}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            Margin="0,2,0,0"
                            FontSize="11"
                            Foreground="{DynamicResource TextSecondary}"
                            Text="{Binding Detail}" />
                        <TextBlock
                            x:Name="TxtFolder"
                            Margin="0,2,0,0"
                            FontFamily="Consolas"
                            FontSize="10.5"
                            Foreground="{DynamicResource TextSecondary}"
                            Text="{Binding FolderPath}"
                            TextTrimming="CharacterEllipsis"
                            ToolTip="{Binding FolderPath}"
                            Visibility="Collapsed" />
                        <ProgressBar
                            x:Name="BarProgress"
                            Height="4"
                            Margin="0,6,12,0"
                            Maximum="100"
                            Visibility="Collapsed"
                            Value="{Binding Progress}" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button
                            x:Name="BtnInstall"
                            MinWidth="84"
                            Click="BtnInstall_Click"
                            Content="{DynamicResource Str_Settings_OcrInstall}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                        <Button
                            x:Name="BtnRemove"
                            MinWidth="84"
                            Click="BtnRemove_Click"
                            Content="{DynamicResource Str_Settings_OcrRemove}"
                            Style="{StaticResource DangerButtonStyle}"
                            Visibility="Collapsed" />
                        <Button
                            x:Name="BtnCancel"
                            MinWidth="84"
                            Click="BtnCancel_Click"
                            Content="{DynamicResource Str_Settings_OcrCancel}"
                            Style="{StaticResource NeutralIconButtonStyle}"
                            Visibility="Collapsed" />
                        <Button Padding="0"
                            x:Name="BtnForget"
                            Width="20"
                            Margin="6,0,0,0"
                            Click="BtnForget_Click"
                            Style="{StaticResource NeutralIconButtonStyle}"
                            ToolTip="{DynamicResource Str_Settings_TranslateForgetTip}"
                            Visibility="Collapsed">
                            <materialDesign:PackIcon
                                Width="18"
                                Height="18"
                                Kind="Close" />
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                    <Setter TargetName="BtnInstall" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="BtnRemove" Property="Visibility" Value="Visible" />
                    <Setter TargetName="TxtFolder" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsCustom}" Value="True">
                    <Setter TargetName="BtnForget" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter TargetName="BtnInstall" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="BtnRemove" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="BtnForget" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="BtnCancel" Property="Visibility" Value="Visible" />
                    <Setter TargetName="BarProgress" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>

        <!--  ============ Indirect translation ============  -->
        <Border Margin="0,0,0,14" Style="{StaticResource CardStyle}">
            <StackPanel>
                <ContentControl
                    Content="{DynamicResource Str_Settings_TranslateIndirectHeader}"
                    Style="{StaticResource CardHeader}"
                    Tag="{x:Static materialDesign:PackIconKind.SourceBranch}" />
                <CheckBox
                    x:Name="ChkIndirect"
                    Margin="0,8,0,0"
                    Click="ChkIndirect_Click"
                    Content="{DynamicResource Str_Settings_TranslateIndirectCheck}" />
                <TextBlock
                    Margin="0,6,0,0"
                    FontSize="12"
                    Foreground="{DynamicResource TextSecondary}"
                    Text="{DynamicResource Str_Settings_TranslateIndirectHint}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!--  ============ Models and where they are ============  -->
        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <ContentControl
                    Content="{DynamicResource Str_Settings_TranslateHeader}"
                    Style="{StaticResource CardHeader}"
                    Tag="{x:Static materialDesign:PackIconKind.Translate}" />
                <TextBlock
                    Margin="0,4,0,12"
                    FontSize="12"
                    Foreground="{DynamicResource TextSecondary}"
                    Text="{DynamicResource Str_Settings_TranslateHint}"
                    TextWrapping="Wrap" />

                <TextBlock
                    Margin="0,0,0,4"
                    FontSize="11.5"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextSecondary}"
                    Text="{DynamicResource Str_Settings_TranslateLocation}" />
                <Grid Margin="0,0,0,6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock
                        x:Name="TxtModelsRoot"
                        VerticalAlignment="Center"
                        FontFamily="Consolas"
                        FontSize="12"
                        Foreground="{DynamicResource TextPrimary}"
                        TextTrimming="CharacterEllipsis"
                        ToolTip="{Binding Text, RelativeSource={RelativeSource Self}}" />
                    <Button Padding="0"
                        Grid.Column="1"
                        Width="40"
                        Margin="8,0,0,0"
                        Click="BtnOpenFolder_Click"
                        Style="{StaticResource NeutralIconButtonStyle}"
                        ToolTip="{DynamicResource Str_Translate_OpenFolder}">
                        <materialDesign:PackIcon
                            Width="18"
                            Height="18"
                            Kind="FolderOpenOutline" />
                    </Button>
                    <Button Padding="0"
                        Grid.Column="2"
                        Width="40"
                        Margin="4,0,0,0"
                        Click="BtnCopyPath_Click"
                        Style="{StaticResource NeutralIconButtonStyle}"
                        ToolTip="{DynamicResource Str_Settings_TranslateCopyPath}">
                        <materialDesign:PackIcon
                            Width="18"
                            Height="18"
                            Kind="ContentCopy" />
                    </Button>
                </Grid>
                <TextBlock
                    x:Name="TxtLocationNote"
                    Margin="0,0,0,10"
                    FontSize="11.5"
                    Foreground="{DynamicResource TextSecondary}"
                    TextWrapping="Wrap" />

                <TextBlock
                    x:Name="TxtModelsCount"
                    Margin="0,0,0,12"
                    FontSize="11.5"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextSecondary}" />
                <ItemsControl
                    x:Name="ListModels"
                    Focusable="False"
                    ItemTemplate="{StaticResource ModelRowTemplate}" />
            </StackPanel>
        </Border>

        <!--  ============ Add another pair ============  -->
        <Border Margin="0,14,0,0" Style="{StaticResource CardStyle}">
            <StackPanel>
                <ContentControl
                    Content="{DynamicResource Str_Settings_TranslateAddHeader}"
                    Style="{StaticResource CardHeader}"
                    Tag="{x:Static materialDesign:PackIconKind.PlusCircleOutline}" />
                <!--  How to  -->
                <TextBlock
                    Margin="0,8,0,6"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimary}"
                    Text="{DynamicResource Str_Settings_TranslateHowHeader}" />
                <TextBlock
                    Margin="0,0,0,3"
                    FontSize="12"
                    Foreground="{DynamicResource TextSecondary}"
                    Text="{DynamicResource Str_Settings_TranslateStep1}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,0,0,3"
                    FontSize="12"
                    Foreground="{DynamicResource TextSecondary}"
                    Text="{DynamicResource Str_Settings_TranslateStep2}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,0,0,3"
                    FontSize="12"
                    Foreground="{DynamicResource TextSecondary}"
                    Text="{DynamicResource Str_Settings_TranslateStep3}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,0,0,14"
                    FontSize="12"
                    Foreground="{DynamicResource TextSecondary}"
                    Text="{DynamicResource Str_Settings_TranslateStep4}"
                    TextWrapping="Wrap" />

                <!--  Short codes, filled in code  -->
                <TextBlock
                    Margin="0,0,0,6"
                    FontSize="12"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimary}"
                    Text="{DynamicResource Str_Settings_TranslateCodesHeader}" />
                <DataGrid
                    x:Name="GridCodes"
                    MaxHeight="260"
                    Margin="0,0,0,4"
                    AutoGenerateColumns="False"
                    CanUserAddRows="False"
                    FontSize="12"
                    IsReadOnly="True"
                    MouseLeftButtonUp="GridCodes_MouseLeftButtonUp"
                    MouseRightButtonUp="GridCodes_MouseRightButtonUp"
                    SelectionMode="Single"
                    SelectionUnit="FullRow"
                    ToolTip="{DynamicResource Str_Settings_TranslateChipTip}">
                    <DataGrid.Columns>
                        <DataGridTextColumn
                            Width="2*"
                            Binding="{Binding Name}"
                            Header="{DynamicResource Str_Settings_TranslateColLanguage}" />
                        <DataGridTextColumn
                            Width="*"
                            Binding="{Binding Code}"
                            Header="{DynamicResource Str_Settings_TranslateColCode}" />
                    </DataGrid.Columns>
                </DataGrid>
                <TextBlock
                    Margin="0,0,0,14"
                    FontSize="11.5"
                    Foreground="{DynamicResource TextSecondary}"
                    Text="{DynamicResource Str_Settings_TranslateCodesNote}"
                    TextWrapping="Wrap" />

                <StackPanel Orientation="Horizontal">
                    <TextBox
                        x:Name="TxtAddFrom"
                        Width="110"
                        MaxLength="14"
                        ToolTip="{DynamicResource Str_Translate_From}" />
                    <materialDesign:PackIcon
                        Width="18"
                        Height="18"
                        Margin="10,0"
                        VerticalAlignment="Center"
                        Kind="ArrowRight" />
                    <TextBox
                        x:Name="TxtAddTo"
                        Width="110"
                        MaxLength="14"
                        ToolTip="{DynamicResource Str_Translate_To}" />
                    <Button
                        x:Name="BtnAddPair"
                        MinWidth="110"
                        Margin="14,0,0,0"
                        Click="BtnAddPair_Click"
                        Content="{DynamicResource Str_Settings_TranslateAddButton}"
                        Style="{StaticResource PrimaryButtonStyle}" />
                </StackPanel>
                <TextBlock
                    x:Name="TxtAddStatus"
                    Margin="0,10,0,0"
                    FontSize="11.5"
                    Foreground="{DynamicResource TextSecondary}"
                    TextWrapping="Wrap" />
                <TextBlock
                    Margin="0,10,0,0"
                    FontSize="11.5"
                    Foreground="{DynamicResource TextSecondary}"
                    Text="{DynamicResource Str_Settings_TranslateAddHint}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
