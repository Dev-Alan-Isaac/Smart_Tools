<UserControl
    x:Class="Smart_Tools.WPF.Views.TextRecognitionSettingsPanel"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:models="clr-namespace:Smart_Tools.WPF.Models"
    Unloaded="Root_Unloaded">

    <!--  The Text recognition section of Settings - UI only. Logic: ScreenOcrManager, TesseractLanguageManager.  -->
    <UserControl.Resources>
        <DataTemplate x:Key="LanguageRowTemplate" DataType="{x:Type models:TesseractLanguageItem}">
            <Border
                Margin="0,0,0,6"
                Padding="12,8,8,8"
                Background="{DynamicResource RowBg}"
                CornerRadius="8">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel VerticalAlignment="Center">
                        <TextBlock
                            FontSize="12.5"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimary}"
                            Text="{Binding Display}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            x:Name="TxtDetail"
                            Margin="0,2,0,0"
                            FontSize="11"
                            Foreground="{DynamicResource TextSecondary}"
                            Text="{Binding Detail}" />
                        <ProgressBar
                            x:Name="BarProgress"
                            Height="4"
                            Margin="0,6,12,0"
                            Maximum="100"
                            Value="{Binding Progress}"
                            Visibility="Collapsed" />
                    </StackPanel>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button
                            x:Name="BtnInstall"
                            MinWidth="84"
                            Click="BtnInstall_Click"
                            Content="{DynamicResource Str_Settings_OcrInstall}"
                            Style="{StaticResource PrimaryButtonStyle}" />
                        <Button
                            x:Name="BtnRemove"
                            MinWidth="84"
                            Click="BtnRemove_Click"
                            Content="{DynamicResource Str_Settings_OcrRemove}"
                            Style="{StaticResource DangerButtonStyle}"
                            Visibility="Collapsed" />
                        <Button
                            x:Name="BtnCancel"
                            MinWidth="84"
                            Click="BtnCancel_Click"
                            Content="{DynamicResource Str_Settings_OcrCancel}"
                            Style="{StaticResource NeutralIconButtonStyle}"
                            Visibility="Collapsed" />
                    </StackPanel>
                </Grid>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding IsInstalled}" Value="True">
                    <Setter TargetName="BtnInstall" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="BtnRemove" Property="Visibility" Value="Visible" />
                </DataTrigger>
                <DataTrigger Binding="{Binding CanRemove}" Value="False">
                    <Setter TargetName="BtnRemove" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding IsBusy}" Value="True">
                    <Setter TargetName="BtnInstall" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="BtnRemove" Property="Visibility" Value="Collapsed" />
                    <Setter TargetName="BtnCancel" Property="Visibility" Value="Visible" />
                    <Setter TargetName="BarProgress" Property="Visibility" Value="Visible" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </UserControl.Resources>

    <StackPanel>

        <!--  ============ Engine ============  -->
        <Border Style="{StaticResource CardStyle}">
            <StackPanel>
                <ContentControl
                    Content="{DynamicResource Str_Settings_OcrEngine}"
                    Style="{StaticResource CardHeader}"
                    Tag="{x:Static materialDesign:PackIconKind.TextRecognition}" />
                <TextBlock
                    Margin="0,4,0,14"
                    FontSize="12"
                    Foreground="{DynamicResource TextSecondary}"
                    Text="{DynamicResource Str_Settings_OcrEngineHint}"
                    TextWrapping="Wrap" />
                <UniformGrid Columns="2">
                    <RadioButton
                        x:Name="RadioEngineWindows"
                        Margin="0,0,2,0"
                        Click="Engine_Click"
                        Content="{DynamicResource Str_Settings_OcrEngineWindows}"
                        GroupName="OcrEngine"
                        IsChecked="True"
                        Style="{StaticResource ModeToggleButtonStyle}"
                        Tag="Windows"
                        ToolTip="{DynamicResource Str_Settings_OcrEngineWindowsTip}" />
                    <RadioButton
                        x:Name="RadioEngineTesseract"
                        Margin="2,0,0,0"
                        Click="Engine_Click"
                        Content="{DynamicResource Str_Settings_OcrEngineTesseract}"
                        GroupName="OcrEngine"
                        Style="{StaticResource ModeToggleButtonStyle}"
                        Tag="Tesseract"
                        ToolTip="{DynamicResource Str_Settings_OcrEngineTesseractTip}" />
                </UniformGrid>
                <TextBlock
                    x:Name="TxtEngineNote"
                    Margin="2,10,0,0"
                    FontSize="11.5"
                    Foreground="{DynamicResource TextSecondary}"
                    TextWrapping="Wrap" />
            </StackPanel>
        </Border>

        <!--  ============ Tesseract languages ============  -->
        <Border Margin="0,14,0,0" Style="{StaticResource CardStyle}">
            <StackPanel>
                <ContentControl
                    Content="{DynamicResource Str_Settings_OcrLanguages}"
                    Style="{StaticResource CardHeader}"
                    Tag="{x:Static materialDesign:PackIconKind.Translate}" />
                <TextBlock
                    Margin="0,4,0,6"
                    FontSize="12"
                    Foreground="{DynamicResource TextSecondary}"
                    Text="{DynamicResource Str_Settings_OcrLanguagesHint}"
                    TextWrapping="Wrap" />
                <TextBlock
                    x:Name="TxtLanguagesCount"
                    Margin="0,0,0,12"
                    FontSize="11.5"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextSecondary}" />
                <ItemsControl
                    x:Name="ListLanguages"
                    Focusable="False"
                    ItemTemplate="{StaticResource LanguageRowTemplate}" />
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
