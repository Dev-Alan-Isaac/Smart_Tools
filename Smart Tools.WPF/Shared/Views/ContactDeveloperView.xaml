<UserControl
    x:Class="Smart_Tools.WPF.Views.ContactDeveloperView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <UserControl.Resources>

        <!--  Contact row: icon tile + label/value + chevron. Lifts and tints with the accent on hover.  -->
        <Style x:Key="ContactRowButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Background" Value="{DynamicResource InputBg}" />
            <Setter Property="BorderBrush" Value="{DynamicResource CardBorder}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="14,12" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Chrome"
                            Padding="{TemplateBinding Padding}"
                            Background="{TemplateBinding Background}"
                            BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}"
                            CornerRadius="10">
                            <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                                <Setter TargetName="Chrome" Property="Background" Value="{DynamicResource AccentColorSubtle}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Chrome" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Chrome" Property="Opacity" Value="0.85" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">

        <Border
            Width="460"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{DynamicResource CardBg}"
            BorderBrush="{DynamicResource CardBorder}"
            BorderThickness="1"
            CornerRadius="14"
            SnapsToDevicePixels="True">

            <Border.Effect>
                <DropShadowEffect
                    BlurRadius="28"
                    Opacity="0.22"
                    ShadowDepth="6"
                    Color="Black" />
            </Border.Effect>

            <StackPanel>

                <!--  Accent banner  -->
                <Border
                    Padding="28,26,28,48"
                    Background="{DynamicResource AccentGradient}"
                    CornerRadius="13,13,0,0">
                    <Grid>
                        <materialDesign:PackIcon
                            Width="120"
                            Height="120"
                            Margin="0,-30,-30,-30"
                            HorizontalAlignment="Right"
                            VerticalAlignment="Center"
                            Foreground="White"
                            Kind="EmailFast"
                            Opacity="0.12" />
                        <StackPanel>
                            <TextBlock
                                FontSize="22"
                                FontWeight="SemiBold"
                                Foreground="White"
                                Text="{DynamicResource Str_Contact_Title}" />
                            <TextBlock
                                Margin="0,6,0,0"
                                FontSize="13"
                                Foreground="White"
                                Opacity="0.85"
                                Text="{DynamicResource Str_Contact_Subtitle}"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!--  Avatar badge overlapping the banner edge  -->
                <Border
                    Width="56"
                    Height="56"
                    Margin="28,-28,0,0"
                    HorizontalAlignment="Left"
                    Background="{DynamicResource CardBg}"
                    BorderBrush="{DynamicResource CardBorder}"
                    BorderThickness="1"
                    CornerRadius="28">
                    <materialDesign:PackIcon
                        Width="28"
                        Height="28"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource AccentColor}"
                        Kind="AccountTie" />
                </Border>

                <StackPanel Margin="28,16,28,28">

                    <!--  PLACEHOLDER - update EmailAddress in the code-behind with the real address  -->
                    <Button
                        x:Name="BtnContactEmail"
                        Margin="0,0,0,10"
                        Click="BtnContactEmail_Click"
                        Style="{StaticResource ContactRowButtonStyle}"
                        ToolTip="{DynamicResource Str_Contact_EmailTooltip}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="40"
                                Height="40"
                                Margin="0,0,14,0"
                                Background="{DynamicResource AccentColorSubtle}"
                                CornerRadius="10">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource AccentColor}"
                                    Kind="EmailOutline" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{DynamicResource Str_QRcodeGenerator_Email}" />
                                <TextBlock
                                    x:Name="TxtContactEmail"
                                    Margin="0,2,0,0"
                                    FontSize="13.5"
                                    Foreground="{DynamicResource TextPrimary}"
                                    Text="{DynamicResource Str_ContactDeveloper_ContactalanisaacGmailCom}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <materialDesign:PackIcon
                                Grid.Column="2"
                                Width="18"
                                Height="18"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextSecondary}"
                                Kind="ChevronRight" />
                        </Grid>
                    </Button>

                    <!--  PLACEHOLDER - update GitHubUrl in the code-behind with the real link  -->
                    <Button
                        x:Name="BtnContactGitHub"
                        Click="BtnContactGitHub_Click"
                        Style="{StaticResource ContactRowButtonStyle}"
                        ToolTip="{DynamicResource Str_Contact_GithubTooltip}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <Border
                                Width="40"
                                Height="40"
                                Margin="0,0,14,0"
                                Background="{DynamicResource AccentColorSubtle}"
                                CornerRadius="10">
                                <materialDesign:PackIcon
                                    Width="20"
                                    Height="20"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource AccentColor}"
                                    Kind="Github" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{DynamicResource Str_Views_Github}" />
                                <TextBlock
                                    x:Name="TxtContactGitHub"
                                    Margin="0,2,0,0"
                                    FontSize="13.5"
                                    Foreground="{DynamicResource TextPrimary}"
                                    Text="{DynamicResource Str_ContactDeveloper_GithubComDevAlan}"
                                    TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <materialDesign:PackIcon
                                Grid.Column="2"
                                Width="18"
                                Height="18"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource TextSecondary}"
                                Kind="OpenInNew" />
                        </Grid>
                    </Button>

                    <TextBlock
                        x:Name="TxtContactStatus"
                        Margin="0,12,0,0"
                        FontSize="11.5"
                        Foreground="{DynamicResource StatusErrorFg}"
                        TextWrapping="Wrap"
                        Visibility="Collapsed" />

                </StackPanel>

            </StackPanel>

        </Border>

    </Grid>

</UserControl>
