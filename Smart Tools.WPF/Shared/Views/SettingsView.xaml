                                        Style="{StaticResource ListToolButtonStyle}"
                                        ToolTip="{DynamicResource Str_Settings_MediaWidgetResetTip}" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,14,0,0" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Settings_MediaRememberHeader}"
                                        Style="{StaticResource CardHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.PlaylistMusicOutline}" />
                                    <TextBlock
                                        Margin="0,4,0,14"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Text="{DynamicResource Str_Settings_MediaRememberIntro}"
                                        TextWrapping="Wrap" />
                                    <CheckBox
                                        x:Name="ChkMvRemember"
                                        Click="ChkMvRemember_Click"
                                        Content="{DynamicResource Str_Settings_MediaRemember}" />
                                    <Button
                                        x:Name="BtnMvForget"
                                        Margin="0,14,0,0"
                                        HorizontalAlignment="Left"
                                        Click="BtnMvForget_Click"
                                        Content="{DynamicResource Str_Settings_MediaForget}"
                                        Style="{StaticResource ListToolDangerButtonStyle}"
                                        ToolTip="{DynamicResource Str_Settings_MediaForgetTip}" />
                                </StackPanel>
                            </Border>

                            <Border Margin="0,14,0,0" Style="{StaticResource CardStyle}">
                                <StackPanel>
                                    <ContentControl
                                        Content="{DynamicResource Str_Settings_MediaSkipHeader}"
                                        Style="{StaticResource CardHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.SkipNext}" />
                                    <TextBlock
                                        Margin="0,4,0,14"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Text="{DynamicResource Str_Settings_MediaSkipIntro}"
                                        TextWrapping="Wrap" />
                                    <CheckBox
                                        x:Name="ChkMvSkipFast"
                                        Click="ChkMvSkipFast_Click"
                                        Content="{DynamicResource Str_Settings_MediaSkipImmediately}" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Border>

                    <!--  ============ Clipboard history ============  -->
                    <views:ClipboardSettingsPanel x:Name="PanelClipboard" Visibility="Collapsed" />

                    <!--  ============ Text recognition ============  -->
                    <views:TextRecognitionSettingsPanel x:Name="PanelTextRecognition" Visibility="Collapsed" />

                    <!--  ============ Translation languages ============  -->
                    <views:TranslateSettingsPanel x:Name="PanelTranslate" Visibility="Collapsed" />

                    <!--  ============ Minecraft versions (Texture Pack Builder) ============  -->
                    <views:TexturePackSettingsPanel x:Name="PanelTexturePack" Visibility="Collapsed" />

                    <!--  ============ Keyboard shortcuts ============  -->
                    <Border
                        x:Name="PanelShortcuts"
                        Style="{StaticResource CardStyle}"
                        Visibility="Collapsed">
                        <StackPanel>
                            <Border
                                Margin="0,0,0,12"
                                Padding="12"
                                BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <StackPanel>
                                    <TextBlock
                                        Margin="0,0,0,6"
                                        Style="{StaticResource FieldLabel}"
                                        Text="{DynamicResource Str_Settings_SearchLabel}" />
                                    <Border Padding="10,0" Style="{StaticResource InputBarStyle}">
                                        <TextBox
                                            x:Name="TxtShortcutSearch"
                                            MinHeight="34"
                                            VerticalContentAlignment="Center"
                                            Style="{StaticResource BareTextBox}"
                                            Tag="{DynamicResource Str_Shortcuts_SearchHint}"
                                            TextChanged="TxtShortcutSearch_TextChanged" />
                                    </Border>
                                </StackPanel>
                            </Border>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentControl
                                    Content="{DynamicResource Str_Shortcuts_Title}"
                                    Style="{StaticResource CardHeader}"
                                    Tag="{x:Static materialDesign:PackIconKind.KeyboardOutline}" />
                                <Button
                                    Grid.Column="1"
                                    Click="BtnResetShortcuts_Click"
                                    Style="{StaticResource NeutralIconButtonStyle}"
                                    ToolTip="{DynamicResource Str_Shortcuts_ResetAllTip}">
                                    <Grid HorizontalAlignment="Center" Margin="8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon
                                            Grid.Column="0"
                                            Width="15"
                                            Height="15"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Kind="Restore" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Text="{DynamicResource Str_Shortcuts_ResetAll}" TextWrapping="Wrap" />
                                    </Grid>
                                </Button>
                            </Grid>
                            <TextBlock
                                Margin="0,4,0,14"
                                FontSize="12"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="{DynamicResource Str_Shortcuts_Intro}"
                                TextWrapping="Wrap" />

                            <CheckBox
                                x:Name="ChkGlobalHotkeys"
                                Margin="0,0,0,8"
                                Click="ChkGlobalHotkeys_Click"
                                Content="{DynamicResource Str_Shortcuts_GlobalSwitch}"
                                ToolTip="{DynamicResource Str_Shortcuts_GlobalSwitchTip}" />

                            <TextBlock
                                x:Name="TxtShortcutError"
                                Margin="0,0,0,8"
                                FontSize="11.5"
                                Foreground="{DynamicResource StatusWarningFg}"
                                TextWrapping="Wrap"
                                Visibility="Collapsed" />

                            <ItemsControl x:Name="ShortcutsList" Focusable="False">
                                <ItemsControl.GroupStyle>
                                    <GroupStyle>
                                        <GroupStyle.HeaderTemplate>
                                            <DataTemplate>
                                                <TextBlock
                                                    Margin="0,14,0,6"
                                                    Style="{StaticResource FieldLabel}"
                                                    Text="{Binding Name}" />
                                            </DataTemplate>
                                        </GroupStyle.HeaderTemplate>
                                    </GroupStyle>
                                </ItemsControl.GroupStyle>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border
                                            Margin="0,0,0,6"
                                            Padding="12,8"
                                            BorderBrush="{DynamicResource CardBorder}"
                                            BorderThickness="1"
                                            CornerRadius="8">
                                            <Grid>
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="*" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="34" />
                                                </Grid.ColumnDefinitions>
                                                <StackPanel VerticalAlignment="Center">
                                                    <TextBlock
                                                        FontWeight="SemiBold"
                                                        Text="{Binding Title}"
                                                        TextTrimming="CharacterEllipsis" />
                                                    <TextBlock
                                                        Margin="0,2,0,0"
                                                        FontSize="11.5"
                                                        Foreground="{DynamicResource StatusWarningFg}"
                                                        Text="{Binding Warning, Converter={StaticResource ShortcutWarning}}"
                                                        TextWrapping="Wrap"
                                                        Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}" />
                                                </StackPanel>
                                                <controls:KeyRecorderBox
                                                    Grid.Column="1"
                                                    Width="170"
                                                    Margin="10,0"
                                                    FontFamily="Consolas"
                                                    Style="{StaticResource NeutralIconButtonStyle}"
                                                    ToolTip="{DynamicResource Str_Shortcuts_ClickToSet}" />
                                                <CheckBox
                                                    Grid.Column="2"
                                                    VerticalAlignment="Center"
                                                    Click="ShortcutEnabled_Click"
                                                    IsChecked="{Binding Enabled, Mode=OneWay}"
                                                    ToolTip="{DynamicResource Str_Shortcuts_EnabledTip}" />
                                                <Button
                                                    Grid.Column="3"
                                                    Width="28"
                                                    Margin="6,0,0,0"
                                                    Padding="0"
                                                    Click="BtnResetShortcut_Click"
                                                    Style="{StaticResource NeutralIconButtonStyle}"
                                                    ToolTip="{DynamicResource Str_Shortcuts_ResetOne}"
                                                    Visibility="{Binding IsModified, Converter={StaticResource BoolToVisibility}}">
                                                    <materialDesign:PackIcon
                                                        Width="15"
                                                        Height="15"
                                                        Kind="Restore" />
                                                </Button>
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <TextBlock
                                x:Name="ShortcutsEmpty"
                                Margin="0,24"
                                HorizontalAlignment="Center"
                                FontSize="12.5"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="{DynamicResource Str_Shortcuts_NoMatches}"
                                Visibility="Collapsed" />
                        </StackPanel>
                    </Border>

                    <!--  ============ Event days ============  -->
                    <Border
                        x:Name="PanelEventDays"
                        Style="{StaticResource CardStyle}"
                        Visibility="Collapsed">
                        <StackPanel>
                            <Border
                                Margin="0,0,0,12"
                                Padding="12"
                                BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <StackPanel>
                                    <TextBlock
                                        Margin="0,0,0,6"
                                        Style="{StaticResource FieldLabel}"
                                        Text="{DynamicResource Str_Settings_SearchLabel}" />
                                    <Border Padding="10,0" Style="{StaticResource InputBarStyle}">
                                        <TextBox
                                            x:Name="TxtEventDaySearch"
                                            MinHeight="34"
                                            VerticalContentAlignment="Center"
                                            Style="{StaticResource BareTextBox}"
                                            Tag="{DynamicResource Str_Settings_SearchEventDays}"
                                            TextChanged="ListSearch_TextChanged" />
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentControl
                                    Content="{DynamicResource Str_Settings_NavEventDays}"
                                    Style="{StaticResource CardHeader}"
                                    Tag="{x:Static materialDesign:PackIconKind.CalendarStar}" />
                                <Button
                                    Grid.Column="1"
                                    Click="BtnResetEventDays_Click"
                                    Style="{StaticResource NeutralIconButtonStyle}"
                                    ToolTip="{DynamicResource Str_Settings_PutBackEventDays}">
                                    <Grid HorizontalAlignment="Center" Margin="8,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon
                                            Grid.Column="0"
                                            Width="15"
                                            Height="15"
                                            Margin="0,0,5,0"
                                            VerticalAlignment="Center"
                                            Kind="Restore" />
                                        <TextBlock
                                            Grid.Column="1"
                                            VerticalAlignment="Center"
                                            FontSize="12"
                                            Text="{DynamicResource Str_Common_Reset}" TextWrapping="Wrap" />
                                    </Grid>
                                </Button>
                            </Grid>
                            <TextBlock
                                Margin="0,4,0,14"
                                FontSize="12"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="{DynamicResource Str_Settings_EventDaysIntro}"
                                TextWrapping="Wrap" />

                            <!--  New event day  -->
                            <Border
                                Margin="0,0,0,14"
                                Padding="12"
                                BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="150" />
                                        </Grid.ColumnDefinitions>
                                        <Border Padding="10,0" Style="{StaticResource InputBarStyle}">
                                            <TextBox
                                                x:Name="TxtNewEventName"
                                                MinHeight="34"
                                                VerticalContentAlignment="Center"
                                                KeyDown="NewEvent_KeyDown"
                                                Style="{StaticResource BareTextBox}"
                                                Tag="{DynamicResource Str_Settings_NewEventNameHint}"
                                                TextChanged="NewEvent_Changed" />
                                        </Border>
                                        <Border
                                            Grid.Column="2"
                                            Padding="10,0"
                                            Style="{StaticResource InputBarStyle}">
                                            <TextBox
                                                x:Name="TxtNewEventDate"
                                                MinHeight="34"
                                                VerticalContentAlignment="Center"
                                                FontFamily="Consolas"
                                                KeyDown="NewEvent_KeyDown"
                                                Style="{StaticResource BareTextBox}"
                                                Tag="yyyy-MM-dd"
                                                TextChanged="NewEvent_Changed" />
                                        </Border>
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                            <CheckBox
                                                x:Name="ChkNewEventRepeats"
                                                VerticalAlignment="Center"
                                                Content="{DynamicResource Str_Settings_EveryYear}"
                                                IsChecked="True"
                                                ToolTip="{DynamicResource Str_Settings_EveryYearTooltip}" />
                                            <CheckBox
                                                x:Name="ChkNewEventNonWorking"
                                                Margin="18,0,0,0"
                                                VerticalAlignment="Center"
                                                Content="{DynamicResource Str_Settings_NonWorkingDay}"
                                                IsChecked="True"
                                                ToolTip="{DynamicResource Str_Settings_NonWorkingTooltip}" />
                                            <TextBlock
                                                x:Name="TxtNewEventHint"
                                                Margin="18,0,0,0"
                                                VerticalAlignment="Center"
                                                FontSize="11.5"
                                                Foreground="{DynamicResource StatusWarningFg}"
                                                Visibility="Collapsed" />
                                        </StackPanel>
                                        <Button
                                            x:Name="BtnAddEvent"
                                            Grid.Column="1"
                                            Click="BtnAddEvent_Click"
                                            IsEnabled="False"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            ToolTip="{DynamicResource Str_Settings_AddTheEventTooltip}">
                                            <Grid HorizontalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon
                                                    Grid.Column="0"
                                                    Width="16"
                                                    Height="16"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Kind="Plus" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_Settings_AddEvent}" TextWrapping="Wrap" />
                                            </Grid>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <ItemsControl
                                x:Name="EventDaysList"
                                Focusable="False"
                                ItemTemplate="{StaticResource EventDayTemplate}" />

                            <TextBlock
                                x:Name="EventDaysNoMatch"
                                Margin="0,24"
                                HorizontalAlignment="Center"
                                FontSize="12.5"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="{DynamicResource Str_Settings_NoMatches}"
                                Visibility="Collapsed" />

                            <StackPanel
                                x:Name="EventDaysEmpty"
                                Margin="0,24"
                                HorizontalAlignment="Center"
                                Visibility="Collapsed">
                                <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.CalendarStar}" />
                                <TextBlock
                                    Margin="0,10,0,0"
                                    FontSize="12.5"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{DynamicResource Str_Settings_NoEventDaysAddOne}"
                                    TextAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!--  ============ Mock data lists ============  -->
                    <Border
                        x:Name="PanelMockData"
                        Style="{StaticResource CardStyle}"
                        Visibility="Collapsed">
                        <StackPanel>
                            <Border
                                Margin="0,0,0,12"
                                Padding="12"
                                BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <StackPanel>
                                    <TextBlock
                                        Margin="0,0,0,6"
                                        Style="{StaticResource FieldLabel}"
                                        Text="{DynamicResource Str_Settings_SearchLabel}" />
                                    <Border Padding="10,0" Style="{StaticResource InputBarStyle}">
                                        <TextBox
                                            x:Name="TxtMockListSearch"
                                            MinHeight="34"
                                            VerticalContentAlignment="Center"
                                            Style="{StaticResource BareTextBox}"
                                            Tag="{DynamicResource Str_Settings_SearchMockLists}"
                                            TextChanged="ListSearch_TextChanged" />
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentControl
                                    Content="{DynamicResource Str_Settings_NavMockData}"
                                    Style="{StaticResource CardHeader}"
                                    Tag="{x:Static materialDesign:PackIconKind.DatabaseEdit}" />
                                <Button
                                    x:Name="BtnResetMockLists"
                                    Grid.Column="1"
                                    Click="BtnResetMockLists_Click"
                                    Style="{StaticResource ListToolButtonStyle}"
                                    ToolTip="{DynamicResource Str_Settings_PutBackMockLists}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="Restore" />
                                </Button>
                            </Grid>
                            <TextBlock
                                Margin="0,4,0,14"
                                FontSize="12"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="{DynamicResource Str_Settings_MockListsIntro}"
                                TextWrapping="Wrap" />

                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" MaxWidth="360" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Border Padding="10,0" Style="{StaticResource InputBarStyle}">
                                    <TextBox
                                        x:Name="TxtNewMockListName"
                                        MinHeight="34"
                                        VerticalContentAlignment="Center"
                                        KeyDown="TxtNewMockListName_KeyDown"
                                        Style="{StaticResource BareTextBox}"
                                        Tag="{DynamicResource Str_Settings_NewListNameHint}"
                                        TextChanged="TxtNewMockListName_TextChanged" />
                                </Border>
                                <Button
                                    x:Name="BtnAddMockList"
                                    Grid.Column="1"
                                    Margin="8,0,0,0"
                                    Click="BtnAddMockList_Click"
                                    IsEnabled="False"
                                    Style="{StaticResource PrimaryButtonStyle}"
                                    ToolTip="{DynamicResource Str_Settings_AddTheListThen}">
                                    <Grid HorizontalAlignment="Center">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon
                                            Grid.Column="0"
                                            Width="16"
                                            Height="16"
                                            Margin="0,0,6,0"
                                            VerticalAlignment="Center"
                                            Kind="Plus" />
                                        <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_Settings_AddList}" TextWrapping="Wrap" />
                                    </Grid>
                                </Button>
                            </Grid>
                            <TextBlock
                                x:Name="TxtNewMockListHint"
                                Margin="2,0,0,12"
                                FontSize="11"
                                Foreground="{DynamicResource StatusWarningFg}"
                                Visibility="Collapsed" />

                            <ItemsControl
                                x:Name="MockListsList"
                                Focusable="False"
                                ItemTemplate="{StaticResource MockListTemplate}" />

                            <TextBlock
                                x:Name="MockListsNoMatch"
                                Margin="0,24"
                                HorizontalAlignment="Center"
                                FontSize="12.5"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="{DynamicResource Str_Settings_NoMatches}"
                                Visibility="Collapsed" />

                            <StackPanel
                                x:Name="MockListsEmpty"
                                Margin="0,24"
                                HorizontalAlignment="Center"
                                Visibility="Collapsed">
                                <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.FormatListBulleted}" />
                                <TextBlock
                                    Margin="0,10,0,0"
                                    FontSize="12.5"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{DynamicResource Str_Settings_NoMockListsAddOne}"
                                    TextAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!--  ============ Patterns ============  -->
                    <Border
                        x:Name="PanelPatterns"
                        Style="{StaticResource CardStyle}"
                        Visibility="Collapsed">
                        <StackPanel>
                            <Border
                                Margin="0,0,0,12"
                                Padding="12"
                                BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <StackPanel>
                                    <TextBlock
                                        Margin="0,0,0,6"
                                        Style="{StaticResource FieldLabel}"
                                        Text="{DynamicResource Str_Settings_SearchLabel}" />
                                    <Border Padding="10,0" Style="{StaticResource InputBarStyle}">
                                        <TextBox
                                            x:Name="TxtPatternSearch"
                                            MinHeight="34"
                                            VerticalContentAlignment="Center"
                                            Style="{StaticResource BareTextBox}"
                                            Tag="{DynamicResource Str_Settings_SearchPatterns}"
                                            TextChanged="ListSearch_TextChanged" />
                                    </Border>
                                </StackPanel>
                            </Border>

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <ContentControl
                                    Content="{DynamicResource Str_Settings_NavPatterns}"
                                    Style="{StaticResource CardHeader}"
                                    Tag="{x:Static materialDesign:PackIconKind.Regex}" />
                                <Button
                                    x:Name="BtnResetPatterns"
                                    Grid.Column="1"
                                    Click="BtnResetPatterns_Click"
                                    Style="{StaticResource ListToolButtonStyle}"
                                    ToolTip="{DynamicResource Str_Settings_PutBackTheBuilt}">
                                    <materialDesign:PackIcon
                                        Width="16"
                                        Height="16"
                                        Kind="Restore" />
                                </Button>
                            </Grid>
                            <TextBlock
                                Margin="0,4,0,4"
                                FontSize="12"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="{DynamicResource Str_Settings_QuickPicksInFile}"
                                TextWrapping="Wrap" />
                            <TextBlock
                                Margin="0,0,0,14"
                                FontSize="12"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="{DynamicResource Str_Settings_PatternSegmentsHint}"
                                TextWrapping="Wrap" />

                            <!--  New pattern  -->
                            <Border
                                Margin="0,0,0,14"
                                Padding="12"
                                BorderBrush="{DynamicResource CardBorder}"
                                BorderThickness="1"
                                CornerRadius="12">
                                <StackPanel>
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="170" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="10" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <Border Padding="10,0" Style="{StaticResource InputBarStyle}">
                                            <TextBox
                                                x:Name="TxtNewPatternName"
                                                MinHeight="34"
                                                VerticalContentAlignment="Center"
                                                KeyDown="NewPattern_KeyDown"
                                                Style="{StaticResource BareTextBox}"
                                                Tag="Name"
                                                TextChanged="NewPattern_Changed" />
                                        </Border>
                                        <Border
                                            Grid.Column="2"
                                            Padding="10,0"
                                            Style="{StaticResource InputBarStyle}">
                                            <TextBox
                                                x:Name="TxtNewPatternText"
                                                MinHeight="34"
                                                VerticalContentAlignment="Center"
                                                FontFamily="Consolas"
                                                KeyDown="NewPattern_KeyDown"
                                                Style="{StaticResource BareTextBox}"
                                                Tag="Pattern, e.g. INV-\d{6} or *.log"
                                                TextChanged="NewPattern_Changed" />
                                        </Border>
                                        <UniformGrid
                                            x:Name="NewPatternTypeChoices"
                                            Grid.Column="4"
                                            Width="180"
                                            Columns="2">
                                            <RadioButton
                                                x:Name="RadioNewRegex"
                                                Margin="0,0,3,0"
                                                Padding="8,7"
                                                Click="NewPatternType_Click"
                                                Content="{DynamicResource Str_Log_RegexCheckbox}"
                                                GroupName="NewPatternType"
                                                IsChecked="True"
                                                Style="{StaticResource ChoiceTileStyle}"
                                                Tag="Regex" />
                                            <RadioButton
                                                x:Name="RadioNewWildcard"
                                                Margin="3,0,0,0"
                                                Padding="8,7"
                                                Click="NewPatternType_Click"
                                                Content="{DynamicResource Str_SearchFile_Wildcard}"
                                                GroupName="NewPatternType"
                                                Style="{StaticResource ChoiceTileStyle}"
                                                Tag="Wildcard" />
                                        </UniformGrid>
                                    </Grid>
                                    <Grid Margin="0,10,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel VerticalAlignment="Center" Orientation="Horizontal">
                                            <materialDesign:PackIcon
                                                x:Name="IconNewPatternState"
                                                Width="14"
                                                Height="14"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource TextSecondary}"
                                                Kind="InformationOutline" />
                                            <TextBlock
                                                x:Name="TxtNewPatternValidation"
                                                VerticalAlignment="Center"
                                                FontSize="11.5"
                                                Foreground="{DynamicResource TextSecondary}"
                                                Text="{DynamicResource Str_Settings_GiveItAName}"
                                                TextWrapping="Wrap" />
                                        </StackPanel>
                                        <Button
                                            x:Name="BtnAddPattern"
                                            Grid.Column="1"
                                            Click="BtnAddPattern_Click"
                                            IsEnabled="False"
                                            Style="{StaticResource PrimaryButtonStyle}"
                                            ToolTip="{DynamicResource Str_Settings_SaveThisPattern}">
                                            <Grid HorizontalAlignment="Center">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition Width="Auto" />
                                                    <ColumnDefinition Width="*" />
                                                </Grid.ColumnDefinitions>
                                                <materialDesign:PackIcon
                                                    Grid.Column="0"
                                                    Width="16"
                                                    Height="16"
                                                    Margin="0,0,6,0"
                                                    VerticalAlignment="Center"
                                                    Kind="Plus" />
                                                <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_Settings_AddPattern}" TextWrapping="Wrap" />
                                            </Grid>
                                        </Button>
                                    </Grid>
                                </StackPanel>
                            </Border>

                            <!--  Try them  -->
                            <TextBlock
                                Margin="0,0,0,6"
                                Style="{StaticResource FieldLabel}"
                                Text="{DynamicResource Str_Settings_TryYourPatterns}" />
                            <Border
                                Margin="0,0,0,14"
                                Padding="10,6"
                                Style="{StaticResource InputBarStyle}">
                                <TextBox
                                    x:Name="TxtPatternTest"
                                    MinHeight="54"
                                    MaxHeight="120"
                                    AcceptsReturn="True"
                                    FontFamily="Consolas"
                                    Style="{StaticResource BareTextBox}"
                                    Tag="Paste some text (or file names, one per line) to see what each pattern finds"
                                    TextChanged="TxtPatternTest_TextChanged"
                                    TextWrapping="Wrap"
                                    VerticalScrollBarVisibility="Auto" />
                            </Border>

                            <ItemsControl
                                x:Name="PatternsList"
                                Focusable="False"
                                ItemTemplate="{StaticResource PatternTemplate}" />

                            <TextBlock
                                x:Name="PatternsNoMatch"
                                Margin="0,24"
                                HorizontalAlignment="Center"
                                FontSize="12.5"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="{DynamicResource Str_Settings_NoMatches}"
                                Visibility="Collapsed" />

                            <StackPanel
                                x:Name="PatternsEmpty"
                                Margin="0,24"
                                HorizontalAlignment="Center"
                                Visibility="Collapsed">
                                <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.Regex}" />
                                <TextBlock
                                    Margin="0,10,0,0"
                                    FontSize="12.5"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{DynamicResource Str_Settings_NoSavedPatternsAdd}"
                                    TextAlignment="Center" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
