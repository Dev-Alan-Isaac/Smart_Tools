                                    <ContentControl
                                        Content="{DynamicResource Str_Settings_MediaWidgetHeader}"
                                        Style="{StaticResource CardHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.PictureInPictureBottomRight}" />
                                    <TextBlock
                                        Margin="0,4,0,14"
                                        FontSize="12"
                                        Foreground="{DynamicResource TextSecondary}"
                                        Text="{DynamicResource Str_Settings_MediaWidgetIntro}"
                                        TextWrapping="Wrap" />
                                    <CheckBox
                                        x:Name="ChkMvWidgetStartup"
                                        Click="ChkMvWidgetStartup_Click"
                                        Content="{DynamicResource Str_Settings_MediaWidgetStartup}" />
                                    <Button
                                        x:Name="BtnMvResetWidget"
