<UserControl
    x:Class="Smart_Tools.WPF.Views.SettingsView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:modules="clr-namespace:Smart_Tools.WPF.Modules"
    xmlns:views="clr-namespace:Smart_Tools.WPF.Views"
    x:Name="Root"
    Loaded="Root_Loaded">

    <!--
        Data: Modules/AppSettingsStore.cs (shared by every tool).
        Logic: Controllers/SettingsManager.cs (extension clean-up, category
        overlaps, name and pattern checks, pattern test). This file and the
        code-behind are UI only. Every change saves at once - there's no
        Save button to forget.
    -->

    <UserControl.Resources>

        <BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <modules:ShortcutWarningConverter x:Key="ShortcutWarning" />

        <!--  Sidebar section link  -->
        <Style x:Key="NavButtonStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource SidebarText}" />
            <Setter Property="HorizontalContentAlignment" Value="Left" />
            <Setter Property="Padding" Value="14,10" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border
                            x:Name="Bd"
                            Margin="0,0,0,4"
                            Background="Transparent"
                            CornerRadius="8">
                            <Grid>
                                <Border
                                    x:Name="Indicator"
                                    Width="3"
                                    Margin="0,8"
                                    HorizontalAlignment="Left"
                                    Background="{DynamicResource AccentColor}"
                                    CornerRadius="2"
                                    Opacity="0" />
                                <ContentPresenter
                                    Margin="{TemplateBinding Padding}"
                                    HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                    VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarItemHoverBg}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource SidebarItemHoverBg}" />
                                <Setter TargetName="Indicator" Property="Opacity" Value="1" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentColor}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  A choice tile on a content card (theme, language, pattern type)  -->
        <Style x:Key="ChoiceTileStyle" TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextPrimary}" />
            <Setter Property="FontSize" Value="12.5" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="10,8" />
            <Setter Property="FocusVisualStyle" Value="{StaticResource FocusRingVisual}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border
                            x:Name="Bd"
                            Padding="{TemplateBinding Padding}"
                            Background="{DynamicResource RowBg}"
                            BorderBrush="{DynamicResource CardBorder}"
                            BorderThickness="1.5"
                            CornerRadius="8"
                            RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="Scale" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentColorSubtle}" />
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentColor}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="Scale"
                                                Storyboard.TargetProperty="ScaleX"
                                                To="0.97"
                                                Duration="0:0:0.08" />
                                            <DoubleAnimation
                                                Storyboard.TargetName="Scale"
                                                Storyboard.TargetProperty="ScaleY"
                                                To="0.97"
                                                Duration="0:0:0.08" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="Scale"
                                                Storyboard.TargetProperty="ScaleX"
                                                To="1"
                                                Duration="0:0:0.12" />
                                            <DoubleAnimation
                                                Storyboard.TargetName="Scale"
                                                Storyboard.TargetProperty="ScaleY"
                                                To="1"
                                                Duration="0:0:0.12" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.45" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  One event day / holiday card: name, date, repeats, non-working  -->
        <DataTemplate x:Key="EventDayTemplate" DataType="{x:Type modules:EventDay}">
            <Border
                Margin="0,0,0,10"
                Padding="12"
                Background="{DynamicResource RowBg}"
                CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MaxWidth="320" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="30"
                            Height="30"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AccentColorSubtle}"
                            CornerRadius="8">
                            <materialDesign:PackIcon
                                Width="16"
                                Height="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource AccentColor}"
                                Kind="CalendarStar" />
                        </Border>
                        <TextBox
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            LostFocus="EventDayField_LostFocus"
                            Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="{DynamicResource Str_Settings_EventNameTooltip}" />
                        <Button
                            Grid.Column="3"
                            Width="28"
                            Height="28"
                            VerticalAlignment="Center"
                            Click="BtnRemoveEventDay_Click"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="{DynamicResource Str_Settings_RemoveThisEvent}">
                            <materialDesign:PackIcon
                                Width="15"
                                Height="15"
                                Foreground="{DynamicResource StatusErrorFg}"
                                Kind="DeleteOutline" />
                        </Button>
                    </Grid>

                    <StackPanel
                        Grid.Row="1"
                        Margin="40,10,0,0"
                        Orientation="Horizontal">
                        <TextBox
                            Width="120"
                            VerticalAlignment="Center"
                            FontFamily="Consolas"
                            LostFocus="EventDayField_LostFocus"
                            Text="{Binding Date, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="{DynamicResource Str_Settings_EventDateTooltip}" />
                        <CheckBox
                            Margin="18,0,0,0"
                            VerticalAlignment="Center"
                            Click="EventDayFlag_Click"
                            Content="{DynamicResource Str_Settings_EveryYear}"
                            IsChecked="{Binding Repeats, Mode=TwoWay}"
                            ToolTip="{DynamicResource Str_Settings_EveryYearTooltip}" />
                        <CheckBox
                            Margin="18,0,0,0"
                            VerticalAlignment="Center"
                            Click="EventDayFlag_Click"
                            Content="{DynamicResource Str_Settings_NonWorkingDay}"
                            IsChecked="{Binding NonWorking, Mode=TwoWay}"
                            ToolTip="{DynamicResource Str_Settings_NonWorkingTooltip}" />
                    </StackPanel>

                    <StackPanel
                        Grid.Row="2"
                        Margin="40,6,0,0"
                        Orientation="Horizontal"
                        Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}">
                        <materialDesign:PackIcon
                            Width="13"
                            Height="13"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource StatusWarningFg}"
                            Kind="AlertOutline" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11.5"
                            Foreground="{DynamicResource StatusWarningFg}"
                            Text="{Binding Warning}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!--  One saved Mock Data list: name, value chips, add box (same layout as a category card)  -->
        <DataTemplate x:Key="MockListTemplate" DataType="{x:Type modules:MockDataList}">
            <Border
                Margin="0,0,0,10"
                Padding="12"
                Background="{DynamicResource RowBg}"
                CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MaxWidth="260" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="30"
                            Height="30"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AccentColorSubtle}"
                            CornerRadius="8">
                            <materialDesign:PackIcon
                                Width="16"
                                Height="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource AccentColor}"
                                Kind="FormatListBulleted" />
                        </Border>
                        <TextBox
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            LostFocus="MockListName_LostFocus"
                            Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="{DynamicResource Str_Settings_MockListNameTooltip}" />
                        <Border
                            Grid.Column="2"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AccentColorSubtle}"
                            Style="{StaticResource IconStatusPillStyle}">
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource AccentColor}"
                                Text="{Binding ValueCount}" />
                        </Border>
                        <StackPanel
                            Grid.Column="4"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Button
                                Width="28"
                                Height="28"
                                Click="BtnMockListUp_Click"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="{DynamicResource Str_Settings_MoveUpCategoriesHigher}">
                                <materialDesign:PackIcon
                                    Width="15"
                                    Height="15"
                                    Kind="ChevronUp" />
                            </Button>
                            <Button
                                Width="28"
                                Height="28"
                                Margin="2,0"
                                Click="BtnMockListDown_Click"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="{DynamicResource Str_Settings_MoveDown}">
                                <materialDesign:PackIcon
                                    Width="15"
                                    Height="15"
                                    Kind="ChevronDown" />
                            </Button>
                            <Button
                                Width="28"
                                Height="28"
                                Click="BtnRemoveMockList_Click"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="{DynamicResource Str_Settings_RemoveThisMockList}">
                                <materialDesign:PackIcon
                                    Width="15"
                                    Height="15"
                                    Foreground="{DynamicResource StatusErrorFg}"
                                    Kind="DeleteOutline" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!--  Value chips + add box  -->
                    <WrapPanel Grid.Row="1" Margin="40,10,0,0">
                        <ItemsControl Focusable="False" ItemsSource="{Binding ValueList}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,6,6"
                                        Padding="9,3,3,3"
                                        Background="{DynamicResource CardBg}"
                                        BorderBrush="{DynamicResource CardBorder}"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Foreground="{DynamicResource TextPrimary}"
                                                Text="{Binding}" />
                                            <Button
                                                Width="20"
                                                Height="20"
                                                Margin="4,0,0,0"
                                                Click="BtnRemoveMockValue_Click"
                                                Style="{StaticResource IconButtonStyle}"
                                                Tag="{Binding}"
                                                ToolTip="{DynamicResource Str_Settings_RemoveThisValue}">
                                                <materialDesign:PackIcon
                                                    Width="11"
                                                    Height="11"
                                                    Kind="Close" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border
                            Width="190"
                            Height="28"
                            Margin="0,0,0,6"
                            Padding="8,0"
                            Style="{StaticResource InputBarStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon
                                    Width="13"
                                    Height="13"
                                    Margin="0,0,4,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource AccentColor}"
                                    Kind="Plus" />
                                <TextBox
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontSize="12"
                                    KeyDown="NewMockValue_KeyDown"
                                    LostFocus="NewMockValue_LostFocus"
                                    Style="{StaticResource BareTextBox}"
                                    Tag="{DynamicResource Str_Settings_AddValuesHint}"
                                    ToolTip="{DynamicResource Str_Settings_AddValuesTooltip}" />
                            </Grid>
                        </Border>
                    </WrapPanel>

                    <!--  Empty-list / name warning  -->
                    <StackPanel
                        Grid.Row="2"
                        Margin="40,4,0,0"
                        Orientation="Horizontal"
                        Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}">
                        <materialDesign:PackIcon
                            Width="13"
                            Height="13"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource StatusWarningFg}"
                            Kind="AlertOutline" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11.5"
                            Foreground="{DynamicResource StatusWarningFg}"
                            Text="{Binding Warning}" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!--  One category card  -->
        <DataTemplate x:Key="CategoryTemplate" DataType="{x:Type modules:FileCategory}">
            <Border
                Margin="0,0,0,10"
                Padding="12"
                Background="{DynamicResource RowBg}"
                CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" MaxWidth="260" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="30"
                            Height="30"
                            Margin="0,0,10,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AccentColorSubtle}"
                            CornerRadius="8">
                            <materialDesign:PackIcon
                                Width="16"
                                Height="16"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource AccentColor}"
                                Kind="TagOutline" />
                        </Border>
                        <TextBox
                            Grid.Column="1"
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            LostFocus="CategoryName_LostFocus"
                            Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                            TextChanged="CategoryName_TextChanged"
                            ToolTip="{DynamicResource Str_Settings_FolderNameOrganizeFiles}" />
                        <Border
                            Grid.Column="2"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource AccentColorSubtle}"
                            Style="{StaticResource IconStatusPillStyle}">
                            <TextBlock
                                FontSize="11"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource AccentColor}"
                                Text="{Binding ExtensionCount}" />
                        </Border>
                        <StackPanel
                            Grid.Column="4"
                            VerticalAlignment="Center"
                            Orientation="Horizontal">
                            <Button
                                Width="28"
                                Height="28"
                                Click="BtnCategoryUp_Click"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="{DynamicResource Str_Settings_MoveUpCategoriesHigher}">
                                <materialDesign:PackIcon
                                    Width="15"
                                    Height="15"
                                    Kind="ChevronUp" />
                            </Button>
                            <Button
                                Width="28"
                                Height="28"
                                Margin="2,0"
                                Click="BtnCategoryDown_Click"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="{DynamicResource Str_Settings_MoveDown}">
                                <materialDesign:PackIcon
                                    Width="15"
                                    Height="15"
                                    Kind="ChevronDown" />
                            </Button>
                            <Button
                                Width="28"
                                Height="28"
                                Click="BtnRemoveCategory_Click"
                                Style="{StaticResource IconButtonStyle}"
                                ToolTip="{DynamicResource Str_Settings_RemoveThisCategory}">
                                <materialDesign:PackIcon
                                    Width="15"
                                    Height="15"
                                    Foreground="{DynamicResource StatusErrorFg}"
                                    Kind="DeleteOutline" />
                            </Button>
                        </StackPanel>
                    </Grid>

                    <!--  Extension chips + add box  -->
                    <WrapPanel Grid.Row="1" Margin="40,10,0,0">
                        <ItemsControl Focusable="False" ItemsSource="{Binding ExtensionList}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border
                                        Margin="0,0,6,6"
                                        Padding="9,3,3,3"
                                        Background="{DynamicResource CardBg}"
                                        BorderBrush="{DynamicResource CardBorder}"
                                        BorderThickness="1"
                                        CornerRadius="12">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock
                                                VerticalAlignment="Center"
                                                FontFamily="Consolas"
                                                FontSize="12"
                                                Foreground="{DynamicResource TextPrimary}"
                                                Text="{Binding}" />
                                            <Button
                                                Width="20"
                                                Height="20"
                                                Margin="4,0,0,0"
                                                Click="BtnRemoveExtension_Click"
                                                Style="{StaticResource IconButtonStyle}"
                                                Tag="{Binding}"
                                                ToolTip="{DynamicResource Str_Settings_RemoveThisExtension}">
                                                <materialDesign:PackIcon
                                                    Width="11"
                                                    Height="11"
                                                    Kind="Close" />
                                            </Button>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Border
                            Width="170"
                            Height="28"
                            Margin="0,0,0,6"
                            Padding="8,0"
                            Style="{StaticResource InputBarStyle}">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <materialDesign:PackIcon
                                    Width="13"
                                    Height="13"
                                    Margin="0,0,4,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource AccentColor}"
                                    Kind="Plus" />
                                <TextBox
                                    Grid.Column="1"
                                    VerticalAlignment="Center"
                                    FontFamily="Consolas"
                                    FontSize="12"
                                    KeyDown="NewExtension_KeyDown"
                                    LostFocus="NewExtension_LostFocus"
                                    Style="{StaticResource BareTextBox}"
                                    Tag="add: png jpg"
                                    TextChanged="NewExtension_TextChanged"
                                    ToolTip="{DynamicResource Str_Settings_TypeOneOrMore}" />
                            </Grid>
                        </Border>
                    </WrapPanel>

                    <!--  Overlap / empty warning  -->
                    <StackPanel
                        Grid.Row="2"
                        Margin="40,4,0,0"
                        Orientation="Horizontal"
                        Visibility="{Binding HasWarning, Converter={StaticResource BoolToVisibility}}">
                        <materialDesign:PackIcon
                            Width="13"
                            Height="13"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource StatusWarningFg}"
                            Kind="AlertOutline" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11.5"
                            Foreground="{DynamicResource StatusWarningFg}"
                            Text="{Binding Warning}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

        <!--  One saved pattern  -->
        <DataTemplate x:Key="PatternTemplate" DataType="{x:Type modules:SavedSearchPattern}">
            <Border
                Margin="0,0,0,10"
                Padding="12"
                Background="{DynamicResource RowBg}"
                CornerRadius="12">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="170" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="10" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox
                            VerticalAlignment="Center"
                            FontWeight="SemiBold"
                            LostFocus="AutoSave_LostFocus"
                            Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}"
                            ToolTip="{DynamicResource Str_Settings_NameShownAsA}" />
                        <TextBox
                            Grid.Column="2"
                            VerticalAlignment="Center"
                            FontFamily="Consolas"
                            LostFocus="AutoSave_LostFocus"
                            Text="{Binding Pattern, UpdateSourceTrigger=PropertyChanged}"
                            TextChanged="PatternText_TextChanged"
                            ToolTip="{DynamicResource Str_Settings_TheRegularExpressionOr}" />
                        <ComboBox
                            Grid.Column="4"
                            VerticalAlignment="Center"
                            SelectedValue="{Binding Type, Mode=TwoWay}"
                            SelectedValuePath="Tag"
                            SelectionChanged="PatternType_SelectionChanged"
                            ToolTip="{DynamicResource Str_Settings_RegexMatchesAnywhereIn}">
                            <ComboBoxItem Tag="Regex">Regex</ComboBoxItem>
                            <ComboBoxItem Tag="Wildcard">Wildcard</ComboBoxItem>
                        </ComboBox>
                        <Border
                            Grid.Column="5"
                            Margin="10,0,0,0"
                            VerticalAlignment="Center"
                            Background="{DynamicResource StatusInfoBg}"
                            Style="{StaticResource IconStatusPillStyle}"
                            ToolTip="{DynamicResource Str_Settings_MatchesInTheTest}"
                            Visibility="{Binding HasTestResult, Converter={StaticResource BoolToVisibility}}">
                            <StackPanel Orientation="Horizontal">
                                <materialDesign:PackIcon
                                    Width="12"
                                    Height="12"
                                    Margin="0,0,4,0"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource StatusInfoFg}"
                                    Kind="TestTube" />
                                <TextBlock
                                    FontSize="11"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource StatusInfoFg}"
                                    Text="{Binding TestResult}" />
                            </StackPanel>
                        </Border>
                        <Button
                            Grid.Column="6"
                            Width="28"
                            Height="28"
                            Margin="8,0,0,0"
                            VerticalAlignment="Center"
                            Click="BtnRemovePattern_Click"
                            Style="{StaticResource IconButtonStyle}"
                            ToolTip="{DynamicResource Str_Settings_RemoveThisPattern}">
                            <materialDesign:PackIcon
                                Width="15"
                                Height="15"
                                Foreground="{DynamicResource StatusErrorFg}"
                                Kind="DeleteOutline" />
                        </Button>
                    </Grid>
                    <StackPanel
                        Grid.Row="1"
                        Margin="180,6,0,0"
                        Orientation="Horizontal"
                        Visibility="{Binding HasError, Converter={StaticResource BoolToVisibility}}">
                        <materialDesign:PackIcon
                            Width="13"
                            Height="13"
                            Margin="0,0,6,0"
                            VerticalAlignment="Center"
                            Foreground="{DynamicResource StatusErrorFg}"
                            Kind="AlertOutline" />
                        <TextBlock
                            VerticalAlignment="Center"
                            FontSize="11.5"
                            Foreground="{DynamicResource StatusErrorFg}"
                            Text="{Binding Error}"
                            TextWrapping="Wrap" />
                    </StackPanel>
                </Grid>
            </Border>
        </DataTemplate>

    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">

        <!--  No page header: MainWindow's header card shows the tool's icon and name.  -->

        <Grid Margin="16,8,16,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="OptionsColumn" Width="280" />
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!--  ================= SIDEBAR =================  -->

            <Border Grid.Column="0" Style="{StaticResource SidebarPanelStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <StackPanel>
                        <Button
                            x:Name="BtnCollapseOptions"
