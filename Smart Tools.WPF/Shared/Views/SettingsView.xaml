                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon
                                        Grid.Column="0"
                                        Width="18"
                                        Height="18"
                                        VerticalAlignment="Center"
                                        Kind="Cog" />
                                    <TextBlock
                                        Grid.Column="1"
                                        x:Name="LblNavGeneral"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="{DynamicResource Str_Settings_NavGeneral}" TextWrapping="Wrap" />
                                </Grid>
                            </RadioButton>
                            <RadioButton
                                x:Name="BtnNavCategories"
                                Click="Nav_Click"
                                GroupName="SettingsNav"
                                Style="{StaticResource NavButtonStyle}"
                                Tag="Categories"
                                ToolTip="{DynamicResource Str_Settings_NavCategories}">
                                <Grid HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon
                                        Grid.Column="0"
                                        Width="18"
                                        Height="18"
                                        VerticalAlignment="Center"
                                        Kind="TagMultiple" />
                                    <TextBlock
                                        Grid.Column="1"
                                        x:Name="LblNavCategories"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="{DynamicResource Str_Settings_NavCategories}" TextWrapping="Wrap" />
                                </Grid>
                            </RadioButton>
                            <RadioButton
                                x:Name="BtnNavPatterns"
                                Click="Nav_Click"
                                GroupName="SettingsNav"
                                Style="{StaticResource NavButtonStyle}"
                                Tag="Patterns"
                                ToolTip="{DynamicResource Str_Settings_NavPatterns}">
                                <Grid HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon
                                        Grid.Column="0"
                                        Width="18"
                                        Height="18"
                                        VerticalAlignment="Center"
                                        Kind="Regex" />
                                    <TextBlock
                                        Grid.Column="1"
                                        x:Name="LblNavPatterns"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="{DynamicResource Str_Settings_NavPatterns}" TextWrapping="Wrap" />
                                </Grid>
                            </RadioButton>
                            <RadioButton
                                x:Name="BtnNavMockData"
                                Click="Nav_Click"
                                GroupName="SettingsNav"
                                Style="{StaticResource NavButtonStyle}"
                                Tag="MockData"
                                ToolTip="{DynamicResource Str_Settings_NavMockData}">
                                <Grid HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon
                                        Grid.Column="0"
                                        Width="18"
                                        Height="18"
                                        VerticalAlignment="Center"
                                        Kind="DatabaseEdit" />
                                    <TextBlock
                                        Grid.Column="1"
                                        x:Name="LblNavMockData"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="{DynamicResource Str_Settings_NavMockData}" TextWrapping="Wrap" />
                                </Grid>
                            </RadioButton>
                            <RadioButton
                                x:Name="BtnNavEventDays"
                                Click="Nav_Click"
                                GroupName="SettingsNav"
                                Style="{StaticResource NavButtonStyle}"
                                Tag="EventDays"
                                ToolTip="{DynamicResource Str_Settings_NavEventDays}">
                                <Grid HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon
                                        Grid.Column="0"
                                        Width="18"
                                        Height="18"
                                        VerticalAlignment="Center"
                                        Kind="CalendarStar" />
                                    <TextBlock
                                        Grid.Column="1"
                                        x:Name="LblNavEventDays"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="{DynamicResource Str_Settings_NavEventDays}" TextWrapping="Wrap" />
                                </Grid>
                            </RadioButton>
                            <RadioButton
                                x:Name="BtnNavShortcuts"
                                Click="Nav_Click"
                                GroupName="SettingsNav"
                                Style="{StaticResource NavButtonStyle}"
                                Tag="Shortcuts"
                                ToolTip="{DynamicResource Str_Settings_NavShortcuts}">
                                <Grid HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon
                                        Grid.Column="0"
                                        Width="18"
                                        Height="18"
                                        VerticalAlignment="Center"
                                        Kind="KeyboardOutline" />
                                    <TextBlock
                                        Grid.Column="1"
                                        x:Name="LblNavShortcuts"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="{DynamicResource Str_Settings_NavShortcuts}" TextWrapping="Wrap" />
                                </Grid>
                            </RadioButton>
                            <RadioButton
                                x:Name="BtnNavVault"
                                Click="Nav_Click"
                                GroupName="SettingsNav"
                                Style="{StaticResource NavButtonStyle}"
                                Tag="Vault"
                                ToolTip="{DynamicResource Str_Settings_NavVault}">
                                <Grid HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon
                                        Grid.Column="0"
                                        Width="18"
                                        Height="18"
                                        VerticalAlignment="Center"
                                        Kind="ShieldKeyOutline" />
                                    <TextBlock
                                        x:Name="LblNavVault"
                                        Grid.Column="1"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="{DynamicResource Str_Settings_NavVault}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </RadioButton>
                            <RadioButton
                                x:Name="BtnNavMediaViewer"
                                Click="Nav_Click"
                                GroupName="SettingsNav"
                                Style="{StaticResource NavButtonStyle}"
                                Tag="MediaViewer"
                                ToolTip="{DynamicResource Str_Settings_NavMediaViewer}">
                                <Grid HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon
                                        Grid.Column="0"
                                        Width="18"
                                        Height="18"
                                        VerticalAlignment="Center"
                                        Kind="PlayBoxMultipleOutline" />
                                    <TextBlock
                                        x:Name="LblNavMediaViewer"
                                        Grid.Column="1"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="{DynamicResource Str_Settings_NavMediaViewer}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </RadioButton>
                            <RadioButton
                                x:Name="BtnNavTexturePack"
                                Click="Nav_Click"
                                GroupName="SettingsNav"
                                Style="{StaticResource NavButtonStyle}"
                                Tag="TexturePack"
                                ToolTip="{DynamicResource Str_Settings_NavTexturePack}">
                                <Grid HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon
                                        Grid.Column="0"
                                        Width="18"
                                        Height="18"
                                        VerticalAlignment="Center"
                                        Kind="PackageVariantClosed" />
                                    <TextBlock
                                        x:Name="LblNavTexturePack"
                                        Grid.Column="1"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="{DynamicResource Str_Settings_NavTexturePack}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </RadioButton>
                            <RadioButton
                                x:Name="BtnNavClipboard"
                                Click="Nav_Click"
                                GroupName="SettingsNav"
                                Style="{StaticResource NavButtonStyle}"
                                Tag="Clipboard"
                                ToolTip="{DynamicResource Str_Settings_NavClipboard}">
                                <Grid HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon
                                        Grid.Column="0"
                                        Width="18"
                                        Height="18"
                                        VerticalAlignment="Center"
                                        Kind="ClipboardTextClockOutline" />
                                    <TextBlock
                                        x:Name="LblNavClipboard"
                                        Grid.Column="1"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="{DynamicResource Str_Settings_NavClipboard}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </RadioButton>
                            <RadioButton
                                x:Name="BtnNavTextRecognition"
                                Click="Nav_Click"
                                GroupName="SettingsNav"
                                Style="{StaticResource NavButtonStyle}"
                                Tag="TextRecognition"
                                ToolTip="{DynamicResource Str_Settings_NavTextRecognition}">
                                <Grid HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon
                                        Grid.Column="0"
                                        Width="18"
                                        Height="18"
                                        VerticalAlignment="Center"
                                        Kind="TextRecognition" />
                                    <TextBlock
                                        x:Name="LblNavTextRecognition"
                                        Grid.Column="1"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="{DynamicResource Str_Settings_NavTextRecognition}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </RadioButton>
                            <RadioButton
                                x:Name="BtnNavTranslate"
                                Click="Nav_Click"
                                GroupName="SettingsNav"
                                Style="{StaticResource NavButtonStyle}"
                                Tag="Translate"
                                ToolTip="{DynamicResource Str_Settings_NavTranslate}">
                                <Grid HorizontalAlignment="Center">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <materialDesign:PackIcon
                                        Grid.Column="0"
                                        Width="18"
                                        Height="18"
                                        VerticalAlignment="Center"
                                        Kind="Translate" />
                                    <TextBlock
                                        x:Name="LblNavTranslate"
                                        Grid.Column="1"
                                        Margin="10,0,0,0"
                                        VerticalAlignment="Center"
                                        Text="{DynamicResource Str_Settings_NavTranslate}"
                                        TextWrapping="Wrap" />
                                </Grid>
                            </RadioButton>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>

            <!--  ================= SECTIONS =================  -->

            <ScrollViewer
                x:Name="ContentScroller"
                Grid.Column="2"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <Grid>

                    <!--  ============ General ============  -->
                    <StackPanel x:Name="PanelGeneral">
                        <Border Margin="0,0,0,14" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <ContentControl
                                    Margin="0,0,0,12"
                                    Content="{DynamicResource Str_Settings_SettingsFile}"
                                    Style="{StaticResource CardHeader}"
                                    Tag="{x:Static materialDesign:PackIconKind.FileCogOutline}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel VerticalAlignment="Center">
                                        <TextBlock
                                            FontSize="12.5"
                                            FontWeight="SemiBold"
                                            Foreground="{DynamicResource TextPrimary}"
                                            Text="{DynamicResource Str_Settings_WhereSettingsLive}" />
                                        <TextBlock
                                            x:Name="TxtSettingsPath"
                                            Margin="0,2,0,0"
                                            FontSize="11"
                                            Foreground="{DynamicResource TextSecondary}"
                                            TextWrapping="Wrap" />
                                    </StackPanel>
                                    <Button
                                        x:Name="BtnOpenSettingsFolder"
                                        Grid.Column="1"
                                        Margin="12,0,0,0"
                                        VerticalAlignment="Center"
                                        Click="BtnOpenSettingsFolder_Click"
                                        Style="{StaticResource NeutralIconButtonStyle}"
                                        ToolTip="{DynamicResource Str_Settings_OpenTheFolderWith}">
                                        <Grid HorizontalAlignment="Center" Margin="8,0">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon
                                                Grid.Column="0"
                                                Width="15"
                                                Height="15"
                                                Margin="0,0,5,0"
                                                VerticalAlignment="Center"
                                                Kind="FolderOpenOutline" />
                                            <TextBlock
                                                Grid.Column="1"
                                                VerticalAlignment="Center"
                                                FontSize="12"
                                                Text="{DynamicResource Str_FileConverter_OpenFolder}" TextWrapping="Wrap" />
                                        </Grid>
                                    </Button>
                                </Grid>
                                <Border
                                    x:Name="LoadProblemBanner"
                                    Margin="0,12,0,0"
                                    Padding="10,8"
                                    Background="{DynamicResource StatusWarningBg}"
                                    CornerRadius="8"
                                    Visibility="Collapsed">
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <materialDesign:PackIcon
                                            Width="14"
                                            Height="14"
                                            Margin="0,1,8,0"
                                            VerticalAlignment="Top"
                                            Foreground="{DynamicResource StatusWarningFg}"
                                            Kind="AlertOutline" />
                                        <TextBlock
                                            x:Name="TxtLoadProblem"
                                            Grid.Column="1"
                                            FontSize="11"
                                            Foreground="{DynamicResource StatusWarningFg}"
                                            TextWrapping="Wrap" />
                                    </Grid>
                                </Border>
                            </StackPanel>
                        </Border>

                        <Border Margin="0,0,0,14" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <Grid Margin="0,0,0,4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <ContentControl
                                        Content="{DynamicResource Str_Settings_GeneralTitle}"
                                        Style="{StaticResource CardHeader}"
                                        Tag="{x:Static materialDesign:PackIconKind.ThemeLightDark}" />
                                    <Border
                                        x:Name="SavedPill"
                                        Grid.Column="1"
                                        VerticalAlignment="Center"
                                        Background="{DynamicResource StatusSuccessBg}"
                                        Style="{StaticResource IconStatusPillStyle}"
                                        Visibility="Collapsed">
                                        <StackPanel Orientation="Horizontal">
                                            <materialDesign:PackIcon
                                                Width="13"
                                                Height="13"
                                                Margin="0,0,5,0"
                                                VerticalAlignment="Center"
                                                Foreground="{DynamicResource StatusSuccessFg}"
                                                Kind="CheckCircleOutline" />
                                            <TextBlock
                                                FontSize="11"
                                                FontWeight="SemiBold"
                                                Foreground="{DynamicResource StatusSuccessFg}"
                                                Text="{DynamicResource Str_Settings_Saved}" />
                                        </StackPanel>
                                    </Border>
                                </Grid>
                                <TextBlock
                                    Margin="0,0,0,16"
                                    FontSize="12"
                                    Foreground="{DynamicResource TextSecondary}"
                                    Text="{DynamicResource Str_Settings_GeneralSubtitle}"
                                    TextWrapping="Wrap" />

                                <TextBlock
                                    Margin="0,0,0,8"
                                    Style="{StaticResource FieldLabel}"
                                    Text="{DynamicResource Str_Settings_Theme}" />
                                <UniformGrid
                                    x:Name="ThemeChoices"
                                    MaxWidth="520"
                                    HorizontalAlignment="Left"
                                    Columns="3"
                                    ToolTip="{DynamicResource Str_Settings_ThemeTooltip}">
                                    <!--  Swatches are fixed colours on purpose: they picture each theme.  -->
                                    <RadioButton
                                        Margin="0,0,8,0"
                                        Click="RadioTheme_Click"
                                        GroupName="Theme"
                                        Style="{StaticResource ChoiceTileStyle}"
                                        Tag="Light">
                                        <StackPanel>
                                            <Border
                                                Width="120"
                                                Height="56"
                                                Background="#F4F6FA"
                                                BorderBrush="#D9DEE7"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                                <StackPanel Margin="8">
                                                    <Border
                                                        Height="8"
                                                        Background="#FFFFFF"
                                                        CornerRadius="3" />
                                                    <Border
                                                        Width="60"
                                                        Height="6"
                                                        Margin="0,6,0,0"
                                                        HorizontalAlignment="Left"
                                                        Background="#C9D0DC"
                                                        CornerRadius="3" />
                                                    <Border
                                                        Width="36"
                                                        Height="6"
                                                        Margin="0,4,0,0"
                                                        HorizontalAlignment="Left"
                                                        Background="#4C8DFF"
                                                        CornerRadius="3" />
                                                </StackPanel>
                                            </Border>
                                            <StackPanel
                                                Margin="0,8,0,0"
                                                HorizontalAlignment="Center"
                                                Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="15"
                                                    Height="15"
                                                    Margin="0,0,5,0"
                                                    VerticalAlignment="Center"
                                                    Kind="WhiteBalanceSunny" />
                                                <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_PdfToolkit_Light}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton
                                        Margin="4,0"
                                        Click="RadioTheme_Click"
                                        GroupName="Theme"
                                        Style="{StaticResource ChoiceTileStyle}"
                                        Tag="Dark">
                                        <StackPanel>
                                            <Border
                                                Width="120"
                                                Height="56"
                                                Background="#1B1E24"
                                                BorderBrush="#2E333C"
                                                BorderThickness="1"
                                                CornerRadius="8">
                                                <StackPanel Margin="8">
                                                    <Border
                                                        Height="8"
                                                        Background="#262A32"
                                                        CornerRadius="3" />
                                                    <Border
                                                        Width="60"
                                                        Height="6"
                                                        Margin="0,6,0,0"
                                                        HorizontalAlignment="Left"
                                                        Background="#3A404B"
                                                        CornerRadius="3" />
                                                    <Border
                                                        Width="36"
                                                        Height="6"
                                                        Margin="0,4,0,0"
                                                        HorizontalAlignment="Left"
                                                        Background="#6EA4FF"
                                                        CornerRadius="3" />
                                                </StackPanel>
                                            </Border>
                                            <StackPanel
                                                Margin="0,8,0,0"
                                                HorizontalAlignment="Center"
                                                Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="15"
                                                    Height="15"
                                                    Margin="0,0,5,0"
                                                    VerticalAlignment="Center"
                                                    Kind="WeatherNight" />
                                                <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_Settings_Dark}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </RadioButton>
                                    <RadioButton
                                        Margin="8,0,0,0"
                                        Click="RadioTheme_Click"
                                        GroupName="Theme"
                                        Style="{StaticResource ChoiceTileStyle}"
                                        Tag="Match System">
                                        <StackPanel>
                                            <Grid Width="120" Height="56">
                                                <Grid.ColumnDefinitions>
                                                    <ColumnDefinition />
                                                    <ColumnDefinition />
                                                </Grid.ColumnDefinitions>
                                                <Border
                                                    Background="#F4F6FA"
                                                    BorderBrush="#D9DEE7"
                                                    BorderThickness="1,1,0,1"
                                                    CornerRadius="8,0,0,8" />
                                                <Border
                                                    Grid.Column="1"
                                                    Background="#1B1E24"
                                                    BorderBrush="#2E333C"
                                                    BorderThickness="0,1,1,1"
                                                    CornerRadius="0,8,8,0" />
                                            </Grid>
                                            <StackPanel
                                                Margin="0,8,0,0"
                                                HorizontalAlignment="Center"
                                                Orientation="Horizontal">
                                                <materialDesign:PackIcon
                                                    Width="15"
                                                    Height="15"
                                                    Margin="0,0,5,0"
                                                    VerticalAlignment="Center"
                                                    Kind="ThemeLightDark" />
                                                <TextBlock VerticalAlignment="Center" Text="{DynamicResource Str_Settings_System}" />
                                            </StackPanel>
                                        </StackPanel>
                                    </RadioButton>
                                </UniformGrid>

                                <TextBlock
                                    Margin="0,18,0,8"
                                    Style="{StaticResource FieldLabel}"
                                    Text="{DynamicResource Str_Settings_Language}" />
                                <UniformGrid
                                    x:Name="LanguageChoices"
                                    Width="260"
                                    HorizontalAlignment="Left"
                                    Columns="2"
                                    ToolTip="{DynamicResource Str_Settings_LanguageTooltip}">
                                    <RadioButton
                                        Margin="0,0,4,0"
                                        Click="RadioLanguage_Click"
                                        GroupName="Language"
                                        Style="{StaticResource ChoiceTileStyle}"
                                        Tag="en">
                                        <Grid HorizontalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon
                                                Grid.Column="0"
                                                Width="15"
                                                Height="15"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Kind="Translate" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_Settings_English}" TextWrapping="Wrap" />
                                        </Grid>
                                    </RadioButton>
                                    <RadioButton
                                        Margin="4,0,0,0"
                                        Click="RadioLanguage_Click"
                                        GroupName="Language"
                                        Style="{StaticResource ChoiceTileStyle}"
                                        Tag="es">
                                        <Grid HorizontalAlignment="Center">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <materialDesign:PackIcon
                                                Grid.Column="0"
                                                Width="15"
                                                Height="15"
                                                Margin="0,0,6,0"
                                                VerticalAlignment="Center"
                                                Kind="Translate" />
                                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_Settings_EspaOl}" TextWrapping="Wrap" />
                                        </Grid>
                                    </RadioButton>
                                </UniformGrid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <ContentControl
                                    Margin="0,0,0,12"
                                    Content="{DynamicResource Str_CodeToolkit_Behaviour}"
                                    Style="{StaticResource CardHeader}"
                                    Tag="{x:Static materialDesign:PackIconKind.BellOutline}" />
                                <CheckBox
                                    x:Name="ChkConfirmDelete"
                                    Checked="Behaviour_Changed"
                                    Content="{DynamicResource Str_Settings_ConfirmDelete}"
                                    ToolTip="{DynamicResource Str_Settings_ConfirmDeleteTooltip}"
                                    Unchecked="Behaviour_Changed" />
                                <CheckBox
                                    x:Name="ChkShowNotifications"
                                    Checked="Behaviour_Changed"
                                    Content="{DynamicResource Str_Settings_ShowNotifications}"
                                    ToolTip="{DynamicResource Str_Settings_ShowNotificationsTooltip}"
                                    Unchecked="Behaviour_Changed" />
                                <CheckBox
                                    x:Name="ChkTrackActiveTool"
                                    Checked="Behaviour_Changed"
                                    Content="{DynamicResource Str_Settings_TrackActiveTool}"
                                    ToolTip="{DynamicResource Str_Settings_TrackActiveToolTooltip}"
                                    Unchecked="Behaviour_Changed" />
                            </StackPanel>
                        </Border>

                        <Border Margin="0,14,0,0" Style="{StaticResource CardStyle}">
                            <StackPanel>
                                <ContentControl
                                    Margin="0,0,0,12"
                                    Content="{DynamicResource Str_Settings_BackgroundHeader}"
                                    Style="{StaticResource CardHeader}"
                                    Tag="{x:Static materialDesign:PackIconKind.TrayFull}" />
                                <CheckBox
                                    x:Name="ChkCloseToTray"
                                    Click="ChkCloseToTray_Click"
                                    Content="{DynamicResource Str_Shortcuts_CloseToTray}"
