                                    </Button>
                                    <Button x:Name="BtnOpenAppFolder" Margin="0,0,8,8" Click="BtnOpenAppFolder_Click" Style="{StaticResource NeutralIconButtonStyle}">
                                        <StackPanel Margin="8,0" Orientation="Horizontal">
                                            <materialDesign:PackIcon Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center" Kind="FolderOpenOutline" />
                                            <TextBlock VerticalAlignment="Center" FontSize="12" Text="{DynamicResource Str_Install_OpenAppFolder}" />
                                        </StackPanel>
                                    </Button>
                                    <Button x:Name="BtnUninstall" Margin="0,0,8,8" Click="BtnUninstall_Click" Style="{StaticResource NeutralIconButtonStyle}" ToolTip="{DynamicResource Str_Install_UninstallTip}">
                                        <StackPanel Margin="8,0" Orientation="Horizontal">
                                            <materialDesign:PackIcon Width="15" Height="15" Margin="0,0,6,0" VerticalAlignment="Center" Kind="DeleteOutline" />
                                            <TextBlock VerticalAlignment="Center" FontSize="12" Text="{DynamicResource Str_Install_Uninstall}" />
                                        </StackPanel>
                                    </Button>
                                </WrapPanel>
                                <TextBlock
                                    x:Name="TxtInstallHint"
                                    FontSize="11"
                                    Foreground="{DynamicResource TextSecondary}"
                                    TextWrapping="Wrap" />
