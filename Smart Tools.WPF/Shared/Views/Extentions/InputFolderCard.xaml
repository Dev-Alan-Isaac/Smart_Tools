<UserControl
    x:Class="Smart_Tools.WPF.Controls.InputFolderCard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!--
        No x:Name in this file on purpose (same rule as OutputFolderCard): parts
        carry x:Uid and the code-behind finds them once, after InitializeComponent.

        The standard Input card for every tool that takes files or folders in.
        Three modes (Mode): Files (queue of files and folders), Folders (folders
        only) and SingleFolder (one source folder, with a status line).
        Logic: Controllers/InputFolderManager.cs. The card only collects paths
        and raises events; the view keeps its own model and managers.

        Files / Folders:
            <controls:InputFolderCard
                x:Name="InputCard"
                Mode="Files"
                ItemTemplate="{StaticResource QueueItemTemplate}"
                PathsAdded="InputCard_PathsAdded"
                ClearRequested="InputCard_ClearRequested"
                IncludeSubfoldersChanged="InputCard_IncludeSubfoldersChanged" />
        SingleFolder:
            <controls:InputFolderCard Mode="SingleFolder" FolderChanged="InputCard_FolderChanged" />
        (xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls")
    -->

    <Border Style="{StaticResource SidebarGroupCardStyle}">
        <StackPanel>
            <ContentControl
                x:Uid="HeaderControl"
                Content="{DynamicResource Str_Common_Files}"
                Style="{StaticResource SidebarGroupHeader}"
                Tag="{x:Static materialDesign:PackIconKind.FileMultipleOutline}" />

            <!--  ============ FILES / FOLDERS: the queue ============  -->
            <StackPanel x:Uid="ListSection">
                <Border
                    x:Uid="DropArea"
                    MinHeight="64"
                    Margin="0,0,0,10"
                    AllowDrop="True"
                    Background="{DynamicResource SidebarInputBg}"
                    BorderBrush="{DynamicResource SidebarInputBorder}"
                    BorderThickness="1"
                    CornerRadius="8"
                    DragLeave="DropArea_DragLeave"
                    DragOver="DropArea_DragOver"
                    Drop="DropArea_Drop">
                    <Grid>
                        <ListBox
                            x:Uid="ItemList"
                            MaxHeight="170"
                            Padding="4"
                            Background="Transparent"
                            BorderThickness="0"
                            ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                            ScrollViewer.VerticalScrollBarVisibility="Auto">
                            <ListBox.ItemContainerStyle>
                                <Style TargetType="ListBoxItem">
                                    <Setter Property="Padding" Value="0" />
                                    <Setter Property="Margin" Value="0,0,0,2" />
                                    <Setter Property="Focusable" Value="False" />
                                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                    <Setter Property="Template">
                                        <Setter.Value>
                                            <ControlTemplate TargetType="ListBoxItem">
                                                <Border
                                                    x:Name="RowBorder"
                                                    Background="Transparent"
                                                    CornerRadius="8">
                                                    <ContentPresenter Margin="6,5" />
                                                </Border>
                                                <ControlTemplate.Triggers>
                                                    <Trigger Property="IsMouseOver" Value="True">
                                                        <Setter TargetName="RowBorder" Property="Background" Value="{DynamicResource SidebarItemHoverBg}" />
                                                    </Trigger>
                                                </ControlTemplate.Triggers>
                                            </ControlTemplate>
                                        </Setter.Value>
                                    </Setter>
                                </Style>
                            </ListBox.ItemContainerStyle>
                        </ListBox>

                        <StackPanel
                            x:Uid="ListEmptyHint"
                            Margin="10,12"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                            <materialDesign:PackIcon
                                x:Uid="ListEmptyIcon"
                                Width="22"
                                Height="22"
                                HorizontalAlignment="Center"
                                Foreground="{DynamicResource SidebarTextMuted}"
                                Kind="TrayArrowDown" />
                            <TextBlock
                                x:Uid="ListEmptyText"
                                Margin="0,4,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource SidebarTextMuted}"
                                Text="{DynamicResource Str_Common_DragDropFilesFolder}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <!--  Files mode: Add files. Folders mode: the same button adds a folder.  -->
                    <Button
                        x:Uid="BtnAddPrimary"
                        Click="BtnAddPrimary_Click"
                        Style="{StaticResource PrimaryButtonStyle}">
                        <Grid HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon
                                Grid.Column="0"
                                x:Uid="AddPrimaryIcon"
                                Width="16"
                                Height="16"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Kind="FilePlusOutline" />
                            <TextBlock
                                Grid.Column="1"
                                x:Uid="AddPrimaryText"
                                VerticalAlignment="Center"
                                Text="{DynamicResource Str_InputFolderCard_AddFiles}" TextWrapping="Wrap" />
                        </Grid>
                    </Button>
                    <Button
                        x:Uid="BtnAddFolder"
                        Grid.Column="1"
                        Width="34"
                        Height="34"
                        Margin="6,0,0,0"
                        Click="BtnAddFolder_Click"
                        Style="{StaticResource NeutralIconButtonStyle}"
                        ToolTip="{DynamicResource Str_InputFolderCard_AddFoldersTooltip}">
                        <materialDesign:PackIcon
                            Width="16"
                            Height="16"
                            Kind="FolderPlusOutline" />
                    </Button>
                    <Button
                        x:Uid="BtnClear"
                        Grid.Column="2"
                        Width="34"
                        Height="34"
                        Margin="6,0,0,0"
                        Click="BtnClear_Click"
                        Style="{StaticResource NeutralIconButtonStyle}"
                        ToolTip="{DynamicResource Str_InputFolderCard_ClearTooltip}">
                        <materialDesign:PackIcon
                            Width="16"
                            Height="16"
                            Kind="PlaylistRemove" />
                    </Button>
                </Grid>
            </StackPanel>

            <!--  ============ SINGLE FOLDER: one source folder ============  -->
            <StackPanel x:Uid="SingleSection" Visibility="Collapsed">
                <Border
                    x:Uid="FolderPanel"
                    MinHeight="64"
                    Margin="0,0,0,10"
                    Padding="8,7"
                    AllowDrop="True"
                    Background="{DynamicResource SidebarInputBg}"
                    BorderBrush="{DynamicResource SidebarInputBorder}"
                    BorderThickness="1"
                    CornerRadius="10"
                    Cursor="Hand"
                    DragLeave="FolderPanel_DragLeave"
                    DragOver="FolderPanel_DragOver"
                    Drop="FolderPanel_Drop"
                    MouseLeftButtonUp="FolderPanel_MouseLeftButtonUp">
                    <Grid>
                        <Grid x:Uid="FolderRow">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Border
                                x:Uid="FolderChip"
                                Width="32"
                                Height="32"
                                Margin="0,0,10,0"
                                VerticalAlignment="Top"
                                Background="{DynamicResource AccentColorSubtle}"
                                CornerRadius="9"
                                RenderTransformOrigin="0.5,0.5">
                                <materialDesign:PackIcon
                                    Width="17"
                                    Height="17"
                                    HorizontalAlignment="Center"
                                    VerticalAlignment="Center"
                                    Foreground="{DynamicResource AccentColor}"
                                    Kind="Folder" />
                            </Border>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                <TextBlock
                                    x:Uid="TxtFolderName"
                                    FontSize="12"
                                    FontWeight="SemiBold"
                                    Foreground="{DynamicResource SidebarText}"
                                    TextTrimming="CharacterEllipsis" />
                                <TextBlock
                                    x:Uid="TxtFolderPath"
                                    Margin="0,1,0,0"
                                    FontSize="10.5"
                                    Foreground="{DynamicResource SidebarTextMuted}"
                                    TextTrimming="CharacterEllipsis" />
                                <StackPanel
                                    x:Uid="StatusLine"
                                    Margin="0,4,0,0"
                                    Orientation="Horizontal">
                                    <materialDesign:PackIcon
                                        x:Uid="StatusIcon"
                                        Width="12"
                                        Height="12"
                                        Margin="0,0,4,0"
                                        VerticalAlignment="Center"
                                        Foreground="{DynamicResource StatusSuccessFg}"
                                        Kind="CheckCircleOutline" />
                                    <TextBlock
                                        x:Uid="TxtStatus"
                                        VerticalAlignment="Center"
                                        FontSize="10.5"
                                        FontWeight="SemiBold"
                                        Foreground="{DynamicResource StatusSuccessFg}"
                                        TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </StackPanel>
                        </Grid>

                        <StackPanel
                            x:Uid="FolderEmptyHint"
                            Margin="10,6"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            IsHitTestVisible="False">
                            <materialDesign:PackIcon
                                Width="22"
                                Height="22"
                                HorizontalAlignment="Center"
                                Foreground="{DynamicResource SidebarTextMuted}"
                                Kind="FolderPlusOutline" />
                            <TextBlock
                                Margin="0,4,0,0"
                                FontSize="11"
                                Foreground="{DynamicResource SidebarTextMuted}"
                                Text="{DynamicResource Str_InputFolderCard_DropAFolderHere}"
                                TextAlignment="Center"
                                TextWrapping="Wrap" />
                        </StackPanel>
                    </Grid>
                </Border>

                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <Button
                        x:Uid="BtnChooseFolder"
                        Click="BtnChooseFolder_Click"
                        Style="{StaticResource PrimaryButtonStyle}"
                        ToolTip="{DynamicResource Str_InputFolderCard_ChooseTooltip}">
                        <Grid HorizontalAlignment="Center">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon
                                Grid.Column="0"
                                Width="16"
                                Height="16"
                                Margin="0,0,6,0"
                                VerticalAlignment="Center"
                                Kind="FolderOutline" />
                            <TextBlock Grid.Column="1" VerticalAlignment="Center" Text="{DynamicResource Str_InputFolderCard_ChooseFolder}" TextWrapping="Wrap" />
                        </Grid>
                    </Button>
                    <Button
                        x:Uid="BtnOpenFolder"
                        Grid.Column="1"
                        Width="34"
                        Height="34"
                        Margin="6,0,0,0"
                        Click="BtnOpenFolder_Click"
                        Style="{StaticResource NeutralIconButtonStyle}"
                        ToolTip="{DynamicResource Str_InputFolderCard_OpenTooltip}">
                        <materialDesign:PackIcon
                            Width="16"
                            Height="16"
                            Kind="FolderOpenOutline" />
                    </Button>
                    <Button
                        x:Uid="BtnResetFolder"
                        Grid.Column="2"
                        Width="34"
                        Height="34"
                        Margin="6,0,0,0"
                        Click="BtnResetFolder_Click"
                        Style="{StaticResource NeutralIconButtonStyle}"
                        ToolTip="{DynamicResource Str_InputFolderCard_ResetTooltip}">
                        <materialDesign:PackIcon
                            Width="16"
                            Height="16"
                            Kind="Restore" />
                    </Button>
                </Grid>
            </StackPanel>

            <!--  Both modes: also use the files inside subfolders  -->
            <CheckBox
                x:Uid="ChkSubfolders"
                Margin="0,10,0,0"
                Click="ChkSubfolders_Click"
                Content="{DynamicResource Str_Common_IncludeSubfolders}"
                Foreground="{DynamicResource SidebarText}"
                IsChecked="True"
                ToolTip="{DynamicResource Str_InputFolderCard_IncludeSubfoldersTooltip}" />

            <!--  The tool's own extra options (e.g. "Skip hidden files")  -->
            <ContentPresenter x:Uid="OptionsPresenter" Margin="0,10,0,0" />
        </StackPanel>
    </Border>
</UserControl>
