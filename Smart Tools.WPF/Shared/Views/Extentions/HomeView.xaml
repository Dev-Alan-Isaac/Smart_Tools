<UserControl
    x:Class="Smart_Tools.WPF.Views.HomeView"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    xmlns:models="clr-namespace:Smart_Tools.WPF.Models"
    x:Name="Root"
    Loaded="Root_Loaded"
    SizeChanged="Root_SizeChanged">

    <!--
        Home page: every tool, grouped into section cards, plus search and
        Recent. Built from Controllers/ToolCatalogManager.cs (the one list of
        sections and tools). Raises ToolRequested(id); MainWindow opens it.
    -->

    <UserControl.Resources>

        <!--  A tool row inside a section card: tinted icon badge, name, one-line description  -->
        <Style x:Key="ToolRowButtonStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Padding="8,7"
                            Background="Transparent"
                            BorderBrush="Transparent"
                            BorderThickness="1"
                            CornerRadius="10"
                            RenderTransformOrigin="0.5,0.5">
                            <Border.RenderTransform>
                                <ScaleTransform x:Name="BdScale" ScaleX="1" ScaleY="1" />
                            </Border.RenderTransform>
                            <ContentPresenter HorizontalAlignment="Stretch" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource RowBg}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Trigger.EnterActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                Storyboard.TargetName="BdScale"
                                                Storyboard.TargetProperty="ScaleX"
                                                To="0.97"
                                                Duration="0:0:0.08" />
                                            <DoubleAnimation
                                                Storyboard.TargetName="BdScale"
                                                Storyboard.TargetProperty="ScaleY"
                                                To="0.97"
                                                Duration="0:0:0.08" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.EnterActions>
                                <Trigger.ExitActions>
                                    <BeginStoryboard>
                                        <Storyboard>
                                            <DoubleAnimation
                                                EasingFunction="{StaticResource EasePop}"
                                                Storyboard.TargetName="BdScale"
                                                Storyboard.TargetProperty="ScaleX"
                                                To="1"
                                                Duration="0:0:0.25" />
                                            <DoubleAnimation
                                                EasingFunction="{StaticResource EasePop}"
                                                Storyboard.TargetName="BdScale"
                                                Storyboard.TargetProperty="ScaleY"
                                                To="1"
                                                Duration="0:0:0.25" />
                                        </Storyboard>
                                    </BeginStoryboard>
                                </Trigger.ExitActions>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Rounded chip for Recent  -->
        <Style x:Key="RecentChipStyle" TargetType="Button">
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Margin" Value="0,0,8,8" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border
                            x:Name="Bd"
                            Padding="10,6,14,6"
                            Background="{DynamicResource CardBg}"
                            BorderBrush="{DynamicResource CardBorder}"
                            BorderThickness="1"
                            CornerRadius="16">
                            <ContentPresenter VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentColorSubtle}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--  Icon in a soft badge tinted with the section colour  -->
        <DataTemplate x:Key="ToolBadgeTemplate" DataType="{x:Type models:ToolInfo}">
            <Grid Width="32" Height="32">
                <Border
                    Background="{Binding AccentHex}"
                    CornerRadius="9"
                    Opacity="0.15" />
                <materialDesign:PackIcon
                    Width="17"
                    Height="17"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Foreground="{Binding AccentHex}"
                    Kind="{Binding Icon}" />
            </Grid>
        </DataTemplate>

        <DataTemplate x:Key="ToolRowTemplate" DataType="{x:Type models:ToolInfo}">
            <Button
                Click="Tool_Click"
                Style="{StaticResource ToolRowButtonStyle}"
                ToolTip="{Binding HeaderTitle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ToolBadgeTemplate}" />
                    <StackPanel
                        Grid.Column="1"
                        Margin="10,0,0,0"
                        VerticalAlignment="Center">
                        <TextBlock
                            FontSize="13"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimary}"
                            Text="{Binding Name}"
                            TextTrimming="CharacterEllipsis" />
                        <TextBlock
                            FontSize="11"
                            Foreground="{DynamicResource TextSecondary}"
                            Text="{Binding Description}"
                            TextTrimming="CharacterEllipsis" />
                    </StackPanel>
                    <materialDesign:PackIcon
                        Grid.Column="2"
                        Width="14"
                        Height="14"
                        Margin="6,0,2,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextSecondary}"
                        Kind="ChevronRight"
                        Opacity="0.6" />
                </Grid>
            </Button>
        </DataTemplate>

        <!--  A section card  -->
        <DataTemplate x:Key="CategoryCardTemplate" DataType="{x:Type models:ToolCategoryInfo}">
            <Border Margin="0,0,0,14" Style="{StaticResource CardStyle}">
                <StackPanel>
                    <Grid Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Border
                            Width="38"
                            Height="38"
                            Background="{Binding AccentHex}"
                            CornerRadius="11">
                            <materialDesign:PackIcon
                                Width="20"
                                Height="20"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Foreground="White"
                                Kind="{Binding Icon}" />
                        </Border>
                        <StackPanel
                            Grid.Column="1"
                            Margin="12,0,0,0"
                            VerticalAlignment="Center">
                            <TextBlock
                                FontSize="15"
                                FontWeight="Bold"
                                Foreground="{DynamicResource TextPrimary}"
                                Text="{Binding Title}" />
                            <TextBlock
                                FontSize="11.5"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="{Binding Blurb}"
                                TextTrimming="CharacterEllipsis" />
                        </StackPanel>
                        <Border
                            Grid.Column="2"
                            Padding="8,2"
                            VerticalAlignment="Center"
                            Background="{DynamicResource RowBg}"
                            CornerRadius="9">
                            <TextBlock
                                FontSize="10.5"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="{Binding CountLabel}" />
                        </Border>
                    </Grid>
                    <ItemsControl
                        Focusable="False"
                        ItemTemplate="{StaticResource ToolRowTemplate}"
                        ItemsSource="{Binding Tools}" />
                </StackPanel>
            </Border>
        </DataTemplate>

        <!--  Search result tile: like a row, plus the section it's in  -->
        <DataTemplate x:Key="ResultTileTemplate" DataType="{x:Type models:ToolInfo}">
            <Border
                Margin="0,0,10,10"
                Padding="4"
                Background="{DynamicResource CardBg}"
                BorderBrush="{DynamicResource CardBorder}"
                BorderThickness="1"
                CornerRadius="12">
                <Button
                    Click="Tool_Click"
                    Style="{StaticResource ToolRowButtonStyle}"
                    ToolTip="{Binding HeaderTitle}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentPresenter Content="{Binding}" ContentTemplate="{StaticResource ToolBadgeTemplate}" />
                        <StackPanel Grid.Column="1" Margin="10,0,0,0">
                            <TextBlock
                                FontSize="13"
                                FontWeight="SemiBold"
                                Foreground="{DynamicResource TextPrimary}"
                                Text="{Binding Name}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                FontSize="11"
                                Foreground="{DynamicResource TextSecondary}"
                                Text="{Binding Description}"
                                TextTrimming="CharacterEllipsis" />
                            <TextBlock
                                Margin="0,3,0,0"
                                FontSize="10"
                                FontWeight="SemiBold"
                                Foreground="{Binding AccentHex}"
                                Text="{Binding CategoryTitle}" />
                        </StackPanel>
                    </Grid>
                </Button>
            </Border>
        </DataTemplate>

        <DataTemplate x:Key="RecentChipTemplate" DataType="{x:Type models:ToolInfo}">
            <Button
                Click="Tool_Click"
                Style="{StaticResource RecentChipStyle}"
                ToolTip="{Binding HeaderTitle}">
                <Grid HorizontalAlignment="Center">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon
                        Grid.Column="0"
                        Width="15"
                        Height="15"
                        Margin="0,0,7,0"
                        VerticalAlignment="Center"
                        Foreground="{Binding AccentHex}"
                        Kind="{Binding Icon}" />
                    <TextBlock
                        Grid.Column="1"
                        VerticalAlignment="Center"
                        FontSize="12"
                        FontWeight="SemiBold"
                        Foreground="{DynamicResource TextPrimary}"
                        Text="{Binding Name}" TextWrapping="Wrap" />
                </Grid>
            </Button>
        </DataTemplate>

    </UserControl.Resources>

    <Grid Background="{DynamicResource ContentBg}">
        <Grid Margin="16,8,16,0">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!--  Search  -->
            <Border Margin="0,0,0,14" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Margin="0,0,24,0" VerticalAlignment="Center">
                        <TextBlock
                            FontSize="18"
                            FontWeight="Bold"
                            Foreground="{DynamicResource TextPrimary}"
                            Text="{DynamicResource Str_Home_WhatDoYouWant}" />
                        <TextBlock
                            x:Name="TxtToolCount"
                            Margin="0,2,0,0"
                            FontSize="11.5"
                            Foreground="{DynamicResource TextSecondary}" />
                    </StackPanel>
                    <Border
                        x:Name="SearchBar"
                        Grid.Column="1"
                        MaxWidth="560"
                        Padding="10,2,4,2"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Center"
                        Style="{StaticResource InputBarStyle}">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <materialDesign:PackIcon
                                Width="18"
                                Height="18"
                                VerticalAlignment="Center"
                                Foreground="{DynamicResource AccentColor}"
                                Kind="Magnify" />
                            <TextBox
                                x:Name="TxtSearch"
                                Grid.Column="1"
                                FontSize="14"
                                PreviewKeyDown="TxtSearch_PreviewKeyDown"
                                Style="{StaticResource BareTextBox}"
                                Tag="Find a tool… (Ctrl+K)"
                                TextChanged="TxtSearch_TextChanged"
                                ToolTip="{DynamicResource Str_Home_TypePartOfA}" />
                            <Button Padding="0"
                                x:Name="BtnClearSearch"
                                Grid.Column="2"
                                Width="28"
                                Height="28"
                                Margin="2,3"
                                Click="BtnClearSearch_Click"
                                Style="{StaticResource NeutralIconButtonStyle}"
                                ToolTip="{DynamicResource Str_MidiInstruments_ClearTheSearch}"
                                Visibility="Collapsed">
                                <materialDesign:PackIcon
                                    Width="14"
                                    Height="14"
                                    Kind="Close" />
                            </Button>
                        </Grid>
                    </Border>
                </Grid>
            </Border>

            <!--  Recent  -->
            <StackPanel
                x:Name="RecentPanel"
                Grid.Row="1"
                Margin="2,0,0,6"
                Visibility="Collapsed">
                <StackPanel Margin="0,0,0,8" Orientation="Horizontal">
                    <materialDesign:PackIcon
                        Width="14"
                        Height="14"
                        Margin="0,0,6,0"
                        VerticalAlignment="Center"
                        Foreground="{DynamicResource TextSecondary}"
                        Kind="History" />
                    <TextBlock
                        VerticalAlignment="Center"
                        FontSize="10.5"
                        FontWeight="Bold"
                        Foreground="{DynamicResource TextSecondary}"
                        Text="{DynamicResource Str_Home_Recent}" />
                </StackPanel>
                <ItemsControl
                    x:Name="RecentList"
                    Focusable="False"
                    ItemTemplate="{StaticResource RecentChipTemplate}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                </ItemsControl>
            </StackPanel>

            <!--  Section cards (columns filled from code) / search results  -->
            <ScrollViewer
                x:Name="CardsScroll"
                Grid.Row="2"
                HorizontalScrollBarVisibility="Disabled"
                VerticalScrollBarVisibility="Auto">
                <Grid Margin="0,0,0,16">
                    <Grid x:Name="CardsHost" />

                    <StackPanel x:Name="ResultsPanel" Visibility="Collapsed">
                        <TextBlock
                            x:Name="TxtResultsTitle"
                            Margin="2,0,0,10"
                            FontSize="12"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextSecondary}" />
                        <ItemsControl
                            x:Name="ResultsList"
                            Focusable="False"
                            ItemTemplate="{StaticResource ResultTileTemplate}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel ItemWidth="290" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                        </ItemsControl>
                    </StackPanel>

                    <StackPanel
                        x:Name="NoResultsPanel"
                        Margin="0,60,0,0"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Top"
                        Visibility="Collapsed">
                        <ContentControl Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.MagnifyRemoveOutline}" />
                        <TextBlock
                            x:Name="TxtNoResults"
                            Margin="0,12,0,0"
                            HorizontalAlignment="Center"
                            FontSize="15"
                            FontWeight="SemiBold"
                            Foreground="{DynamicResource TextPrimary}" />
                        <TextBlock
                            Margin="0,4,0,0"
                            HorizontalAlignment="Center"
                            FontSize="12"
                            Foreground="{DynamicResource TextSecondary}"
                            Text="{DynamicResource Str_Home_TryAnotherWordLike}" />
                    </StackPanel>
                </Grid>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
