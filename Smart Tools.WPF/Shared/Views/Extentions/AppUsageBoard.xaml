<UserControl
    x:Class="Smart_Tools.WPF.Controls.AppUsageBoard"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:controls="clr-namespace:Smart_Tools.WPF.Controls"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes">

    <!--  Three figures on top, programs stacked over time, then the ranking. Shared by Resource Hogs History and Bandwidth per App.  -->

    <Grid>
        <Grid x:Name="Body">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="14" />
                <RowDefinition Height="2*" MinHeight="190" />
                <RowDefinition Height="14" />
                <RowDefinition Height="3*" MinHeight="150" />
            </Grid.RowDefinitions>

            <!--  The figures that matter  -->
            <ItemsControl x:Name="Highlights">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="0,0,10,0" Padding="16,14" Style="{StaticResource CardStyle}">
                            <DockPanel>
                                <Border Width="44" Height="44" Margin="0,0,14,0" VerticalAlignment="Center" Background="{DynamicResource AccentGradient}" CornerRadius="12" DockPanel.Dock="Left">
                                    <materialDesign:PackIcon Width="24" Height="24" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="White" Kind="{Binding Icon}" />
                                </Border>
                                <StackPanel VerticalAlignment="Center">
                                    <TextBlock FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Text="{Binding Label}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,1,0,0" FontSize="19" FontWeight="Bold" Foreground="{DynamicResource TextPrimary}" Text="{Binding Value}" TextTrimming="CharacterEllipsis" />
                                    <TextBlock Margin="0,1,0,0" FontSize="11.5" Foreground="{DynamicResource TextSecondary}" Text="{Binding Sub}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </DockPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!--  Programs stacked over time  -->
            <Border Grid.Row="2" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <DockPanel>
                        <ContentControl x:Name="ChartHeader" DockPanel.Dock="Left" Style="{StaticResource CardHeader}" Tag="{x:Static materialDesign:PackIconKind.ChartTimelineVariant}" />
                        <ItemsControl x:Name="Legend" Margin="16,0,0,0" VerticalAlignment="Center">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel HorizontalAlignment="Right" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="8,2,0,2" Padding="8,3" Background="Transparent" Cursor="Hand" CornerRadius="10" MouseLeftButtonUp="LegendItem_Click" Tag="{Binding Name}">
                                        <StackPanel Orientation="Horizontal">
                                            <Ellipse Width="9" Height="9" Margin="0,0,6,0" VerticalAlignment="Center" Fill="{Binding ColorBrush}" />
                                            <TextBlock MaxWidth="130" VerticalAlignment="Center" FontSize="11.5" Foreground="{DynamicResource TextPrimary}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DockPanel>
                    <controls:StackedUsageChart x:Name="Chart" Grid.Row="1" Margin="0,10,0,0" />
                </Grid>
            </Border>

            <!--  Ranking  -->
            <Border Grid.Row="4" Style="{StaticResource CardStyle}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>
                    <ContentControl x:Name="ListHeader" Style="{StaticResource CardHeader}" Tag="{x:Static materialDesign:PackIconKind.FormatListNumbered}" />
                    <Grid Grid.Row="1" Margin="12,10,12,4">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="30" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="110" />
                        </Grid.ColumnDefinitions>
                        <TextBlock x:Name="HeadName" Grid.Column="1" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" />
                        <TextBlock x:Name="HeadValue" Grid.Column="2" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" TextAlignment="Right" />
                        <TextBlock x:Name="HeadPeak" Grid.Column="3" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource TextSecondary}" TextAlignment="Right" />
                    </Grid>
                    <ListBox
                        x:Name="List"
                        Grid.Row="2"
                        Background="Transparent"
                        BorderThickness="0"
                        HorizontalContentAlignment="Stretch"
                        ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                        SelectionChanged="List_SelectionChanged">
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="0" />
                                <Setter Property="Margin" Value="0,0,0,2" />
                                <Setter Property="Cursor" Value="Hand" />
                                <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="ListBoxItem">
                                            <Border x:Name="Bd" Background="Transparent" BorderBrush="Transparent" BorderThickness="1" CornerRadius="8">
                                                <ContentPresenter />
                                            </Border>
                                            <ControlTemplate.Triggers>
                                                <Trigger Property="IsMouseOver" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource HoverOverlay}" />
                                                </Trigger>
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter TargetName="Bd" Property="Background" Value="{DynamicResource AccentColorSubtle}" />
                                                    <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource AccentColor}" />
                                                </Trigger>
                                            </ControlTemplate.Triggers>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Margin="10,7">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="30" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="110" />
                                        <ColumnDefinition Width="110" />
                                    </Grid.ColumnDefinitions>
                                    <Ellipse Width="10" Height="10" HorizontalAlignment="Left" VerticalAlignment="Center" Fill="{Binding ColorBrush}" />
                                    <StackPanel Grid.Column="1" Margin="0,0,12,0" VerticalAlignment="Center">
                                        <TextBlock FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                                        <ProgressBar Height="4" Margin="0,5,0,0" Maximum="100" Value="{Binding Share, Mode=OneWay}" />
                                    </StackPanel>
                                    <TextBlock Grid.Column="2" VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" Text="{Binding ValueText}" TextAlignment="Right" />
                                    <TextBlock Grid.Column="3" VerticalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" Text="{Binding PeakText}" TextAlignment="Right" />
                                </Grid>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </Border>
        </Grid>

        <StackPanel x:Name="EmptyState" MaxWidth="460" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
            <ContentControl x:Name="EmptyBadge" Style="{StaticResource EmptyStateBadge}" Tag="{x:Static materialDesign:PackIconKind.ChartTimelineVariant}" />
            <TextBlock x:Name="EmptyTitle" Margin="0,12,0,0" HorizontalAlignment="Center" FontSize="15" FontWeight="SemiBold" Foreground="{DynamicResource TextPrimary}" />
            <TextBlock x:Name="EmptyHint" Margin="0,4,0,0" HorizontalAlignment="Center" FontSize="12" Foreground="{DynamicResource TextSecondary}" TextAlignment="Center" TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
