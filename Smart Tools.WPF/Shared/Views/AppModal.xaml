<UserControl
    x:Class="Smart_Tools.WPF.Views.AppModal"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    Focusable="False"
    KeyboardNavigation.TabNavigation="Cycle">
    <Grid>
        <!--  Scrim: swallows the mouse so nothing behind the card can be clicked  -->
        <Border Background="Black" Opacity="0.55" />
        <Border
            MinWidth="380"
            MaxWidth="560"
            Margin="24"
            Padding="22"
            HorizontalAlignment="Center"
            VerticalAlignment="Center"
            Background="{DynamicResource CardBg}"
            BorderBrush="{DynamicResource CardBorder}"
            BorderThickness="1"
            CornerRadius="16">
            <StackPanel>
                <TextBlock
                    x:Name="TxtTitle"
                    Margin="0,0,0,12"
                    FontSize="15"
                    FontWeight="SemiBold"
                    Foreground="{DynamicResource TextPrimary}"
                    TextTrimming="CharacterEllipsis" />
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <materialDesign:PackIcon
                        x:Name="IconChip"
                        Width="32"
                        Height="32"
                        Margin="0,0,14,0"
                        VerticalAlignment="Top"
                        Visibility="Collapsed" />
                    <ScrollViewer
                        Grid.Column="1"
                        MaxHeight="360"
                        VerticalAlignment="Center"
                        HorizontalScrollBarVisibility="Disabled"
                        VerticalScrollBarVisibility="Auto">
                        <TextBlock
                            x:Name="TxtMessage"
                            FontSize="13.5"
                            Foreground="{DynamicResource TextPrimary}"
                            TextWrapping="Wrap" />
                    </ScrollViewer>
                </Grid>
                <StackPanel
                    x:Name="ButtonRow"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal" />
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
