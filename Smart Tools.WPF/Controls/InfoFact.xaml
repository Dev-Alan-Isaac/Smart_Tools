<UserControl
    x:Class="Smart_Tools.WPF.Controls.InfoFact"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
    x:Name="Self">

    <!--  One short "good to know" fact: a small icon, a bold title, and a sentence or two.  -->
    <Grid Margin="0,0,16,14">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="Auto" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>
        <Border
            Width="30"
            Height="30"
            Margin="0,0,12,0"
            VerticalAlignment="Top"
            Background="{DynamicResource AccentColorSubtle}"
            CornerRadius="9">
            <materialDesign:PackIcon
                Width="16"
                Height="16"
                HorizontalAlignment="Center"
                VerticalAlignment="Center"
                Foreground="{DynamicResource AccentColor}"
                Kind="{Binding Icon, ElementName=Self}" />
        </Border>
        <StackPanel Grid.Column="1">
            <TextBlock
                FontSize="12.5"
                FontWeight="SemiBold"
                Foreground="{DynamicResource TextPrimary}"
                Text="{Binding Title, ElementName=Self}"
                TextWrapping="Wrap" />
            <TextBlock
                Margin="0,2,0,0"
                FontSize="12"
                Foreground="{DynamicResource TextSecondary}"
                Text="{Binding Body, ElementName=Self}"
                TextWrapping="Wrap" />
        </StackPanel>
    </Grid>
</UserControl>
