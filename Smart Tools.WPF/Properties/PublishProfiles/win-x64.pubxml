<?xml version="1.0" encoding="utf-8"?>
<!--
  The one publish profile: a self-contained Windows x64 folder (it carries .NET, so it runs on a PC that has nothing installed,
  which is where the first-run Install / Run window must be able to appear). Not a single file: ffmpeg, VLC, Tesseract and
  Whisper are native files that have to sit beside the exe. Used by Tools/Publish.ps1.
-->
<Project>
  <PropertyGroup>
    <Configuration>Release</Configuration>
    <Platform>Any CPU</Platform>
    <PublishProtocol>FileSystem</PublishProtocol>
    <TargetFramework>net10.0-windows10.0.17763.0</TargetFramework>
    <RuntimeIdentifier>win-x64</RuntimeIdentifier>
    <SelfContained>true</SelfContained>
    <PublishSingleFile>false</PublishSingleFile>
    <PublishReadyToRun>false</PublishReadyToRun>
    <PublishDir>..\publish\win-x64\</PublishDir>
    <PublishTrimmed>false</PublishTrimmed>
  </PropertyGroup>
</Project>