<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs"
     xmlns:ui="http://wixtoolset.org/schemas/v4/wxs/ui"
     xmlns:util="http://wixtoolset.org/schemas/v4/wxs/util">

	<!--
	  UpgradeCode is the SAME as the old SmartToolsWPF.Setup.vdproj, so installing this over an old 2.0.x install upgrades it
	  instead of leaving two Smart Tools entries in Apps & features. Per machine (Program Files): the app detects that folder
	  and treats it as "installed with the Windows installer" - Windows removes it, the app's own Uninstall button stays hidden.
	-->
	<Package Name="Smart Tools"
	         Manufacturer="Sheep"
	         Version="$(ProductVersion)"
	         UpgradeCode="5DED29E9-3DD5-4386-B62E-E4CC3DA7A264"
	         Scope="perMachine"
	         Compressed="yes">

		<SummaryInformation Description="Smart Tools - everyday tools for files, media, PDF, network and your PC." />

		<MajorUpgrade DowngradeErrorMessage="A newer version of Smart Tools is already installed." />
		<MediaTemplate EmbedCab="yes" CompressionLevel="high" />

		<!-- The app targets Windows 10 version 1809 (build 17763) or later, 64-bit. Nothing else is needed: .NET is in the folder. -->
		<Launch Condition="Installed OR (VersionNT64 AND WindowsBuild &gt;= 17763)"
		        Message="Smart Tools needs 64-bit Windows 10 (version 1809) or Windows 11." />

		<Icon Id="AppIcon.ico" SourceFile="..\Smart Tools.WPF\Images\Icon.ico" />
		<Property Id="ARPPRODUCTICON" Value="AppIcon.ico" />
		<Property Id="ARPNOREPAIR" Value="1" />

		<StandardDirectory Id="ProgramFiles64Folder">
			<Directory Id="INSTALLFOLDER" Name="Smart Tools" />
		</StandardDirectory>

		<!-- Everything the publish folder holds, except the exe (which carries the shortcuts, below). -->
		<ComponentGroup Id="AppFiles" Directory="INSTALLFOLDER">
			<Files Include="$(PublishDir)\**">
				<Exclude Files="$(PublishDir)\SmartTools.exe" />
				<Exclude Files="$(PublishDir)\portable.txt" />
			</Files>
		</ComponentGroup>

		<Component Id="MainExecutable" Directory="INSTALLFOLDER" Bitness="always64">
			<File Id="SmartTools.exe" Source="$(PublishDir)\SmartTools.exe" KeyPath="yes">
				<Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="Smart Tools" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon.ico" Advertise="no" />
				<Shortcut Id="DesktopShortcut" Directory="DesktopFolder" Name="Smart Tools" WorkingDirectory="INSTALLFOLDER" Icon="AppIcon.ico" Advertise="no" />
			</File>
			<!-- "Start with Windows" in Settings writes this value for the current user: take it away when uninstalling. -->
			<RemoveRegistryValue Root="HKCU" Key="Software\Microsoft\Windows\CurrentVersion\Run" Name="SmartTools" />
		</Component>

		<Feature Id="Main" Title="Smart Tools" Level="1" AllowAbsent="no">
			<ComponentRef Id="MainExecutable" />
			<ComponentGroupRef Id="AppFiles" />
		</Feature>

		<!-- The wizard: Welcome, folder, confirm, progress, finish (with "Start Smart Tools"). No licence page: there is no licence text to show. -->
		<ui:WixUI Id="WixUI_InstallDir" InstallDirectory="INSTALLFOLDER" />
		<UIRef Id="WixUI_ErrorProgressText" />

		<UI>
			<Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Order="99" Condition="NOT Installed" />
			<Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="99" />
			<Publish Dialog="ExitDialog" Control="Finish" Event="DoAction" Value="LaunchApplication" Condition="WIXUI_EXITDIALOGOPTIONALCHECKBOX = 1 and NOT Installed" />
		</UI>

		<Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOXTEXT" Value="Start Smart Tools" />
		<Property Id="WIXUI_EXITDIALOGOPTIONALCHECKBOX" Value="1" />
		<Property Id="WixShellExecTarget" Value="[#SmartTools.exe]" />
		<!-- Impersonate: the app starts as the person who ran Setup, not as the elevated installer. -->
		<CustomAction Id="LaunchApplication" DllEntry="WixShellExec" BinaryRef="Wix4UtilCA_$(sys.BUILDARCHSHORT)" Impersonate="yes" Return="ignore" />
	</Package>
</Wix>
