<Project Sdk="WixToolset.Sdk/5.0.2">

	<!--
	  The classic "Next, Next, Finish" installer (an .msi), for people who expect a setup wizard.
	  It packages the self-contained publish folder made by Tools\Publish.ps1 (which carries .NET, so no prerequisite).
	  It only INSTALLS. "Run without installing" is the app's own first-run window (or the zip); an MSI cannot do that.
	  Build it with Tools\Publish.ps1 (which publishes first and passes the version). It is not in Smart_Tools.slnx on purpose:
	  it needs the publish folder to exist, and a plain solution build would fail without it.
	-->

	<PropertyGroup>
		<OutputName>SmartTools-Setup</OutputName>
		<InstallerPlatform>x64</InstallerPlatform>
		<ProductVersion Condition="'$(ProductVersion)' == ''">2.1.0</ProductVersion>
		<PublishDir Condition="'$(PublishDir)' == ''">$(MSBuildThisFileDirectory)..\publish\win-x64</PublishDir>
		<DefineConstants>$(DefineConstants);ProductVersion=$(ProductVersion);PublishDir=$(PublishDir)</DefineConstants>
		<!-- The shortcuts and the Run-key clean-up use per-user places from a per-machine package on purpose. -->
		<SuppressIces>ICE38;ICE43;ICE57;ICE64;ICE91</SuppressIces>
	</PropertyGroup>

	<ItemGroup>
		<PackageReference Include="WixToolset.UI.wixext" Version="5.0.2" />
		<PackageReference Include="WixToolset.Util.wixext" Version="5.0.2" />
	</ItemGroup>

</Project>
